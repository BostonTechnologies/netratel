{
  "ConnectionStrings": {
    "NetRatelDb": "Host=postgres;Port=5432;Database=netratel;Username=netratel;Password=replace-at-deployment"
  },
  "DataProtection": {
    "ApplicationName": "NetRatel",
    "KeysDirectory": "/var/netratel/keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownIPNetworks": [],
    "AllowedHosts": [
      "localhost",
      "127.0.0.1",
      "[::1]"
    ]
  },
  "LoginUi": {
    "EnvironmentLabel": "Self-hosted instance"
  },
  "ScriptLibrary": {
    "MaxEditorPayloadBytes": 10485760
  },
  "ApiBaseUrl": "http://api:9222/",
  "Authentication": {
    "MachineToken": {
      "Enabled": false,
      "Authority": "https://issuer.example.invalid",
      "Audience": "netratel-machine-token",
      "RequiredGroups": [
        "netratel-operators"
      ],
      "SessionRoles": [
        "Operator"
      ],
      "AllowedSigningAlgorithms": [
        "RS256",
        "ES256"
      ]
    }
  },
  "WebGateway": {
    "Topology": "Compose",
    "Mcp": {
      "Enabled": false,
      "AuthenticationMode": "LocalCredential",
      "ActivityTimeout": "00:05:00"
    }
  }
}
