{
  "ConnectionStrings": {
    "NetRatelDb": "Host=postgres;Port=5432;Database=netratel;Username=netratel;Password=replace-at-deployment"
  },
  "DataProtection": {
    "ApplicationName": "NetRatel",
    "KeysDirectory": "/var/netratel/keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LoginUi": {
    "EnvironmentLabel": "Self-hosted instance"
  },
  "ScriptLibrary": {
    "MaxEditorPayloadBytes": 10485760
  },
  "ApiBaseUrl": "http://api:9222",
  "ReverseProxy": {
    "Routes": {
      "api-openapi-route": {
        "ClusterId": "apiCluster",
        "Match": { "Path": "/api/openapi/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      "api-v1-route": {
        "ClusterId": "apiCluster",
        "Match": { "Path": "/api/v1/{**catch-all}" },
        "Transforms": [ { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" } ]
      }
    },
    "Clusters": {
      "apiCluster": {
        "Destinations": { "api1": { "Address": "http://api:9222" } }
      }
    }
  },
  "Authentication": {
    "MachineToken": {
      "Enabled": false,
      "Authority": "https://issuer.example.invalid",
      "Audience": "netratel-machine-token",
      "RequiredGroups": [ "netratel-operators" ],
      "SessionRoles": [ "Operator" ],
      "AllowedSigningAlgorithms": [ "RS256", "ES256" ]
    }
  }
}
