@page "/account/integration-credentials/link/respond/{AttemptId}"
@page "/account/integration-credentials/link/review/{AttemptId}"
@page "/account/integration-credentials/link/result"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Text.Json
@using NetRatel.Shared.ServiceIdentity
@using NetRatel.Shared.ServiceLinks
@using NetRatel.Web.Components.Shared.ServiceLinks
@using NetRatel.Web.Services.ServiceLinks
@inject HelpdeskM2MApiClient Api
@inject NavigationManager Navigation

<PageTitle>RatelDesk link approval</PageTitle>
<MudContainer MaxWidth="MaxWidth.Medium" Class="integration-page" data-testid="service-link-consent-page">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h5" HtmlTag="h1">@(IsResponder ? "Approve RatelDesk connection" : "Complete RatelDesk connection")</MudText>
        @if (loading) { <MudProgressLinear Indeterminate="true" /> }
        else if (error is not null || status is null)
        {
            <MudAlert Dense="true" Severity="Severity.Warning">@(error ?? ResultMessage(Status))</MudAlert>
            @if (ResultFailure.Stage != "request" || ResultFailure.CorrelationId is not null)
            {
                <MudText Typo="Typo.caption">Stage: @ResultFailure.Stage · Reference: @(ResultFailure.CorrelationId ?? "unavailable")</MudText>
            }
            @if (ValidResultAttemptId is { } retainedAttempt)
            {
                <HelpdeskConnectionsPanel @key="retainedAttempt" AttemptId="@retainedAttempt" VerifyOnLoad="false" />
                <MudButton Href="/account/integration-credentials?tab=system-connections">Back to system connections</MudButton>
            }
            else if (ResultFailure.Stage == "start")
            {
                <MudButton Href="/account/integration-credentials?purpose=helpdesk-m2m" Color="Color.Primary">Correct setup and retry</MudButton>
            }
            else
            {
                <MudButton Href="/account/integration-credentials" Color="Color.Primary">Review connections</MudButton>
            }
            <MudButton Href="/notifications">View notifications</MudButton>
        }
        else
        {
            <MudText Typo="Typo.caption">1 · Connect   →   2 · Approve   →   3 · Connected</MudText>
            @if (observing) { <MudText Typo="Typo.caption" role="status" data-testid="service-link-status-observation">Checking for setup progress automatically…</MudText> }
            @if (observationMessage is not null) { <MudAlert Severity="Severity.Info" Dense="true" role="status">@observationMessage</MudAlert> }
            @if (status.GrantSummary is null) { <MudText Typo="Typo.body2">Requested access · not yet approved</MudText> }
            <ServiceLinkConsentDetails Initiator="status.Descriptor.InitiatorEndpointSnapshot" Responder="status.Descriptor.ResponderEndpointSnapshot" Grants="DisplayedGrants" />
            @if (status.AvailableAction == "respond" && IsResponder && status.GrantSummary is null)
            {
                <ServiceGrantSelector @key="loadGeneration" Authority="NarrowedAuthority" IncidentOnly="IncidentOnly" PresetTenantId="RequestedLocalTenantId" Changed="SelectionChanged" />
                <MudSelect T="string" Style="@(IncidentOnly ? "display:none" : null)" Label="NetRatel → RatelDesk permissions" MultiSelection="true" SelectedValues="outboundScopes" SelectedValuesChanged="OutboundChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var scope in RequestedOutboundScopes) { <MudSelectItem Value="@scope">@scope</MudSelectItem> }
                </MudSelect>
                @if (selection.Scopes.Contains("netratel.orchestration.invoke") && !outboundScopes.Contains("rateldesk.orchestration.callback"))
                {
                    <MudAlert Dense="true" Severity="Severity.Info">Task invocation requires the reverse correlated task callback permission. Include it or approve read-only orchestration access.</MudAlert>
                }
                <form @key="status" method="post" action="/account/integration-credentials/link/respond" data-enhance="false" data-testid="service-link-responder-approval">
                    <AntiforgeryToken />
                    <input type="hidden" name="attemptId" value="@AttemptId" />
                    <input type="hidden" name="descriptorHash" value="@status.Descriptor.DescriptorHash" />
                    <input type="hidden" name="localTenantId" value="@selection.TenantId?.ToString(CultureInfo.InvariantCulture)" />
                    @foreach (var scope in selection.Scopes) { <input type="hidden" name="inboundScopes" value="@scope" /> }
                    @foreach (var scope in outboundScopes) { <input type="hidden" name="outboundScopes" value="@scope" /> }
                    @foreach (var resource in selection.ResourceIds) { <input type="hidden" name="resourceIds" value="@resource" /> }
                    @foreach (var definition in selection.RequestDefinitionIds) { <input type="hidden" name="requestDefinitionIds" value="@definition" /> }
                    <label class="helpdesk-consent-checkbox"><input type="checkbox" name="confirmed" value="true" @bind="confirmed" required />I approve this connection for the selected tenant and incident target.</label>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanApproveRemote)">Approve and return to RatelDesk</MudButton>
                </form>
            }
            else if (status.AvailableAction == "review" && !IsResponder && status.GrantSummary is not null)
            {
                <MudAlert Dense="true" Severity="Severity.Info">RatelDesk selected the organization/customer and permissions shown above. This final consent approves that exact summary before either business direction is enabled.</MudAlert>
                <form @key="status" method="post" action="/account/integration-credentials/link/confirm" data-enhance="false" data-testid="service-link-final-approval">
                    <AntiforgeryToken />
                    <input type="hidden" name="attemptId" value="@AttemptId" />
                    <input type="hidden" name="grantHash" value="@status.GrantHash" />
                    <label class="helpdesk-consent-checkbox"><input type="checkbox" name="confirmed" value="true" required />I approve this connection and the selected RatelDesk incident target.</label>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Approve and complete setup</MudButton>
                </form>
            }
            else
            {
                <MudAlert Dense="true" Severity="Severity.Info">@ConnectionMessage</MudAlert>
                @if (status.AvailableAction is "continue" or "return")
                {
                    <form method="post" action="/account/integration-credentials/link/continue" data-enhance="false" data-testid="service-link-continue-approval">
                        <AntiforgeryToken />
                        <input type="hidden" name="attemptId" value="@status.AttemptId" />
                        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">@(status.AvailableAction == "return" ? "Return to RatelDesk to finish setup" : "Continue to RatelDesk approval")</MudButton>
                    </form>
                }
            }
            @if (status.AvailableAction is not ("respond" or "review" or "continue" or "return"))
            { <HelpdeskConnectionsPanel @key="status" AttemptId="@AttemptId" VerifyOnLoad="verifyObservedConnection" ObserveProgress="false" /> }
            @if (status.LifecycleState == "active") { <MudButton Href="/account/integration-credentials/link/return" Color="Color.Primary">Return to Flow or integrations</MudButton> }
            else { <MudButton Href="/account/integration-credentials">Return to integrations</MudButton> }
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter] public string? AttemptId { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "attemptId")] public string? ResultAttemptId { get; set; }
    private string? ValidResultAttemptId => ResultAttemptId is { Length: > 0 and <= 128 } && ResultAttemptId.All(character => char.IsAsciiLetterOrDigit(character) || character is '-' or '_') ? ResultAttemptId : null;
    [SupplyParameterFromQuery(Name = "stage")] public string? Stage { get; set; }
    [SupplyParameterFromQuery(Name = "correlationId")] public string? CorrelationId { get; set; }
    private ServiceLinkFailure? operationFailure;
    private ServiceLinkFailure ResultFailure => operationFailure ?? ServiceLinkFailure.From(Status, Stage, CorrelationId);
    private ServiceLinkAdminStatus? status;
    private ServiceClientManagementAuthority authority = new(false, []);
    private HelpdeskGrantSelection selection = new(null, [], [], []);
    private HashSet<string> outboundScopes = new(StringComparer.Ordinal);
    private string? error, observationMessage;
    private bool observing;
    private bool loading = true, disposed, IsResponder, confirmed, verifyObservedConnection;
    private int loadGeneration;
    private CancellationTokenSource? loadCancellation;
    private IEnumerable<string> RequestedInboundScopes => status?.Descriptor.RequestedGrants.Where(grant => grant.TargetProduct == "netratel").SelectMany(grant => grant.Scopes).Distinct(StringComparer.Ordinal) ?? [];
    private IEnumerable<string> RequestedOutboundScopes => status?.Descriptor.RequestedGrants.Where(grant => grant.TargetProduct == "rateldesk").SelectMany(grant => grant.Scopes).Distinct(StringComparer.Ordinal) ?? [];
    private int? RequestedLocalTenantId => int.TryParse(status?.Descriptor.RequestedResponderTenantId, out var tenant) ? tenant : null;
    private ServiceClientManagementAuthority NarrowedAuthority => authority with { Tenants = authority.Tenants
        .Where(tenant => string.IsNullOrEmpty(status?.Descriptor.RequestedResponderTenantId) || tenant.TenantId.ToString(CultureInfo.InvariantCulture) == status.Descriptor.RequestedResponderTenantId).Select(tenant => tenant with { Scopes = tenant.Scopes.Intersect(RequestedInboundScopes, StringComparer.Ordinal).ToArray() }).ToArray() };
    private bool IncidentOnly => RequestedInboundScopes.ToHashSet(StringComparer.Ordinal).SetEquals([ServiceLinkContract.ControlScope, ServiceLinkContract.VerifyScope]);
    private string ConnectionMessage => status?.OrganizationBindingInvalid == true && status.LifecycleState is not ("revoked" or "expired" or "failed")
        ? "The proposed local tenant is unavailable. Cancel this unapproved setup and start fresh with an authorized tenant; the original proposal cannot be changed."
        : status?.CanStartFresh == true && status.LifecycleState is not ("revoked" or "expired" or "failed")
            ? "This approval expired. Start fresh setup for new consent."
            : status?.LifecycleState switch
    {
        "revoked" => "This connection is disconnected. Start fresh setup for new consent.",
        "expired" => "This setup expired. Start fresh setup for new consent.",
        "failed" => "This setup could not complete. Review its status below before starting fresh setup.",
        "active" => "Approval is saved. The connection below shows whether the incident destination is ready for Flow delivery.",
        _ => status?.GrantSummary is null
            ? "Approval has not been saved. The original approving account must continue in its authorized browser session."
            : status?.AvailableAction == "resume"
                ? "Approval is saved. Resume below to reconcile the stored decision and authenticated connection checks."
                : "Review the saved approval and current connection status below."
    };
    private bool CanApproveRemote => authority.CanManage && selection.IsValid && outboundScopes.Count > 0 &&
        (!selection.Scopes.Contains("netratel.orchestration.invoke") || outboundScopes.Contains("rateldesk.orchestration.callback"));
    private ServiceLinkGrant[] DisplayedGrants => status?.GrantSummary?.Grants ?? (status?.Descriptor.RequestedGrants ?? []).Select(grant => grant.TargetProduct == "netratel" && status?.AvailableAction == "respond"
        ? grant with { TargetTenantId = selection.TenantId?.ToString(CultureInfo.InvariantCulture) ?? "", Scopes = selection.Scopes, ResourceConstraints = grant.ResourceConstraints with { TenantId = selection.TenantId?.ToString(CultureInfo.InvariantCulture), ResourceIds = selection.ResourceIds, RequestDefinitionIds = selection.RequestDefinitionIds } }
        : grant.TargetProduct == "rateldesk" && status?.AvailableAction == "respond" ? grant with { CallerTenantId = selection.TenantId?.ToString(CultureInfo.InvariantCulture) ?? "", Scopes = outboundScopes.Order(StringComparer.Ordinal).ToArray() } : grant).ToArray();
    protected override async Task OnParametersSetAsync()
    {
        if (disposed) return;
        var generation = ++loadGeneration;
        loadCancellation?.Cancel(); loadCancellation?.Dispose();
        loadCancellation = new CancellationTokenSource();
        var token = loadCancellation.Token;
        var attempt = AttemptId;
        var route = new Uri(Navigation.Uri).AbsolutePath;
        IsResponder = false;
        loading = true; verifyObservedConnection = false; error = null; observationMessage = null; observing = false; operationFailure = null; status = null; authority = new(false, []);
        selection = new(null, [], [], []); outboundScopes = new(StringComparer.Ordinal); confirmed = false;
        if (string.IsNullOrEmpty(attempt) || !route.Contains("/respond/", StringComparison.Ordinal) && !route.Contains("/review/", StringComparison.Ordinal))
        { loading = false; return; }
        try
        {
            var loadedStatus = await Api.GetAttemptAsync(attempt, token);
            if (!IsCurrentLoad(generation, attempt, route)) return;
            var loadedAuthority = new ServiceClientManagementAuthority(false, []);
            var loadedOutbound = new HashSet<string>(StringComparer.Ordinal);
            if (loadedStatus.LocalRole == "responder" && loadedStatus.AvailableAction == "respond" && loadedStatus.GrantSummary is null)
            {
                loadedAuthority = await Api.GetAuthorityAsync(token);
                if (!IsCurrentLoad(generation, attempt, route)) return;
                loadedOutbound = loadedStatus.Descriptor.RequestedGrants.Where(grant => grant.TargetProduct == "rateldesk")
                    .SelectMany(grant => grant.Scopes).ToHashSet(StringComparer.Ordinal);
            }
            status = loadedStatus; IsResponder = loadedStatus.LocalRole == "responder"; authority = loadedAuthority; outboundScopes = loadedOutbound;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (Exception exception) when (exception is OperationCanceledException or HttpRequestException or JsonException or InvalidDataException or ServiceAdministrationException)
        {
            if (IsCurrentLoad(generation, attempt, route))
            {
                operationFailure = (exception as ServiceAdministrationException)?.Failure;
                error = operationFailure?.Message ?? "The protected grant summary is unavailable or current authority has changed. Refresh its stored status before approving.";
            }
        }
        finally
        {
            if (IsCurrentLoad(generation, attempt, route))
            {
                loading = false;
                if (status is not null && AwaitingProgress(status))
                { observing = true; _ = ObserveAttemptAsync(generation, attempt, route, token); }
            }
        }
    }
    private static bool AwaitingProgress(ServiceLinkAdminStatus value) => value.Decision != "abort" && !value.CanStartFresh && !value.OrganizationBindingInvalid &&
        value.LifecycleState is "awaiting_approval" or "approved" or "prepared" or "verified" or "commit_decided" or "in_doubt";
    private async Task ObserveAttemptAsync(int generation, string attempt, string route, CancellationToken lifetime)
    {
        using var budget = CancellationTokenSource.CreateLinkedTokenSource(lifetime);
        budget.CancelAfter(TimeSpan.FromSeconds(30));
        try
        {
            for (var read = 1; read <= 5; read++)
            {
                await Task.Delay(TimeSpan.FromSeconds(read * 2), budget.Token);
                var latest = await Api.GetAttemptAsync(attempt, budget.Token);
                if (!IsCurrentLoad(generation, attempt, route) || budget.IsCancellationRequested) return;
                // Preserve the user's tenant selection and consent checkbox while the durable proposal is unchanged.
                if (status is not null && (latest.LifecycleState != status.LifecycleState || latest.LinkRevision != status.LinkRevision ||
                    latest.Decision != status.Decision || latest.GrantHash != status.GrantHash || latest.AvailableAction != status.AvailableAction ||
                    latest.Descriptor.DescriptorHash != status.Descriptor.DescriptorHash))
                {
                    verifyObservedConnection = latest.LifecycleState == "active" && status.LifecycleState != "active";
                    status = latest; confirmed = false;
                    await InvokeAsync(StateHasChanged);
                }
                if (!AwaitingProgress(latest)) return;
            }
        }
        catch (OperationCanceledException) when (budget.IsCancellationRequested)
        {
            if (lifetime.IsCancellationRequested || !IsCurrentLoad(generation, attempt, route)) return;
            observationMessage = "This setup is still waiting. Reopen its status to check again; your existing approval is retained.";
        }
        catch (ServiceAdministrationException failure) when (failure.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized)
        {
            if (!IsCurrentLoad(generation, attempt, route)) return;
            status = null; authority = new(false, []); confirmed = false; error = failure.Message; operationFailure = failure.Failure;
        }
        catch (Exception failure) when (failure is OperationCanceledException or HttpRequestException or JsonException or InvalidDataException or ServiceAdministrationException)
        {
            if (!IsCurrentLoad(generation, attempt, route)) return;
            observationMessage = "Automatic status refresh could not finish. Reopen this connection to check its current status.";
        }
        finally
        {
            if (IsCurrentLoad(generation, attempt, route)) { observing = false; await InvokeAsync(StateHasChanged); }
        }
    }
    private bool IsCurrentLoad(int generation, string attempt, string route) => !disposed && generation == loadGeneration &&
        string.Equals(AttemptId, attempt, StringComparison.Ordinal) && string.Equals(new Uri(Navigation.Uri).AbsolutePath, route, StringComparison.Ordinal);
    private void SelectionChanged(HelpdeskGrantSelection value) { selection = value; confirmed = false; }
    private void OutboundChanged(IEnumerable<string>? values)
    { outboundScopes = values?.ToHashSet(StringComparer.Ordinal) ?? new(StringComparer.Ordinal); confirmed = false; }
    public void Dispose()
    {
        disposed = true; ++loadGeneration; loadCancellation?.Cancel(); loadCancellation?.Dispose(); loadCancellation = null;
        status = null; authority = new(false, []); selection = new(null, [], [], []); outboundScopes.Clear(); confirmed = false;
    }
    private static string ResultMessage(string? code) => ServiceLinkFailure.From(code).Message;
}
