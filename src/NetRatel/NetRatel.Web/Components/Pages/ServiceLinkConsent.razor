@page "/account/integration-credentials/link/respond/{AttemptId}"
@page "/account/integration-credentials/link/review/{AttemptId}"
@page "/account/integration-credentials/link/result"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Text.Json
@using NetRatel.Shared.ServiceIdentity
@using NetRatel.Shared.ServiceLinks
@using NetRatel.Web.Components.Shared.ServiceLinks
@using NetRatel.Web.Services.ServiceLinks
@inject HelpdeskM2MApiClient Api
@inject NavigationManager Navigation

<PageTitle>RatelDesk link approval</PageTitle>
<MudContainer MaxWidth="MaxWidth.Medium" Class="integration-page" data-testid="service-link-consent-page">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h5" HtmlTag="h1">@(IsResponder ? "Approve RatelDesk connection" : "Complete RatelDesk connection")</MudText>
        @if (loading) { <MudProgressLinear Indeterminate="true" /> }
        else if (error is not null || status is null)
        {
            <MudAlert Dense="true" Severity="Severity.Warning">@(error ?? ResultMessage(Status))</MudAlert>
            <MudButton Href="/account/integration-credentials?purpose=helpdesk-m2m" Color="Color.Primary">Return to Helpdesk M2M setup</MudButton>
        }
        else
        {
            <MudText Typo="Typo.caption">1 · Connect   →   2 · Approve   →   3 · Connected</MudText>
            <ServiceLinkConsentDetails Initiator="status.Descriptor.InitiatorEndpointSnapshot" Responder="status.Descriptor.ResponderEndpointSnapshot" Grants="DisplayedGrants" />
            @if (IsResponder && status.GrantSummary is null)
            {
                <ServiceGrantSelector @key="loadGeneration" Authority="NarrowedAuthority" IncidentOnly="IncidentOnly" Changed="SelectionChanged" />
                <MudSelect T="string" Style="@(IncidentOnly ? "display:none" : null)" Label="NetRatel → RatelDesk permissions" MultiSelection="true" SelectedValues="outboundScopes" SelectedValuesChanged="OutboundChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var scope in RequestedOutboundScopes) { <MudSelectItem Value="@scope">@scope</MudSelectItem> }
                </MudSelect>
                @if (selection.Scopes.Contains("netratel.orchestration.invoke") && !outboundScopes.Contains("rateldesk.orchestration.callback"))
                {
                    <MudAlert Dense="true" Severity="Severity.Info">Task invocation requires the reverse correlated task callback permission. Include it or approve read-only orchestration access.</MudAlert>
                }
                <form @key="status" method="post" action="/account/integration-credentials/link/respond" data-enhance="false" data-testid="service-link-responder-approval">
                    <AntiforgeryToken />
                    <input type="hidden" name="attemptId" value="@AttemptId" />
                    <input type="hidden" name="descriptorHash" value="@status.Descriptor.DescriptorHash" />
                    <input type="hidden" name="localTenantId" value="@selection.TenantId?.ToString(CultureInfo.InvariantCulture)" />
                    @foreach (var scope in selection.Scopes) { <input type="hidden" name="inboundScopes" value="@scope" /> }
                    @foreach (var scope in outboundScopes) { <input type="hidden" name="outboundScopes" value="@scope" /> }
                    @foreach (var resource in selection.ResourceIds) { <input type="hidden" name="resourceIds" value="@resource" /> }
                    @foreach (var definition in selection.RequestDefinitionIds) { <input type="hidden" name="requestDefinitionIds" value="@definition" /> }
                    <label class="helpdesk-consent-checkbox"><input type="checkbox" name="confirmed" value="true" @bind="confirmed" required />I approve this connection for the selected tenant and incident target.</label>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanApproveRemote)">Approve and return to RatelDesk</MudButton>
                </form>
            }
            else if (!IsResponder && status.GrantSummary is not null && status.Decision == "undecided" && status.LifecycleState == "approved")
            {
                <MudAlert Dense="true" Severity="Severity.Info">RatelDesk selected the organization/customer and permissions shown above. This final consent approves that exact summary before either business direction is enabled.</MudAlert>
                <form @key="status" method="post" action="/account/integration-credentials/link/confirm" data-enhance="false" data-testid="service-link-final-approval">
                    <AntiforgeryToken />
                    <input type="hidden" name="attemptId" value="@AttemptId" />
                    <input type="hidden" name="grantHash" value="@status.GrantHash" />
                    <label class="helpdesk-consent-checkbox"><input type="checkbox" name="confirmed" value="true" required />I approve this connection and the selected RatelDesk incident target.</label>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Approve and complete setup</MudButton>
                </form>
            }
            else
            {
                <MudAlert Dense="true" Severity="Severity.Info">@ConnectionMessage</MudAlert>
            }
            <HelpdeskConnectionsPanel />
            @if (status.LifecycleState == "active") { <MudButton Href="/account/integration-credentials/link/return" Color="Color.Primary">Return to Flow or integrations</MudButton> }
            else { <MudButton Href="/account/integration-credentials">Return to integrations</MudButton> }
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter] public string? AttemptId { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    private ServiceLinkAdminStatus? status;
    private ServiceClientManagementAuthority authority = new(false, []);
    private HelpdeskGrantSelection selection = new(null, [], [], []);
    private HashSet<string> outboundScopes = new(StringComparer.Ordinal);
    private string? error;
    private bool loading = true, disposed, IsResponder, confirmed;
    private int loadGeneration;
    private CancellationTokenSource? loadCancellation;
    private IEnumerable<string> RequestedInboundScopes => status?.Descriptor.RequestedGrants.Where(grant => grant.TargetProduct == "netratel").SelectMany(grant => grant.Scopes).Distinct(StringComparer.Ordinal) ?? [];
    private IEnumerable<string> RequestedOutboundScopes => status?.Descriptor.RequestedGrants.Where(grant => grant.TargetProduct == "rateldesk").SelectMany(grant => grant.Scopes).Distinct(StringComparer.Ordinal) ?? [];
    private ServiceClientManagementAuthority NarrowedAuthority => authority with { Tenants = authority.Tenants.Select(tenant => tenant with { Scopes = tenant.Scopes.Intersect(RequestedInboundScopes, StringComparer.Ordinal).ToArray() }).ToArray() };
    private bool IncidentOnly => RequestedInboundScopes.ToHashSet(StringComparer.Ordinal).SetEquals([ServiceLinkContract.ControlScope, ServiceLinkContract.VerifyScope]);
    private string ConnectionMessage => status?.LifecycleState == "active" ? "Approved. Verify the connection below to confirm it is ready for Flow delivery." : "Completing setup. Resume below to retry the stored approval and authenticated connection checks.";
    private bool CanApproveRemote => authority.CanManage && selection.IsValid && outboundScopes.Count > 0 &&
        (!selection.Scopes.Contains("netratel.orchestration.invoke") || outboundScopes.Contains("rateldesk.orchestration.callback"));
    private ServiceLinkGrant[] DisplayedGrants => status?.GrantSummary?.Grants ?? (status?.Descriptor.RequestedGrants ?? []).Select(grant => grant.TargetProduct == "netratel" && IsResponder
        ? grant with { TargetTenantId = selection.TenantId?.ToString(CultureInfo.InvariantCulture) ?? "", Scopes = selection.Scopes, ResourceConstraints = grant.ResourceConstraints with { TenantId = selection.TenantId?.ToString(CultureInfo.InvariantCulture), ResourceIds = selection.ResourceIds, RequestDefinitionIds = selection.RequestDefinitionIds } }
        : grant.TargetProduct == "rateldesk" && IsResponder ? grant with { CallerTenantId = selection.TenantId?.ToString(CultureInfo.InvariantCulture) ?? "", Scopes = outboundScopes.Order(StringComparer.Ordinal).ToArray() } : grant).ToArray();
    protected override async Task OnParametersSetAsync()
    {
        if (disposed) return;
        var generation = ++loadGeneration;
        loadCancellation?.Cancel(); loadCancellation?.Dispose();
        loadCancellation = new CancellationTokenSource();
        var token = loadCancellation.Token;
        var attempt = AttemptId;
        var route = new Uri(Navigation.Uri).AbsolutePath;
        IsResponder = route.Contains("/respond/", StringComparison.Ordinal);
        loading = true; error = null; status = null; authority = new(false, []);
        selection = new(null, [], [], []); outboundScopes = new(StringComparer.Ordinal); confirmed = false;
        if (string.IsNullOrEmpty(attempt) || !IsResponder && !route.Contains("/review/", StringComparison.Ordinal))
        { loading = false; return; }
        try
        {
            var loadedStatus = await Api.GetAttemptAsync(attempt, token);
            if (!IsCurrentLoad(generation, attempt, route)) return;
            var loadedAuthority = new ServiceClientManagementAuthority(false, []);
            var loadedOutbound = new HashSet<string>(StringComparer.Ordinal);
            if (IsResponder && loadedStatus.GrantSummary is null)
            {
                loadedAuthority = await Api.GetAuthorityAsync(token);
                if (!IsCurrentLoad(generation, attempt, route)) return;
                loadedOutbound = loadedStatus.Descriptor.RequestedGrants.Where(grant => grant.TargetProduct == "rateldesk")
                    .SelectMany(grant => grant.Scopes).ToHashSet(StringComparer.Ordinal);
            }
            status = loadedStatus; authority = loadedAuthority; outboundScopes = loadedOutbound;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (Exception exception) when (exception is OperationCanceledException or HttpRequestException or JsonException or InvalidDataException or ServiceAdministrationException)
        { if (IsCurrentLoad(generation, attempt, route)) error = "The protected grant summary is unavailable or current authority has changed. Refresh its stored status before approving."; }
        finally { if (IsCurrentLoad(generation, attempt, route)) loading = false; }
    }
    private bool IsCurrentLoad(int generation, string attempt, string route) => !disposed && generation == loadGeneration &&
        string.Equals(AttemptId, attempt, StringComparison.Ordinal) && string.Equals(new Uri(Navigation.Uri).AbsolutePath, route, StringComparison.Ordinal);
    private void SelectionChanged(HelpdeskGrantSelection value) { selection = value; confirmed = false; }
    private void OutboundChanged(IEnumerable<string>? values)
    { outboundScopes = values?.ToHashSet(StringComparer.Ordinal) ?? new(StringComparer.Ordinal); confirmed = false; }
    public void Dispose()
    {
        disposed = true; ++loadGeneration; loadCancellation?.Cancel(); loadCancellation?.Dispose(); loadCancellation = null;
        status = null; authority = new(false, []); selection = new(null, [], [], []); outboundScopes.Clear(); confirmed = false;
    }
    private static string ResultMessage(string? code) => code switch
    {
        "upgrade-required" => "Upgrade required: this RatelDesk build does not support the requested connection capability. Manual service credentials remain available.",
        "not-authorized" => "Current integration management authority is required for the selected tenant and resources.",
        "expired" => "This unprepared attempt expired. Start a new approved attempt; prepared connections retain their decision recovery state.",
        "form-expired" => "The approval form expired. Reload the protected review and confirm again.",
        "session-expired" => "The initiating browser session expired. Sign in and review the durable attempt before starting a new approval.",
        "needs-attention" => "The operation could not be confirmed. Review the separate directional states and resume recovery before starting another attempt.",
        "deployment-managed" => "Deployment configuration owns the selected connection. Guided setup cannot replace its registration or protected credentials.",
        "profile-occupied" => "An existing connection owns this profile. Disconnect it explicitly before approving a replacement.",
        "source-unavailable" => "The exact persisted incident producer identity has not been configured. Approve its explicit mapping before linking.",
        "unsupported-peer" => "The selected origin is not a compatible distinct RatelDesk instance.",
        "service-unavailable" => "The deployment's service issuer or reciprocal link capability is unavailable. Review its configured public identity and service settings.",
        "callback-required" => "Task invocation requires the reverse correlated task callback grant. Include it or approve read-only orchestration access.",
        _ => "The link proof or browser session could not be verified. No approval was accepted through this page."
    };
}
