@page "/terminal/{SessionId}"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using NetRatel.Shared.Contracts.Terminals
@using NetRatel.Shared.Contracts.Secrets
@using NetRatel.Web.Components.Shared.Secrets
@using Microsoft.JSInterop
@inject ITerminalService Term
@inject ISnackbar Snack
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Terminal</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4 terminal-page">
  @if (_isLoading)
  {
    <MudStack AlignItems="AlignItems.Center" Class="mt-6">
      <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    </MudStack>
  }
  else if (_session is null)
  {
    <MudAlert Severity="Severity.Error">Terminal session @SessionId was not found.</MudAlert>
  }
  else
  {
    <MudStack Spacing="2">
      <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
        <MudText Typo="Typo.h5">Terminal @_session.ShellType</MudText>
        <MudChip T="string" Variant="Variant.Outlined">@_session.State</MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Person"
                 Disabled="@(!CanSwitchAccount)" OnClick="SwitchAccountAsync" aria-label="Change execution context">
          <span class="terminal-account-name" title="@TerminalAccount">@TerminalAccount</span>
        </MudChip>
        @if (!string.IsNullOrWhiteSpace(_session.Backend))
        {
          <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">@_session.Backend</MudChip>
        }
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@FormatTransport(_session.Transport)</MudChip>
        @if (_session.Cols.HasValue && _session.Rows.HasValue)
        {
          <MudText Typo="Typo.caption" Class="text-secondary">@_session.Cols x @_session.Rows</MudText>
        }
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="FitTerminalAsync">Fit</MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="ClearTerminalAsync">Clear</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   Disabled="@string.Equals(_session.State, "closed", StringComparison.OrdinalIgnoreCase)"
                   OnClick="CloseSessionAsync">Close Session</MudButton>
      </MudStack>

      <MudText Typo="Typo.caption" Class="text-secondary">Session @_session.SessionId</MudText>

      <MudPaper Class="pa-0 terminal-console-surface">
        <TerminalConsole @key="_session.SessionId" @ref="_console"
                         SessionId="@_session.SessionId"
                         IsInputEnabled="@(_inputEnabled && !_switching && !_session.AwaitingAccountSwitch)"
                         OnClosed="HandleClosedAsync" />
      </MudPaper>
    </MudStack>
  }
</MudContainer>

@code {
  private string TerminalAccount => _session?.ObservedIdentity?.Account ?? "Agent service account";
  [Parameter] public string SessionId { get; set; } = string.Empty;

  private TerminalSessionDto? _session;
  private bool _isLoading = true;
  private TerminalConsole? _console;
  private CancellationTokenSource? _streamCts;
  private Task? _streamTask;
  private bool _streamStarted;
  private bool _inputEnabled;
  private bool _switching;
  private long? _heartbeatId;
  private IJSObjectReference? _heartbeat;
  private DotNetObjectReference<Terminal>? _heartbeatReference;
  private bool CanSwitchAccount => !_switching && _session is { TenantId: > 0, Generation: > 0,
    AttachmentLeaseId.Length: > 0, AwaitingAccountSwitch: false } session && TerminalAccountHandover.IsOpen(session);

  protected override async Task OnParametersSetAsync()
  {
    await DisposeStreamAsync();
    await StopHeartbeatAsync();
    _isLoading = true;
    _streamStarted = false;
    _inputEnabled = false;

    try
    {
      _session = await Term.GetSessionAsync(SessionId);
      _inputEnabled = _session is not null && TerminalAccountHandover.IsOpen(_session);
    }
    catch (Exception ex)
    {
      Snack.Add($"Failed to load terminal session: {ex.Message}", Severity.Error);
      _session = null;
    }
    finally
    {
      _isLoading = false;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_session is not { } session || _console is null || _streamStarted) return;

    if (session.ReplacementSessionId is { } replacementId && await Term.GetGatewaySessionAsync(replacementId) is { } replacement && TerminalAccountHandover.IsOpen(replacement))
    {
      Navigation.NavigateTo($"/terminal/{replacementId}", replace: true);
      return;
    }
    _streamStarted = true;
    _streamCts = new CancellationTokenSource();
    _streamTask = PumpTerminalStreamAsync(_streamCts.Token);
    if (session.Generation is not { } generation || string.IsNullOrEmpty(session.AttachmentLeaseId)) return;
    _heartbeat ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/terminalAttachmentHeartbeat.js");
    _heartbeatReference ??= DotNetObjectReference.Create(this);
    _heartbeatId = await _heartbeat.InvokeAsync<long>("startTerminalAttachmentHeartbeat", _heartbeatReference,
      session.SessionId, generation.ToString(System.Globalization.CultureInfo.InvariantCulture), session.AttachmentLeaseId);
  }

  private async Task SwitchAccountAsync()
  {
    if (!CanSwitchAccount || _session is not { } original || !Guid.TryParse(original.ClientIdentityHex, out var agentId)) return;
    var dialog = await Dialogs.ShowAsync<TerminalAccountSwitchDialog>("Change execution context",
      new DialogParameters<TerminalAccountSwitchDialog> { { x => x.TenantId, original.TenantId!.Value }, { x => x.AgentId, agentId } },
      SecretVaultPresentation.Options);
    if (await dialog.Result is not { Canceled: false, Data: ExecutionIdentitySetting requested } ||
        !CanSwitchAccount || _session?.SessionId != original.SessionId) return;
    original = _session;
    _switching = true;
    try
    {
      using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(55));
      var replacement = await TerminalAccountHandover.SwitchAsync(Term, original, requested, deadline.Token);
      Navigation.NavigateTo($"/terminal/{replacement.SessionId}", replace: true);
    }
    catch (Exception error) when (error is HttpRequestException or InvalidOperationException or OperationCanceledException)
    {
      Snack.Add(error is OperationCanceledException ? "The terminal account switch timed out." : error.Message, Severity.Error);
    }
    finally { _switching = false; }
  }

  [JSInvokable]
  public async Task<TerminalAttachmentHeartbeatResult> OnGatewayTerminalAttachmentHeartbeat(string sessionId, string generation,
    string leaseId, string browserId, bool claimOwnership)
  {
    if (!ulong.TryParse(generation, out var epoch) || _session is not { } session || session.SessionId != sessionId ||
        session.Generation != epoch || session.AttachmentLeaseId != leaseId) return new(false);
    try
    {
      using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(10));
      var renewed = await Term.RenewGatewayAttachmentAsync(sessionId, epoch, leaseId, browserId, claimOwnership, deadline.Token);
      if (renewed.AttachmentLeaseId is not { } next || _session?.SessionId != sessionId) return new(false);
      var latest = session.AwaitingAccountSwitch ? await Term.GetGatewaySessionAsync(sessionId, deadline.Token) : null;
      _session = (latest ?? session) with { AttachmentLeaseId = next };
      _inputEnabled = TerminalAccountHandover.IsOpen(_session);
      await InvokeAsync(StateHasChanged);
      return new(true, true, next);
    }
    catch (HttpRequestException error) when (error.StatusCode is System.Net.HttpStatusCode.Conflict or System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.NotFound)
    {
      _inputEnabled = false;
      await InvokeAsync(StateHasChanged);
      return new(false);
    }
  }

  [JSInvokable]
  public Task OnGatewayTerminalBrowserActive(string sessionId, string generation, string leaseId) => Task.CompletedTask;

  private async Task StopHeartbeatAsync()
  {
    if (_heartbeatId is not { } id || _heartbeat is null) return;
    _heartbeatId = null;
    try { await _heartbeat.InvokeVoidAsync("stopTerminalAttachmentHeartbeat", id); }
    catch (JSDisconnectedException) { return; }
  }

  private async Task CloseSessionAsync()
  {
    try
    {
      var response = await Term.CloseAsync(_session?.SessionId ?? SessionId);
      Snack.Add(response.Message, Severity.Info);
      _session = await Term.GetSessionAsync(SessionId);
    }
    catch (Exception ex)
    {
      Snack.Add($"Failed to close session: {ex.Message}", Severity.Error);
    }
  }

  private Task FitTerminalAsync() =>
    _console?.FitAsync() ?? Task.CompletedTask;

  private Task ClearTerminalAsync() =>
    _console?.ClearAsync() ?? Task.CompletedTask;

  private static string FormatTransport(TerminalTransportKind transport) =>
    transport switch
    {
      TerminalTransportKind.ApiWebSocket => "direct-ws",
      TerminalTransportKind.AkkaGateway => "akka-gateway",
      _ => "auto"
    };

  private Task HandleClosedAsync(string? reason)
  {
    Snack.Add(string.IsNullOrWhiteSpace(reason) ? "Terminal closed." : reason, Severity.Info);
    return Task.CompletedTask;
  }

  private async Task PumpTerminalStreamAsync(CancellationToken ct)
  {
    try
    {
      var streamSessionId = _session?.SessionId ?? SessionId;
      await foreach (var message in Term.StreamSessionAsync(streamSessionId, ct))
      {
        if (message.Kind.Equals("data", StringComparison.OrdinalIgnoreCase))
        {
          var shouldRefresh = false;

          if (!_inputEnabled)
          {
            _inputEnabled = true;
            shouldRefresh = true;
          }

          if (_session is not null && !string.Equals(_session.State, "active", StringComparison.OrdinalIgnoreCase))
          {
            _session = _session with { State = "active" };
            shouldRefresh = true;
          }

          if (shouldRefresh)
          {
            await InvokeAsync(StateHasChanged);
          }

          if (_console is not null)
          {
            await _console.AppendOutputAsync(message.Data ?? string.Empty);
          }

          continue;
        }

        if (message.Kind.Equals("close", StringComparison.OrdinalIgnoreCase))
        {
          _inputEnabled = false;
          if (_session is not null)
          {
            _session = _session with { State = "closed", CloseReason = message.Reason };
            await InvokeAsync(StateHasChanged);
          }

          if (_console is not null)
          {
            await _console.ShowClosedAsync(message.Reason);
          }

          break;
        }
      }
    }
    catch (OperationCanceledException) when (ct.IsCancellationRequested)
    {
      return;
    }
    catch (Exception ex)
    {
      await InvokeAsync(() => Snack.Add($"Terminal stream failed: {ex.Message}", Severity.Error));
    }
  }

  private async Task DisposeStreamAsync()
  {
    if (_streamCts is null)
    {
      return;
    }

    try
    {
      _streamCts.Cancel();
      if (_streamTask is not null)
      {
        await _streamTask;
      }
    }
    catch (OperationCanceledException)
    {
      return;
    }
    finally
    {
      _streamCts.Dispose();
      _streamCts = null;
      _streamTask = null;
    }
  }

  public async ValueTask DisposeAsync()
  {
    await DisposeStreamAsync();
    await StopHeartbeatAsync();
    _heartbeatReference?.Dispose();
    if (_heartbeat is not null)
    {
      try { await _heartbeat.DisposeAsync(); }
      catch (JSDisconnectedException) { return; }
    }
  }
}
