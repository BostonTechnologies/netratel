@using NetRatel.Shared.Contracts
@using NetRatel.Web.Services
@inject IClientArtifactsService Artifacts

<div class="tenant-rollout-context" data-testid="tenant-update-policy">
    <div class="tenant-rollout-selector">
        <MudSelect T="int?" @bind-Value="_selectedTenantId" Label="Tenant rollout policy" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var tenant in Tenants)
            {
                <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name</MudSelectItem>
            }
        </MudSelect>
    </div>
    <details class="tenant-rollout-details" data-testid="tenant-policy-disclosure">
        <summary>
            <span>Tenant rollout eligibility</span>
            @if (SelectedTenant is { } policy)
            {
                <span class="tenant-rollout-status">Updates @(policy.AutoUpdate ? "on" : "off") · @(AllowsPrereleases(policy) ? "Stable + prerelease" : "Stable only")@(!string.IsNullOrWhiteSpace(policy.AutoUpdateTargetVersion) ? " · Pinned" : "")</span>
                @if (policy.AutoUpdate && !AllowsPrereleases(policy) && _publishedPrereleases.Count > 0)
                { <span class="tenant-rollout-attention">Prereleases excluded</span> }
            }
            @if (_loadError is not null) { <span class="tenant-rollout-attention">Eligibility unavailable</span> }
        </summary>
        <div class="tenant-rollout-explanation">
            <MudStack Spacing="1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Global release automation downloads and publishes packages. Each tenant's automatic updates, release channel, and target version pin determine which releases its clients can receive.</MudText>
                @if (_loadError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">@_loadError <MudButton Size="Size.Small" OnClick="LoadEligibilityAsync">Retry</MudButton></MudAlert>
                }
                @if (SelectedTenant is { } selected)
                {
                    <MudText Typo="Typo.body2" data-testid="tenant-policy-current">Automatic updates: @(selected.AutoUpdate ? "on" : "off") · Channel: @(AllowsPrereleases(selected) ? "Stable releases and prereleases" : "Stable releases only")</MudText>
                    @if (!string.IsNullOrWhiteSpace(selected.AutoUpdateTargetVersion))
                    {
                        <MudText Typo="Typo.body2" Style="overflow-wrap: anywhere;">Target version pin: @selected.AutoUpdateTargetVersion. Only this version is eligible within the selected channel. Newer approved releases are excluded until this pin is changed or cleared.</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">No pin / follow selected channel.</MudText>
                    }
                    @if (selected.AutoUpdate && !AllowsPrereleases(selected) && _publishedPrereleases.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" data-testid="tenant-prerelease-excluded">@selected.Name uses stable releases only. Enabled published prereleases (@string.Join(", ", _publishedPrereleases)) are excluded, even when global prerelease deployment is on. Excluded releases create no update attempts. A client already on a beta needs a newer eligible release before an update is offered.</MudAlert>
                    }
                    <MudLink Href="@($"/tenants?search={Uri.EscapeDataString(selected.Name)}")">Edit tenant update policy</MudLink>
                }
            </MudStack>
        </div>
    </details>
</div>

@code {
    [Parameter] public IReadOnlyList<TenantDto> Tenants { get; set; } = [];
    private int? _selectedTenantId;
    private IReadOnlyList<string> _publishedPrereleases = [];
    private string? _loadError;
    private TenantDto? SelectedTenant => Tenants.FirstOrDefault(tenant => tenant.TenantId == _selectedTenantId);
    private static bool AllowsPrereleases(TenantDto tenant) =>
        string.Equals(tenant.AutoUpdateChannel, "prerelease", StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        if (SelectedTenant is null) _selectedTenantId = Tenants.FirstOrDefault()?.TenantId;
    }

    protected override Task OnInitializedAsync() => LoadEligibilityAsync();

    private async Task LoadEligibilityAsync()
    {
        try
        {
            // Request the endpoint's supported bounded page, then sample distinct versions for display.
            var releases = await Artifacts.GetUpdateReleasePageAsync(0, 10, channel: "prerelease", enabled: true);
            _publishedPrereleases = releases.Items.Where(release => release.Enabled && release.Channel == "prerelease")
                .Select(release => release.Version).Distinct(StringComparer.Ordinal).Take(5).ToArray();
            _loadError = null;
        }
        catch (HttpRequestException)
        {
            _loadError = "Published prerelease eligibility is unavailable. The previous sample is retained; tenant policy remains inspectable.";
        }
    }
}
