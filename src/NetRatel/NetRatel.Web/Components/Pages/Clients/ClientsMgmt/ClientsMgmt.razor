    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactiveReady = true;
            StateHasChanged();
        }

        if (_restoreActivityDetailsFocus is { } attemptId)
        {
            _restoreActivityDetailsFocus = null;
            if (_activeTab == ActivityTab && _activityDetailLaunchers.TryGetValue(attemptId, out var launcher))
                await launcher.FocusAsync();
        }

        if (_restoreAutomationFocus && _automationOpener is not null)
        {
            _restoreAutomationFocus = false;
            await _automationOpener.FocusAsync();
        }

        if (_restoreReleaseFocus is { } version && _releaseLaunchers.TryGetValue(version, out var releaseLauncher))
        { _restoreReleaseFocus = null; await releaseLauncher.FocusAsync(); }
        if (_pendingTabReload is int pendingTab && pendingTab == _activeTab)
        {
            // Claim this reload before it renders the table or opens a stream. A child
            // render can reenter OnAfterRender while the server read is still pending.
            _pendingTabReload = null;
            if (!await ReloadActiveTabAsync(pendingTab))
            {
                if (_activeTab == pendingTab && _pendingTabReload is null) _pendingTabReload = pendingTab;
                return;
            }

            // OnAfterRenderAsync does not render again when its awaited reload finishes.
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _tenants = await TenantApi.GetTenantsAsync();
        _selectedTenantId = _tenants.FirstOrDefault()?.TenantId;
        await LoadGitHubAsync(false);
        await LoadAutomationAsync();
        _importPollingTask = PollImportsAsync(_importPolling.Token);
    }

    private async Task OnTabChanged(int index)
    {
        if (index == _activeTab)
        {
            return;
        }

        if (_automationDirty)
        {
            _automationError = "Save or cancel the automation draft before changing tabs.";
            _automationDrawerOpen = true;
            return;
        }

        await StopActivityAsync();
        _activeTab = index;
        _pendingTabReload = index;
        return;
    }

    private async Task<bool> ReloadActiveTabAsync(int index)
    {
        switch (index)
        {
            case 0:
                await LoadGitHubAsync(false);
                await LoadAutomationAsync();
                return true;
            case ActivityTab when _attemptTable is not null:
                await StartActivityAsync();
                await _attemptTable.ReloadServerData();
                return true;
            case SuspendedTab when _suspendedTable is not null:
                await _suspendedTable.ReloadServerData();
                return true;
            default:
                return false;
        }
    }

    private async Task GuardAutomationTabChangeAsync(TabInteractionEventArgs context)
    {
        if (!_automationDirty)
        {
            return;
        }

        context.Cancel = true;
        _automationError = "Save or cancel the automation draft before changing tabs.";
        _automationDrawerOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadGitHubAsync(bool refresh)
    {
        _githubLoadCancellation?.Cancel();
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_importPolling.Token);
        _githubLoadCancellation = cancellation;
        var generation = ++_githubLoadGeneration;
        var channel = _githubChannel;
        var pageNumber = _githubPageNumber;
        var pageSize = _githubPageSize;
        _githubLoading = true;
        _githubError = null;
        try
        {
            var page = await Artifacts.GetReleaseWorkspaceAsync(pageNumber, pageSize, _workspaceSearch,
                channel, _workspaceRuntime, _workspaceLocalState, refresh, cancellation.Token);
            if (_automationDisposed || generation != _githubLoadGeneration || cancellation.IsCancellationRequested) return;
            _workspace = page; _githubPageNumber = page.Page;
            _githubImports = page.Items.SelectMany(x => x.Imports).GroupBy(x => x.GitHubReleaseId).ToDictionary(x => x.Key, x => x.First());
            _localDeletions = page.Items.Where(x => x.Cleanup is not null).Select(x => x.Cleanup!).ToList();

        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (HttpRequestException)
        {
            if (!_automationDisposed && generation == _githubLoadGeneration)
            {
                _githubPageNumber = _workspace?.Page ?? 0;
                _githubError = "Could not refresh the release inventory. The previous page may be stale; refresh before acting on it.";
            }
        }
        finally
        {
            if (generation == _githubLoadGeneration)
            {
                _githubLoading = false;
                _githubLoadCancellation = null;
            }
        }

    }

    private async Task LoadAutomationAsync()
    {
        if (_automationDirty || _automationBusy)
        {
            return;
        }

        var generation = ++_automationLoadGeneration;
        var operationGeneration = _automationOperationGeneration;
        _automationLoading = true;
        _automationError = null;
        try
        {
            var loaded = await Artifacts.GetReleaseAutomationAsync();
            if (_automationDisposed || generation != _automationLoadGeneration ||
                operationGeneration != _automationOperationGeneration || _automationDirty)
            {
                return;
            }

            _automationSaved = CloneAutomation(loaded);
            _automationDraft = CloneAutomation(loaded);
        }
        catch (HttpRequestException)
        {
            if (!_automationDisposed && generation == _automationLoadGeneration &&
                operationGeneration == _automationOperationGeneration)
            {
                _automationError = "Could not load automation settings. Refresh status and try again.";
            }
        }
        finally
        {
            if (generation == _automationLoadGeneration)
            {
                _automationLoading = false;
            }
        }
    }

