        CloseAutomationDrawer();
        return Task.CompletedTask;
    }

    private void CloseAutomationDrawer()
    {
        if (_automationBusy)
        {
            _automationError = "Wait for the current automation operation to finish before closing settings.";
            _automationDrawerOpen = true;
            return;
        }

        if (_automationDirty)
        {
            _automationError = "Unsaved automation changes are still open. Save or cancel them before closing settings.";
            _automationDrawerOpen = true;
            return;
        }

        _automationDrawerOpen = false;
        _restoreAutomationFocus = true;
    }

    private void CancelAutomationDraft()
    {
        if (_automationBusy) return;
        if (_automationSaved is not null)
        {
            _automationDraft = CloneAutomation(_automationSaved);
        }

        _automationError = null;
    }

    private Task RefreshAutomationAsync() => _automationDirty || _automationBusy
        ? Task.CompletedTask
        : LoadAutomationAsync();

    private async Task SaveAutomationAsync()
    {
        if (_automationBusy || _automationDraft is null || !_automationDirty) return;
        if (AutomationValidationError is not null)
        {
            _automationError = AutomationValidationError;
            return;
        }

        _automationBusy = true;
        var operation = BeginAutomationOperation();
        var submitted = CloneAutomation(_automationDraft);
        _automationError = null;
        try
        {
            var saved = await Artifacts.SaveReleaseAutomationAsync(CloneAutomation(submitted));
            if (_automationDisposed || operation != _automationOperationGeneration) return;

            _automationSaved = CloneAutomation(saved);
            if (_automationDraft is not null && SameAutomationPolicy(_automationDraft, submitted))
            {
                _automationDraft = CloneAutomation(saved);
            }
            else
            {
                _automationError = "The policy was saved, but the draft changed while the request was in flight. Review and save the remaining draft.";
            }
        }
        catch (HttpRequestException exception) when (!_automationDisposed && operation == _automationOperationGeneration)
        {
            _automationError = exception.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "Another operator changed this policy. Your draft is preserved; reload saved settings to review the current revision."
                : "Could not save the policy. Check the selected options or refresh status if another operator changed it.";
        }
        finally { _automationBusy = false; }
    }

    private async Task CheckReleasesNowAsync()
    {
        if (_automationBusy) return;
        if (_automationDirty)
        {
            _automationError = "Save or cancel the automation draft before running the saved policy.";
            return;
        }

        _automationBusy = true;
        var savedBefore = _automationSaved is null ? null : CloneAutomation(_automationSaved);
        var operation = BeginAutomationOperation();
        _automationError = null;
        try
        {
            if (savedBefore is { PublishAutomatically: true } or { DeployPrereleaseAutomatically: true })
            {
                var confirmed = await Dialogs.ShowMessageBoxAsync(
                    "Run release automation now",
                    "This may download and publish release packages according to the saved policy. Continue?",
                    yesText: "Run policy", cancelText: "Cancel");
                if (confirmed != true || _automationDisposed || operation != _automationOperationGeneration) return;

                if (_automationDirty || _automationSaved is null ||
                    _automationSaved.Revision != savedBefore.Revision ||
                    !SameAutomationPolicy(_automationSaved, savedBefore))
                {
                    _automationError = "The saved policy changed while confirmation was open. Review it before running again.";
                    return;
                }
            }

            if (_automationDisposed || operation != _automationOperationGeneration) return;

            var result = await Artifacts.CheckReleasesNowAsync();
            if (_automationDisposed || operation != _automationOperationGeneration) return;

            _automationSaved = CloneAutomation(result);
            if (_automationDraft is not null && savedBefore is not null && SameAutomationPolicy(_automationDraft, savedBefore))
            {
                _automationDraft = CloneAutomation(result);
            }
        }
        catch (HttpRequestException) when (!_automationDisposed && operation == _automationOperationGeneration)
        {
            _automationError = "Could not schedule a check. Refresh status and try again.";
        }
        finally { _automationBusy = false; }
    }

    private long BeginAutomationOperation()
    {
        _automationLoadGeneration++;
        _automationLoading = false;
        return ++_automationOperationGeneration;
    }

    private async Task GuardAutomationNavigationAsync(LocationChangingContext context)
    {
        if (!_automationDirty) { await StopActivityAsync(); return; }

        context.PreventNavigation();
        _automationDrawerOpen = true;
        _automationError = "Save or cancel the automation draft before leaving this page.";
        await InvokeAsync(StateHasChanged);
    }

    private static ClientReleaseAutomationModel CloneAutomation(ClientReleaseAutomationModel source) => new()
    {
        CheckEveryHours = source.CheckEveryHours,
        DownloadStable = source.DownloadStable,
        DownloadPrerelease = source.DownloadPrerelease,
        PublishAutomatically = source.PublishAutomatically,
        DeployPrereleaseAutomatically = source.DeployPrereleaseAutomatically,
        LastAttemptAtUtc = source.LastAttemptAtUtc,
        LastSuccessAtUtc = source.LastSuccessAtUtc,
        NextCheckAtUtc = source.NextCheckAtUtc,
        LastError = source.LastError,
        Revision = source.Revision,
        UpdatedBy = source.UpdatedBy,
        UpdatedAtUtc = source.UpdatedAtUtc
    };

    private static bool SameAutomationPolicy(ClientReleaseAutomationModel left, ClientReleaseAutomationModel right) =>
        left.CheckEveryHours == right.CheckEveryHours &&
        left.DownloadStable == right.DownloadStable &&
        left.DownloadPrerelease == right.DownloadPrerelease &&
        left.PublishAutomatically == right.PublishAutomatically &&
        left.DeployPrereleaseAutomatically == right.DeployPrereleaseAutomatically;

    private static string OnOff(bool value) => value ? "on" : "off";

    private static string UtcTime(DateTimeOffset? value) =>
        value.HasValue ? value.Value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'") : "Never";

