    private async Task LoadEndpointPreviewAsync()
    {
        var request = ++_endpointPreviewRequest;
        var tenant = _selectedTenantId;
        _endpointPreview = null;
        _endpointPreviewError = null;
        _endpointPreviewLoading = tenant.HasValue;
        if (!tenant.HasValue) return;
        try
        {
            var preview = await Artifacts.PreviewInstallEndpointsAsync(tenant.Value);
            if (request == _endpointPreviewRequest) _endpointPreview = preview;
        }
        catch (HttpRequestException exception)
        {
            if (request == _endpointPreviewRequest) _endpointPreviewError = exception.Message;
        }
        finally { if (request == _endpointPreviewRequest) _endpointPreviewLoading = false; }
    }
