@page "/clients/mgmt"
@using MudBlazor
@using Microsoft.AspNetCore.Components.Routing
@using NetRatel.Shared
@using NetRatel.Shared.Contracts
@using NetRatel.Web.Services
@using NetRatel.Web.Services.Tenants
@inject IClientArtifactsService Artifacts
@inject ITenantApiService TenantApi
@inject IJSRuntime JsRuntime
@inject IDialogService Dialogs
@implements IAsyncDisposable

@if (_interactiveReady)
{
    <span data-testid="clients-mgmt-interactive" hidden></span>
}
<NavigationLock OnBeforeInternalNavigation="GuardAutomationNavigationAsync" ConfirmExternalNavigation="@_automationDirty" />
<div class="client-mgmt-workspace" data-testid="client-management-workspace">
<header class="client-mgmt-header" data-testid="client-management-header">
    <div class="client-mgmt-identity">
        <MudText Typo="Typo.h6">Agent Installers &amp; Updates</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Release catalogue, installers and rollout activity.</MudText>
    </div>
    <div class="client-mgmt-policy"><TenantUpdatePolicySummary Tenants="_tenants" /></div>
    <MudStack Row="true" Class="flex-wrap client-mgmt-header-actions" Spacing="1">
        <MudButton @ref="_automationOpener" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tune" OnClick="OpenAutomationDrawer" data-testid="automation-settings-button">Automation @if (_automationDirty) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">Unsaved</MudChip> }</MudButton>
        <MudMenu Dense="true" Size="Size.Small" Variant="Variant.Outlined" Label="Advanced" AriaLabel="Advanced: upload artifact" StartIcon="@Icons.Material.Filled.MoreHoriz" data-testid="advanced-client-actions">
            <MudMenuItem Icon="@Icons.Material.Filled.Upload" Disabled="@(!_interactiveReady)" OnClick="OpenUpload">Upload legacy artifact</MudMenuItem>
        </MudMenu>
    </MudStack>
</header>

<MudPaper Class="pa-2 client-mgmt-surface" Elevation="0">
    <MudTabs Rounded="true" KeepPanelsAlive="true" LazyLoadPanels="true" MinimumTabWidth="116px" ActivePanelIndex="@_activeTab" ActivePanelIndexChanged="OnTabChanged" OnPreviewInteraction="GuardAutomationTabChangeAsync" TabPanelsClass="client-mgmt-tab-panel" data-testid="client-management-tabs">
        <MudTabPanel Text="GitHub releases">
            <MudStack Spacing="1" data-testid="github-release-catalogue">
                <details class="client-mgmt-automation-summary" data-testid="release-automation-settings">
                    <summary>Release automation <span class="client-mgmt-summary-status">@AutomationSummary</span>@if (!string.IsNullOrWhiteSpace(_automationSaved?.LastError) || !string.IsNullOrWhiteSpace(_automationError)) { <span class="client-mgmt-summary-error">Attention required</span> }</summary>
                    <div class="pa-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Checks and downloads run here; deployment follows each tenant’s saved channel policy. Edit with Automation above.</MudText>
                        <MudText Typo="Typo.caption">@AutomationStatusSummary</MudText>
                        @if (!string.IsNullOrWhiteSpace(_automationSaved?.LastError)) { <MudAlert Severity="Severity.Warning" Dense="true">@_automationSaved.LastError</MudAlert> }
                        @if (!string.IsNullOrWhiteSpace(_automationError)) { <MudAlert Severity="Severity.Error" Dense="true">@_automationError</MudAlert> }
                    </div>
                </details>
                <MudStack Row="true" Class="flex-wrap" AlignItems="AlignItems.Center" Spacing="1">
                    <MudTextField T="string" Value="_workspaceSearch" ValueChanged="SearchWorkspaceAsync" DebounceInterval="300" Label="Search releases and local packages" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Margin="Margin.Dense" />
                    <MudSelect T="string" Value="_githubChannel" ValueChanged="OnGitHubChannelChanged" Label="Channel" Margin="Margin.Dense">
                        <MudSelectItem Value="@("all")">All channels</MudSelectItem><MudSelectItem Value="@("stable")">Stable</MudSelectItem><MudSelectItem Value="@("prerelease")">Prerelease</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" Value="_workspaceRuntime" ValueChanged="FilterWorkspaceRuntimeAsync" Label="Runtime" Margin="Margin.Dense">
                        <MudSelectItem Value="@string.Empty">All runtimes</MudSelectItem>@foreach (var runtime in RuntimeIds) { <MudSelectItem Value="@runtime">@runtime</MudSelectItem> }
                    </MudSelect>
                    <MudSelect T="string" Value="_workspaceLocalState" ValueChanged="FilterWorkspaceLocalStateAsync" Label="Local state" Margin="Margin.Dense">
                        <MudSelectItem Value="@string.Empty">All states</MudSelectItem><MudSelectItem Value="@("local")">Stored locally</MudSelectItem><MudSelectItem Value="@("remote")">Remote only</MudSelectItem><MudSelectItem Value="@("enabled")">Updates enabled</MudSelectItem><MudSelectItem Value="@("disabled")">Updates disabled</MudSelectItem><MudSelectItem Value="@("cleanup")">Cleanup receipts</MudSelectItem>
                    </MudSelect>
                    <MudTooltip Text="Refresh remote discovery and local inventory"><MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh release catalogue" Disabled="_githubLoading" OnClick="@(() => LoadGitHubAsync(true))" /></MudTooltip>
                </MudStack>
                @if (_workspace?.RefreshedAtUtc > DateTimeOffset.MinValue) { <MudText Typo="Typo.caption">Upstream checked @_workspace.RefreshedAtUtc.ToUniversalTime().ToString("g") UTC</MudText> }
                @if (_githubLoading) { <MudProgressLinear Indeterminate="true" aria-label="Loading release catalogue" /> }
                @if (_githubError is not null) { <MudAlert Severity="Severity.Error">@_githubError</MudAlert> }
                @if (_importsError is not null) { <MudAlert Severity="Severity.Warning">@_importsError</MudAlert> }
                @if (_workspace?.Warning is not null) { <MudAlert Severity="Severity.Warning">@_workspace.Warning</MudAlert> }
                @if (_localDeleteMessage is not null) { <MudAlert Dense="true" Severity="Severity.Info" data-testid="local-release-deletion-status">@_localDeleteMessage</MudAlert> }
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap" Spacing="1" data-testid="release-selection-toolbar">
                    <MudButton Size="Size.Small" Disabled="@(_githubLoading || _workspace?.CanManageCleanup != true)" OnClick="SelectWorkspacePage">Select local versions on this page</MudButton>
                    <MudButton Size="Size.Small" Disabled="@(_githubLoading || _workspace is null || !_workspace.CanManageCleanup || _workspace.SelectableVersions.Length > 100)" OnClick="SelectAllFilteredVersions">Select all filtered local versions</MudButton>
                    @if (_workspace?.SelectableVersions.Length > 100) { <MudText Typo="Typo.caption">More than 100 local matches. Select pages or narrow filters; each reviewed batch allows 100 versions.</MudText> }
                    @if (_selectedVersions.Count > 0)
                    {
                        <MudText Typo="Typo.caption">@_selectedVersions.Count versions selected across pages</MudText>
                        <MudTooltip Text="Preview owned disk assets and blockers for the exact selected versions"><MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Color="Color.Error" aria-label="Preview purge of selected local versions" Disabled="_localDeleteBusy" OnClick="PreviewSelectedCleanupAsync" /></MudTooltip>
                        <MudButton Size="Size.Small" OnClick="@(() => _selectedVersions.Clear())">Clear selection</MudButton>
                    }
                </MudStack>
                <MudTable T="ClientReleaseWorkspaceRowModel" Items="@(_workspace?.Items ?? [])" RowsPerPage="_githubPageSize" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="client-github-table" data-testid="github-release-table">
                    <HeaderContent><MudTh>Details / select</MudTh><MudTh>Release</MudTh><MudTh>Source / local state</MudTh><MudTh>Runtimes / storage</MudTh><MudTh>Actions</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Details / select"><div class="release-cell-content">
                            <MudIconButton @ref="_releaseLaunchers[context.Version]" Icon="@(_expandedVersions.Contains(context.Version) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" aria-label="@($"Details for {context.Version}")" aria-expanded="@_expandedVersions.Contains(context.Version).ToString().ToLowerInvariant()" OnClick="@(() => ToggleReleaseDetailsAsync(context.Version))" data-testid="release-details-toggle" />
                            <MudCheckBox T="bool" Value="@_selectedVersions.Contains(context.Version)" ValueChanged="@(value => SelectVersion(context.Version, value))" Disabled="@(_workspace?.CanManageCleanup != true || !context.HasLocal && context.Cleanup?.State is not ("Pending" or "Failed"))" aria-label="@($"Select local version {context.Version}")" Size="Size.Small" />
                        </div></MudTd>
                        <MudTd DataLabel="Release"><div class="release-cell-content">
                            <MudText Typo="Typo.subtitle2" data-testid="github-release-name">@context.Name</MudText>
                            <MudText Typo="Typo.caption">@context.Version · @context.Channel @context.PublishedAtUtc?.ToUniversalTime().ToString("g")</MudText>
                            @if (context.Remote is not null) { <MudLink Href="@context.Remote.DetailsUrl" Target="_blank" rel="noopener noreferrer" Typo="Typo.caption">Upstream release</MudLink> }
                            else { <MudText Typo="Typo.caption">Local only · upstream availability unconfirmed</MudText> }
                        </div></MudTd>
                        <MudTd DataLabel="Source / local state"><div class="release-cell-content">
                            <MudText Typo="Typo.caption">Source: @(_sourceStates.GetValueOrDefault(context.Version)?.State ?? context.SourceState)</MudText>
                            @if (context.Cleanup is not null) { <MudText Typo="Typo.caption">Cleanup: @context.Cleanup.State · @(context.Cleanup.Suppressed ? "automatic re-import suppressed" : "re-import allowed")</MudText> }
                            @foreach (var import in context.Imports)
                            {
                                <MudText Typo="Typo.caption">Local: @(import.PublishedAtUtc.HasValue ? "Approved / Published" : ImportState(import.State)) · @FormatBytes(import.DownloadedBytes) / @FormatBytes(import.TotalBytes ?? 0)</MudText>
                                @if (import.Error is not null) { <MudText Typo="Typo.caption" Color="Color.Error">@import.Error</MudText> }
                                @if (import.AutomaticPublishError is not null) { <MudText Typo="Typo.caption" Color="Color.Warning">Automatic publication: @import.AutomaticPublishError</MudText> }
                            }
                            @if (context.Imports.Count == 0 && context.Packages.Count > 0) { <MudText Typo="Typo.caption">Local upload · @(context.Releases.Count > 0 ? "Published" : "Stored package")</MudText> }
                            @if (!context.HasLocal && context.Cleanup is null) { <MudText Typo="Typo.caption">Not downloaded to this instance</MudText>@if (context.Remote is not null) { <MudText Typo="Typo.caption">Catalogue evidence: @context.Remote.PublicationState</MudText> } }
                        </div></MudTd>
                        <MudTd DataLabel="Runtimes / storage"><div class="release-cell-content">
                            <div class="release-runtime-chips">@foreach (var runtime in WorkspaceRuntimes(context)) { <MudChip T="string" Size="Size.Small">@runtime</MudChip> }</div>
                            <MudText Typo="Typo.caption">@context.Releases.Count(x => x.Enabled) / @context.Releases.Count runtime updates enabled</MudText>
                            <MudText Typo="Typo.caption">Archives @FormatBytes(context.ArchiveBytes) · @(_cleanupPlans.TryGetValue(context.Version, out var plan) ? FormatBytes(plan.ReclaimableBytes) + " owned bytes reclaimable" : "expand for owned disk size")</MudText>
                        </div></MudTd>
                        <MudTd DataLabel="Actions" data-testid="github-release-actions"><div class="release-cell-content">
                            <div class="release-actions">
                            @if (context.Remote is not null && (context.Imports.Count == 0 || context.Cleanup?.Suppressed == true))
                            { <MudTooltip Text="@(context.Remote.PublicationState == "verification required" ? "Download and verify this release pack into this server instance" : "Import unavailable: " + context.Remote.PublicationState)"><MudIconButton Icon="@Icons.Material.Filled.CloudDownload" Color="Color.Primary" aria-label="Download release pack into this instance" Disabled="@(!_interactiveReady || _importActionBusy || context.Remote.PublicationState != "verification required" || context.Cleanup?.State is "Pending" or "Failed")" OnClick="@(() => QueueImportAsync(context.Remote.Id))" data-testid="github-import-pack" /></MudTooltip> }
                            @foreach (var import in context.Imports)
                            {
                                @if (import.State is 6 or 7) { <MudTooltip Text="Retry this local import"><MudIconButton Icon="@Icons.Material.Filled.Replay" aria-label="Retry local import" Disabled="_importActionBusy" OnClick="@(() => RetryImportAsync(import.Id))" /></MudTooltip> }
                                else if (import.State == 5 && !import.PublishedAtUtc.HasValue) { <MudTooltip Text="Approve this fully verified pack and publish under tenant rollout policies"><MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" aria-label="Approve verified import" Disabled="@(_importActionBusy || _workspace?.CanManageCleanup != true)" OnClick="@(() => PublishImportAsync(import.Id, context.Channel == "prerelease"))" /></MudTooltip> }
                                else if (import.State != 5) { <MudTooltip Text="Cancel local import and drain its lease"><MudIconButton Icon="@Icons.Material.Filled.Cancel" aria-label="Cancel local import" Disabled="_importActionBusy" OnClick="@(() => CancelImportAsync(import.Id))" /></MudTooltip> }
                            }
                            @if (context.Packages.Count == 1)
                            {
                                <MudTooltip Text="Download this local archive to your computer"><MudIconButton Icon="@Icons.Material.Filled.Download" aria-label="Download local package to computer" OnClick="@(() => OpenDownload(context.Packages[0]))" /></MudTooltip>
                                <MudTooltip Text="Generate an installer using the selected tenant and runtime"><MudIconButton Icon="@Icons.Material.Filled.Terminal" aria-label="Generate install script" Disabled="@(!CanUsePackage(context, context.Packages[0]))" OnClick="@(() => OpenScript(context.Packages[0]))" /></MudTooltip>
                            }
                            else if (context.Packages.Count > 1)
                            {
                                <MudMenu Icon="@Icons.Material.Filled.Download" aria-label="Choose runtime package to download" Dense="true">@foreach (var package in context.Packages) { <MudMenuItem OnClick="@(() => OpenDownload(package))">@package.Rid · @package.FileName</MudMenuItem> }</MudMenu>
                                <MudMenu Icon="@Icons.Material.Filled.Terminal" aria-label="Choose runtime for install script" Dense="true">@foreach (var package in context.Packages) { <MudMenuItem Disabled="@(!CanUsePackage(context, package))" OnClick="@(() => OpenScript(package))">@package.Rid</MudMenuItem> }</MudMenu>
                            }
                            @if (_workspace?.CanManageCleanup == true && (context.HasLocal || context.Cleanup?.State is "Pending" or "Failed")) { <MudTooltip Text="Review deletion of all local runtime assets for this version"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" aria-label="@($"Preview local purge for {context.Version}")" Disabled="_localDeleteBusy" OnClick="@(() => DeleteLocalReleaseAsync(context.Version))" /></MudTooltip> }
                            </div>
                        </div></MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (_expandedVersions.Contains(context.Version))
                        {
                            <MudTr @key="context.Version" Class="release-details-row" data-testid="release-details-row"><td colspan="5" class="release-details-cell">
                            <MudExpansionPanels Elevation="0" Outlined="true"><MudExpansionPanel Expanded="true" ExpandedChanged="@(expanded => SetReleaseExpandedAsync(context.Version, expanded))" Class="release-details-panel">
                                <TitleContent><div class="release-details-heading"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" Color="Color.Primary" Size="Size.Small" /><strong>Local assets</strong><span>@context.Version · all runtime packages</span></div></TitleContent>
                                <ChildContent>
                                    <div class="release-details-grid">
                                    @foreach (var package in context.Packages)
                                    {
                                        <section class="release-details-card" aria-label="@($"Local asset {package.Rid}")">
                                            <h3>@package.Rid · @package.FileName</h3>
                                            <dl><div><dt>Archive size</dt><dd>@FormatBytes(package.Size)</dd></div><div><dt>Uploaded / imported</dt><dd>@package.UploadedAt.ToUniversalTime().ToString("g") UTC</dd></div><div><dt>SHA256</dt><dd><code>@package.Sha256</code><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="Copy package SHA256" OnClick="@(() => CopyAsync(package.Sha256))" /></dd></div></dl>
                                            @foreach (var import in context.Imports.Where(x => x.Assets.Any(a => a.RuntimeId == package.Rid))) { <MudText Typo="Typo.caption">Provenance: @import.Tag · @(import.PublishedAtUtc.HasValue ? "verified and approved" : ImportState(import.State))</MudText> }
                                            @if (!context.Imports.Any(x => x.Assets.Any(a => a.RuntimeId == package.Rid))) { <MudText Typo="Typo.caption">Manual upload · local checksum metadata</MudText> }
                                            @foreach (var release in context.Releases.Where(x => x.RuntimeId == package.Rid)) { <MudText Typo="Typo.caption">Runtime updates @(release.Enabled ? "Enabled" : "Disabled") · published @release.PublishedAt.ToUniversalTime().ToString("g") UTC</MudText><MudTooltip Text="Disable updates for only this runtime"><MudIconButton Icon="@Icons.Material.Filled.PauseCircleOutline" aria-label="@($"Disable {release.RuntimeId} updates only")" Disabled="@(!release.Enabled || _importActionBusy)" OnClick="@(() => DisableRelease(release))" /></MudTooltip>@if (!release.Enabled) { <MudTooltip Text="Enable this approved runtime package under existing tenant policies"><MudIconButton Icon="@Icons.Material.Filled.PlayCircleOutline" aria-label="@($"Enable {release.RuntimeId} updates only")" Disabled="_importActionBusy" OnClick="@(() => EnableRuntimeAsync(release))" /></MudTooltip> } }
                                            <MudTooltip Text="Download archive to your computer"><MudIconButton Icon="@Icons.Material.Filled.Download" aria-label="@($"Download {package.Rid} archive")" OnClick="@(() => OpenDownload(package))" /></MudTooltip>
                                            <MudTooltip Text="Generate installer; verified imports must first be approved"><MudIconButton Icon="@Icons.Material.Filled.Terminal" aria-label="@($"Generate {package.Rid} install script")" Disabled="@(!CanUsePackage(context, package))" OnClick="@(() => OpenScript(package))" /></MudTooltip>
                                        </section>
                                    }
                                    @foreach (var import in context.Imports)
                                    {
                                        <section class="release-details-card"><h3>Import · @import.Tag</h3><MudText Typo="Typo.caption">@(import.PublishedAtUtc.HasValue ? "Approved / Published" : ImportState(import.State)) · @FormatBytes(import.DownloadedBytes) / @FormatBytes(import.TotalBytes ?? 0)</MudText>@foreach (var asset in import.Assets) { <MudText Typo="Typo.caption">@asset.RuntimeId · @asset.SourceName · @FormatBytes(asset.DownloadedBytes) / @FormatBytes(asset.SourceSizeBytes) · @asset.Error</MudText> }</section>
                                    }
                                    <section class="release-details-card"><h3>Source availability</h3><MudText Typo="Typo.caption">@(_sourceStates.GetValueOrDefault(context.Version)?.State ?? context.SourceState) · @(_sourceStates.GetValueOrDefault(context.Version)?.Message ?? "Source discovery and local verification are independent. Check the exact imported release and tag to confirm absence or change.")</MudText><MudTooltip Text="Inspect exact upstream release, tag and asset identities"><MudIconButton Icon="@Icons.Material.Filled.FactCheck" aria-label="Check upstream source" OnClick="@(() => CheckSourceAsync(context.Version))" /></MudTooltip></section>
                                    <section class="release-details-card"><h3>Version-wide local cleanup</h3>
                                        @if (_cleanupPlans.TryGetValue(context.Version, out var plan)) { <MudText Typo="Typo.caption">@FormatBytes(plan.ReclaimableBytes) owned bytes reclaimable</MudText><ReleaseCleanupDependencies Plan="plan" Busy="_localDeleteBusy" Resolve="@(blocker => ResolveCleanupBlockerAsync(context.Version, blocker))" Inspect="@(blocker => InspectCleanupAttemptAsync(context.Version, blocker))" /> }
                                        else { <MudText Typo="Typo.caption">@(_detailErrors.GetValueOrDefault(context.Version) ?? "Loading owned assets and dependencies…")</MudText> }
                                        @if (context.Cleanup is not null) { <MudText Typo="Typo.caption">Cleanup @context.Cleanup.State · @context.Cleanup.Error · @(context.Cleanup.Suppressed ? "Automatic re-import suppressed until deliberate import" : "Deliberate re-import allowed")</MudText> }
                                        <MudTooltip Text="@(context.HasLocal || context.Cleanup?.State is "Pending" or "Failed" ? "Review version-wide owned file deletion" : "There are no retained local files to purge")"><MudButton Size="Size.Small" Color="Color.Error" Disabled="@(_localDeleteBusy || _workspace?.CanManageCleanup != true || !context.HasLocal && context.Cleanup?.State is not ("Pending" or "Failed"))" OnClick="@(() => DeleteLocalReleaseAsync(context.Version))">Review all-runtime cleanup</MudButton></MudTooltip>
                                        <MudButton Size="Size.Small" OnClick="@(() => LoadCleanupDetailsAsync(context.Version))">Refresh dependencies</MudButton>
                                    </section>
                                    </div>
                                </ChildContent>
                            </MudExpansionPanel></MudExpansionPanels>
                            </td></MudTr>
                        }
                    </ChildRowContent>
                    <NoRecordsContent><MudText Typo="Typo.body2">@(_githubError is null ? "No releases or local versions match these filters." : "Release inventory unavailable. Refresh to retry.")</MudText></NoRecordsContent>
                </MudTable>
                <ClientManagementPager Label="GitHub releases" Page="_githubPageNumber" PageSize="_githubPageSize" ItemCount="@(_workspace?.Items.Count ?? 0)" Total="@(_workspace?.Total ?? 0)" HasMore="@((_githubPageNumber + 1) * _githubPageSize < (_workspace?.Total ?? 0))" Busy="_githubLoading" PageChanged="ChangeGitHubPageAsync" PageSizeChanged="ChangeGitHubPageSizeAsync" />
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Activity">
                <MudStack Spacing="2" data-testid="attempt-management-panel">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap" Spacing="1">
                        <MudText Typo="Typo.caption" role="status" aria-live="polite" data-testid="activity-live-status">@_activityStatus@if (_activityUpdatedAt is { } updated) { <span> · Updated @ActivityTime(updated)</span> }</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_attemptsLoading" OnClick="RefreshActivityAsync" data-testid="activity-refresh">Refresh</MudButton>
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(_activityError)) { <MudAlert Severity="Severity.Warning" Dense="true" data-testid="activity-refresh-error">@_activityError</MudAlert> }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Groups count this filtered page.</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4"><MudTextField T="string" Value="@_attemptSearch" ValueChanged="OnAttemptSearchChanged" Immediate="true" Label="Search attempts" Placeholder="Hostname, tenant, version, status" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" data-testid="attempt-search" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudSelect T="int?" Value="_attemptTenantId" ValueChanged="OnAttemptTenantChanged" Label="Tenant"><MudSelectItem T="int?" Value="@null">All tenants</MudSelectItem>@foreach (var tenant in _tenants) { <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudSelect T="string" Value="@_attemptRid" ValueChanged="OnAttemptRidChanged" Label="Runtime"><MudSelectItem Value="@string.Empty">All runtimes</MudSelectItem>@foreach (var runtimeId in RuntimeIds) { <MudSelectItem Value="@runtimeId">@runtimeId</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudTextField T="string" Value="@_attemptVersion" ValueChanged="OnAttemptVersionChanged" Immediate="true" Label="Version" Clearable="true" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudSelect T="string" Value="@_attemptStatus" ValueChanged="OnAttemptStatusChanged" Label="Status"><MudSelectItem Value="@string.Empty">All states</MudSelectItem>@foreach (var state in UpdateStatuses) { <MudSelectItem Value="@state">@state</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudSelect T="string" Value="@_attemptGrouping" ValueChanged="OnAttemptGroupingChanged" Label="Group current page" data-testid="attempt-grouping"><MudSelectItem Value="@("None")">None</MudSelectItem><MudSelectItem Value="@("Tenant")">Tenant</MudSelectItem><MudSelectItem Value="@("Version")">Version</MudSelectItem><MudSelectItem Value="@("RID")">RID</MudSelectItem><MudSelectItem Value="@("Status")">Status</MudSelectItem></MudSelect></MudItem>
                    </MudGrid>
                    <div class="client-activity-table">
                    <MudTable T="ClientUpdateHistoryItemModel" @ref="_attemptTable" RowsPerPage="20" ServerData="LoadAttemptsAsync" GroupBy="AttemptGroup" RowStyleFunc="ActivityRowStyle" Dense="true" Hover="true" Loading="_attemptsLoading" Breakpoint="Breakpoint.Sm" data-testid="attempt-table">
                        <HeaderContent><MudTh>Client</MudTh><MudTh>Release</MudTh><MudTh>Status</MudTh><MudTh>Failure</MudTh><MudTh>Updated</MudTh></HeaderContent>
                        <GroupHeaderTemplate><td colspan="5"><MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"><MudIconButton Class="mud-table-row-expander" Size="Size.Small" Icon="@(IsActivityGroupExpanded(context.Key) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" OnClick="@(() => ToggleActivityGroup(context.Key))" aria-label="@(IsActivityGroupExpanded(context.Key) ? "Collapse group" : "Expand group")" aria-expanded="@IsActivityGroupExpanded(context.Key).ToString().ToLowerInvariant()" /><MudText Typo="Typo.subtitle2">@context.Key <span class="text-secondary">(@context.Items.Count() on this page)</span></MudText></MudStack></td></GroupHeaderTemplate>
                        <RowTemplate>
                            <MudTd DataLabel="Client"><MudTooltip Text="@context.AgentId.ToString()"><MudStack Spacing="0"><MudText Typo="Typo.body2">@ClientTarget(context.ClientHostName, context.ClientDisplayName, context.AgentId)</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@(context.TenantName ?? $"Tenant {context.TenantId}")@(DisplaySecondaryName(context.ClientHostName, context.ClientDisplayName))</MudText></MudStack></MudTooltip></MudTd>
                            <MudTd DataLabel="Release"><MudText Typo="Typo.body2">@context.RuntimeId · Target @context.TargetVersion</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Running observed: @(context.ObservedRunningVersion ?? "unknown")@(context.ObservedRunningVersion is null ? string.Empty : context.PresenceActive ? " · online" : " · last known")</MudText>@if (context.LocalPackagePurged) { <MudText Typo="Typo.caption" Color="Color.Secondary">Historical · local package deleted</MudText> }</MudTd>
                            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@UpdateStatusColor(context.Status)">@context.Status</MudChip><MudText Typo="Typo.caption">@InstallationSummary(context)</MudText><MudText Typo="Typo.caption">@ServerReportSummary(context)</MudText>@if (context.ReconciliationState is not null) { <MudText Typo="Typo.caption" Color="Color.Warning">Reconciliation required</MudText> }@if (context.SuspendedAtUtc is not null) { <MudText Typo="Typo.caption" Color="Color.Warning">Automatic updates suspended</MudText> }</MudTd>
                            <MudTd DataLabel="Failure">
                                <MudTooltip Text="@(context.ReportedMessage ?? context.Message ?? context.ReportedFailureCode ?? context.FailureCode ?? "No failure detail")"><span class="client-mgmt-clamp">@(context.ReportedFailureCode ?? context.FailureCode ?? context.ReportedMessage ?? context.Message ?? "—")</span></MudTooltip>
                                <button type="button" class="client-activity-details-toggle" @ref="_activityDetailLaunchers[context.AttemptId]" @onclick="() => ToggleActivityDetails(context.AttemptId)" aria-expanded="@_expandedActivityAttempts.Contains(context.AttemptId).ToString().ToLowerInvariant()" aria-controls="@($"attempt-details-{context.AttemptId:D}")" data-testid="attempt-details-toggle">
                                    <MudIcon Icon="@(_expandedActivityAttempts.Contains(context.AttemptId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />Details
                                </button>
                            </MudTd>
                            <MudTd DataLabel="Updated">@ActivityTime(context.UpdatedAtUtc)</MudTd>
                        </RowTemplate>
                        <ChildRowContent>
                            @if (_expandedActivityAttempts.Contains(context.AttemptId))
                            {
                                <MudTr @key="context.AttemptId" Class="client-activity-details-row" Style="@ActivityRowStyle(context, 0)" data-testid="attempt-details-row">
                                    <td colspan="5" class="client-activity-details-cell">
                                        <ClientUpdateAttemptDetails Item="context" OperatorAction="@OperatorAction(context)" ExpandedChanged="expanded => SetActivityDetailsExpanded(context.AttemptId, expanded)" />
                                    </td>
                                </MudTr>
                            }
                        </ChildRowContent>
                        <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">@(_activityError is null ? "No update attempts match the active filters." : "Activity is unavailable. Use Refresh to retry.")</MudText></NoRecordsContent>
                        <PagerContent><MudTablePager PageSizeOptions="PageSizes" InfoFormat="@ActivityCountFormat" /></PagerContent>
                    </MudTable>
                    </div>
                </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Suspended">
                <MudStack Spacing="2" data-testid="suspended-management-panel">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Resume affects only future automatic updates for the selected suspended client.</MudText>
                    <MudGrid Spacing="2"><MudItem xs="12" md="6"><MudTextField T="string" Value="_suspendedSearch" ValueChanged="OnSuspendedSearchChanged" Immediate="true" Label="Search suspended agents" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" data-testid="suspended-search" /></MudItem><MudItem xs="12" md="3"><MudSelect T="int?" Value="_suspendedTenantId" ValueChanged="OnSuspendedTenantChanged" Label="Tenant"><MudSelectItem T="int?" Value="@null">All tenants</MudSelectItem>@foreach (var tenant in _tenants) { <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name</MudSelectItem> }</MudSelect></MudItem></MudGrid>
                    <MudTable T="AgentClientUpdateStateModel" @ref="_suspendedTable" RowsPerPage="20" ServerData="LoadSuspendedAsync" Dense="true" Hover="true" Loading="_suspendedLoading" Breakpoint="Breakpoint.Sm" data-testid="suspended-table">
                        <HeaderContent><MudTh>Client</MudTh><MudTh>Reason</MudTh><MudTh>Suspended</MudTh><MudTh></MudTh></HeaderContent>
                        <RowTemplate><MudTd DataLabel="Client"><MudTooltip Text="@context.AgentId.ToString()"><MudStack Spacing="0"><MudText Typo="Typo.body2">@StateTarget(context)</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@(context.TenantName ?? $"Tenant {context.TenantId}")@(DisplaySecondaryName(context.ClientHostName, context.ClientDisplayName))</MudText></MudStack></MudTooltip></MudTd><MudTd DataLabel="Reason"><span class="client-mgmt-clamp">@(context.SuspensionReason ?? "—")</span></MudTd><MudTd DataLabel="Suspended">@context.SuspendedAtUtc?.ToLocalTime().ToString("g")</MudTd><MudTd><MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => Resume(context))">Resume future updates</MudButton></MudTd></RowTemplate>
                        <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">No clients have auto-update suspended.</MudText></NoRecordsContent>
                        <PagerContent><MudTablePager PageSizeOptions="PageSizes" /></PagerContent>
                    </MudTable>
                </MudStack>
        </MudTabPanel>
    </MudTabs>
</MudPaper>
</div>

<MudDrawer Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(560px, 100vw)"
           Open="_automationDrawerOpen" OpenChanged="OnAutomationDrawerChanged" OverlayAutoClose="false">
    <MudStack Class="client-mgmt-automation-drawer" Spacing="0" data-testid="automation-drawer">
        <MudStack Class="pa-4 client-mgmt-automation-content" Spacing="2" data-testid="automation-drawer-content">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Release automation settings</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Draft changes stay local until you save them.</MudText>
            </MudStack>
            <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Close automation settings" OnClick="CloseAutomationDrawer" data-testid="close-automation-settings" />
        </MudStack>
        @if (_automationDraft is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            @if (_automationDirty)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" data-testid="automation-unsaved">Unsaved changes. Refresh is disabled until you save or cancel this draft.</MudAlert>
            }
            <MudPaper Class="client-mgmt-automation-group pa-3" Elevation="0">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">Schedule &amp; downloads</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Choose how often this instance checks GitHub and which packages it stages for verification.</MudText>
                    <MudSelect T="int" @bind-Value="_automationDraft.CheckEveryHours" Label="Automatic checks (UTC)" Margin="Margin.Dense" Disabled="_automationBusy" data-testid="automation-check-frequency">
                        <MudSelectItem Value="0">Off</MudSelectItem>
                        <MudSelectItem Value="12">Twice daily</MudSelectItem>
                        <MudSelectItem Value="24">Daily</MudSelectItem>
                    </MudSelect>
                    <MudSwitch T="bool" @bind-Value="_automationDraft.DownloadStable" Color="Color.Primary" Label="Download new stable releases" Disabled="_automationBusy" data-testid="automation-download-stable" />
                    <MudSwitch T="bool" @bind-Value="_automationDraft.DownloadPrerelease" Color="Color.Warning" Label="Include prereleases in downloads" Disabled="_automationBusy" data-testid="automation-download-prerelease" />
                </MudStack>
            </MudPaper>
            <MudPaper Class="client-mgmt-automation-group pa-3" Elevation="0">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">Publication</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Imports remain verification-required until this saved policy permits automatic publication.</MudText>
                    <MudSwitch T="bool" @bind-Value="_automationDraft.PublishAutomatically" Color="Color.Warning" Label="Publish verified imports automatically" Disabled="_automationBusy" data-testid="automation-publish-automatically" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Importing a release may therefore be followed by automatic publication under this policy.</MudText>
                </MudStack>
            </MudPaper>
            <MudPaper Class="client-mgmt-automation-group pa-3" Elevation="0">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">Prerelease rollout</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Only tenants already allowing prereleases can receive an automatic prerelease deployment.</MudText>
                    <MudSwitch T="bool" @bind-Value="_automationDraft.DeployPrereleaseAutomatically" Color="Color.Error" Label="Allow automatic prerelease deployment" Disabled="_automationBusy" data-testid="automation-deploy-prerelease" />
                    @if (AutomationValidationError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" data-testid="automation-validation">@AutomationValidationError</MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">Automatic prerelease deployment can update enrolled clients on prerelease-enabled tenant policies. Existing disabled releases and suspended agents remain blocked.</MudAlert>
                    }
                </MudStack>
            </MudPaper>
            <MudDivider />
            <MudText Typo="Typo.subtitle2">Saved policy status</MudText>
            <MudText Typo="Typo.caption">Last attempt: @UtcTime(_automationSaved?.LastAttemptAtUtc) · Last success: @UtcTime(_automationSaved?.LastSuccessAtUtc) · Next check: @UtcTime(_automationSaved?.NextCheckAtUtc)</MudText>
            @if (_automationSaved?.UpdatedAtUtc is not null)
            {
                <MudText Typo="Typo.caption">Policy updated by @_automationSaved.UpdatedBy at @UtcTime(_automationSaved.UpdatedAtUtc)</MudText>
            }
            @if (_automationBusy)
            {
                <MudAlert Severity="Severity.Info" Dense="true" data-testid="automation-saving">Automation operation in progress…</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_automationError))
            {
                <MudAlert Severity="Severity.Error" data-testid="automation-drawer-error">@_automationError</MudAlert>
            }
        }
        </MudStack>
        @if (_automationDraft is not null)
        {
            <MudPaper Class="client-mgmt-automation-action-footer pa-4" Elevation="0" data-testid="automation-action-footer">
                <MudStack Row="true" Class="flex-wrap" Spacing="1">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_automationBusy || !_automationDirty || AutomationValidationError is not null)" OnClick="SaveAutomationAsync" data-testid="save-automation-policy">Save policy</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="@(_automationBusy || !_automationDirty)" OnClick="CancelAutomationDraft" data-testid="cancel-automation-policy">Cancel</MudButton>
                </MudStack>
                <MudStack Row="true" Class="flex-wrap" Spacing="1">
                    <MudButton Variant="Variant.Outlined" Disabled="@(_automationBusy || _automationDirty)" OnClick="CheckReleasesNowAsync" data-testid="run-automation-policy">Run saved policy now</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="@(_automationBusy || _automationLoading || _automationDirty)" OnClick="RefreshAutomationAsync" data-testid="reload-automation-policy">Reload saved settings</MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudDrawer>

<MudOverlay Visible="_downloadDialogOpen" AutoClose="false" DarkBackground="true">
    <MudPaper Class="pa-4 mx-auto mt-12" Style="max-width: 520px;"><MudStack Spacing="2"><MudText Typo="Typo.h6">Download Client Package</MudText><MudText Typo="Typo.body2">Installer will auto-enroll on first run; no token is embedded.</MudText><MudSelect T="int?" Label="Tenant" @bind-Value="_selectedTenantId" Required="true">@foreach (var tenant in _tenants) { <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name (@tenant.TenantId)</MudSelectItem> }</MudSelect><MudSelect T="ClientEnvironment" Label="Environment" @bind-Value="_selectedEnvironment"><MudSelectItem T="ClientEnvironment" Value="ClientEnvironment.Dev">Dev</MudSelectItem><MudSelectItem T="ClientEnvironment" Value="ClientEnvironment.Prod">Prod</MudSelectItem><MudSelectItem T="ClientEnvironment" Value="ClientEnvironment.Both">Dev + Prod</MudSelectItem></MudSelect><MudSelect T="string" Label="Runtime" @bind-Value="_selectedRuntimeId">@foreach (var runtimeId in RuntimeIds) { <MudSelectItem Value="@runtimeId">@runtimeId</MudSelectItem> }</MudSelect><MudCheckBox T="bool" Label="Inject enrollment code" @bind-Value="_injectEnrollment" />@if (_injectEnrollment) { <MudSelect T="int?" Label="Validity" @bind-Value="_validityMinutes">@foreach (var preset in _validityPresets) { <MudSelectItem T="int?" Value="@preset.Minutes">@preset.Label</MudSelectItem> }</MudSelect><MudNumericField T="int" Label="Max uses" Min="1" @bind-Value="_maxUses" /> }<MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1"><MudButton Variant="Variant.Text" OnClick="CloseDownloadDialog">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanDownload())" OnClick="DownloadSelectedAsync">Download</MudButton></MudStack></MudStack></MudPaper>
</MudOverlay>

<MudDialog Visible="_scriptDialogOpen" VisibleChanged="ScriptVisibleChanged" AriaLabel="Generate deployment script"
           Class="client-deployment-dialog"
           Options="@(new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false, FullWidth = true, MaxWidth = MaxWidth.Large })">
    <TitleContent>Generate deployment script</TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            @if (_scriptResult is null || _scriptEditing)
            {
            <MudText Typo="Typo.body2">The public install URL can be used by anyone holding it until the enrollment allowance expires or is revoked.</MudText>
            <MudText Typo="Typo.body2">Selected artifact: @_scriptRuntimeId @(_scriptArtifactVersion ?? "latest")</MudText>
            <MudSelect T="int?" Label="Tenant" @bind-Value="_selectedTenantId" @bind-Value:after="LoadEndpointPreviewAsync" Required="true">
                @foreach (var tenant in _tenants) { <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name (@tenant.TenantId)</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" Label="Runtime" Value="_scriptRuntimeId" ValueChanged="OnScriptRuntimeChanged">
                @foreach (var runtimeId in RuntimeIds) { <MudSelectItem Value="@runtimeId">@runtimeId</MudSelectItem> }
            </MudSelect>
            <MudSelect T="int?" Label="Validity" @bind-Value="_scriptValidityMinutes">
                @foreach (var preset in _validityPresets) { <MudSelectItem T="int?" Value="@preset.Minutes">@preset.Label</MudSelectItem> }
            </MudSelect>
            <MudNumericField T="int" Label="Max uses" Min="1" @bind-Value="_scriptMaxUses" />
            <MudCheckBox T="bool" Label="Install as Service" @bind-Value="_scriptInstallAsService" />
            <MudCheckBox T="bool" Label="Silent install" @bind-Value="_scriptSilentInstall" />
            @if (_endpointPreviewLoading) { <MudText Typo="Typo.caption" role="status">Resolving public endpoints…</MudText> }
            @if (_endpointPreview is not null) { <ClientEndpointSummary Endpoints="_endpointPreview" Label="Endpoint preview" /> }
            @if (!string.IsNullOrWhiteSpace(_endpointPreviewError)) { <MudAlert Severity="Severity.Error">@_endpointPreviewError</MudAlert> }
            }
            @if (_scriptGenerating) { <div role="status"><MudProgressLinear Indeterminate="true" /><MudText>Generating protected install link…</MudText></div> }
            @if (!string.IsNullOrWhiteSpace(_scriptError)) { <MudAlert Severity="Severity.Error">@_scriptError</MudAlert> }
            @if (_scriptResult is not null)
            {
                @if (ScriptResultIsStale()) { <MudAlert Severity="Severity.Warning">Options changed. Generate a new link for these selections.</MudAlert> }
                @if (_scriptResultRevoked) { <MudAlert Severity="Severity.Warning">This link has been revoked. Existing enrolled clients remain active.</MudAlert> }
                <MudText Typo="Typo.subtitle1">Generated install link</MudText>
                <MudText Typo="Typo.body2">Tenant @_scriptResult.TenantId · @_scriptResult.RuntimeId · @_scriptResult.ArtifactVersion</MudText>
                @if (_scriptResult.Endpoints is not null) { <ClientEndpointSummary Endpoints="_scriptResult.Endpoints" Label="Endpoints stored with this link" /> }
                @if (_endpointPreviewChanged) { <MudAlert Severity="Severity.Info">The endpoints differ from the preview. This link uses the stored values shown above.</MudAlert> }
                <MudText Typo="Typo.body2">Expires @_scriptResult.ExpiresAtUtc.UtcDateTime.ToString("u") UTC (@_scriptResult.ExpiresAtUtc.ToLocalTime().ToString("g") local). @_scriptResult.RemainingUses of @_scriptResult.MaxUses enrollments remain.</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RefreshGeneratedLinkAsync">Refresh status</MudButton>
                <MudText Typo="Typo.caption">Fetching, previewing, copying, and downloading the script do not spend an enrollment use. Service installation may require administrator or root privileges.</MudText>
                <InstallCodeBlock Label="Install command" Value="@_scriptResult.InstallCommand" CopyLabel="Copy command" OnCopy="CopyInstallTextAsync" />
                <InstallCodeBlock Label="Public script URL" Value="@_scriptResult.PublicUrl" CopyLabel="Copy URL" OnCopy="CopyInstallTextAsync" />
                @if (!string.IsNullOrWhiteSpace(_scriptCopyMessage)) { <MudText Typo="Typo.caption" role="status">@_scriptCopyMessage</MudText> }
                <MudText Typo="Typo.subtitle2">Script preview</MudText>
                <GeneratedInstallScriptPreview @key="_scriptResult.Id" Script="@_scriptResult.Script" RuntimeId="@_scriptResult.RuntimeId" />
                <MudStack Row="true" Class="flex-wrap" Spacing="1">
                    <MudChip T="string" OnClick="DownloadGeneratedScriptAsync" Icon="@Icons.Material.Filled.Download" Color="Color.Primary">Download script</MudChip>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="_scriptResultRevoked" OnClick="RevokeGeneratedLinkAsync">Revoke link</MudButton>
                </MudStack>
            }
            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_scriptLinksLoading" OnClick="LoadInstallLinksAsync">Manage recent links</MudButton>
            @if (_scriptLinks is not null)
            {
                @foreach (var link in _scriptLinks)
                {
                    <MudPaper Class="pa-2" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap">
                            <MudText Typo="Typo.body2">Tenant @link.TenantId · @link.RuntimeId @link.ArtifactVersion · @(Math.Max(0, link.MaxUses - link.Uses))/@link.MaxUses uses · @(link.IsActive ? "Active" : "Inactive") · expires @link.ExpiresAtUtc.UtcDateTime.ToString("u") UTC</MudText>
                            <MudButton Size="Size.Small" Color="Color.Error" Disabled="@(!link.IsActive)" OnClick="@(() => RevokeManagedLinkAsync(link.Id))">Revoke</MudButton>
                        </MudStack>
                    </MudPaper>
                }
                @if (_scriptLinks.Count == 0) { <MudText Typo="Typo.caption">No recent links for this tenant.</MudText> }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseScriptDialog">Close</MudButton>
        @if (_scriptResult is not null && !_scriptEditing)
        {
            <MudButton Variant="Variant.Outlined" OnClick="@(() => _scriptEditing = true)">Edit options</MudButton>
        }
        @if (_scriptResult is null || _scriptEditing)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanGenerateScript() || _scriptGenerating)" OnClick="GenerateScriptAsync">Generate link</MudButton>
        }
    </DialogActions>
</MudDialog>

<MudDialog Visible="_cleanupDialogOpen" VisibleChanged="@(visible => { if (!visible) CloseCleanupDialog(); })" AriaLabel="Review local release cleanup" Options="@(new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseOnEscapeKey = false })">
    <TitleContent><MudText Typo="Typo.h6">Review local release cleanup</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
        @if (_localDeleteMessage is not null) { <MudAlert Dense="true" Severity="Severity.Info">@_localDeleteMessage</MudAlert> }
        @if (_retirementTarget is { } target)
        {
            <MudAlert Severity="Severity.Warning">Retire authority for attempt @target.Blocker.ReferenceId on decommissioned client @target.Blocker.AgentId? The original @target.Blocker.State admission and all reported evidence remain. Physical installation and rollback outcomes are unknown. Late reports, readmissions and confirmations will be rejected.</MudAlert>
            <MudTextField T="string" @bind-Value="_retirementReason" Label="Audit reason" Lines="3" MaxLength="512" Immediate="true" />
            <MudCheckBox T="bool" @bind-Value="_acknowledgeUnknownOutcome" Label="I acknowledge that retirement does not confirm installation or a verified rollback." />
        }
        else
        {
            <MudText Typo="Typo.body2">@_cleanupPreview.Count exact versions · @FormatBytes(_cleanupPreview.Sum(x => x.ReclaimableBytes)) owned bytes in this preview. Purge affects all local runtimes, imports and owned staging for each version. Installed clients, upstream releases and historical evidence remain.</MudText>
            <MudCheckBox T="bool" @bind-Value="_disableAllRuntimes" Disabled="_localDeleteBusy" Label="Disable all runtime update releases for each eligible version before deleting local files" />
            <MudText Typo="Typo.caption">@_cleanupPreview.Count(CleanupEligible) eligible · @_cleanupPreview.Count(x => !CleanupEligible(x)) blocked. Only eligible versions are submitted; blockers stay selected for resolution. Dependencies are rechecked by the server.</MudText>
            @foreach (var plan in _cleanupPreview)
            {
                <MudExpansionPanels Elevation="0" Outlined="true"><MudExpansionPanel Expanded="true" Text="@($"{plan.Version} · {FormatBytes(plan.ReclaimableBytes)} · {(CleanupEligible(plan) ? "Eligible" : "Blocked")}")">
                    <ReleaseCleanupDependencies Plan="plan" Busy="_localDeleteBusy" Resolve="@(blocker => ResolveCleanupBlockerAsync(plan.Version, blocker))" Inspect="@(blocker => InspectCleanupAttemptAsync(plan.Version, blocker))" />
                </MudExpansionPanel></MudExpansionPanels>
            }
            @foreach (var result in _batchResults) { <MudAlert Dense="true" Severity="@(result.State == "Deleted" ? Severity.Success : Severity.Warning)">@result.Version · @result.State · @(result.State == "Deleted" ? FormatBytes(result.Receipt?.ReclaimedBytes ?? 0) + " confirmed removed" : "") · @result.Error @(result.State == "Deleted" ? "Owned files removed; re-import suppressed." : "No completed reclamation is claimed. Refresh dependencies or retry cleanup.")</MudAlert> }
        }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_retirementTarget is not null)
        {
            <MudButton Disabled="_localDeleteBusy" OnClick="@(() => _retirementTarget = null)">Back to cleanup</MudButton>
            <MudButton Color="Color.Warning" Disabled="@(_localDeleteBusy || !_acknowledgeUnknownOutcome || _retirementReason.Trim().Length is < 10 or > 512)" OnClick="ConfirmRetirementAsync">Retire authority with unknown outcome</MudButton>
        }
        else
        {
            <MudButton Disabled="_localDeleteBusy" OnClick="CloseCleanupDialog">Close</MudButton>
            <MudButton Disabled="_localDeleteBusy" OnClick="RefreshCleanupPreviewAsync">Refresh preview</MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(_localDeleteBusy || !_cleanupPreview.Any(CleanupEligible))" OnClick="ConfirmCleanupAsync" data-testid="confirm-local-purge">Delete eligible local versions and files</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private static readonly int[] PageSizes = [20, 50, 100];
    private int _githubPageSize = 20;
    private string? _importsError;
    private long _githubLoadGeneration;
    private CancellationTokenSource? _githubLoadCancellation;
    private static readonly string[] RuntimeIds = ["win-x64", "win-arm64", "linux-x64", "osx-x64", "osx-arm64"];
    private static readonly string[] UpdateStatuses = ["Claimed", "Downloading", "Staged", "Activating", "GatewayReadmitted", "Accepted", "FailedPreActivation", "RolledBack", "RollbackUnverified"];
