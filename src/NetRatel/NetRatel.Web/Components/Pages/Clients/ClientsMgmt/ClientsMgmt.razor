    private async Task ChangeGitHubPageSizeAsync(int size)
    {
        if (!PageSizes.Contains(size) || size == _githubPageSize) return;
        _githubPageSize = size; _githubPageNumber = 0; _workspace = null;
        await LoadGitHubAsync(false);
    }
    private async Task ChangeGitHubPageAsync(int page)
    {
        if (_githubLoading || page < 0 || page == _githubPageNumber || (page > _githubPageNumber && (page * _githubPageSize >= (_workspace?.Total ?? 0)))) return;
        _githubPageNumber = page;
        await LoadGitHubAsync(false);
    }
    private Task RefreshImportsAsync() => LoadGitHubAsync(false);

    private async Task PollImportsAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_activeTab != 0 ||
                    (!_githubImports.Values.Any(x => x.State is >= 0 and <= 4) && !_localDeletions.Any(x => x.State == "Pending"))) continue;
                await InvokeAsync(async () => { await RefreshImportsAsync(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
    }

    private async Task QueueImportAsync(long releaseId)
    {
        if (_importActionBusy || _automationDisposed) return;
        _importActionBusy = true;
        _importsError = null;
        try
        {
            var operation = await Artifacts.QueueReleaseImportAsync(releaseId, _importPolling.Token);
            _githubImports[releaseId] = operation;
            await LoadGitHubAsync(false);
        }
        catch (OperationCanceledException) when (_importPolling.IsCancellationRequested) { }
        catch (HttpRequestException) { _importsError = "Could not queue the release import. Check the release evidence and try again."; }
        finally { _importActionBusy = false; }
    }

    private async Task CancelImportAsync(Guid id)
    {
        if (_importActionBusy || _automationDisposed) return;
        _importActionBusy = true;
        try { await Artifacts.CancelReleaseImportAsync(id, _importPolling.Token); await RefreshImportsAsync(); }
        catch (OperationCanceledException) when (_importPolling.IsCancellationRequested) { }
        catch (HttpRequestException) { _importsError = "Could not cancel the import. Refresh its status and try again."; }
        finally { _importActionBusy = false; }
    }

    private async Task RetryImportAsync(Guid id)
    {
        if (_importActionBusy || _automationDisposed) return;
        _importActionBusy = true;
        try { await Artifacts.RetryReleaseImportAsync(id, _importPolling.Token); await RefreshImportsAsync(); }
        catch (OperationCanceledException) when (_importPolling.IsCancellationRequested) { }
        catch (HttpRequestException) { _importsError = "Could not retry the import. Refresh its status and try again."; }
        finally { _importActionBusy = false; }
    }

    private async Task PublishImportAsync(Guid id, bool isPrerelease)
    {
        if (_importActionBusy || _automationDisposed) return;
        _importActionBusy = true;
        try
        {
        var message = isPrerelease
            ? "Publish this prerelease pack for tenants whose update policy explicitly allows prereleases? Existing stable tenants remain on stable releases."
            : "Publish this stable client pack for enabled tenant update policies?";
        var approved = await Dialogs.ShowMessageBoxAsync("Approve client pack", message,
            yesText: "Publish", cancelText: "Cancel");
        if (_automationDisposed || approved != true) return;
        try
        {
            await Artifacts.PublishReleaseImportAsync(id, isPrerelease, _importPolling.Token);
            await RefreshImportsAsync();
        }
        catch (OperationCanceledException) when (_importPolling.IsCancellationRequested) { }
        catch (HttpRequestException)
        {
            _importsError = "Could not publish the client pack. Refresh its status and inspect the imported artifacts.";
        }
        }
        finally { _importActionBusy = false; }
    }

    private static string ImportState(int state) => state switch
    {
        0 => "Queued", 1 => "Resolving", 2 => "Downloading", 3 => "Verifying",
        4 => "Importing", 5 => "Imported; awaiting approval", 6 => "Failed", 7 => "Cancelled", _ => "Unknown"
    };

    public async ValueTask DisposeAsync()
    {
        _automationDisposed = true;
        _githubLoadCancellation?.Cancel();
        _githubLoadGeneration++;
        await StopActivityAsync();
