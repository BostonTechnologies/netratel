    private async Task DownloadSelectedAsync()
    {
        if (_selectedItem is null || !_selectedTenantId.HasValue) return;
        _downloadDialogOpen = false;
        await Artifacts.DownloadClientPackageAsync(new ClientPackageDownloadRequest { TenantId = _selectedTenantId.Value, Environment = (int)_selectedEnvironment, RuntimeId = _selectedRuntimeId, Version = _selectedItem.Version, InjectEnrollment = _injectEnrollment, ValidForMinutes = _injectEnrollment ? _validityMinutes : null, MaxUses = _injectEnrollment ? _maxUses : null });
    }

    private bool CanDownload() => _selectedTenantId.HasValue && !string.IsNullOrWhiteSpace(_selectedRuntimeId) && (!_injectEnrollment || (_validityMinutes is >= 5 && _maxUses >= 1));
    private bool CanGenerateScript() => _selectedTenantId.HasValue && !string.IsNullOrWhiteSpace(_scriptRuntimeId) && _scriptValidityMinutes is >= 5 and <= 10080 && _scriptMaxUses >= 1 && !_endpointPreviewLoading && _endpointPreviewError is null;

    private async Task GenerateScriptAsync()
    {
        if (!_selectedTenantId.HasValue || !_scriptValidityMinutes.HasValue) return;
        var fingerprint = ScriptInputFingerprint();
        if (_scriptRequestFingerprint != fingerprint)
        {
            _scriptRequestFingerprint = fingerprint;
            _scriptRequestKey = Guid.NewGuid().ToString("D");
        }
        _scriptGenerating = true;
        _scriptError = null;
        try
        {
            _scriptResult = await Artifacts.GenerateInstallLinkAsync(new ClientScriptGenerateRequest
            {
                TenantId = _selectedTenantId.Value, RuntimeId = _scriptRuntimeId,
                ArtifactVersion = _scriptArtifactVersion, ValidForMinutes = _scriptValidityMinutes.Value,
                MaxUses = _scriptMaxUses, InstallAsService = _scriptInstallAsService,
                SilentInstall = _scriptSilentInstall, IdempotencyKey = _scriptRequestKey!
            });
            _scriptResultFingerprint = fingerprint;
            _endpointPreviewChanged = _endpointPreview is not null && _scriptResult.Endpoints is not null &&
                _endpointPreview != _scriptResult.Endpoints;
            _scriptEditing = false;
            _scriptResultRevoked = false;
        }
        catch (HttpRequestException exception) { _scriptError = exception.Message; }
        finally { _scriptGenerating = false; }
    }

    private string ScriptInputFingerprint() => string.Join('|', _selectedTenantId, _scriptRuntimeId,
        _scriptArtifactVersion, _scriptValidityMinutes, _scriptMaxUses,
        _scriptInstallAsService, _scriptSilentInstall);
    private bool ScriptResultIsStale() => _scriptResult is not null &&
        _scriptResultFingerprint != ScriptInputFingerprint();

    private async Task CopyInstallTextAsync(string value)
    {
        try { await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value); _scriptCopyMessage = "Copied to clipboard."; }
        catch (JSException) { _scriptCopyMessage = "Clipboard unavailable. Select and copy the text above."; }
    }

    private async Task DownloadGeneratedScriptAsync()
    {
        if (_scriptResult is not null) await Artifacts.DownloadGeneratedInstallScriptAsync(_scriptResult);
    }

    private async Task RevokeGeneratedLinkAsync()
    {
        if (_scriptResult is null) return;
        try { await Artifacts.RevokeInstallLinkAsync(_scriptResult.Id); _scriptResultRevoked = true; }
        catch (HttpRequestException) { _scriptError = "Could not revoke this link. Try again or use install-link management."; }
    }

    private async Task RefreshGeneratedLinkAsync()
    {
        if (_scriptResult is null) return;
        try
        {
            var metadata = await Artifacts.GetInstallLinkAsync(_scriptResult.Id);
            if (metadata is null) { _scriptError = "This link could not be found."; return; }
            _scriptResult.RemainingUses = Math.Max(0, metadata.MaxUses - metadata.Uses);
            _scriptResultRevoked = metadata.RevokedAtUtc.HasValue;
        }
        catch (HttpRequestException) { _scriptError = "Could not refresh link status. Try again."; }
    }

    private async Task LoadInstallLinksAsync()
    {
        if (!_selectedTenantId.HasValue) return;
        _scriptLinksLoading = true;
        try { _scriptLinks = await Artifacts.GetInstallLinksAsync(_selectedTenantId.Value); }
        catch (HttpRequestException) { _scriptError = "Could not load recent links. Try again."; }
        finally { _scriptLinksLoading = false; }
    }

    private async Task RevokeManagedLinkAsync(Guid id)
    {
        try
        {
            await Artifacts.RevokeInstallLinkAsync(id);
            if (_scriptResult?.Id == id) _scriptResultRevoked = true;
            await LoadInstallLinksAsync();
        }
        catch (HttpRequestException) { _scriptError = "Could not revoke this link. Try again."; }
    }

    private async Task DisableRelease(ClientUpdateReleaseModel release)
    {
        if (_importActionBusy || _automationDisposed) return;
        _importActionBusy = true;
        try { await Artifacts.DisableReleaseAsync(release.ReleaseId, _importPolling.Token); await LoadGitHubAsync(false); }
        catch (HttpRequestException ex) { _importsError = ex.Message; }
        finally { _importActionBusy = false; }
    }
    private async Task Resume(AgentClientUpdateStateModel state) { await Artifacts.ResumeAgentAsync(state.TenantId, state.AgentId); await ResetAndReloadAsync(_suspendedTable); }
    private async Task CopyAsync(string value) { if (!string.IsNullOrWhiteSpace(value)) await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value); }
    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string ShortHash(string hash) => string.IsNullOrWhiteSpace(hash) ? string.Empty : hash.Length <= 12 ? hash : $"{hash[..12]}…";
    private static string FormatBytes(long bytes) => bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024d / 1024d:F1} MiB";
    private static string ClientTarget(string? hostName, string? displayName, Guid agentId) => FirstPresent(hostName, displayName) ?? $"Unknown client · {agentId.ToString("N")[..8]}";
    private static string StateTarget(AgentClientUpdateStateModel state) => FirstPresent(state.ClientHostName, state.ClientDisplayName, state.AgentName) ?? $"Unknown client · {state.AgentId.ToString("N")[..8]}";
    private static string DisplaySecondaryName(string? hostName, string? displayName) => !string.IsNullOrWhiteSpace(hostName) && !string.IsNullOrWhiteSpace(displayName) && !string.Equals(hostName, displayName, StringComparison.OrdinalIgnoreCase) ? $" · {displayName}" : string.Empty;
    private static string? FirstPresent(params string?[] values) => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();
    private static Color UpdateStatusColor(string status) => status switch { "Accepted" or "GatewayReadmitted" => Color.Success, "FailedPreActivation" or "RolledBack" or "RollbackUnverified" => Color.Error, "Downloading" or "Staged" or "Activating" => Color.Info, _ => Color.Default };
}

