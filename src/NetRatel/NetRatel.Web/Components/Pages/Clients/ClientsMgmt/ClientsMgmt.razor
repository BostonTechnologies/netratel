@page "/clients/mgmt"
@using MudBlazor
@using NetRatel.Shared
@using NetRatel.Shared.Contracts
@using NetRatel.Web.Services
@using NetRatel.Web.Services.Tenants
@inject IClientArtifactsService Artifacts
@inject ITenantApiService TenantApi
@inject IJSRuntime JsRuntime
@inject IDialogService Dialogs
@implements IAsyncDisposable

@if (_interactiveReady)
{
    <span data-testid="clients-mgmt-interactive" hidden></span>
}
<MudPaper Class="client-mgmt-hero pa-4" Elevation="0">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap" Spacing="2">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Agent Installers &amp; Updates</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Browse client releases, create tenant-scoped installers, and supervise rollout state from one catalogue.</MudText>
        </MudStack>
        <MudStack Row="true" Class="flex-wrap" Spacing="1">
            <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tune" OnClick="OpenAutomationDrawer" data-testid="automation-settings-button">Automation @if (_automationDirty) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">Unsaved</MudChip> }</MudButton>
            <MudMenu Dense="true" Variant="Variant.Outlined" Label="Advanced" StartIcon="@Icons.Material.Filled.MoreHoriz" data-testid="advanced-client-actions">
                <MudMenuItem Icon="@Icons.Material.Filled.Upload" Disabled="@(!_interactiveReady)" OnClick="OpenUpload">Upload legacy artifact</MudMenuItem>
            </MudMenu>
        </MudStack>
    </MudStack>
    <MudStack Row="true" Class="flex-wrap mt-3" AlignItems="AlignItems.Center" Spacing="1">
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">Automation: @AutomationSummary</MudChip>
        @if (_automationSaved is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Next check: @UtcTime(_automationSaved.NextCheckAtUtc)</MudText>
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary">GitHub is the primary source; legacy upload is under Advanced.</MudText>
    </MudStack>
</MudPaper>

<MudPaper Class="mt-4 pa-3 client-mgmt-surface" Elevation="0">
    <MudTabs Rounded="true" KeepPanelsAlive="true" LazyLoadPanels="true" MinimumTabWidth="116px" ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChanged" TabPanelsClass="client-mgmt-tab-panel" data-testid="client-management-tabs">
        <MudTabPanel Text="GitHub releases" Icon="@Icons.Material.Filled.CloudDownload">
            @if (_activeTab == 0)
            {
            <MudStack Spacing="2" data-testid="github-release-catalogue">
                <MudPaper Class="pa-3 client-mgmt-automation-summary" Elevation="0" data-testid="release-automation-settings">
                    <MudStack Row="true" Class="flex-wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">Release automation</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Checks and downloads run on this instance. Deployment still follows each tenant’s existing channel policy.</MudText>
                            <MudText Typo="Typo.caption" Class="mt-1">@AutomationStatusSummary</MudText>
                        </MudStack>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenAutomationDrawer">Settings</MudButton>
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(_automationSaved?.LastError))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">Last automation error: @_automationSaved.LastError</MudAlert>
                    }
                    @if (!string.IsNullOrWhiteSpace(_automationError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_automationError</MudAlert>
                    }
                </MudPaper>
                <MudStack Row="true" Class="flex-wrap" AlignItems="AlignItems.Center" Spacing="1">
                    <MudSelect T="string" Value="_githubChannel" ValueChanged="OnGitHubChannelChanged" Label="Channel" Class="client-mgmt-channel-filter" Margin="Margin.Dense">
                        <MudSelectItem Value="@("all")">Stable and prerelease</MudSelectItem>
                        <MudSelectItem Value="@("stable")">Stable</MudSelectItem>
                        <MudSelectItem Value="@("prerelease")">Prerelease</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_githubLoading" OnClick="@(() => LoadGitHubAsync(true))">Refresh catalogue</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="_githubLoading" OnClick="RefreshImportsAsync">Refresh imports</MudButton>
                    @if (_githubPage is not null && _githubPage.RefreshedAtUtc > DateTimeOffset.MinValue)
                    {
                        <MudText Typo="Typo.caption">Checked @_githubPage.RefreshedAtUtc.ToLocalTime().ToString("g")</MudText>
                    }
                </MudStack>
                @if (_githubLoading) { <div role="status" aria-label="Loading GitHub releases"><MudProgressLinear Indeterminate="true" /></div> }
                @if (!string.IsNullOrWhiteSpace(_githubError)) { <MudAlert Severity="Severity.Error">@_githubError</MudAlert> }
                @if (!string.IsNullOrWhiteSpace(_githubPage?.Warning)) { <MudAlert Severity="Severity.Warning">@_githubPage.Warning</MudAlert> }
                @if (_githubPage?.Items.Count == 0 && !_githubLoading)
                {
                    <MudText Typo="Typo.body2">No matching releases in the scanned range. Older releases may exist when a scan limit is shown.</MudText>
                }
                <MudTable T="GitHubClientReleaseModel" Items="@(_githubPage?.Items ?? [])" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="client-github-table" data-testid="github-release-table">
                    <HeaderContent><MudTh>Release</MudTh><MudTh>Channel</MudTh><MudTh>Packages</MudTh><MudTh>State</MudTh><MudTh>Actions</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Release">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">@context.Name</MudText>
                                <MudText Typo="Typo.caption">@context.Version · @context.PublishedAtUtc.ToLocalTime().ToString("g")</MudText>
                                <a href="@context.DetailsUrl" target="_blank" rel="noopener noreferrer">Release details</a>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Channel"><MudChip T="string" Size="Size.Small" Color="@(context.IsPrerelease ? Color.Warning : Color.Success)">@(context.IsPrerelease ? "Prerelease" : "Stable")</MudChip></MudTd>
                        <MudTd DataLabel="Packages">
                            <MudStack Row="true" Class="flex-wrap" Spacing="1">
                                @foreach (var asset in context.ClientAssets) { <MudChip T="string" Size="Size.Small">@asset.RuntimeId</MudChip> }
                            </MudStack>
                            <MudText Typo="Typo.caption">@FormatBytes(context.TotalClientBytes)</MudText>
                        </MudTd>
                        <MudTd DataLabel="State">
                            <MudText Typo="Typo.body2">@context.PublicationState</MudText>
                            @if (_githubImports.TryGetValue(context.Id, out var import))
                            {
                                <MudText Typo="Typo.caption">Local: @(import.PublishedAtUtc.HasValue ? "Published" : ImportState(import.State)) · @FormatBytes(import.DownloadedBytes) / @FormatBytes(import.TotalBytes ?? context.TotalClientBytes)</MudText>
                                @if (!string.IsNullOrWhiteSpace(import.Error)) { <MudText Typo="Typo.caption" Color="Color.Error">@import.Error</MudText> }
                                @if (!string.IsNullOrWhiteSpace(import.AutomaticPublishError)) { <MudText Typo="Typo.caption" Color="Color.Warning">Automatic publication: @import.AutomaticPublishError</MudText> }
                            }
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            @if (_githubImports.TryGetValue(context.Id, out var currentImport))
                            {
                                @if (currentImport.State is 6 or 7)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_importActionBusy" OnClick="@(() => RetryImportAsync(currentImport.Id))">Retry import</MudButton>
                                }
                                else if (currentImport.State == 5 && !currentImport.PublishedAtUtc.HasValue)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Disabled="_importActionBusy" OnClick="@(() => PublishImportAsync(currentImport.Id, context.IsPrerelease))">Approve and publish</MudButton>
                                }
                                else if (currentImport.State != 5)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_importActionBusy" OnClick="@(() => CancelImportAsync(currentImport.Id))">Cancel import</MudButton>
                                }
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_interactiveReady || context.PublicationState != "verification required" || _importActionBusy)" OnClick="@(() => QueueImportAsync(context.Id))">Import pack</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">No matching GitHub client releases were found.</MudText></NoRecordsContent>
                </MudTable>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudButton Disabled="@(_githubLoading || _githubPageNumber == 0)" OnClick="PreviousGitHubPage">Previous</MudButton>
                    <MudText Typo="Typo.body2">Page @(_githubPageNumber + 1)</MudText>
                    <MudButton Disabled="@(_githubLoading || _githubPage?.HasMore != true)" OnClick="NextGitHubPage">Next</MudButton>
                </MudStack>
                </MudStack>
            }
        </MudTabPanel>
        <MudTabPanel Text="Packages" Icon="@Icons.Material.Filled.Inventory2">
            @if (_activeTab == 1)
            {
                <MudStack Spacing="2" data-testid="artifact-management-panel">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="5"><MudTextField T="string" Value="_artifactSearch" ValueChanged="OnArtifactSearchChanged" Immediate="true" Label="Search artifacts" Placeholder="Runtime, version, filename, SHA, notes" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" data-testid="artifact-search" /></MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudSelect T="string" Value="_artifactRid" ValueChanged="OnArtifactRidChanged" Label="Runtime" Immediate="true" data-testid="artifact-rid-filter"><MudSelectItem Value="@string.Empty">All runtimes</MudSelectItem>@foreach (var runtimeId in RuntimeIds) { <MudSelectItem Value="@runtimeId">@runtimeId</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" sm="6" md="4"><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadArtifactsAsync" Disabled="_artifactsLoading">Refresh</MudButton></MudItem>
                    </MudGrid>
                    <MudTable T="ClientArtifactSummaryModel" @ref="_artifactTable" ServerData="LoadArtifactsAsync" Dense="true" Hover="true" Loading="_artifactsLoading" Breakpoint="Breakpoint.Sm" data-testid="artifact-table">
                        <HeaderContent><MudTh>Runtime</MudTh><MudTh>Version</MudTh><MudTh>Notes</MudTh><MudTh>SHA256</MudTh><MudTh>Uploaded</MudTh><MudTh></MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Runtime">@context.Rid</MudTd>
                            <MudTd DataLabel="Version">@context.Version</MudTd>
                            <MudTd DataLabel="Notes"><span class="client-mgmt-clamp">@(context.Notes ?? "—")</span></MudTd>
                            <MudTd DataLabel="SHA256"><MudTooltip Text="@context.Sha256"><code>@ShortHash(context.Sha256)</code></MudTooltip><MudTooltip Text="Copy full SHA256"><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyAsync(context.Sha256))" /></MudTooltip></MudTd>
                            <MudTd DataLabel="Uploaded">@context.UploadedAt.ToLocalTime().ToString("g")</MudTd>
                            <MudTd><MudMenu Icon="@Icons.Material.Filled.MoreVert" aria-label="Artifact actions"><MudMenuItem OnClick="@(() => OpenDownload(context))">Download</MudMenuItem><MudMenuItem OnClick="@(() => OpenScript(context))">Generate script</MudMenuItem><MudMenuItem OnClick="@(() => Delete(context))">Delete unpublished artifact</MudMenuItem></MudMenu></MudTd>
                        </RowTemplate>
                        <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">No installer artifacts match the active filters.</MudText></NoRecordsContent>
                        <PagerContent><MudTablePager PageSizeOptions="PageSizes" /></PagerContent>
                    </MudTable>
                </MudStack>
            }
        </MudTabPanel>

        <MudTabPanel Text="Auto-updates" Icon="@Icons.Material.Filled.SystemUpdateAlt">
            @if (_activeTab == 2)
            {
                <MudStack Spacing="2" data-testid="release-management-panel">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4"><MudTextField T="string" Value="_releaseSearch" ValueChanged="OnReleaseSearchChanged" Immediate="true" Label="Search releases" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" data-testid="release-search" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudSelect T="string" Value="_releaseRid" ValueChanged="OnReleaseRidChanged" Label="Runtime"><MudSelectItem Value="@string.Empty">All runtimes</MudSelectItem>@foreach (var runtimeId in RuntimeIds) { <MudSelectItem Value="@runtimeId">@runtimeId</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudTextField T="string" Value="_releaseVersion" ValueChanged="OnReleaseVersionChanged" Immediate="true" Label="Version" Clearable="true" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudSelect T="string" Value="_releaseChannel" ValueChanged="OnReleaseChannelChanged" Label="Channel"><MudSelectItem Value="@string.Empty">All channels</MudSelectItem><MudSelectItem Value="@("stable")">stable</MudSelectItem><MudSelectItem Value="@("prerelease")">prerelease</MudSelectItem></MudSelect></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudSelect T="string" Value="_releaseEnabled" ValueChanged="OnReleaseEnabledChanged" Label="Status"><MudSelectItem Value="@string.Empty">All statuses</MudSelectItem><MudSelectItem Value="@("enabled")">Enabled</MudSelectItem><MudSelectItem Value="@("disabled")">Disabled</MudSelectItem></MudSelect></MudItem>
                    </MudGrid>
                    <MudTable T="ClientUpdateReleaseModel" @ref="_releaseTable" ServerData="LoadReleasesAsync" Dense="true" Hover="true" Loading="_releasesLoading" Breakpoint="Breakpoint.Sm" data-testid="release-table">
                        <HeaderContent><MudTh>Runtime</MudTh><MudTh>Version</MudTh><MudTh>Channel</MudTh><MudTh>SHA256</MudTh><MudTh>Published</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Runtime">@context.RuntimeId</MudTd><MudTd DataLabel="Version">@context.Version</MudTd><MudTd DataLabel="Channel">@context.Channel</MudTd>
                            <MudTd DataLabel="SHA256"><MudTooltip Text="@context.Sha256"><code>@ShortHash(context.Sha256)</code></MudTooltip></MudTd>
                            <MudTd DataLabel="Published">@context.PublishedAt.ToLocalTime().ToString("g")</MudTd>
                            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@(context.Enabled ? Color.Success : Color.Default)">@(context.Enabled ? "Enabled" : "Disabled")</MudChip></MudTd>
                            <MudTd><MudButton Size="Size.Small" Color="Color.Warning" Disabled="@(!context.Enabled)" OnClick="@(() => DisableRelease(context))">Disable</MudButton></MudTd>
                        </RowTemplate>
                        <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">No update releases match the active filters.</MudText></NoRecordsContent>
                        <PagerContent><MudTablePager PageSizeOptions="PageSizes" /></PagerContent>
                    </MudTable>
                </MudStack>
            }
        </MudTabPanel>

        <MudTabPanel Text="Activity" Icon="@Icons.Material.Filled.History">
            @if (_activeTab == 3)
            {
                <MudStack Spacing="2" data-testid="attempt-management-panel">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Grouping is applied to this server-filtered page; group counts are not global totals.</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4"><MudTextField T="string" Value="_attemptSearch" ValueChanged="OnAttemptSearchChanged" Immediate="true" Label="Search attempts" Placeholder="Hostname, tenant, version, status" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" data-testid="attempt-search" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudSelect T="int?" Value="_attemptTenantId" ValueChanged="OnAttemptTenantChanged" Label="Tenant"><MudSelectItem T="int?" Value="@null">All tenants</MudSelectItem>@foreach (var tenant in _tenants) { <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudSelect T="string" Value="_attemptRid" ValueChanged="OnAttemptRidChanged" Label="Runtime"><MudSelectItem Value="@string.Empty">All runtimes</MudSelectItem>@foreach (var runtimeId in RuntimeIds) { <MudSelectItem Value="@runtimeId">@runtimeId</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudTextField T="string" Value="_attemptVersion" ValueChanged="OnAttemptVersionChanged" Immediate="true" Label="Version" Clearable="true" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudSelect T="string" Value="_attemptStatus" ValueChanged="OnAttemptStatusChanged" Label="Status"><MudSelectItem Value="@string.Empty">All states</MudSelectItem>@foreach (var state in UpdateStatuses) { <MudSelectItem Value="@state">@state</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudSelect T="string" Value="_attemptGrouping" ValueChanged="OnAttemptGroupingChanged" Label="Group current page" data-testid="attempt-grouping"><MudSelectItem Value="@("None")">None</MudSelectItem><MudSelectItem Value="@("Tenant")">Tenant</MudSelectItem><MudSelectItem Value="@("Version")">Version</MudSelectItem><MudSelectItem Value="@("RID")">RID</MudSelectItem><MudSelectItem Value="@("Status")">Status</MudSelectItem></MudSelect></MudItem>
                    </MudGrid>
                    <MudTable T="ClientUpdateHistoryItemModel" @ref="_attemptTable" ServerData="LoadAttemptsAsync" GroupBy="AttemptGroup" Dense="true" Hover="true" Loading="_attemptsLoading" Breakpoint="Breakpoint.Sm" data-testid="attempt-table">
                        <HeaderContent><MudTh>Client</MudTh><MudTh>Release</MudTh><MudTh>Status</MudTh><MudTh>Failure</MudTh><MudTh>Updated</MudTh></HeaderContent>
                        <GroupHeaderTemplate><td colspan="5"><MudText Typo="Typo.subtitle2">@context.Key <span class="text-secondary">(@context.Items.Count() on this page)</span></MudText></td></GroupHeaderTemplate>
                        <RowTemplate>
                            <MudTd DataLabel="Client"><MudTooltip Text="@context.AgentId.ToString()"><MudStack Spacing="0"><MudText Typo="Typo.body2">@ClientTarget(context.ClientHostName, context.ClientDisplayName, context.AgentId)</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@(context.TenantName ?? $"Tenant {context.TenantId}")@(DisplaySecondaryName(context.ClientHostName, context.ClientDisplayName))</MudText></MudStack></MudTooltip></MudTd>
                            <MudTd DataLabel="Release">@context.RuntimeId @context.TargetVersion</MudTd><MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@UpdateStatusColor(context.Status)">@context.Status</MudChip></MudTd>
                            <MudTd DataLabel="Failure"><MudTooltip Text="@(context.Message ?? context.FailureCode ?? "No failure detail")"><span class="client-mgmt-clamp">@(context.FailureCode ?? context.Message ?? "—")</span></MudTooltip></MudTd><MudTd DataLabel="Updated">@context.UpdatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                        </RowTemplate>
                        <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">No update attempts match the active filters.</MudText></NoRecordsContent>
                        <PagerContent><MudTablePager PageSizeOptions="PageSizes" /></PagerContent>
                    </MudTable>
                </MudStack>
            }
        </MudTabPanel>

        <MudTabPanel Text="Suspended" Icon="@Icons.Material.Filled.PauseCircleOutline">
            @if (_activeTab == 4)
            {
                <MudStack Spacing="2" data-testid="suspended-management-panel">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Resume affects only future automatic updates for the selected suspended client.</MudText>
                    <MudGrid Spacing="2"><MudItem xs="12" md="6"><MudTextField T="string" Value="_suspendedSearch" ValueChanged="OnSuspendedSearchChanged" Immediate="true" Label="Search suspended agents" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" data-testid="suspended-search" /></MudItem><MudItem xs="12" md="3"><MudSelect T="int?" Value="_suspendedTenantId" ValueChanged="OnSuspendedTenantChanged" Label="Tenant"><MudSelectItem T="int?" Value="@null">All tenants</MudSelectItem>@foreach (var tenant in _tenants) { <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name</MudSelectItem> }</MudSelect></MudItem></MudGrid>
                    <MudTable T="AgentClientUpdateStateModel" @ref="_suspendedTable" ServerData="LoadSuspendedAsync" Dense="true" Hover="true" Loading="_suspendedLoading" Breakpoint="Breakpoint.Sm" data-testid="suspended-table">
                        <HeaderContent><MudTh>Client</MudTh><MudTh>Reason</MudTh><MudTh>Suspended</MudTh><MudTh></MudTh></HeaderContent>
                        <RowTemplate><MudTd DataLabel="Client"><MudTooltip Text="@context.AgentId.ToString()"><MudStack Spacing="0"><MudText Typo="Typo.body2">@StateTarget(context)</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@(context.TenantName ?? $"Tenant {context.TenantId}")@(DisplaySecondaryName(context.ClientHostName, context.ClientDisplayName))</MudText></MudStack></MudTooltip></MudTd><MudTd DataLabel="Reason"><span class="client-mgmt-clamp">@(context.SuspensionReason ?? "—")</span></MudTd><MudTd DataLabel="Suspended">@context.SuspendedAtUtc?.ToLocalTime().ToString("g")</MudTd><MudTd><MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => Resume(context))">Resume future updates</MudButton></MudTd></RowTemplate>
                        <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">No clients have auto-update suspended.</MudText></NoRecordsContent>
                        <PagerContent><MudTablePager PageSizeOptions="PageSizes" /></PagerContent>
                    </MudTable>
                </MudStack>
            }
        </MudTabPanel>
    </MudTabs>
</MudPaper>

<MudDrawer Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(560px, 100vw)" @bind-Open="_automationDrawerOpen">
    <MudStack Class="pa-4 client-mgmt-automation-drawer" Spacing="2" data-testid="automation-drawer">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Release automation settings</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Draft changes stay local until you save them.</MudText>
            </MudStack>
            <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Close automation settings" OnClick="CloseAutomationDrawer" />
        </MudStack>
        @if (_automationDraft is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            @if (_automationDirty)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" data-testid="automation-unsaved">Unsaved changes. Refresh is disabled until you save or cancel this draft.</MudAlert>
            }
            <MudSelect T="int" @bind-Value="_automationDraft.CheckEveryHours" Label="Automatic checks (UTC)" Margin="Margin.Dense">
                <MudSelectItem Value="0">Off</MudSelectItem>
                <MudSelectItem Value="12">Twice daily</MudSelectItem>
                <MudSelectItem Value="24">Daily</MudSelectItem>
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="_automationDraft.DownloadStable" Color="Color.Primary" Label="Download new stable releases" />
            <MudSwitch T="bool" @bind-Value="_automationDraft.DownloadPrerelease" Color="Color.Warning" Label="Include prereleases in downloads" />
            <MudSwitch T="bool" @bind-Value="_automationDraft.PublishAutomatically" Color="Color.Warning" Label="Publish verified imports automatically" />
            <MudSwitch T="bool" @bind-Value="_automationDraft.DeployPrereleaseAutomatically" Color="Color.Error" Label="Allow automatic prerelease deployment" />
            <MudAlert Severity="Severity.Warning" Dense="true">Automatic prerelease deployment can update enrolled clients on prerelease-enabled tenant policies. It requires both prerelease download and automatic publication. Existing disabled releases and suspended agents remain blocked.</MudAlert>
            <MudDivider />
            <MudText Typo="Typo.subtitle2">Saved policy status</MudText>
            <MudText Typo="Typo.caption">Last attempt: @UtcTime(_automationSaved?.LastAttemptAtUtc) · Last success: @UtcTime(_automationSaved?.LastSuccessAtUtc) · Next check: @UtcTime(_automationSaved?.NextCheckAtUtc)</MudText>
            @if (_automationSaved?.UpdatedAtUtc is not null)
            {
                <MudText Typo="Typo.caption">Policy updated by @_automationSaved.UpdatedBy at @UtcTime(_automationSaved.UpdatedAtUtc)</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(_automationError))
            {
                <MudAlert Severity="Severity.Error">@_automationError</MudAlert>
            }
            <MudStack Row="true" Class="flex-wrap" Spacing="1">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_automationBusy || !_automationDirty)" OnClick="SaveAutomationAsync">Save policy</MudButton>
                <MudButton Variant="Variant.Text" Disabled="@(_automationBusy || !_automationDirty)" OnClick="CancelAutomationDraft">Cancel</MudButton>
            </MudStack>
            <MudStack Row="true" Class="flex-wrap" Spacing="1">
                <MudButton Variant="Variant.Outlined" Disabled="@(_automationBusy || _automationDirty)" OnClick="CheckReleasesNowAsync">Run saved policy now</MudButton>
                <MudButton Variant="Variant.Text" Disabled="@(_automationBusy || _automationDirty)" OnClick="RefreshAutomationAsync">Reload saved settings</MudButton>
            </MudStack>
        }
    </MudStack>
</MudDrawer>

<MudOverlay Visible="_downloadDialogOpen" AutoClose="false" DarkBackground="true">
    <MudPaper Class="pa-4 mx-auto mt-12" Style="max-width: 520px;"><MudStack Spacing="2"><MudText Typo="Typo.h6">Download Client Package</MudText><MudText Typo="Typo.body2">Installer will auto-enroll on first run; no token is embedded.</MudText><MudSelect T="int?" Label="Tenant" @bind-Value="_selectedTenantId" Required="true">@foreach (var tenant in _tenants) { <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name (@tenant.TenantId)</MudSelectItem> }</MudSelect><MudSelect T="ClientEnvironment" Label="Environment" @bind-Value="_selectedEnvironment"><MudSelectItem T="ClientEnvironment" Value="ClientEnvironment.Dev">Dev</MudSelectItem><MudSelectItem T="ClientEnvironment" Value="ClientEnvironment.Prod">Prod</MudSelectItem><MudSelectItem T="ClientEnvironment" Value="ClientEnvironment.Both">Dev + Prod</MudSelectItem></MudSelect><MudSelect T="string" Label="Runtime" @bind-Value="_selectedRuntimeId">@foreach (var runtimeId in RuntimeIds) { <MudSelectItem Value="@runtimeId">@runtimeId</MudSelectItem> }</MudSelect><MudCheckBox T="bool" Label="Inject enrollment code" @bind-Value="_injectEnrollment" />@if (_injectEnrollment) { <MudSelect T="int?" Label="Validity" @bind-Value="_validityMinutes">@foreach (var preset in _validityPresets) { <MudSelectItem T="int?" Value="@preset.Minutes">@preset.Label</MudSelectItem> }</MudSelect><MudNumericField T="int" Label="Max uses" Min="1" @bind-Value="_maxUses" /> }<MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1"><MudButton Variant="Variant.Text" OnClick="CloseDownloadDialog">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanDownload())" OnClick="DownloadSelectedAsync">Download</MudButton></MudStack></MudStack></MudPaper>
</MudOverlay>

<MudDialog Visible="_scriptDialogOpen" VisibleChanged="ScriptVisibleChanged" AriaLabel="Generate deployment script"
           Class="client-deployment-dialog"
           Options="@(new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false, FullWidth = true, MaxWidth = MaxWidth.Large })">
    <TitleContent>Generate deployment script</TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            @if (_scriptResult is null || _scriptEditing)
            {
            <MudText Typo="Typo.body2">The public install URL can be used by anyone holding it until the enrollment allowance expires or is revoked.</MudText>
            <MudText Typo="Typo.body2">Selected artifact: @_scriptRuntimeId @(_scriptArtifactVersion ?? "latest")</MudText>
            <MudSelect T="int?" Label="Tenant" @bind-Value="_selectedTenantId" Required="true">
                @foreach (var tenant in _tenants) { <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name (@tenant.TenantId)</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" Label="Runtime" Value="_scriptRuntimeId" ValueChanged="OnScriptRuntimeChanged">
                @foreach (var runtimeId in RuntimeIds) { <MudSelectItem Value="@runtimeId">@runtimeId</MudSelectItem> }
            </MudSelect>
            <MudSelect T="int?" Label="Validity" @bind-Value="_scriptValidityMinutes">
                @foreach (var preset in _validityPresets) { <MudSelectItem T="int?" Value="@preset.Minutes">@preset.Label</MudSelectItem> }
            </MudSelect>
            <MudNumericField T="int" Label="Max uses" Min="1" @bind-Value="_scriptMaxUses" />
            <MudCheckBox T="bool" Label="Install as Service" @bind-Value="_scriptInstallAsService" />
            <MudCheckBox T="bool" Label="Silent install" @bind-Value="_scriptSilentInstall" />
            }
            @if (_scriptGenerating) { <div role="status"><MudProgressLinear Indeterminate="true" /><MudText>Generating protected install link…</MudText></div> }
            @if (!string.IsNullOrWhiteSpace(_scriptError)) { <MudAlert Severity="Severity.Error">@_scriptError</MudAlert> }
            @if (_scriptResult is not null)
            {
                @if (ScriptResultIsStale()) { <MudAlert Severity="Severity.Warning">Options changed. Generate a new link for these selections.</MudAlert> }
                @if (_scriptResultRevoked) { <MudAlert Severity="Severity.Warning">This link has been revoked. Existing enrolled clients remain active.</MudAlert> }
                <MudText Typo="Typo.subtitle1">Generated install link</MudText>
                <MudText Typo="Typo.body2">Tenant @_scriptResult.TenantId · @_scriptResult.RuntimeId · @_scriptResult.ArtifactVersion</MudText>
                <MudText Typo="Typo.body2">Expires @_scriptResult.ExpiresAtUtc.UtcDateTime.ToString("u") UTC (@_scriptResult.ExpiresAtUtc.ToLocalTime().ToString("g") local). @_scriptResult.RemainingUses of @_scriptResult.MaxUses enrollments remain.</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RefreshGeneratedLinkAsync">Refresh status</MudButton>
                <MudText Typo="Typo.caption">Fetching, previewing, copying, and downloading the script do not spend an enrollment use. Service installation may require administrator or root privileges.</MudText>
                <MudTextField T="string" Label="Install command" Value="_scriptResult.InstallCommand" ReadOnly="true" Lines="2" Class="client-script-output" />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopyInstallTextAsync(_scriptResult.InstallCommand))">Copy command</MudButton>
                <MudTextField T="string" Label="Public script URL" Value="_scriptResult.PublicUrl" ReadOnly="true" Lines="2" Class="client-script-output" />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopyInstallTextAsync(_scriptResult.PublicUrl))">Copy URL</MudButton>
                @if (!string.IsNullOrWhiteSpace(_scriptCopyMessage)) { <MudText Typo="Typo.caption" role="status">@_scriptCopyMessage</MudText> }
                <MudText Typo="Typo.subtitle2">Script preview</MudText>
                <pre class="client-script-preview" aria-label="Generated script preview">@_scriptResult.Script</pre>
                <MudStack Row="true" Class="flex-wrap" Spacing="1">
                    <MudChip T="string" OnClick="DownloadGeneratedScriptAsync" Icon="@Icons.Material.Filled.Download" Color="Color.Primary">Download script</MudChip>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="_scriptResultRevoked" OnClick="RevokeGeneratedLinkAsync">Revoke link</MudButton>
                </MudStack>
            }
            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_scriptLinksLoading" OnClick="LoadInstallLinksAsync">Manage recent links</MudButton>
            @if (_scriptLinks is not null)
            {
                @foreach (var link in _scriptLinks)
                {
                    <MudPaper Class="pa-2" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap">
                            <MudText Typo="Typo.body2">Tenant @link.TenantId · @link.RuntimeId @link.ArtifactVersion · @(Math.Max(0, link.MaxUses - link.Uses))/@link.MaxUses uses · @(link.IsActive ? "Active" : "Inactive") · expires @link.ExpiresAtUtc.UtcDateTime.ToString("u") UTC</MudText>
                            <MudButton Size="Size.Small" Color="Color.Error" Disabled="@(!link.IsActive)" OnClick="@(() => RevokeManagedLinkAsync(link.Id))">Revoke</MudButton>
                        </MudStack>
                    </MudPaper>
                }
                @if (_scriptLinks.Count == 0) { <MudText Typo="Typo.caption">No recent links for this tenant.</MudText> }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseScriptDialog">Close</MudButton>
        @if (_scriptResult is not null && !_scriptEditing)
        {
            <MudButton Variant="Variant.Outlined" OnClick="@(() => _scriptEditing = true)">Edit options</MudButton>
        }
        @if (_scriptResult is null || _scriptEditing)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanGenerateScript() || _scriptGenerating)" OnClick="GenerateScriptAsync">Generate link</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private static readonly int[] PageSizes = [10, 20, 50, 100];
    private static readonly string[] RuntimeIds = ["win-x64", "win-arm64", "linux-x64", "osx-x64", "osx-arm64"];
    private static readonly string[] UpdateStatuses = ["Claimed", "Downloading", "Staged", "Activating", "GatewayReadmitted", "Accepted", "FailedPreActivation", "RolledBack", "RollbackUnverified"];
    private readonly (string Label, int Minutes)[] _validityPresets = [("1 hour", 60), ("6 hours", 360), ("24 hours", 1440), ("3 days", 4320), ("7 days", 10080)];
    private IReadOnlyList<TenantDto> _tenants = Array.Empty<TenantDto>();
    private MudTable<ClientArtifactSummaryModel>? _artifactTable;
    private GitHubClientReleasePageModel? _githubPage;
    private ClientReleaseAutomationModel? _automationSaved;
    private ClientReleaseAutomationModel? _automationDraft;
    private string? _automationError;
    private bool _automationBusy;
    private bool _automationDrawerOpen;
    private Dictionary<long, ClientReleaseImportModel> _githubImports = [];
    private bool _importActionBusy;
    private readonly CancellationTokenSource _importPolling = new();
    private Task? _importPollingTask;
    private string _githubChannel = "all";
    private string? _githubError;
    private int _githubPageNumber;
    private bool _githubLoading;
    private MudTable<ClientUpdateReleaseModel>? _releaseTable;
    private MudTable<ClientUpdateHistoryItemModel>? _attemptTable;
    private MudTable<AgentClientUpdateStateModel>? _suspendedTable;
    private int _activeTab;
    private bool _artifactsLoading;
    private bool _releasesLoading;
    private bool _attemptsLoading;
    private bool _suspendedLoading;
    private string? _artifactSearch;
    private string _artifactRid = string.Empty;
    private string? _releaseSearch;
    private string _releaseRid = string.Empty;
    private string? _releaseVersion;
    private string _releaseChannel = string.Empty;
    private string _releaseEnabled = string.Empty;
    private string? _attemptSearch;
    private int? _attemptTenantId;
    private string _attemptRid = string.Empty;
    private string? _attemptVersion;
    private string _attemptStatus = string.Empty;
    private string _attemptGrouping = "Tenant";
    private string? _suspendedSearch;
    private int? _suspendedTenantId;
    private bool _downloadDialogOpen;
    private bool _scriptDialogOpen;
    private ClientArtifactSummaryModel? _selectedItem;
    private int? _selectedTenantId;
    private ClientEnvironment _selectedEnvironment = ClientEnvironment.Dev;
    private string _selectedRuntimeId = "win-x64";
    private bool _injectEnrollment = true;
    private int? _validityMinutes = 60;
    private int _maxUses = 1;
    private string _scriptRuntimeId = "win-x64";
    private string? _scriptArtifactVersion;
    private int? _scriptValidityMinutes = 60;
    private int _scriptMaxUses = 1;
    private bool _scriptInstallAsService = true;
    private bool _scriptSilentInstall = true;
    private ClientInstallLinkResultModel? _scriptResult;
    private string? _scriptResultFingerprint;
    private string? _scriptRequestFingerprint;
    private string? _scriptRequestKey;
    private string? _scriptError;
    private string? _scriptCopyMessage;
    private bool _scriptGenerating;
    private bool _scriptEditing;
    private bool _scriptResultRevoked;
    private List<ClientInstallLinkMetadataModel>? _scriptLinks;
    private bool _scriptLinksLoading;
    private bool _interactiveReady;

    private bool _automationDirty => _automationSaved is not null && _automationDraft is not null && !SameAutomationPolicy(_automationSaved, _automationDraft);
    private string AutomationSummary => _automationSaved is null
        ? "Loading"
        : _automationSaved.CheckEveryHours <= 0
            ? "Checks off"
            : $"Checks every {_automationSaved.CheckEveryHours}h";
    private string AutomationStatusSummary => _automationSaved is null
        ? "Loading saved policy…"
        : $"Stable downloads: {OnOff(_automationSaved.DownloadStable)} · Prereleases: {OnOff(_automationSaved.DownloadPrerelease)} · Automatic publication: {OnOff(_automationSaved.PublishAutomatically)}";

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactiveReady = true;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        _tenants = await TenantApi.GetTenantsAsync();
        _selectedTenantId = _tenants.FirstOrDefault()?.TenantId;
        await LoadGitHubAsync(false);
        await LoadAutomationAsync();
        _importPollingTask = PollImportsAsync(_importPolling.Token);
    }

    private async Task OnTabChanged(int index)
    {
        _activeTab = index;
        await Task.Yield();
        switch (index)
        {
            case 0: await LoadGitHubAsync(false); await LoadAutomationAsync(); break;
            case 1 when _artifactTable is not null: await _artifactTable.ReloadServerData(); break;
            case 2 when _releaseTable is not null: await _releaseTable.ReloadServerData(); break;
            case 3 when _attemptTable is not null: await _attemptTable.ReloadServerData(); break;
            case 4 when _suspendedTable is not null: await _suspendedTable.ReloadServerData(); break;
        }
    }

    private async Task LoadGitHubAsync(bool refresh)
    {
        _githubLoading = true;
        _githubError = null;
        try
        {
            _githubPage = await Artifacts.GetGitHubReleasesAsync(_githubChannel, _githubPageNumber, refresh);
            await RefreshImportsAsync();
        }
        catch (HttpRequestException)
        {
            _githubError = "Could not refresh GitHub releases. Try again; imported artifacts remain available.";
        }
        finally
        {
            _githubLoading = false;
        }
    }

    private async Task LoadAutomationAsync()
    {
        if (_automationDirty)
        {
            return;
        }

        _automationError = null;
        try
        {
            _automationSaved = await Artifacts.GetReleaseAutomationAsync();
            _automationDraft = CloneAutomation(_automationSaved);
        }
        catch (HttpRequestException) { _automationError = "Could not load automation settings. Refresh status and try again."; }
    }

    private async Task OpenAutomationDrawer()
    {
        if (_automationDraft is null)
        {
            await LoadAutomationAsync();
        }

        _automationDrawerOpen = true;
    }

    private void CloseAutomationDrawer() => _automationDrawerOpen = false;

    private void CancelAutomationDraft()
    {
        if (_automationSaved is not null)
        {
            _automationDraft = CloneAutomation(_automationSaved);
        }

        _automationError = null;
    }

    private Task RefreshAutomationAsync() => LoadAutomationAsync();

    private async Task SaveAutomationAsync()
    {
        if (_automationDraft is null || !_automationDirty) return;
        _automationBusy = true;
        _automationError = null;
        try
        {
            _automationSaved = await Artifacts.SaveReleaseAutomationAsync(CloneAutomation(_automationDraft));
            _automationDraft = CloneAutomation(_automationSaved);
        }
        catch (HttpRequestException)
        {
            _automationError = "Could not save the policy. Check the selected options or refresh status if another operator changed it.";
        }
        finally { _automationBusy = false; }
    }

    private async Task CheckReleasesNowAsync()
    {
        if (_automationDirty)
        {
            _automationError = "Save or cancel the automation draft before running the saved policy.";
            return;
        }

        _automationBusy = true;
        _automationError = null;
        try
        {
            _automationSaved = await Artifacts.CheckReleasesNowAsync();
            _automationDraft = CloneAutomation(_automationSaved);
        }
        catch (HttpRequestException) { _automationError = "Could not schedule a check. Refresh status and try again."; }
        finally { _automationBusy = false; }
    }

    private static ClientReleaseAutomationModel CloneAutomation(ClientReleaseAutomationModel source) => new()
    {
        CheckEveryHours = source.CheckEveryHours,
        DownloadStable = source.DownloadStable,
        DownloadPrerelease = source.DownloadPrerelease,
        PublishAutomatically = source.PublishAutomatically,
        DeployPrereleaseAutomatically = source.DeployPrereleaseAutomatically,
        LastAttemptAtUtc = source.LastAttemptAtUtc,
        LastSuccessAtUtc = source.LastSuccessAtUtc,
        NextCheckAtUtc = source.NextCheckAtUtc,
        LastError = source.LastError,
        Revision = source.Revision,
        UpdatedBy = source.UpdatedBy,
        UpdatedAtUtc = source.UpdatedAtUtc
    };

    private static bool SameAutomationPolicy(ClientReleaseAutomationModel left, ClientReleaseAutomationModel right) =>
        left.CheckEveryHours == right.CheckEveryHours &&
        left.DownloadStable == right.DownloadStable &&
        left.DownloadPrerelease == right.DownloadPrerelease &&
        left.PublishAutomatically == right.PublishAutomatically &&
        left.DeployPrereleaseAutomatically == right.DeployPrereleaseAutomatically;

    private static string OnOff(bool value) => value ? "on" : "off";

    private static string UtcTime(DateTimeOffset? value) =>
        value.HasValue ? value.Value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'") : "Never";

    private async Task OnGitHubChannelChanged(string channel) { _githubChannel = channel; _githubPageNumber = 0; await LoadGitHubAsync(false); }

    private async Task RefreshImportsAsync()
    {
        try
        {
            _githubImports = (await Artifacts.GetReleaseImportsAsync()).ToDictionary(x => x.GitHubReleaseId);
        }
        catch (HttpRequestException)
        {
            _githubError = "Could not load local import status. Try Refresh imports.";
        }
    }

    private async Task PollImportsAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_activeTab != 0 || !_githubImports.Values.Any(x => x.State is >= 0 and <= 4)) continue;
                await InvokeAsync(async () => { await RefreshImportsAsync(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
    }

    private async Task QueueImportAsync(long releaseId)
    {
        _importActionBusy = true;
        _githubError = null;
        try
        {
            var operation = await Artifacts.QueueReleaseImportAsync(releaseId);
            _githubImports[releaseId] = operation;
        }
        catch (HttpRequestException) { _githubError = "Could not queue the release import. Check the release evidence and try again."; }
        finally { _importActionBusy = false; }
    }

    private async Task CancelImportAsync(Guid id)
    {
        try { await Artifacts.CancelReleaseImportAsync(id); await RefreshImportsAsync(); }
        catch (HttpRequestException) { _githubError = "Could not cancel the import. Refresh its status and try again."; }
    }

    private async Task RetryImportAsync(Guid id)
    {
        try { await Artifacts.RetryReleaseImportAsync(id); await RefreshImportsAsync(); }
        catch (HttpRequestException) { _githubError = "Could not retry the import. Refresh its status and try again."; }
    }

    private async Task PublishImportAsync(Guid id, bool isPrerelease)
    {
        var message = isPrerelease
            ? "Publish this prerelease pack for tenants whose update policy explicitly allows prereleases? Existing stable tenants remain on stable releases."
            : "Publish this stable client pack for enabled tenant update policies?";
        var approved = await Dialogs.ShowMessageBoxAsync("Approve client pack", message,
            yesText: "Publish", cancelText: "Cancel");
        if (approved != true) return;
        try
        {
            await Artifacts.PublishReleaseImportAsync(id, isPrerelease);
            await RefreshImportsAsync();
            await ResetAndReloadAsync(_releaseTable);
        }
        catch (HttpRequestException)
        {
            _githubError = "Could not publish the client pack. Refresh its status and inspect the imported artifacts.";
        }
    }

    private static string ImportState(int state) => state switch
    {
        0 => "Queued", 1 => "Resolving", 2 => "Downloading", 3 => "Verifying",
        4 => "Importing", 5 => "Imported; awaiting approval", 6 => "Failed", 7 => "Cancelled", _ => "Unknown"
    };

    public async ValueTask DisposeAsync()
    {
        _importPolling.Cancel();
        if (_importPollingTask is not null) await _importPollingTask;
        _importPolling.Dispose();
    }
    private async Task PreviousGitHubPage() { if (_githubPageNumber > 0) { _githubPageNumber--; await LoadGitHubAsync(false); } }
    private async Task NextGitHubPage() { if (_githubPage?.HasMore == true) { _githubPageNumber++; await LoadGitHubAsync(false); } }

    private async Task<TableData<ClientArtifactSummaryModel>> LoadArtifactsAsync(TableState state, CancellationToken ct)
    {
        _artifactsLoading = true;
        try
        {
            var page = await Artifacts.GetArtifactsAsync(state.Page, state.PageSize, EmptyToNull(_artifactRid), EmptyToNull(_artifactSearch), ct);
            return new TableData<ClientArtifactSummaryModel> { Items = page.Items, TotalItems = page.Total };
        }
        finally { _artifactsLoading = false; }
    }

    private async Task<TableData<ClientUpdateReleaseModel>> LoadReleasesAsync(TableState state, CancellationToken ct)
    {
        _releasesLoading = true;
        try
        {
            var page = await Artifacts.GetUpdateReleasePageAsync(state.Page, state.PageSize, EmptyToNull(_releaseSearch), EmptyToNull(_releaseRid), EmptyToNull(_releaseVersion), EmptyToNull(_releaseChannel), ParseEnabledFilter(), ct);
            return new TableData<ClientUpdateReleaseModel> { Items = page.Items, TotalItems = page.Total };
        }
        finally { _releasesLoading = false; }
    }

    private async Task<TableData<ClientUpdateHistoryItemModel>> LoadAttemptsAsync(TableState state, CancellationToken ct)
    {
        _attemptsLoading = true;
        try
        {
            var page = await Artifacts.GetUpdateHistoryAsync(state.Page, state.PageSize, EmptyToNull(_attemptSearch), EmptyToNull(_attemptStatus), null, EmptyToNull(_attemptRid), _attemptTenantId, EmptyToNull(_attemptVersion), ct);
            return new TableData<ClientUpdateHistoryItemModel> { Items = page.Items, TotalItems = page.Total };
        }
        finally { _attemptsLoading = false; }
    }

    private async Task<TableData<AgentClientUpdateStateModel>> LoadSuspendedAsync(TableState state, CancellationToken ct)
    {
        _suspendedLoading = true;
        try
        {
            var page = await Artifacts.GetSuspendedAgentsAsync(state.Page, state.PageSize, EmptyToNull(_suspendedSearch), _suspendedTenantId, ct);
            return new TableData<AgentClientUpdateStateModel> { Items = page.Items, TotalItems = page.Total };
        }
        finally { _suspendedLoading = false; }
    }

    private Task OnArtifactSearchChanged(string value) { _artifactSearch = value; return ResetAndReloadAsync(_artifactTable); }
    private Task OnArtifactRidChanged(string value) { _artifactRid = value; return ResetAndReloadAsync(_artifactTable); }
    private Task OnReleaseSearchChanged(string value) { _releaseSearch = value; return ResetAndReloadAsync(_releaseTable); }
    private Task OnReleaseRidChanged(string value) { _releaseRid = value; return ResetAndReloadAsync(_releaseTable); }
    private Task OnReleaseVersionChanged(string value) { _releaseVersion = value; return ResetAndReloadAsync(_releaseTable); }
    private Task OnReleaseChannelChanged(string value) { _releaseChannel = value; return ResetAndReloadAsync(_releaseTable); }
    private Task OnReleaseEnabledChanged(string value) { _releaseEnabled = value; return ResetAndReloadAsync(_releaseTable); }
    private Task OnAttemptSearchChanged(string value) { _attemptSearch = value; return ResetAndReloadAsync(_attemptTable); }
    private Task OnAttemptTenantChanged(int? value) { _attemptTenantId = value; return ResetAndReloadAsync(_attemptTable); }
    private Task OnAttemptRidChanged(string value) { _attemptRid = value; return ResetAndReloadAsync(_attemptTable); }
    private Task OnAttemptVersionChanged(string value) { _attemptVersion = value; return ResetAndReloadAsync(_attemptTable); }
    private Task OnAttemptStatusChanged(string value) { _attemptStatus = value; return ResetAndReloadAsync(_attemptTable); }
    private Task OnAttemptGroupingChanged(string value) { _attemptGrouping = value; return InvokeAsync(StateHasChanged); }
    private Task OnSuspendedSearchChanged(string value) { _suspendedSearch = value; return ResetAndReloadAsync(_suspendedTable); }
    private Task OnSuspendedTenantChanged(int? value) { _suspendedTenantId = value; return ResetAndReloadAsync(_suspendedTable); }
    private Task ReloadArtifactsAsync() => ResetAndReloadAsync(_artifactTable);

    private static async Task ResetAndReloadAsync<T>(MudTable<T>? table)
    {
        if (table is null) return;
        table.NavigateTo(0);
        await table.ReloadServerData();
    }

    private TableGroupDefinition<ClientUpdateHistoryItemModel>? AttemptGroup => _attemptGrouping switch
    {
        "Tenant" => NewAttemptGroup("Tenant", item => item.TenantName ?? $"Tenant {item.TenantId}"),
        "Version" => NewAttemptGroup("Version", item => item.TargetVersion),
        "RID" => NewAttemptGroup("RID", item => item.RuntimeId),
        "Status" => NewAttemptGroup("Status", item => item.Status),
        _ => null
    };

    private static TableGroupDefinition<ClientUpdateHistoryItemModel> NewAttemptGroup(string name, Func<ClientUpdateHistoryItemModel, object> selector) => new(selector) { GroupName = name, Expandable = true, IsInitiallyExpanded = false, Indentation = false };

    private Task OpenUpload() => Artifacts.OpenUploadDialogAsync(_artifactRid, OnUploaded);
    private async Task OnUploaded() { await ResetAndReloadAsync(_artifactTable); await ResetAndReloadAsync(_releaseTable); }
    private void OpenDownload(ClientArtifactSummaryModel item) { _selectedItem = item; _selectedRuntimeId = item.Rid; _downloadDialogOpen = true; }
    private void CloseDownloadDialog() => _downloadDialogOpen = false;
    private void OpenScript(ClientArtifactSummaryModel item)
    {
        _scriptRuntimeId = item.Rid;
        _scriptArtifactVersion = item.Version;
        _scriptResult = null;
        _scriptResultFingerprint = null;
        _scriptRequestFingerprint = null;
        _scriptRequestKey = null;
        _scriptError = null;
        _scriptCopyMessage = null;
        _scriptEditing = true;
        _scriptResultRevoked = false;
        _scriptLinks = null;
        _scriptDialogOpen = true;
    }
    private void OnScriptRuntimeChanged(string runtimeId) { _scriptRuntimeId = runtimeId; _scriptArtifactVersion = null; }
    private void CloseScriptDialog() => _scriptDialogOpen = false;
    private void ScriptVisibleChanged(bool visible) => _scriptDialogOpen = visible;

    private async Task DownloadSelectedAsync()
    {
        if (_selectedItem is null || !_selectedTenantId.HasValue) return;
        _downloadDialogOpen = false;
        await Artifacts.DownloadClientPackageAsync(new ClientPackageDownloadRequest { TenantId = _selectedTenantId.Value, Environment = (int)_selectedEnvironment, RuntimeId = _selectedRuntimeId, Version = _selectedItem.Version, InjectEnrollment = _injectEnrollment, ValidForMinutes = _injectEnrollment ? _validityMinutes : null, MaxUses = _injectEnrollment ? _maxUses : null });
    }

    private bool CanDownload() => _selectedTenantId.HasValue && !string.IsNullOrWhiteSpace(_selectedRuntimeId) && (!_injectEnrollment || (_validityMinutes is >= 5 && _maxUses >= 1));
    private bool CanGenerateScript() => _selectedTenantId.HasValue && !string.IsNullOrWhiteSpace(_scriptRuntimeId) && _scriptValidityMinutes is >= 5 and <= 10080 && _scriptMaxUses >= 1;

    private async Task GenerateScriptAsync()
    {
        if (!_selectedTenantId.HasValue || !_scriptValidityMinutes.HasValue) return;
        var fingerprint = ScriptInputFingerprint();
        if (_scriptRequestFingerprint != fingerprint)
        {
            _scriptRequestFingerprint = fingerprint;
            _scriptRequestKey = Guid.NewGuid().ToString("D");
        }
        _scriptGenerating = true;
        _scriptError = null;
        try
        {
            _scriptResult = await Artifacts.GenerateInstallLinkAsync(new ClientScriptGenerateRequest
            {
                TenantId = _selectedTenantId.Value, RuntimeId = _scriptRuntimeId,
                ArtifactVersion = _scriptArtifactVersion, ValidForMinutes = _scriptValidityMinutes.Value,
                MaxUses = _scriptMaxUses, InstallAsService = _scriptInstallAsService,
                SilentInstall = _scriptSilentInstall, IdempotencyKey = _scriptRequestKey!
            });
            _scriptResultFingerprint = fingerprint;
            _scriptEditing = false;
            _scriptResultRevoked = false;
        }
        catch (HttpRequestException exception) { _scriptError = exception.Message; }
        finally { _scriptGenerating = false; }
    }

    private string ScriptInputFingerprint() => string.Join('|', _selectedTenantId, _scriptRuntimeId,
        _scriptArtifactVersion, _scriptValidityMinutes, _scriptMaxUses,
        _scriptInstallAsService, _scriptSilentInstall);
    private bool ScriptResultIsStale() => _scriptResult is not null &&
        _scriptResultFingerprint != ScriptInputFingerprint();

    private async Task CopyInstallTextAsync(string value)
    {
        try { await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value); _scriptCopyMessage = "Copied to clipboard."; }
        catch (JSException) { _scriptCopyMessage = "Clipboard unavailable. Select and copy the text above."; }
    }

    private async Task DownloadGeneratedScriptAsync()
    {
        if (_scriptResult is not null) await Artifacts.DownloadGeneratedInstallScriptAsync(_scriptResult);
    }

    private async Task RevokeGeneratedLinkAsync()
    {
        if (_scriptResult is null) return;
        try { await Artifacts.RevokeInstallLinkAsync(_scriptResult.Id); _scriptResultRevoked = true; }
        catch (HttpRequestException) { _scriptError = "Could not revoke this link. Try again or use install-link management."; }
    }

    private async Task RefreshGeneratedLinkAsync()
    {
        if (_scriptResult is null) return;
        try
        {
            var metadata = await Artifacts.GetInstallLinkAsync(_scriptResult.Id);
            if (metadata is null) { _scriptError = "This link could not be found."; return; }
            _scriptResult.RemainingUses = Math.Max(0, metadata.MaxUses - metadata.Uses);
            _scriptResultRevoked = metadata.RevokedAtUtc.HasValue;
        }
        catch (HttpRequestException) { _scriptError = "Could not refresh link status. Try again."; }
    }

    private async Task LoadInstallLinksAsync()
    {
        if (!_selectedTenantId.HasValue) return;
        _scriptLinksLoading = true;
        try { _scriptLinks = await Artifacts.GetInstallLinksAsync(_selectedTenantId.Value); }
        catch (HttpRequestException) { _scriptError = "Could not load recent links. Try again."; }
        finally { _scriptLinksLoading = false; }
    }

    private async Task RevokeManagedLinkAsync(Guid id)
    {
        try
        {
            await Artifacts.RevokeInstallLinkAsync(id);
            if (_scriptResult?.Id == id) _scriptResultRevoked = true;
            await LoadInstallLinksAsync();
        }
        catch (HttpRequestException) { _scriptError = "Could not revoke this link. Try again."; }
    }

    private async Task Delete(ClientArtifactSummaryModel item) { await Artifacts.DeleteAsync(item.Rid, item.Version); await ResetAndReloadAsync(_artifactTable); }
    private async Task DisableRelease(ClientUpdateReleaseModel release) { await Artifacts.DisableReleaseAsync(release.ReleaseId); await ResetAndReloadAsync(_releaseTable); }
    private async Task Resume(AgentClientUpdateStateModel state) { await Artifacts.ResumeAgentAsync(state.TenantId, state.AgentId); await ResetAndReloadAsync(_suspendedTable); }
    private async Task CopyAsync(string value) { if (!string.IsNullOrWhiteSpace(value)) await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value); }
    private bool? ParseEnabledFilter() => _releaseEnabled switch { "enabled" => true, "disabled" => false, _ => null };
    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string ShortHash(string hash) => string.IsNullOrWhiteSpace(hash) ? string.Empty : hash.Length <= 12 ? hash : $"{hash[..12]}…";
    private static string FormatBytes(long bytes) => bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024d / 1024d:F1} MiB";
    private static string ClientTarget(string? hostName, string? displayName, Guid agentId) => FirstPresent(hostName, displayName) ?? $"Unknown client · {agentId.ToString("N")[..8]}";
    private static string StateTarget(AgentClientUpdateStateModel state) => FirstPresent(state.ClientHostName, state.ClientDisplayName, state.AgentName) ?? $"Unknown client · {state.AgentId.ToString("N")[..8]}";
    private static string DisplaySecondaryName(string? hostName, string? displayName) => !string.IsNullOrWhiteSpace(hostName) && !string.IsNullOrWhiteSpace(displayName) && !string.Equals(hostName, displayName, StringComparison.OrdinalIgnoreCase) ? $" · {displayName}" : string.Empty;
    private static string? FirstPresent(params string?[] values) => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();
    private static Color UpdateStatusColor(string status) => status switch { "Accepted" or "GatewayReadmitted" => Color.Success, "FailedPreActivation" or "RolledBack" or "RollbackUnverified" => Color.Error, "Downloading" or "Staged" or "Activating" => Color.Info, _ => Color.Default };
}

