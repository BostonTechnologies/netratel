@page "/software-inventory"
@using NetRatel.Shared.Contracts.SoftwareInventory
@using NetRatel.Web.Services.SoftwareInventory
@using NetRatel.Web.Components.SoftwareInventory
@using NetRatel.Web.Components.Shared.Navigation
@implements IDisposable
@inject ISoftwareInventoryApiService Api

<PageTitle>Installed Software · Fleet</PageTitle>
<div class="pa-4">
    <WorkspaceHeader Area="WorkspaceArea.Fleet" />
    <div class="inventory-tenant-selector" data-testid="inventory-tenant-selector">
        <MudAutocomplete T="SoftwareInventoryTenant" Label="Tenant" Value="_tenant" ValueChanged="SelectTenant"
                         SearchFunc="FindTenantsAsync" ToStringFunc="@(tenant => tenant?.Name ?? string.Empty)"
                         Strict="false" CoerceValue="false" MinCharacters="0" DebounceInterval="250"
                         MaxItems="TenantOptions" MaxLength="128" Dense="true" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Disabled="_loading">
            <NoItemsTemplate><MudText Typo="Typo.caption" Class="pa-3">No matching tenants.</MudText></NoItemsTemplate>
            <MoreItemsTemplate><MudText Typo="Typo.caption" Class="pa-3">Type more to narrow the results.</MudText></MoreItemsTemplate>
        </MudAutocomplete>
    </div>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading authorized tenants" /> }
    @if (_error is not null) { <MudAlert Severity="Severity.Warning" Dense="true">@_error <MudButton OnClick="LoadInitialTenantAsync">Retry</MudButton></MudAlert> }
    @if (_tenant is { } selected)
    {
        <SoftwareInventoryPanel @key="selected.TenantId" TenantId="selected.TenantId" />
    }
    else if (!_loading && _error is null)
    {
        <MudPaper Outlined="true" Elevation="0" Class="pa-8">
            <MudText Typo="Typo.h6">No accessible tenants</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Software inventory requires read access to at least one tenant.</MudText>
        </MudPaper>
    }
</div>

@code {
    private const int TenantOptions = 25;
    private readonly CancellationTokenSource _lifetime = new();
    private SoftwareInventoryTenant? _tenant;
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadInitialTenantAsync();

    private async Task LoadInitialTenantAsync()
    {
        _loading = true;
        try
        {
            var tenants = await FindTenantsAsync(null, _lifetime.Token);
            _tenant ??= tenants.FirstOrDefault();
        }
        finally { _loading = false; }
    }

    private void SelectTenant(SoftwareInventoryTenant? tenant)
    {
        if (tenant is not null) _tenant = tenant;
    }

    private async Task<IEnumerable<SoftwareInventoryTenant>> FindTenantsAsync(string? search, CancellationToken token)
    {
        using var request = CancellationTokenSource.CreateLinkedTokenSource(token, _lifetime.Token);
        try
        {
            var tenants = await Api.TenantsAsync(0, request.Token, search, TenantOptions + 1);
            request.Token.ThrowIfCancellationRequested();
            if (_error is not null)
            {
                _error = null;
                await InvokeAsync(StateHasChanged);
            }
            return tenants.Items;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { return []; }
        catch (Exception error) when (error is HttpRequestException or OperationCanceledException)
        {
            if (!request.IsCancellationRequested)
            {
                _error = "Unable to load authorized tenants. Check your access and connection.";
                await InvokeAsync(StateHasChanged);
            }
            return [];
        }
    }

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
