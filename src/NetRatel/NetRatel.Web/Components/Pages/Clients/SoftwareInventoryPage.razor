@page "/software-inventory"
@using NetRatel.Shared.Contracts.SoftwareInventory
@using NetRatel.Web.Services.SoftwareInventory
@using NetRatel.Web.Components.SoftwareInventory
@implements IDisposable
@inject ISoftwareInventoryApiService Api

<PageTitle>Software Inventory</PageTitle>
<div class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-5" Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h5">Software Inventory</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Asset intelligence · software, device coverage and changes across your estate</MudText>
            </div>
        </MudStack>
        <div style="width:320px;max-width:100%">
            <MudSelect T="int" Label="Tenant" Value="_tenant" ValueChanged="SelectTenant" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_loading">
                @foreach (var tenant in _tenants) { <MudSelectItem T="int" Value="tenant.TenantId">@tenant.Name</MudSelectItem> }
            </MudSelect>
            @if (_more) { <MudButton Size="Size.Small" OnClick="MoreTenantsAsync" Disabled="_loading">Load more tenants</MudButton> }
        </div>
    </MudStack>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading authorized tenants" /> }
    @if (_error is not null) { <MudAlert Severity="Severity.Warning">@_error <MudButton OnClick="MoreTenantsAsync">Retry</MudButton></MudAlert> }
    @if (_tenant > 0)
    {
        <MudPaper Elevation="0" Outlined="true">
            <MudTabs Rounded="true" Border="true" KeepPanelsAlive="false">
                <MudTabPanel Text="Asset intelligence" Icon="@Icons.Material.Filled.Analytics"><SoftwareInventoryPanel @key="_tenant" TenantId="_tenant" /></MudTabPanel>
                <MudTabPanel Text="Collection policy" Icon="@Icons.Material.Filled.Schedule"><SoftwareInventoryPolicyEditor @key="_tenant" TenantId="_tenant" /></MudTabPanel>
            </MudTabs>
        </MudPaper>
    }
    else if (!_loading && _tenants.Count == 0 && _error is null)
    {
        <MudPaper Outlined="true" Elevation="0" Class="pa-8">
            <MudText Typo="Typo.h6">No accessible tenants</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Software inventory requires read access to at least one tenant.</MudText>
        </MudPaper>
    }
</div>

@code {
    private readonly List<SoftwareInventoryTenant> _tenants = [];
    private readonly CancellationTokenSource _lifetime = new();
    private int _tenant, _tenantPage;
    private bool _more, _loading;
    private string? _error;
    protected override Task OnInitializedAsync() => MoreTenantsAsync();
    private void SelectTenant(int tenant) => _tenant = tenant;
    private async Task MoreTenantsAsync()
    {
        if (_loading) return;
        _loading = true; _error = null;
        try
        {
            var page = await Api.TenantsAsync(_tenantPage, _lifetime.Token);
            _lifetime.Token.ThrowIfCancellationRequested();
            _tenants.AddRange(page.Items); _tenantPage++;
            _more = _tenants.Count < page.Total;
            if (_tenant == 0 && _tenants.Count > 0) _tenant = _tenants[0].TenantId;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception error) when (error is HttpRequestException or OperationCanceledException) { _error = "Unable to load authorized tenants. Check your access and connection."; }
        finally { _loading = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
