@page "/clients"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using NetRatel.Web.Models.Clients
@using NetRatel.Web.Services.Clients
@using NetRatel.Web.Components.Dialogs

@inject ClientPresentationService ClientPresentation
@inject NavigationManager Navigation
@inject ILogger<ClientsPage> Logger
@inject IDialogService DialogService

<PageTitle>Clients</PageTitle>

@if (_interactiveReady)
{
    <span data-testid="clients-page-interactive" hidden></span>
}

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4"
              data-testid="client-directory-state"
              data-load-count="@_loadCount"
              data-last-load-trigger="@_lastLoadTrigger"
              data-loading="@(_isLoading ? "true" : "false")">
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudGrid Spacing="3" Justify="Justify.FlexStart">
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="int?" Label="Tenant" @bind-Value="SelectedTenantId" Clearable="true" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int?" Value="@((int?)null)">All Tenants</MudSelectItem>
                    @foreach (var tenant in TenantOptions)
                    {
                        <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              Value="_search"
                              ValueChanged="OnSearchChanged"
                              Label="Search"
                              Placeholder="Name, host, tag, IP or client ID"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" Label="Operating System" @bind-Value="SelectedOs" Clearable="true" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="string" Value="@((string?)null)">All OS</MudSelectItem>
                    @foreach (var os in OsOptions)
                    {
                        <MudSelectItem T="string" Value="@os">@os</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="12" md="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="clients-status-tools">
                        <MudStack Spacing="0" Class="clients-status-filter">
                        <MudText Typo="Typo.caption">Status</MudText>
                        <MudStack Row="true" Spacing="1">
                            <MudChip T="string" Color="Color.Default" Variant="@GetStatusVariant(ClientStatusFilter.All)" OnClick="@(() => SelectedStatus = ClientStatusFilter.All)" aria-label="Show all clients">All</MudChip>
                            <MudChip T="string" Color="Color.Success" Variant="@GetStatusVariant(ClientStatusFilter.Online)" OnClick="@(() => SelectedStatus = ClientStatusFilter.Online)" aria-label="Show online clients">Online</MudChip>
                            <MudChip T="string" Color="Color.Default" Variant="@GetStatusVariant(ClientStatusFilter.Offline)" OnClick="@(() => SelectedStatus = ClientStatusFilter.Offline)" aria-label="Show offline clients">Offline</MudChip>
                        </MudStack>
                    </MudStack>
                    <MudStack Row="true" Spacing="1" Class="clients-view-tools">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Disabled="@_isLoading"
                                       OnClick="ReloadClientsAsync"
                                       aria-label="Refresh clients" />
                        <MudIconButton Icon="@(_view == ClientListView.Cards ? Icons.Material.Filled.TableRows : Icons.Material.Filled.GridView)"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       OnClick="ToggleView"
                                       aria-label="Switch client view" />
                    </MudStack>
                </MudStack>
            </MudItem>
        </MudGrid>
        @if (_selectedClientId is { } clientId)
        {
            <div class="mt-3" data-testid="client-exact-filter">
                <MudChip T="Guid" Value="clientId" Variant="Variant.Outlined" Color="Color.Primary" OnClose="ClearClientFilter">Client: @SelectedClientName</MudChip>
            </div>
        }
    </MudPaper>

    @if (_isLoading && _clients.Count == 0)
    {
        <div class="d-flex align-center" role="status" aria-live="polite" aria-busy="true">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Class="ml-2">Loading clients...</MudText>
        </div>
    }
    else if (_directoryFailure is { } failure)
    {
        <div role="alert">
            <MudAlert Severity="Severity.Error" Class="clients-directory-error">
                <MudStack Spacing="2" AlignItems="AlignItems.Start">
                    <MudText>@GetDirectoryFailureMessage(failure)</MudText>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Outlined"
                               Disabled="@_isLoading"
                               OnClick="ReloadClientsAsync"
                               data-testid="retry-client-directory">
                        Retry
                    </MudButton>
                </MudStack>
            </MudAlert>
        </div>
    }
    else if (_clients.Count == 0)
    {
        <div role="status" aria-live="polite">
            <MudAlert Severity="Severity.Info">
                No registered clients yet. Clients will appear here after they enroll.
            </MudAlert>
        </div>
    }
    else if (FilteredClients.Count == 0)
    {
        <div role="status" aria-live="polite">
            <MudAlert Severity="Severity.Info">No clients match the active filters.</MudAlert>
        </div>
    }
    else
    {
        @if (_view == ClientListView.Table)
        {
            <ClientGridView Clients="@FilteredClients" RefreshRequested="ReloadClientsAsync" RemoveRequested="RemoveAsync" />
        }
        else
        {
            <ClientCardGrid Clients="@FilteredClients" RefreshRequested="ReloadClientsAsync" RemoveRequested="RemoveAsync" />
        }
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    [SupplyParameterFromQuery(Name = "tenantId")]
    public int? TenantId { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "clientId")]
    public Guid? ClientId { get; set; }

    [SupplyParameterFromQuery(Name = "os")]
    public string? OperatingSystem { get; set; }

    private IReadOnlyList<ClientPresentationModel> _clients = [];
    private bool _isLoading = true;
    private bool _loadStarted;
    private int _loadCount;
    private bool _interactiveReady;
    private string _lastLoadTrigger = "initial";
    private ClientPresentationFailure? _directoryFailure;
    private int? _selectedTenantId;
    private Guid? _selectedClientId;
    private string? _selectedOs;
    private ClientStatusFilter _selectedStatus = ClientStatusFilter.All;
    private string _search = string.Empty;
    private ClientListView _view = ClientListView.Cards;
    private CancellationTokenSource? _refreshLoop;

    private int? SelectedTenantId
    {
        get => _selectedTenantId;
        set { if (_selectedTenantId != value) { _selectedTenantId = value; NavigateWithQuery(); } }
    }

    private string? SelectedOs
    {
        get => _selectedOs;
        set { if (!string.Equals(_selectedOs, value, StringComparison.OrdinalIgnoreCase)) { _selectedOs = value; NavigateWithQuery(); } }
    }

    private ClientStatusFilter SelectedStatus
    {
        get => _selectedStatus;
        set { if (_selectedStatus != value) { _selectedStatus = value; NavigateWithQuery(); } }
    }

    private IReadOnlyList<(int TenantId, string Name)> TenantOptions => _clients
        .Select(client => (TenantId: client.TenantId, Name: client.TenantName))
        .Distinct()
        .OrderBy(tenant => tenant.Name, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private IReadOnlyList<string> OsOptions => _clients
        .Select(client => client.OperatingSystem)
        .Where(os => !string.IsNullOrWhiteSpace(os))
        .Cast<string>()
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(os => os, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private string SelectedClientName => _clients.FirstOrDefault(client => client.AgentId == _selectedClientId &&
        (!_selectedTenantId.HasValue || client.TenantId == _selectedTenantId.Value))?.DisplayName ?? _selectedClientId?.ToString("D") ?? string.Empty;

    private IReadOnlyList<ClientPresentationModel> FilteredClients => _clients
        .Where(client => !_selectedTenantId.HasValue || client.TenantId == _selectedTenantId.Value)
        .Where(client => !_selectedClientId.HasValue || client.AgentId == _selectedClientId.Value)
        .Where(client => string.IsNullOrWhiteSpace(_selectedOs) || string.Equals(client.OperatingSystem, _selectedOs, StringComparison.OrdinalIgnoreCase))
        .Where(client => _selectedStatus == ClientStatusFilter.All ||
                         (_selectedStatus == ClientStatusFilter.Online && client.Online) ||
                         (_selectedStatus == ClientStatusFilter.Offline && !client.Online))
        .Where(MatchesSearch)
        .OrderBy(client => client.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ThenBy(client => client.TenantId)
        .ThenBy(client => client.AgentId)
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        _refreshLoop = new CancellationTokenSource();
        var refreshToken = _refreshLoop.Token;
        await ReloadClientsAsync(refreshToken, "initial");
        _ = RefreshPeriodicallyAsync(refreshToken);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactiveReady = true;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        _search = Search ?? string.Empty;
        _view = NormalizeView(View);
        _selectedTenantId = TenantId;
        _selectedClientId = ClientId;
        _selectedStatus = NormalizeStatus(Status);
        _selectedOs = OperatingSystem;
    }

    private Task ReloadClientsAsync() => ReloadClientsAsync(_refreshLoop?.Token ?? CancellationToken.None, "manual");

    private async Task RemoveAsync(ClientPresentationModel client)
    {
        if (!client.CanManage) return;
        var parameters = new DialogParameters<ClientOffboardingDialog> { { dialog => dialog.Client, client } };
        var dialog = await DialogService.ShowAsync<ClientOffboardingDialog>("Remove client", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true, CloseButton = true });
        if (await dialog.Result is { Canceled: false }) await ReloadClientsAsync();
    }

    private async Task ReloadClientsAsync(CancellationToken cancellationToken, string trigger)
    {
        if (_isLoading && _loadStarted)
        {
            return;
        }

        _loadStarted = true;
        _lastLoadTrigger = trigger;
        _isLoading = true;
        try
        {
            var result = await ClientPresentation.GetClientsAsync(cancellationToken);
            _directoryFailure = result.Failure;
            _clients = result.Clients;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load the authoritative client directory.");
            _directoryFailure = new(ClientPresentationFailureKind.Unknown);
        }
        finally
        {
            _loadCount++;
            _isLoading = false;
            if (!cancellationToken.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RefreshPeriodicallyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await ReloadClientsAsync(cancellationToken, "periodic");
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
    }

    private bool MatchesSearch(ClientPresentationModel client)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var term = _search.Trim();
        if (Guid.TryParse(term, out var agentId)) return client.AgentId == agentId;
        return Contains(client.DisplayName, term) || Contains(client.HostName, term) ||
               Contains(client.OperatingSystem, term) || Contains(client.TenantName, term) ||
               Contains(client.AgentVersion, term) || Contains(client.FriendlyName, term) ||
               Contains(client.ReportedAddress, term) || client.DisplayTags.Any(tag => Contains(tag, term));
    }

    private void OnSearchChanged(string? value)
    {
        _search = value ?? string.Empty;
        NavigateWithQuery(replaceHistory: true);
    }

    private void ClearClientFilter()
    {
        _selectedClientId = null;
        NavigateWithQuery();
    }

    private void ToggleView()
    {
        _view = _view == ClientListView.Cards ? ClientListView.Table : ClientListView.Cards;
        NavigateWithQuery();
    }

    private void NavigateWithQuery(bool replaceHistory = false)
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            ["view"] = _view == ClientListView.Table ? "table" : "cards",
            ["tenantId"] = _selectedTenantId,
            ["clientId"] = _selectedClientId,
            ["status"] = _selectedStatus switch { ClientStatusFilter.Online => "online", ClientStatusFilter.Offline => "offline", _ => null },
            ["os"] = string.IsNullOrWhiteSpace(_selectedOs) ? null : _selectedOs
        });
        Navigation.NavigateTo(uri, replace: replaceHistory);
    }

    private static ClientStatusFilter NormalizeStatus(string? status) => status?.ToLowerInvariant() switch
    {
        "online" => ClientStatusFilter.Online,
        "offline" => ClientStatusFilter.Offline,
        _ => ClientStatusFilter.All
    };

    private static ClientListView NormalizeView(string? view) =>
        string.Equals(view, "table", StringComparison.OrdinalIgnoreCase) ? ClientListView.Table : ClientListView.Cards;

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private Variant GetStatusVariant(ClientStatusFilter status) =>
        _selectedStatus == status ? Variant.Filled : Variant.Outlined;

    private static string GetDirectoryFailureMessage(ClientPresentationFailure failure) => failure.Kind switch
    {
        ClientPresentationFailureKind.AuthenticationRequired => "Your session is no longer authorized to read the client directory. Sign in again, then retry.",
        ClientPresentationFailureKind.PermissionDenied => "Your account does not have permission to read the client directory. Ask an administrator to grant access.",
        ClientPresentationFailureKind.RouteUnavailable => "The API does not expose the client directory route. Verify that the web app points to the expected API and retry.",
        ClientPresentationFailureKind.Timeout => "The API did not respond in time. Check API health and connectivity, then retry.",
        ClientPresentationFailureKind.BackendUnavailable => $"The API could not load the client directory (HTTP {(int?)failure.StatusCode}). Check API health and logs, then retry.",
        ClientPresentationFailureKind.NetworkUnavailable => "The web app could not reach the API. Check web-to-API connectivity, then retry.",
        ClientPresentationFailureKind.InvalidResponse => "The API returned an unreadable client directory response. Check that the web app and API versions match, then retry.",
        ClientPresentationFailureKind.RequestRejected => $"The API rejected the client directory request (HTTP {(int?)failure.StatusCode}). Check the API request logs, then retry.",
        _ => "The client directory could not be loaded. Check API health and connectivity, then retry."
    };

    private enum ClientStatusFilter
    {
        All,
        Online,
        Offline
    }

    private enum ClientListView
    {
        Cards,
        Table
    }

    public ValueTask DisposeAsync()
    {
        _refreshLoop?.Cancel();
        _refreshLoop?.Dispose();
        return ValueTask.CompletedTask;
    }
}
