@page "/ai/ops"
@rendermode InteractiveServer
@attribute [Authorize]
@using NetRatel.Shared.Contracts.Netclaw
@using NetRatel.Web.Services
@using NetRatel.Web.Components.Shared.Netclaw
@using System.Net
@implements IAsyncDisposable
@inject INetclawApiService Api

<PageTitle>AI Ops · Investigations</PageTitle>
<main class="ai-ops @(_creating ? "is-creating" : "")" data-testid="ai-ops">
    <header class="ai-toolbar" aria-label="Investigation workspace">
        <h1 title="Follow alerts, inspect systems and work through the evidence with your AI assistant.">Investigations</h1>
        <label>Tenant<select value="@_tenant" @onchange="ChooseTenantAsync" disabled="@(_loading || _busy)">
            @foreach (var tenant in _tenants) { <option value="@tenant.TenantId">@tenant.TenantName</option> }
        </select></label>
        <button type="button" @onclick="ReloadAsync" disabled="@(_loading || _busy || _tenant == 0)" aria-label="Refresh investigations">Refresh</button>
        <button type="button" class="ai-primary" @onclick="() => _creating = !_creating" disabled="@(Access?.CanInvestigate != true || _busy)" data-testid="ai-new-investigation">New investigation</button>
        <div class="ai-connection-slot"><NetclawConnectionStatus TenantId="_tenant" TenantName="@(Access?.TenantName)" Connection="_connection" /></div>
    </header>
    @if (_error is not null) { <div class="ai-notice" role="alert">@_error</div> }
    @if (_loading) { <p role="status">Loading your authorized investigation workspace…</p> }
    else if (_tenants.Count == 0) { <div class="ai-empty"><h2>No investigation access</h2><p>A tenant role with read telemetry permission grants access to this workspace.</p></div> }
    else
    {
        <div class="ai-metrics" aria-label="Recent investigation status">
            <div title="Active in recent history"><span>Active</span><strong>@_items.Count(x => x.State is InvestigationState.Processing or InvestigationState.Queued)</strong></div>
            <div><span>Waiting for your decision</span><strong>@_items.Count(x => x.State == InvestigationState.AwaitingApproval)</strong></div>
            <div><span>Needs recovery</span><strong>@_items.Count(x => x.State == InvestigationState.DeliveryUnknown)</strong></div>
        </div>
        @if (_creating)
        {
            <section class="ai-create" aria-label="New investigation">
                <h2>Start with a question and the right systems</h2>
                <label>Investigation title<input @bind="_title" maxlength="200" placeholder="For example: PostgreSQL latency after the update" /></label>
                <label>Find systems<input value="@_systemSearch" @oninput="SearchSystemsAsync" placeholder="Hostname, friendly name, IP or tag" /></label>
                <div class="ai-system-picker">
                    @foreach (var client in FilteredClients)
                    {
                        <label @key="client.AgentId"><input type="checkbox" checked="@_selectedClients.Contains(client.AgentId)" @onchange="e => SelectClient(client.AgentId, e)" />
                            <span><strong>@client.HostName</strong><small>@ClientDetails(client)</small><small>@client.AgentId</small></span></label>
                    }
                </div>
                @if (_clientNextOffset is not null) { <button type="button" @onclick="LoadMoreSystemsAsync" disabled="@_busy">More matching systems</button> }
                <p>@_selectedClients.Count / 20 systems selected. Metadata is included with each request.</p>
                <div class="ai-context">@foreach (var id in _selectedClients) { <span>@(_knownClients.GetValueOrDefault(id)?.HostName ?? "Unknown hostname") · @id.ToString("N")[..8]</span> }</div>
                <PromptPicker TenantId="_tenant" Selected="_selectedPrompts" SelectedChanged="SelectPrompts" Disabled="_busy" />
                <div class="ai-actions"><button type="button" class="ai-primary" disabled="@(_busy || _selectedClients.Count == 0 || string.IsNullOrWhiteSpace(_title))" @onclick="CreateAsync">Open investigation</button><button type="button" @onclick="() => _creating = false" disabled="@_busy">Cancel</button></div>
            </section>
        }
        <div class="ai-workspace">
            <aside class="ai-investigation-list" aria-label="Recent investigations">
                <label>Find investigations<input @bind="_search" @bind:event="oninput" placeholder="Title or client" /></label>
                <label>Status<select @bind="_filter"><option value="all">All recent investigations</option><option value="active">Active</option><option value="approval">Waiting for approval</option><option value="recovery">Needs recovery</option><option value="archived">Archived</option></select></label>
                @if (!FilteredItems.Any()) { <p class="ai-muted">No matching investigations. Open one or add an AI investigation action to a monitoring Flow.</p> }
                @foreach (var item in FilteredItems)
                {
                    <button type="button" @key="item.Id" class="ai-investigation @(_snapshot?.Investigation.Id == item.Id ? "selected" : "")" @onclick="() => OpenAsync(item.Id)" disabled="@_busy" aria-pressed="@(_snapshot?.Investigation.Id == item.Id)">
                        <span class="ai-state">@StateLabel(item.State)</span><strong>@item.Title</strong>
                        <small>@(item.OccurrenceId is null ? "Manual investigation" : "Monitoring alert") · @item.AgentIds.Count system(s)</small>
                        <small>@item.LastActivityUtc.ToLocalTime().ToString("g")</small>
                    </button>
                }
            </aside>
            @if (_snapshot is null)
            {
                <section class="ai-conversation"><div class="ai-empty"><h2>Start from an alert. Find the cause.</h2><p>Open an investigation to review its evidence and conversation, or choose systems for a new investigation.</p><a href="/flows">Configure an AI action in Flows</a></div></section>
            }
            else
            {
                <NetclawConversation @key="_snapshot.Investigation.Id" Snapshot="_snapshot" Events="_events" TenantName="@(Access?.TenantName)"
                    @bind-Message="_message" Busy="_busy" CanInvestigate="@(Access?.CanInvestigate == true)"
                    CanEditMessage="@(_pendingMessage is null && !_busy && Access?.CanInvestigate == true && _snapshot.Investigation.State == InvestigationState.Idle)"
                    CanSend="@(!_busy && Access?.CanInvestigate == true && _snapshot.Investigation.State == InvestigationState.Idle && !string.IsNullOrWhiteSpace(_message))"
                    SendLabel="@(_pendingMessage is null ? "Send" : "Retry same request")"
                    Send="SendAsync" Recover="RecoverAsync" LoadMore="LoadMoreAsync"
                    Archive="@(async (bool acknowledge) => { _acknowledgeRemote = acknowledge; await ArchiveAsync(); })"
                    Approve="@(decision => ApproveAsync(decision.CallId, decision.Key))">
                    <Context>
                        <small>Investigation @_snapshot.Investigation.Id</small>
                    <div class="ai-context" aria-label="System context">
                        @foreach (var client in _snapshot.Clients) { <span title="@(ClientDetails(client) + " · " + client.AgentId)">@client.HostName · @client.PrimaryIpAddress<small>@(client.FriendlyName ?? client.DisplayName) · @client.OperatingSystem · @client.Status · @client.AgentId.ToString("N")[..8]</small></span> }
                        @if (_snapshot.Investigation.OccurrenceId is not null) { <a href="@($"/monitoring?tenantId={_tenant}")">View monitoring</a> }
                        @if (_snapshot.Investigation.FlowRunId is { } run) { <a href="@($"/flows?tenantId={_tenant}&run={run:D}")">Flow run</a> }
                    </div>
                    @if (_snapshot.Prompts is { Count: > 0 } prompts)
                    {
                        <details class="ai-activity"><summary>Saved guidance · @prompts.Count prompt(s)</summary>
                            @foreach (var prompt in prompts) { <details><summary>@prompt.Name · revision @prompt.Revision @(prompt.IsDefault ? "· Always included" : "")</summary><p>@prompt.Description</p><pre class="ai-context-preview">@prompt.Body</pre></details> }
                        </details>
                    }
                    @if (_snapshot.SentContext is { } context)
                    {
                        <details class="ai-activity"><summary>Effective context · @context.PayloadBytes bytes · @context.PreparedAtUtc.ToString("u")</summary>
                            <p>@(context.SendAttemptedAtUtc is { } attempted ? $"Send attempted at {attempted:u}." : "Prepared context.") Message @context.MessageId</p>
                            @foreach (var note in context.OmissionNotes) { <p>@note</p> }
                            <pre class="ai-context-preview">@context.Request</pre>
                        </details>
                    }
                    </Context>
                </NetclawConversation>
            }
        </div>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")] public int? RequestedTenant { get; set; }
    [SupplyParameterFromQuery(Name = "investigation")] public Guid? RequestedInvestigation { get; set; }
    [SupplyParameterFromQuery(Name = "occurrenceId")] public Guid? RequestedOccurrence { get; set; }
    [SupplyParameterFromQuery(Name = "agentId")] public Guid? RequestedAgent { get; set; }
    private IReadOnlyList<NetclawTenantDto> _tenants = [];
    private IReadOnlyList<InvestigationClientDto> _clients = [];
    private IReadOnlyList<InvestigationSummaryDto> _items = [];
    private readonly HashSet<Guid> _selectedClients = [];
    private readonly Dictionary<Guid, InvestigationClientDto> _knownClients = [];
    private IReadOnlyList<AiPromptReference> _selectedPrompts = [];
    private int? _clientNextOffset;
    private int _clientSearchRevision;
    private CancellationTokenSource? _clientSearchScope;
    private readonly List<InvestigationEventDto> _events = [];
    private NetclawConnectionDto? _connection;
    private InvestigationSnapshotDto? _snapshot;
    private string? _error;
    private string _search = "", _systemSearch = "", _filter = "all", _title = "", _message = "";
    private int _tenant, _generation;
    private bool _loading = true, _busy, _creating, _disposed, _acknowledgeRemote;
    private Guid _createRequestId = Guid.NewGuid();
    private InvestigationMessageRequest? _pendingMessage;
    private CancellationTokenSource _scope = new();
    private Task _polling = Task.CompletedTask;
    private NetclawTenantDto? Access => _tenants.FirstOrDefault(x => x.TenantId == _tenant);
    private long Cursor => _events.LastOrDefault()?.Sequence ?? 0;
    private IEnumerable<InvestigationClientDto> FilteredClients => _clients;
    private IEnumerable<InvestigationSummaryDto> FilteredItems => _items.Where(x => (_search.Length == 0 || x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.AgentIds.Any(id => _clients.Any(c => c.AgentId == id && c.HostName.Contains(_search, StringComparison.OrdinalIgnoreCase)))) && (_filter switch
    { "active" => x.State is InvestigationState.Processing or InvestigationState.Queued, "approval" => x.State == InvestigationState.AwaitingApproval, "recovery" => x.State == InvestigationState.DeliveryUnknown, "archived" => x.State == InvestigationState.Archived, _ => true }));
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tenants = await Api.TenantsAsync(_scope.Token);
            _tenant = RequestedTenant is { } requested ? _tenants.FirstOrDefault(x => x.TenantId == requested)?.TenantId ?? 0 : _tenants.FirstOrDefault()?.TenantId ?? 0;
            if (_tenant > 0) await LoadTenantAsync();
            else if (RequestedTenant.HasValue) _error = "The linked tenant is unavailable to this account.";
        }
        catch (HttpRequestException exception) { _error = exception.Message; }
        catch (OperationCanceledException) when (_scope.IsCancellationRequested) { return; }
        catch (OperationCanceledException) { _error = "The workspace request timed out. Refresh to reconnect."; }
        finally { _loading = false; }
        _polling = PollAsync(_scope.Token);
    }
    private async Task LoadTenantAsync()
    {
        var tenant = _tenant; var generation = _generation; var ct = _scope.Token;
        var clients = await Api.SearchClientsAsync(tenant, ct: ct); var items = await Api.ListAsync(tenant, ct); var connection = await Api.ConnectionAsync(tenant, ct);
        if (!Current(tenant, generation)) return;
        _clients = clients.Items; _clientNextOffset = clients.NextOffset; foreach (var client in clients.Items) _knownClients[client.AgentId] = client; _items = items; _connection = connection;
        if (RequestedTenant == tenant && RequestedAgent is { } agent && clients.Items.Any(x => x.AgentId == agent)) { _selectedClients.Add(agent); _creating = true; }
        if (RequestedTenant == tenant && RequestedInvestigation is { } id) await OpenCoreAsync(id);
    }
    private bool Current(int tenant, int generation) => !_disposed && tenant == _tenant && generation == _generation;
    private async Task ChooseTenantAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var tenant) || tenant == _tenant || !_tenants.Any(x => x.TenantId == tenant)) return;
        ++_generation; _tenant = tenant; _snapshot = null; _events.Clear(); _items = []; _clients = []; _selectedClients.Clear(); _connection = null;
        _knownClients.Clear(); _selectedPrompts = []; _systemSearch = ""; _clientNextOffset = null; ++_clientSearchRevision; _clientSearchScope?.Cancel();
        _creating = false; _message = ""; _pendingMessage = null; _error = null;
        await CommandAsync(LoadTenantAsync);
    }
    private async Task CommandAsync(Func<Task> action)
    {
        if (_busy || _disposed) return; _busy = true; _error = null;
        try { await action(); }
        catch (OperationCanceledException) when (_scope.IsCancellationRequested) { return; }
        catch (OperationCanceledException) { _error = "The request timed out. Its saved state remains available through Refresh."; }
        catch (HttpRequestException exception) { _error = exception.Message; }
        finally { _busy = false; }
    }
    private Task ReloadAsync() => CommandAsync(async () =>
    {
        var generation = _generation; var tenant = _tenant;
        var items = await Api.ListAsync(tenant, _scope.Token); var connection = await Api.ConnectionAsync(tenant, _scope.Token);
        if (!Current(tenant, generation)) return; _items = items; _connection = connection;
        if (_snapshot is not null) Apply(await Api.GetAsync(tenant, _snapshot.Investigation.Id, Cursor, _scope.Token));
        else if (RequestedTenant == tenant && RequestedInvestigation is { } requested) await OpenCoreAsync(requested);
    });
    private Task OpenAsync(Guid id) => CommandAsync(() => OpenCoreAsync(id));
    private async Task OpenCoreAsync(Guid id)
    {
        var tenant = _tenant; var generation = _generation;
        var snapshot = await Api.GetAsync(tenant, id, 0, _scope.Token); if (!Current(tenant, generation)) return;
        _events.Clear(); _snapshot = null; _message = ""; _pendingMessage = null; Apply(snapshot);
    }
    private void Apply(InvestigationSnapshotDto snapshot)
    {
        if (snapshot.Investigation.TenantId != _tenant || _snapshot is not null && (_snapshot.Investigation.Id != snapshot.Investigation.Id || _snapshot.LastSequence > snapshot.LastSequence)) return;
        foreach (var item in snapshot.Events) if (_events.All(x => x.Sequence != item.Sequence)) _events.Add(item);
        _events.Sort((left, right) => left.Sequence.CompareTo(right.Sequence)); _snapshot = snapshot;
        if (_pendingMessage is not null && _events.Any(x => x.Type == "operator" && x.MessageId == _pendingMessage.MessageId)) { _pendingMessage = null; _message = ""; }
        _items = _items.Where(x => x.Id != snapshot.Investigation.Id).Append(snapshot.Investigation).OrderByDescending(x => x.LastActivityUtc).ToArray();
    }
    private void SelectPrompts(IReadOnlyList<AiPromptReference> prompts) => _selectedPrompts = prompts;
    private static string ClientDetails(InvestigationClientDto client) => string.Join(" · ", new[]
    {
        client.FriendlyName ?? client.DisplayName, client.OperatingSystem, client.Architecture, client.PrimaryIpAddress,
        client.Status, client.AgentVersion, client.ObservedAtUtc is { } observed ? $"Observed {observed:u}" : "Observation unknown",
        string.Join(" · ", client.Tags)
    }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private async Task SearchSystemsAsync(ChangeEventArgs e)
    {
        _systemSearch = e.Value?.ToString() ?? "";
        _clientSearchScope?.Cancel(); _clientSearchScope?.Dispose();
        _clientSearchScope = CancellationTokenSource.CreateLinkedTokenSource(_scope.Token);
        var ct = _clientSearchScope.Token; var tenant = _tenant; var generation = _generation; var revision = ++_clientSearchRevision;
        try
        {
            var page = await Api.SearchClientsAsync(tenant, _systemSearch, ct: ct);
            if (!Current(tenant, generation) || revision != _clientSearchRevision) return;
            _clients = page.Items; _clientNextOffset = page.NextOffset;
            foreach (var client in page.Items) _knownClients[client.AgentId] = client;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (HttpRequestException exception) { if (Current(tenant, generation) && revision == _clientSearchRevision) _error = exception.Message; }
    }
    private Task LoadMoreSystemsAsync() => CommandAsync(async () =>
    {
        if (_clientNextOffset is not { } offset) return;
        var tenant = _tenant; var generation = _generation; var revision = _clientSearchRevision;
        var page = await Api.SearchClientsAsync(tenant, _systemSearch, offset, _scope.Token);
        if (!Current(tenant, generation) || revision != _clientSearchRevision) return;
        _clients = _clients.Concat(page.Items).DistinctBy(x => x.AgentId).ToArray(); _clientNextOffset = page.NextOffset;
        foreach (var client in page.Items) _knownClients[client.AgentId] = client;
    });
    private void SelectClient(Guid id, ChangeEventArgs e)
    { if (e.Value is true && _selectedClients.Count < 20) _selectedClients.Add(id); else _selectedClients.Remove(id); }
    private Task CreateAsync() => CommandAsync(async () =>
    {
        var request = new InvestigationCreateRequest(_createRequestId, _title, _selectedClients.ToArray(), RequestedTenant == _tenant ? RequestedOccurrence : null, _selectedPrompts);
        var snapshot = await Api.CreateAsync(_tenant, request, _scope.Token);
        _events.Clear(); _snapshot = null; Apply(snapshot); _creating = false; _createRequestId = Guid.NewGuid(); _title = "";
    });
    private Task SendAsync() => CommandAsync(async () =>
    {
        if (_snapshot is null || _snapshot.Investigation.State != InvestigationState.Idle) return;
        _pendingMessage ??= new(Guid.NewGuid(), _message.Trim());
        try { Apply(await Api.SendAsync(_tenant, _snapshot.Investigation.Id, _pendingMessage, _scope.Token)); }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.BadRequest)
        { _pendingMessage = null; throw; }
        _pendingMessage = null; _message = "";
    });
    private Task ApproveAsync(string callId, string key) => CommandAsync(async () =>
    { if (_snapshot is not null) Apply(await Api.ApproveAsync(_tenant, _snapshot.Investigation.Id, callId, key, _scope.Token)); });
    private Task RecoverAsync() => CommandAsync(async () =>
    { if (_snapshot is not null) Apply(await Api.ReconcileAsync(_tenant, _snapshot.Investigation.Id, _scope.Token)); });
    private Task ArchiveAsync() => CommandAsync(async () =>
    {
        if (_snapshot is null) return;
        Apply(await Api.ArchiveAsync(_tenant, _snapshot.Investigation.Id, new(_snapshot.ActiveMessageId ?? Guid.Empty, _acknowledgeRemote), _scope.Token));
        _acknowledgeRemote = false;
    });
    private Task LoadMoreAsync() => CommandAsync(async () =>
    { if (_snapshot is not null) Apply(await Api.GetAsync(_tenant, _snapshot.Investigation.Id, Cursor, _scope.Token)); });
    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2)); var ticks = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_busy || _tenant == 0) continue;
                await InvokeAsync(async () =>
                {
                    var tenant = _tenant; var generation = _generation; var id = _snapshot?.Investigation.Id;
                    try
                    {
                        if (id is { } selected)
                        { var snapshot = await Api.GetAsync(tenant, selected, Cursor, ct); if (Current(tenant, generation) && _snapshot?.Investigation.Id == selected) Apply(snapshot); }
                        if (++ticks % 5 == 0) { var items = await Api.ListAsync(tenant, ct); if (Current(tenant, generation)) _items = items; }
                    }
                    catch (HttpRequestException exception) { if (Current(tenant, generation)) _error = exception.Message; }
                    catch (OperationCanceledException) when (!ct.IsCancellationRequested) { if (Current(tenant, generation)) _error = "Live updates are reconnecting. Your saved conversation remains visible."; }
                    if (!_disposed) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
    }
    private static string StateLabel(InvestigationState state) => state switch
    { InvestigationState.Idle => "Ready", InvestigationState.Processing => "Investigating", InvestigationState.AwaitingApproval => "Approval needed", InvestigationState.DeliveryUnknown => "Outcome unconfirmed", InvestigationState.Queued => "Queued", _ => "Archived" };
    public async ValueTask DisposeAsync() { _clientSearchScope?.Cancel(); _clientSearchScope?.Dispose(); _disposed = true; ++_generation; await _scope.CancelAsync(); await _polling; _scope.Dispose(); }
}
