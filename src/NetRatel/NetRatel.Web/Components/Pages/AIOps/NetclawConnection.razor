@page "/ai/integration"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager Navigation

<PageTitle>Netclaw integration</PageTitle>
<p>Opening Netclaw integration… <a href="@Destination">Continue</a></p>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")] public int? RequestedTenant { get; set; }
    private string Destination => RequestedTenant is { } tenant
        ? $"/account/integration-credentials?tab=netclaw&tenantId={tenant}"
        : "/account/integration-credentials?tab=netclaw";
    protected override void OnParametersSet()
    {
        // Query notifications can arrive while the router is replacing this legacy page.
        if (Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0].Trim('/') != "ai/integration") return;
        if (Navigation.Uri == Navigation.ToAbsoluteUri(Destination).AbsoluteUri) return;
        Navigation.NavigateTo(Destination, replace: true);
    }
}
