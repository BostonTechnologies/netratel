@page "/ai/chat"
@rendermode InteractiveServer
@attribute [Authorize]
@using NetRatel.Shared.Contracts.Netclaw
@using NetRatel.Web.Components.Shared.Netclaw
@implements IAsyncDisposable
@inject NetRatel.Web.Services.INetclawApiService Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Chat · NetRatel</PageTitle>

<main class="chat-page" data-testid="netclaw-chat">
    <header class="chat-page-heading">
        <div>
            <p class="chat-eyebrow">AI OPERATIONS</p>
            <h1>Chat</h1>
            <p class="chat-page-description">A place to work things through with Netclaw.</p>
        </div>
        <div class="chat-workspace-controls">
            <label class="chat-tenant">Tenant
                <select value="@_tenant" @onchange="ChooseTenant" disabled="@(_busy || _tenants.Count == 0)" data-testid="chat-tenant">
                    @if (_tenant == 0) { <option value="0">Select a tenant</option> }
                    @foreach (var tenant in _tenants) { <option value="@tenant.TenantId">@tenant.TenantName</option> }
                </select>
            </label>
            @if (_tenant > 0)
            {
                <NetclawConnectionStatus TenantId="_tenant" TenantName="@(Access?.TenantName)" Connection="_connection" />
            }
        </div>
    </header>

    @if (_error is not null && _snapshot is null)
    {
        <div class="chat-notice chat-error" role="alert"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" /><span>@_error</span></div>
    }
    @if (_loading)
    {
        <div class="chat-loading" role="status"><span class="chat-loading-dot"></span>Opening your chat workspace…</div>
    }
    else if (_tenant == 0)
    {
        <section class="chat-no-access"><MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" /><h2>No chat workspace available</h2><p>Select an available tenant with AI Ops access to continue.</p></section>
    }
    else
    {
        <div class="chat-workspace">
            <aside class="chat-history" aria-label="Chat history">
                <button type="button" class="chat-new-button" @onclick="NewChat" disabled="@(_busy || !CanStart)" data-testid="chat-new">
                    <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" /><span>New chat</span>
                </button>
                <label class="chat-history-search"><span class="chat-visually-hidden">Search recent chats</span><MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" /><input @bind="_search" @bind:event="oninput" placeholder="Search recent chats" /></label>
                <div class="chat-history-label"><span>RECENT CONVERSATIONS</span><button type="button" class="chat-icon-button" @onclick="RefreshAsync" disabled="@_busy" title="Refresh chats" aria-label="Refresh chats"><MudIcon Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" /></button></div>
                <nav class="chat-history-list" aria-label="Saved conversations">
                    @if (!FilteredItems.Any())
                    {
                        <p class="chat-history-empty">@(_search.Length > 0 ? "No matching chats." : "Tenant conversations will appear here.")</p>
                    }
                    @foreach (var item in FilteredItems)
                    {
                        <a @key="item.Id" href="@ChatUrl(_tenant, item.Id)" class="chat-history-item @(_snapshot?.Investigation.Id == item.Id ? "selected" : "")" aria-current="@(_snapshot?.Investigation.Id == item.Id ? "page" : null)">
                            <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Small" />
                            <span><strong>@item.Title</strong><small><span class="chat-state-dot @StateClass(item.State)"></span>@StateLabel(item.State)<span class="chat-history-time" title="@TimestampTitle(item.LastActivityUtc)">@HistoryDate(item.LastActivityUtc)</span></small></span>
                        </a>
                    }
                </nav>
                <label class="chat-archive-toggle"><input type="checkbox" @bind="_showArchived" />Show archived chats</label>
                <a class="chat-settings-link" href="@ConnectionUrl"><MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" />Netclaw connection</a>
            </aside>

            @if (_snapshot is not null)
            {
                <NetclawConversation @key="_snapshot.Investigation.Id" Snapshot="_snapshot" Events="_events" TenantName="@(Access?.TenantName)"
                    @bind-Message="_message" Busy="_busy" CanInvestigate="@(Access?.CanInvestigate == true)" ConnectionReady="ConnectionReady"
                    CanEditMessage="CanEditMessage" CanSend="CanSend" SendLabel="@(_pendingMessage is null ? "Send" : "Retry message")"
                    Error="@_error" Refresh="ReloadAsync" LiveError="@_liveError" MessageTimeFormatter="MessageTime" Send="SendAsync" Recover="RecoverAsync" LoadMore="LoadMoreAsync"
                    Archive="@(async (bool acknowledge) => { _acknowledgeRemote = acknowledge; await ArchiveAsync(); })"
                    Approve="@(decision => ApproveAsync(decision.CallId, decision.Key))" />
            }
            else
            {
                <section class="chat-canvas" aria-label="Netclaw conversation">
                    <header class="chat-conversation-heading"><div class="chat-assistant-identity"><h2>Netclaw · @Access?.TenantName</h2></div></header>
                    <div class="chat-transcript">
                    @if (!ConnectionReady)
                        {
                            <div class="chat-welcome chat-connect">
                                <div class="chat-welcome-mark"><MudIcon Icon="@Icons.Material.Outlined.Forum" /></div>
                                <p class="chat-eyebrow">YOUR TENANT WORKSPACE</p>
                                <h2>Connect with Netclaw</h2>
                                <p>@(Access?.CanConfigure == true ? "Connect or enable Netclaw for this tenant to start a conversation." : "A tenant administrator can connect or enable Netclaw in Integration.")</p>
                                @if (Access?.CanConfigure == true) { <a class="chat-primary-button" href="@ConnectionUrl">Set up Netclaw <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" /></a> }
                            </div>
                        }
                        else
                        {
                            <div class="chat-welcome">
                                <div class="chat-welcome-mark"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /></div>
                                <p class="chat-eyebrow">NETCLAW · @Access?.TenantName</p>
                                <h2>What would you like to work on?</h2>
                                <p>Write a script, review notifications, or talk through your next task.</p>
                                <div class="chat-starters" aria-label="Conversation starters">
                                    @foreach (var starter in Starters)
                                    {
                                        <button type="button" class="chat-starter" @onclick="() => UseStarterAsync(starter.Prompt)" disabled="@(!CanStart || _busy)"><MudIcon Icon="@starter.Icon" Size="Size.Small" /><strong>@starter.Title</strong><span>@starter.Description</span></button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (ConnectionReady)
                    {
                    <div class="chat-composer-area">
                        <div class="chat-composer">
                            <label class="chat-visually-hidden" for="netclaw-chat-message">Message Netclaw</label>
                            <textarea id="netclaw-chat-message" @ref="_composer" @bind="_message" @bind:event="oninput" @onkeydown="ComposerKeyDownAsync" placeholder="Message Netclaw…" maxlength="16000" rows="3" disabled="@(!CanEditMessage)" data-testid="chat-message"></textarea>
                            <div class="chat-composer-toolbar"><span class="chat-composer-tenant"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" />Netclaw<span>· @Access?.TenantName</span></span><button type="button" class="chat-send-button" @onclick="SendAsync" disabled="@(!CanSend)" data-testid="chat-send"><span>@(_pendingMessage is null ? "Send" : "Retry message")</span><MudIcon Icon="@Icons.Material.Outlined.ArrowUpward" Size="Size.Small" /></button></div>
                        </div>
                        <p class="chat-composer-hint">@(Access?.CanInvestigate == true ? "Ctrl / ⌘ + Enter to send · Enter for a new line" : "Your current access allows you to read saved conversations.")</p>
                    </div>
                    }
                </section>
            }
        </div>
    }
</main>
