@page "/tasks/history"

@using NetRatel.Shared.Contracts.Tasks
@using NetRatel.Web.Services.ClientTasks

@inject TaskApiService TaskApi
@inject ISnackbar Snackbar

@implements IDisposable

<MudStack Spacing="2" Class="task-history-page">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Task history</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="task-history-count">@_total matching runs · @_items.Count on this page</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Text" Size="Size.Small" Href="/tasks/new">New task</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadFromFirstPageAsync" Disabled="_isLoading">Refresh</MudButton>
        </MudStack>
    </MudStack>

    <MudPaper Class="task-history-surface pa-3" Elevation="0">
        <MudStack Spacing="2">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="8">
                    <MudTextField T="string"
                                  Value="_search"
                                  ValueChanged="OnSearchChangedAsync"
                                  Label="Search task, target, or request ID"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true"
                                  data-testid="task-history-search" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="string"
                               Label="Status"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Value="_statusFilter"
                               ValueChanged="OnStatusChangedAsync"
                               data-testid="task-history-status">
                        <MudSelectItem Value="@AllFilter">All statuses</MudSelectItem>
                        <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
                        <MudSelectItem Value="@("Failed")">Failed</MudSelectItem>
                        <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
                        <MudSelectItem Value="@("Processing")">Processing</MudSelectItem>
                        <MudSelectItem Value="@("Running")">Running</MudSelectItem>
                        <MudSelectItem Value="@("Accepted")">Accepted</MudSelectItem>
                        <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                        <MudSelectItem Value="@("TimedOut")">Timed out</MudSelectItem>
                        <MudSelectItem Value="@("Unknown")">Outcome unknown</MudSelectItem>
                        <MudSelectItem Value="@("Skipped")">Skipped</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudTable T="TaskHistoryItemDto"
                      @ref="_table"
                      ServerData="LoadServerDataAsync"
                      Dense="true"
                      Hover="true"
                      Breakpoint="Breakpoint.Md"
                      Loading="_isLoading"
                      RowsPerPage="10"
                      Class="task-history-table"
                      data-testid="task-history-table">
                <HeaderContent>
                    <MudTh>Status</MudTh>
                    <MudTh>Task</MudTh>
                    <MudTh Class="task-history-target-column">Target</MudTh>
                    <MudTh>Queued / started</MudTh>
                    <MudTh>Runtime</MudTh>
                    <MudTh style="width:72px;"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudChip T="string" Color="@TaskStatusColor(context.Status)" Variant="Variant.Outlined" Size="Size.Small">@TaskPresentation.StatusLabel(context.Status)</MudChip>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.subtitle2">@TaskPresentation.Title(context.TaskType, context.ScriptName, context.CommandLabel)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.ScriptType ?? context.TaskType)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="task-history-request-id">@context.RequestId</MudText>
                        @if (!string.IsNullOrWhiteSpace(context.StatusMessage))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="task-history-status-message">@TaskPresentation.ConciseReason(context.StatusMessage)</MudText>
                        }
                    </MudTd>
                    <MudTd Class="task-history-target-column">
                        <MudText Typo="Typo.body2">@GetTaskTargetDisplay(context)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="task-history-target-meta">@TaskPresentation.Tenant(context.TenantName, context.TenantId) · @(context.Environment?.ToString() ?? "Environment not recorded")</MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.caption">Queued @FormatTimestamp(context.Created)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.StartedAt is { } started ? "Started " + FormatTimestamp(started) : TaskPresentation.MissingStart(context.Status) == "Not started" ? "Not started" : "Start not recorded")</MudText>
                    </MudTd>
                    <MudTd>@TaskPresentation.Runtime(context.StartedAt, context.CompletedAt, context.Status)</MudTd>
                    <MudTd Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       aria-label="Open task details"
                                       Href="@($"/tasks/request/{Uri.EscapeDataString(context.RequestId)}")" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.subtitle1" Class="pa-4">No task executions match the current filters.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudStack>
    </MudPaper>
</MudStack>

<style>
  .task-history-surface {
      border: 1px solid var(--mud-palette-divider);
      border-radius: var(--netratel-radius-surface, 7px);
      background: var(--mud-palette-surface);
  }

  .task-history-target-column {
      min-width: 12rem;
      max-width: 22rem;
  }

  .task-history-target-meta,
  .task-history-status-message,
  .task-history-request-id {
      display: -webkit-box;
      overflow: hidden;
      overflow-wrap: anywhere;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
  }
</style>

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    private const string AllFilter = "__all__";

    private readonly CancellationTokenSource _disposeCts = new();
    private IReadOnlyList<TaskHistoryItemDto> _items = [];
    private MudTable<TaskHistoryItemDto>? _table;
    private CancellationTokenSource? _searchDebounceCts;
    private bool _isLoading;
    private long _loadVersion;
    private bool _disposed;
    private int _total;
    private string _search = string.Empty;
    private string _statusFilter = AllFilter;

    protected override void OnInitialized()
    {
        _search = Search ?? string.Empty;
    }

    private async Task<TableData<TaskHistoryItemDto>> LoadServerDataAsync(TableState state, CancellationToken ct)
    {
        var version = ++_loadVersion;
        _isLoading = true;
        try
        {
            var pageSize = state.PageSize <= 0 ? 10 : state.PageSize;
            var page = await TaskApi.GetHistoryAsync(
                state.Page,
                pageSize,
                search: _search,
                status: _statusFilter == AllFilter ? null : _statusFilter,
                cancellationToken: ct).ConfigureAwait(false);

            if (version != _loadVersion || ct.IsCancellationRequested)
                return new TableData<TaskHistoryItemDto> { Items = _items, TotalItems = _total };
            _items = page?.Items ?? [];
            _total = page?.Total ?? 0;
            return new TableData<TaskHistoryItemDto>
            {
                Items = _items,
                TotalItems = _total
            };
        }
        catch (OperationCanceledException)
        {
            return new TableData<TaskHistoryItemDto>
            {
                Items = _items,
                TotalItems = _total
            };
        }
        catch (Exception exception)
        {
            if (version != _loadVersion)
                return new TableData<TaskHistoryItemDto> { Items = _items, TotalItems = _total };
            Snackbar.Add($"Failed to load task history: {exception.Message}", Severity.Warning);
            _items = [];
            _total = 0;
            return new TableData<TaskHistoryItemDto>
            {
                Items = [],
                TotalItems = 0
            };
        }
        finally
        {
            if (version == _loadVersion) _isLoading = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnSearchChangedAsync(string value)
    {
        _search = value;
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), _searchDebounceCts.Token).ConfigureAwait(false);
            await ReloadFromFirstPageAsync().ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            return;
        }
    }

    private async Task OnStatusChangedAsync(string status)
    {
        _statusFilter = status;
        await ReloadFromFirstPageAsync().ConfigureAwait(false);
    }

    private async Task ReloadFromFirstPageAsync()
    {
        if (_table is null)
        {
            return;
        }

        _table.NavigateTo(0);
        await _table.ReloadServerData().ConfigureAwait(false);
    }

    private static string FormatTimestamp(DateTimeOffset value)
        => value.ToLocalTime().ToString("yyyy/MM/dd HH:mm");

    private static Color TaskStatusColor(string status) => status switch
    {
        "Completed" => Color.Success,
        "Processing" or "Running" or "Accepted" => Color.Info,
        "Failed" => Color.Error,
        "Cancelled" or "TimedOut" => Color.Warning,
        _ => Color.Default
    };

    private static string GetTaskTargetDisplay(TaskHistoryItemDto task)
        => TaskPresentation.Target(task.ClientHostName, task.ClientDisplayName, task.ClientName);

    public void Dispose()
    {
        _disposed = true;
        _disposeCts.Cancel();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _disposeCts.Dispose();
    }
}
