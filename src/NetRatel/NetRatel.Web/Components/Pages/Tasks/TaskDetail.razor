@page "/tasks/{TaskId:int}"
@page "/tasks/request/{RequestId}"

@using System.Net
@using System.Text.Json
@using System.Text.Json.Nodes

@using NetRatel.Shared.Contracts.Tasks
@using NetRatel.Shared.Utils
@using NetRatel.Web.Services.ClientTasks
@using NetRatel.Web.Services

@inject TaskApiService TaskApi
@inject ISnackbar Snackbar
@inject ITaskExecutionStream ExecutionStream
@inject IJSRuntime JS

@implements IAsyncDisposable

<MudStack Spacing="2">
    @if (_task is null)
    {
        @if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_loadError</MudAlert>
            <MudButton Variant="Variant.Text" OnClick="RetryAsync">Retry</MudButton>
        }
        else
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
    }
    else
    {
        <MudPaper Class="task-detail-header pa-3" Elevation="0">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h5" Class="task-detail-title">@TaskPresentation.Title(_task.TaskType, _task.ScriptName, _task.CommandLabel)</MudText>
                    <MudChip T="string" Color="@StatusColor(_task.Status)" Variant="Variant.Outlined" Size="Size.Small">@TaskPresentation.StatusLabel(_task.Status)</MudChip>
                </MudStack>
                <MudText Typo="Typo.body2" data-testid="task-target">@TaskPresentation.Target(_task.ClientHostName, _task.ClientDisplayName, _task.ClientName) · @TaskPresentation.Tenant(_task.TenantName, _task.TenantId)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@(_task.ScriptType ?? _task.TaskType) · Environment: @(_task.Environment?.ToString() ?? "Not recorded")</MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="task-detail-timing">
                    <MudText Typo="Typo.caption">Queued: @FormatTimestamp(_task.Created)</MudText>
                    <MudText Typo="Typo.caption" data-testid="task-started">Started: @FormatTimestamp(_task.StartedAt, MissingStart(_task.Status))</MudText>
                    <MudText Typo="Typo.caption">@(_task.Status == "Unknown" ? "Reconciled" : "Completed"): @FormatTimestamp(_task.CompletedAt, IsTerminal(_task) ? "Not recorded" : "Waiting")</MudText>
                    <MudText Typo="Typo.caption" data-testid="task-runtime">Runtime: @TaskPresentation.Runtime(_task.StartedAt, _task.CompletedAt, _task.Status)</MudText>
                    @if (_task.ExitCode is not null)
                    {
                        <MudText Typo="Typo.caption">Exit @_task.ExitCode</MudText>
                    }
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(_task.StatusMessage))
                {
                    <details class="task-detail-reason">
                        <summary>@TaskPresentation.ConciseReason(_task.StatusMessage)</summary>
                        <pre class="task-output-scroll">@_task.StatusMessage</pre>
                    </details>
                }
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="task-detail-identifiers">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Request: <span class="task-request-id">@_task.RequestId</span> · Task #@_task.Id</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="Copy request ID" OnClick="CopyRequestIdAsync" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Href="/tasks/history">History</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Class="task-output-surface pa-3" Elevation="0" data-testid="task-output-panel">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle1">Execution output</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ConnectionColor" data-testid="task-connection">@_connectionStatus</MudChip>
                </MudStack>

                @if (_loadError is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" role="status">@_loadError</MudText>
                }
                @if (HasAnyOutput)
                {
                    var finalOutput = _task.ReturnData;
                    var (plain, html, parsedExitCode) = string.IsNullOrWhiteSpace(finalOutput)
                        ? (string.Empty, string.Empty, (int?)null)
                        : ExecOutputFormatter.ParseExecReturn(finalOutput);
                    var parsed = GetParsedResult(finalOutput);

                    <MudTabs Rounded="true" KeepPanelsAlive="true" @bind-ActivePanelIndex="_activeTab" TabPanelsClass="task-output-tab-panel">
                        <MudTabPanel Text="Console">
                            <MudPaper Class="task-execution-console pa-2">
                                <div class="task-output-scroll task-output-console"
                                     @onclick:stopPropagation="true"
                                     @onmousedown:stopPropagation="true"
                                     @onmouseup:stopPropagation="true"
                                     @onmousemove:stopPropagation="true">@((MarkupString)(string.IsNullOrWhiteSpace(finalOutput) ? WebUtility.HtmlEncode(LiveConsoleOutput) : plain.Length > MaxOutputCharacters ? WebUtility.HtmlEncode(BoundOutput(plain)) : html))</div>
                            </MudPaper>
                            @if ((_task.ExitCode ?? ParseExitCode(finalOutput)) is { } exitCode)
                            {
                                <MudText Typo="Typo.caption">Exit code: @exitCode</MudText>
                            }
                        </MudTabPanel>
                        <MudTabPanel Text="Stdout">
                            <MudPaper Class="task-stream-panel pa-3">
                                @if (parsed.Stdout.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">No stdout captured.</MudText>
                                }
                                else
                                {
                                    <pre class="task-output-scroll">@BoundOutput(string.Join(System.Environment.NewLine, parsed.Stdout))</pre>
                                }
                            </MudPaper>
                        </MudTabPanel>
                        <MudTabPanel Text="Stderr">
                            <MudPaper Class="task-stream-panel pa-3">
                                @if (parsed.Stderr.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">No stderr captured.</MudText>
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(parsed.ErrorSummary))
                                    {
                                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                            @parsed.ErrorSummary
                                        </MudAlert>
                                    }
                                    <pre class="task-output-scroll task-stream-error">@BoundOutput(string.Join(System.Environment.NewLine, parsed.Stderr))</pre>
                                }
                            </MudPaper>
                        </MudTabPanel>
                        <MudTabPanel Text="Diagnostics">
                            <MudPaper Class="task-stream-panel pa-3">
                                @if (parsed.Diagnostics.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">No execution diagnostics were captured.</MudText>
                                }
                                else
                                {
                                    @foreach (var item in parsed.Diagnostics)
                                    {
                                        <MudText Typo="Typo.caption"><b>@item.Key:</b> @item.Value</MudText>
                                    }
                                }
                            </MudPaper>
                        </MudTabPanel>
                        <MudTabPanel Text="Plain">
                            <MudPaper Class="task-stream-panel pa-3">
                                <pre class="task-output-scroll">@BoundOutput(plain)</pre>
                            </MudPaper>
                        </MudTabPanel>
                        <MudTabPanel Text="Raw JSON">
                            <MudPaper Class="task-stream-panel pa-3">
                                @if (string.IsNullOrWhiteSpace(finalOutput))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">The final result has not arrived yet.</MudText>
                                }
                                else
                                {
                                    <pre class="task-output-scroll">@BoundOutput(finalOutput)</pre>
                                }
                            </MudPaper>
                        </MudTabPanel>
                    </MudTabs>
                }
                else if (IsTerminal(_task))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No execution output was captured.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Waiting for execution output. New log lines will appear here while the task runs.</MudText>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

<style>
  pre { line-height: 1.25; }
  .task-detail-header,
  .task-stream-panel,
  .task-output-surface {
      border: 1px solid var(--mud-palette-divider);
      border-radius: var(--netratel-radius-surface, 7px);
      background: var(--mud-palette-surface);
  }

  .task-detail-header {
      border-left: 3px solid var(--mud-palette-primary);
  }

  .task-detail-title { overflow-wrap: anywhere; min-width: 0; }
  .task-detail-timing { color: var(--mud-palette-text-secondary); }
  .task-detail-reason { font-size: 0.86rem; overflow-wrap: anywhere; }
  .task-detail-reason summary { cursor: pointer; }
  .task-detail-identifiers { flex-wrap: wrap; min-width: 0; }
  .task-request-id { user-select: all; overflow-wrap: anywhere; }

  .task-execution-console {
      background: var(--mud-palette-background-gray);
      border-radius: var(--netratel-radius-surface, 7px);
      color: var(--mud-palette-text-primary);
      font-family: ui-monospace, Consolas, monospace;
      font-size: 0.85rem;
  }

  .task-output-tab-panel {
      min-height: 0;
  }

  .task-output-scroll {
      display: block;
      max-height: min(46dvh, 34rem);
      margin: 0;
      overflow: auto;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
      word-break: break-word;
  }

  .task-output-console {
      max-width: 100%;
      white-space: pre;
      word-break: normal;
  }

  .task-stream-error {
      color: var(--mud-palette-error);
      white-space: pre-wrap;
  }
</style>

@code {
    [Parameter] public int TaskId { get; set; }
    [Parameter] public string? RequestId { get; set; }

    private const int MaxLogLines = 2000;
    private const int MaxOutputCharacters = 512 * 1024;
    private TaskDto? _task;
    private readonly CancellationTokenSource _disposeCts = new();
    private CancellationTokenSource? _routeCts;
    private long _routeVersion;
    private readonly List<TaskLogDto> _logs = [];
    private readonly HashSet<long> _logIds = [];
    private long _latestLogId;
    private string _connectionStatus = "Connecting";
    private string? _loadError;
    private int _activeTab;
    private string? _loadedRequest;
    private int _loadedTaskId;
    private bool _disposed;

    private Color ConnectionColor => _connectionStatus == "Live" ? Color.Success : Color.Default;
    private bool HasAnyOutput => !string.IsNullOrWhiteSpace(_task?.ReturnData) || _logs.Count > 0;
    private string LiveConsoleOutput => BoundOutput(string.Join(System.Environment.NewLine, _logs
        .OrderBy(log => log.Seq > 0 ? log.Seq : log.Id).ThenBy(log => log.Id)
        .Select(log => $"[{log.Ts.ToLocalTime():T}] {log.Stream}: {AnsiConsole.NormalizeForDisplay(log.Message)}")));

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedRequest == RequestId && _loadedTaskId == TaskId && _task is not null) return;
        var version = ++_routeVersion;
        _routeCts?.Cancel();
        _routeCts?.Dispose();
        _routeCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        var token = _routeCts.Token;
        await ExecutionStream.StopAsync();
        if (_disposed || version != _routeVersion || token.IsCancellationRequested) return;
        _loadedRequest = RequestId;
        _loadedTaskId = TaskId;
        _task = null;
        _logs.Clear();
        _logIds.Clear();
        _latestLogId = 0;
        _activeTab = 0;
        _connectionStatus = "Connecting";
        await RefreshSnapshotAsync(token);
        if (_disposed || version != _routeVersion || token.IsCancellationRequested) return;
        var requestId = _task?.RequestId ?? RequestId;
        if (!string.IsNullOrWhiteSpace(requestId))
            await ExecutionStream.StartAsync(requestId, RefreshSnapshotAsync, status => ConnectionChanged(status, version), token);
    }

    private Task RetryAsync() => OnParametersSetAsync();

    private async Task<bool> RefreshSnapshotAsync(CancellationToken cancellationToken)
    {
        // Components mutate state only on the renderer; a snapshot and its output merge is
        // serialized with navigation/disposal and preserves tabs and existing scroll nodes.
        var succeeded = false;
        var version = _routeVersion;
        var requestId = _loadedRequest;
        var taskId = _loadedTaskId;
        await InvokeAsync(async () =>
        {
            if (_disposed || version != _routeVersion || cancellationToken.IsCancellationRequested) return;
            var taskLoaded = false;
            var logsLoaded = false;
            try
            {
                var task = !string.IsNullOrWhiteSpace(requestId)
                    ? await TaskApi.GetByRequestIdAsync(requestId, cancellationToken)
                    : await TaskApi.GetAsync(taskId, cancellationToken);
                if (_disposed || version != _routeVersion || cancellationToken.IsCancellationRequested) return;
                if (task is not null) { _task = task; taskLoaded = true; _loadError = null; }
                else _loadError = "Task was not found or access is unavailable.";
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
            catch (Exception)
            {
                if (_disposed || version != _routeVersion || cancellationToken.IsCancellationRequested) return;
                _loadError = "Task updates are temporarily unavailable. Reconnecting will recover the latest evidence.";
            }

            if (_task is not null)
            {
                try
                {
                    var logs = await TaskApi.GetLogsByRequestIdAsync(_task.RequestId, _latestLogId, cancellationToken: cancellationToken);
                    if (_disposed || version != _routeVersion || cancellationToken.IsCancellationRequested) return;
                    foreach (var log in (logs ?? []).OrderBy(log => log.Id))
                    {
                        if (log.Id <= _latestLogId || !_logIds.Add(log.Id)) continue;
                        _logs.Add(log.Message.Length > MaxOutputCharacters ? log with { Message = BoundOutput(log.Message) } : log);
                    }
                    if (logs is { Count: > 0 }) _latestLogId = Math.Max(_latestLogId, logs.Max(log => log.Id));
                    var chars = _logs.Sum(log => log.Message.Length);
                    while (_logs.Count > MaxLogLines || chars > MaxOutputCharacters && _logs.Count > 1)
                    {
                        chars -= _logs[0].Message.Length;
                        _logIds.Remove(_logs[0].Id);
                        _logs.RemoveAt(0);
                    }
                    logsLoaded = true;
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
                catch (Exception)
                {
                    if (_disposed || version != _routeVersion || cancellationToken.IsCancellationRequested) return;
                    _loadError = "Output updates are temporarily unavailable. The connection will retry without losing captured lines.";
                }
            }
            StateHasChanged();
            succeeded = taskLoaded && logsLoaded;
        });
        return succeeded;
    }

    private void ConnectionChanged(string status, long version)
    {
        if (_disposed || version != _routeVersion) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed || version != _routeVersion) return;
            _connectionStatus = status;
            StateHasChanged();
        });
    }

    private async Task CopyRequestIdAsync()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _task?.RequestId); }
        catch (JSException) { Snackbar.Add("Clipboard unavailable. Select and copy the request ID.", Severity.Info); }
    }

    private static Color StatusColor(string status) => status switch
    {
        "Completed" => Color.Success,
        "Processing" or "Running" or "Accepted" => Color.Info,
        "Failed" => Color.Error,
        "Cancelled" or "TimedOut" => Color.Warning,
        _ => Color.Default
    };

    private static bool IsTerminal(TaskDto? task) => TaskPresentation.IsTerminal(task?.Status);
    private static string MissingStart(string status) => TaskPresentation.MissingStart(status);
    private static string FormatTimestamp(DateTimeOffset? ts, string missing = "Waiting")
        => ts is null ? missing : ts.Value.ToLocalTime().ToString("g");
    private static string BoundOutput(string? value)
        => string.IsNullOrEmpty(value) ? string.Empty : value.Length <= MaxOutputCharacters
            ? value : "[Earlier output omitted from this view]\n" + value[^MaxOutputCharacters..];

    private sealed record ParsedTaskResult(
        List<string> Stdout,
        List<string> Stderr,
        Dictionary<string, string> Diagnostics,
        string? ErrorSummary);

    private ParsedTaskResult GetParsedResult(string? json)
    {
        if (!string.IsNullOrWhiteSpace(json)) return ParseReturnData(json);
        var stdout = _logs.Where(log => log.Stream.Equals("stdout", StringComparison.OrdinalIgnoreCase))
            .OrderBy(log => log.Seq > 0 ? log.Seq : log.Id).ThenBy(log => log.Id).Select(log => AnsiConsole.NormalizeForDisplay(log.Message)).ToList();
        var stderr = _logs.Where(log => log.Stream.Equals("stderr", StringComparison.OrdinalIgnoreCase))
            .OrderBy(log => log.Seq > 0 ? log.Seq : log.Id).ThenBy(log => log.Id).Select(log => AnsiConsole.NormalizeForDisplay(log.Message)).ToList();
        return new ParsedTaskResult(stdout, stderr, [], stderr.Select(ExtractErrorSummary).FirstOrDefault(value => value is not null));
    }

    private static int? ParseExitCode(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try
        {
            using var result = JsonDocument.Parse(json);
            return result.RootElement.ValueKind == JsonValueKind.Object && result.RootElement.TryGetProperty("exitCode", out var value) && value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var code) ? code : null;
        }
        catch (JsonException) { return null; }
    }

    private static ParsedTaskResult ParseReturnData(string? json)
    {
        var stdout = new List<string>();
        var stderr = new List<string>();
        var diagnostics = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        string? errorSummary = null;

        if (string.IsNullOrWhiteSpace(json))
        {
            return new ParsedTaskResult(stdout, stderr, diagnostics, errorSummary);
        }

        try
        {
            var root = JsonNode.Parse(json) as JsonObject;
            if (root is null)
            {
                return new ParsedTaskResult(stdout, stderr, diagnostics, errorSummary);
            }

            if (root["stdout"] is JsonArray stdoutArray)
            {
                stdout.AddRange(stdoutArray.Select(x => AnsiConsole.NormalizeForDisplay(x?.ToString() ?? string.Empty)));
            }

            if (root["stderr"] is JsonArray stderrArray)
            {
                stderr.AddRange(stderrArray.Select(x => AnsiConsole.NormalizeForDisplay(x?.ToString() ?? string.Empty)));
                errorSummary = stderr
                    .Select(ExtractErrorSummary)
                    .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
            }

            if (root["diagnostics"] is JsonObject diag)
            {
                foreach (var kv in diag)
                {
                    diagnostics[kv.Key] = kv.Value?.ToString() ?? string.Empty;
                }
            }
        }
        catch (JsonException)
        {
            return new ParsedTaskResult(stdout, stderr, diagnostics, errorSummary);
        }

        return new ParsedTaskResult(stdout, stderr, diagnostics, errorSummary);
    }

    private static string? ExtractErrorSummary(string? raw)
    {
        var text = AnsiConsole.NormalizeForDisplay(raw ?? string.Empty);
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        var lines = text
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !x.Equals("Write-Error:", StringComparison.OrdinalIgnoreCase))
            .ToList();

        var preferred = lines.LastOrDefault(line =>
            line.Contains("because", StringComparison.OrdinalIgnoreCase) ||
            line.Contains("not exist", StringComparison.OrdinalIgnoreCase) ||
            line.Contains("access", StringComparison.OrdinalIgnoreCase) ||
            line.Contains("failed", StringComparison.OrdinalIgnoreCase) ||
            line.Contains("error", StringComparison.OrdinalIgnoreCase));

        return preferred ?? lines.LastOrDefault() ?? text;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ++_routeVersion;
        _routeCts?.Cancel();
        _disposeCts.Cancel();
        await ExecutionStream.StopAsync();
        _routeCts?.Dispose();
        _disposeCts.Dispose();
    }
}
