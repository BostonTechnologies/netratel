@page "/tasks/new"
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components.Web
@using NetRatel.Shared
@using NetRatel.Shared.Contracts.Execution
@using NetRatel.Shared.Contracts.Scripts
@using NetRatel.Shared.Contracts.Tasks
@using NetRatel.Web.Models.Clients
@using NetRatel.Web.Services.Clients
@implements IDisposable
@inject ITenantApiService TenantApi
@inject ClientPresentationService ClientPresentation
@inject IScriptLibraryService ScriptLibraryService
@inject TaskApiService TaskApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="task-console">
    <div class="task-toolbar">
        <MudText Typo="Typo.h6">New Task</MudText>
        <MudText Typo="Typo.body2" Class="task-scope">@(_selectedTenant?.Name ?? "Select tenant") · @_environment.ToShortLabel() · @GetSelectedTargetDisplay()</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/tasks/history" StartIcon="@Icons.Material.Filled.History">History</MudButton>
    </div>

    <div class="task-workspace">
        <section class="task-panel task-target-panel" aria-label="Target selection">
            <div class="task-scope-fields">
                <MudAutocomplete T="TenantDto" Label="Tenant" @bind-Value="TenantSelection"
                                 ToStringFunc="TenantDisplay" SearchFunc="SearchTenants" ResetValueOnEmptyText="true"
                                 Clearable="true" Disabled="_isLoadingTenants || _isSubmitting" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" />
                <MudSelect T="ClientEnvironment" Label="Environment" @bind-Value="EnvironmentSelection" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_isSubmitting">
                    @foreach (var env in _environments)
                    {
                        <MudSelectItem Value="@env">@env.ToShortLabel()</MudSelectItem>
                    }
                </MudSelect>
            </div>
            @if (_isLoadingTenants || _isLoadingClients)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            @if (_showValidation && _selectedTenant is null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">Tenant selection is required.</MudText>
            }
            @if (_selectedClient is { } target)
            {
                <div class="task-selected-target" data-testid="task-selected-target">
                    <MudText Typo="Typo.subtitle2">@target.DisplayName</MudText>
                    <MudText Typo="Typo.caption">@target.HostName · @(target.OperatingSystem ?? "OS unavailable")</MudText>
                    <MudText Typo="Typo.caption">@(FirstPresent(target.ReportedAddress) ?? "Address unavailable") · @(target.Online ? "Online" : "Offline")</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _targetListExpanded = !_targetListExpanded" aria-expanded="@_targetListExpanded">
                        @(_targetListExpanded ? "Hide targets" : "Change target")
                    </MudButton>
                </div>
            }
            @if (_targetListExpanded || _selectedClient is null)
            {
            <div class="task-search-row">
                <MudTextField @bind-Value="_clientSearch" Label="Search targets" Immediate="true" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="HandleClientSearchKey" Disabled="_isLoadingClients || _selectedTenant is null || _isSubmitting" />
                <MudIconButton Icon="@Icons.Material.Filled.Search" Size="Size.Small" aria-label="Search targets"
                               OnClick="PerformClientSearch" Disabled="_isLoadingClients || _selectedTenant is null || _isSubmitting" />
            </div>
            @if (_clientsUnavailable)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">Target directory unavailable. Refresh before launching.</MudAlert>
            }
            else if (_selectedTenant is null)
            {
                <MudText Typo="Typo.body2" Class="py-3">Select a tenant to load targets.</MudText>
            }
            else if (_clients.Count == 0 && !_isLoadingClients)
            {
                <MudText Typo="Typo.body2" Class="py-3">No targets match this search.</MudText>
            }
            else
            {
                <MudTable T="ClientPresentationModel" Items="_clients" Hover="true" Dense="true" FixedHeader="true"
                          Height="240px" OnRowClick="OnClientRowClick" RowClassFunc="SelectedRowClassFunc" Class="task-client-table" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh></MudTh><MudTh>Client / host</MudTh><MudTh>Address</MudTh><MudTh>Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Select">
                            <span @onclick:stopPropagation="true">
                            <MudIconButton Size="Size.Small" aria-label="@($"Select {context.DisplayName}")"
                                           Icon="@(IsClientSelected(context) ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Outlined.RadioButtonUnchecked)"
                                           OnClick="() => SelectClient(context)" Disabled="!context.Online || _isSubmitting" />
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Client / host">
                            <MudText Typo="Typo.body2">@context.DisplayName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.HostName · @(context.OperatingSystem ?? "OS unavailable")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Address">@(FirstPresent(context.ReportedAddress) ?? "Unavailable")</MudTd>
                        <MudTd DataLabel="Status">@(context.Online ? "Online" : "Offline")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            <div class="task-target-footer">
                <MudText Typo="Typo.caption">@(_clientsUnavailable ? "Inventory unavailable" : _isLoadingClients ? "Loading inventory…" : $"{_clientTotalCount} matching targets · tenant inventory")</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" aria-label="Previous target page" OnClick="PreviousClientPage" Disabled="_clientPage <= 1 || _isLoadingClients || _isSubmitting" />
                <MudText Typo="Typo.caption">Page @_clientPage</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-label="Next target page" OnClick="NextClientPage" Disabled="!ClientHasNextPage || _isLoadingClients || _isSubmitting" />
            </div>
            }
            @if (_showValidation && _selectedClient is null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">Select an online client.</MudText>
            }
        </section>

        <section class="task-panel task-payload-panel" aria-label="Execution payload">
            <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection" @bind-SelectedValue="TaskTypeSelection">
                <MudChip T="string" Value="@TaskKinds.ExecShellCommand" Size="Size.Small" Disabled="_isSubmitting">Shell Command</MudChip>
                <MudChip T="string" Value="@TaskKinds.ExecLibraryScript" Size="Size.Small" Disabled="_isSubmitting">Library Script</MudChip>
            </MudChipSet>
            @if (_taskType == TaskKinds.ExecShellCommand)
            {
                <MudTextField T="string" @bind-Value="ScriptText" Immediate="true" Lines="@(_commandExpanded ? 12 : 2)"
                              Label="Command / Script" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isSubmitting" data-testid="task-command" />
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleCommandEditor" aria-expanded="@_commandExpanded" data-testid="task-expand-editor">
                    @(_commandExpanded ? "Collapse editor" : "Expand editor")
                </MudButton>
                @if (_showValidation && string.IsNullOrWhiteSpace(_scriptText))
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">Provide the command or script to execute.</MudText>
                }
            }
            else
            {
                <div class="task-library-selection">
                    <div>
                        <MudText Typo="Typo.body2">@(_selectedScript?.Name ?? "Choose a library script")</MudText>
                        @if (_selectedScript is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@_selectedScript.ScriptType · Library source #@_selectedScript.Id · current revision resolved at launch</MudText>
                        }
                    </div>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="OpenScriptDialog" Disabled="_isSubmitting">Browse</MudButton>
                    @if (_selectedScript is not null)
                    {
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" aria-label="Clear selected script" OnClick="ClearSelectedScript" Disabled="_isSubmitting" />
                    }
                </div>
                @if (_showValidation && _selectedScript is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">Select a library script.</MudText>
                }
            }

            <div class="task-parameters-heading">
                <MudText Typo="Typo.subtitle2">Parameters</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="AddParameter" StartIcon="@Icons.Material.Filled.Add" Disabled="_isSubmitting">Add parameter</MudButton>
            </div>
            <div class="task-parameter-list">
                @foreach (var parameter in _parameters)
                {
                    <div class="task-parameter-row" @key="parameter">
                        <MudTextField @bind-Value="parameter.Key" Label="Key" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isSubmitting" />
                        <MudTextField @bind-Value="parameter.Value" Label="Value" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isSubmitting" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Remove parameter" OnClick="() => RemoveParameter(parameter)" Disabled="_isSubmitting" />
                    </div>
                }
            </div>
            <MudExpansionPanels Elevation="0" Dense="true" Class="task-advanced">
                <MudExpansionPanel Text="Advanced" Dense="true">
                    <MudTextField @bind-Value="_requestId" Label="Request ID (optional)" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isSubmitting || _launchedRequestId is not null" />
                    @if (_taskType == TaskKinds.ExecLibraryScript)
                    {
                        <MudSelect T="ShellExecutor" Label="Preferred shell" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_libraryShellPreference" Disabled="_isSubmitting">
                            <MudSelectItem Value="@ShellExecutor.Auto">Auto</MudSelectItem>
                            <MudSelectItem Value="@ShellExecutor.Pwsh">PowerShell 7 (pwsh)</MudSelectItem>
                            <MudSelectItem Value="@ShellExecutor.WindowsPowerShell">Windows PowerShell</MudSelectItem>
                        </MudSelect>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
            <div class="task-launch-footer">
                <MudText Typo="Typo.caption" Class="task-scope">@GetReadinessSummary()</MudText>
                @if (_launchedRequestId is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="PrepareAnotherTask" data-testid="task-new-launch">New launch</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_canSubmit || _launchedRequestId is not null)"
                           OnClick="SubmitAsync" StartIcon="@Icons.Material.Filled.PlayArrow" data-testid="task-launch">
                    @(_isSubmitting ? "Launching…" : "Launch")
                </MudButton>
            </div>
        </section>
    </div>

    @if (_launchedRequestId is not null)
    {
        <section class="task-panel task-launch-status" aria-live="polite" aria-label="Launched task status" data-testid="task-launch-status">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@TaskStatusColor(_launchedTask?.Status)">@(_launchedTask?.Status ?? "Accepted; waiting for task")</MudChip>
            <MudText Typo="Typo.body2">@(_launchedTask is null ? _launchedRequestId : GetTaskTargetDisplay(_launchedTask))</MudText>
            @if (_launchedTask is not null)
            {
                <MudText Typo="Typo.caption">@FormatRuntime(_launchedTask)</MudText>
                <MudText Typo="Typo.caption">@_launchedTask.StatusMessage</MudText>
            }
            <MudText Typo="Typo.caption" Color="Color.Secondary">@(_launchStatusUnavailable ? "Status unavailable · use Refresh" : "Server execution status")</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RefreshLaunchStatusAsync" Disabled="_isRefreshingLaunch" aria-label="Refresh launched task status">Refresh</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/tasks/request/{Uri.EscapeDataString(_launchedRequestId)}")">Result / logs</MudButton>
        </section>
    }

    <section class="task-panel" aria-label="Recent tasks">
        <div class="task-toolbar">
            <MudText Typo="Typo.subtitle2">Recent tasks</MudText>
            <MudText Typo="Typo.caption" Class="task-scope">Latest 12 · @(_selectedTenant?.Name ?? "accessible tenants") · @_environment.ToShortLabel() · @GetSelectedTargetDisplay("all targets")</MudText>
            <MudText Typo="Typo.caption">@(_recentUpdatedAt is { } updated ? $"Updated {updated.ToLocalTime():T}" : "Not loaded")</MudText>
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh recent tasks" OnClick="RefreshRecentTasksAsync" Disabled="_isLoadingRecentTasks" />
        </div>
        @if (_isLoadingRecentTasks)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        @if (_recentUnavailable)
        {
            <MudText Typo="Typo.body2" Color="Color.Warning">Recent task status unavailable.</MudText>
        }
        else if (_recentTasks.Count == 0 && !_isLoadingRecentTasks)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No recent tasks for this scope.</MudText>
        }
        else
        {
            <MudTable T="TaskDto" Items="_recentTasks" Dense="true" Hover="true" FixedHeader="true" Height="180px" Breakpoint="Breakpoint.Sm">
                <HeaderContent><MudTh>Status</MudTh><MudTh>Task / target</MudTh><MudTh>Created</MudTh><MudTh>Elapsed</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Status"><MudChip T="string" Color="@TaskStatusColor(context.Status)" Variant="Variant.Outlined" Size="Size.Small">@context.Status</MudChip></MudTd>
                    <MudTd DataLabel="Task / target">@context.TaskType · @GetTaskTargetDisplay(context)</MudTd>
                    <MudTd DataLabel="Created">@context.Created.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Elapsed">@FormatRuntime(context)</MudTd>
                    <MudTd><MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary" Size="Size.Small" aria-label="@($"Open task {context.RequestId}")" Href="@($"/tasks/request/{Uri.EscapeDataString(context.RequestId)}")" /></MudTd>
                </RowTemplate>
            </MudTable>
        }
    </section>
</div>

@code {
    private readonly List<TenantDto> _tenants = new();
    private TenantDto? _selectedTenant;
    private bool _isLoadingTenants;

    private readonly ClientEnvironment[] _environments = new[] { ClientEnvironment.Dev, ClientEnvironment.Prod };
    private ClientEnvironment _environment = ClientEnvironment.Dev;

    private readonly List<ClientPresentationModel> _clients = new();
    private ClientPresentationModel? _selectedClient;
    private Guid? _selectedAgentId;
    private string? _clientSearch;
    private int _clientPage = 1;
    private int _clientTotalCount;
    private bool _isLoadingClients;
    private bool _targetListExpanded = true;

    private string _taskType = TaskKinds.ExecShellCommand;
    private ShellExecutor _libraryShellPreference = ShellExecutor.Auto;
    private string? _scriptText;
    private bool _commandExpanded;
    private ScriptSummaryDto? _selectedScript;

    public sealed class ParameterInput
    {
        public string? Key { get; set; }
        public string? Value { get; set; }
    }

    private string? _requestId;

    private bool _isSubmitting;
    private bool _showValidation;
    private readonly List<TaskDto> _recentTasks = new();
    private bool _isLoadingRecentTasks;
    private bool _clientsUnavailable;
    private bool _recentUnavailable;
    private DateTimeOffset? _recentUpdatedAt;
    private int _clientLoadGeneration;
    private int _recentLoadGeneration;
    private string? _recentScope;
    private CancellationTokenSource? _recentLoadCts;
    private CancellationTokenSource? _launchStatusCts;
    private string? _launchedRequestId;
    private TaskDto? _launchedTask;
    private bool _launchStatusUnavailable;
    private bool _isRefreshingLaunch;

    private readonly CancellationTokenSource _disposeCts = new();
    private CancellationTokenSource? _clientsLoadCts;

    private const int ClientPageSize = 25;

    private bool _canSubmit;
    private bool _gate_isSubmitting, _gate_isLoadingClients, _gate_isLoadingTenants,
                 _gate_hasTenant, _gate_hasClient, _gate_hasScript, _gate_hasLibrary;

    // Bindable wrappers (avoid duplicate SelectedOptionChanged)
    private TenantDto? TenantSelection
    {
        get => _selectedTenant;
        set => _ = ChangeTenantAsync(value);
    }

    private ClientEnvironment EnvironmentSelection
    {
        get => _environment;
        set => _ = ChangeEnvironmentAsync(value);
    }

    private string TaskTypeSelection
    {
        get => _taskType;
        set
        {
            var next = NormalizeTaskKind(value);
            if (_isSubmitting || string.Equals(_taskType, next, StringComparison.Ordinal)) return;

            _taskType = next;
            _ = InvokeAsync(StateHasChanged);

            if (_taskType == TaskKinds.ExecLibraryScript && _selectedScript is null)
            {
                RecomputeCanSubmit();
                _ = OpenScriptDialog();
            }
            else
            {
                RecomputeCanSubmit();
                _ = InvokeAsync(StateHasChanged);
            }
        }
    }

    private string? ScriptText
    {
        get => _scriptText;
        set
        {
            if (_scriptText == value) return;
            _scriptText = value;
            RecomputeCanSubmit();
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private static string NormalizeTaskKind(string? value) => value switch
    {
        null or "" => TaskKinds.ExecShellCommand,
        TaskKinds.ExecShellCommand => TaskKinds.ExecShellCommand,
        TaskKinds.ExecLibraryScript => TaskKinds.ExecLibraryScript,
        TaskKinds.Legacy_RunPowerShell => TaskKinds.ExecShellCommand,
        TaskKinds.Legacy_RunLibraryScript => TaskKinds.ExecLibraryScript,
        TaskKinds.Legacy_ExecPs => TaskKinds.ExecShellCommand,
        TaskKinds.Legacy_ExecSh => TaskKinds.ExecShellCommand,
        _ => TaskKinds.ExecShellCommand
    };

    private static bool TryParseScriptType(string? value, out ScriptType scriptType)
    {
        if (!string.IsNullOrWhiteSpace(value) &&
            Enum.TryParse(value, ignoreCase: true, out scriptType))
        {
            return true;
        }

        scriptType = default;
        return false;
    }

    private string GetReadinessSummary()
    {
        if (_isLoadingTenants || _isLoadingClients)
            return "Loading orchestration context";

        if (_selectedTenant is null)
            return "Select a tenant scope";

        if (_selectedClient is null && !_selectedAgentId.HasValue)
            return "Choose a target Agent";

        if (_taskType == TaskKinds.ExecShellCommand && string.IsNullOrWhiteSpace(_scriptText))
            return "Provide a command or script payload";

        if (_taskType == TaskKinds.ExecLibraryScript && _selectedScript is null)
            return "Select a library script";

        return "All launch requirements satisfied";
    }

    private string GetSelectedTargetDisplay(string fallback = "No target")
        => _selectedClient is null
            ? fallback
            : GetClientDisplay(_selectedClient);

    private static string GetClientDisplay(ClientPresentationModel client)
        => FirstPresent(client.DisplayName, client.HostName) ?? "Agent unavailable";

    private static string GetTaskTargetDisplay(TaskDto task)
        => FirstPresent(task.ClientHostName, task.ClientDisplayName, task.ClientName) ?? "Client unavailable";

    private static string? GetTaskTargetMeta(TaskDto task)
        => FirstPresent(task.ClientName, task.ClientDisplayName) is { } meta &&
           !string.Equals(meta, GetTaskTargetDisplay(task), StringComparison.OrdinalIgnoreCase)
            ? meta
            : null;

    private static string? FirstPresent(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
        await LoadRecentTasksAsync();
    }

    private void RecomputeCanSubmit()
    {
        _gate_isSubmitting      = _isSubmitting;
        _gate_isLoadingClients  = _isLoadingClients;
        _gate_isLoadingTenants  = _isLoadingTenants;

        // Some installs end up with _selectedTenant null even though there's only one tenant
        // (clients load fine, but the autocomplete Value isn't set). Treat exactly one tenant
        // as a valid selection and normalize it here.
        if (_selectedTenant is null && _tenants.Count == 1)
            _selectedTenant = _tenants[0];

        _gate_hasTenant  = _selectedTenant is not null;
        _gate_hasClient  = _selectedClient is { Online: true, Enabled: true } && !_clientsUnavailable;
        _gate_hasScript  = _taskType != TaskKinds.ExecShellCommand   || !string.IsNullOrWhiteSpace(_scriptText);
        _gate_hasLibrary = _taskType != TaskKinds.ExecLibraryScript || _selectedScript is not null;

        _canSubmit = !_gate_isSubmitting
                     && !_gate_isLoadingClients
                     && !_gate_isLoadingTenants
                     && _gate_hasTenant
                     && _gate_hasClient
                     && _gate_hasScript
                     && _gate_hasLibrary;
    }

    private async Task LoadTenantsAsync()
    {
        _isLoadingTenants = true;
        try
        {
            var tenants = await TenantApi.GetTenantsAsync(_disposeCts.Token);
            _tenants.Clear();
            _tenants.AddRange(tenants.OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase));

            if (_selectedTenant is not null)
            {
                _selectedTenant = _tenants.FirstOrDefault(t => t.Id == _selectedTenant.Id);
            }

            if (_selectedTenant is null && _tenants.Count == 1)
            {
                _selectedTenant = _tenants[0];
                await LoadClientsAsync();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load tenants: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingTenants = false;
            // Re-sync after clients are loaded
            SyncSelectedClientFromAgentId();
            RecomputeCanSubmit();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnClientRowClick(TableRowClickEventArgs<ClientPresentationModel> e) => SelectClient(e.Item);

    private void SelectClient(ClientPresentationModel client)
    {
        if (_isSubmitting || !client.Online || !client.Enabled) return;
        _targetListExpanded = false;
        _selectedAgentId = client.AgentId;
        SyncSelectedClientFromAgentId();
        RecomputeCanSubmit();
        _ = LoadRecentTasksAsync();
    }

    private string SelectedRowClassFunc(ClientPresentationModel row, int rowNumber)
        => IsClientSelected(row) ? "task-selected" : string.Empty;

    private bool IsClientSelected(ClientPresentationModel c) => _selectedAgentId == c.AgentId;

    private Task<IEnumerable<TenantDto>> SearchTenants(string value, CancellationToken cancellationToken)
    {
        _ = cancellationToken;
        IEnumerable<TenantDto> result = _tenants;
        if (!string.IsNullOrWhiteSpace(value))
        {
            result = result.Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(result);
    }

    private string TenantDisplay(TenantDto? tenant) => tenant?.Name ?? string.Empty;

    private async Task ChangeTenantAsync(TenantDto? tenant)
    {
        if (_isSubmitting || tenant?.Id == _selectedTenant?.Id) return;
        ClearLaunchFeedback();

        _clientsLoadCts?.Cancel();
        _clientLoadGeneration++;
        _isLoadingClients = false;
        _selectedTenant = tenant;
        _selectedClient = null;
        _selectedAgentId = null;
        _clientPage = 1;
        _clientTotalCount = 0;
        _clients.Clear();

        RecomputeCanSubmit();

        if (_selectedTenant is not null)
        {
            await LoadClientsAsync();
            await LoadRecentTasksAsync();
        }
        else
        {
            await LoadRecentTasksAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ChangeEnvironmentAsync(ClientEnvironment environment)
    {
        if (_isSubmitting || _environment == environment) return;
        ClearLaunchFeedback();

        _environment = environment;
        _clientPage = 1;
        _selectedClient = null;
        _selectedAgentId = null;

        if (_selectedTenant is not null)
        {
            await LoadClientsAsync();
        }

        await LoadRecentTasksAsync();
    }

    private async Task LoadClientsAsync()
    {
        var tenantId = _selectedTenant?.Id;
        if (tenantId is null) return;

        _clientsLoadCts?.Cancel();
        _clientsLoadCts?.Dispose();
        _clientsLoadCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        var ct = _clientsLoadCts.Token;
        var generation = ++_clientLoadGeneration;
        var search = _clientSearch;
        var pageNumber = _clientPage;
        _isLoadingClients = true;
        RecomputeCanSubmit();
        try
        {
            var snapshot = await ClientPresentation.GetClientsAsync(ct);
            if (ct.IsCancellationRequested || generation != _clientLoadGeneration || tenantId != _selectedTenant?.Id) return;
            _clientsUnavailable = !snapshot.IsAvailable;
            if (!snapshot.IsAvailable)
            {
                _clients.Clear();
                _clientTotalCount = 0;
                _selectedClient = null;
                _selectedAgentId = null;
                return;
            }
            var matches = snapshot.Clients
                .Where(agent => agent.TenantId == tenantId && agent.Enabled)
                .Where(agent => string.IsNullOrWhiteSpace(search) || $"{agent.DisplayName} {agent.HostName} {agent.OperatingSystem} {agent.ReportedAddress}".Contains(search, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(agent => agent.Online)
                .ThenBy(agent => agent.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToList();
            _clients.Clear();
            _clients.AddRange(matches.Skip((pageNumber - 1) * ClientPageSize).Take(ClientPageSize));
            _clientTotalCount = matches.Count;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (generation != _clientLoadGeneration) return;
            _clientsUnavailable = true;
            _selectedClient = null;
            _selectedAgentId = null;
            Snackbar.Add($"Failed to load targets: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (generation == _clientLoadGeneration && !_disposeCts.IsCancellationRequested)
            {
                _isLoadingClients = false;
                SyncSelectedClientFromAgentId();
                RecomputeCanSubmit();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadRecentTasksAsync()
    {
        var scope = $"{_selectedTenant?.Id}:{_environment}:{_selectedAgentId}";
        if (_recentScope != scope)
        {
            _recentTasks.Clear();
            _recentUpdatedAt = null;
            _recentUnavailable = false;
            _recentScope = scope;
        }
        _recentLoadCts?.Cancel();
        _recentLoadCts?.Dispose();
        _recentLoadCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        var ct = _recentLoadCts.Token;
        var generation = ++_recentLoadGeneration;
        _isLoadingRecentTasks = true;
        try
        {
            var recent = await TaskApi.GetRecentAsync(
                limit: 12, agentId: _selectedAgentId, tenantId: _selectedTenant?.Id,
                environment: _environment == ClientEnvironment.None ? null : _environment,
                cancellationToken: ct) ?? new List<TaskDto>();
            if (ct.IsCancellationRequested || generation != _recentLoadGeneration) return;
            _recentTasks.Clear();
            _recentTasks.AddRange(recent.OrderByDescending(t => t.Created));
            _recentUnavailable = false;
            _recentUpdatedAt = DateTimeOffset.UtcNow;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception)
        {
            if (generation == _recentLoadGeneration) _recentUnavailable = true;
        }
        finally
        {
            if (generation == _recentLoadGeneration && !_disposeCts.IsCancellationRequested)
            {
                _isLoadingRecentTasks = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private Task RefreshRecentTasksAsync() => LoadRecentTasksAsync();

    private void HandleClientSearchKey(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", System.StringComparison.OrdinalIgnoreCase))
        {
            _ = PerformClientSearch();
        }
    }

    private async Task PerformClientSearch()
    {
        _clientPage = 1;
        await LoadClientsAsync();
    }

    private async Task PreviousClientPage()
    {
        if (_clientPage <= 1) return;
        _clientPage--;
        await LoadClientsAsync();
    }

    private async Task NextClientPage()
    {
        if (!ClientHasNextPage) return;
        _clientPage++;
        await LoadClientsAsync();
    }

    private bool ClientHasNextPage => _clientPage * ClientPageSize < _clientTotalCount;

    private void SyncSelectedClientFromAgentId()
    {
        if (!_selectedAgentId.HasValue)
        {
            _selectedClient = null;
            return;
        }

        _selectedClient = _clients.FirstOrDefault(c =>
            c.AgentId == _selectedAgentId.Value && c.Online && c.Enabled);
        if (_selectedClient is null) _selectedAgentId = null;
    }

    private async Task OpenScriptDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = false };
        var dialogReference = await DialogService.ShowAsync<ScriptLibraryDialog>("Choose Script", options);
        var result = await dialogReference.Result;

        if (!result.Canceled && result.Data is ScriptSummaryDto summary)
        {
            _selectedScript = summary;
            RecomputeCanSubmit();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearSelectedScript()
    {
        _selectedScript = null;
        RecomputeCanSubmit();
        _ = InvokeAsync(StateHasChanged);
    }

    private void AddParameter() => _parameters.Add(new ParameterInput());

    private void RemoveParameter(ParameterInput parameter) => _parameters.Remove(parameter);

    private async Task SubmitAsync()
    {
        _showValidation = true;

        if (_isSubmitting || _launchedRequestId is not null) return;
        if (!ValidateForm()) return;

        _isSubmitting = true;
        RecomputeCanSubmit();
        try
        {
            // Refresh authoritative identity/presence before sending. The task
            // endpoint still owns environment, execution permission and approval checks.
            var targets = await ClientPresentation.GetClientsAsync(_disposeCts.Token);
            var selected = targets.Clients.FirstOrDefault(client =>
                client.TenantId == _selectedTenant?.Id && client.AgentId == _selectedAgentId && client.Enabled && client.Online);
            if (!targets.IsAvailable || selected is null)
            {
                _selectedClient = null;
                _selectedAgentId = null;
                _clientsUnavailable = !targets.IsAvailable;
                Snackbar.Add("Target is no longer available in this tenant. Refresh and select an online client.", Severity.Warning);
                return;
            }
            _selectedClient = selected;
            var parameterPairs = _parameters
                .Where(p => !string.IsNullOrWhiteSpace(p.Key))
                .ToDictionary(p => p.Key!.Trim(), p => p.Value ?? string.Empty, StringComparer.OrdinalIgnoreCase);

            var agentId = _selectedClient?.AgentId ?? _selectedAgentId;
            if (!agentId.HasValue)
            {
                Snackbar.Add("Agent target is required.", Severity.Error);
                return;
            }

            var request = new TaskCreateRequestDto
            {
                TenantId = _selectedTenant?.Id,
                AgentId = agentId,
                Environment = _environment,
                TaskType = _taskType,
                Preferred = _taskType == TaskKinds.ExecLibraryScript
                    ? _libraryShellPreference
                    : ShellExecutor.Auto,
                RequestId = _requestId,
                Parameters = parameterPairs.Count > 0
                    ? new Dictionary<string, string>(parameterPairs, StringComparer.OrdinalIgnoreCase)
                    : null
            };

            switch (_taskType)
            {
                case TaskKinds.ExecShellCommand:
                {
                    var commandText = (_scriptText ?? string.Empty).Trim();
                    request.ShellCommand = new ExecShellCommandPayload
                    {
                        Command = commandText,
                        Preferred = request.Preferred
                    };
                    request.Payload = commandText;
                    break;
                }

                case TaskKinds.ExecLibraryScript:
                {
                    if (_selectedScript is null)
                    {
                        Snackbar.Add("Select a library script before submitting.", Severity.Error);
                        return;
                    }

                    var currentScript = await ScriptLibraryService.GetByIdAsync(_selectedScript.Id, _disposeCts.Token);
                    if (currentScript is null || !string.Equals(currentScript.ScriptType, _selectedScript.ScriptType, StringComparison.OrdinalIgnoreCase))
                    {
                        Snackbar.Add("The selected library script is unavailable or its type changed. Select it again before launching.", Severity.Warning);
                        return;
                    }
                    _selectedScript = currentScript;

                    if (_selectedScript.Id > int.MaxValue)
                    {
                        Snackbar.Add("Script identifier exceeds supported range for client execution.", Severity.Error);
                        return;
                    }

                    if (!TryParseScriptType(_selectedScript.ScriptType, out var scriptType))
                    {
                        Snackbar.Add("Selected script is missing a valid ScriptType. Edit the script and choose a type.", Severity.Error);
                        return;
                    }

                    request.ScriptId = (int)_selectedScript.Id;
                    request.ScriptType = scriptType;
                    var libPayload = new ExecLibraryScriptPayload
                    {
                        ScriptId = request.ScriptId.Value,
                        ScriptType = request.ScriptType.Value,
                        Preferred = request.Preferred,
                        WorkingDirectory = request.WorkingDirectory,
                        TimeoutSeconds = request.TimeoutSeconds,
                        Parameters = parameterPairs.Count > 0
                            ? new Dictionary<string, string>(parameterPairs, StringComparer.OrdinalIgnoreCase)
                            : null
                    };
                    request.Payload = System.Text.Json.JsonSerializer.Serialize(libPayload);
                    break;
                }

                default:
                    Snackbar.Add($"Unsupported task type '{_taskType}'.", Severity.Error);
                    return;
            }

            if (string.IsNullOrWhiteSpace(_requestId))
            {
                _requestId = Guid.NewGuid().ToString("N");
                request.RequestId = _requestId;
            }

            var (created, accepted) = await TaskApi.CreateAsync(request, _disposeCts.Token);

            if (created?.Id > 0 || accepted)
            {
                _launchedTask = created;
                _launchedRequestId = created?.RequestId ?? request.RequestId;
                _launchStatusUnavailable = false;
                await LoadRecentTasksAsync();
                if (_launchedRequestId is not null)
                {
                    _launchStatusCts?.Cancel();
                    _launchStatusCts?.Dispose();
                    _launchStatusCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
                    _ = MonitorLaunchAsync(_launchedRequestId, _launchStatusCts.Token);
                }
            }
            else
            {
                Snackbar.Add("Task was not accepted. Check execution permissions and input before retrying.", Severity.Error);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create task: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            RecomputeCanSubmit();
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool ValidateForm()
    {
        if (_selectedTenant is null) return false;

        if (_selectedClient is not { Online: true, Enabled: true } || !_selectedAgentId.HasValue || _clientsUnavailable) return false;

        if (_taskType == TaskKinds.ExecShellCommand && string.IsNullOrWhiteSpace(_scriptText)) return false;
        if (_taskType == TaskKinds.ExecLibraryScript && _selectedScript is null) return false;

        return true;
    }

    private readonly List<ParameterInput> _parameters = new() { new ParameterInput() };

    private static Color TaskStatusColor(string? status) => status switch
    {
        "Completed" => Color.Success,
        "Processing" or "Running" => Color.Info,
        "Cancelled" => Color.Warning,
        "Failed" => Color.Error,
        _ => Color.Default
    };

    private static string FormatRuntime(TaskDto task)
    {
        if (task.StartedAt is null)
        {
            return "Not started";
        }

        var end = task.CompletedAt ?? DateTimeOffset.UtcNow;
        var duration = end - task.StartedAt.Value;
        if (duration.TotalHours >= 1) return duration.ToString(@"hh\:mm\:ss");
        if (duration.TotalMinutes >= 1) return duration.ToString(@"mm\:ss");
        return $"{Math.Max(0, duration.TotalSeconds):0.0}s";
    }

    private void ToggleCommandEditor() => _commandExpanded = !_commandExpanded;

    private void ClearLaunchFeedback()
    {
        _launchStatusCts?.Cancel();
        _launchedRequestId = null;
        _launchedTask = null;
        _launchStatusUnavailable = false;
    }

    private void PrepareAnotherTask()
    {
        ClearLaunchFeedback();
        _requestId = null;
        RecomputeCanSubmit();
    }

    private Task RefreshLaunchStatusAsync() => _launchedRequestId is { } requestId
        ? ReadLaunchStatusAsync(requestId, _disposeCts.Token)
        : Task.CompletedTask;

    private async Task ReadLaunchStatusAsync(string requestId, CancellationToken ct)
    {
        if (_isRefreshingLaunch) return;
        _isRefreshingLaunch = true;
        try
        {
            var task = await TaskApi.GetByRequestIdAsync(requestId, ct);
            if (ct.IsCancellationRequested || requestId != _launchedRequestId) return;
            if (task is not null) _launchedTask = task;
            _launchStatusUnavailable = task is null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception)
        {
            if (requestId == _launchedRequestId) _launchStatusUnavailable = true;
        }
        finally
        {
            _isRefreshingLaunch = false;
            if (!_disposeCts.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MonitorLaunchAsync(string requestId, CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (requestId == _launchedRequestId && !IsTerminal(_launchedTask))
            {
                await ReadLaunchStatusAsync(requestId, ct);
                if (IsTerminal(_launchedTask))
                {
                    await LoadRecentTasksAsync();
                    return;
                }
                if (!await timer.WaitForNextTickAsync(ct)) return;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private static bool IsTerminal(TaskDto? task) => task?.Status is "Completed" or "Failed" or "Cancelled";

    public void Dispose()
    {
        _disposeCts.Cancel();
        _clientsLoadCts?.Cancel();
        _recentLoadCts?.Cancel();
        _launchStatusCts?.Cancel();
        _clientsLoadCts?.Dispose();
        _recentLoadCts?.Dispose();
        _launchStatusCts?.Dispose();
    }
}
