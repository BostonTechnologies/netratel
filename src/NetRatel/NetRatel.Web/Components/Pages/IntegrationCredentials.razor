@page "/account/integration-credentials"
@rendermode InteractiveServer
@implements IDisposable
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Routing
@using NetRatel.Infrastructure.Identity
@using NetRatel.Shared.Connectivity
@using NetRatel.Web.Services
@using NetRatel.Web.Components.Shared.Pairing
@using NetRatel.Web.Components.Shared.Notifications
@using NetRatel.Web.Components.Shared.Integrations
@using NetRatel.Web.Components.Shared.Netclaw
@inject IHttpClientFactory Clients
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Integration</PageTitle>
<NavigationLock OnBeforeInternalNavigation="GuardNavigationAsync" ConfirmExternalNavigation="@(_creating || _createOpen && _step == 3)" />
<div class="integration-surface">
<MudContainer MaxWidth="MaxWidth.Large" Class="integration-page" data-testid="integration-credentials-page">
    @if (_interactiveReady) { <span hidden data-testid="integration-credentials-client-ready"></span> }
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-5 integration-header">
        <div><MudText Typo="Typo.h4">Integrations</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Manage system connections and scoped credentials.</MudText></div>
        @if (SafeReturnUrl is { } returnUrl) { <MudButton Href="@returnUrl" Variant="Variant.Text">Return to setup</MudButton> }
    </MudStack>
    @if (_tenantContextError is not null) { <MudAlert Severity="Severity.Warning" Class="mb-3" data-testid="tenant-context-error">@_tenantContextError</MudAlert> }
    <MudTabs ActivePanelIndex="_activeTab" ActivePanelIndexChanged="ChangeTab" MinimumTabWidth="0" Class="integration-tabs" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-5" data-testid="integration-tabs">
        <MudTabPanel Text="System connections">
            <PairingConnectionsPanel InitialTenantId="TenantId" />
        </MudTabPanel>
        <MudTabPanel Text="API &amp; MCP credentials">
            <div class="approval-entry-grid"><HttpHostSetupApprovalPanel InitialCode="@HostCode" /><IntegrationPairingApprovalPanel Approved="LoadAsync" /></div>
            <div class="integration-section-toolbar">
                <MudText Typo="Typo.body2">Scoped client access to the API, CLI/stdio, or HTTP MCP endpoint.</MudText>
                <MudButton @ref="_createOpener" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate" Disabled="@(_loading || _authority is null || _creating)" data-testid="open-create-integration">Create credential</MudButton>
            </div>
    <div class="credential-toolbar" @ref="_listFocus" tabindex="-1">
        <label>Search credentials <input type="search" value="@_credentialSearch" @oninput="CredentialSearchChanged" placeholder="Name, type or endpoint" data-testid="credential-search" /></label>
        <div class="credential-filters" role="group" aria-label="Credential status">
            @foreach (var filter in new[] { "All", "Active", "Revoked", "Expired" })
            { <MudButton Size="Size.Small" Variant="@(_statusFilter == filter ? Variant.Filled : Variant.Text)" Color="Color.Primary" OnClick="@(() => SetStatusFilter(filter))" data-testid="@($"credential-filter-{filter.ToLowerInvariant()}")">@filter (@CountStatus(filter))</MudButton> }
        </div>
        @if (_selectedInactive.Count > 0) { <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" OnClick="ConfirmDeleteSelected" Disabled="_revoking" data-testid="delete-selected-inactive">Delete selected inactive (@_selectedInactive.Count)</MudButton> }
    </div>
    @if (_loadError is not null)
    { <MudAlert Severity="Severity.Error" Class="mb-3">@_loadError <MudButton Variant="Variant.Text" OnClick="LoadAsync">Retry</MudButton></MudAlert> }
    @if (_managementError is not null) { <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="credential-management-error">@_managementError</MudAlert> }
    @if (_loading)
    { <MudSkeleton Height="120px" data-testid="integration-loading" /> }
    else if (_credentials.Count == 0)
    { <MudPaper Class="integration-empty" Elevation="0"><MudText Typo="Typo.h6">No API or MCP credentials yet</MudText><MudText Typo="Typo.body2">Create scoped access for an API, CLI or MCP client.</MudText></MudPaper> }
    else
    {
        <div class="credential-list" role="table" aria-label="Integration credentials" data-testid="credential-list">
            <div class="credential-list-heading" role="row"><span></span><span role="columnheader">Name / connection</span><span role="columnheader">Status / access</span><span role="columnheader">Activity (UTC)</span><span role="columnheader">Actions</span></div>
            @foreach (var credential in FilteredCredentials)
            {
                <div class="credential-compact-row" role="row" @key="credential.Id" data-testid="credential-row">
                    <div role="cell">@if (!IsActive(credential)) { <MudCheckBox T="bool" Value="@_selectedInactive.Contains(credential.Id)" ValueChanged="@(value => SelectInactive(credential, value))" Disabled="_revoking" aria-label="@($"Select inactive credential {credential.Name}")" data-testid="@($"select-inactive-{credential.Id}")" /> }</div>
                    <div role="cell" class="credential-name"><strong>@credential.Name</strong><span>@DisplayPurpose(credential.Purpose)</span><small>@credential.TokenPrefix…</small></div>
                    <div role="cell"><MudChip T="string" Size="Size.Small" Color="@(credential.RevokedAtUtc is not null ? Color.Default : IsActive(credential) ? Color.Success : Color.Warning)">@Status(credential)</MudChip><span class="credential-secondary">@AccessSummary(credential)</span></div>
                    <div role="cell" class="credential-activity"><span>Expires @credential.ExpiresAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</span><span>Last used @(credential.LastUsedAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "never")</span></div>
                    <div role="cell" class="credential-actions">
                        <MudButton Size="Size.Small" OnClick="@(() => _detail = credential)" Disabled="_revoking">Details</MudButton>
                        @if (IsActive(credential))
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmRevoke(credential))" Disabled="_revoking">Revoke</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDelete(credential))" Disabled="_revoking">Revoke &amp; delete</MudButton>
                        }
                        else { <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDelete(credential))" Disabled="_revoking">Delete</MudButton> }
                    </div>
                </div>
            }
            @if (!FilteredCredentials.Any()) { <p class="pa-3" role="status">No credentials match the current search and filter.</p> }
        </div>
    }
        </MudTabPanel>
        <MudTabPanel Text="Notifications">
            @if (_activeTab == 2) { <NotificationConnectorsPanel InitialTenantId="TenantId" @key="TenantId" /> }
        </MudTabPanel>
        <MudTabPanel Text="Netclaw">
            @if (_activeTab == 3) { <NetclawConnectionPanel InitialTenantId="TenantId" TenantChanged="NetclawTenantChanged" /> }
        </MudTabPanel>
    </MudTabs>
</MudContainer>
</div>

<MudDialog ContentStyle="max-height: min(62dvh, 36rem); overflow-y: auto" Visible="_createOpen" VisibleChanged="CreateVisibleChanged" AriaLabel="Create integration" Options="@(new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false, FullWidth = true, MaxWidth = MaxWidth.Large })">
    <TitleContent><MudText Typo="Typo.h6">@(_step == 3 ? "Store your integration secret" : "Create integration")</MudText><MudText Typo="Typo.caption">@(_step < 3 ? $"Step {_step + 1} of 3 · {(_step == 0 ? "Connection" : _step == 1 ? "Access" : "Review")}" : "One-time secret")</MudText></TitleContent>
    <DialogContent><MudStack Spacing="2" Class="integration-dialog">
        @if (_error is not null) { <MudAlert Severity="Severity.Error" data-testid="credential-error">@_error</MudAlert> }
        @if (_step == 0)
        {
            <div class="credential-connection-grid"><MudSelect T="string" Label="Connection type" Variant="Variant.Outlined" @bind-Value="ConnectionType" data-testid="credential-purpose">
                <MudSelectItem Value="@("api")">API / CLI / stdio MCP</MudSelectItem>
                <MudSelectItem Value="@("http-mcp")">HTTP MCP gateway</MudSelectItem>
            </MudSelect>
            <MudTextField Label="Integration name" Variant="Variant.Outlined" @bind-Value="Name" data-testid="credential-name" />
            <MudTextField T="string" Label="Exact expiry (UTC)" Variant="Variant.Outlined" @bind-Value="ExpiryInstant" Placeholder="2030-04-01T10:11:12Z" data-testid="credential-expiry" /></div>
            <MudText Typo="Typo.caption">30 days means 720 hours from @IntegrationCredentialExpiry.Format(_expiryReference). Stored expiry: @(ExpiryUtc is { } expiry ? IntegrationCredentialExpiry.Format(expiry) : "Enter an exact UTC instant ending in Z").</MudText>
            <MudButton OnClick="UseThirtyDays" Disabled="_creating" Size="Size.Small">Use 30 days from this reference</MudButton>
            @if (Purpose == IntegrationCredentialPurpose.HttpMcp)
            {
                <MudTextField Label="HTTP MCP server URL" Variant="Variant.Outlined" @bind-Value="Resource" Placeholder="https://mcp.example.com/mcp" data-testid="credential-resource" />
                <MudText Typo="Typo.body2">Enter the public address of your NetRatel HTTP MCP server. Use the same address in your MCP client. This credential works only with that server.</MudText>
                <MudTooltip Text="This is a server address, not an integration name or the usual NetRatel sign-in URL. Your administrator can provide the configured HTTP MCP endpoint.">
                    <MudButton Variant="Variant.Text" Size="Size.Small">About this URL</MudButton>
                </MudTooltip>
                <MudText Typo="Typo.caption">Use the endpoint from server setup, usually your NetRatel Web address followed by /mcp. Configure and verify the server-to-backend connection first. <a href="https://github.com/BostonTechnologies/netratel/blob/main/docs/mcp-http/setup.md" target="_blank" rel="noopener noreferrer">Server and client setup guide</a>.</MudText>
            }
        }
        else if (_step == 1)
        {
            <div class="selected-tenant-toolbar">
                @foreach (var tenantId in _selectedTenants.ToArray())
                { <MudChip T="int" Value="tenantId" OnClose="@(() => RemoveTenant(tenantId))" Size="Size.Small">@TenantName(tenantId)</MudChip> }
                @if (_authority!.Tenants.Any(tenant => !_selectedTenants.Contains(tenant.TenantId)))
                {
                    <MudSelect T="int?" Label="Add tenant" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_tenantToAdd" data-testid="credential-add-tenant-select">
                        @foreach (var tenant in _authority.Tenants.Where(tenant => !_selectedTenants.Contains(tenant.TenantId))) { <MudSelectItem T="int?" Value="@((int?)tenant.TenantId)">@tenant.Name</MudSelectItem> }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(_tenantToAdd is null)" OnClick="AddTenant">Add tenant</MudButton>
                }
            </div>
            <MudText Typo="Typo.body2">Select explicit access in each scope. Changing scopes preserves selections; removing a tenant clears its grants.</MudText>
            <IntegrationPermissionSelector Scopes="PermissionScopes" Grants="SelectedPairingGrants" InstancePermissions="_instancePermissions" Changed="ChangePermissions" Disabled="_creating" />
        }
        else if (_step == 2)
        {
            <MudText Typo="Typo.subtitle1">Review access</MudText>
            <MudText Typo="Typo.body2">@_name · @DisplayPurpose(Purpose) · expires @(ExpiryUtc is { } exactExpiry ? IntegrationCredentialExpiry.Format(exactExpiry) : "invalid UTC expiry")</MudText>
            @if (Purpose == IntegrationCredentialPurpose.HttpMcp) { <MudText Typo="Typo.body2">Server: @_resource</MudText> }
            <details><summary>@_selectedGrants.Count tenant grants · @_instancePermissions.Count server-level grants</summary>
                @foreach (var tenantGrants in Grants().GroupBy(grant => grant.TenantId))
                { <details><summary>@TenantName(tenantGrants.Key) · @tenantGrants.Count() permissions</summary><ul>@foreach (var grant in tenantGrants) { <li>@Label(grant.Permission) <code>@grant.Permission</code></li> }</ul></details> }
                @if (_instancePermissions.Count > 0) { <details><summary>Server-level · @_instancePermissions.Count permissions</summary><ul>@foreach (var permission in _instancePermissions) { <li>@Label(permission) <code>@permission</code></li> }</ul></details> }
            </details>
            <MudCheckBox T="bool" @bind-Value="_createConfirmed" Label="I approve this connection with the selected access and expiry." data-testid="credential-review-confirm" />
        }
        else
        {
            <MudAlert Severity="Severity.Warning" data-testid="credential-one-time-secret">Copy this secret now. It cannot be shown again.</MudAlert>
            <MudTextField Label="One-time secret" Variant="Variant.Outlined" Value="_revealedSecret" ReadOnly="true" />
            <MudText Typo="Typo.body2">Store it in your client's secret manager. Use it as a Bearer token for the selected connection type; keep it out of shell history and logs.</MudText>
            @if (Purpose == IntegrationCredentialPurpose.HttpMcp)
            {
                <MudText Typo="Typo.subtitle2">HTTP MCP client</MudText>
                <MudText Typo="Typo.body2">Set the server URL to @_resource. Supply the saved secret as the bearer value in your MCP client's protected credential setting.</MudText>
                <pre class="integration-connection-example">Authorization: Bearer &lt;secret from your credential store&gt;</pre>
            }
            else
            {
                <MudText Typo="Typo.subtitle2">CLI and stdio MCP</MudText>
                <pre class="integration-connection-example">NETRATEL_CLI_API_BASE_URL=https://netratel.example.invalid
NETRATEL_CLI_INTEGRATION_TOKEN=&lt;secret from your credential store&gt;

NETRATEL_MCP_CONFIG=/path/to/owner-readable/mcp.json</pre>
                <MudText Typo="Typo.caption">For stdio MCP, the private JSON file needs apiBaseUrl and integrationCredential. Do not pass the secret as a command-line argument.</MudText>
            }
        }
    </MudStack></DialogContent>
    <DialogActions>
        @if (_step == 3) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseCreate" Disabled="_creating">I stored the secret</MudButton> }
        else
        {
            <MudButton OnClick="CloseCreate" Disabled="_creating">Cancel</MudButton>
            @if (_step > 0) { <MudButton OnClick="Previous" Disabled="_creating">Back</MudButton> }
            @if (_step < 2) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Next" Disabled="_creating">Next</MudButton> }
            else { <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_creating || !_createConfirmed)" OnClick="CreateAsync" data-testid="create-credential">@(_creating ? "Creating…" : "Create integration")</MudButton> }
        }
    </DialogActions>
</MudDialog>

<MudDialog Visible="_revokeOpen" VisibleChanged="RevokeVisibleChanged" AriaLabel="Confirm credential action" Options="@(new DialogOptions { BackdropClick = false })">
    <DialogContent><MudText Typo="Typo.h6" Style="overflow-wrap:anywhere">@ManagementActionLabel @_revokeName?</MudText><MudText Typo="Typo.body2">@(_deleteRecord ? _deleteStopsAccess ? "Access stops immediately and this management record will be removed. The secret cannot be recovered." : "The selected inactive management records will be removed. Secrets cannot be recovered." : "Its secret stops working immediately. The revoked management record remains available until deleted.")</MudText></DialogContent>
    <DialogActions><MudButton OnClick="@(() => RevokeVisibleChanged(false))" Disabled="_revoking">Cancel</MudButton><MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_revoking" OnClick="RevokeAsync">@(_revoking ? "Saving…" : ManagementActionLabel)</MudButton></DialogActions>
</MudDialog>
<MudDialog ContentStyle="max-height: min(62dvh, 36rem); overflow-y: auto" Visible="@(_detail is not null)" VisibleChanged="CloseDetail" AriaLabel="Credential details" Options="@(new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium })">
    <DialogContent><div class="credential-detail">@if (_detail is { } detail) {
        <MudText Typo="Typo.h6">@detail.Name</MudText><p>@DisplayPurpose(detail.Purpose) · @Status(detail)</p>
        @if (detail.Resource is not null) { <p class="credential-detail-address">HTTP MCP server: @detail.Resource</p> }
        <p>Created @detail.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC · expires @detail.ExpiresAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</p>
        @foreach (var tenantGrants in detail.Grants.GroupBy(grant => grant.TenantId)) { <details><summary>@TenantName(tenantGrants.Key) · @tenantGrants.Count() permissions</summary><ul>@foreach (var grant in tenantGrants) { <li>@Label(grant.Permission) <code>@grant.Permission</code></li> }</ul></details> }
        @if (detail.InstancePermissions.Count > 0) { <details><summary>Server-level · @detail.InstancePermissions.Count permissions</summary><ul>@foreach (var permission in detail.InstancePermissions) { <li>@Label(permission) <code>@permission</code></li> }</ul></details> }
        <p>The secret was shown once and cannot be recovered.</p>
    }</div></DialogContent>
    <DialogActions><MudButton OnClick="@(() => CloseDetail(false))">Close</MudButton></DialogActions>
</MudDialog>

@code {
    [SupplyParameterFromQuery(Name = "host_code")] public string? HostCode { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "tenant_id")] public string? TenantIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tenantId")] public string? TenantIdAliasQuery { get; set; }
    public int? TenantId { get; private set; }
    private string? _tenantContextError;
    internal static (int? TenantId, string? Error) ResolveTenantContext(string? snake, string? camel)
    {
        var hasSnake = snake is not null; var hasCamel = camel is not null;
        var snakeId = 0; var camelId = 0;
        if (hasSnake && (!int.TryParse(snake, out snakeId) || snakeId <= 0) || hasCamel && (!int.TryParse(camel, out camelId) || camelId <= 0))
            return (null, "The tenant link is invalid. Choose a tenant explicitly; no mapping has changed.");
        if (hasSnake && hasCamel && snakeId != camelId)
            return (null, "The tenant link contains conflicting tenant values. Choose a tenant explicitly; no mapping has changed.");
        return (hasSnake ? snakeId : hasCamel ? camelId : null, null);
    }
    private string? SafeReturnUrl => ReturnUrl is { Length: > 0 } value && value.StartsWith('/') && !value.StartsWith("//", StringComparison.Ordinal) && !value.Contains('\\') && !value.Any(char.IsControl) ? value : null;
    private int _activeTab;
    private string _connectionType = "api";
    private string ConnectionType
    {
        get => _connectionType;
        set
        {
            if (_connectionType != value) _createConfirmed = false;
            _connectionType = value;
            Purpose = value == "http-mcp" ? IntegrationCredentialPurpose.HttpMcp : IntegrationCredentialPurpose.Api;
        }
    }
    protected override void OnParametersSet()
    {
        (TenantId, _tenantContextError) = ResolveTenantContext(TenantIdQuery, TenantIdAliasQuery);
        _activeTab = Tab switch { "credentials" => 1, "notifications" => 2, "netclaw" => 3, _ => 0 };
    }
    private void ChangeTab(int index)
    {
        if (_disposed || index == _activeTab) return;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", index switch { 1 => "credentials", 2 => "notifications", 3 => "netclaw", _ => (string?)null }));
    }
    private void NetclawTenantChanged(int tenant) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(
        new Dictionary<string, object?> { ["tab"] = "netclaw", ["tenantId"] = tenant, ["tenant_id"] = null }));
    private HttpClient Api => Clients.CreateClient("OrchestratorApi");
    private IReadOnlyList<CredentialSummary> _credentials = [];
    private CredentialAuthority? _authority;
    private readonly List<int> _selectedTenants = [];
    private readonly HashSet<(int TenantId, string Permission)> _selectedGrants = [];
    private readonly HashSet<string> _instancePermissions = new(StringComparer.Ordinal);
    private string _name = string.Empty;
    private string? _resource, _search, _error, _loadError, _revealedSecret, _revokeId, _revokeName;
    private DateTimeOffset _expiryReference = DateTimeOffset.UtcNow;
    private string _expiryInstant = IntegrationCredentialExpiry.Format(IntegrationCredentialExpiry.ThirtyDaysFrom(DateTimeOffset.UtcNow));
    private IntegrationCredentialPurpose _purpose = IntegrationCredentialPurpose.Api;
    private IntegrationCredentialPurpose Purpose
    {
        get => _purpose;
        set
        {
            if (_purpose != value && value == IntegrationCredentialPurpose.Api) _resource = null;
            if (_purpose != value && value == IntegrationCredentialPurpose.HttpMcp && string.IsNullOrWhiteSpace(_resource))
                _resource = _authority?.ConfiguredHttpMcpServerUrl;
            _purpose = value;
        }
    }
    private string Name { get => _name; set { if (_name != value) _createConfirmed = false; _name = value; } }
    private string? Resource { get => _resource; set { if (_resource != value) _createConfirmed = false; _resource = value; } }
    private string ExpiryInstant { get => _expiryInstant; set { if (_expiryInstant != value) _createConfirmed = false; _expiryInstant = value; } }
    private void UseThirtyDays() { ExpiryInstant = IntegrationCredentialExpiry.Format(IntegrationCredentialExpiry.ThirtyDaysFrom(_expiryReference)); _createConfirmed = false; }
    private bool _createConfirmed, _deleteRecord, _deleteStopsAccess, _restoreListFocus;
    private string ManagementActionLabel => _deleteRecord ? _deleteStopsAccess ? "Revoke & delete" : "Delete" : "Revoke";
    private ElementReference _listFocus;
    private string _credentialSearch = "", _statusFilter = "All";
    private string? _managementError;
    private CredentialSummary? _detail;
    private readonly HashSet<string> _selectedInactive = new(StringComparer.Ordinal);
    // A GET started before a mutation may complete afterwards with the previous snapshot.
    private readonly HashSet<string> _deletedCredentialIds = new(StringComparer.Ordinal);
    private readonly Dictionary<string, DateTimeOffset> _acknowledgedRevocations = new(StringComparer.Ordinal);
    private string[] _deleteIds = [];
    private IEnumerable<CredentialSummary> FilteredCredentials => _credentials.Where(credential => (_statusFilter == "All" || Status(credential) == _statusFilter) && (string.IsNullOrWhiteSpace(_credentialSearch) || credential.Name.Contains(_credentialSearch, StringComparison.OrdinalIgnoreCase) || (credential.Resource?.Contains(_credentialSearch, StringComparison.OrdinalIgnoreCase) ?? false) || DisplayPurpose(credential.Purpose).Contains(_credentialSearch, StringComparison.OrdinalIgnoreCase)));
    private int CountStatus(string status) => _credentials.Count(credential => status == "All" || Status(credential) == status);
    private static bool IsActive(CredentialSummary credential) => Status(credential) == "Active";
    private void SetStatusFilter(string value) { if (_revoking) return; _statusFilter = value; _selectedInactive.Clear(); }
    private void CredentialSearchChanged(ChangeEventArgs args) { if (_revoking) return; _credentialSearch = args.Value?.ToString() ?? ""; _selectedInactive.Clear(); }
    private void SelectInactive(CredentialSummary credential, bool selected) { if (_revoking || IsActive(credential) || !FilteredCredentials.Any(item => item.Id == credential.Id)) return; if (selected) _selectedInactive.Add(credential.Id); else _selectedInactive.Remove(credential.Id); }
    private void CloseDetail(bool value) { if (value) return; _detail = null; _restoreListFocus = true; }
    private IReadOnlyList<IntegrationPairingGrant> SelectedPairingGrants => _selectedGrants.Select(grant => new IntegrationPairingGrant(grant.TenantId, grant.Permission)).ToArray();
    private IReadOnlyList<IntegrationPermissionScope> PermissionScopes => _authority is null ? [] : _authority.Tenants.Where(tenant => _selectedTenants.Contains(tenant.TenantId)).Select(tenant => new IntegrationPermissionScope(tenant.TenantId, tenant.Name, tenant.Permissions.Select(permission => new IntegrationPermission(permission.Id, permission.Label, permission.Description)).ToArray())).Concat(_authority.InstancePermissions.Count > 0 ? [new IntegrationPermissionScope(null, "Server-level access", _authority.InstancePermissions.Select(permission => new IntegrationPermission(permission.Id, permission.Label, permission.Description)).ToArray())] : []).ToArray();
    private void ChangePermissions(IntegrationPermissionChange change)
    {
        if (_creating) return;
        foreach (var permission in change.Permissions)
            if (change.TenantId is int tenant) SetTenantPermission(tenant, permission, change.Selected);
            else SetInstancePermission(permission, change.Selected);
    }
    private int? _tenantToAdd;
    private bool _loading = true, _creating, _createOpen, _revokeOpen, _revoking, _interactiveReady;
    private bool _disposed;
    private MudButton? _createOpener;
    private bool _restoreCreateFocus;
    private int _createGeneration;
    private int _step;
    private DateTimeOffset? ExpiryUtc => IntegrationCredentialExpiry.ParseUtcInstant(_expiryInstant);
    protected override async Task OnInitializedAsync() { await LoadAsync(); OnParametersSet(); }
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _interactiveReady = true;
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_restoreListFocus) { _restoreListFocus = false; await _listFocus.FocusAsync(); }
        if (!_restoreCreateFocus || _createOpener is null) return;
        _restoreCreateFocus = false;
        await _createOpener.FocusAsync();
    }
    private async Task LoadAsync()
    {
        if (_disposed) return;
        _loading = true; _loadError = null;
        try
        {
            var credentials = Api.GetFromJsonAsync<List<CredentialSummary>>("/api/v2/account/integration-credentials/");
            var authority = Api.GetFromJsonAsync<CredentialAuthority>("/api/v2/account/integration-credentials/authority");
