        return Task.CompletedTask;
    }
    private async Task ShowValidationErrorAsync(HttpResponseMessage response, int generation)
    {
        try
        {
            using var document = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            if (!IsCurrentCreate(generation)) return;
            if (document.RootElement.TryGetProperty("errors", out var errors))
            {
                foreach (var field in new[] { "name", "purpose", "expiresAtUtc", "resource", "grants", "instancePermissions", "credential" })
                {
                    if (!errors.TryGetProperty(field, out var messages) || messages.ValueKind != JsonValueKind.Array || messages.GetArrayLength() == 0)
                        continue;
                    _step = field is "name" or "purpose" or "expiresAtUtc" or "resource" ? 0 : 1;
                    _error = messages[0].GetString() ?? "Review this field and retry.";
                    return;
                }
            }
        }
        catch (JsonException)
        {
            if (IsCurrentCreate(generation)) _error = "The API rejected a field. Review the connection and access steps; your draft is still here.";
            return;
        }
        if (IsCurrentCreate(generation)) _error = "The API rejected a field. Review the connection and access steps; your draft is still here.";
    }
    private void ConfirmRevoke(CredentialSummary credential) { if (_revoking) return; _deleteRecord = false; _deleteIds = []; _revokeId = credential.Id; _revokeName = credential.Name; _revokeOpen = true; }
    private void ConfirmDelete(CredentialSummary credential) { if (_revoking) return; _deleteRecord = true; _deleteStopsAccess = IsActive(credential); _deleteIds = [credential.Id]; _revokeName = credential.Name; _revokeOpen = true; }
    private void ConfirmDeleteSelected()
    {
        if (_revoking) return;
        _deleteIds = FilteredCredentials.Where(credential => !IsActive(credential) && _selectedInactive.Contains(credential.Id)).Select(credential => credential.Id).ToArray();
        if (_deleteIds.Length == 0) return;
        _deleteRecord = true; _deleteStopsAccess = false; _revokeName = $"{_deleteIds.Length} selected inactive credentials"; _revokeOpen = true;
    }
    private void RevokeVisibleChanged(bool value) { if (_revoking) return; _revokeOpen = value; if (!value) { _revokeId = _revokeName = null; _deleteIds = []; _restoreListFocus = true; } }
    private async Task RevokeAsync()
    {
        if (_revoking || !_revokeOpen || _disposed || !_deleteRecord && _revokeId is null) return;
        _revoking = true; _managementError = null;
