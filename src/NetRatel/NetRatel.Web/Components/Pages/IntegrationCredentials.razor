    private bool Selected(int tenantId, string permission) => _selectedGrants.Contains((tenantId, permission));
    private void SetTenantPermission(int tenantId, string permission, bool selected) { _createConfirmed = false; if (selected) _selectedGrants.Add((tenantId, permission)); else _selectedGrants.Remove((tenantId, permission)); }
    private void SetInstancePermission(string permission, bool selected) { _createConfirmed = false; if (selected) _instancePermissions.Add(permission); else _instancePermissions.Remove(permission); }
