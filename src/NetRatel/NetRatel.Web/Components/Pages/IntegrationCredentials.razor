@page "/account/integration-credentials"
@rendermode InteractiveServer
@using NetRatel.Infrastructure.Identity
@using NetRatel.Infrastructure.Identity.Authorization
@inject IHttpClientFactory Clients
@inject ISnackbar Snackbar

<MudPaper Class="p-6 space-y-4" data-testid="integration-credentials-page">
    <MudText Typo="Typo.h4">Integration credentials</MudText>
    <MudText Typo="Typo.body2">
        Create a scoped token for API, CLI, or stdio MCP automation. HTTP MCP credentials are purpose-bound and will only work with its paired gateway. A secret is shown once and cannot be recovered.
    </MudText>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" data-testid="credential-error">@_error</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_name" Label="Credential name" Required="true" data-testid="credential-name" /></MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="IntegrationCredentialPurpose" Label="Purpose" @bind-Value="_purpose" data-testid="credential-purpose">
                <MudSelectItem Value="IntegrationCredentialPurpose.Api">API / CLI / stdio MCP</MudSelectItem>
                <MudSelectItem Value="IntegrationCredentialPurpose.HttpMcp">HTTP MCP gateway</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6"><MudNumericField T="int" @bind-Value="_tenantId" Label="Tenant ID" Min="1" Required="true" data-testid="credential-tenant" /></MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Permission" @bind-Value="_permission" data-testid="credential-permission">
                @foreach (var permission in Permissions)
                {
                    <MudSelectItem Value="@permission">@permission</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6"><MudDatePicker Label="Expires on" @bind-Date="_expiryDate" MinDate="DateTime.Today.AddDays(1)" Required="true" data-testid="credential-expiry" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_resource" Label="HTTP MCP resource (required for HTTP MCP)" data-testid="credential-resource" /></MudItem>
    </MudGrid>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_creating" OnClick="CreateAsync" data-testid="create-credential">Create credential</MudButton>

    @if (!string.IsNullOrWhiteSpace(_revealedSecret))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" data-testid="credential-one-time-secret">
            <MudText Typo="Typo.subtitle2">Copy this secret now. It cannot be shown again.</MudText>
            <MudTextField Value="_revealedSecret" ReadOnly="true" />
            <MudButton Variant="Variant.Text" OnClick="DismissSecret">I stored it safely</MudButton>
        </MudAlert>
    }

    <MudDivider Class="my-4" />
    <MudText Typo="Typo.h6">Your credentials</MudText>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudTable Items="_credentials" Dense="true" Hover="true">
            <HeaderContent><MudTh>Name</MudTh><MudTh>Purpose</MudTh><MudTh>Resource</MudTh><MudTh>Prefix</MudTh><MudTh>Grants</MudTh><MudTh>Last used</MudTh><MudTh>Expires</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Purpose">@DisplayPurpose(context.Purpose)</MudTd>
                <MudTd DataLabel="Resource">@(context.Resource ?? "—")</MudTd>
                <MudTd DataLabel="Prefix"><code>@context.TokenPrefix</code></MudTd>
                <MudTd DataLabel="Grants">@string.Join(", ", context.Grants.Select(grant => $"{grant.TenantId}:{grant.Permission}"))</MudTd>
                <MudTd DataLabel="Last used">@(context.LastUsedAtUtc?.LocalDateTime.ToString("g") ?? "Never")</MudTd>
                <MudTd DataLabel="Expires">@context.ExpiresAtUtc.LocalDateTime.ToString("d")</MudTd>
                <MudTd DataLabel="Status">@(context.RevokedAtUtc is not null ? "Revoked" : context.ExpiresAtUtc <= DateTimeOffset.UtcNow ? "Expired" : "Active")</MudTd>
                <MudTd><MudButton Size="Size.Small" Color="Color.Error" Disabled="context.RevokedAtUtc is not null" OnClick="@(() => RevokeAsync(context.Id))">Revoke</MudButton></MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private static readonly string[] Permissions = NetRatelPermissions.All.Order().Where(permission => permission != NetRatelPermissions.IntegrationManagement).ToArray();
    private HttpClient Api => Clients.CreateClient("OrchestratorApi");
    private IReadOnlyList<CredentialSummary> _credentials = [];
    private string _name = string.Empty;
    private IntegrationCredentialPurpose _purpose = IntegrationCredentialPurpose.Api;
    private int _tenantId = 1;
    private string _permission = NetRatelPermissions.TelemetryRead;
    private DateTime? _expiryDate = DateTime.Today.AddDays(30);
    private string? _resource;
    private string? _revealedSecret;
    private string? _error;
    private bool _loading = true;
    private bool _creating;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try { _credentials = await Api.GetFromJsonAsync<List<CredentialSummary>>("/api/v2/account/integration-credentials/") ?? []; }
        catch (HttpRequestException) { Snackbar.Add("Could not load integration credentials.", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task CreateAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name) || _expiryDate is null || _tenantId < 1 || string.IsNullOrWhiteSpace(_permission) ||
            (_purpose == IntegrationCredentialPurpose.HttpMcp && string.IsNullOrWhiteSpace(_resource)))
        {
            Snackbar.Add("Name, purpose, tenant, permission, expiry, and an HTTP MCP resource when applicable are required.", Severity.Warning);
            return;
        }

        _creating = true;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, "/api/v2/account/integration-credentials/")
            {
                Content = JsonContent.Create(new CreateCredential(
                    _name, _purpose, new DateTimeOffset(_expiryDate.Value.Date.AddDays(1).AddTicks(-1), TimeSpan.Zero),
                    [new Grant(_tenantId, _permission)], _resource))
            };
            using var response = await Api.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Credential creation was denied or invalid (HTTP {(int)response.StatusCode}).";
                Snackbar.Add(_error, Severity.Error);
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<CredentialSecret>();
            _revealedSecret = created?.Secret;
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Credential creation failed because the API is unavailable.";
            Snackbar.Add(_error, Severity.Error);
        }
        finally { _creating = false; }
    }

    private async Task RevokeAsync(string credentialId)
    {
        using var request = new HttpRequestMessage(HttpMethod.Post, $"/api/v2/account/integration-credentials/{Uri.EscapeDataString(credentialId)}/revoke");
        using var response = await Api.SendAsync(request);
        if (response.IsSuccessStatusCode) { Snackbar.Add("Credential revoked.", Severity.Success); await LoadAsync(); }
        else Snackbar.Add("Credential revocation failed.", Severity.Error);
    }

    private void DismissSecret() => _revealedSecret = null;
    private static string DisplayPurpose(IntegrationCredentialPurpose purpose) => purpose == IntegrationCredentialPurpose.Api ? "API / CLI / stdio" : "HTTP MCP";
    private sealed record Grant(int TenantId, string Permission);
    private sealed record CreateCredential(string Name, IntegrationCredentialPurpose Purpose, DateTimeOffset ExpiresAtUtc, IReadOnlyList<Grant> Grants, string? Resource);
    private sealed record CredentialSecret(string CredentialId, string PublicId, string TokenPrefix, string Secret, DateTimeOffset ExpiresAtUtc);
    private sealed record CredentialSummary(string Id, string PublicId, string TokenPrefix, string Name, IntegrationCredentialPurpose Purpose, string? Resource, DateTimeOffset CreatedAtUtc, DateTimeOffset ExpiresAtUtc, DateTimeOffset? RevokedAtUtc, DateTimeOffset? LastUsedAtUtc, IReadOnlyList<Grant> Grants);
}
