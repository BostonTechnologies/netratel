@page "/account/integration-credentials"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using NetRatel.Infrastructure.Identity
@using NetRatel.Shared.Connectivity
@using NetRatel.Web.Services
@inject IHttpClientFactory Clients
@inject ISnackbar Snackbar

<PageTitle>Integration</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="integration-page" data-testid="integration-credentials-page">
    @if (_interactiveReady) { <span hidden data-testid="integration-credentials-client-ready"></span> }
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-5 integration-header">
        <div><MudText Typo="Typo.h4">Integration</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Connect automation with only the access it needs.</MudText></div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate" Disabled="@(_loading || _authority is null)" data-testid="open-create-integration">Create integration</MudButton>
    </MudStack>
    @if (_loadError is not null)
    { <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError <MudButton Variant="Variant.Text" OnClick="LoadAsync">Retry</MudButton></MudAlert> }
    @if (_loading)
    { <MudSkeleton Height="160px" data-testid="integration-loading" /> }
    else if (_credentials.Count == 0)
    { <MudPaper Class="integration-empty" Elevation="0"><MudText Typo="Typo.h6">No integrations yet</MudText><MudText Typo="Typo.body2">Create a scoped credential for an API client, CLI, stdio MCP, or an HTTP MCP server.</MudText></MudPaper> }
    else
    {
        <MudStack Spacing="2">
            @foreach (var credential in _credentials)
            {
                <MudPaper Class="integration-row" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="integration-row-head">
                        <div><MudText Typo="Typo.h6">@credential.Name</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@DisplayPurpose(credential.Purpose) · @credential.TokenPrefix…</MudText></div>
                        <MudChip T="string" Size="Size.Small" Color="@(credential.RevokedAtUtc is not null ? Color.Default : credential.ExpiresAtUtc <= DateTimeOffset.UtcNow ? Color.Warning : Color.Success)">@Status(credential)</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="my-2">@AccessSummary(credential)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Expires @credential.ExpiresAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC · Last used @(credential.LastUsedAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "never")</MudText>
                    <MudExpansionPanels Class="mt-2" Elevation="0"><MudExpansionPanel Text="Connection and access details">
                        @if (credential.Resource is not null) { <MudText Typo="Typo.body2">HTTP MCP server: @credential.Resource</MudText> }
                        @foreach (var grant in credential.Grants) { <MudText Typo="Typo.body2">@TenantName(grant.TenantId): @Label(grant.Permission) <span class="integration-id">(@grant.Permission)</span></MudText> }
                        @foreach (var permission in credential.InstancePermissions) { <MudText Typo="Typo.body2">Server-level: @Label(permission) <span class="integration-id">(@permission)</span></MudText> }
                        <MudText Typo="Typo.caption">The secret was shown once at creation and cannot be recovered.</MudText>
                        @if (credential.RevokedAtUtc is null) { <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="@(() => ConfirmRevoke(credential))">Revoke integration</MudButton> }
                    </MudExpansionPanel></MudExpansionPanels>
                </MudPaper>
            }
        </MudStack>
    }
</MudContainer>

<MudDialog Visible="_createOpen" VisibleChanged="CreateVisibleChanged" AriaLabel="Create integration">
    <DialogContent><MudStack Spacing="3" Class="integration-dialog">
        <MudText Typo="Typo.h6">@(_step == 3 ? "Store your integration secret" : "Create integration")</MudText>
        @if (_step < 3) { <MudText Typo="Typo.caption">Step @(_step + 1) of 3 · @(_step == 0 ? "Connection" : _step == 1 ? "Access" : "Review")</MudText> }
        @if (_error is not null) { <MudAlert Severity="Severity.Error" data-testid="credential-error">@_error</MudAlert> }
        @if (_step == 0)
        {
            <MudTextField Label="Integration name" Variant="Variant.Outlined" @bind-Value="_name" data-testid="credential-name" />
            <MudSelect T="IntegrationCredentialPurpose" Label="Connection type" Variant="Variant.Outlined" @bind-Value="Purpose" data-testid="credential-purpose">
                <MudSelectItem Value="IntegrationCredentialPurpose.Api">API / CLI / stdio MCP</MudSelectItem>
                <MudSelectItem Value="IntegrationCredentialPurpose.HttpMcp">HTTP MCP gateway</MudSelectItem>
            </MudSelect>
            <MudDatePicker Label="Expires on (23:59 UTC)" Variant="Variant.Outlined" @bind-Date="_expiryDate" MinDate="DateTime.UtcNow.Date.AddDays(1)" data-testid="credential-expiry" />
            @if (Purpose == IntegrationCredentialPurpose.HttpMcp)
            {
                <MudTextField Label="HTTP MCP server URL" Variant="Variant.Outlined" @bind-Value="_resource" Placeholder="https://mcp.example.com/mcp" data-testid="credential-resource" />
                <MudText Typo="Typo.body2">Enter the public address of your NetRatel HTTP MCP server. Use the same address in your MCP client. This credential works only with that server.</MudText>
                <MudText Typo="Typo.caption">This is usually separate from the NetRatel sign-in address. Ask your administrator for the configured endpoint. <a href="https://github.com/BostonTechnologies/netratel/blob/main/docs/mcp-http/local-credential-mode.md" target="_blank" rel="noopener noreferrer">HTTP MCP setup guide</a>.</MudText>
            }
        }
        else if (_step == 1)
        {
            <MudText Typo="Typo.subtitle1">Tenant permissions</MudText>
            <MudText Typo="Typo.body2">Choose each permission separately. A tenant administrator role does not automatically grant this integration every permission.</MudText>
            @foreach (var tenantId in _selectedTenants.ToArray())
            {
                var tenant = _authority!.Tenants.Single(candidate => candidate.TenantId == tenantId);
                <MudPaper Class="integration-access-group" Elevation="0">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"><MudText Typo="Typo.subtitle1">@tenant.Name</MudText><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => RemoveTenant(tenantId))">Remove</MudButton></MudStack>
                    <MudTextField Label="Search permissions" Variant="Variant.Outlined" @bind-Value="_search" Immediate="true" />
                    @foreach (var permission in tenant.Permissions.Where(VisiblePermission))
                    {
                        <MudCheckBox T="bool" Value="@Selected(tenantId, permission.Id)" ValueChanged="@(value => SetTenantPermission(tenantId, permission.Id, value))" Label="@permission.Label" data-testid="@($"credential-permission-{tenantId}-{permission.Id}")" />
                        <MudText Typo="Typo.caption" Class="integration-description">@permission.Description <span class="integration-id">@permission.Id</span></MudText>
                    }
                </MudPaper>
            }
            @if (_authority!.Tenants.Any(tenant => !_selectedTenants.Contains(tenant.TenantId)))
            {
                <MudSelect T="int?" Label="Add tenant" Variant="Variant.Outlined" @bind-Value="_tenantToAdd" data-testid="credential-add-tenant-select">
                    @foreach (var tenant in _authority.Tenants.Where(tenant => !_selectedTenants.Contains(tenant.TenantId))) { <MudSelectItem T="int?" Value="@((int?)tenant.TenantId)">@tenant.Name</MudSelectItem> }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Disabled="@(_tenantToAdd is null)" OnClick="AddTenant">Add tenant</MudButton>
            }
            <MudExpansionPanels Elevation="0"><MudExpansionPanel Text="Server-level access (advanced)">
                <MudText Typo="Typo.body2">Tenant permissions apply only to the tenants above. Server-level permissions may expose NetRatel-wide information or operations; choose them separately.</MudText>
                @foreach (var permission in _authority.InstancePermissions)
                {
                    <MudCheckBox T="bool" Value="@_instancePermissions.Contains(permission.Id)" ValueChanged="@(value => SetInstancePermission(permission.Id, value))" Label="@permission.Label" data-testid="@($"credential-instance-permission-{permission.Id}")" />
                    <MudText Typo="Typo.caption" Class="integration-description">@permission.Description <span class="integration-id">@permission.Id</span></MudText>
                }
            </MudExpansionPanel></MudExpansionPanels>
        }
        else if (_step == 2)
        {
            <MudText Typo="Typo.subtitle1">Review access</MudText>
            <MudText Typo="Typo.body2">@_name · @DisplayPurpose(Purpose) · expires @_expiryDate?.ToString("yyyy-MM-dd") at 23:59 UTC</MudText>
            @if (Purpose == IntegrationCredentialPurpose.HttpMcp) { <MudText Typo="Typo.body2">Server: @_resource</MudText> }
            @foreach (var grant in Grants()) { <MudText Typo="Typo.body2">@TenantName(grant.TenantId) · @Label(grant.Permission)</MudText> }
            @foreach (var permission in _instancePermissions) { <MudText Typo="Typo.body2">Server-level · @Label(permission)</MudText> }
        }
        else
        {
            <MudAlert Severity="Severity.Warning" data-testid="credential-one-time-secret">Copy this secret now. It cannot be shown again.</MudAlert>
            <MudTextField Label="One-time secret" Variant="Variant.Outlined" Value="_revealedSecret" ReadOnly="true" />
            <MudText Typo="Typo.body2">Store it in your client's secret manager. Use it as a Bearer token for the selected connection type; keep it out of shell history and logs.</MudText>
        }
    </MudStack></DialogContent>
    <DialogActions>
        @if (_step == 3) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseCreate">I stored the secret</MudButton> }
        else
        {
            <MudButton OnClick="CloseCreate">Cancel</MudButton>
            @if (_step > 0) { <MudButton OnClick="Previous">Back</MudButton> }
            @if (_step < 2) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Next">Next</MudButton> }
            else { <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_creating" OnClick="CreateAsync" data-testid="create-credential">@(_creating ? "Creating…" : "Create integration")</MudButton> }
        }
    </DialogActions>
</MudDialog>

<MudDialog Visible="_revokeOpen" VisibleChanged="RevokeVisibleChanged" AriaLabel="Revoke integration">
    <DialogContent><MudText Typo="Typo.h6">Revoke @_revokeName?</MudText><MudText Typo="Typo.body2">Its current secret will stop working immediately. This cannot be undone.</MudText></DialogContent>
    <DialogActions><MudButton OnClick="@(() => RevokeVisibleChanged(false))">Cancel</MudButton><MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_revoking" OnClick="RevokeAsync">Revoke</MudButton></DialogActions>
</MudDialog>

@code {
    private HttpClient Api => Clients.CreateClient("OrchestratorApi");
    private IReadOnlyList<CredentialSummary> _credentials = [];
    private CredentialAuthority? _authority;
    private readonly List<int> _selectedTenants = [];
    private readonly HashSet<(int TenantId, string Permission)> _selectedGrants = [];
    private readonly HashSet<string> _instancePermissions = new(StringComparer.Ordinal);
    private string _name = string.Empty;
    private string? _resource, _search, _error, _loadError, _revealedSecret, _revokeId, _revokeName;
    private DateTime? _expiryDate = DateTime.UtcNow.Date.AddDays(30);
    private IntegrationCredentialPurpose _purpose = IntegrationCredentialPurpose.Api;
    private IntegrationCredentialPurpose Purpose
    {
        get => _purpose;
        set
        {
            if (_purpose != value && value == IntegrationCredentialPurpose.Api) _resource = null;
            if (_purpose != value && value == IntegrationCredentialPurpose.HttpMcp && string.IsNullOrWhiteSpace(_resource))
                _resource = _authority?.ConfiguredHttpMcpServerUrl;
            _purpose = value;
        }
    }
    private int? _tenantToAdd;
    private bool _loading = true, _creating, _createOpen, _revokeOpen, _revoking, _interactiveReady;
    private int _step;
    private DateTimeOffset? ExpiryUtc => IntegrationCredentialExpiry.EndOfUtcDay(_expiryDate);
    protected override async Task OnInitializedAsync() => await LoadAsync();
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _interactiveReady = true;
        StateHasChanged();
    }
    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            var credentials = Api.GetFromJsonAsync<List<CredentialSummary>>("/api/v2/account/integration-credentials/");
            var authority = Api.GetFromJsonAsync<CredentialAuthority>("/api/v2/account/integration-credentials/authority");
            await Task.WhenAll(credentials, authority);
            _credentials = await credentials ?? [];
            _authority = await authority;
        }
        catch (HttpRequestException) { _loadError = "Could not load integrations or your assignable access."; _authority = null; }
        finally { _loading = false; }
    }
    private void OpenCreate()
    {
        if (_authority is null) return;
        _step = 0; _error = null; _name = string.Empty; _purpose = IntegrationCredentialPurpose.Api;
        _resource = _authority.ConfiguredHttpMcpServerUrl; _expiryDate = DateTime.UtcNow.Date.AddDays(30);
        _selectedTenants.Clear(); _selectedGrants.Clear(); _instancePermissions.Clear(); _tenantToAdd = null; _search = null; _revealedSecret = null;
        if (_authority.Tenants.Count > 0) _selectedTenants.Add(_authority.Tenants[0].TenantId);
        _createOpen = true;
    }
    private void CloseCreate() => CreateVisibleChanged(false);
    private void CreateVisibleChanged(bool value)
    {
        _createOpen = value;
        if (!value) { _revealedSecret = _resource = _error = null; _selectedGrants.Clear(); _instancePermissions.Clear(); }
    }
    private void Next()
    {
        _error = null;
        if (_step == 0)
        {
            if (string.IsNullOrWhiteSpace(_name) || _name.Length > 128 || ExpiryUtc is null ||
                ExpiryUtc <= DateTimeOffset.UtcNow || ExpiryUtc > DateTimeOffset.UtcNow.AddDays(365))
            { _error = "Enter a name and an expiry date from tomorrow through the next year (23:59 UTC)."; return; }
            if (Purpose == IntegrationCredentialPurpose.HttpMcp && !McpResourceUri.TryNormalize(_resource, out _))
            { _error = "Enter an absolute HTTPS MCP server URL ending in /mcp, without a query or fragment."; return; }
        }
        if (_step == 1 && _selectedGrants.Count == 0 && _instancePermissions.Count == 0)
        { _error = "Choose at least one tenant or server-level permission."; return; }
        _step++;
    }
    private void Previous() { _error = null; if (_step > 0) _step--; }
    private void AddTenant() { if (_tenantToAdd is int id && !_selectedTenants.Contains(id)) _selectedTenants.Add(id); _tenantToAdd = null; }
    private void RemoveTenant(int id) { _selectedTenants.Remove(id); _selectedGrants.RemoveWhere(grant => grant.TenantId == id); _error = "Removed that tenant and its selected permissions."; }
    private bool VisiblePermission(PermissionDescriptor permission) => string.IsNullOrWhiteSpace(_search) || permission.Label.Contains(_search, StringComparison.OrdinalIgnoreCase) || permission.Id.Contains(_search, StringComparison.OrdinalIgnoreCase);
    private bool Selected(int tenantId, string permission) => _selectedGrants.Contains((tenantId, permission));
    private void SetTenantPermission(int tenantId, string permission, bool selected) { if (selected) _selectedGrants.Add((tenantId, permission)); else _selectedGrants.Remove((tenantId, permission)); }
    private void SetInstancePermission(string permission, bool selected) { if (selected) _instancePermissions.Add(permission); else _instancePermissions.Remove(permission); }
    private Grant[] Grants() => _selectedGrants.OrderBy(grant => grant.TenantId).ThenBy(grant => grant.Permission).Select(grant => new Grant(grant.TenantId, grant.Permission)).ToArray();
    private async Task CreateAsync()
    {
        if (_creating || _step != 2 || ExpiryUtc is null) return;
        _creating = true; _error = null;
        try
        {
            var expiryUtc = ExpiryUtc.Value;
            using var response = await Api.PostAsJsonAsync("/api/v2/account/integration-credentials/", new CreateCredential(
                _name.Trim(), Purpose, expiryUtc, Grants(), Purpose == IntegrationCredentialPurpose.HttpMcp ? _resource : null,
                _instancePermissions.Order().ToArray()));
            if (!response.IsSuccessStatusCode)
            {
                _error = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => "Your access changed or one selected permission cannot be delegated. Review the selections.",
                    System.Net.HttpStatusCode.TooManyRequests => "Too many requests. Wait a moment and retry.",
                    System.Net.HttpStatusCode.BadRequest => "A field or permission is invalid. Review the connection and access steps.",
                    _ => $"Creation failed (HTTP {(int)response.StatusCode}). Your draft is still here."
                };
                return;
            }
            _revealedSecret = (await response.Content.ReadFromJsonAsync<CredentialSecret>())?.Secret;
            _step = 3;
            await LoadAsync();
        }
        catch (HttpRequestException) { _error = "The API is unavailable. Your draft is still here."; }
        finally { _creating = false; }
    }
    private void ConfirmRevoke(CredentialSummary credential) { _revokeId = credential.Id; _revokeName = credential.Name; _revokeOpen = true; }
    private void RevokeVisibleChanged(bool value) { _revokeOpen = value; if (!value) _revokeId = _revokeName = null; }
    private async Task RevokeAsync()
    {
        if (_revoking || _revokeId is null) return;
        _revoking = true;
        try
        {
            using var response = await Api.PostAsync($"/api/v2/account/integration-credentials/{Uri.EscapeDataString(_revokeId)}/revoke", null);
            if (!response.IsSuccessStatusCode) { Snackbar.Add("Could not revoke integration.", Severity.Error); return; }
            RevokeVisibleChanged(false); await LoadAsync();
        }
        catch (HttpRequestException) { Snackbar.Add("The API is unavailable.", Severity.Error); }
        finally { _revoking = false; }
    }
    private string TenantName(int id) => _authority?.Tenants.FirstOrDefault(tenant => tenant.TenantId == id)?.Name ?? $"Tenant {id} (unavailable)";
    private string Label(string id) => _authority?.Tenants.SelectMany(tenant => tenant.Permissions).Concat(_authority.InstancePermissions).FirstOrDefault(permission => permission.Id == id)?.Label ?? id;
    private string AccessSummary(CredentialSummary credential) => $"{credential.Grants.Count} tenant permission{(credential.Grants.Count == 1 ? "" : "s")}, {credential.InstancePermissions.Count} server-level permission{(credential.InstancePermissions.Count == 1 ? "" : "s")}";
    private static string Status(CredentialSummary credential) => credential.RevokedAtUtc is not null ? "Revoked" : credential.ExpiresAtUtc <= DateTimeOffset.UtcNow ? "Expired" : "Active";
    private static string DisplayPurpose(IntegrationCredentialPurpose purpose) => purpose == IntegrationCredentialPurpose.Api ? "API / CLI / stdio MCP" : "HTTP MCP";
    private sealed record PermissionDescriptor(string Id, string Label, string Description);
    private sealed record TenantAuthority(int TenantId, string Name, IReadOnlyList<PermissionDescriptor> Permissions);
    private sealed record CredentialAuthority(IReadOnlyList<TenantAuthority> Tenants, IReadOnlyList<PermissionDescriptor> InstancePermissions, string ConfiguredHttpMcpServerUrl);
    private sealed record Grant(int TenantId, string Permission);
    private sealed record CreateCredential(string Name, IntegrationCredentialPurpose Purpose, DateTimeOffset ExpiresAtUtc, IReadOnlyList<Grant> Grants, string? Resource, IReadOnlyList<string> InstancePermissions);
    private sealed record CredentialSecret(string CredentialId, string PublicId, string TokenPrefix, string Secret, DateTimeOffset ExpiresAtUtc);
    private sealed record CredentialSummary(string Id, string PublicId, string TokenPrefix, string Name, IntegrationCredentialPurpose Purpose, string? Resource, DateTimeOffset CreatedAtUtc, DateTimeOffset ExpiresAtUtc, DateTimeOffset? RevokedAtUtc, DateTimeOffset? LastUsedAtUtc, IReadOnlyList<Grant> Grants, IReadOnlyList<string> InstancePermissions);
}
