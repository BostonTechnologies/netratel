@page "/tenants"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IDisposable

@using System.Net
@using MudBlazor
@using NetRatel.Shared.Contracts
@using NetRatel.Shared.Contracts.Monitoring
@using NetRatel.Shared.Contracts.Requests
@using NetRatel.Web.Components.Dialogs
@using NetRatel.Web.Components.Shared.Navigation
@using NetRatel.Web.Services.Tenants
@using NetRatel.Web.Services.Monitoring
@using NetRatel.Web.Services.Authentication

@inject ITenantApiService TenantApi
@inject IMonitoringApiService MonitoringApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>Tenants · Fleet</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <div class="mb-3"><WorkspaceHeader Area="WorkspaceArea.Fleet" /></div>
    @if (IsScopedEntry || _profileListUnavailable)
    {
        <MudPaper Class="pa-3">
            @if (_isLoading)
            {
                <p role="status">Checking metrics access…</p>
            }
            else if (_metricsError is not null)
            {
                <MudAlert Severity="Severity.Warning">@_metricsError</MudAlert>
            }
            else if (IsScopedEntry && _scopedTenant is { } tenant)
            {
                <MudButton OnClick="OpenScopedDialogAsync">Edit Tenant · @tenant.Name</MudButton>
            }
            else if (_metricsTenants.Count == 0)
            {
                <p>No tenants with metrics management access are listed.</p>
            }
            else
            {
                <MudList T="int">
                    @foreach (var item in _metricsTenants)
                    {
                        <MudListItem T="int" Href="@($"/tenants?editTenant={item.TenantId}&tab=metrics")"
                                     aria-label="@($"Edit Tenant metrics for {item.Name}")">@item.Name · Edit Metrics</MudListItem>
                    }
                </MudList>
            }
            @if (IsScopedEntry)
            {
                <MudButton Href="/tenants">Back to Tenants</MudButton>
            }
        </MudPaper>
    }
    else
    {
    <MudStack Spacing="3">
        <MudPaper Class="pa-3">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap" Spacing="2">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search tenant, domain, contact, or location"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="tenants-search" />

                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AddBusiness" OnClick="OpenAddDialogAsync">Add Tenant</MudButton>
                    <MudChip T="string" Variant="@GetFilterVariant(string.IsNullOrWhiteSpace(_searchText))" Color="Color.Primary">
                        @FilteredTenants.Count result@(FilteredTenants.Count == 1 ? string.Empty : "s")
                    </MudChip>
                    @if (!string.IsNullOrWhiteSpace(_searchText))
                    {
                        <MudButton Variant="Variant.Text" OnClick="@(() => _searchText = string.Empty)">Clear</MudButton>
                    }
                </MudStack>
            </MudStack>

            @if (_isLoading)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="py-6">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText>Loading tenants...</MudText>
                </MudStack>
            }
            else if (FilteredTenants.Count == 0)
            {
                <MudPaper Class="tenant-empty-state pa-6 mt-4" Outlined="true">
                    <MudText Typo="Typo.h6">No tenants match this view</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Try a broader search, or add a new tenant to get started.
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudTable Items="@FilteredTenants"
                          Hover="true"
                          Dense="true"
                          Breakpoint="Breakpoint.Md"
                          Elevation="0"
                          Class="tenant-table mt-4">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Tenant</MudTh>
                        <MudTh>Location</MudTh>
                        <MudTh>Contact</MudTh>
                        <MudTh>Domains</MudTh>
                        <MudTh>Updated</MudTh>
                        <MudTh Class="text-right">Actions</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="ID">
                            <MudChip T="int" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                @context.TenantId
                            </MudChip>
                        </MudTd>

                        <MudTd DataLabel="Tenant">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">@context.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(string.IsNullOrWhiteSpace(context.Description) ? "No description" : context.Description)
                                </MudText>
                                <MudText Typo="Typo.caption" Style="overflow-wrap: anywhere;" data-testid="tenant-update-policy-summary">
                                    Updates @(context.AutoUpdate ? "on" : "off") · @(context.AutoUpdateChannel == "prerelease" ? "Prereleases allowed" : "Stable only") · @(string.IsNullOrWhiteSpace(context.AutoUpdateTargetVersion) ? "No pin" : $"Pinned: {context.AutoUpdateTargetVersion}")
                                </MudText>
                            </MudStack>
                        </MudTd>

                        <MudTd DataLabel="Location">
                            <MudText Typo="Typo.body2">@(context.Location ?? "Unspecified")</MudText>
                        </MudTd>

                        <MudTd DataLabel="Contact">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">@(context.ContactPerson ?? "No contact")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.ContactEmail ?? "No email")</MudText>
                            </MudStack>
                        </MudTd>

                        <MudTd DataLabel="Domains">
                            <div class="tenant-domain-wrap">
                                @if (context.Domains is { Count: > 0 })
                                {
                                    @foreach (var domain in context.Domains)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                            @domain
                                        </MudChip>
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">No domains</MudText>
                                }
                            </div>
                        </MudTd>

                        <MudTd DataLabel="Updated">
                            <MudText Typo="Typo.body2">@context.UpdatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</MudText>
                        </MudTd>

                        <MudTd DataLabel="Actions" Class="text-right">
                            <MudMenu Dense="true"
                                     AriaLabel="@($"Manage {context.Name}")"
                                     Variant="Variant.Text"
                                     Color="Color.Default"
                                     Icon="@Icons.Material.Filled.MoreHoriz"
                                     AnchorOrigin="Origin.TopRight"
                                     TransformOrigin="Origin.TopRight">
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialogAsync(context))">
                                    Edit Tenant
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Devices" OnClick="@(() => OpenAgents(context))">
                                    View Agents
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.VpnKey" OnClick="@(() => OpenEnrollmentCodes(context))">
                                    Enrollment Codes
                                </MudMenuItem>
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.DeleteForever"
                                             Class="tenant-delete-action"
                                             OnClick="@(() => ConfirmDeleteAsync(context))">
                                    Delete Tenant
                                </MudMenuItem>
                            </MudMenu>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudStack>
    }
</MudContainer>

<style>
    .tenants-search {
        min-width: min(100%, 420px);
    }

    .tenant-empty-state {
        border-radius: var(--netratel-radius-surface, 7px);
        text-align: center;
        background: var(--mud-palette-surface);
    }

    .tenant-table .mud-table-head th {
        font-size: 0.76rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        opacity: 0.74;
    }

    .tenant-table .mud-table-body td {
        vertical-align: top;
        padding-top: 0.95rem;
        padding-bottom: 0.95rem;
    }

    .tenant-domain-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        max-width: 28rem;
    }

    .tenant-delete-action {
        color: var(--mud-palette-error);
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "editTenant")] public string? EditTenant { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private List<TenantDto> _tenants = new();
    private bool _isLoading = true;
    private string _searchText = string.Empty;
    private bool _profileListUnavailable, _initialized, _openScoped;
    private IReadOnlyList<MonitoringTenantDto> _metricsTenants = [];
    private string? _requestedTenant, _metricsError;
    private MonitoringTenantDto? _scopedTenant;
    private IDialogReference? _scopedDialog;
    private CancellationTokenSource? _scope;
    private bool IsScopedEntry => EditTenant is not null && string.Equals(Tab, "metrics", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<TenantDto> FilteredTenants =>
        _tenants
            .Where(MatchesSearch)
            .OrderBy(x => x.Name)
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        _searchText = Search ?? string.Empty;
        var requested = IsScopedEntry ? EditTenant : null;
        if (_initialized && requested == _requestedTenant) return;
        _initialized = true;
        _requestedTenant = requested;
        EndScope();
        _scope = new();
        _metricsError = null;
        _tenants = [];
        _scopedTenant = null;
        _openScoped = false;
        if (IsScopedEntry) await LoadScopedTenantAsync(_scope.Token);
        else await LoadTenantsAsync();
    }

    private async Task LoadScopedTenantAsync(CancellationToken token)
    {
        _isLoading = true;
        try
        {
            if (!int.TryParse(EditTenant, out var tenantId) || tenantId <= 0 ||
                await ReadPermissionsAsync(tenantId, token) is not { CanManage: true })
            {
                if (!token.IsCancellationRequested) _metricsError = "Metrics management is unavailable for this tenant.";
                return;
            }
            if (token.IsCancellationRequested) return;

            // The directory only returns monitoring.read tenants. A manage-only operator can use a known ID.
            _scopedTenant = _metricsTenants.FirstOrDefault(item => item.TenantId == tenantId) ?? new(tenantId, $"Tenant #{tenantId}");
            _openScoped = true;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (Exception error) when (error is HttpRequestException or System.Text.Json.JsonException)
        {
            if (!token.IsCancellationRequested) _metricsError = "Could not verify metrics access for this tenant.";
        }
        finally { if (!token.IsCancellationRequested) _isLoading = false; }
    }

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        _openScoped ? OpenScopedDialogAsync() : Task.CompletedTask;

    private async Task OpenScopedDialogAsync()
    {
        _openScoped = false;
        if (_scopedTenant is not { } tenant || _scope is null || _scopedDialog is not null) return;
        var token = _scope.Token;
        var dialog = await DialogService.ShowAsync<TenantEditorDialog>("Edit Tenant", new DialogParameters<TenantEditorDialog>
        {
            { editor => editor.DialogTitle, $"Edit {tenant.Name}" },
            { editor => editor.ScopedMetricsTenant, tenant }
        }, BuildDialogOptions());
        if (token.IsCancellationRequested) { dialog.Close(); return; }
        _scopedDialog = dialog;
        await dialog.Result;
        if (!token.IsCancellationRequested) _scopedDialog = null;
    }

    private async Task LoadTenantsAsync()
    {
        if (_scope is null || IsScopedEntry) return;
        var token = _scope.Token;
        _isLoading = true;
        try
        {
            var tenants = await TenantApi.GetTenantsAsync(token);
            if (token.IsCancellationRequested) return;
            _tenants = tenants.ToList();
            _profileListUnavailable = false;
        }
        catch (HttpRequestException error) when (error.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized)
        {
            if (token.IsCancellationRequested) return;
            _profileListUnavailable = true;
            await LoadMetricsDirectoryAsync(token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested) Snackbar.Add($"Failed to load tenants: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadMetricsDirectoryAsync(CancellationToken token)
    {
        _metricsTenants = [];
        try
        {
            var directory = await MonitoringApi.GetTenantsAsync(token);
            var managed = new List<MonitoringTenantDto>();
            foreach (var batch in directory.Chunk(8))
            {
                if (token.IsCancellationRequested) return;
                var permissions = await Task.WhenAll(batch.Select(tenant => ReadPermissionsAsync(tenant.TenantId, token)));
                managed.AddRange(batch.Where((_, index) => permissions[index]?.CanManage == true));
            }
            if (!token.IsCancellationRequested) _metricsTenants = managed.OrderBy(tenant => tenant.Name).ToList();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (Exception error) when (error is HttpRequestException or System.Text.Json.JsonException)
        {
            if (!token.IsCancellationRequested) _metricsError = "Could not load the monitoring tenant directory.";
        }
    }

    private async Task<MonitoringPermissionsDto?> ReadPermissionsAsync(int tenantId, CancellationToken token)
    {
        try
        {
            var permissions = await MonitoringApi.GetPermissionsAsync(tenantId, token);
            return permissions.TenantId == tenantId ? permissions : null;
        }
        catch (HttpRequestException error) when (error.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized)
        {
            return null;
        }
    }

    private void EndScope()
    {
        _scope?.Cancel();
        _scope?.Dispose();
        _scope = null;
        _scopedDialog?.Close();
        _scopedDialog = null;
    }

    public void Dispose() => EndScope();

    private async Task OpenAddDialogAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(TenantEditorDialog.DialogTitle)] = "Add Tenant",
            [nameof(TenantEditorDialog.IsEditMode)] = false
        };

        var result = await DialogService.ShowAsync<TenantEditorDialog>(
            "Add Tenant",
            parameters,
            BuildDialogOptions());

        var dialogResult = await result.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not CreateTenantRequest request)
        {
            return;
        }

        try
        {
            await TenantApi.CreateTenantAsync(request);
            Snackbar.Add("Tenant created.", Severity.Success);
            await LoadTenantsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create tenant: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenEditDialogAsync(TenantDto tenant)
    {
        var parameters = new DialogParameters
        {
            [nameof(TenantEditorDialog.DialogTitle)] = $"Edit {tenant.Name}",
            [nameof(TenantEditorDialog.Tenant)] = tenant,
            [nameof(TenantEditorDialog.IsEditMode)] = true
        };

        var result = await DialogService.ShowAsync<TenantEditorDialog>(
            "Edit Tenant",
            parameters,
            BuildDialogOptions());

        var dialogResult = await result.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not CreateTenantRequest request)
        {
            return;
        }

        try
        {
            await TenantApi.UpdateTenantAsync(tenant.TenantId, new UpdateTenantRequest
            {
                Name = request.Name,
                Description = request.Description,
                Location = request.Location,
                Domains = request.Domains,
                ContactPerson = request.ContactPerson,
                ContactEmail = request.ContactEmail,
                AutoUpdate = request.AutoUpdate,
                AutoUpdateChannel = request.AutoUpdateChannel,
                // Null retains the existing pin in the partial-update API; an empty
                // value explicitly clears it and is normalized to null by the service.
                AutoUpdateTargetVersion = request.AutoUpdateTargetVersion ?? string.Empty,
                ExpectedVersion = tenant.Version
            });

            Snackbar.Add("Tenant updated.", Severity.Success);
            await LoadTenantsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update tenant: {ex.Message}", Severity.Error);
        }
    }

    private readonly HashSet<int> _deletingTenants = [];

    private async Task ConfirmDeleteAsync(TenantDto tenant)
    {
        if (!_deletingTenants.Add(tenant.TenantId)) return;
        try
        {
        var result = await DialogService.ShowMessageBoxAsync(
            title: "Delete Tenant",
            message: $"Delete {tenant.Name}? Enrollment and service credentials are revoked; archived prompts and audit history are retained. Decommission clients and disconnect active named connections first.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small });

        if (result != true)
        {
            return;
        }

        try
        {
            await TenantApi.DeleteTenantAsync(tenant.TenantId, tenant.Version);
            Snackbar.Add("Tenant deleted.", Severity.Success);
            await LoadTenantsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete tenant: {ex.Message}", Severity.Error);
        }
        }
        finally { _deletingTenants.Remove(tenant.TenantId); }
    }

    private void OpenAgents(TenantDto tenant) => Nav.NavigateTo($"/tenants/{tenant.TenantId}/agents");

    private void OpenEnrollmentCodes(TenantDto tenant) => Nav.NavigateTo($"/tenants/{tenant.TenantId}/enrollment");

    private bool MatchesSearch(TenantDto tenant)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            return true;
        }

        var search = _searchText.Trim();
        return Contains(tenant.Name, search)
            || Contains(tenant.Description, search)
            || Contains(tenant.Location, search)
            || Contains(tenant.ContactPerson, search)
            || Contains(tenant.ContactEmail, search)
            || tenant.TenantId.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
            || tenant.Domains.Any(domain => Contains(domain, search));
    }

    private static bool Contains(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static DialogOptions BuildDialogOptions() => new()
    {
        CloseOnEscapeKey = false,
        BackdropClick = false,
        CloseOnNavigation = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Medium
    };

    private static Variant GetFilterVariant(bool isPrimary) => isPrimary ? Variant.Filled : Variant.Outlined;
}
