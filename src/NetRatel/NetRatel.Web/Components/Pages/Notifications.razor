        => highlightedNotificationIds.Contains(dto.Id)
            ? "notification-row-clickable notification-row-live"
            : "notification-row-clickable";

    private static Dictionary<string, object> GetCellAttributes(NetRatelNotificationDto dto)
        => new()
        {
            ["data-notification-id"] = dto.Id.ToString()
        };

    private static Color SeverityColor(NetRatelNotificationSeverity severity) => severity switch
    {
        NetRatelNotificationSeverity.Critical => Color.Error,
        NetRatelNotificationSeverity.Error => Color.Error,
        NetRatelNotificationSeverity.Warning => Color.Warning,
