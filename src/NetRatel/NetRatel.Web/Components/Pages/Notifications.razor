    };

    private static string? ShortId(string? value, int head = 10, int tail = 6)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        if (value.Length <= head + tail + 3)
            return value;

        return $"{value[..head]}...{value[^tail..]}";
    }

    private static string FriendlyEvent(string eventType)
    {
        if (string.IsNullOrWhiteSpace(eventType))
            return "-";

        var normalized = eventType.StartsWith("DomainEvent.", StringComparison.OrdinalIgnoreCase)
            ? eventType["DomainEvent.".Length..]
            : eventType;

        var parts = normalized.Split('.', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (parts.Count > 1 && string.Equals(parts[0], "Orchestration", StringComparison.OrdinalIgnoreCase))
            parts.RemoveAt(0);

        for (var i = 0; i < parts.Count; i++)
            parts[i] = Regex.Replace(parts[i], "(?<!^)([A-Z])", " $1");

        return string.Join(" ", parts);
    }

    private static bool CanRetryEvent(NetRatelNotificationDto notification)
        => IsCallbackReplayEvent(notification)
            || string.Equals(notification.Status, "Failed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(notification.Status, "Disabled", StringComparison.OrdinalIgnoreCase);

    private static bool IsCallbackReplayEvent(NetRatelNotificationDto notification)
        => string.Equals(notification.EventType, "DomainEvent.Orchestration.ExternalServiceCallbackFailed", StringComparison.Ordinal)
            || string.Equals(notification.EventType, "DomainEvent.Orchestration.ExternalServiceCallbackRejected", StringComparison.Ordinal);

    private static string GetRetryLabel(NetRatelNotificationDto notification)
        => IsCallbackReplayEvent(notification) ? "Replay Callback" : "Retry";

    private async Task CopyToClipboardAsync(string value, string _)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
    }

    private static NotificationDetailView MapDetail(NetRatelNotificationDto notification)
    {
        var rawJson = string.IsNullOrWhiteSpace(notification.PayloadJson)
            ? (notification.Message ?? string.Empty)
            : notification.PayloadJson;

        var structuredFields = new List<KeyValuePair<string, string>>();
        if (!string.IsNullOrWhiteSpace(rawJson))
        {
            try
            {
                using var doc = JsonDocument.Parse(rawJson);
                if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    foreach (var property in doc.RootElement.EnumerateObject())
                    {
                        var value = property.Value.ValueKind switch
                        {
                            JsonValueKind.String => property.Value.GetString(),
                            JsonValueKind.Number => property.Value.GetRawText(),
                            JsonValueKind.True => "true",
                            JsonValueKind.False => "false",
                            JsonValueKind.Null => null,
                            _ => property.Value.GetRawText()
                        };

                        if (!string.IsNullOrWhiteSpace(value))
                            structuredFields.Add(new KeyValuePair<string, string>(property.Name, value!));
                    }
                }
            }
            catch
            {
                // ignored
            }
        }

        return new NotificationDetailView(notification, rawJson, structuredFields);
    }

    public async ValueTask DisposeAsync()
    {
        searchDebounceCts?.Cancel();
        searchDebounceCts?.Dispose();
        NotificationStream.ConnectionChanged -= HandleStreamConnectionChanged;
        streamConnected = false;
        await NotificationStream.StopAsync();
    }

    private void HandleStreamConnectionChanged(bool connected)
    {
        streamConnected = connected;
        _ = InvokeAsync(StateHasChanged);
    }

    private sealed record NotificationDetailView(
        NetRatelNotificationDto Notification,
        string RawJson,
        List<KeyValuePair<string, string>> StructuredFields);
}
