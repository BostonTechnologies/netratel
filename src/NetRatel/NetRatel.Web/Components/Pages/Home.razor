@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using NetRatel.Shared.Contracts.Monitoring
@using NetRatel.Web.Services.Monitoring
@inject IMonitoringApiService MonitoringApi
@inject IOperationsDashboardApiService DashboardApi
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="dashboard-shell" data-testid="operations-dashboard">
    <header class="dashboard-toolbar">
        <MudText Typo="Typo.h5">Dashboard</MudText>
        <MudSelect T="int" Label="Tenant" Value="@_tenantId" ValueChanged="ChangeTenantAsync" Margin="Margin.Dense" Variant="Variant.Outlined" Class="dashboard-tenant" Disabled="@(_tenants.Count == 0)">
            @foreach (var tenant in _tenants) { <MudSelectItem T="int" Value="@tenant.TenantId">@tenant.Name</MudSelectItem> }
        </MudSelect>
        <div class="dashboard-toolbar-actions">
            <MudButton Size="Size.Small" Href="@MonitoringLink()" StartIcon="@Icons.Material.Filled.MonitorHeart" Disabled="@(_tenantId == 0)">Monitoring</MudButton>
            <MudTooltip Text="Refresh dashboard"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="@_loading" aria-label="Refresh dashboard" /></MudTooltip>
        </div>
    </header>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Class="dashboard-loading" aria-label="Loading dashboard" /> }
    @if (_tenantError is not null) { <MudAlert Severity="Severity.Error" Dense="true">@_tenantError <MudButton Size="Size.Small" OnClick="LoadTenantsAsync">Retry</MudButton></MudAlert> }
    @if (!_loading && _tenantError is null && _tenants.Count == 0) { <MudAlert Severity="Severity.Info" Dense="true">No tenant with monitoring access is available.</MudAlert> }
    @if (_tenantId > 0)
    {
        @if (_dashboardError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" data-testid="dashboard-data-error">
                @_dashboardError @if (_snapshot is not null) { <span>Showing the last successful update.</span> }
                <MudButton Size="Size.Small" OnClick="RefreshAsync" Disabled="@_loading">Retry</MudButton>
            </MudAlert>
        }
        <div class="dashboard-metrics" aria-label="Tenant operations counts">
            <MudPaper Outlined="true" Class="dashboard-metric"><MudText Typo="Typo.caption">Online clients</MudText><MudText Typo="Typo.h5" Color="Color.Success">@Count(_snapshot?.OnlineClients)</MudText></MudPaper>
            <MudPaper Outlined="true" Class="dashboard-metric"><MudText Typo="Typo.caption">Offline clients</MudText><MudText Typo="Typo.h5">@Count(_snapshot?.OfflineClients)</MudText></MudPaper>
            <MudPaper Outlined="true" Class="dashboard-metric"><MudText Typo="Typo.caption">Clients with firing alerts</MudText><MudText Typo="Typo.h5" Color="Color.Warning">@Count(_snapshot?.FiringClients)</MudText></MudPaper>
            <MudPaper Outlined="true" Class="dashboard-metric"><MudText Typo="Typo.caption">Active alert occurrences</MudText><MudText Typo="Typo.h5" Color="Color.Error">@Count(_snapshot?.ActiveOccurrences)</MudText></MudPaper>
        </div>
        <MudPaper Outlined="true" Class="dashboard-panel">
            <div class="dashboard-section-heading">
                <MudText Typo="Typo.h6">Clients with active alerts</MudText>
                <MudButton Size="Size.Small" Href="@MonitoringLink()" EndIcon="@Icons.Material.Filled.ArrowForward">View monitoring</MudButton>
            </div>
            @if (_snapshot is { } snapshot)
            {
                <div class="dashboard-state-counts">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Pending @snapshot.PendingSeries</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Unknown @snapshot.UnknownSeries</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Suppressed @snapshot.SuppressedOccurrences</MudChip>
                    <MudText Typo="Typo.caption">Tenant totals · acknowledged alerts remain active</MudText>
                </div>
                <MudTable T="OperationsAlertClientDto" Items="@snapshot.Clients" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Class="dashboard-table" data-testid="dashboard-alert-table">
                    <HeaderContent><MudTh>Client / host / reported IP</MudTh><MudTh>Highest severity</MudTh><MudTh>Active</MudTh><MudTh>Acknowledgement</MudTh><MudTh>State</MudTh><MudTh>Actions</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Client / host / reported IP"><ClientIdentity Identity="@context.Identity" /></MudTd>
                        <MudTd DataLabel="Highest severity"><MudChip T="string" Size="Size.Small" Color="@SeverityColor(context.HighestSeverity)" Variant="Variant.Outlined">@context.HighestSeverity</MudChip></MudTd>
                        <MudTd DataLabel="Active">@context.ActiveOccurrences</MudTd>
                        <MudTd DataLabel="Acknowledgement">@Acknowledgement(context)</MudTd>
                        <MudTd DataLabel="State">
                            <div class="dashboard-row-states">
                                @if (context.FiringOccurrences > 0) { <span>Firing @context.FiringOccurrences</span> }
                                @if (context.UnknownOccurrences > 0) { <span>Unknown @context.UnknownOccurrences</span> }
                                @if (context.SuppressedOccurrences > 0) { <span>Suppressed @context.SuppressedOccurrences</span> }
                                @if (context.FiringOccurrences == 0 && context.UnknownOccurrences == 0 && context.SuppressedOccurrences == 0) { <span>Recovery pending</span> }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Actions"><div class="dashboard-row-actions"><MudButton Size="Size.Small" Href="@MonitoringLink(context.AgentId)">Alerts</MudButton><MudButton Size="Size.Small" Href="@ClientLink(context.AgentId)">Client</MudButton></div></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2" Class="pa-4" data-testid="dashboard-no-alerts">No active alert occurrences in this tenant.</MudText></NoRecordsContent>
                </MudTable>
                <footer class="dashboard-table-footer">
                    <MudText Typo="Typo.caption">@PageRange(snapshot) · updated @FormatTime(snapshot.GeneratedAtUtc)</MudText>
                    <div><MudTooltip Text="Previous clients"><MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(_loading || snapshot.Page == 0)" OnClick="PreviousPageAsync" aria-label="Previous alerting clients" /></MudTooltip><MudTooltip Text="Next clients"><MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(_loading || (long)(snapshot.Page + 1) * snapshot.PageSize >= snapshot.AlertingClients)" OnClick="NextPageAsync" aria-label="Next alerting clients" /></MudTooltip></div>
                </footer>
            }
            else if (!_loading) { <MudText Typo="Typo.body2" Class="pa-3">Alert counts and clients are unavailable.</MudText> }
        </MudPaper>
        <MudPaper Outlined="true" Class="dashboard-panel dashboard-jobs">
            <div class="dashboard-section-heading"><MudText Typo="Typo.h6">Recent job runs</MudText><MudButton Size="Size.Small" Href="/jobs" EndIcon="@Icons.Material.Filled.ArrowForward">View jobs</MudButton></div>
            @if (_jobsError is not null) { <MudAlert Severity="Severity.Warning" Dense="true" data-testid="dashboard-jobs-error">@_jobsError @if (_jobsUpdatedAtUtc is { } jobsUpdated) { <span>Showing the update from @FormatTime(jobsUpdated).</span> }</MudAlert> }
            @if (_recentRuns is not null)
            {
                <MudTable T="OperationsRecentJobDto" Items="@_recentRuns" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Class="dashboard-table">
                    <HeaderContent><MudTh>Job</MudTh><MudTh>Client</MudTh><MudTh>Status</MudTh><MudTh>Started</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate><MudTd DataLabel="Job">@context.JobName</MudTd><MudTd DataLabel="Client"><ClientIdentity Identity="@context.ClientIdentity" /></MudTd><MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@RunColor(context.Status)" Variant="Variant.Outlined">@RunStatus(context.Status)</MudChip></MudTd><MudTd DataLabel="Started">@FormatTime(context.StartedAtUtc)</MudTd><MudTd><MudButton Size="Size.Small" Href="@($"/jobs/{context.JobId}/runs/{context.RunId}")">Details</MudButton></MudTd></RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2" Class="pa-3">No recent job runs in this tenant.</MudText></NoRecordsContent>
                </MudTable>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")] public int? InitialTenantId { get; set; }
    private IReadOnlyList<MonitoringTenantDto> _tenants = [];
    private int _tenantId;
    private int _page;
    private bool _loading = true;
    private OperationsDashboardDto? _snapshot;
    private IReadOnlyList<OperationsRecentJobDto>? _recentRuns;
    private DateTimeOffset? _jobsUpdatedAtUtc;
    private string? _tenantError;
    private string? _dashboardError;
    private string? _jobsError;
    private CancellationTokenSource? _request;
    private IJSObjectReference? _timeModule;
    private TimeZoneInfo _timeZone = TimeZoneInfo.Utc;
    private string _timeZoneName = "UTC";

    protected override Task OnInitializedAsync() => LoadTenantsAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _timeModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/operator-time.js");
            var zone = await _timeModule.InvokeAsync<string>("getTimeZone");
            _timeZone = TimeZoneInfo.FindSystemTimeZoneById(zone);
            _timeZoneName = zone;
            StateHasChanged();
        }
        catch (Exception exception) when (exception is JSException or TimeZoneNotFoundException or InvalidTimeZoneException) { }
    }

    private async Task LoadTenantsAsync()
    {
        _loading = true;
        _tenantError = null;
        try
        {
            _tenants = await MonitoringApi.GetTenantsAsync();
            var selected = _tenants.FirstOrDefault(tenant => tenant.TenantId == (_tenantId > 0 ? _tenantId : InitialTenantId)) ?? _tenants.FirstOrDefault();
            if (selected is not null) await ChangeTenantAsync(selected.TenantId);
        }
        catch (HttpRequestException) { _tenantError = "Tenant access could not be loaded. Retry to refresh the dashboard."; }
        finally { _loading = false; }
    }

    private async Task ChangeTenantAsync(int tenantId)
    {
        if (!_tenants.Any(tenant => tenant.TenantId == tenantId)) return;
        if (_tenantId != tenantId)
        {
            _request?.Cancel();
            _tenantId = tenantId; _page = 0; _snapshot = null; _recentRuns = null; _jobsUpdatedAtUtc = null;
            _dashboardError = null; _jobsError = null;
        }
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (_tenantId == 0) return;
        _request?.Cancel();
        _request?.Dispose();
        var request = _request = new CancellationTokenSource();
        var tenantId = _tenantId;
        var page = _page;
        _loading = true;
        await Task.WhenAll(LoadSummaryAsync(tenantId, page, request.Token), LoadJobsAsync(tenantId, request.Token));
        if (ReferenceEquals(request, _request)) _loading = false;
    }

    private async Task LoadSummaryAsync(int tenantId, int page, CancellationToken token)
    {
        try
        {
            var snapshot = await DashboardApi.GetAsync(tenantId, page, token);
            if (!token.IsCancellationRequested && _tenantId == tenantId) { _snapshot = snapshot; _dashboardError = null; }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (HttpRequestException exception)
        { if (!token.IsCancellationRequested && _tenantId == tenantId) _dashboardError = exception.Message; }
    }

    private async Task LoadJobsAsync(int tenantId, CancellationToken token)
    {
        try
        {
            var runs = await DashboardApi.GetJobsAsync(tenantId, token);
            if (!token.IsCancellationRequested && _tenantId == tenantId) { _recentRuns = runs; _jobsError = null; _jobsUpdatedAtUtc = DateTimeOffset.UtcNow; }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (HttpRequestException)
        { if (!token.IsCancellationRequested && _tenantId == tenantId) _jobsError = "Recent jobs are unavailable. Refresh to try again."; }
    }

    private Task PreviousPageAsync() { _page = Math.Max(0, (_snapshot?.Page ?? _page) - 1); return RefreshAsync(); }
    private Task NextPageAsync() { _page = (_snapshot?.Page ?? _page) + 1; return RefreshAsync(); }
    private string MonitoringLink(Guid? agentId = null) => $"/monitoring?tenantId={_tenantId}" + (agentId is null ? "" : $"&clientId={agentId:D}");
    private static string ClientLink(Guid agentId) => "/clients?search=" + Uri.EscapeDataString(agentId.ToString("D"));
    private static string Count(long? value) => value?.ToString("N0") ?? "—";
    private static string Acknowledgement(OperationsAlertClientDto client) => client.AcknowledgedOccurrences switch
    {
        0 => "Unacknowledged",
        var count when count == client.ActiveOccurrences => "All acknowledged",
        var count => $"{count} of {client.ActiveOccurrences} acknowledged"
    };
    private static string PageRange(OperationsDashboardDto snapshot) => snapshot.AlertingClients == 0 ? "0 clients" :
        $"{(long)snapshot.Page * snapshot.PageSize + 1}–{(long)snapshot.Page * snapshot.PageSize + snapshot.Clients.Length} of {snapshot.AlertingClients} clients";
    private static Color SeverityColor(MonitoringSeverity severity) => severity switch { MonitoringSeverity.Critical => Color.Error, MonitoringSeverity.Warning => Color.Warning, _ => Color.Info };
    private static Color RunColor(JobRunStatusDto status) => status switch { JobRunStatusDto.Running => Color.Info, JobRunStatusDto.Succeeded => Color.Success, JobRunStatusDto.Failed or JobRunStatusDto.TimedOut => Color.Error, _ => Color.Default };
    private static string RunStatus(JobRunStatusDto status) => status == JobRunStatusDto.TimedOut ? "Timed out" : status.ToString();
    private string FormatTime(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, _timeZone).ToString("yyyy-MM-dd HH:mm:ss zzz") + $" ({_timeZoneName})";
    public async ValueTask DisposeAsync()
    {
        _request?.Cancel(); _request?.Dispose();
        if (_timeModule is not null)
            try { await _timeModule.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
