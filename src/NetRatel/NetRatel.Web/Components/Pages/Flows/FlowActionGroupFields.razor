@using NetRatel.Shared.Contracts.Flows

<div class="flow-action-group" data-testid="flow-action-group">
    <p class="flow-help">Each alert runs every selected action. Completed actions keep their results while another target retries.</p>
    @foreach (var action in Node.Actions ?? [])
    {
        <fieldset @key="action.Id" class="flow-group-target" disabled="@Disabled" data-testid="flow-group-target">
            <legend>@KindLabel(action.Kind)</legend>
            <label>Action type<select value="@((int)action.Kind)" @onchange="e => ChangeKindAsync(action, e)" data-testid="flow-action-kind">
                @foreach (var kind in Enum.GetValues<FlowActionKind>()) { <option value="@((int)kind)">@KindLabel(kind)</option> }
            </select></label>
            <label>Notification or incident target<select value="@(action.ConnectorId?.ToString() ?? "")" @onchange="e => SelectTargetAsync(action, e)" data-testid="flow-action-target">
                <option value="">Choose an enabled target</option>
                @foreach (var target in Targets.Where(target => target.TenantId == TenantId && target.Kind == action.Kind &&
                    (target.Enabled && target.CanExecute || target.Id == action.ConnectorId)))
                {
                    <option value="@target.Id" disabled="@(!target.Enabled || !target.CanExecute)">@target.Name @(!target.Enabled || !target.CanExecute ? "(unavailable)" : "")</option>
                }
            </select></label>
            @if (SelectedTarget(action) is { } selected)
            {
                @if (selected.Enabled && selected.CanExecute && action.ConnectorRevision is { } revision && revision != selected.Revision)
                {
                    <p role="status">Target configuration changed. Use the updated target before publishing.</p>
                    <button type="button" @onclick="() => UpdateTargetAsync(action, selected)" data-testid="flow-action-use-updated-target">Use updated target</button>
                }
                else
                {
                    <p role="status">@(selected.Enabled && selected.CanExecute ? "Ready" : selected.UnavailableReason ?? "Target unavailable")</p>
                }
            }
            else
            {
                <p role="status">Configure and enable a @KindLabel(action.Kind) target to publish this action.</p>
            }
            <button type="button" @onclick="() => RemoveAsync(action.Id)" data-testid="flow-action-remove">Remove action</button>
        </fieldset>
    }
    <button type="button" disabled="@(Disabled || (Node.Actions?.Count ?? 0) >= FlowLimits.MaximumActionsPerGroup)" @onclick="AddAsync" data-testid="flow-action-add">Add action</button>
    <p class="flow-help">@(Node.Actions?.Count ?? 0) / @FlowLimits.MaximumActionsPerGroup actions</p>
    <button type="button" disabled="@Disabled" @onclick="ManageTargetsRequested" data-testid="flow-manage-notifications">Manage notification targets</button>
</div>

@code {
    [Parameter, EditorRequired] public FlowNodeDto Node { get; set; } = default!;
    [Parameter] public IReadOnlyList<FlowConnectorReferenceDto> Targets { get; set; } = [];
    [Parameter] public int TenantId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<FlowNodeDto> Changed { get; set; }
    [Parameter] public EventCallback ManageTargetsRequested { get; set; }

    public static string KindLabel(FlowActionKind kind) => kind switch
    { FlowActionKind.RatelDeskIncident => "RatelDesk incident", FlowActionKind.Discord => "Discord notification", FlowActionKind.Slack => "Slack notification", _ => "Unsupported action" };

    private FlowConnectorReferenceDto? SelectedTarget(FlowActionTargetDto action) => Targets.FirstOrDefault(target =>
        target.TenantId == TenantId && target.Kind == action.Kind && target.Id == action.ConnectorId);

    private Task ChangeKindAsync(FlowActionTargetDto action, ChangeEventArgs args) =>
        Enum.TryParse<FlowActionKind>(args.Value?.ToString(), out var kind) && Enum.IsDefined(kind)
            ? UpdateAsync(action with { Kind = kind, ConnectorId = null, ConnectorRevision = null, Name = null }) : Task.CompletedTask;

    private Task SelectTargetAsync(FlowActionTargetDto action, ChangeEventArgs args)
    {
        var target = Guid.TryParse(args.Value?.ToString(), out var id) ? Targets.FirstOrDefault(target => target.Id == id &&
            target.TenantId == TenantId && target.Kind == action.Kind && target.Enabled && target.CanExecute) : null;
        return UpdateTargetAsync(action, target);
    }

    private Task UpdateTargetAsync(FlowActionTargetDto action, FlowConnectorReferenceDto? target) =>
        UpdateAsync(action with { ConnectorId = target?.Id, ConnectorRevision = target is { Revision: > 0 } ? target.Revision : null, Name = target?.Name });

    private Task UpdateAsync(FlowActionTargetDto action) => Disabled ? Task.CompletedTask :
        Changed.InvokeAsync(Node with { Actions = (Node.Actions ?? []).Select(current => current.Id == action.Id ? action : current).ToArray() });

    private Task AddAsync()
    {
        if (Disabled || (Node.Actions?.Count ?? 0) >= FlowLimits.MaximumActionsPerGroup) return Task.CompletedTask;
        var target = Targets.FirstOrDefault(target => target.TenantId == TenantId && target.Enabled && target.CanExecute &&
            (Node.Actions ?? []).All(action => action.ConnectorId != target.Id));
        var action = new FlowActionTargetDto(Guid.NewGuid(), target?.Kind ?? FlowActionKind.Discord,
            target?.Id, target is { Revision: > 0 } ? target.Revision : null) { Name = target?.Name };
        return Changed.InvokeAsync(Node with { Actions = [.. (Node.Actions ?? []), action] });
    }

    private Task RemoveAsync(Guid actionId) => Disabled ? Task.CompletedTask :
        Changed.InvokeAsync(Node with { Actions = (Node.Actions ?? []).Where(action => action.Id != actionId).ToArray() });
}
