@using System.Globalization
@using NetRatel.Shared
@using NetRatel.Shared.Contracts.Flows
@using NetRatel.Shared.Contracts.Jobs
@using NetRatel.Web.Services.Flows

<section class="flow-execution-fields" data-testid="flow-execution-action-fields">
@if (Node.Kind == FlowNodeKind.RerunOriginalExecution)
{
    var rerun = Node.Rerun ?? new FlowRerunSettingsDto();
    <p>Rerun the original supported execution using its trusted pinned definition, inputs and endpoint. Other requests return Unsupported. Success requires its committed terminal result.</p>
    <fieldset disabled="@Disabled">
        <label>Maximum linked reruns<input type="number" min="1" max="@FlowGraphV2Limits.MaximumRecoveryAttempts" value="@rerun.MaximumAttempts" @onchange="SetReruns" data-testid="flow-rerun-budget" /></label>
        <label>Maximum wait (minutes)<input type="number" min="1" max="@FlowGraphV2Limits.MaximumOperationMinutes" value="@rerun.TimeoutMinutes" @onchange="SetRerunTimeout" /></label>
    </fieldset>
}
else
{
    @if (Node.ExecutionAction is { } action)
    {
        <div class="flow-definition-summary" data-testid="flow-execution-definition-summary">
            <strong>@action.Definition.Name</strong>
            <span>Revision @(action.Definition.Revision ?? "not selected")</span>
            <small>@(action.PinnedSnapshotReference is null ? "Selected definition; pinned on publish" : "Published pinned definition")</small>
            <details><summary>Definition details</summary><p>Definition ID: @action.Definition.Id</p>
                <p>Content hash: @(action.Definition.ContentHash ?? "Unavailable")</p></details>
        </div>
        @if (!Disabled) { <button type="button" @onclick="() => _choosing = !_choosing" data-testid="flow-change-execution-definition">@(_choosing ? "Keep selection" : "Choose or update definition")</button> }
        <fieldset disabled="@Disabled">
            <label>Maximum wait (minutes)<input type="number" min="1" max="@FlowGraphV2Limits.MaximumOperationMinutes" value="@action.TimeoutMinutes" @onchange="SetTimeout" data-testid="flow-execution-timeout" /></label>
            @if (Node.Kind == FlowNodeKind.RunJob)
            {
                @if (action.JobTarget is { } jobTarget)
                {
                    <p data-testid="flow-job-target-policy"><strong>Job targets:</strong> @TargetPolicyName(jobTarget)</p>
                    @if (jobTarget.Source == JobTargetSource.RuntimeInput && jobTarget.RuntimeInput is { } runtime)
                    {
                        <FlowInputBindingField @key="@(Node.Id.ToString() + ":runtime-target")" NodeId="Node.Id"
                            Label="@("Target · " + TargetKindName(runtime.Kind))" DataType="TargetDataType(runtime.Kind)"
                            Value="@(action.TargetBinding?.Value)" ValueChanged="SetJobTargetBinding"
                            EventFields="TargetEventFields(runtime.Kind)" Producers="_producers" Disabled="Disabled" />
                        <p class="flow-execution-help">The mapped value is a typed literal target. A client ID from the source event identifies that event's client. All selected clients are checked when this action runs.</p>
                        @if (runtime.DefaultValues is { Count: > 0 })
                        { <p class="flow-execution-help">The job's saved target default applies when no mapping is selected.</p> }
                    }
                    else
                    {
                        <p class="flow-execution-help">Fresh actions resolve the job's current group or filter membership. An admitted action retains its original target plan.</p>
                    }
                    @if (action.JobExecutionPolicy is { } policy)
                    { <p>Thread Count @policy.ThreadCount · @(policy.NodeFailurePolicy == JobNodeFailurePolicy.StopRemaining ? "Stop starting remaining nodes after a node fails" : "Continue remaining nodes, then fail the run")</p> }
                    <NetRatel.Web.Components.Pages.Jobs.JobTargetPreview TenantId="TenantId" Target="jobTarget"
                        ExecutionPolicy="action.JobExecutionPolicy" RuntimeTarget="PreviewRuntimeTarget(action)"
                        Parameters="PreviewParameters()" Environment="@(action.Environment == ClientEnvironment.None ? action.JobTargetEnvironment : action.Environment)"
                        Disabled="Disabled" ButtonLabel="Preview pinned job targets" />
                }
                else
                {
                    <p data-testid="flow-job-bound-target"><strong>Job endpoint:</strong> @(action.Target is null ? "Bound endpoint not configured" : TargetName(action.Target))</p>
                    <p class="flow-execution-help">This job retains its configured tenant and endpoint.</p>
                }
            }
            else
            {
                <label>Endpoint<select value="@(action.Target is null ? "event" : "fixed")" @onchange="SetTargetMode" data-testid="flow-script-target-mode"><option value="event">Source event endpoint</option><option value="fixed">Fixed endpoint</option></select></label>
                @if (action.Target is not null)
                {
                    <p>Selected endpoint: @TargetName(action.Target)</p>
                    @if (!Disabled) { <FlowExecutionTargetPicker TenantId="TenantId" NodeId="Node.Id" SourceKind="FlowExecutionSourceKind.Script" Disabled="Disabled" Selected="SelectTarget" /> }
                }
                <label>Execution environment<select value="@((int)action.Environment)" @onchange="SetEnvironment"><option value="0">None specified</option><option value="1">Development</option><option value="2">Production</option><option value="3">Development and production</option></select></label>
                <label>Working directory (optional)<input value="@action.WorkingDirectory" maxlength="1024" @onchange="SetDirectory" /></label>
            }
        </fieldset>
        @if (action.Parameters is { Count: > 0 } parameters)
        {
            <h4>Inputs</h4>
            @foreach (var parameter in parameters)
            {
                var key = parameter.Name;
                <FlowInputBindingField @key="@(Node.Id.ToString() + ":" + key)" NodeId="Node.Id" Label="@(parameter.Name + (parameter.Required ? " · required" : ""))" DataType="parameter.DataType"
                    Value="@(Node.Inputs?.GetValueOrDefault(key))" ValueChanged="binding => SetInput(key, binding)"
                    EventFields="_eventFields" Producers="_producers" Disabled="Disabled" />
            }
        }
        else if (action.Parameters is null)
        {
            <p class="flow-execution-help">The input schema is unavailable. Choose the current authorized definition to review its parameters.</p>
            @if (Node.Inputs is { Count: > 0 } stored)
            {
                <details><summary>Stored mappings</summary>
                @foreach (var pair in stored)
                {
                    <FlowInputBindingField @key="@(Node.Id.ToString() + ":" + pair.Key)" NodeId="Node.Id" Label="@pair.Key" DataType="pair.Value.DataType"
                        Value="pair.Value" EventFields="_eventFields" Producers="_producers" Disabled="true" />
                }
                </details>
            }
        }
        else { <p class="flow-execution-help">The selected definition has an empty input schema.</p> }
        @if (UnknownInputs.Count > 0)
        {
            <p role="alert">These stored mappings are absent from the selected parameter schema. Review them before publishing.</p>
            @foreach (var key in UnknownInputs) { <p>@key <button type="button" @onclick="() => SetInput(key, null)" disabled="@Disabled">Remove mapping</button></p> }
        }
    }
    else { <p>Select an authorized @(Node.Kind == FlowNodeKind.RunJob ? "job" : "library script") definition.</p> }
    @if (!Disabled && (Node.ExecutionAction is null || _choosing))
    {
        <FlowExecutionDefinitionPicker @key="Node.Id" TenantId="TenantId" NodeId="Node.Id" SourceKind="Source" Disabled="Disabled" Selected="SelectDefinition" />
    }
}
@if (_error is not null) { <p role="alert">@_error</p> }
</section>

@code {
    [Parameter, EditorRequired] public FlowNodeDto Node { get; set; } = default!;
    [Parameter, EditorRequired] public FlowGraphDto Graph { get; set; } = default!;
    [Parameter] public int TenantId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<FlowNodeDto> Changed { get; set; }
    private Guid _node; private bool _choosing; private string? _error;
    private IReadOnlyList<FlowNodeDto> _producers = [];
    private IReadOnlyList<FlowBindingFieldDto> _eventFields = [];
    private FlowExecutionSourceKind Source => Node.Kind == FlowNodeKind.RunJob ? FlowExecutionSourceKind.Job : FlowExecutionSourceKind.Script;
    private IReadOnlyList<string> UnknownInputs => Node.ExecutionAction?.Parameters is { } parameters
        ? Node.Inputs?.Keys.Where(key => !parameters.Any(parameter => parameter.Name == key)).ToArray() ?? [] : [];
    protected override void OnParametersSet()
    {
        if (_node != Node.Id) { _node = Node.Id; _choosing = false; _error = null; }
        _producers = FlowAuthoringContext.AvailableProducers(Graph, Node.Id); _eventFields = FlowAuthoringContext.EventFields(Graph);
    }
    private static string TargetName(FlowExecutionTargetDto? target) => target is null ? "Source event endpoint" :
        target.AgentId is null ? "Choose a fixed endpoint" : target.DisplayName ?? target.HostName ?? "Endpoint metadata unavailable";
    private async Task SelectDefinition(FlowExecutionActionSettingsDto selected)
    {
        if (Disabled || selected.SourceKind != Source) return;
        var previous = Node.ExecutionAction;
        if (previous is not null) selected = selected with
        {
            TimeoutMinutes = previous.TimeoutMinutes, Environment = previous.Environment, WorkingDirectory = previous.WorkingDirectory,
            Target = Source == FlowExecutionSourceKind.Script ? previous.Target : selected.Target
        };
        if (selected.JobTarget is { Source: JobTargetSource.RuntimeInput, RuntimeInput: { } runtime })
        {
            var binding = previous?.TargetBinding?.Kind == runtime.Kind ? previous.TargetBinding :
                runtime.Kind == JobRuntimeTargetKind.ClientId ? new FlowJobTargetBindingDto(runtime.Kind,
                    new(FlowInputSource.Event, FlowDataType.Text, _eventFields.Any(field => field.Path == "alert.agentId")
                        ? "alert.agentId" : "event.target.agentId"), runtime.AllOf) : null;
            selected = selected with { TargetBinding = binding };
        }
        _choosing = false; _error = null;
        await Changed.InvokeAsync(Node with { ExecutionAction = selected with { PinnedSnapshotReference = null } });
    }
    private static string TargetPolicyName(JobTargetDefinition target) => target.Source switch
    {
        JobTargetSource.ExecutionGroup => "Execution group · all members at admission",
        JobTargetSource.ExplicitNodes => $"Selected nodes · {target.AgentIds?.Count ?? 0}",
        JobTargetSource.NodeFilter => "Node filter · " + target.Filter,
        JobTargetSource.RuntimeInput => "Provided at run time",
        _ => "Unsupported target policy"
    };
    private static string TargetKindName(JobRuntimeTargetKind kind) => kind switch
    {
        JobRuntimeTargetKind.ClientId => "Client ID", JobRuntimeTargetKind.ClientIds => "Client IDs",
        JobRuntimeTargetKind.Hostname => "Hostname", JobRuntimeTargetKind.Hostnames => "Hostnames",
        JobRuntimeTargetKind.Tag => "Tag", JobRuntimeTargetKind.Tags => "Tags", _ => "Target"
    };
    private static FlowDataType TargetDataType(JobRuntimeTargetKind kind) => FlowJobTargetBindingValues.DataType(kind);
    private static JobRuntimeTargetInput? PreviewRuntimeTarget(FlowExecutionActionSettingsDto action) =>
        action.TargetBinding is { Value.Source: FlowInputSource.Literal, Value.Literal: { } literal } binding &&
        FlowJobTargetBindingValues.TryCreate(binding, literal, out var target) ? target : null;
    private IReadOnlyDictionary<string, string[]> PreviewParameters()
    {
        var values = new Dictionary<string, string[]>(StringComparer.Ordinal);
        foreach (var pair in Node.Inputs ?? new Dictionary<string, FlowInputBindingDto>())
            if (pair.Value is { Source: FlowInputSource.Literal, Literal: { } value })
            {
                if (value.ValueKind == System.Text.Json.JsonValueKind.String) values[pair.Key] = [value.GetString()!];
                else if (value.ValueKind == System.Text.Json.JsonValueKind.Array && value.EnumerateArray().All(item => item.ValueKind == System.Text.Json.JsonValueKind.String))
                    values[pair.Key] = value.EnumerateArray().Select(item => item.GetString()!).ToArray();
            }
        return values;
    }
    private IReadOnlyList<FlowBindingFieldDto> TargetEventFields(JobRuntimeTargetKind kind) => kind is
        JobRuntimeTargetKind.ClientId or JobRuntimeTargetKind.ClientIds
        ? _eventFields.Where(field => field.Path is "alert.agentId" or "event.target.agentId").ToArray() : _eventFields;
    private Task SetJobTargetBinding(FlowInputBindingDto? value) => Node.ExecutionAction is { JobTarget.RuntimeInput: { } runtime } action
        ? SetAction(action with { TargetBinding = value is null ? null : new(runtime.Kind, value, runtime.AllOf) }) : Task.CompletedTask;
    private Task SetAction(FlowExecutionActionSettingsDto action) => Disabled ? Task.CompletedTask :
        Changed.InvokeAsync(Node with { ExecutionAction = action with { PinnedSnapshotReference = null } });
    private Task SetTargetMode(ChangeEventArgs args) => Node.ExecutionAction is { } action
        ? SetAction(action with { Target = args.Value?.ToString() == "fixed" ? action.Target ?? new(null) : null }) : Task.CompletedTask;
    private Task SelectTarget(FlowExecutionTargetDto target) => Node.ExecutionAction is { } action ? SetAction(action with { Target = target }) : Task.CompletedTask;
    private Task SetEnvironment(ChangeEventArgs args) => Node.ExecutionAction is { } action && int.TryParse(args.Value?.ToString(), out var value) && Enum.IsDefined((ClientEnvironment)value)
        ? SetAction(action with { Environment = (ClientEnvironment)value }) : Task.CompletedTask;
    private Task SetDirectory(ChangeEventArgs args) => Node.ExecutionAction is { } action
        ? SetAction(action with { WorkingDirectory = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value!.ToString() }) : Task.CompletedTask;
    private Task SetTimeout(ChangeEventArgs args)
    {
        if (Node.ExecutionAction is not { } action || !Minutes(args, out var minutes)) return Task.CompletedTask;
        return SetAction(action with { TimeoutMinutes = minutes });
    }
    private Task SetInput(string key, FlowInputBindingDto? binding)
    {
        if (Disabled) return Task.CompletedTask;
        var inputs = Node.Inputs?.ToDictionary(pair => pair.Key, pair => pair.Value) ?? [];
        if (binding is null) inputs.Remove(key); else inputs[key] = binding;
        return Changed.InvokeAsync(Node with { Inputs = inputs.Count == 0 ? null : inputs });
    }
    private bool Minutes(ChangeEventArgs args, out int minutes)
    {
        var valid = int.TryParse(args.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out minutes) && minutes is >= 1 and <= FlowGraphV2Limits.MaximumOperationMinutes;
        _error = valid ? null : $"Choose a wait between 1 and {FlowGraphV2Limits.MaximumOperationMinutes} minutes."; return valid;
    }
    private Task SetReruns(ChangeEventArgs args)
    {
        if (Disabled || !int.TryParse(args.Value?.ToString(), out var value) || value is < 1 or > FlowGraphV2Limits.MaximumRecoveryAttempts)
        { _error = $"Choose between 1 and {FlowGraphV2Limits.MaximumRecoveryAttempts} linked reruns."; return Task.CompletedTask; }
        return Changed.InvokeAsync(Node with { Rerun = (Node.Rerun ?? new()) with { MaximumAttempts = value } });
    }
    private Task SetRerunTimeout(ChangeEventArgs args) => !Disabled && Minutes(args, out var minutes)
        ? Changed.InvokeAsync(Node with { Rerun = (Node.Rerun ?? new()) with { TimeoutMinutes = minutes } }) : Task.CompletedTask;
}
