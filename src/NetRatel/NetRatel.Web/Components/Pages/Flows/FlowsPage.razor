@page "/flows"
@rendermode InteractiveServer
@attribute [Authorize]
@using NetRatel.Shared.Contracts.Flows
@using NetRatel.Web.Services.Flows
@implements IAsyncDisposable
@inject IFlowApiService Api
@inject IJSRuntime JS

<PageTitle>Flows</PageTitle>
<NavigationLock ConfirmExternalNavigation="@_dirty" OnBeforeInternalNavigation="BeforeNavigation" />
<main class="flows-page" data-testid="flows-page">
    <header class="flows-heading"><div><h1>Flows</h1><p>Build bounded incident workflows from monitoring alerts.</p></div>
        <label>Tenant<select @bind:get="_tenantId" @bind:set="TenantChosenAsync" disabled="@(_loadingTenants || _tenants.Count == 0)" data-testid="flow-tenant">
            @if (_tenantId == 0) { <option value="0" disabled>Choose an authorized tenant</option> }
            @foreach (var tenant in _tenants) { <option value="@tenant.TenantId">@tenant.TenantName</option> }
        </select></label>
        @if (_tenantId > 0) { <a href="@($"/flows/connectors?tenantId={_tenantId}")">RatelDesk connectors</a> }
    </header>
    @if (_pendingTenant is not null)
    {
        <div role="alert" class="flow-notice" data-testid="flow-tenant-unsaved">The draft has unsaved changes. Keep editing or discard them to change tenant.
            <button type="button" @onclick="() => _pendingTenant = null">Keep editing</button><button type="button" @onclick="DiscardTenantAsync" data-testid="flow-tenant-discard">Discard and change tenant</button>
        </div>
    }
    @if (_navigationBlocked) { <p role="alert" class="flow-notice">The draft has unsaved changes. Save it or use Close editor to discard before leaving.</p> }
    @if (_error is not null) { <div role="alert" class="flow-error" data-testid="flows-error">@_error<button type="button" @onclick="ReloadAsync" data-testid="flows-retry">Retry</button></div> }
    @if (_loadingTenants) { <p role="status">Loading authorized tenants…</p> }
    else if (_tenants.Count == 0) { <p role="status" data-testid="flows-no-access">No tenants grant access to Flows.</p> }
    else if (Access is null) { <p role="status" data-testid="flows-no-access">Choose an authorized tenant to view Flows.</p> }
    else if (_editorDefinition is not null)
    {
        <FlowEditor @key="(_editorDefinition.Id, _version?.Id)" Definition="_editorDefinition" TenantName="@Access!.TenantName" Connectors="_connectors"
            CanEdit="@(Access.CanEdit)" CanPublish="@(Access.CanPublish)" ReadOnly="@(_version is not null)" VersionNumber="@(_version?.VersionNumber ?? 0)"
            Saved="DefinitionSaved" Closed="CloseEditor" DirtyChanged="DirtyChanged" />
    }
    else
    {
        <div class="flows-toolbar">
            <label>Search flows<input @bind="_search" @bind:event="oninput" placeholder="Name or status" data-testid="flows-search" /></label>
            <button type="button" @onclick="ReloadAsync" disabled="@_busy" data-testid="flows-refresh">Refresh list</button>
            @if (Access?.CanEdit == true) { <button type="button" @onclick="() => _showCreate = !_showCreate" disabled="@_busy" data-testid="flows-new">New flow</button> }
        </div>
        @if (_showCreate)
        {
            <fieldset class="flow-create" disabled="@_busy"><legend>New flow</legend><label>Name<input @bind="_createName" maxlength="@FlowLimits.MaximumNameLength" data-testid="flow-create-name" /></label>
                <button type="button" @onclick="() => CreateAsync(true)" data-testid="flow-create-template">Create incident from alert template</button>
                <button type="button" @onclick="() => CreateAsync(false)" data-testid="flow-create-blank">Create blank draft</button>
                <button type="button" @onclick="() => _showCreate = false">Cancel</button>
            </fieldset>
        }
        @if (_clone is not null)
        {
            <fieldset class="flow-create" disabled="@_busy"><legend>Clone @_clone.Name</legend><label>New name<input @bind="_cloneName" maxlength="@FlowLimits.MaximumNameLength" data-testid="flow-clone-name" /></label>
                <button type="button" @onclick="CloneAsync" data-testid="flow-clone-confirm">Create independent draft</button><button type="button" @onclick="() => _clone = null">Cancel</button>
            </fieldset>
        }
        @if (_loading) { <p role="status">Loading flows…</p> }
        else if (FilteredFlows.Count == 0) { <p role="status" data-testid="flows-empty">@(_flows.Count == 0 ? "No flows in this tenant. Create a named template to begin." : "No flows match this search.")</p> }
        else
        {
            <table class="flows-table" data-testid="flows-table"><caption>Flows in @Access?.TenantName</caption><thead><tr><th>Name / tenant</th><th>Versions</th><th>State</th><th>Latest run</th><th>Actions</th></tr></thead><tbody>
                @foreach (var flow in FilteredFlows)
                {
                    <tr data-testid="flow-row" data-flow-id="@flow.Id"><td data-label="Name / tenant"><strong>@flow.Name</strong><span>@Access?.TenantName</span></td>
                        <td data-label="Versions">Draft revision @flow.Revision<span>@(flow.PublishedVersionNumber > 0 ? $"Published version {flow.PublishedVersionNumber}" : "Not published")</span></td>
                        <td data-label="State">@(flow.Enabled ? "Enabled" : "Disabled")</td>
                        <td data-label="Latest run">@(flow.LatestRun?.Status.ToString() ?? "No runs")<span>@(flow.LatestRun is null ? "" : flow.LatestRun.CreatedAtUtc.ToString("u"))</span></td>
                        <td data-label="Actions"><div class="flow-row-actions">
                            <button type="button" id="@($"flow-open-{flow.Id:N}")" @onclick="() => OpenEditorAsync(flow)" disabled="@_busy" data-testid="flow-edit">@(Access?.CanEdit == true ? "Edit" : "View draft")</button>
                            @if (Access?.CanEdit == true)
                            {
                                <button type="button" @onclick="() => BeginClone(flow)" disabled="@_busy" data-testid="flow-clone">Clone</button>
                                <button type="button" @onclick="() => SetEnabledAsync(flow)" disabled="@_busy" data-testid="flow-enabled">@(flow.Enabled ? "Disable" : "Enable")</button>
                            }
                            <button type="button" id="@($"flow-history-{flow.Id:N}")" @onclick="() => LoadHistoryAsync(flow)" disabled="@_busy" data-testid="flow-history">History</button>
                        </div></td>
                    </tr>
                }
            </tbody></table>
        }
        @if (_history is not null)
        {
            <section class="flow-history" data-testid="flow-history-panel"><header><h2>@_history.Name — history</h2><button type="button" @onclick="CloseHistory" data-testid="flow-history-close">Close history</button></header>
                <h3>Immutable published versions</h3>
                @if (_versions.Count == 0) { <p>No published versions.</p> }
                @foreach (var version in _versions) { <p>Version @version.VersionNumber · @version.PublishedAtUtc.ToString("u") · @version.PublishedBy <button type="button" id="@($"flow-version-{version.Id:N}")" @onclick="() => ViewVersionAsync(version)" data-testid="flow-view-version">View immutable graph</button></p> }
                <h3>Recent runs</h3>
                @if (_runs.Count == 0) { <p>No runs. Opening history does not execute a flow.</p> }
                @foreach (var run in _runs) { <p>@run.Status · @run.CreatedAtUtc.ToString("u") @run.Code <button type="button" @onclick="() => LoadRunAsync(run)" disabled="@_busy" data-testid="flow-run-detail">View result</button></p> }
                @if (_runDetail is not null)
                {
                    <div data-testid="flow-run-result"><h3>@_runDetail.Run.Status</h3><p>@_runDetail.Run.Code · @(_runDetail.Run.CompletedAtUtc?.ToString("u") ?? "Not completed")</p>
                        <p>@_runDetail.Input.RuleName · @_runDetail.Input.ClientName · @_runDetail.Input.Resource · @_runDetail.Input.Metric · @_runDetail.Input.Severity</p>
                        <p>Observed: @(_runDetail.Input.NumericValue?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? _runDetail.Input.ServiceState ?? "Unknown") at @_runDetail.Input.ObservedAtUtc.ToString("u")</p>
                        @foreach (var action in _runDetail.Actions) { <p>@action.Status · attempts @action.Attempts · @action.Code
                            @if (action.Receipt is { } receipt) { <span>Incident @receipt.IncidentId</span>@if (SafeReceiptLink(receipt.SafeLink) is { } link) { <a href="@link" target="_blank" rel="noopener noreferrer">Open incident</a> } }
                        </p> }
                    </div>
                }
            </section>
        }
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")] public int? RequestedTenantId { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public Guid? RequestedVersionId { get; set; }
    [SupplyParameterFromQuery(Name = "run")] public Guid? RequestedRunId { get; set; }
    private (int? Tenant, Guid? Version, Guid? Run) _processedQuery;
    private IReadOnlyList<FlowTenantAccessDto> _tenants = [];
    private IReadOnlyList<FlowDefinitionDto> _flows = [];
    private IReadOnlyList<FlowConnectorReferenceDto> _connectors = [];
    private IReadOnlyList<FlowVersionDto> _versions = [];
    private IReadOnlyList<FlowRunSummaryDto> _runs = [];
    private FlowDefinitionDto? _editorDefinition, _history, _clone;
    private FlowVersionDto? _version;
    private FlowRunDetailDto? _runDetail;
    private int _tenantId, _generation;
    private int? _pendingTenant;
    private string _search = "", _createName = "Incident from alert", _cloneName = "";
    private bool _loadingTenants = true, _loading, _busy, _disposed, _dirty, _showCreate, _navigationBlocked;
    private string? _error, _restoreFocus;
    private CancellationTokenSource _scope = new();
    private IJSObjectReference? _module;
    private FlowTenantAccessDto? Access => _tenants.FirstOrDefault(t => t.TenantId == _tenantId);
    private IReadOnlyList<FlowDefinitionDto> FilteredFlows => _flows.Where(f => _search.Length == 0 || f.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || (f.Enabled ? "Enabled" : "Disabled").Contains(_search, StringComparison.OrdinalIgnoreCase)).ToArray();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tenants = await Api.GetTenantsAsync(_scope.Token); if (_disposed) return;
            _tenants = tenants.Where(t => t.TenantId > 0).GroupBy(t => t.TenantId).Select(g => g.First()).ToArray();
            _tenantId = RequestedTenantId is { } requested ? _tenants.Any(t => t.TenantId == requested) ? requested : 0 : _tenants.FirstOrDefault()?.TenantId ?? 0;
            if (RequestedTenantId is not null && _tenantId == 0) _error = "The linked tenant does not grant Flows access. Choose an authorized tenant.";
        }
        catch (HttpRequestException) { _error = "Authorized Flows tenants could not be loaded. Retry when the API is available."; }
        catch (OperationCanceledException) when (_scope.IsCancellationRequested) { }
        finally { if (!_disposed) _loadingTenants = false; }
        if (_tenantId > 0) await ReloadAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        var query = (RequestedTenantId, RequestedVersionId, RequestedRunId);
        if (_processedQuery == query || _loadingTenants || _disposed) return;
        if (_dirty) { _navigationBlocked = true; return; }
        _processedQuery = query;
        if (RequestedTenantId is { } tenant && tenant != _tenantId)
        {
            if (!_tenants.Any(t => t.TenantId == tenant))
            { ResetScope(); _tenantId = 0; _flows = []; _error = "The linked tenant does not grant Flows access. Choose an authorized tenant."; return; }
            await ChangeTenantAsync(tenant);
            if (_processedQuery != query || _disposed) return;
        }
        // A new result link is a new read scope even when its tenant is unchanged.
        // Cancel the previous lookup and fence every late response before admitting the new one.
        ResetScope();
        if (Access is null) return;
        if (RequestedVersionId is null && RequestedRunId is null) return;
        if (RequestedTenantId is null || RequestedVersionId == Guid.Empty || RequestedRunId == Guid.Empty || RequestedVersionId is not null && RequestedRunId is not null)
        { _error = "A Flow result link needs one version or run and its authorized tenant."; return; }
        await ScopeCommandAsync(async (scopeTenant, generation, token) =>
        {
            if (query.RequestedVersionId is { } versionId)
            {
                var version = await Api.GetVersionAsync(scopeTenant, versionId, token);
                if (!Current(generation, scopeTenant) || version.TenantId != scopeTenant || version.Id != versionId) return;
                var flow = await Api.GetAsync(scopeTenant, version.FlowId, token);
                if (!Current(generation, scopeTenant) || flow.TenantId != scopeTenant || flow.Id != version.FlowId) return;
                var connectors = await Api.GetConnectorsAsync(scopeTenant, token); if (!Current(generation, scopeTenant)) return;
                _connectors = connectors.Where(c => c.TenantId == scopeTenant).ToArray(); _editorDefinition = flow with { Draft = version.Graph }; _version = version; _history = null; _dirty = false;
            }
            else if (query.RequestedRunId is { } runId)
            {
                var detail = await Api.GetRunByIdAsync(scopeTenant, runId, token);
                if (!Current(generation, scopeTenant) || detail.Run.Id != runId) return;
                var flow = await Api.GetAsync(scopeTenant, detail.Run.FlowId, token);
                if (!Current(generation, scopeTenant) || flow.TenantId != scopeTenant || flow.Id != detail.Run.FlowId) return;
                var version = await Api.GetVersionAsync(scopeTenant, detail.Run.FlowVersionId, token);
                if (!Current(generation, scopeTenant) || version.TenantId != scopeTenant || version.Id != detail.Run.FlowVersionId || version.FlowId != flow.Id) return;
                _editorDefinition = null; _version = null; _history = flow; _versions = [version]; _runs = [detail.Run]; _runDetail = detail;
            }
        });
    }
    private bool Current(int generation, int tenant) => !_disposed && generation == _generation && tenant == _tenantId;
    private async Task ScopeCommandAsync(Func<int, int, CancellationToken, Task> command)
    {
        if (_busy || _disposed || Access is null) return;
        var generation = _generation; var tenant = _tenantId; var token = _scope.Token;
        _busy = true; _error = null;
        try { await command(tenant, generation, token); }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (HttpRequestException exception) { if (Current(generation, tenant)) _error = exception is FlowApiException ? exception.Message : "The flow request failed. Retry when the API is available."; }
        catch (Exception) { if (Current(generation, tenant)) _error = "The flow could not be displayed. Retry or contact an administrator."; }
        finally { if (Current(generation, tenant)) _busy = false; }
    }
    private async Task ReloadAsync()
    {
        if (_tenantId == 0) { await OnInitializedAsync(); return; }
        await ScopeCommandAsync(async (tenant, generation, token) =>
        {
            _loading = true;
            try { var flows = await Api.ListAsync(tenant, token); if (Current(generation, tenant)) _flows = flows.Where(f => f.TenantId == tenant).OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase).ToArray(); }
            finally { if (Current(generation, tenant)) _loading = false; }
        });
    }
    private async Task TenantChosenAsync(int tenant)
    {
        if (tenant == _tenantId || !_tenants.Any(t => t.TenantId == tenant)) return;
        if (_dirty) { _pendingTenant = tenant; return; }
        await ChangeTenantAsync(tenant);
    }
    private Task DiscardTenantAsync() => _pendingTenant is { } tenant ? ChangeTenantAsync(tenant) : Task.CompletedTask;
    private void ResetScope()
    {
        _scope.Cancel(); _scope.Dispose(); _scope = new(); ++_generation;
        _connectors = []; _editorDefinition = null; _version = null; _history = null; _clone = null; _versions = []; _runs = []; _runDetail = null; _dirty = false;
        _pendingTenant = null; _busy = false; _error = null; _showCreate = false; _loading = false; _navigationBlocked = false;
    }
    private async Task ChangeTenantAsync(int tenant)
    {
        ResetScope(); _tenantId = tenant; _flows = [];
        await ReloadAsync();
    }
    private Task CreateAsync(bool template) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (Access?.CanEdit != true || string.IsNullOrWhiteSpace(_createName)) return;
        var flow = await Api.CreateAsync(tenant, new(_createName.Trim(), template), token);
        if (!Current(generation, tenant) || flow.TenantId != tenant) return;
        _flows = [.. _flows, flow]; _showCreate = false; await OpenEditorCoreAsync(flow, generation, token);
    });
    private Task OpenEditorAsync(FlowDefinitionDto flow) => ScopeCommandAsync(async (_, generation, token) =>
    {
        var latest = await Api.GetAsync(_tenantId, flow.Id, token);
        if (!Current(generation, flow.TenantId) || latest.TenantId != _tenantId || latest.Id != flow.Id) return;
        await OpenEditorCoreAsync(latest, generation, token);
    });
    private async Task OpenEditorCoreAsync(FlowDefinitionDto flow, int generation, CancellationToken token)
    {
        var connectors = await Api.GetConnectorsAsync(flow.TenantId, token);
        if (!Current(generation, flow.TenantId)) return;
        _connectors = connectors.Where(c => c.TenantId == flow.TenantId).ToArray(); _editorDefinition = flow; _version = null; _dirty = false; _history = null;
    }
    private Task DefinitionSaved(FlowDefinitionDto flow)
    {
        if (flow.TenantId == _tenantId && _editorDefinition?.Id == flow.Id) { _flows = _flows.Select(f => f.Id == flow.Id ? flow : f).ToArray(); _editorDefinition = flow; }
        return Task.CompletedTask;
    }
    private Task DirtyChanged(bool dirty) { _dirty = dirty; if (!dirty) _navigationBlocked = false; return Task.CompletedTask; }
    private Task CloseEditor()
    {
        _restoreFocus = _version is not null && _versions.Any(v => v.Id == _version.Id) && _history is not null ? $"flow-version-{_version.Id:N}" : _editorDefinition is null ? null : $"flow-open-{_editorDefinition.Id:N}";
        _editorDefinition = null; _version = null; _dirty = false; _pendingTenant = null; _navigationBlocked = false; return Task.CompletedTask;
    }
    private void BeginClone(FlowDefinitionDto flow) { _clone = flow; _cloneName = flow.Name.Length > 120 ? flow.Name[..120] + " copy" : flow.Name + " copy"; }
    private Task CloneAsync() => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (Access?.CanEdit != true || _clone is null || string.IsNullOrWhiteSpace(_cloneName)) return;
        var clone = await Api.CloneAsync(tenant, _clone.Id, new(_clone.Revision, _cloneName.Trim()), token);
        if (!Current(generation, tenant) || clone.TenantId != tenant) return;
        _clone = null; _flows = [.. _flows, clone]; await OpenEditorCoreAsync(clone, generation, token);
    });
    private Task SetEnabledAsync(FlowDefinitionDto flow) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (Access?.CanEdit != true) return;
        var saved = await Api.SetEnabledAsync(tenant, flow.Id, new(flow.Revision, !flow.Enabled), token);
        if (Current(generation, tenant) && saved.TenantId == tenant && saved.Id == flow.Id && saved.Revision > flow.Revision) _flows = _flows.Select(f => f.Id == flow.Id ? saved : f).ToArray();
    });
    private Task LoadHistoryAsync(FlowDefinitionDto flow) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        var versionsTask = Api.GetVersionsAsync(tenant, flow.Id, token);
        var runsTask = Api.GetRunsAsync(tenant, flow.Id, token);
        await Task.WhenAll(versionsTask, runsTask);
        if (!Current(generation, tenant)) return;
        _versions = (await versionsTask).Where(v => v.TenantId == tenant && v.FlowId == flow.Id).OrderByDescending(v => v.VersionNumber).ToArray();
        _runs = (await runsTask).Where(r => r.FlowId == flow.Id).ToArray(); _history = flow; _runDetail = null;
    });
    private Task LoadRunAsync(FlowRunSummaryDto run) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (_history is null) return; var flowId = _history.Id;
        var detail = await Api.GetRunAsync(tenant, flowId, run.Id, token);
        if (Current(generation, tenant) && _history?.Id == flowId && detail.Run.FlowId == flowId && detail.Run.Id == run.Id) _runDetail = detail;
    });
    private Task ViewVersionAsync(FlowVersionDto version) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (_history is null || version.TenantId != tenant || version.FlowId != _history.Id) return;
        var connectors = await Api.GetConnectorsAsync(tenant, token); if (!Current(generation, tenant)) return;
        _connectors = connectors.Where(c => c.TenantId == tenant).ToArray(); _editorDefinition = _history with { Draft = version.Graph }; _version = version; _dirty = false;
    });
    private void CloseHistory() { _restoreFocus = _history is null ? null : $"flow-history-{_history.Id:N}"; _history = null; _runDetail = null; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreFocus is not { } id) return; _restoreFocus = null;
        try { _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/flows-editor.js"); await _module.InvokeVoidAsync("focus", id); } catch (JSDisconnectedException) { }
    }
    private Task BeforeNavigation(LocationChangingContext context) { if (_dirty) { context.PreventNavigation(); _navigationBlocked = true; StateHasChanged(); } return Task.CompletedTask; }
    private static string? SafeReceiptLink(string? link) => Uri.TryCreate(link, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps ? uri.AbsoluteUri : null;
    public async ValueTask DisposeAsync() { _disposed = true; ++_generation; _scope.Cancel(); _scope.Dispose(); if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } }
}
