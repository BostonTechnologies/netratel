@page "/flows"
@rendermode InteractiveServer
@attribute [Authorize]
@using NetRatel.Shared.Contracts.Flows
@using NetRatel.Web.Services.Flows
@implements IAsyncDisposable
@inject IFlowApiService Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<FlowsPage> Logger

<PageTitle>Flows</PageTitle>
<main class="flows-page" data-testid="flows-page">
    <header class="flows-heading"><div><h1 id="flows-heading" tabindex="-1">Flows</h1><p>Build workflows from monitoring and committed execution outcomes.</p></div>
        <label>Tenant<select @bind:get="_tenantId" @bind:set="TenantChosenAsync" disabled="@(_loadingTenants || _tenants.Count == 0)" data-testid="flow-tenant">
            @if (_tenantId == 0) { <option value="0" disabled>Choose an authorized tenant</option> }
            @foreach (var tenant in _tenants) { <option value="@tenant.TenantId">@tenant.TenantName</option> }
        </select></label>
        @if (_tenantId > 0) { <a href="@($"/flows/connectors?tenantId={_tenantId}")">RatelDesk connectors</a> }
    </header>
    @if (_error is not null) { <div role="alert" class="flow-error" data-testid="flows-error">@_error<button type="button" @onclick="ReloadAsync" data-testid="flows-retry">Retry</button></div> }
    @if (_loadingTenants) { <p role="status">Loading authorized tenants…</p> }
    else if (_tenants.Count == 0) { <p role="status" data-testid="flows-no-access">No tenants grant access to Flows.</p> }
    else if (Access is null) { <p role="status" data-testid="flows-no-access">Choose an authorized tenant to view Flows.</p> }
    else if (_editorDefinition is not null)
    {
        <FlowEditor @ref="_editor" InitialSelectedNodeId="RequestedNodeId" @key="(_editorDefinition.Id, _version?.Id)" Definition="_editorDefinition" TenantName="@Access!.TenantName" Connectors="_connectors"
            CanEdit="@(Access.CanEdit)" CanPublish="@(Access.CanPublish)" SupportedDraftSchemas="_schemaCapabilities.SupportedDraftSchemas" ExecutableSchemas="_schemaCapabilities.ExecutableSchemas" ReadOnly="@(_version is not null)" VersionNumber="@(_version?.VersionNumber ?? 0)"
            RecordedRunId="_recordedRun?.Run.Id" RecordedTrace="_recordedRun?.Trace" RecordedConfigurationHash="@_version?.ConfigurationHash" RecordedDataUnavailableReason="@_recordedRun?.DataUnavailableReason"
            Saved="DefinitionSaved" Closed="CloseEditor" DirtyChanged="DirtyChanged" />
    }
    else
    {
        <div class="flows-toolbar">
            <MudTextField T="string" Value="_search" ValueChanged="SearchChangedAsync" Label="Search flow names" Placeholder="Name" Clearable="true" DebounceInterval="300" Immediate="true" MaxLength="128" id="flows-search" data-testid="flows-search" />
            <label>Enabled state<select value="@_query.Enabled" @onchange="EnabledFilterChangedAsync" data-testid="flows-enabled-filter">
                @foreach (var value in Enum.GetValues<FlowEnabledFilter>()) { <option value="@value">@value</option> }
            </select></label>
            <label>Publication<select value="@_query.Publication" @onchange="PublicationChangedAsync" data-testid="flows-publication-filter">
                @foreach (var value in Enum.GetValues<FlowPublicationFilter>()) { <option value="@value">@value</option> }
            </select></label>
            <MudButton OnClick="ClearQueryAsync" Disabled="@_busy">Clear all</MudButton>
            <MudTooltip Text="Refresh flows"><MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="ReloadAsync" Disabled="@_busy" aria-label="Refresh flows" data-testid="flows-refresh" /></MudTooltip>
            @if (Access?.CanEdit == true) { <MudButton OnClick="() => _showCreate = !_showCreate" Disabled="@_busy" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" data-testid="flows-new">New flow</MudButton> }
        </div>
        @if (_showCreate)
        {
            <fieldset class="flow-create" disabled="@_busy"><legend>New flow</legend><label>Name<input @bind="_createName" maxlength="@FlowLimits.MaximumNameLength" data-testid="flow-create-name" /></label>
                <button type="button" @onclick="() => CreateAsync(true)" data-testid="flow-create-template">Create incident from alert template</button>
                <button type="button" @onclick="() => CreateAsync(false)" data-testid="flow-create-blank">Create blank draft</button>
                <button type="button" @onclick="() => _showCreate = false">Cancel</button>
                <FlowTemplatePicker @key="_tenantId" TenantId="_tenantId" Disabled="@(_busy || Access?.CanEdit != true)" Selected="CreateFromTemplateAsync" />
            </fieldset>
        }
        @if (_clone is not null)
        {
            <fieldset class="flow-create" disabled="@_busy"><legend>Clone @_clone.Name</legend><label>New name<input @bind="_cloneName" maxlength="@FlowLimits.MaximumNameLength" data-testid="flow-clone-name" /></label>
                <button type="button" @onclick="CloneAsync" data-testid="flow-clone-confirm">Create independent draft</button><button type="button" @onclick="() => _clone = null">Cancel</button>
            </fieldset>
        }
        <div @ref="_resultsElement" class="flows-table-region" data-testid="flows-table-region">
            <MudTable @key="(_tenantId, _tableEpoch)" T="FlowSummaryDto" @ref="_table" ServerData="LoadPageAsync" Dense="true" Hover="true"
                RowClassFunc="@((flow, index) => "flow-row")" AllowUnsorted="false" FixedHeader="true" FixedFooter="true" Height="min(62vh, 700px)" Breakpoint="Breakpoint.None"
                RowsPerPage="_query.PageSize" CurrentPage="_query.PageIndex" Class="flows-table" data-testid="flows-table"
                aria-label="@($"Flows in {Access?.TenantName}")">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="FlowSummaryDto" SortLabel="Name" InitialDirection="@InitialSort(FlowSort.Name)">Name / tenant</MudTableSortLabel></MudTh>
                    <MudTh>Versions</MudTh><MudTh>State</MudTh>
                    <MudTh><MudTableSortLabel T="FlowSummaryDto" SortLabel="UpdatedAt" InitialDirection="@InitialSort(FlowSort.UpdatedAt)">Updated</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="FlowSummaryDto" SortLabel="LatestRunAt" InitialDirection="@InitialSort(FlowSort.LatestRunAt)">Latest run</MudTableSortLabel></MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate Context="flow">
                    <MudTd @key="flow.Id" DataLabel="Name / tenant"><strong class="flow-name" title="@flow.Name">@flow.Name</strong><span>@Access?.TenantName</span></MudTd>
                    <MudTd DataLabel="Versions">Draft revision @flow.Revision<span>@(flow.PublishedVersionNumber > 0 ? $"Published version {flow.PublishedVersionNumber}" : "Not published")</span></MudTd>
                    <MudTd DataLabel="State">@(flow.Enabled ? "Enabled" : "Disabled")</MudTd>
                    <MudTd DataLabel="Updated">@flow.UpdatedAtUtc.ToString("u")</MudTd>
                    <MudTd DataLabel="Latest run">@(flow.LatestRun is null ? "No runs" : RunStatusLabel(flow.LatestRun.Status))<span>@flow.LatestRun?.CreatedAtUtc.ToString("u")</span></MudTd>
                    <MudTd DataLabel="Actions"><div class="flow-row-actions" @key="flow.Id" data-flow-id="@flow.Id" @onclick:stopPropagation>
                        <MudTooltip Text="@(Access?.CanEdit == true ? "Edit flow" : "View draft")"><MudIconButton Icon="@(Access?.CanEdit == true ? Icons.Material.Outlined.Edit : Icons.Material.Outlined.Visibility)" id="@($"flow-open-{flow.Id:N}")" OnClick="() => OpenEditorAsync(flow)" Disabled="@_busy" aria-label="@($"{(Access?.CanEdit == true ? "Edit" : "View draft")} {flow.Name}")" data-testid="flow-edit" /></MudTooltip>
                        @if (Access?.CanEdit == true)
                        {
                            <MudTooltip Text="Clone flow"><MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" OnClick="() => BeginClone(flow)" Disabled="@_busy" aria-label="@($"Clone {flow.Name}")" data-testid="flow-clone" /></MudTooltip>
                            <FlowEnabledToggle @key="flow.Id" Enabled="flow.Enabled" Name="flow.Name" Disabled="@(_busy || _uncertain.Contains(flow.Id))" Requested="target => SetEnabledAsync(flow, target)" />
                        }
                        <MudTooltip Text="Flow history"><MudIconButton Icon="@Icons.Material.Outlined.History" id="@($"flow-history-{flow.Id:N}")" OnClick="() => LoadHistoryAsync(flow)" Disabled="@_busy" aria-label="@($"History for {flow.Name}")" data-testid="flow-history" /></MudTooltip>
                        @if (Access?.CanDelete == true)
                        {
                            <MudTooltip Text="Delete flow"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="() => _delete = flow" Disabled="@(_busy || _uncertain.Contains(flow.Id))" aria-label="@($"Delete {flow.Name}")" data-testid="flow-delete" /></MudTooltip>
                        }
                    </div></MudTd>
                </RowTemplate>
                <LoadingContent><MudText role="status">Loading flows…</MudText></LoadingContent>
                <NoRecordsContent>
                    @if (_queryError is not null) { <MudText role="alert">@_queryError Use Refresh to retry.</MudText> }
                    else { <MudText role="status" data-testid="flows-empty">No flows match this tenant and query.</MudText> }
                </NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="@(new[] { 20, 50, 100 })" InfoFormat="{first_item}–{last_item} of {all_items}" /></PagerContent>
            </MudTable>
        </div>
    }
</main>

<MudDialog Visible="@(_delete is not null)" VisibleChanged="visible => { if (!visible && !_busy) _delete = null; }" Options="HistoryDialogOptions" AriaLabel="Delete flow confirmation">
    <TitleContent><MudText Typo="Typo.h6">Delete flow</MudText></TitleContent>
    <DialogContent>
        @if (_delete is { } target)
        {
            <p>Delete <strong>@target.Name</strong> in @Access?.TenantName?</p>
            <p>Deletion stops future processing, disables this flow and frees its active slot. History remains under existing retention: normally 90 days, with protected unknown-delivery evidence. Unfinished work prevents deletion.</p>
            <p>Flow @target.Id · revision @target.Revision</p>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _delete = null" Disabled="@_busy" data-testid="flow-delete-cancel">Cancel</MudButton>
        <MudButton OnClick="DeleteAsync" Disabled="@_busy" Color="Color.Error" Variant="Variant.Filled" data-testid="flow-delete-confirm">Delete flow</MudButton>
    </DialogActions>
</MudDialog>
@{ var historyGeneration = _historyGeneration; }
<MudDialog @key="historyGeneration" Visible="@(_historyOpen && _editorDefinition is null)" VisibleChanged="@(visible => HistoryVisibleChanged(historyGeneration, visible))"
           DefaultFocus="DefaultFocus.None" Options="HistoryDialogOptions" AriaLabel="@($"Flow history: {_history?.Name}")"
           Style="width:min(1120px,calc(100vw - 32px));max-width:1120px;border-radius:16px;overflow:hidden"
           ContentClass="pa-0">
    <TitleContent>
        <div class="flow-history-heading">
            <div class="flow-history-symbol"><MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Large" /></div>
            <div class="flow-history-title"><span>FLOW HISTORY</span><h2 title="@_history?.Name">@_history?.Name @(_history?.DeletedAtUtc is null ? "" : "(Deleted flow)")</h2><p title="@Access?.TenantName"><span>@Access?.TenantName</span><span class="flow-history-subtitle"> · Published versions and execution results</span></p></div>
            <MudIconButton id="flow-history-dismiss" Icon="@Icons.Material.Filled.Close" OnClick="CloseHistory" aria-label="Close flow history" data-testid="flow-history-dismiss" />
        </div>
    </TitleContent>
    <DialogContent>
        @if (_history is { } history)
        {
            <FlowHistoryPanel Flow="history" TenantId="_tenantId" Versions="_versions" Runs="_runs" Detail="_runDetail" Loading="_historyLoading" RunLoading="_runLoading" Busy="_busy"
                              Error="@_historyError" BodyId="@HistoryBodyId(historyGeneration)" FocusTarget="@_historyFocusTarget"
                              Reload="ReloadHistoryAsync" ViewVersion="ViewVersionAsync" ViewRun="LoadRunAsync" ReplayRun="ReplayRunAsync" Back="BackToHistory" />
        }
    </DialogContent>
    <DialogActions>
        <div class="flow-history-footer"><span>Times shown in UTC</span><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseHistory" data-testid="flow-history-close">Close history</MudButton></div>
    </DialogActions>
</MudDialog>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")] public int? RequestedTenantId { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public Guid? RequestedVersionId { get; set; }
    [SupplyParameterFromQuery(Name = "run")] public Guid? RequestedRunId { get; set; }
    [SupplyParameterFromQuery(Name = "draftId")] public Guid? RequestedDraftId { get; set; }
    [SupplyParameterFromQuery(Name = "nodeId")] public Guid? RequestedNodeId { get; set; }
    [SupplyParameterFromQuery(Name = "search")] public string? RequestedSearch { get; set; }
    private FlowEditor? _editor;
    private static readonly FlowSchemaCapabilitiesDto LegacyCapabilities = new([FlowLimits.SchemaVersion], [FlowLimits.SchemaVersion]);
    private FlowSchemaCapabilitiesDto _schemaCapabilities = LegacyCapabilities;
    private (int? Tenant, Guid? Version, Guid? Run, Guid? Draft, Guid? Node, Guid? History) _processedQuery;
    private IReadOnlyList<FlowTenantAccessDto> _tenants = [];
    private MudTable<FlowSummaryDto>? _table;
    private FlowQueryDto _query = new();
    private TableData<FlowSummaryDto> _pageData = new() { Items = [], TotalItems = 0 };
    private long _readIdentity;
    private string? _queryError;
    private CancellationTokenSource? _readScope;
    private readonly HashSet<Guid> _uncertain = [];
    private FlowSummaryDto? _delete;
    private IReadOnlyList<FlowConnectorReferenceDto> _connectors = [];
    private IReadOnlyList<FlowVersionDto> _versions = [];
    private IReadOnlyList<FlowRunSummaryDto> _runs = [];
    private FlowDefinitionDto? _editorDefinition;
    private FlowSummaryDto? _history, _clone;
    private FlowVersionDto? _version;
    private FlowRunDetailDto? _runDetail, _recordedRun;
    private int _tenantId, _generation, _historyGeneration;
    private string _search = "", _createName = "Incident from alert", _cloneName = "";
    private bool _loadingTenants = true, _busy, _disposed, _dirty, _showCreate;
    private string? _error, _restoreFocus, _historyError, _historyFocusTarget;
    private bool _historyOpen, _historyLoading, _runLoading, _restoreHistoryFocus;
    private IJSObjectReference? _historyFocusModule;
    private static readonly DialogOptions HistoryDialogOptions = new()
    { FullWidth = true, MaxWidth = MaxWidth.Large, BackdropClick = false, CloseOnEscapeKey = true };
    private CancellationTokenSource _scope = new();
    private IJSObjectReference? _module, _resultsModule, _resultsObserver;
    private ElementReference _resultsElement;
    private bool _resultsUnavailable;
    private FlowTenantAccessDto? Access => _tenants.FirstOrDefault(t => t.TenantId == _tenantId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tenants = await Api.GetTenantsAsync(_scope.Token); if (_disposed) return;
            _tenants = tenants.Where(t => t.TenantId > 0).GroupBy(t => t.TenantId).Select(g => g.First()).ToArray();
            _tenantId = RequestedTenantId is { } requested ? _tenants.Any(t => t.TenantId == requested) ? requested : 0 : _tenants.FirstOrDefault()?.TenantId ?? 0;
            if (RequestedTenantId is not null && _tenantId == 0) _error = "The linked tenant does not grant Flows access. Choose an authorized tenant.";
        }
        catch (HttpRequestException) { _error = "Authorized Flows tenants could not be loaded. Retry when the API is available."; }
        catch (OperationCanceledException) when (_scope.IsCancellationRequested) { return; }
        finally { if (!_disposed) _loadingTenants = false; }

    }
    protected override async Task OnParametersSetAsync()
    {
        await ReadListParametersAsync();
        var query = (RequestedTenantId, RequestedVersionId, RequestedRunId, RequestedDraftId, RequestedNodeId, RequestedHistoryFlowId);
        if (_processedQuery == query || _loadingTenants || _disposed) return;
        if (_dirty) return;
        _processedQuery = query;
        if (RequestedTenantId is { } tenant && tenant != _tenantId)
        {
            if (!_tenants.Any(t => t.TenantId == tenant))
            { ResetScope(); _tenantId = 0; _pageData = new() { Items = [], TotalItems = 0 }; _error = "The linked tenant does not grant Flows access. Choose an authorized tenant."; return; }
            await ChangeTenantAsync(tenant);
            if (_processedQuery != query || _disposed) return;
        }
        // A new result link is a new read scope even when its tenant is unchanged.
        // Cancel the previous lookup and fence every late response before admitting the new one.
        if (RequestedVersionId is not null || RequestedRunId is not null || RequestedDraftId is not null || RequestedHistoryFlowId is not null) ResetScope();
        if (Access is null) return;
        if (RequestedDraftId is { } draftId)
        {
            if (RequestedTenantId is null || draftId == Guid.Empty || RequestedVersionId is not null || RequestedRunId is not null)
            { _error = "A Flow draft link needs its authorized tenant and one draft."; return; }
            await ScopeCommandAsync(async (tenant, generation, token) =>
            {
                var flow = await Api.GetAsync(tenant, draftId, token);
                if (!Current(generation, tenant) || flow.TenantId != tenant || flow.Id != draftId) return;
                await OpenEditorCoreAsync(flow, generation, token);
            });
            return;
        }
        if (RequestedHistoryFlowId is { } historyId && historyId != Guid.Empty)
        {
            var metadata = await Api.GetMetadataAsync(_tenantId, historyId, _scope.Token);
            await LoadHistoryAsync(metadata); return;
        }
        if (RequestedVersionId is null && RequestedRunId is null) return;
        if (RequestedTenantId is null || RequestedVersionId == Guid.Empty || RequestedRunId == Guid.Empty || RequestedVersionId is not null && RequestedRunId is not null)
        { _error = "A Flow result link needs one version or run and its authorized tenant."; return; }
        await ScopeCommandAsync(async (scopeTenant, generation, token) =>
        {
            if (query.RequestedVersionId is { } versionId)
            {
                var version = await Api.GetVersionAsync(scopeTenant, versionId, token);
                if (!Current(generation, scopeTenant) || version.TenantId != scopeTenant || version.Id != versionId) return;
                var flow = await Api.GetMetadataAsync(scopeTenant, version.FlowId, token);
                if (!Current(generation, scopeTenant) || flow.TenantId != scopeTenant || flow.Id != version.FlowId) return;
                var connectors = await Api.GetConnectorsAsync(scopeTenant, token); if (!Current(generation, scopeTenant)) return;
                _connectors = connectors.Where(c => c.TenantId == scopeTenant).ToArray(); _editorDefinition = HistoricalDefinition(flow, version.Graph); _version = version; _recordedRun = null; _history = null; _dirty = false;
            }
            else if (query.RequestedRunId is { } runId)
            {
                var detail = await Api.GetRunByIdAsync(scopeTenant, runId, token);
                if (!Current(generation, scopeTenant) || detail.Run.Id != runId) return;
                var flow = await Api.GetMetadataAsync(scopeTenant, detail.Run.FlowId, token);
                if (!Current(generation, scopeTenant) || flow.TenantId != scopeTenant || flow.Id != detail.Run.FlowId) return;
                var version = await Api.GetVersionAsync(scopeTenant, detail.Run.FlowVersionId, token);
                if (!Current(generation, scopeTenant) || version.TenantId != scopeTenant || version.Id != detail.Run.FlowVersionId || version.FlowId != flow.Id) return;
                _editorDefinition = null; _version = null; _recordedRun = null; BeginHistory(flow); _versions = [version]; _runs = [detail.Run]; _runDetail = detail;
            }
        });
    }
    private bool Current(int generation, int tenant) => !_disposed && generation == _generation && tenant == _tenantId;
    private async Task ScopeCommandAsync(Func<int, int, CancellationToken, Task> command, bool historyRequest = false)
    {
        if (_busy || _disposed || Access is null) return;
        var generation = _generation; var tenant = _tenantId; var token = _scope.Token;
        _busy = true; if (historyRequest) _historyError = null; else _error = null;
        try { await command(tenant, generation, token); }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (HttpRequestException exception) { if (Current(generation, tenant)) SetRequestError(historyRequest, exception is FlowApiException ? exception.Message : "The flow request failed. Retry when the API is available."); }
        catch (Exception) { if (Current(generation, tenant)) SetRequestError(historyRequest, "The flow could not be displayed. Retry or contact an administrator."); }
        finally { if (Current(generation, tenant)) _busy = false; }
    }
    private void SetRequestError(bool historyRequest, string error)
    {
        if (historyRequest) _historyError = error;
        else _error = error;
    }
    private async Task ReloadAsync()
    {
        _queryError = null; _error = null;
        if (_tenantId == 0) { await OnInitializedAsync(); return; }
        var tenant = _tenantId; var generation = _generation;
        try
        {
            var tenants = await Api.GetTenantsAsync(_scope.Token);
            if (!Current(generation, tenant)) return;
            _tenants = tenants.Where(item => item.TenantId > 0).ToArray();
            if (Access is null) { _pageData = new() { Items = [], TotalItems = 0 }; _error = "This tenant no longer grants Flows access."; return; }
        }
        catch (HttpRequestException) { if (Current(generation, tenant)) _error = "Flows permissions could not be refreshed. Retry."; return; }
        if (_editorDefinition is null && _table is not null) await _table.ReloadServerData();
    }
    private async Task TenantChosenAsync(int tenant)
    {
        if (tenant == _tenantId || !_tenants.Any(t => t.TenantId == tenant)) return;
        if (_dirty && _editor is not null) { await _editor.RequestLeaveAsync(() => ChangeTenantAsync(tenant)); return; }
        await ChangeTenantAsync(tenant);
    }
    private void ResetScope()
    {
        _scope.Cancel(); _scope.Dispose(); _scope = new(); ++_generation;
        _readScope?.Cancel(); ++_readIdentity; _delete = null;
        _connectors = []; _editorDefinition = null; _version = null; _recordedRun = null; _history = null; _clone = null; _versions = []; _runs = []; _runDetail = null; _dirty = false;
        _editor = null; _busy = false; _error = null; _showCreate = false;
        _historyError = null; _historyOpen = _historyLoading = _runLoading = _restoreHistoryFocus = false; ++_historyGeneration;
    }
    private async Task ChangeTenantAsync(int tenant)
    {
        ResetScope(); _tenantId = tenant; _query = _query with { PageIndex = 0 }; PersistQuery(); _pageData = new() { Items = [], TotalItems = 0 };
        await ReloadAsync();
    }
    private Task CreateAsync(bool template) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (Access?.CanEdit != true || string.IsNullOrWhiteSpace(_createName)) return;
        var flow = await Api.CreateAsync(tenant, new(_createName.Trim(), template), token);
        if (!Current(generation, tenant) || flow.TenantId != tenant) return;
        await ReloadAsync(); _showCreate = false; await OpenEditorCoreAsync(flow, generation, token);
    });
    private Task CreateFromTemplateAsync(FlowTemplateDescriptorDto template) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (Access?.CanEdit != true || string.IsNullOrWhiteSpace(_createName)) return;
        var flow = await Api.CreateFromTemplateAsync(tenant, new(_createName.Trim(), template.Id), token);
        if (!Current(generation, tenant) || flow.TenantId != tenant) return;
        if (flow.Enabled || flow.PublishedVersionId is not null || flow.PublishedVersionNumber != 0 || flow.Id == Guid.Empty || flow.Draft.SchemaVersion != template.SchemaVersion)
        { _error = "The template response was not a disabled unpublished draft. Refresh the list before continuing."; return; }
        await ReloadAsync(); _showCreate = false; await OpenEditorCoreAsync(flow, generation, token);
    });
    private Task OpenEditorAsync(FlowSummaryDto flow) => ScopeCommandAsync(async (_, generation, token) =>
    {
        var latest = await Api.GetAsync(_tenantId, flow.Id, token);
        if (!Current(generation, flow.TenantId) || latest.TenantId != _tenantId || latest.Id != flow.Id) return;
        await OpenEditorCoreAsync(latest, generation, token);
    });
    private async Task<FlowSchemaCapabilitiesDto> ReadSchemaCapabilitiesAsync(int tenant, CancellationToken token)
    {
        try
        {
            var capabilities = await Api.GetSchemaCapabilitiesAsync(tenant, token);
            if (capabilities.SupportedDraftSchemas is null || capabilities.ExecutableSchemas is null ||
                capabilities.SupportedDraftSchemas.Any(schema => schema <= 0) || capabilities.ExecutableSchemas.Any(schema => schema <= 0))
                throw new HttpRequestException("The server returned invalid flow schema capabilities.");
            return new(capabilities.SupportedDraftSchemas.Where(schema => schema is FlowLimits.SchemaVersion or FlowGraphV2Limits.SchemaVersion).Distinct().ToArray(),
                capabilities.ExecutableSchemas.Where(schema => schema is FlowLimits.SchemaVersion or FlowGraphV2Limits.SchemaVersion).Distinct().ToArray());
        }
        catch (FlowApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        { return LegacyCapabilities; }
    }
    private async Task OpenEditorCoreAsync(FlowDefinitionDto flow, int generation, CancellationToken token)
    {
        var connectorsTask = Api.GetConnectorsAsync(flow.TenantId, token);
        var capabilitiesTask = ReadSchemaCapabilitiesAsync(flow.TenantId, token);
        await Task.WhenAll(connectorsTask, capabilitiesTask);
        if (!Current(generation, flow.TenantId)) return;
        _schemaCapabilities = await capabilitiesTask;
        _connectors = (await connectorsTask).Where(c => c.TenantId == flow.TenantId).ToArray(); _editorDefinition = flow; _version = null; _recordedRun = null; _dirty = false; _history = null; _historyOpen = false;
    }
    private async Task DefinitionSaved(FlowDefinitionDto flow)
    {
        if (flow.TenantId != _tenantId || _editorDefinition?.Id != flow.Id) return;
        _editorDefinition = flow;
        await ReloadAsync();
    }
    private Task DirtyChanged(bool dirty) { _dirty = dirty; return Task.CompletedTask; }
    private Task CloseEditor()
    {
        if (_recordedRun is not null && _history is not null) _historyFocusTarget = "flow-run-replay";
        else if (_version is not null && _versions.Any(v => v.Id == _version.Id) && _history is not null)
            _historyFocusTarget = $"flow-version-{_version.Id:N}";
        else _restoreFocus = _editorDefinition is null ? null : $"flow-open-{_editorDefinition.Id:N}";
        _editorDefinition = null; _version = null; _recordedRun = null; _dirty = false; _editor = null; return Task.CompletedTask;
    }
    private void BeginClone(FlowSummaryDto flow) { _clone = flow; _cloneName = flow.Name.Length > 120 ? flow.Name[..120] + " copy" : flow.Name + " copy"; }
    private Task CloneAsync() => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (Access?.CanEdit != true || _clone is null || string.IsNullOrWhiteSpace(_cloneName)) return;
        var clone = await Api.CloneAsync(tenant, _clone.Id, new(_clone.Revision, _cloneName.Trim()), token);
        if (!Current(generation, tenant) || clone.TenantId != tenant) return;
        _clone = null; await ReloadAsync(); await OpenEditorCoreAsync(clone, generation, token);
    });
    private Task SetEnabledAsync(FlowSummaryDto flow, bool target) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (Access?.CanEdit != true || flow.TenantId != tenant || _uncertain.Contains(flow.Id)) return;
        try
        {
            var saved = await Api.SetEnabledAsync(tenant, flow.Id, new(flow.Revision, target), token);
            if (!Current(generation, tenant)) return;
            if (saved.TenantId != tenant || saved.Id != flow.Id || saved.Revision <= flow.Revision || saved.Enabled != target)
                throw new HttpRequestException("The enabled result could not be verified.");
            await ReloadAsync();
        }
        catch (FlowApiException exception) when ((int?)exception.StatusCode is < 500)
        {
            if (!Current(generation, tenant)) return;
            await ReloadAsync(); _error = exception.Message;
        }
        catch (HttpRequestException)
        {
            if (!Current(generation, tenant)) return;
            _uncertain.Add(flow.Id);
            await ReloadAsync();
            _error = "The enabled change was not confirmed. The list was reconciled where available; review its current state and revision. No automatic retry was made.";
        }
    });
    private Task DeleteAsync() => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        var target = _delete;
        if (Access?.CanDelete != true || target is null || target.TenantId != tenant) return;
        try
        {
            var result = await Api.DeleteAsync(tenant, target.Id, new(target.Revision), token);
            if (!Current(generation, tenant)) return;
            if (result.TenantId != tenant || result.FlowId != target.Id || result.Disposition is not (FlowDeleteDisposition.Deleted or FlowDeleteDisposition.AlreadyDeleted))
                throw new HttpRequestException("The deletion result could not be verified.");
            _delete = null; await ReloadAsync(); _restoreFocus = "flows-search";
        }
        catch (FlowApiException exception) when ((int?)exception.StatusCode is < 500)
        {
            if (!Current(generation, tenant)) return;
            _delete = null; await ReloadAsync(); _error = exception.Message;
        }
        catch (HttpRequestException)
        {
            if (!Current(generation, tenant)) return;
            _delete = null; _uncertain.Add(target.Id); await ReloadAsync();
            _error = "The deletion response was uncertain. Refresh to reconcile this exact flow before any new deletion intent. No automatic retry was made.";
        }
    });
    private Task LoadHistoryAsync(FlowSummaryDto flow) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (flow.TenantId != tenant) return;
        BeginHistory(flow);
        _versions = []; _runs = []; _runDetail = null; _historyLoading = true;
        try
        {
            var versionsTask = Api.GetVersionsAsync(tenant, flow.Id, token);
            var runsTask = Api.GetRunsAsync(tenant, flow.Id, token);
            await Task.WhenAll(versionsTask, runsTask);
            if (!Current(generation, tenant) || _history?.Id != flow.Id) return;
            _versions = (await versionsTask).Where(v => v.TenantId == tenant && v.FlowId == flow.Id).OrderByDescending(v => v.VersionNumber).ToArray();
            _runs = (await runsTask).Where(r => r.FlowId == flow.Id).OrderByDescending(r => r.CreatedAtUtc).ToArray();
        }
        finally { if (Current(generation, tenant)) _historyLoading = false; }
    }, historyRequest: true);
    private void BeginHistory(FlowSummaryDto flow)
    {
        if (!_historyOpen || _history?.Id != flow.Id) ++_historyGeneration;
        _recordedRun = null; _history = flow; _historyOpen = true; _restoreHistoryFocus = false; _historyFocusTarget = "flow-history-dismiss";
    }
    private Task ReloadHistoryAsync() => _history is { } flow ? LoadHistoryAsync(flow) : Task.CompletedTask;
    private Task LoadRunAsync(FlowRunSummaryDto run) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (_history is null || run.FlowId != _history.Id) return;
        var flowId = _history.Id;
        _runDetail = null; _runLoading = true; _historyFocusTarget = "flow-history-dismiss";
        try
        {
            var detail = await Api.GetRunAsync(tenant, flowId, run.Id, token);
            if (Current(generation, tenant) && _history?.Id == flowId && detail.Run.FlowId == flowId && detail.Run.Id == run.Id)
            { _runDetail = detail; _historyFocusTarget = "flow-run-heading"; }
        }
        finally { if (Current(generation, tenant)) _runLoading = false; }
    }, historyRequest: true);
    private void BackToHistory() { _runDetail = null; _historyError = null; _historyFocusTarget = "flow-history-runs-heading"; }
    private Task ViewVersionAsync(FlowVersionDto version) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (_history is null || version.TenantId != tenant || version.FlowId != _history.Id) return;
        var connectors = await Api.GetConnectorsAsync(tenant, token); if (!Current(generation, tenant)) return;
        _connectors = connectors.Where(c => c.TenantId == tenant).ToArray(); _editorDefinition = HistoricalDefinition(_history, version.Graph); _version = version; _recordedRun = null; _dirty = false;
    }, historyRequest: true);
    private Task ReplayRunAsync(FlowRunDetailDto detail) => ScopeCommandAsync(async (tenant, generation, token) =>
    {
        if (_history is null || detail.Run.FlowId != _history.Id || _runDetail?.Run.Id != detail.Run.Id) return;
        var flowId = _history.Id;
        var version = await Api.GetVersionAsync(tenant, detail.Run.FlowVersionId, token);
        if (!Current(generation, tenant) || _history?.Id != flowId || _runDetail?.Run.Id != detail.Run.Id ||
            version.TenantId != tenant || version.FlowId != flowId || version.Id != detail.Run.FlowVersionId) return;
        var hash = FlowGraphSerialization.Hash(version.Graph);
        if (!string.Equals(hash, version.ConfigurationHash, StringComparison.Ordinal))
        { _historyError = "This run's immutable graph could not be verified. Recorded playback is unavailable."; return; }
        var connectors = await Api.GetConnectorsAsync(tenant, token);
        if (!Current(generation, tenant) || _history?.Id != flowId || _runDetail?.Run.Id != detail.Run.Id) return;
        _connectors = connectors.Where(c => c.TenantId == tenant).ToArray();
        _editorDefinition = HistoricalDefinition(_history, version.Graph); _version = version; _recordedRun = detail; _dirty = false;
    }, historyRequest: true);
    private void HistoryVisibleChanged(int generation, bool visible)
    {
        if (generation == _historyGeneration && !visible && _editorDefinition is null) CloseHistory();
    }
    private void CloseHistory()
    {
        if (!_historyOpen || _history is null) return;
        _restoreFocus = $"flow-history-{_history.Id:N}"; _restoreHistoryFocus = true;
        _historyOpen = false; _historyError = null; _historyLoading = _runLoading = false;
        // Closing a read-only viewer cancels its reads without resetting the list or search.
        _scope.Cancel(); _scope.Dispose(); _scope = new(); ++_generation; _busy = false;
    }
    private static string HistoryBodyId(int generation) => $"flow-history-body-{generation}";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_editorDefinition is null && Access is not null && !_resultsUnavailable)
        {
            try
            {
                _resultsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/flows-results.js");
                if (_resultsObserver is null) _resultsObserver = await _resultsModule.InvokeAsync<IJSObjectReference>("observeResults", _resultsElement);
                else await _resultsObserver.InvokeVoidAsync("setElement", _resultsElement);
            }
            catch (JSException exception)
            {
                _resultsUnavailable = true;
                Logger.LogWarning(exception, "Flows viewport measurement is unavailable; retaining the CSS scroll bounds.");
            }
        }
        if (_restoreFocus is not { } id) return; _restoreFocus = null;
        try
        {
            if (_restoreHistoryFocus)
            {
                _restoreHistoryFocus = false;
                var generation = _historyGeneration;
                _historyFocusModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/operator-policy-dialog.js");
                await _historyFocusModule.InvokeVoidAsync("waitForDismissal", HistoryBodyId(generation));
                if (!_disposed && !_historyOpen && generation == _historyGeneration)
                    await _historyFocusModule.InvokeVoidAsync("restoreFocus", id, "flows-search", "flows-heading");
            }
            else
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/operator-policy-dialog.js");
                await _module.InvokeVoidAsync("restoreFocus", id, "flows-search", "flows-heading");
            }
        }
        catch (JSDisconnectedException) { _module = null; _historyFocusModule = null; }
    }
    private static string RunStatusLabel(FlowRunStatus status) => status switch
    { FlowRunStatus.PartiallySucceeded => "Partially succeeded", FlowRunStatus.RetryWaiting => "Waiting to retry", FlowRunStatus.DeliveryUnknown => "Delivery unconfirmed",
        FlowRunStatus.WaitingForAi => "Waiting for AI completion", FlowRunStatus.AwaitingApproval => "Awaiting AI approval", _ => status.ToString() };
    public async ValueTask DisposeAsync()
    {
        _disposed = true; ++_generation; _scope.Cancel(); _scope.Dispose(); _readScope?.Cancel(); _readScope?.Dispose();
        if (_resultsObserver is not null)
        {
            try { await _resultsObserver.InvokeVoidAsync("dispose"); await _resultsObserver.DisposeAsync(); }
            catch (JSDisconnectedException) { _resultsObserver = null; }
        }
        foreach (var module in new[] { _module, _historyFocusModule, _resultsModule })
        {
            if (module is not null)
            {
                try { await module.DisposeAsync(); }
                catch (JSDisconnectedException) { _module = null; _historyFocusModule = null; }
            }
        }
    }
}
