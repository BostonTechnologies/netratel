@using System.Globalization
@using System.ComponentModel
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors
@using NetRatel.Shared.Contracts.Flows
@using NetRatel.Web.Services.Flows
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="flow-canvas-tools">
    <MudTooltip Text="Zoom in"><MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Size="MudBlazor.Size.Small" OnClick="() => ZoomAsync(120)" aria-label="Zoom in" data-testid="flow-zoom-in" /></MudTooltip>
    <span>@((100 / Adapter.Tree.Layout.Scale.Horizontal).ToString("0", CultureInfo.InvariantCulture))%</span>
    <MudTooltip Text="Zoom out"><MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Size="MudBlazor.Size.Small" OnClick="() => ZoomAsync(-120)" aria-label="Zoom out" data-testid="flow-zoom-out" /></MudTooltip>
    <MudTooltip Text="Fit graph"><MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" Size="MudBlazor.Size.Small" OnClick="FitAsync" aria-label="Fit graph" data-testid="flow-fit" /></MudTooltip>
    <MudTooltip Text="@(_overviewOpen ? "Hide overview" : "Show overview")"><MudIconButton Icon="@Icons.Material.Filled.Map" Size="MudBlazor.Size.Small" OnClick="ToggleOverviewAsync" aria-expanded="@(_overviewOpen ? "true" : "false")" aria-label="@(_overviewOpen ? "Hide overview" : "Show overview")" data-testid="flow-overview-toggle" /></MudTooltip>
</div>
<section class="flow-canvas-panel" id="@PanelId" aria-label="Workflow canvas" data-testid="flow-canvas" tabindex="0" data-read-only="@(ReadOnly ? "true" : "false")" data-connection-start="@_connectingFrom">
    <FlowSurfaceBehavior @ref="_surface" @key="Adapter.Tree" Tree="Adapter.Tree" IsEnabled="true" ZoomEnabled="true"
        ScrollViewerId="@ScrollId" CanvasId="@CanvasId" Background="var(--mud-palette-background)"
        GridColor="var(--mud-palette-divider)" MajorGridColor="var(--mud-palette-text-disabled)">
        <Minimap Context="viewport">@if (_overviewOpen) { <div data-testid="flow-overview"><WorkflowMinimapOverlay Viewport="viewport" Width="120" Height="76" ScrollViewerId="@ScrollId"
            Background="var(--mud-palette-surface)" ViewportStroke="var(--mud-palette-primary)" /></div> }</Minimap>
        <ChildContent Context="canvas">
            <svg class="flow-links" width="@canvas.Width" height="@canvas.Height" role="group" aria-label="Workflow connections">
                @foreach (var link in Adapter.Tree.Links.ToArray())
                {
                    @if (Adapter.Ports.ContainsKey(link.Sender) && Adapter.Ports.ContainsKey(link.Receiver))
                    {
                        var source = Adapter.Ports[link.Sender].NodeId; var target = Adapter.Ports[link.Receiver].NodeId;
                        <FlowConnectionPath @key="link" Link="link" Source="source" Target="target"
                            Label="@($"Connection from {NodeName(source)} to {NodeName(target)}")"
                            Selected="@(_selectedConnection == (source, target))" SelectedChanged="() => SelectConnection(source, target)" />
                    }
                }
                <path class="flow-live-link" hidden="hidden" fill="none" stroke="var(--mud-palette-primary)" stroke-width="3" stroke-dasharray="7 5" pointer-events="none" aria-hidden="true" data-native-virtual-link="@WorkflowRuntimeIds.Get(Adapter.Tree.VirtualLink)" data-testid="flow-virtual-link" />
            </svg>
            <ViewPool ItemsSource="Adapter.Tree.Nodes.ToArray()" KeySelector="item => item">
                <ItemTemplate Context="item">
                    @{ var node = (IWorkflowNodeViewModel)item; }
                    @if (Adapter.Metadata.TryGetValue(node, out var metadata))
                    {
                    <WorkflowSlotLayoutBehavior Node="node" IsEnabled="true">
                        <WorkflowNodeDragBehavior Node="node" IsEnabled="@(!ReadOnly)" Style="@NodeStyle(node)">
                            <article class="flow-node @(SelectedNodeId == metadata.Id ? "selected" : "")" data-node-id="@metadata.Id" data-node-kind="@metadata.Kind" style="@CardStyle(node)">
                                <header class="flow-node-header">
                                    <div role="button" tabindex="0" class="flow-node-title" @onclick="() => Selected.InvokeAsync(metadata.Id)" @onkeydown="e => SelectFromKeyboard(metadata.Id, e)" data-testid="flow-node-title">@metadata.Name</div>
                                    <div class="flow-node-actions" @onpointerdown:stopPropagation @onmousedown:stopPropagation @onclick:stopPropagation>
                                        <MudTooltip Text="Node settings"><MudIconButton Icon="@Icons.Material.Filled.Settings" Size="MudBlazor.Size.Small" OnClick="() => Settings.InvokeAsync(metadata.Id)" aria-label="@($"Settings for {metadata.Name}")" data-testid="flow-node-settings" /></MudTooltip>
                                        <MudTooltip Text="Delete node"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="MudBlazor.Size.Small" OnClick="() => Delete.InvokeAsync(metadata.Id)" Disabled="@ReadOnly" aria-label="@($"Delete {metadata.Name}")" data-testid="flow-node-delete" /></MudTooltip>
                                    </div>
                                </header>
                                <div class="flow-node-body"><small class="flow-node-category">@KindLabel(metadata.Kind)</small><span class="flow-node-summary">@NodeSummary(metadata)</span>
                                    @foreach (var slot in node.Slots)
                                    {
                                        if (!Adapter.Ports.TryGetValue(slot, out var port)) continue;
                                        var output = port.Output;
                                        <div class="flow-port @(output ? "output" : "input")" data-port-node="@metadata.Id" data-port-id="@(output ? FlowLimits.OutputPort : FlowLimits.InputPort)" data-port-direction="@(output ? "output" : "input")" data-compatible-targets="@(output ? CompatibleTargets(metadata.Id) : null)">
                                            <WorkflowSlotConnectionBehavior Slot="slot" Tree="Adapter.Tree" IsEnabled="false">
                                                <button type="button" class="flow-port-button" disabled="@ReadOnly"
                                                    aria-label="@($"{(output ? FlowCanvasAdapter.OutputType(metadata.Kind) : FlowCanvasAdapter.InputType(metadata.Kind))} {(output ? "output" : "input")} port of {metadata.Name}")"
                                                    aria-pressed="@(_connectingFrom == metadata.Id && output ? "true" : "false")"
                                                    @onclick="() => ActivatePortAsync(metadata.Id, output)" data-testid="flow-port-button">
                                                    <svg class="veloxdev-wf-slot-svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="var(--mud-palette-primary)" stroke="var(--mud-palette-primary-text)" stroke-width="2" /></svg>
                                                    <span class="flow-port-label">@(output ? $"out · {FlowCanvasAdapter.OutputType(metadata.Kind)}" : $"in · {FlowCanvasAdapter.InputType(metadata.Kind)}")</span>
                                                </button>
                                            </WorkflowSlotConnectionBehavior>
                                        </div>
                                    }
                                </div>
                            </article>
                        </WorkflowNodeDragBehavior>
                    </WorkflowSlotLayoutBehavior>
                    }
                </ItemTemplate>
            </ViewPool>
        </ChildContent>
    </FlowSurfaceBehavior>
    @if (SelectedConnection is { } connection)
    {
        <div class="flow-edge-tools" data-testid="flow-edge-tools"><span>@NodeName(connection.SourceNodeId) → @NodeName(connection.TargetNodeId)</span>
            @if (!ReadOnly) { <button type="button" @onclick="RemoveSelectedConnectionAsync" data-testid="flow-edge-remove">Remove connection</button> }
            <button type="button" @onclick="() => _selectedConnection = null" aria-label="Close connection inspector">Close</button>
        </div>
    }
</section>
<div class="flow-connection-status" role="status" data-testid="flow-connection-status"><span data-testid="flow-connection-message">@_connectionMessage</span>
    @if (_connectingFrom is not null) { <button type="button" @onclick="CancelConnectionAsync" data-testid="flow-connection-cancel">Cancel connection</button> }
</div>
<p class="flow-canvas-hint">Drag compatible ports, or activate an output and then an input using keyboard or touch. Select a curve to inspect or remove it. Pan on blank canvas; Ctrl + wheel zooms.</p>

@code {
    [Parameter, EditorRequired] public FlowCanvasAdapter Adapter { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public IReadOnlyList<FlowConnectorReferenceDto> Connectors { get; set; } = [];
    [Parameter] public Guid? SelectedNodeId { get; set; }
    [Parameter] public EventCallback<Guid> Selected { get; set; }
    [Parameter] public EventCallback<Guid> Settings { get; set; }
    [Parameter] public EventCallback<Guid> Delete { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback Ready { get; set; }
    public bool IsReady { get; private set; }
    [Parameter] public FlowViewportDto InitialViewport { get; set; } = new();
    private readonly string _id = Guid.NewGuid().ToString("N");
    private string ScrollId => "flow-scroll-" + _id;
    private string CanvasId => "flow-canvas-" + _id;
    private string PanelId => "flow-panel-" + _id;
    private WorkflowSurfaceBehavior? _surface;
    private IJSObjectReference? _module, _connections;
    private DotNetObjectReference<FlowCanvas>? _reference;
    private bool _disposed;
    private bool _overviewOpen;
    private FlowCanvasAdapter? _subscribed;
    private double _scrollX, _scrollY;
    private Guid? _connectingFrom;
    private bool _committingConnection;
    private readonly CancellationTokenSource _portLifetime = new();
    public bool IsConnecting => _connectingFrom is not null;
    private (Guid Source, Guid Target)? _selectedConnection;
    private string? _connectionMessage;
    private readonly Dictionary<Guid, string> _compatibleTargets = [];
    private FlowEdgeDto? SelectedConnection => _selectedConnection is { } selected ? Adapter.Capture().Edges.FirstOrDefault(edge => edge.SourceNodeId == selected.Source && edge.TargetNodeId == selected.Target) : null;

    protected override void OnParametersSet()
    {
        if (ReadOnly) _connectingFrom = null;
        if (_subscribed == Adapter) return;
        Unsubscribe(); _subscribed = Adapter;
        Adapter.Changed += ScheduleRefresh;
        Adapter.Tree.Nodes.CollectionChanged += CollectionChanged;
        Adapter.Tree.Links.CollectionChanged += CollectionChanged;
        Adapter.Tree.Layout.PropertyChanged += PropertyChanged;
        Adapter.Tree.GetHelper().NodeAdded += NodeChanged;
        Adapter.Tree.GetHelper().NodeRemoved += NodeRemoved;
        Adapter.Tree.GetHelper().LinkAdded += LinkChanged;
        Adapter.Tree.GetHelper().LinkRemoved += LinkChanged;
        foreach (var node in Adapter.Tree.Nodes) node.PropertyChanged += PropertyChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/flows-editor.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            _reference = DotNetObjectReference.Create(this);
            _scrollX = InitialViewport.ScrollX; _scrollY = InitialViewport.ScrollY;
            await _module.InvokeVoidAsync("attach", ScrollId, InitialViewport.ScrollX, InitialViewport.ScrollY, _reference);
            _connections = await JS.InvokeAsync<IJSObjectReference>("import", "./js/flows-connections.js");
            if (_disposed) { await _connections.DisposeAsync(); _connections = null; return; }
            await _connections.InvokeVoidAsync("attach", PanelId, _reference);
            if (!_disposed) { IsReady = true; await Ready.InvokeAsync(); }
        }
        catch (JSDisconnectedException) { return; }
    }

    private string NodeName(Guid id) => Adapter.Metadata.Values.FirstOrDefault(node => node.Id == id)?.Name ?? "Unknown node";
    private string NodeSummary(FlowNodeDto node) => node.Kind switch
    {
        FlowNodeKind.AlertRaised => "A monitoring occurrence starts this path",
        FlowNodeKind.Condition when node.Condition is { } condition => $"{condition.Field} {condition.Comparison} {condition.NumericValue?.ToString(CultureInfo.InvariantCulture) ?? condition.TextValue}",
        FlowNodeKind.MapIncident => node.Mapping?.TitleTemplate ?? "Configure the message fields",
        FlowNodeKind.ActionGroup => $"{node.Actions?.Count ?? 0} independent destinations",
        FlowNodeKind.InvestigateWithAi => $"{ConnectorName(node)} · waits for the exact AI turn",
        FlowNodeKind.CreateIncident => ConnectorName(node),
        _ => "Configure this node"
    };
    private string ConnectorName(FlowNodeDto node) => Connectors.FirstOrDefault(connector => connector.Id == node.ConnectorId)?.Name ?? "Select a connection";
    private string CompatibleTargets(Guid source)
    {
        if (_compatibleTargets.TryGetValue(source, out var cached)) return cached;
        var targets = string.Join(" ", Adapter.Ports.Values.Where(port => !port.Output)
            .Select(port => port.NodeId).Where(target => Adapter.ConnectionRejection(source, target) is null));
        _compatibleTargets[source] = targets;
        return targets;
    }
    private Task SelectConnection(Guid source, Guid target)
    { _selectedConnection = (source, target); return Task.CompletedTask; }
    public bool HasSelectedConnection => SelectedConnection is not null;
    public void ClearConnectionSelection() => _selectedConnection = null;
    public async Task RemoveSelectedConnectionAsync()
    {
        if (ReadOnly || SelectedConnection is not { } edge) return;
        await Adapter.DisconnectAsync(edge); _selectedConnection = null;
    }
    private async Task ActivatePortAsync(Guid node, bool output)
    {
        if (ReadOnly || _disposed) return;
        if (output)
        {
            await CancelConnectionAsync();
            _connectingFrom = node; _selectedConnection = null;
            _connectionMessage = $"Connecting from {NodeName(node)}. Activate a compatible input port, or cancel.";
            return;
        }
        if (_connectingFrom is not { } source) { _connectionMessage = "Activate an output port first."; return; }
        if (Adapter.ConnectionRejection(source, node) is { } reason) { _connectionMessage = reason; return; }
        await CreateConnectionAsync(source, node);
    }
    [JSInvokable] public Task CompletePortConnection(string source, string target) => InvokeAsync(async () =>
    {
        if (_disposed || ReadOnly || !Guid.TryParse(source, out var from) || !Guid.TryParse(target, out var to)) return;
        await CreateConnectionAsync(from, to);
        if (!_disposed) StateHasChanged();
    });
    private async Task CreateConnectionAsync(Guid source, Guid target)
    {
        if (_disposed || ReadOnly || _committingConnection) return;
        if (Adapter.ConnectionRejection(source, target) is { } reason) { _connectionMessage = reason; return; }
        _committingConnection = true;
        try
        {
            await Adapter.ConnectAsync(source, target, _portLifetime.Token);
            if (!_disposed) { _connectingFrom = null; _connectionMessage = "Connection created."; }
        }
        catch (OperationCanceledException) when (_portLifetime.IsCancellationRequested) { return; }
        catch (InvalidOperationException exception) { if (!_disposed) _connectionMessage = exception.Message; }
        finally { _committingConnection = false; }
    }
    [JSInvokable] public Task ExplainPortConnection(string source, string target) => InvokeAsync(() =>
    {
        if (_disposed || ReadOnly || !Guid.TryParse(source, out var from) || !Guid.TryParse(target, out var to)) return;
        _connectionMessage = Adapter.ConnectionRejection(from, to);
        StateHasChanged();
    });
    [JSInvokable] public Task CancelPortConnection() => InvokeAsync(CancelConnectionAsync);
    public async Task CancelConnectionAsync()
    {
        _connectingFrom = null; _connectionMessage = null;
        if (!_disposed && Adapter.Tree.ResetVirtualLinkCommand.CanExecute(null))
            await FlowCanvasAdapter.CompleteAsync(Adapter.Tree.ResetVirtualLinkCommand, null);
        if (!_disposed) StateHasChanged();
    }

    [JSInvokable] public Task ViewportChanged(double x, double y)
    {
        if (_disposed || !double.IsFinite(x) || !double.IsFinite(y)) return Task.CompletedTask;
        _scrollX = x; _scrollY = y;
        return ReadOnly ? Task.CompletedTask : Changed.InvokeAsync();
    }
    public async Task<FlowGraphDto> CaptureAsync()
    {
        if (_module is not null)
        {
            var geometry = await _module.InvokeAsync<double[]>("geometry", ScrollId);
            _scrollX = geometry[0]; _scrollY = geometry[1];
        }
        return Adapter.Capture(_scrollX, _scrollY);
    }
    public FlowGraphDto CaptureCurrent() => Adapter.Capture(_scrollX, _scrollY);
    public async Task<FlowPositionDto?> TakeDropPositionAsync()
    {
        if (_module is null || ReadOnly) return null;
        var point = await _module.InvokeAsync<double[]?>("takeDropPosition", ScrollId);
        return CanonicalPosition(point);
    }
    public async Task<FlowPositionDto?> CenterPositionAsync()
    {
        if (_module is null || ReadOnly) return null;
        return CanonicalPosition(await _module.InvokeAsync<double[]?>("centerPosition", ScrollId));
    }
    private FlowPositionDto? CanonicalPosition(double[]? point)
    {
        if (point is not { Length: 2 }) return null;
        var scale = Adapter.Tree.Layout.Scale.Horizontal;
        var x = Math.Round(point[0] * scale, 6); var y = Math.Round(point[1] * scale, 6);
        return double.IsFinite(x) && double.IsFinite(y) && Math.Abs(x) <= 20000 && Math.Abs(y) <= 20000 ? new(x, y) : null;
    }
    public async Task FocusAsync() { if (_module is not null) await _module.InvokeVoidAsync("focus", PanelId); }
    public async Task FocusNodeSettingsAsync(Guid? nodeId)
    { if (_module is not null) await _module.InvokeVoidAsync("focusNodeSettings", PanelId, nodeId?.ToString()); }
    private async Task ZoomAsync(int delta)
    {
        if (_module is null || _surface is null) return;
        var g = await _module.InvokeAsync<double[]>("geometry", ScrollId);
        await _surface.OnWheelZoom(delta, g[0], g[1], g[2], g[3], g[4], g[5]);
    }
    private Task SelectFromKeyboard(Guid id, KeyboardEventArgs e) => e.Key is "Enter" or " " ? Selected.InvokeAsync(id) : Task.CompletedTask;
    private async Task FitAsync()
    {
        if (_module is null || _surface is null || Adapter.Tree.Nodes.Count == 0) return;
        var nodes = Adapter.Capture().Nodes;
        var g = await _module.InvokeAsync<double[]>("geometry", ScrollId);
        var marginX = Math.Min(30, Math.Max(4, g[2] * .08));
        var marginY = Math.Min(30, Math.Max(4, g[3] * .08));
        var desired = Math.Clamp(Math.Max((nodes.Max(n => n.Position.X) - nodes.Min(n => n.Position.X) + 220) / Math.Max(1, g[2] - marginX * 2),
            (nodes.Max(n => n.Position.Y) - nodes.Min(n => n.Position.Y) + 140) / Math.Max(1, g[3] - marginY * 2 - (_overviewOpen ? 92 : 0))), .1, 10);
        var steps = (int)Math.Ceiling(Math.Log(desired / Adapter.Tree.Layout.Scale.Horizontal, 1.1));
        if (steps != 0) await ZoomAsync(-120 * steps);
        // Native zoom also changes the surface offset. Position using the actual rendered node bounds.
        await _module.InvokeVoidAsync("fitPosition", ScrollId, marginX, marginY);
    }
    private async Task ToggleOverviewAsync()
    {
        _overviewOpen = !_overviewOpen;
        if (_overviewOpen) { StateHasChanged(); await FitAsync(); }
    }
    private void NodeChanged(object? sender, IWorkflowNodeViewModel node) { _compatibleTargets.Clear(); node.PropertyChanged -= PropertyChanged; node.PropertyChanged += PropertyChanged; ScheduleRefresh(); }
    private void NodeRemoved(object? sender, IWorkflowNodeViewModel node) { _compatibleTargets.Clear(); node.PropertyChanged -= PropertyChanged; ScheduleRefresh(); }
    private void LinkChanged(object? sender, IWorkflowLinkViewModel link) { _connectingFrom = null; _compatibleTargets.Clear(); ScheduleRefresh(); }
    private void CollectionChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs args) { _compatibleTargets.Clear(); ScheduleRefresh(); }
    private void PropertyChanged(object? sender, PropertyChangedEventArgs args) => ScheduleRefresh();
    private void ScheduleRefresh()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () => { if (_disposed) return; await Task.Yield(); StateHasChanged(); if (!ReadOnly) await Changed.InvokeAsync(); });
    }
    private void Unsubscribe()
    {
        if (_subscribed is not { } adapter) return;
        adapter.Changed -= ScheduleRefresh;
        adapter.Tree.Nodes.CollectionChanged -= CollectionChanged; adapter.Tree.Links.CollectionChanged -= CollectionChanged;
        adapter.Tree.Layout.PropertyChanged -= PropertyChanged;
        adapter.Tree.GetHelper().NodeAdded -= NodeChanged; adapter.Tree.GetHelper().NodeRemoved -= NodeRemoved;
        adapter.Tree.GetHelper().LinkAdded -= LinkChanged; adapter.Tree.GetHelper().LinkRemoved -= LinkChanged;
        foreach (var node in adapter.Tree.Nodes) node.PropertyChanged -= PropertyChanged;
    }
    public static string KindLabel(FlowNodeKind kind) => kind switch { FlowNodeKind.AlertRaised => "Alert raised", FlowNodeKind.Condition => "Typed condition", FlowNodeKind.MapIncident => "Map alert fields", FlowNodeKind.CreateIncident => "RatelDesk: Create incident", FlowNodeKind.InvestigateWithAi => "AI: Investigate alert", FlowNodeKind.ActionGroup => "Action group", _ => "Unsupported node" };
    private static string NodeStyle(IWorkflowNodeViewModel node) => FormattableString.Invariant($"width:{node.Size.Width}px;height:{node.Size.Height}px;");
    private static string CardStyle(IWorkflowNodeViewModel node) => FormattableString.Invariant($"transform:scale({node.Size.Width / 220});");
    public async ValueTask DisposeAsync()
    {
        _disposed = true; IsReady = false; _portLifetime.Cancel(); Unsubscribe();
        if (_connections is { } connections)
        {
            _connections = null;
            try { await connections.InvokeVoidAsync("detach", PanelId); await connections.DisposeAsync(); }
            catch (JSDisconnectedException) { _connectingFrom = null; }
        }
        if (_module is { } module)
        {
            _module = null;
            try { await module.InvokeVoidAsync("detach", ScrollId); }
            catch (JSDisconnectedException) { _reference?.Dispose(); _reference = null; }
            finally
            {
                try { await module.DisposeAsync(); }
                catch (JSDisconnectedException) { _reference?.Dispose(); _reference = null; }
            }
        }
        _reference?.Dispose(); _reference = null; _portLifetime.Dispose();
    }
}
