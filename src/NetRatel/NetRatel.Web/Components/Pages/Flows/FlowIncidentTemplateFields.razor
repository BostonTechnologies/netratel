@using AutomationTrace.Contracts
@using NetRatel.Shared.Contracts.RatelDesk
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@implements IAsyncDisposable

<fieldset disabled="@Disabled" class="flow-incident-presentation" data-testid="flow-incident-presentation" aria-busy="@(loading || previewing)">
    <legend>Incident presentation</legend>
    @if (loading) { <p class="presentation-help" role="status">Loading report options…</p> }
    @if (error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined">@error</MudAlert>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(Disabled || loading)" OnClick="ReloadAsync">Retry lookup</MudButton>
    }
    @if (catalogue is { } available)
    {
        <MudCheckBox T="bool" Value="@(Presentation is not null)" ValueChanged="ToggleHumanAsync" Disabled="Disabled"
                     Label="Use human summary and source relations" Dense="true" Size="Size.Small" Class="presentation-toggle" />
        @if (Presentation is not null)
        {
            <MudCheckBox T="bool" Value="custom" ValueChanged="ToggleCustomAsync" Disabled="@(Disabled || available.CatalogueState != "available")"
                         Label="Use RatelDesk incident template" Dense="true" Size="Size.Small" Class="presentation-toggle" />
            @if (available.CatalogueState != "available")
            { <p class="presentation-help" role="status">Enable “Browse and preview internal incident templates” on the saved connection to use a custom report.</p> }
            @if (custom)
            {
                <div class="presentation-picker">
                    <label>Find template<input type="search" @bind="filter" @bind:event="oninput" maxlength="128" /></label>
                    <label>Published template revision<select value="@SelectionKey" @onchange="SelectAsync">
                        <option value="">Choose a compatible published revision</option>
                        @foreach (var item in Eligible)
                        { <option value="@Key(item.Presentation)">@item.Name · revision @item.Presentation.Revision</option> }
                    </select></label>
                </div>
                @if (Presentation.Mode == "template" && !Eligible.Any(x => x.Presentation == Presentation))
                { <p class="presentation-error" role="alert">Choose an available published revision before publishing this flow.</p> }
            }
            <div class="presentation-actions">
                <span class="presentation-selection">@(Presentation.Mode == "template" ? string.IsNullOrEmpty(Presentation.TemplateId)
                    ? "Choose a published revision" : $"Template revision {Presentation.Revision}" : "Built-in human summary")</span>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Visibility"
                           Class="presentation-preview-button" Disabled="@(Disabled || previewing || string.IsNullOrEmpty(Presentation.TemplateId))"
                           OnClick="PreviewAsync" data-testid="incident-report-preview">@(previewing ? "Loading preview…" : "Preview report")</MudButton>
            </div>
            <p class="presentation-help">Priority and assignment follow the connector.</p>
        }
    }
    else if (!loading && error is null && ConnectorId is null) { <p class="presentation-help">Choose a saved RatelDesk connector.</p> }
    @if (preview is not null)
    {
        <section class="presentation-preview" aria-label="Synthetic report preview">
            <span class="presentation-preview-caption">Synthetic preview</span>
            <p class="presentation-preview-subject">@preview.Subject</p>
            <iframe title="Read-only internal incident report preview" sandbox="" srcdoc="@(previewHtml ?? preview.Html)"></iframe>
        </section>
    }
</fieldset>

@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter] public Guid? ConnectorId { get; set; }
    [Parameter] public IncidentPresentationReference? Presentation { get; set; }
    [Parameter] public EventCallback<IncidentPresentationReference?> Changed { get; set; }
    [Parameter] public IReadOnlyList<string> SourceKinds { get; set; } = ["monitoring"];
    [Parameter] public bool Disabled { get; set; }
    private HttpClient Api => HttpClientFactory.CreateClient("FlowsApi");
    private RatelDeskIncidentPresentationCatalogue? catalogue;
    private IncidentTemplatePreview? preview;
    private string? previewHtml;
    private IJSObjectReference? previewModule;
    private string? error, scope;
    private string filter = "";
    private bool loading, custom, previewing;
    private int generation;
    private string SelectionKey => Presentation is { Mode: "template" } selected ? Key(selected) : "";
    private IEnumerable<IncidentTemplateCatalogueItem> Eligible => (catalogue?.Templates ?? []).Where(x => x.Presentation.Mode == "template" &&
        SourceKinds.All(source => x.SourceKinds.Contains(source)) && x.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Name).ThenBy(x => x.Id);
    private string Path => $"api/v2/tenants/{TenantId}/connectors/rateldesk/{ConnectorId:D}/incident-templates";
    protected override async Task OnParametersSetAsync()
    {
        var next = $"{TenantId}:{ConnectorId}";
        if (scope == next) return;
        scope = next; generation++; loading = false; previewing = false; error = null; custom = Presentation?.Mode == "template"; preview = null; catalogue = null;
        if (ConnectorId is not null) await ReloadAsync();
    }
    private async Task ReloadAsync()
    {
        var current = ++generation; var currentScope = scope;
        loading = true; error = null;
        try
        {
            var response = await Api.GetFromJsonAsync<RatelDeskIncidentPresentationCatalogue>(Path);
            if (current != generation || currentScope != scope) return;
            catalogue = response;
        }
        catch (HttpRequestException) { if (current == generation) error = "Presentation lookup is unavailable or denied. Check peer compatibility, the selected connector and its approval."; }
        finally { if (current == generation) loading = false; }
    }
    private async Task ToggleHumanAsync(bool enabled)
    {
        preview = null; custom = false;
        await Changed.InvokeAsync(enabled ? catalogue?.Capability.Standard : null);
    }
    private async Task ToggleCustomAsync(bool enabled)
    {
        custom = enabled; preview = null;
        if (!custom) await Changed.InvokeAsync(catalogue?.Capability.Standard);
        else if (catalogue is { } available)
            await Changed.InvokeAsync(available.Capability.Standard with
            { Mode = "template", TemplateId = "", Revision = "", ContentDigest = "", LayoutDigest = "" });
    }
    private Task SelectAsync(ChangeEventArgs args)
    {
        var item = Eligible.SingleOrDefault(x => Key(x.Presentation) == args.Value?.ToString());
        preview = null;
        return item is null ? Task.CompletedTask : Changed.InvokeAsync(item.Presentation);
    }
    private async Task PreviewAsync()
    {
        if (Presentation is null || ConnectorId is null) return;
        var current = generation; var selected = Presentation; previewing = true;
        try
        {
            using var response = await Api.PostAsJsonAsync(Path + "/preview", new RatelDeskIncidentPreviewRequest(selected, SourceKinds.FirstOrDefault() ?? "monitoring"));
            if (current != generation || selected != Presentation) return;
            if (!response.IsSuccessStatusCode) { error = "The pinned presentation could not be previewed. Check revision compatibility and current connector authority."; return; }
            var candidate = await response.Content.ReadFromJsonAsync<IncidentTemplatePreview>();
            if (current != generation || selected != Presentation) return;
            preview = candidate;
            previewHtml = preview?.Html;
            if (preview is not null)
            {
                previewModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/automationPreview.js");
                if (previewModule is not null)
                {
                    var formatted = await previewModule.InvokeAsync<string>("formatReport", candidate!.Html);
                    if (current == generation && selected == Presentation) previewHtml = formatted;
                }
            }
        }
        catch (HttpRequestException) { if (current == generation && selected == Presentation) error = "Preview is unavailable. No incident or execution was created."; }
        catch (JSException) { previewHtml = preview?.Html; }
        finally { if (current == generation) previewing = false; }
    }
    public async ValueTask DisposeAsync()
    {
        if (previewModule is null) return;
        try { await previewModule.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
    private static string Key(IncidentPresentationReference value) => value.TemplateId + ":" + value.Revision + ":" + value.ContentDigest;
}
