@using System.Globalization
@using NetRatel.Shared.Contracts.Flows
@using NetRatel.Web.Services.Flows

@if (Edge is { Id: { } edgeId, Route: { } route })
{
    @for (var index = 0; index < route.Points.Count; index++)
    {
        var pointIndex = index; var point = route.Points[index];
        <circle class="flow-route-handle" cx="@Number(point.X / Scale)" cy="@Number(point.Y / Scale)" r="7"
            data-edge-id="@edgeId" data-point-index="@index" data-world-x="@Number(point.X)" data-world-y="@Number(point.Y)"
            tabindex="0" role="slider" aria-label="@($"Route point {index + 1}")" aria-valuetext="@($"X {Number(point.X)}, Y {Number(point.Y)}")"
            @onkeydown="args => KeyDown(pointIndex, args)" @onkeydown:preventDefault data-testid="flow-route-handle" />
    }
}

@code {
    [Parameter, EditorRequired] public FlowEdgeDto Edge { get; set; } = default!;
    [Parameter] public double Scale { get; set; } = 1;
    [Parameter] public EventCallback<FlowRoutePointEdit> Changed { get; set; }
    private Task KeyDown(int index, KeyboardEventArgs args)
    {
        if (Edge is not { Id: { } edgeId, Route: { } route } || index < 0 || index >= route.Points.Count) return Task.CompletedTask;
        var step = args.ShiftKey ? 10d : 1d; var point = route.Points[index];
        var next = args.Key switch
        {
            "ArrowLeft" => point with { X = point.X - step }, "ArrowRight" => point with { X = point.X + step },
            "ArrowUp" => point with { Y = point.Y - step }, "ArrowDown" => point with { Y = point.Y + step }, _ => point
        };
        return next == point ? Task.CompletedTask : Changed.InvokeAsync(new(edgeId, index, next));
    }
    private static string Number(double value) => value.ToString("0.######", CultureInfo.InvariantCulture);
}
