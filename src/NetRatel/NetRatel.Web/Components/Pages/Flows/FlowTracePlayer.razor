@using System.Text.Json
@using NetRatel.Shared.Contracts.Flows
@implements IAsyncDisposable
@inject IJSRuntime JS

<section id="@_id" class="flow-trace-player" data-testid="flow-trace-player" data-context="@ContextKey" data-scope-id="@ScopeId" aria-label="Flow playback" @onkeydown:stopPropagation>
    @if (Trace is { SchemaVersion: not 1 })
    {
        <p role="alert" data-testid="flow-trace-unsupported">Node data unavailable. This trace format is unsupported.</p>
    }
    else if (Stale)
    {
        <p role="alert" data-testid="flow-trace-stale">This trace belongs to a different graph revision. Preview the current draft again.</p>
    }
    else if (Trace is not { Steps.Count: > 0 } trace)
    {
        <p data-testid="flow-trace-unavailable">Node data unavailable.
            @if (DataUnavailableReason is { Length: > 0 })
            { <span>Source or node data could not be provided: <code>@DataUnavailableReason</code>.</span> }
            else
            { <span>This run has no captured node snapshots.</span> }
        </p>
    }
    else
    {
        <header><strong>@ProvenanceLabel(trace.Provenance) playback</strong><span>Presentation only · no actions run</span></header>
        @if (DataUnavailableReason is { Length: > 0 }) { <p class="flow-trace-warning">Some source or node data is unavailable: <code>@DataUnavailableReason</code>.</p> }
        @if (trace.Truncated) { <p class="flow-trace-warning">Some trace data was omitted to stay within the capture budget.</p> }
        <div class="flow-trace-controls" role="group" aria-label="Playback controls">
            <button type="button" data-trace-action="restart" aria-label="Restart playback">Restart</button>
            <button type="button" data-trace-action="previous" aria-label="Previous step">Previous</button>
            <button type="button" data-trace-action="play" aria-label="Play playback" aria-pressed="false">Play</button>
            <button type="button" data-trace-action="next" aria-label="Next step">Next</button>
            <label>Speed<select data-trace-speed aria-label="Playback speed"><option value="0.5">0.5×</option><option value="1" selected>1×</option><option value="2">2×</option><option value="4">4×</option></select></label>
            <button type="button" data-trace-action="exit">Exit replay</button>
            <output data-trace-position aria-live="polite">Step 1 of @trace.Steps.Count</output>
        </div>
        <div class="flow-trace-steps" role="group" aria-label="Captured steps">
            @for (var index = 0; index < trace.Steps.Count; index++)
            {
                var step = trace.Steps[index];
                <button type="button" data-trace-step="@index" aria-current="@(index == 0 ? "step" : null)">@($"{index + 1}. {step.NodeName}")</button>
            }
        </div>
        @for (var index = 0; index < trace.Steps.Count; index++)
        {
            var step = trace.Steps[index];
            <article class="flow-trace-step" data-trace-panel="@index" data-node-id="@step.NodeId" data-next-node-id="@step.NextNodeId" data-edge-id="@step.EdgeId" hidden="@(index != 0)" tabindex="0">
                <h4>@step.NodeName</h4>
                <dl>
                    <div><dt>Outcome</dt><dd>@step.Outcome · @step.Status</dd></div>
                    <div><dt>Data</dt><dd>@ProvenanceLabel(step.Provenance)</dd></div>
                    <div><dt>Attempt</dt><dd>@step.Attempt</dd></div>
                    <div><dt>Duration</dt><dd>@(step.DurationMilliseconds is { } duration ? $"{duration} ms" : "Not captured")</dd></div>
                    @if (step.SelectedPort is not null) { <div><dt>Chosen port</dt><dd>@step.SelectedPort</dd></div> }
                    @if (step.ErrorCode is not null) { <div><dt>Error</dt><dd>@step.ErrorCode</dd></div> }
                </dl>
                <details open><summary>Input · @StateLabel(step.Input.State)</summary><FlowTraceData Snapshot="step.Input" /></details>
                <details open><summary>Output · @StateLabel(step.Output.State)</summary><FlowTraceData Snapshot="step.Output" /></details>
                @if (step.Status == FlowTraceStepStatus.Planned)
                { <p>No external action was executed. An explicit sample result is required to preview downstream outcomes.</p> }
            </article>
        }
    }
</section>

@code {
    [Parameter] public FlowTraceDto? Trace { get; set; }
    [Parameter, EditorRequired] public string ContextKey { get; set; } = "";
    [Parameter] public string? ExpectedConfigurationHash { get; set; }
    [Parameter] public string? DataUnavailableReason { get; set; }
    [Parameter] public string? ScopeId { get; set; }
    [Parameter] public int? ExpectedGraphSchemaVersion { get; set; }
    private readonly string _id = "flow-trace-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module, _handle;
    private FlowTraceDto? _renderedTrace;
    private string? _renderedContext, _renderedHash, _renderedScope;
    private int? _renderedGraphSchema;
    private long _generation;
    private bool _pendingAttach, _disposed;
    private bool Stale => Trace is not null &&
        (ExpectedConfigurationHash is not null && !string.Equals(Trace.ConfigurationHash, ExpectedConfigurationHash, StringComparison.Ordinal) ||
         ExpectedGraphSchemaVersion is not null && Trace.GraphSchemaVersion != ExpectedGraphSchemaVersion);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_renderedTrace, Trace) && _renderedContext == ContextKey &&
            _renderedHash == ExpectedConfigurationHash && _renderedScope == ScopeId && _renderedGraphSchema == ExpectedGraphSchemaVersion) return;
        _renderedTrace = Trace; _renderedGraphSchema = ExpectedGraphSchemaVersion; _renderedContext = ContextKey; _renderedHash = ExpectedConfigurationHash; _renderedScope = ScopeId;
        ++_generation; _pendingAttach = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || !_pendingAttach) return;
        _pendingAttach = false;
        var generation = _generation;
        try
        {
            var old = _handle; _handle = null;
            if (old is not null) { await old.InvokeVoidAsync("dispose"); await old.DisposeAsync(); }
            if (_disposed || generation != _generation || Stale || Trace is not { SchemaVersion: 1, Steps.Count: > 0 }) return;
            var imported = _module is null;
            var module = _module ?? await JS.InvokeAsync<IJSObjectReference>("import", "./js/flows-playback.js");
            if (_disposed || generation != _generation) { if (imported) await module.DisposeAsync(); return; }
            _module = module;
            var handle = await module.InvokeAsync<IJSObjectReference?>("attach", _id, ContextKey);
            if (_disposed || generation != _generation)
            {
                if (handle is not null) { await handle.InvokeVoidAsync("dispose"); await handle.DisposeAsync(); }
                return;
            }
            _handle = handle;
        }
        catch (JSDisconnectedException) { _handle = null; }
    }

    private static string ProvenanceLabel(FlowTraceProvenance provenance) => provenance switch
    { FlowTraceProvenance.Simulated => "Simulated", FlowTraceProvenance.Recorded => "Recorded", FlowTraceProvenance.Actual => "Recorded execution", _ => "Unspecified" };
    private static string StateLabel(FlowTraceDataState state) => state switch
    { FlowTraceDataState.Missing => "Unavailable", FlowTraceDataState.Null => "Captured null", FlowTraceDataState.Empty => "Captured empty", FlowTraceDataState.Truncated => "Truncated", _ => "Captured" };

    public async ValueTask DisposeAsync()
    {
        _disposed = true; ++_generation;
        try
        {
            if (_handle is not null) { await _handle.InvokeVoidAsync("dispose"); await _handle.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { _handle = null; _module = null; }
    }
}
