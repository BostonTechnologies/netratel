@using System.Globalization
@using System.Text.Json
@using MudBlazor.Extensions
@using NetRatel.Shared.Contracts.Flows
@using NetRatel.Shared.Contracts.Netclaw
@using NetRatel.Web.Components.Pages.AIOps
@using NetRatel.Web.Services.Flows
@using VeloxDev.WorkflowSystem
@implements IAsyncDisposable
@inject IFlowApiService Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<NavigationLock ConfirmExternalNavigation="@(_dirty && !_allowNavigation)" OnBeforeInternalNavigation="BeforeNavigation" />
<section id="@_shellId" class="flow-editor @(_focused ? "focused" : "")" data-testid="flow-editor" data-history-enabled="@(!ReadOnly && EditingAllowed && !_busy ? "true" : "false")" aria-label="@(ReadOnly ? "Published flow viewer" : "Flow editor")" @onkeydown="KeyDown">
    @if (_loading || _adapter is null)
    {
        <header class="flow-editor-header"><h2>@(ReadOnly ? "Published version" : "Flow draft")</h2>
            <MudIconButton @ref="_closeButton" Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small" OnClick="RequestClose" Disabled="@_busy" aria-label="Close editor" data-testid="flow-close" />
        </header>
    }
    @if (_error is not null) { <div role="alert" class="flow-error" data-testid="flow-error">@_error</div> }
    @if (_loading) { <p role="status">Loading workflow…</p> }
    else if (_adapter is not null && _current is not null)
    {
        <div class="flow-toolbar">
            <label class="flow-name">Flow name<input @bind="_name" @bind:event="oninput" @bind:after="NameEdited" @onfocus="BeginNameEdit" @onblur="EndNameEdit" maxlength="@FlowLimits.MaximumNameLength" disabled="@(ReadOnly || _busy || !EditingAllowed)" data-testid="flow-name" /></label>
            <span class="flow-context">@TenantName</span>
            <span role="status" data-testid="flow-dirty">@(ReadOnly ? $"Immutable version {VersionNumber}" : _busy ? OperationLabel : _dirty ? "Unsaved changes" : $"Saved draft · revision {_current.Revision}")</span>
            <div class="flow-editor-actions">
            @if (!ReadOnly)
            {
                @if (_adapter.SchemaVersion == FlowLimits.SchemaVersion && SupportedDraftSchemas.Contains(FlowGraphV2Limits.SchemaVersion) && CanEdit)
                { <MudTooltip Text="Upgrade this draft to named outcomes; published versions stay immutable"><MudIconButton Icon="@Icons.Material.Filled.Upgrade" Size="MudBlazor.Size.Small" OnClick="UpgradeDraftAsync" Disabled="@_busy" aria-label="Upgrade draft to named outcomes" data-testid="flow-upgrade-draft" /></MudTooltip> }
                <MudTooltip Text="Undo last graph edit · Ctrl+Z"><MudIconButton Icon="@Icons.Material.Filled.Undo" Size="MudBlazor.Size.Small" OnClick="UndoAsync" Disabled="@(_busy || !EditingAllowed || !_history.CanUndo)" aria-label="Undo graph edit" data-testid="flow-undo" /></MudTooltip>
                <MudTooltip Text="Redo graph edit · Ctrl+Shift+Z"><MudIconButton Icon="@Icons.Material.Filled.Redo" Size="MudBlazor.Size.Small" OnClick="RedoAsync" Disabled="@(_busy || !EditingAllowed || !_history.CanRedo)" aria-label="Redo graph edit" data-testid="flow-redo" /></MudTooltip>
                <MudTooltip Text="@SaveHint"><MudIconButton Icon="@Icons.Material.Filled.Save" Size="MudBlazor.Size.Small" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_busy || !EditingAllowed || !_dirty)" aria-label="Save draft" data-testid="flow-save" /></MudTooltip>
                <MudTooltip Text="Validate draft"><MudIconButton Icon="@Icons.Material.Filled.FactCheck" Size="MudBlazor.Size.Small" OnClick="ValidateAsync" Disabled="@_busy" aria-label="Validate draft" data-testid="flow-validate" /></MudTooltip>
                <MudTooltip Text="Dry run · preview only"><MudIconButton Icon="@Icons.Material.Filled.Science" Size="MudBlazor.Size.Small" OnClick="TogglePreviewAsync" Disabled="@_busy" aria-expanded="@(_showDryRun ? "true" : "false")" aria-label="Dry run" data-testid="flow-dry-run-toggle" /></MudTooltip>
                <MudTooltip Text="@PublishHint"><MudIconButton Icon="@Icons.Material.Filled.Publish" Size="MudBlazor.Size.Small" OnClick="PublishAsync" Disabled="@(_busy || _dirty || !PublishingAllowed)" aria-label="Publish version" data-testid="flow-publish" /></MudTooltip>
                <MudTooltip Text="Reload saved draft"><MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="MudBlazor.Size.Small" OnClick="ReloadAsync" Disabled="@_busy" aria-label="Reload saved draft" data-testid="flow-reload" /></MudTooltip>
            }
            <MudTooltip Text="@(_paletteCollapsed ? "Show node library" : "Hide node library")"><MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="MudBlazor.Size.Small" OnClick="() => _paletteCollapsed = !_paletteCollapsed" aria-label="@(_paletteCollapsed ? "Show node library" : "Hide node library")" aria-expanded="@(!_paletteCollapsed ? "true" : "false")" data-testid="flow-palette-toggle" /></MudTooltip>
            <MudTooltip Text="Node properties"><MudIconButton Icon="@Icons.Material.Filled.Tune" Size="MudBlazor.Size.Small" OnClick="TogglePropertiesAsync" aria-expanded="@(_showProperties ? "true" : "false")" aria-label="Node properties" data-testid="flow-properties-toggle" /></MudTooltip>
            <MudTooltip Text="@(_focused ? "Exit fullscreen" : "Fullscreen workspace")"><MudIconButton Icon="@(_focused ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" Size="MudBlazor.Size.Small" OnClick="ToggleFocusAsync" aria-label="@(_focused ? "Exit fullscreen" : "Fullscreen workspace")" aria-pressed="@(_focused ? "true" : "false")" data-testid="flow-focus" /></MudTooltip>
            <MudTooltip Text="Close editor"><MudIconButton @ref="_closeButton" Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small" OnClick="RequestClose" Disabled="@_busy" aria-label="Close editor" data-testid="flow-close" /></MudTooltip>
            </div>
        </div>
        @if (_message is not null) { <p role="status" class="flow-notice" data-testid="flow-result">@_message</p> }

        @if (_issues.Count > 0)
        {
            <ul class="flow-issues" data-testid="flow-validation-issues">@foreach (var issue in _issues) { <li>@IssueText(issue) @NodeLabel(issue.NodeId)</li> }</ul>
        }
        @if ((_showDryRun || _previewSetupGraph?.SchemaVersion == FlowGraphV2Limits.SchemaVersion) && !ReadOnly)
        {
            <dialog id="@_previewId" class="flow-preview-dialog" aria-labelledby="@(_previewId + "-title")" data-testid="flow-preview-dialog" @onkeydown:stopPropagation>
            <header class="flow-preview-header"><h3 id="@(_previewId + "-title")">Preview sample</h3><MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small" OnClick="ClosePreviewAsync" aria-label="Close preview" data-testid="flow-preview-close" /></header>
            <p class="flow-help">Pure evaluation only. No script, job, AI turn, notification or incident is dispatched.</p>
            @if (_previewSetupGraph is { SchemaVersion: FlowGraphV2Limits.SchemaVersion } sampleGraph)
            {
                <FlowExecutionPreviewSetup Graph="sampleGraph" TenantId="Definition.TenantId" ContextKey="@($"{Definition.TenantId}:{Definition.Id:N}:{_shellId}")" Busy="_busy" Preview="DryRunExecutionAsync" />
                @if (_preview is not null)
                {
                    <div role="status" data-testid="flow-preview">@(_preview.Skipped ? "Sample event did not continue through this graph" : _preview.Valid ? "Preview only — no action sent" : "Preview could not validate the graph")
                        @if (_preview.Incident is { } fields) { <p><strong>@fields.Title</strong></p><p>@fields.Description</p><p>Priority: @(fields.Priority?.ToString() ?? "Connector default")</p> }
                    </div>
                }
            }
            else
            {
            <fieldset class="flow-dry-run" disabled="@_busy" data-testid="flow-dry-run-form"><legend>Sample alert</legend>
                <label>Rule name<input @bind="_sampleRule" /></label><label>Client name<input @bind="_sampleClient" /></label>
                <label>Resource<input @bind="_sampleResource" /></label><label>Metric<input @bind="_sampleMetric" /></label>
                <label>Severity<select @bind="_sampleSeverity"><option>warning</option><option>critical</option><option>info</option></select></label>
                <label>Numeric value<input type="number" step="any" @bind="_sampleValue" /></label>
                <label>Service state<input @bind="_sampleService" /></label>
                <button type="button" @onclick="DryRunAsync" data-testid="flow-dry-run">Preview sample</button>
                @if (_preview is not null)
                {
                    <div role="status" data-testid="flow-preview">@(_preview.Skipped ? "Skipped by condition" : _preview.Valid ? "Preview only — no action sent" : "Preview could not validate the graph")
                        @if (_preview.Incident is { } fields) { <p><strong>@fields.Title</strong></p><p>@fields.Description</p><p>Priority: @(fields.Priority?.ToString() ?? "Connector default")</p> }
                    </div>
                }
            </fieldset>
            }
            </dialog>
        }
        <MudDropContainer T="FlowNodeKind" Items="PaletteKinds" ItemsSelector="@((item, zone) => zone == "library")"
            ItemDisabled="@(kind => !CanInsert(kind))" CanDrop="CanDrop" ItemDropped="DropNodeAsync"
            ApplyDropClassesOnDragStarted="true" CanDropClass="flow-drop-allowed" NoDropClass="flow-drop-forbidden"
            Class="@($"flow-workspace {(_showProperties && _propertiesPinned ? "properties-docked" : "")} {(_paletteCollapsed ? "palette-collapsed" : "")}")">
            <ChildContent>
            @if (!_paletteCollapsed)
            {
            <aside class="flow-library" aria-label="Node library">
                <h3>Nodes</h3>
                <label>Search nodes<input type="search" @bind="_paletteQuery" @bind:event="oninput" placeholder="Name or category" data-testid="flow-palette-search" /></label>
                <MudDropZone T="FlowNodeKind" Identifier="library" Class="flow-palette" AllowReorder="false">
                    <ItemRenderer Context="kind">
                        <div class="flow-palette-item">
                            <MudDragHandle T="FlowNodeKind" Class="flow-palette-handle" aria-label="@($"Drag {KindLabel(kind)} to canvas")" data-testid="@($"flow-drag-{kind}")"><MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="MudBlazor.Size.Small" /></MudDragHandle>
                            <button type="button" class="flow-palette-label" @onclick="() => _paletteSelection = kind" data-testid="@($"flow-palette-{kind}")"><small class="flow-palette-category">@PaletteCategory(kind)</small><span class="flow-palette-name">@KindLabel(kind)</span></button>
                            <MudTooltip Text="@(CanInsert(kind) ? InsertHint(kind) : InsertBlockReason(kind))"><MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" OnClick="() => InsertNodeAsync(kind)" Disabled="@(!CanInsert(kind))" aria-label="@InsertHint(kind)" data-testid="@($"flow-add-{kind}")" /></MudTooltip>
                        </div>
                    </ItemRenderer>
                </MudDropZone>
                <p class="flow-help">@(_paletteSelection is { } palette ? PaletteHelp(palette) : "Drag a handle onto the canvas, or use its insert button.")</p>
                <p>@_adapter.Tree.Nodes.Count / @_adapter.MaximumNodes nodes</p>
                <label>Selected node<select value="@(_selected?.ToString() ?? "")" @onchange="SelectNode" data-testid="flow-select-node"><option value="">Choose a node</option>
                    @foreach (var n in _adapter.Capture().Nodes) { <option value="@n.Id">@n.Name</option> }
                </select></label>
            </aside>
            }
            <MudDropZone T="FlowNodeKind" Identifier="canvas" OnlyZone="true" Class="flow-canvas-column">
                <FlowCanvas @key="_adapter" @ref="_canvas" Adapter="_adapter" TenantId="Definition.TenantId" Connectors="Connectors" ReadOnly="@(ReadOnly || !EditingAllowed || _busy)" SelectedNodeId="_selected" Selected="SelectNodeAsync" Settings="OpenPropertiesAsync" Delete="RequestRemoveAsync" Changed="CheckDirty" Ready="CanvasReady" InitialViewport="_initialViewport" />
                @if (ReadOnly && RecordedRunId is { } runId)
                {
                    <div class="flow-playback-overlay">
                        <FlowTracePlayer @key="runId" Trace="RecordedTrace" ContextKey="@($"{Definition.TenantId}:{Definition.Id:N}:run:{runId:N}:{RecordedConfigurationHash}")"
                            DataUnavailableReason="@RecordedDataUnavailableReason" ExpectedConfigurationHash="@RecordedConfigurationHash" ExpectedGraphSchemaVersion="Definition.Draft.SchemaVersion" ScopeId="@_shellId" />
                    </div>
                }
                else if (_preview?.Trace is { } trace && _previewGraphHash is not null)
                {
                    <div class="flow-playback-overlay">
                        <FlowTracePlayer @key="trace" Trace="trace" ContextKey="@($"{Definition.TenantId}:{Definition.Id:N}:{_generation}:{_previewGraphHash}")"
                            ExpectedConfigurationHash="@_previewGraphHash" ExpectedGraphSchemaVersion="_previewGraphSchemaVersion" ScopeId="@_shellId" />
                    </div>
                }
            </MudDropZone>
            @if (_showProperties)
            {
                <aside class="flow-properties @(_propertiesPinned ? "docked" : "overlay")" aria-label="Node properties" data-testid="flow-properties">
                    <header @ref="_propertiesHeader" tabindex="-1"><h3>@(SelectedDefinition?.Name ?? "Node properties")</h3><div class="flow-editor-actions">
                        <MudTooltip Text="@(_propertiesPinned ? "Overlay properties" : "Dock properties")"><MudIconButton Icon="@Icons.Material.Filled.PushPin" Color="@(_propertiesPinned ? Color.Primary : Color.Default)" Size="MudBlazor.Size.Small" OnClick="() => _propertiesPinned = !_propertiesPinned" aria-label="@(_propertiesPinned ? "Overlay properties" : "Dock properties")" aria-pressed="@(_propertiesPinned ? "true" : "false")" data-testid="flow-properties-pin" /></MudTooltip>
                        <MudTooltip Text="Close properties"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small" OnClick="ClosePropertiesAsync" aria-label="Close properties" data-testid="flow-properties-close" /></MudTooltip>
                    </div></header>
                    <div class="flow-properties-body" @key="_generation">
                    @if (SelectedDefinition is { } selected)
                    {
                        <fieldset disabled="@(ReadOnly || !EditingAllowed || _busy)">
                            <legend>@KindLabel(selected.Kind)</legend>
                            <label>Node name<input value="@selected.Name" @onchange="e => UpdateNode(selected with { Name = e.Value?.ToString() ?? string.Empty })" maxlength="@FlowLimits.MaximumNameLength" data-testid="flow-node-name" /></label>
                            <div class="flow-coordinates"><label>X<input type="number" value="@Number(selected.Position.X)" @onchange="e => MoveNodeAsync(selected, true, e)" data-testid="flow-node-x" /></label>
                            <label>Y<input type="number" value="@Number(selected.Position.Y)" @onchange="e => MoveNodeAsync(selected, false, e)" data-testid="flow-node-y" /></label></div>
                            @if (_adapter.SchemaVersion == FlowGraphV2Limits.SchemaVersion)
                            {
                                @if (selected.Kind == FlowNodeKind.ExecutionEvent)
                                { <FlowExecutionTriggerFields @key="selected.Id" Node="selected" TenantId="Definition.TenantId" Disabled="@(ReadOnly || !EditingAllowed || _busy)" Changed="UpdateNode" /> }
                                @if (selected.Kind is FlowNodeKind.RunLibraryScript or FlowNodeKind.RunJob or FlowNodeKind.RerunOriginalExecution)
                                { <FlowExecutionActionFields @key="selected.Id" Node="selected" Graph="_adapter.Capture()" TenantId="Definition.TenantId" Disabled="@(ReadOnly || !EditingAllowed || _busy)" Changed="UpdateNode" /> }
                                @if (selected.Kind == FlowNodeKind.Condition)
                                { <FlowPredicateFields @key="selected.Id" Node="selected" Graph="_adapter.Capture()" Disabled="@(ReadOnly || !EditingAllowed || _busy)" Changed="UpdateNode" /> }
                                @if (selected.Kind == FlowNodeKind.MapIncident)
                                { <FlowMappingFields @key="selected.Id" Node="selected" Graph="_adapter.Capture()" Disabled="@(ReadOnly || !EditingAllowed || _busy)" Changed="UpdateNode" /> }
                            }
                            @if (selected.Kind == FlowNodeKind.Condition && _adapter.SchemaVersion == FlowLimits.SchemaVersion)
                            {
                                var condition = selected.Condition ?? new(FlowValueField.NumericValue, FlowComparison.GreaterThan, 90);
                                <label>Field<select value="@((int)condition.Field)" @onchange="e => UpdateConditionField(selected, e)" data-testid="flow-condition-field">@foreach (var field in Enum.GetValues<FlowValueField>()) { <option value="@((int)field)">@field</option> }</select></label>
                                <label>Comparison<select value="@((int)condition.Comparison)" @onchange="e => UpdateConditionComparison(selected, e)">@foreach (var comparison in Enum.GetValues<FlowComparison>()) { <option value="@((int)comparison)">@comparison</option> }</select></label>
                                @if (condition.Field == FlowValueField.NumericValue)
                                { <label>Value<input type="number" step="any" value="@condition.NumericValue" @onchange="e => UpdateConditionNumber(selected, e)" data-testid="flow-condition-value" /></label> }
                                else
                                { <label>Value<input value="@condition.TextValue" @onchange="e => UpdateNode(selected with { Condition = condition with { TextValue = e.Value?.ToString(), NumericValue = null } })" /></label> }
                            }
                            @if (selected.Kind == FlowNodeKind.MapIncident && _adapter.SchemaVersion == FlowLimits.SchemaVersion)
                            {
                                var mapping = selected.Mapping ?? new("{ruleName}: {resource}", "{clientName} — {metric}: {value}");
                                <label>Message / incident title<input value="@mapping.TitleTemplate" maxlength="@FlowLimits.MaximumTitleLength" @onchange="e => UpdateNode(selected with { Mapping = mapping with { TitleTemplate = e.Value?.ToString() ?? string.Empty } })" data-testid="flow-mapping-title" /></label>
                                <label>Description<textarea maxlength="@FlowLimits.MaximumTemplateLength" @onchange="e => UpdateNode(selected with { Mapping = mapping with { DescriptionTemplate = e.Value?.ToString() ?? string.Empty } })">@mapping.DescriptionTemplate</textarea></label>
                                <label>Priority<select value="@(mapping.Priority?.ToString() ?? "")" @onchange="e => UpdatePriority(selected, e)"><option value="">Connector default</option><option value="0">Low</option><option value="1">Normal</option><option value="2">High</option><option value="3">Urgent</option></select></label>
                                <p class="flow-help">The title and description feed every action. Priority applies to incident actions.</p>
                                <p class="flow-help">Fields: {ruleName}, {clientName}, {resource}, {metric}, {severity}, {value}, {serviceState}, {occurredAt}, {offlineSummary}, {offlineCount}, {offlineClients}, {aiSummary}, {aiEvidence}, {aiRecommendations}, {aiStatus}, {aiObservedAt}, {aiInvestigationId}. AI findings are also appended separately to the incident.</p>
                            }
                            @if (selected.Kind is FlowNodeKind.CreateIncident or FlowNodeKind.InvestigateWithAi)
                            {
                                <label>@(selected.Kind == FlowNodeKind.InvestigateWithAi ? "Netclaw connection" : "RatelDesk connector")<select value="@(selected.ConnectorId?.ToString() ?? "")" @onchange="e => SelectConnector(selected, e)" data-testid="flow-connector"><option value="">Choose an available reference</option>
                                    @foreach (var connector in Connectors.Where(c => c.TenantId == Definition.TenantId && c.Kind == TargetKind(selected))) { <option value="@connector.Id">@connector.Name @(connector.CanExecute && connector.Enabled ? "" : "(unavailable)")</option> }
                                </select></label>
                                @if (SelectedConnector(selected) is { } reference)
                                {
                                    @if (reference.Enabled && reference.CanExecute && selected.ConnectorRevision is { } revision && revision != reference.Revision)
                                    {
                                        <p role="status" data-testid="flow-connector-status">Target configuration changed. Use the updated target before publishing.</p>
                                        <button type="button" @onclick="() => UpdateNode(selected with { ConnectorRevision = reference.Revision })" data-testid="flow-connector-use-updated-target">Use updated target</button>
                                    }
                                    else
                                    { <p role="status" data-testid="flow-connector-status">@(reference.Enabled && reference.CanExecute ? "Available for authorized server execution" : $"Unavailable: {reference.UnavailableReason ?? (reference.Enabled ? "Receiver capability is not verified" : "Connector disabled")}")</p> }
                                }
                                else { <p role="status" data-testid="flow-connector-status">@(selected.Kind == FlowNodeKind.InvestigateWithAi ? "No owned Netclaw connection is available. Pair and verify one before publishing this action." : "No owned connector reference is available. Configure one in Flows connectors before publishing this action.")</p> }
                                @if (selected.Kind == FlowNodeKind.InvestigateWithAi)
                                {
                                    var ai = selected.AiSettings ?? new FlowAiSettingsDto();
                                    @if (_adapter.SchemaVersion == FlowGraphV2Limits.SchemaVersion)
                                    {
                                        <p class="flow-help">Diagnostic investigation preserves original execution evidence separately from findings. This server reports Unsupported when it cannot enforce diagnostic-only tools. Repair actions and linked reruns are configured as explicit graph nodes; follow the real outcome ports.</p>
                                    }
                                    else
                                    {
                                    <p class="flow-help">The output waits for this automated turn's committed result. It preserves the original alert and adds labelled AI findings to the downstream incident. Follow approval requests in AI Ops.</p>
                                    }
                                    <label>Investigation deadline (minutes)<input type="number" min="1" max="60" value="@ai.DeadlineMinutes" @onchange="e => UpdateAiDeadline(selected, e)" data-testid="flow-ai-deadline" /></label>
                                    @if (_adapter.SchemaVersion == FlowLimits.SchemaVersion)
                                    {
                                    <label>If the investigation is unsuccessful<select value="@((int)ai.FailureBehavior)" @onchange="e => UpdateAiFailureBehavior(selected, e)" data-testid="flow-ai-failure-behavior">
                                        <option value="@((int)FlowAiFailureBehavior.ContinueWithAlert)">Continue with original alert and labelled AI outcome</option>
                                        <option value="@((int)FlowAiFailureBehavior.StopFlow)">Stop and flag the flow</option>
                                    </select></label>
                                    }
                                    <p class="flow-help">Approval pauses until the deadline. Failed, timed-out or unconfirmed results never become successful findings.</p>
                                    @if (_adapter.SchemaVersion == FlowGraphV2Limits.SchemaVersion)
                                    { <FlowNamedInputFields @key="selected.Id" Node="selected" Graph="_adapter.Capture()" Disabled="@(ReadOnly || !EditingAllowed || _busy)" Changed="UpdateNode" /> }
                                    <PromptPicker @key="selected.Id" TenantId="Definition.TenantId" Selected="@(ai.OptionalPrompts ?? [])" SelectedChanged="references => UpdateAiPrompts(selected, references)"
                                        PinnedPrompts="ai.PinnedPrompts" Disabled="@(ReadOnly || !EditingAllowed || _busy)" />
                                    <a href="@($"/account/integration-credentials?tab=netclaw&tenantId={Definition.TenantId}")">Configure Netclaw</a>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Outlined" Size="MudBlazor.Size.Small" StartIcon="@Icons.Material.Filled.Link" OnClick="ConnectRatelDeskAsync" Disabled="@_busy" data-testid="flow-connect-rateldesk">Connect RatelDesk</MudButton>
                                    <a href="@($"/flows/connectors?tenantId={Definition.TenantId}")">Manage RatelDesk connectors</a>
                                }
                                @if (selected.Kind == FlowNodeKind.CreateIncident)
                                { <button type="button" @onclick="() => ConvertToGroup(selected)" data-testid="flow-convert-action-group">Add more actions</button> }
                            }
                            @if (selected.Kind == FlowNodeKind.ActionGroup)
                            {
                                <FlowActionGroupFields Node="selected" Targets="Connectors" TenantId="Definition.TenantId"
                                    Disabled="@(ReadOnly || !EditingAllowed || _busy)" Changed="UpdateNode" ManageTargetsRequested="ManageNotificationTargetsAsync" />
                            }
                            <button type="button" @onclick="() => RequestRemoveAsync(selected.Id)" data-testid="flow-remove-node">Remove node</button>
                        </fieldset>
                    }
                    else { <p>Select a node on the canvas or in the node list.</p> }
           </div>
                </aside>
            }
            </ChildContent>
        </MudDropContainer>
    }
</section>
@{ var leaveDialogGeneration = _leaveDialogGeneration; }
<MudDialog @key="leaveDialogGeneration" @ref="_leaveDialog" @onkeydown="UnsavedDialogKeyDown" data-testid="flow-unsaved-dialog" Visible="@(_pendingLeave is not null)" VisibleChanged="@(visible => LeaveDialogVisibleChanged(leaveDialogGeneration, visible))" AriaLabel="Unsaved changes" Options="_leaveOptions">
    <TitleContent><MudText Typo="Typo.h6">Unsaved changes</MudText></TitleContent>
    <DialogContent><div data-testid="flow-unsaved"><MudText>Unsaved changes are kept while you decide. Save your draft before leaving, discard the changes, or keep editing.</MudText>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" data-testid="flow-unsaved-error">@_error</MudAlert> }
    </div></DialogContent>
    <DialogActions>
        <MudButton OnClick="KeepEditingAsync" Disabled="@_busy" data-testid="flow-keep-editing">Keep editing</MudButton>
        <MudButton OnClick="DiscardLeaveAsync" Disabled="@_busy" data-testid="flow-discard">Discard changes</MudButton>
        <MudButton OnClick="SaveLeaveAsync" Disabled="@(_busy || !EditingAllowed)" Variant="Variant.Filled" Color="Color.Primary" data-testid="flow-save-leave">@(_busy ? "Saving…" : "Save and leave")</MudButton>
    </DialogActions>
</MudDialog>
<MudDialog @ref="_deleteDialog" Visible="@(_pendingDelete is not null)" VisibleChanged="DeleteDialogVisibleChanged" AriaLabel="Delete connected node" Options="_deleteOptions">
    <TitleContent><MudText Typo="Typo.h6">Delete connected node?</MudText></TitleContent>
    <DialogContent><MudText>Delete @NodeLabel(_pendingDelete) and its connections? The saved draft remains available until you save.</MudText></DialogContent>
    <DialogActions><MudButton OnClick="KeepNodeAsync">Keep node</MudButton><MudButton OnClick="ConfirmRemoveAsync" Color="Color.Error" data-testid="flow-delete-confirm">Delete node</MudButton></DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public FlowDefinitionDto Definition { get; set; } = default!;
    [Parameter] public string TenantName { get; set; } = "";
    [Parameter] public IReadOnlyList<FlowConnectorReferenceDto> Connectors { get; set; } = [];
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanPublish { get; set; }
    [Parameter] public IReadOnlyList<int> SupportedDraftSchemas { get; set; } = [FlowLimits.SchemaVersion];
