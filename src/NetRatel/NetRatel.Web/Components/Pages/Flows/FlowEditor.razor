            await replacement.RestoreAsync(graph, token);
            if (!Current(generation, tenant, id)) { await replacement.DisposeAsync(); return; }
            if (_showDryRun) await ClosePreviewAsync();
            if (!Current(generation, tenant, id)) { await replacement.DisposeAsync(); return; }
