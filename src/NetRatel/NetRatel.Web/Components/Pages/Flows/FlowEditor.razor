    private bool HasNodeKind(FlowNodeKind kind) => _adapter?.SchemaVersion == FlowGraphV2Limits.SchemaVersion
        ? FlowNodeCatalogue.IsTrigger(kind) && _adapter.Metadata.Values.Any(node => FlowNodeCatalogue.IsTrigger(node.Kind))
        : _adapter?.Metadata.Values.Any(node => FlowGraphValidator.IsTerminal(kind) ? FlowGraphValidator.IsTerminal(node.Kind) : node.Kind == kind) == true;
    private FlowEdgeDto? AiInsertionEdge => _adapter?.Capture() is { } graph ? graph.Edges.FirstOrDefault(edge =>
        graph.Nodes.Any(node => node.Id == edge.SourceNodeId && node.Kind == FlowNodeKind.MapIncident) &&
        graph.Nodes.Any(node => node.Id == edge.TargetNodeId && FlowGraphValidator.IsTerminal(node.Kind))) : null;
    private string InsertHint(FlowNodeKind kind) => _adapter?.SchemaVersion == FlowLimits.SchemaVersion && kind == FlowNodeKind.InvestigateWithAi && AiInsertionEdge is not null
        ? "Insert AI before the existing final action" : $"Insert {KindLabel(kind)} at canvas center";
    private void UpdateNode(FlowNodeDto node) { if (ReadOnly || !EditingAllowed || _busy || _adapter is null) return; _historyGroup = null; _adapter.Update(node); _ = CheckDirty(); }
    private Task MoveNodeAsync(FlowNodeDto definition, bool x, ChangeEventArgs args) => CommandAsync("move", async (tenant, id, token) =>
    {
        if (ReadOnly || !EditingAllowed || _adapter is null || !double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) || !double.IsFinite(value) || Math.Abs(value) > 20000) { _error = "Coordinates must be finite numbers within the canvas bounds."; return; }
        var generation = _generation;
        var position = x ? definition.Position with { X = value } : definition.Position with { Y = value };
        var node = _adapter.Metadata.Single(p => p.Value.Id == definition.Id).Key;
        await FlowCanvasAdapter.CompleteAsync(node.SetAnchorCommand, new VeloxDev.WorkflowSystem.Anchor(position.X, position.Y), token);
        if (Current(generation, tenant, id)) await CheckDirty();
    });
    private Task CanvasReady() => InvokeAsync(StateHasChanged);
    private bool CanInsert(FlowNodeKind kind) => EditingAllowed && !ReadOnly && !_busy && Enum.IsDefined(kind) && _canvas?.IsReady == true && _adapter is not null && _adapter.Tree.Nodes.Count < _adapter.MaximumNodes && !HasNodeKind(kind);
    private string InsertBlockReason(FlowNodeKind kind) => ReadOnly ? "Published versions are read only" : !CanEdit ? "Editing permission required" : !EditingAllowed ? "This server does not save this draft schema yet" : _busy ? "Wait for the current operation" : _canvas?.IsReady != true ? "Canvas is loading" : HasNodeKind(kind) ? _adapter?.SchemaVersion == FlowGraphV2Limits.SchemaVersion ? "The draft already has an alert or execution trigger" : FlowGraphValidator.IsTerminal(kind) ? "Open the current action settings and choose Add more actions" : $"The draft already has {KindLabel(kind)}" : "Node limit reached";
    private bool CanDrop(FlowNodeKind kind, string zone) => zone == "canvas" && CanInsert(kind);
    private async Task DropNodeAsync(MudItemDropInfo<FlowNodeKind> drop)
    {
        if (drop.DropzoneIdentifier != "canvas" || !CanInsert(drop.Item) || _canvas is null) { _error = "This node cannot be inserted in the current draft."; return; }
        var position = await _canvas.TakeDropPositionAsync();
        if (position is null) { _error = "Drop the handle inside the canvas to insert a node."; return; }
        await AddNodeAsync(drop.Item, position);
    }
    private async Task InsertNodeAsync(FlowNodeKind kind)
    {
        if (!CanInsert(kind)) return;
        var position = _canvas is not null ? await _canvas.CenterPositionAsync() : new FlowPositionDto(70, 140);
        if (position is not null) await AddNodeAsync(kind, position);
    }
    private Task AddNodeAsync(FlowNodeKind kind, FlowPositionDto position) => CommandAsync("add", async (tenant, id, token) =>
    {
        if (!EditingAllowed || ReadOnly || _adapter is null || HasNodeKind(kind)) return;
        var generation = _generation; var adapter = _adapter;
        var insertBefore = adapter.SchemaVersion == FlowLimits.SchemaVersion && kind == FlowNodeKind.InvestigateWithAi ? AiInsertionEdge : null;
        var executionSource = adapter.Metadata.Values.Any(node => node.Kind == FlowNodeKind.ExecutionEvent);
        var definition = new FlowNodeDto(Guid.NewGuid(), kind, KindLabel(kind), position,
            kind == FlowNodeKind.Condition && adapter.SchemaVersion == FlowLimits.SchemaVersion ? new(FlowValueField.NumericValue, FlowComparison.GreaterThan, 90) : null,
            kind == FlowNodeKind.MapIncident ? executionSource ? new("{definitionName}: {outcome}", "{targetName} — {rawStatus}: {reason}") : new("{ruleName}: {resource}", "{clientName} — {metric}: {value}") : null)
            { Actions = kind == FlowNodeKind.ActionGroup ? [new(Guid.NewGuid(), FlowActionKind.Discord)] : null,
              AiSettings = kind == FlowNodeKind.InvestigateWithAi ? new() : null,
              ExecutionTrigger = kind == FlowNodeKind.ExecutionEvent ? new([FlowExecutionSourceKind.Job], [FlowExecutionOutcome.Failed], FlowExecutionScope.AllInTenant) : null,
              Rerun = kind == FlowNodeKind.RerunOriginalExecution ? new() : null,
              Predicate = kind == FlowNodeKind.Condition && adapter.SchemaVersion == FlowGraphV2Limits.SchemaVersion
                ? new(new(FlowInputSource.Event, executionSource ? FlowDataType.Text : FlowDataType.Number, executionSource ? "event.outcome" : "alert.numericValue"),
                    executionSource ? FlowComparison.Equal : FlowComparison.GreaterThan, executionSource ? JsonSerializer.SerializeToElement(FlowNodeCatalogue.Failed) : JsonSerializer.SerializeToElement(90)) : null };
        await adapter.AddAsync(definition, token);
        if (insertBefore is not null)
        {
            await adapter.DisconnectAsync(insertBefore, token);
            await adapter.ConnectAsync(insertBefore.SourceNodeId, definition.Id, token);
            await adapter.ConnectAsync(definition.Id, insertBefore.TargetNodeId, token);
        }
        if (!Current(generation, tenant, id)) return; _selected = definition.Id;
        if (adapter.SchemaVersion == FlowGraphV2Limits.SchemaVersion) { _showProperties = true; _propertiesFocusPending = true; }
        await CheckDirty();
    });
    private async Task RequestRemoveAsync(Guid node)
    {
        if (!EditingAllowed || ReadOnly || _busy || _adapter?.Metadata.Values.Any(n => n.Id == node) != true) return;
        if (_adapter.Capture().Edges.Any(e => e.SourceNodeId == node || e.TargetNodeId == node)) { _pendingDelete = node; return; }
        await RemoveNodeAsync(node);
    }
    private void DeleteDialogVisibleChanged(bool visible) { if (!visible) _pendingDelete = null; }
    private async Task KeepNodeAsync()
    {
        if (_pendingDelete is not null && _deleteDialog is not null && _deleteDialog.GetState(dialog => dialog.Visible)) await _deleteDialog.CloseAsync();
        _pendingDelete = null;
    }
    private async Task ConfirmRemoveAsync() { if (_pendingDelete is not { } node) return; await KeepNodeAsync(); await RemoveNodeAsync(node); }
    private Task RemoveNodeAsync(Guid node) => CommandAsync("remove", async (tenant, id, token) =>
    {
        if (!EditingAllowed || ReadOnly) return;
        var generation = _generation; await _adapter!.RemoveAsync(node, token);
        if (!Current(generation, tenant, id)) return;
        if (_selected == node) { _selected = null; _showProperties = false; }
        await CheckDirty();
    });
    private string KindLabel(FlowNodeKind kind) => _adapter?.SchemaVersion == FlowGraphV2Limits.SchemaVersion ? FlowNodeCatalogue.Find(kind)?.Name ?? "Unsupported node" : FlowCanvas.KindLabel(kind);
    private string PaletteCategory(FlowNodeKind kind) => _adapter?.SchemaVersion == FlowGraphV2Limits.SchemaVersion ? FlowNodeCatalogue.Find(kind)?.Category ?? "Unavailable" : kind switch
    { FlowNodeKind.AlertRaised => "Events", FlowNodeKind.Condition => "Logic", FlowNodeKind.MapIncident => "Data",
      FlowNodeKind.InvestigateWithAi => "AI", _ => "Integrations" };
    private string PaletteHelp(FlowNodeKind kind) => _adapter?.SchemaVersion == FlowGraphV2Limits.SchemaVersion ? kind switch
    {
        FlowNodeKind.ExecutionEvent => "Subscribes to committed job, script and request outcomes, with tenant, definition and endpoint filters.",
        FlowNodeKind.RunLibraryScript => "Runs a permitted pinned library script and waits for its real terminal outcome.",
        FlowNodeKind.RunJob => "Runs a permitted pinned job on its own bound endpoint and waits for its real terminal outcome.",
        FlowNodeKind.RerunOriginalExecution => "Creates one bounded linked attempt from trusted original inputs, definition and endpoint. Unsupported requests remain explicit.",
        FlowNodeKind.Condition => "Compares a typed event field or earlier output and chooses True or False.",
        FlowNodeKind.MapIncident => "Maps original evidence and typed outputs into message fields.",
        FlowNodeKind.InvestigateWithAi => "Investigates failure without repair dispatch. Unsupported diagnostic tool policies stay explicit.",
        FlowNodeKind.Finish => "Ends this exclusive branch.",
        _ => FlowNodeCatalogue.Find(kind)?.Name ?? "Unsupported node."
    } : kind switch { FlowNodeKind.AlertRaised => "Starts when a monitoring occurrence fires.", FlowNodeKind.Condition => "Checks a selected alert value.", FlowNodeKind.MapIncident => "Sets the message title, description and incident priority.", FlowNodeKind.CreateIncident => "Delivers an incident through an approved RatelDesk connection.", FlowNodeKind.InvestigateWithAi => "Waits for one AI investigation before the next action. Insert it into an existing incident path to retain and enrich the incident.", FlowNodeKind.ActionGroup => "Runs notification, incident and AI actions independently.", _ => "Unsupported node." };
    private void UpdateConditionField(FlowNodeDto node, ChangeEventArgs e) { if (Enum.TryParse<FlowValueField>(e.Value?.ToString(), out var field)) UpdateNode(node with { Condition = field == FlowValueField.NumericValue ? new(field, FlowComparison.GreaterThan, 90) : new(field, FlowComparison.Equal, null, "") }); }
    private void UpdateConditionComparison(FlowNodeDto node, ChangeEventArgs e) { if (Enum.TryParse<FlowComparison>(e.Value?.ToString(), out var comparison)) UpdateNode(node with { Condition = (node.Condition ?? new(FlowValueField.NumericValue, comparison, 90)) with { Comparison = comparison } }); }
    private void UpdateConditionNumber(FlowNodeDto node, ChangeEventArgs e)
    {
        if (ReadOnly || !EditingAllowed || _busy || _adapter is null) return;
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) || !double.IsFinite(value))
        { _error = "Condition values must be finite numbers. The previous valid value is preserved."; return; }
        _error = null;
        UpdateNode(node with { Condition = (node.Condition ?? new(FlowValueField.NumericValue, FlowComparison.GreaterThan)) with { NumericValue = value, TextValue = null } });
    }
    private void UpdatePriority(FlowNodeDto node, ChangeEventArgs e) => UpdateNode(node with { Mapping = (node.Mapping ?? new("{ruleName}", "")) with { Priority = int.TryParse(e.Value?.ToString(), out var priority) ? priority : null } });
    private void SelectConnector(FlowNodeDto node, ChangeEventArgs e)
    {
        var reference = Guid.TryParse(e.Value?.ToString(), out var id) ? Connectors.FirstOrDefault(c => c.Id == id && c.TenantId == Definition.TenantId && c.Kind == TargetKind(node)) : null;
        UpdateNode(node with { ConnectorId = reference?.Id, ConnectorRevision = reference is { Revision: > 0 } ? reference.Revision : null });
    }
    private void UpdateAiDeadline(FlowNodeDto node, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var minutes) || minutes is < 1 or > 60) { _error = "Choose an investigation deadline between 1 and 60 minutes."; return; }
        UpdateNode(node with { AiSettings = (node.AiSettings ?? new()) with { DeadlineMinutes = minutes } });
    }
    private void UpdateAiFailureBehavior(FlowNodeDto node, ChangeEventArgs args)
    {
        if (Enum.TryParse<FlowAiFailureBehavior>(args.Value?.ToString(), out var behavior) && Enum.IsDefined(behavior))
            UpdateNode(node with { AiSettings = (node.AiSettings ?? new()) with { FailureBehavior = behavior } });
    }
    private void UpdateAiPrompts(FlowNodeDto node, IReadOnlyList<AiPromptReference> references) => UpdateNode(node with
    { AiSettings = (node.AiSettings ?? new()) with { OptionalPrompts = references.Count == 0 ? null : references.ToArray(), PinnedPrompts = null } });
    private static FlowActionKind TargetKind(FlowNodeDto node) => node.Kind == FlowNodeKind.InvestigateWithAi ? FlowActionKind.NetclawInvestigation : FlowActionKind.RatelDeskIncident;
    private FlowConnectorReferenceDto? SelectedConnector(FlowNodeDto node) => Connectors.FirstOrDefault(c => c.Id == node.ConnectorId && c.TenantId == Definition.TenantId && c.Kind == TargetKind(node));
    private string NodeLabel(Guid? id) => id is null ? "" : _adapter?.Metadata.Values.FirstOrDefault(n => n.Id == id)?.Name ?? "Unknown node";
    private static string Number(double value) => value.ToString("0.######", CultureInfo.InvariantCulture);
    private string IssueText(FlowValidationIssueDto issue)
    {
        if (_adapter?.SchemaVersion != FlowGraphV2Limits.SchemaVersion) return LegacyIssueText(issue);
        if (issue.Code.StartsWith("outcome-path-", StringComparison.Ordinal))
        {
            var outcome = issue.Code["outcome-path-".Length..];
            var node = _adapter.Metadata.Values.FirstOrDefault(value => value.Id == issue.NodeId);
            var name = node is null ? outcome.Replace('_', ' ') : FlowNodeCatalogue.Port(node.Kind, outcome, FlowPortDirection.Output)?.Name ?? outcome.Replace('_', ' ');
            return $"Connect the {name} outcome to another step or Finish.";
        }
        return issue.Code switch
        {
            "trigger-count" => "Keep exactly one alert or execution event trigger.",
            "execution-trigger" => "Choose execution sources, outcomes and an authorized tenant or selected-definition scope. An empty selection does not mean all.",
            "execution-action" or "execution-action-required" => "Choose an available library script or job, retain its definition and configure its inputs and endpoint.",
            "execution-definition-not-pinned" => "Publish must capture the selected definition revision, hash and native parameter schema.",
            "job-bound-target-required" => "Select a job with its own bound endpoint. Job actions do not substitute the source event endpoint.",
            "execution-parameters" or "input-type" or "input-unknown" => "Match the selected definition's parameter names and types. Review retained mappings after changing definitions.",
            "input-binding" or "input-required" => "Configure each required typed input from an allowed event field, earlier output or literal.",
            "input-unavailable" => "Choose an output from a node on every path to this step.",
            "input-path" or "unreachable-path" => "Connect every node from the selected trigger through an explicit outcome path.",
            "typed-port" => "Connect compatible output and input ports with the same type.",
            "outcome-fanout" => "Each named outcome supports one connection. Choose an explicit next step for each outcome.",
            "edge-id" or "edge-node" => "Keep stable, unique connections between nodes in this draft.",
            "edge-route" => $"Use at most {FlowGraphV2Limits.MaximumRoutePoints} finite route points within the canvas bounds.",
            "condition-ambiguous" => "Convert the stored legacy condition explicitly before configuring a typed condition.",
            "condition" or "condition-required" or "condition-source" => "Choose a typed input and a matching comparison value.",
            "rerun-budget" or "rerun-settings-required" => $"Configure a finite linked rerun budget from 1 to {FlowGraphV2Limits.MaximumRecoveryAttempts}. Unknown and unsupported executions remain explicit.",
            "graph-limit" or "graph-bytes" => $"Keep the draft within {FlowGraphV2Limits.MaximumNodes} nodes, {FlowGraphV2Limits.MaximumEdges} connections and the graph size limit.",
            _ => LegacyIssueText(issue)
        };
    }
    private static string LegacyIssueText(FlowValidationIssueDto issue) => issue.Code switch
    {
        "connector-required" or "connector-reference" or "connector-revision-required" => "Select an owned connector reference.",
        "unreachable-path" or "input-path" or "output-path" => "Connect every node from Alert raised through mapping to an action or action group.",
        "typed-port" => "Connect compatible alert or incident ports.", "fanout" => "Each port supports one connection.", "cycle" => "Remove the cyclic connection.",
        "mapping" or "mapping-required" => "Check incident templates and approved fields.", "condition" or "condition-required" => "Check condition field, comparison and value.",
        "node-catalogue" => "Use one trigger, one mapping, at most one AI step, one final action or action group, and at most one condition. AI may also end a path.", "graph-limit" or "graph-bytes" => "The draft exceeds the bounded graph size.",
        "ai-settings" => "Choose a deadline between 1 and 60 minutes and an explicit AI failure behavior.",
        "ai-prompts" or "ai-prompt-reference" or "ai-prompts-required" or "ai-prompt-snapshots" or "ai-prompts-not-pinned" => "Select available prompt revisions from this tenant and deliberately update unavailable revisions.",
        "actions-required" => "Add at least one target to the action group.", "action-limit" => $"An action group supports up to {FlowLimits.MaximumActionsPerGroup} targets.",
        "duplicate-action-target" => "Select each notification or incident target only once in a group.",
        "action-id" or "action-kind" or "action-name" => "Check the action group targets.",
        "node-layout" or "viewport-limit" => "Check node names and finite canvas geometry.", _ => "The graph contains an invalid definition (" + issue.Code + ")."
    };
    public async ValueTask DisposeAsync()
    {
        _disposed = true; ++_generation;
        await CloseLeaveDialogAsync(); await KeepNodeAsync();
        _pendingLeave = null;
        _lifetime.Cancel(); _lifetime.Dispose();
        if (_adapter is not null) await _adapter.DisposeAsync();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detachShell", _shellId); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { _module = null; }
        }
        _shellReference?.Dispose();
    }
