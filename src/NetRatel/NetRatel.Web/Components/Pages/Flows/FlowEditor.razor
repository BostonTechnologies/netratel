        var graph = snapshot.Graph with { Viewport = viewport };
        var replacement = new FlowCanvasAdapter();
        var generation = _generation; var tenant = _current.TenantId; var id = _current.Id; var token = _lifetime.Token;
        var installed = false;
        _busy = true; _restoringHistory = true; _operation = "history"; _error = null;
        try
