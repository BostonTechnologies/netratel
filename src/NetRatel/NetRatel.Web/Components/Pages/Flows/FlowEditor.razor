@using System.Globalization
@using System.Text.Json
@using NetRatel.Shared.Contracts.Flows
@using NetRatel.Web.Services.Flows
@using VeloxDev.WorkflowSystem
@implements IAsyncDisposable
@inject IFlowApiService Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<NavigationLock ConfirmExternalNavigation="@(_dirty && !_allowNavigation)" OnBeforeInternalNavigation="BeforeNavigation" />
<section class="flow-editor @(_focused ? "focused" : "")" data-testid="flow-editor" @onkeydown="KeyDown">
    <header class="flow-editor-header">
        <div><h2>@(ReadOnly ? "Published version" : "Flow draft")</h2><p>@TenantName · @(_current?.Name ?? Definition.Name)</p></div>
        <div class="flow-editor-actions">
            <MudTooltip Text="@(_focused ? "Exit editor focus" : "Expand editor")"><MudIconButton Icon="@(_focused ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" Size="MudBlazor.Size.Small" OnClick="() => _focused = !_focused" aria-label="@(_focused ? "Exit editor focus" : "Expand editor")" data-testid="flow-focus" /></MudTooltip>
            <MudTooltip Text="Close editor"><MudIconButton @ref="_closeButton" Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small" OnClick="RequestClose" Disabled="@_busy" aria-label="Close editor" data-testid="flow-close" /></MudTooltip>
        </div>
    </header>
    @if (_error is not null) { <div role="alert" class="flow-error" data-testid="flow-error">@_error</div> }
    @if (_loading) { <p role="status">Loading workflow…</p> }
    else if (_adapter is not null && _current is not null)
    {
        <div class="flow-toolbar">
            <label class="flow-name">Flow name<input @bind="_name" @bind:event="oninput" @bind:after="CheckDirty" maxlength="@FlowLimits.MaximumNameLength" disabled="@(ReadOnly || _busy || !CanEdit)" data-testid="flow-name" /></label>
            <span role="status" data-testid="flow-dirty">@(ReadOnly ? $"Immutable version {VersionNumber}" : _busy ? OperationLabel : _dirty ? "Unsaved changes" : $"Saved draft · revision {_current.Revision}")</span>
            <div class="flow-editor-actions">
            @if (!ReadOnly)
            {
                <MudTooltip Text="@SaveHint"><MudIconButton Icon="@Icons.Material.Filled.Save" Size="MudBlazor.Size.Small" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_busy || !CanEdit || !_dirty)" aria-label="Save draft" data-testid="flow-save" /></MudTooltip>
                <MudTooltip Text="Validate draft"><MudIconButton Icon="@Icons.Material.Filled.FactCheck" Size="MudBlazor.Size.Small" OnClick="ValidateAsync" Disabled="@_busy" aria-label="Validate draft" data-testid="flow-validate" /></MudTooltip>
                <MudTooltip Text="Dry run · preview only"><MudIconButton Icon="@Icons.Material.Filled.Science" Size="MudBlazor.Size.Small" OnClick="() => _showDryRun = !_showDryRun" Disabled="@_busy" aria-expanded="@(_showDryRun ? "true" : "false")" aria-label="Dry run" data-testid="flow-dry-run-toggle" /></MudTooltip>
                <MudTooltip Text="@PublishHint"><MudIconButton Icon="@Icons.Material.Filled.Publish" Size="MudBlazor.Size.Small" OnClick="PublishAsync" Disabled="@(_busy || _dirty || !CanPublish)" aria-label="Publish version" data-testid="flow-publish" /></MudTooltip>
                <MudTooltip Text="Reload saved draft"><MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="MudBlazor.Size.Small" OnClick="ReloadAsync" Disabled="@_busy" aria-label="Reload saved draft" data-testid="flow-reload" /></MudTooltip>
            }
            <MudTooltip Text="Node properties"><MudIconButton Icon="@Icons.Material.Filled.Tune" Size="MudBlazor.Size.Small" OnClick="TogglePropertiesAsync" aria-expanded="@(_showProperties ? "true" : "false")" aria-label="Node properties" data-testid="flow-properties-toggle" /></MudTooltip>
            </div>
        </div>
        @if (_message is not null) { <p role="status" class="flow-notice" data-testid="flow-result">@_message</p> }
        @if (ReadOnly) { <p class="flow-notice">This published graph is immutable. Draft edits and new versions cannot change its definition.</p> }

        @if (_issues.Count > 0)
        {
            <ul class="flow-issues" data-testid="flow-validation-issues">@foreach (var issue in _issues) { <li>@IssueText(issue) @NodeLabel(issue.NodeId)</li> }</ul>
        }
        @if (_showDryRun && !ReadOnly)
        {
            <fieldset class="flow-dry-run" disabled="@_busy" data-testid="flow-dry-run-form"><legend>Sample alert — preview only</legend>
                <label>Rule name<input @bind="_sampleRule" /></label><label>Client name<input @bind="_sampleClient" /></label>
                <label>Resource<input @bind="_sampleResource" /></label><label>Metric<input @bind="_sampleMetric" /></label>
                <label>Severity<select @bind="_sampleSeverity"><option>warning</option><option>critical</option><option>info</option></select></label>
                <label>Numeric value<input type="number" step="any" @bind="_sampleValue" /></label>
                <label>Service state<input @bind="_sampleService" /></label>
                <button type="button" @onclick="DryRunAsync" data-testid="flow-dry-run">Preview sample</button>
                @if (_preview is not null)
                {
                    <div role="status" data-testid="flow-preview">@(_preview.Skipped ? "Skipped by condition" : _preview.Valid ? "Preview only — no incident sent" : "Preview could not validate the graph")
                        @if (_preview.Incident is { } fields) { <p><strong>@fields.Title</strong></p><p>@fields.Description</p><p>Priority: @(fields.Priority?.ToString() ?? "Connector default")</p> }
                    </div>
                }
            </fieldset>
        }
        <MudDropContainer T="FlowNodeKind" Items="_nodeKinds" ItemsSelector="@((item, zone) => zone == "library")"
            ItemDisabled="@(kind => !CanInsert(kind))" CanDrop="CanDrop" ItemDropped="DropNodeAsync"
            ApplyDropClassesOnDragStarted="true" CanDropClass="flow-drop-allowed" NoDropClass="flow-drop-forbidden"
            Class="@($"flow-workspace {(_showProperties && _propertiesPinned ? "properties-docked" : "")}")">
            <ChildContent>
            <aside class="flow-library" aria-label="Node library">
                <h3>Nodes</h3>
                <MudDropZone T="FlowNodeKind" Identifier="library" Class="flow-palette" AllowReorder="false">
                    <ItemRenderer Context="kind">
                        <div class="flow-palette-item">
                            <MudDragHandle T="FlowNodeKind" Class="flow-palette-handle" aria-label="@($"Drag {FlowCanvas.KindLabel(kind)} to canvas")" data-testid="@($"flow-drag-{kind}")"><MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="MudBlazor.Size.Small" /></MudDragHandle>
                            <button type="button" class="flow-palette-label" @onclick="() => _paletteSelection = kind" data-testid="@($"flow-palette-{kind}")">@FlowCanvas.KindLabel(kind)</button>
                            <MudTooltip Text="@(CanInsert(kind) ? $"Insert {FlowCanvas.KindLabel(kind)} at canvas center" : InsertBlockReason(kind))"><MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="MudBlazor.Size.Small" OnClick="() => InsertNodeAsync(kind)" Disabled="@(!CanInsert(kind))" aria-label="@($"Insert {FlowCanvas.KindLabel(kind)} at canvas center")" data-testid="@($"flow-add-{kind}")" /></MudTooltip>
                        </div>
                    </ItemRenderer>
                </MudDropZone>
                <p class="flow-help">@(_paletteSelection is { } palette ? PaletteHelp(palette) : "Drag a handle onto the canvas, or use its insert button.")</p>
                <p>@_adapter.Tree.Nodes.Count / @FlowLimits.MaximumNodes nodes</p>
                <label>Selected node<select value="@(_selected?.ToString() ?? "")" @onchange="SelectNode" data-testid="flow-select-node"><option value="">Choose a node</option>
                    @foreach (var n in _adapter.Capture().Nodes) { <option value="@n.Id">@n.Name</option> }
                </select></label>
            </aside>
            <MudDropZone T="FlowNodeKind" Identifier="canvas" OnlyZone="true" Class="flow-canvas-column">
                <FlowCanvas @key="_adapter" @ref="_canvas" Adapter="_adapter" ReadOnly="@(ReadOnly || !CanEdit || _busy)" SelectedNodeId="_selected" Selected="SelectNodeAsync" Settings="OpenPropertiesAsync" Delete="RequestRemoveAsync" Changed="CheckDirty" Ready="CanvasReady" InitialViewport="_initialViewport" />
            </MudDropZone>
            @if (_showProperties)
            {
                <aside class="flow-properties @(_propertiesPinned ? "docked" : "overlay")" aria-label="Node properties" data-testid="flow-properties">
                    <header @ref="_propertiesHeader" tabindex="-1"><h3>@(SelectedDefinition?.Name ?? "Node properties")</h3><div class="flow-editor-actions">
                        <MudTooltip Text="@(_propertiesPinned ? "Overlay properties" : "Dock properties")"><MudIconButton Icon="@Icons.Material.Filled.PushPin" Color="@(_propertiesPinned ? Color.Primary : Color.Default)" Size="MudBlazor.Size.Small" OnClick="() => _propertiesPinned = !_propertiesPinned" aria-label="@(_propertiesPinned ? "Overlay properties" : "Dock properties")" aria-pressed="@(_propertiesPinned ? "true" : "false")" data-testid="flow-properties-pin" /></MudTooltip>
                        <MudTooltip Text="Close properties"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small" OnClick="ClosePropertiesAsync" aria-label="Close properties" data-testid="flow-properties-close" /></MudTooltip>
                    </div></header>
                    <div class="flow-properties-body">
                    @if (SelectedDefinition is { } selected)
                    {
                        <fieldset disabled="@(ReadOnly || !CanEdit || _busy)">
                            <legend>@FlowCanvas.KindLabel(selected.Kind)</legend>
                            <label>Node name<input value="@selected.Name" @onchange="e => UpdateNode(selected with { Name = e.Value?.ToString() ?? string.Empty })" maxlength="@FlowLimits.MaximumNameLength" data-testid="flow-node-name" /></label>
                            <div class="flow-coordinates"><label>X<input type="number" value="@Number(selected.Position.X)" @onchange="e => MoveNodeAsync(selected, true, e)" data-testid="flow-node-x" /></label>
                            <label>Y<input type="number" value="@Number(selected.Position.Y)" @onchange="e => MoveNodeAsync(selected, false, e)" data-testid="flow-node-y" /></label></div>
                            @if (selected.Kind == FlowNodeKind.Condition)
                            {
                                var condition = selected.Condition ?? new(FlowValueField.NumericValue, FlowComparison.GreaterThan, 90);
                                <label>Field<select value="@((int)condition.Field)" @onchange="e => UpdateConditionField(selected, e)" data-testid="flow-condition-field">@foreach (var field in Enum.GetValues<FlowValueField>()) { <option value="@((int)field)">@field</option> }</select></label>
                                <label>Comparison<select value="@((int)condition.Comparison)" @onchange="e => UpdateConditionComparison(selected, e)">@foreach (var comparison in Enum.GetValues<FlowComparison>()) { <option value="@((int)comparison)">@comparison</option> }</select></label>
                                @if (condition.Field == FlowValueField.NumericValue)
                                { <label>Value<input type="number" step="any" value="@condition.NumericValue" @onchange="e => UpdateConditionNumber(selected, e)" data-testid="flow-condition-value" /></label> }
                                else
                                { <label>Value<input value="@condition.TextValue" @onchange="e => UpdateNode(selected with { Condition = condition with { TextValue = e.Value?.ToString(), NumericValue = null } })" /></label> }
                            }
                            @if (selected.Kind == FlowNodeKind.MapIncident)
                            {
                                var mapping = selected.Mapping ?? new("{ruleName}: {resource}", "{clientName} — {metric}: {value}");
                                <label>Incident title<input value="@mapping.TitleTemplate" maxlength="@FlowLimits.MaximumTitleLength" @onchange="e => UpdateNode(selected with { Mapping = mapping with { TitleTemplate = e.Value?.ToString() ?? string.Empty } })" data-testid="flow-mapping-title" /></label>
                                <label>Description<textarea maxlength="@FlowLimits.MaximumTemplateLength" @onchange="e => UpdateNode(selected with { Mapping = mapping with { DescriptionTemplate = e.Value?.ToString() ?? string.Empty } })">@mapping.DescriptionTemplate</textarea></label>
                                <label>Priority<select value="@(mapping.Priority?.ToString() ?? "")" @onchange="e => UpdatePriority(selected, e)"><option value="">Connector default</option><option value="0">Low</option><option value="1">Normal</option><option value="2">High</option><option value="3">Urgent</option></select></label>
                                <p class="flow-help">Fields: {ruleName}, {clientName}, {resource}, {metric}, {severity}, {value}, {serviceState}, {occurredAt}.</p>
                            }
                            @if (selected.Kind == FlowNodeKind.CreateIncident)
                            {
                                <label>RatelDesk connector<select value="@(selected.ConnectorId?.ToString() ?? "")" @onchange="e => SelectConnector(selected, e)" data-testid="flow-connector"><option value="">Choose an available reference</option>
                                    @foreach (var connector in Connectors.Where(c => c.TenantId == Definition.TenantId)) { <option value="@connector.Id">@connector.Name @(connector.CanExecute && connector.Enabled ? "" : "(unavailable)")</option> }
                                </select></label>
                                @if (SelectedConnector(selected) is { } reference)
                                { <p role="status" data-testid="flow-connector-status">@(reference.Enabled && reference.CanExecute ? "Available for authorized server execution" : $"Unavailable: {reference.UnavailableReason ?? (reference.Enabled ? "Receiver capability is not verified" : "Connector disabled")}")</p> }
                                else { <p role="status" data-testid="flow-connector-status">No owned connector reference is available. Configure one in Flows connectors before publishing this action.</p> }
                                <MudButton Variant="Variant.Outlined" Size="MudBlazor.Size.Small" StartIcon="@Icons.Material.Filled.Link" OnClick="ConnectRatelDeskAsync" Disabled="@_busy" data-testid="flow-connect-rateldesk">Connect RatelDesk</MudButton>
                                <a href="@($"/flows/connectors?tenantId={Definition.TenantId}")">Manage RatelDesk connectors</a>
                            }
                            <button type="button" @onclick="() => RequestRemoveAsync(selected.Id)" data-testid="flow-remove-node">Remove node</button>
                        </fieldset>
                    }
                    else { <p>Select a node on the canvas or in the node list.</p> }
                    <fieldset disabled="@(ReadOnly || !CanEdit || _busy)" class="flow-connections"><legend>Connections</legend>
                        <label>From<select @bind="_from" data-testid="flow-connect-from"><option value="">Choose output</option>@foreach (var n in _adapter.Capture().Nodes.Where(n => n.Kind != FlowNodeKind.CreateIncident)) { <option value="@n.Id">@n.Name · @FlowCanvasAdapter.OutputType(n.Kind)</option> }</select></label>
                        <label>To<select @bind="_to" data-testid="flow-connect-to"><option value="">Choose input</option>@foreach (var n in _adapter.Capture().Nodes.Where(n => n.Kind != FlowNodeKind.AlertRaised)) { <option value="@n.Id">@n.Name · @FlowCanvasAdapter.InputType(n.Kind)</option> }</select></label>
                        <button type="button" @onclick="ConnectAsync" data-testid="flow-connect">Connect ports</button>
                        @foreach (var edge in _adapter.Capture().Edges)
                        { <p class="flow-edge">@NodeLabel(edge.SourceNodeId) → @NodeLabel(edge.TargetNodeId)<button type="button" @onclick="() => DisconnectAsync(edge)" aria-label="@($"Disconnect {NodeLabel(edge.SourceNodeId)} from {NodeLabel(edge.TargetNodeId)}")">Remove</button></p> }
                    </fieldset>
                    </div>
                </aside>
            }
            </ChildContent>
        </MudDropContainer>
    }
</section>
<MudDialog @ref="_leaveDialog" @onkeydown="UnsavedDialogKeyDown" data-testid="flow-unsaved-dialog" Visible="@(_pendingLeave is not null)" VisibleChanged="LeaveDialogVisibleChanged" AriaLabel="Unsaved changes" Options="_leaveOptions">
    <TitleContent><MudText Typo="Typo.h6">Unsaved changes</MudText></TitleContent>
    <DialogContent><div data-testid="flow-unsaved"><MudText>Unsaved changes are kept while you decide. Save your draft before leaving, discard the changes, or keep editing.</MudText>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" data-testid="flow-unsaved-error">@_error</MudAlert> }
    </div></DialogContent>
    <DialogActions>
        <MudButton OnClick="KeepEditingAsync" Disabled="@_busy" data-testid="flow-keep-editing">Keep editing</MudButton>
        <MudButton OnClick="DiscardLeaveAsync" Disabled="@_busy" data-testid="flow-discard">Discard changes</MudButton>
        <MudButton OnClick="SaveLeaveAsync" Disabled="@(_busy || !CanEdit)" Variant="Variant.Filled" Color="Color.Primary" data-testid="flow-save-leave">@(_busy ? "Saving…" : "Save and leave")</MudButton>
    </DialogActions>
</MudDialog>
<MudDialog @ref="_deleteDialog" Visible="@(_pendingDelete is not null)" VisibleChanged="DeleteDialogVisibleChanged" AriaLabel="Delete connected node" Options="_deleteOptions">
    <TitleContent><MudText Typo="Typo.h6">Delete connected node?</MudText></TitleContent>
    <DialogContent><MudText>Delete @NodeLabel(_pendingDelete) and its connections? The saved draft remains available until you save.</MudText></DialogContent>
    <DialogActions><MudButton OnClick="() => _pendingDelete = null">Keep node</MudButton><MudButton OnClick="ConfirmRemoveAsync" Color="Color.Error" data-testid="flow-delete-confirm">Delete node</MudButton></DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public FlowDefinitionDto Definition { get; set; } = default!;
    [Parameter] public string TenantName { get; set; } = "";
    [Parameter] public IReadOnlyList<FlowConnectorReferenceDto> Connectors { get; set; } = [];
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanPublish { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public int VersionNumber { get; set; }
    [Parameter] public EventCallback<FlowDefinitionDto> Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<bool> DirtyChanged { get; set; }
    [Parameter] public Guid? InitialSelectedNodeId { get; set; }
    private FlowDefinitionDto? _current;
    private FlowCanvasAdapter? _adapter;
    private FlowCanvas? _canvas;
    private FlowViewportDto _initialViewport = new();
    private Guid? _selected;
    private string _name = "", _baseline = "", _from = "", _to = "";
    private bool _dirty, _busy, _loading, _disposed, _showProperties, _propertiesPinned, _focused, _showDryRun, _focusPending, _propertiesFocusPending, _allowNavigation;
    private Guid? _pendingDelete;
    private FlowNodeKind? _paletteSelection;
    private Func<Task>? _pendingLeave;
    private IJSObjectReference? _module;
    private static readonly FlowNodeKind[] _nodeKinds = Enum.GetValues<FlowNodeKind>();
    private static readonly DialogOptions _leaveOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false, CloseOnEscapeKey = false };
    private static readonly DialogOptions _deleteOptions = _leaveOptions with { CloseOnEscapeKey = true };
    private string OperationLabel => _operation switch { "save" => "Saving draft…", "validate" => "Validating…", "publish" => "Publishing version…", "preview" => "Previewing sample…", _ => "Updating draft…" };
    private string SaveHint => _busy ? "Wait for the current operation" : !CanEdit ? "Editing permission required" : !_dirty ? "Draft already saved" : "Save draft";
    private string PublishHint => _busy ? "Wait for the current operation" : !CanPublish ? "Publishing permission required" : _dirty ? "Save your draft before publishing" : "Publish version";
    private string? _error, _message, _operation, _reviewedFingerprint;
    private IReadOnlyList<FlowValidationIssueDto> _issues = [];
    private FlowDryRunResultDto? _preview;
    private CancellationTokenSource _lifetime = new();
    private int _generation;
    private MudIconButton? _closeButton;
    private MudDialog? _leaveDialog, _deleteDialog;
    private ElementReference _propertiesHeader;
    private string _sampleRule = "Disk capacity", _sampleClient = "Sample client", _sampleResource = "/", _sampleMetric = "disk.used.percent", _sampleSeverity = "warning", _sampleService = "";
    private double? _sampleValue = 95;
    private readonly Guid _sampleAgentId = Guid.NewGuid(), _sampleRuleId = Guid.NewGuid();
    private FlowNodeDto? SelectedDefinition => _adapter?.Capture().Nodes.FirstOrDefault(n => n.Id == _selected);
    protected override async Task OnParametersSetAsync()
    {
        if (_current?.Id == Definition.Id && _current.TenantId == Definition.TenantId && _current.Revision == Definition.Revision) return;
        _lifetime.Cancel(); _lifetime.Dispose(); _lifetime = new(); var generation = ++_generation;
        _loading = true; _error = null; _busy = false;
        await ReplaceAsync(Definition, generation, _lifetime.Token);
    }
    private async Task ReplaceAsync(FlowDefinitionDto definition, int generation, CancellationToken token)
    {
        var replacement = new FlowCanvasAdapter();
        try
        {
            await replacement.RestoreAsync(definition.Draft, token);
            if (!Current(generation, definition.TenantId, definition.Id)) { await replacement.DisposeAsync(); return; }
            var old = _adapter; _adapter = replacement; _canvas = null; _current = definition; _name = definition.Name;
            _initialViewport = definition.Draft.Viewport; _selected = definition.Draft.Nodes.FirstOrDefault(n => n.Id == InitialSelectedNodeId)?.Id ?? definition.Draft.Nodes.FirstOrDefault()?.Id;
            _showProperties = InitialSelectedNodeId is not null && _selected == InitialSelectedNodeId;
            _baseline = Fingerprint(definition.Name, definition.Draft); _dirty = false; _issues = []; _preview = null; _reviewedFingerprint = null; _focusPending = true;
            if (old is not null) await old.DisposeAsync();
            await DirtyChanged.InvokeAsync(false);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { await replacement.DisposeAsync(); }
        catch (Exception) { await replacement.DisposeAsync(); if (Current(generation, definition.TenantId, definition.Id)) _error = "The draft cannot be displayed safely. Reload the saved flow or contact an administrator."; }
        finally { if (Current(generation, definition.TenantId, definition.Id)) _loading = false; }
    }
    private bool Current(int generation, int tenant, Guid id) => !_disposed && generation == _generation && Definition.TenantId == tenant && Definition.Id == id;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_propertiesFocusPending && _showProperties) { _propertiesFocusPending = false; _focusPending = false; await _propertiesHeader.FocusAsync(); }
        else if (_focusPending && !_loading && _closeButton is not null) { _focusPending = false; await _closeButton.FocusAsync(); }
    }
    private static string Fingerprint(string name, FlowGraphDto graph) => name + "\n" + JsonSerializer.Serialize(graph);
    private async Task CheckDirty()
    {
        if (ReadOnly || _adapter is null || _disposed) return;
        var fingerprint = Fingerprint(_name, _canvas?.CaptureCurrent() ?? _adapter.Capture(_initialViewport.ScrollX, _initialViewport.ScrollY));
        if (_reviewedFingerprint is not null && _reviewedFingerprint != fingerprint)
        { _reviewedFingerprint = null; _issues = []; _preview = null; _message = "Draft changed. Validate the current draft."; }
        var next = fingerprint != _baseline;
        if (next == _dirty) return; _dirty = next; await DirtyChanged.InvokeAsync(next);
    }
    private async Task CommandAsync(string operation, Func<int, Guid, CancellationToken, Task> command)
    {
        if (_busy || _disposed || _current is null) return;
        var generation = _generation; var tenant = _current.TenantId; var id = _current.Id;
        _busy = true; _operation = operation; _error = null; _message = null; _issues = [];
        try { await command(tenant, id, _lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (HttpRequestException exception) { if (Current(generation, tenant, id)) _error = exception is FlowApiException ? exception.Message : "The flow request failed. Your unsaved edits are preserved. Try again."; }
        catch (InvalidOperationException exception) when (operation is "connect" or "add") { if (Current(generation, tenant, id)) _error = exception.Message; }
        catch (Exception) { if (Current(generation, tenant, id)) _error = "The workflow operation could not finish. Your unsaved edits are preserved."; }
        finally { if (Current(generation, tenant, id)) { _busy = false; _operation = null; } }
    }
    private async Task<FlowGraphDto> CaptureAsync() => _canvas is not null ? await _canvas.CaptureAsync() : _adapter!.Capture(_initialViewport.ScrollX, _initialViewport.ScrollY);
    private Task SaveAsync() => !CanEdit || ReadOnly ? Task.CompletedTask : CommandAsync("save", async (tenant, id, token) =>
    {
        var generation = _generation; var nameAtSubmit = _name; var graph = await CaptureAsync();
        var result = FlowGraphValidator.ValidateDraft(graph);
        if (!result.Valid) { _issues = result.Issues; _message = "The draft has unsafe or invalid fields. Correct these before saving."; return; }
        var saved = await Api.SaveAsync(tenant, id, new(_current!.Revision, nameAtSubmit, graph), token);
        if (!Current(generation, tenant, id) || saved.TenantId != tenant || saved.Id != id || saved.Revision <= _current.Revision) return;
        _current = saved; if (_name == nameAtSubmit) _name = saved.Name; _baseline = Fingerprint(saved.Name, saved.Draft);
        _dirty = Fingerprint(_name, _canvas?.CaptureCurrent() ?? _adapter!.Capture(_initialViewport.ScrollX, _initialViewport.ScrollY)) != _baseline;
        _message = _dirty ? "Submitted draft saved. Newer canvas changes remain unsaved. No action ran." : "Draft saved. No action ran.";
        await DirtyChanged.InvokeAsync(_dirty); await Saved.InvokeAsync(saved);
    });
    private Task ValidateAsync() => CommandAsync("validate", async (tenant, id, token) =>
    {
        var generation = _generation; var graph = await CaptureAsync(); var reviewed = Fingerprint(_name, graph);
        var result = await Api.ValidateAsync(tenant, graph, token);
        if (!Current(generation, tenant, id)) return;
        _reviewedFingerprint = reviewed; _issues = result.Issues; _message = result.Valid ? "Valid complete graph. No action ran." : "Complete graph validation found issues.";
        await CheckDirty();
    });
    private Task DryRunAsync() => CommandAsync("preview", async (tenant, id, token) =>
    {
        var generation = _generation;
        var input = new FlowEventDataDto(_sampleAgentId, _sampleRuleId, _sampleRule, _sampleClient, _sampleResource, _sampleMetric, _sampleSeverity, _sampleValue, string.IsNullOrWhiteSpace(_sampleService) ? null : _sampleService, DateTimeOffset.UtcNow);
        var graph = await CaptureAsync(); var reviewed = Fingerprint(_name, graph);
        var result = await Api.DryRunAsync(tenant, new(graph, input), token);
        if (!Current(generation, tenant, id)) return;
        _reviewedFingerprint = reviewed; _preview = result; _issues = result.Issues; await CheckDirty();
    });
    private Task PublishAsync() => ReadOnly || !CanPublish || _dirty ? Task.CompletedTask : CommandAsync("publish", async (tenant, id, token) =>
    {
        var generation = _generation; var version = await Api.PublishAsync(tenant, id, new(_current!.Revision), token);
        if (!Current(generation, tenant, id) || version.TenantId != tenant || version.FlowId != id) return;
        var saved = await Api.GetAsync(tenant, id, token);
        if (!Current(generation, tenant, id) || saved.TenantId != tenant || saved.Id != id || saved.Revision <= _current.Revision) return;
        _current = saved; _message = $"Published immutable version {version.VersionNumber}. No action ran."; await Saved.InvokeAsync(saved);
    });
    private Task ReloadAsync() => RequestLeaveAsync(ReloadConfirmedAsync);
    private Task ReloadConfirmedAsync() => CommandAsync("reload", async (tenant, id, token) =>
    {
        var generation = _generation; var saved = await Api.GetAsync(tenant, id, token);
        if (!Current(generation, tenant, id) || saved.Id != id || saved.TenantId != tenant || saved.Revision < _current!.Revision) return;
        await ReplaceAsync(saved, generation, token); _message = "Saved draft reloaded.";
    });
    public async Task RequestLeaveAsync(Func<Task> destination)
    {
        if (_busy || _disposed || _pendingLeave is not null) return;
        if (_pendingDelete is not null) { _pendingDelete = null; if (_deleteDialog is not null) await _deleteDialog.CloseAsync(); }
        if (_dirty) { _pendingLeave = destination; await InvokeAsync(StateHasChanged); return; }
        await destination();
    }
    private Task BeforeNavigation(LocationChangingContext context)
    {
        if (!_dirty || _allowNavigation) return Task.CompletedTask;
        context.PreventNavigation();
        var target = context.TargetLocation;
        return RequestLeaveAsync(() => { _allowNavigation = true; Navigation.NavigateTo(target); return Task.CompletedTask; });
    }
    private Task RequestClose() => RequestLeaveAsync(DiscardClose);
    private async Task DiscardClose() { _lifetime.Cancel(); ++_generation; await DirtyChanged.InvokeAsync(false); await Closed.InvokeAsync(); }
    private async Task KeepEditingAsync()
    {
        _pendingLeave = null;
        if (_canvas is not null) await _canvas.FocusAsync();
    }
    private Task UnsavedDialogKeyDown(KeyboardEventArgs args) => args.Key == "Escape" && !_busy ? KeepEditingAsync() : Task.CompletedTask;
    private Task LeaveDialogVisibleChanged(bool visible) => !visible && !_busy && !_disposed ? KeepEditingAsync() : Task.CompletedTask;
    private async Task DiscardLeaveAsync()
    {
        if (_busy || _pendingLeave is not { } destination) return;
        var generation = _generation;
        _pendingLeave = null; _dirty = false; await DirtyChanged.InvokeAsync(false);
        if (_leaveDialog is not null) await _leaveDialog.CloseAsync();
        await destination();
        if (!_disposed && generation == _generation) await CheckDirty();
    }
    private async Task SaveLeaveAsync()
    {
        if (_busy || _pendingLeave is not { } destination) return;
        await SaveAsync();
        if (_dirty || _error is not null || _disposed) return;
        _pendingLeave = null; if (_leaveDialog is not null) await _leaveDialog.CloseAsync(); await destination();
    }
    private async Task KeyDown(KeyboardEventArgs args)
    {
        if (_pendingLeave is not null || _pendingDelete is not null) return;
        if (args.Key == "Escape") { if (_showProperties) await ClosePropertiesAsync(); else await RequestClose(); }
        else if (args.Key == "Delete" && _selected is { } node && !ReadOnly && CanEdit && !_busy)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/flows-editor.js");
            if (!await _module.InvokeAsync<bool>("isEditing")) await RequestRemoveAsync(node);
        }
    }
    private void SelectNode(ChangeEventArgs args) => _selected = Guid.TryParse(args.Value?.ToString(), out var id) && _adapter?.Metadata.Values.Any(n => n.Id == id) == true ? id : null;
    private Task SelectNodeAsync(Guid id) { _selected = id; return Task.CompletedTask; }
    private Task OpenPropertiesAsync(Guid id) { _selected = id; _showProperties = true; _propertiesFocusPending = true; return Task.CompletedTask; }
    private Task TogglePropertiesAsync()
    {
        if (_showProperties) return ClosePropertiesAsync();
        _showProperties = true; _propertiesFocusPending = true; return Task.CompletedTask;
    }
    private async Task ClosePropertiesAsync()
    { _showProperties = false; if (_canvas is not null) await _canvas.FocusNodeSettingsAsync(_selected); }
    private Task ConnectRatelDeskAsync()
    {
        var returnUrl = $"/flows?tenantId={Definition.TenantId}&draftId={Definition.Id:D}&nodeId={_selected:D}";
        return RequestLeaveAsync(() => { _allowNavigation = true; Navigation.NavigateTo($"/account/integration-credentials?purpose=helpdesk-m2m&tenant_id={Definition.TenantId}&returnUrl={Uri.EscapeDataString(returnUrl)}"); return Task.CompletedTask; });
    }
    private void UpdateNode(FlowNodeDto node) { if (ReadOnly || !CanEdit || _busy || _adapter is null) return; _adapter.Update(node); _ = CheckDirty(); }
    private Task MoveNodeAsync(FlowNodeDto definition, bool x, ChangeEventArgs args) => CommandAsync("move", async (tenant, id, token) =>
    {
        if (ReadOnly || !CanEdit || _adapter is null || !double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) || !double.IsFinite(value) || Math.Abs(value) > 20000) { _error = "Coordinates must be finite numbers within the canvas bounds."; return; }
        var generation = _generation;
        var position = x ? definition.Position with { X = value } : definition.Position with { Y = value };
        var node = _adapter.Metadata.Single(p => p.Value.Id == definition.Id).Key;
        await FlowCanvasAdapter.CompleteAsync(node.SetAnchorCommand, new VeloxDev.WorkflowSystem.Anchor(position.X, position.Y), token);
        if (Current(generation, tenant, id)) await CheckDirty();
    });
    private Task CanvasReady() => InvokeAsync(StateHasChanged);
    private bool CanInsert(FlowNodeKind kind) => CanEdit && !ReadOnly && !_busy && Enum.IsDefined(kind) && _canvas?.IsReady == true && _adapter is not null && _adapter.Tree.Nodes.Count < FlowLimits.MaximumNodes && !_adapter.Metadata.Values.Any(n => n.Kind == kind);
    private string InsertBlockReason(FlowNodeKind kind) => ReadOnly ? "Published versions are read only" : !CanEdit ? "Editing permission required" : _busy ? "Wait for the current operation" : _canvas?.IsReady != true ? "Canvas is loading" : _adapter?.Metadata.Values.Any(n => n.Kind == kind) == true ? $"The draft already has {FlowCanvas.KindLabel(kind)}" : "Node limit reached";
    private bool CanDrop(FlowNodeKind kind, string zone) => zone == "canvas" && CanInsert(kind);
    private async Task DropNodeAsync(MudItemDropInfo<FlowNodeKind> drop)
    {
        if (drop.DropzoneIdentifier != "canvas" || !CanInsert(drop.Item) || _canvas is null) { _error = "This node cannot be inserted in the current draft."; return; }
        var position = await _canvas.TakeDropPositionAsync();
        if (position is null) { _error = "Drop the handle inside the canvas to insert a node."; return; }
        await AddNodeAsync(drop.Item, position);
    }
    private async Task InsertNodeAsync(FlowNodeKind kind)
    {
        if (!CanInsert(kind)) return;
        var position = _canvas is not null ? await _canvas.CenterPositionAsync() : new FlowPositionDto(70, 140);
        if (position is not null) await AddNodeAsync(kind, position);
    }
    private Task AddNodeAsync(FlowNodeKind kind, FlowPositionDto position) => CommandAsync("add", async (tenant, id, token) =>
    {
        if (!CanEdit || ReadOnly || _adapter is null || _adapter.Metadata.Values.Any(n => n.Kind == kind)) return;
        var generation = _generation; var adapter = _adapter;
        var definition = new FlowNodeDto(Guid.NewGuid(), kind, FlowCanvas.KindLabel(kind), position,
            kind == FlowNodeKind.Condition ? new(FlowValueField.NumericValue, FlowComparison.GreaterThan, 90) : null,
            kind == FlowNodeKind.MapIncident ? new("{ruleName}: {resource}", "{clientName} — {metric}: {value}") : null);
        await adapter.AddAsync(definition, token); if (!Current(generation, tenant, id)) return; _selected = definition.Id; await CheckDirty();
    });
    private async Task RequestRemoveAsync(Guid node)
    {
        if (!CanEdit || ReadOnly || _busy || _adapter?.Metadata.Values.Any(n => n.Id == node) != true) return;
        if (_adapter.Capture().Edges.Any(e => e.SourceNodeId == node || e.TargetNodeId == node)) { _pendingDelete = node; return; }
        await RemoveNodeAsync(node);
    }
    private void DeleteDialogVisibleChanged(bool visible) { if (!visible) _pendingDelete = null; }
    private async Task ConfirmRemoveAsync() { if (_pendingDelete is not { } node) return; _pendingDelete = null; await RemoveNodeAsync(node); }
    private Task RemoveNodeAsync(Guid node) => CommandAsync("remove", async (tenant, id, token) =>
    {
        if (!CanEdit || ReadOnly) return;
        var generation = _generation; await _adapter!.RemoveAsync(node, token);
        if (!Current(generation, tenant, id)) return;
        if (_selected == node) { _selected = null; _showProperties = false; }
        _from = _from == node.ToString() ? "" : _from; _to = _to == node.ToString() ? "" : _to;
        await CheckDirty();
    });
    private static string PaletteHelp(FlowNodeKind kind) => kind switch { FlowNodeKind.AlertRaised => "Starts when a monitoring occurrence fires.", FlowNodeKind.Condition => "Checks a selected alert value.", FlowNodeKind.MapIncident => "Sets the incident title, description and priority.", FlowNodeKind.CreateIncident => "Delivers an incident through an approved RatelDesk connection.", _ => "Unsupported node." };
    private Task ConnectAsync() => CommandAsync("connect", async (tenant, id, token) =>
    { if (!CanEdit || ReadOnly || !Guid.TryParse(_from, out var from) || !Guid.TryParse(_to, out var to)) { _error = "Select an output and an input."; return; } var generation = _generation; await _adapter!.ConnectAsync(from, to, token); if (Current(generation, tenant, id)) await CheckDirty(); });
    private Task DisconnectAsync(FlowEdgeDto edge) => CommandAsync("disconnect", async (tenant, id, token) => { if (!CanEdit || ReadOnly) return; var generation = _generation; await _adapter!.DisconnectAsync(edge, token); if (Current(generation, tenant, id)) await CheckDirty(); });
    private void UpdateConditionField(FlowNodeDto node, ChangeEventArgs e) { if (Enum.TryParse<FlowValueField>(e.Value?.ToString(), out var field)) UpdateNode(node with { Condition = field == FlowValueField.NumericValue ? new(field, FlowComparison.GreaterThan, 90) : new(field, FlowComparison.Equal, null, "") }); }
    private void UpdateConditionComparison(FlowNodeDto node, ChangeEventArgs e) { if (Enum.TryParse<FlowComparison>(e.Value?.ToString(), out var comparison)) UpdateNode(node with { Condition = (node.Condition ?? new(FlowValueField.NumericValue, comparison, 90)) with { Comparison = comparison } }); }
    private void UpdateConditionNumber(FlowNodeDto node, ChangeEventArgs e)
    {
        if (ReadOnly || !CanEdit || _busy || _adapter is null) return;
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) || !double.IsFinite(value))
        { _error = "Condition values must be finite numbers. The previous valid value is preserved."; return; }
        _error = null;
        UpdateNode(node with { Condition = (node.Condition ?? new(FlowValueField.NumericValue, FlowComparison.GreaterThan)) with { NumericValue = value, TextValue = null } });
    }
    private void UpdatePriority(FlowNodeDto node, ChangeEventArgs e) => UpdateNode(node with { Mapping = (node.Mapping ?? new("{ruleName}", "")) with { Priority = int.TryParse(e.Value?.ToString(), out var priority) ? priority : null } });
    private void SelectConnector(FlowNodeDto node, ChangeEventArgs e)
    {
        var reference = Guid.TryParse(e.Value?.ToString(), out var id) ? Connectors.FirstOrDefault(c => c.Id == id && c.TenantId == Definition.TenantId) : null;
        UpdateNode(node with { ConnectorId = reference?.Id, ConnectorRevision = reference is { Revision: > 0 } ? reference.Revision : null });
    }
    private FlowConnectorReferenceDto? SelectedConnector(FlowNodeDto node) => Connectors.FirstOrDefault(c => c.Id == node.ConnectorId && c.TenantId == Definition.TenantId);
    private string NodeLabel(Guid? id) => id is null ? "" : _adapter?.Metadata.Values.FirstOrDefault(n => n.Id == id)?.Name ?? "Unknown node";
    private static string Number(double value) => value.ToString("0.######", CultureInfo.InvariantCulture);
    private static string IssueText(FlowValidationIssueDto issue) => issue.Code switch
    {
        "connector-required" or "connector-reference" or "connector-revision-required" => "Select an owned connector reference.",
        "unreachable-path" or "input-path" or "output-path" => "Connect every node in one path from Alert raised to Create incident.",
        "typed-port" => "Connect compatible alert or incident ports.", "fanout" => "Each port supports one connection.", "cycle" => "Remove the cyclic connection.",
        "mapping" or "mapping-required" => "Check incident templates and approved fields.", "condition" or "condition-required" => "Check condition field, comparison and value.",
        "node-catalogue" => "Use one trigger, one mapping, one action and at most one condition.", "graph-limit" or "graph-bytes" => "The draft exceeds the bounded graph size.",
        "node-layout" or "viewport-limit" => "Check node names and finite canvas geometry.", _ => "The graph contains an invalid definition (" + issue.Code + ")."
    };
    public async ValueTask DisposeAsync()
    {
        _disposed = true; ++_generation; _pendingLeave = null; _pendingDelete = null;
        _lifetime.Cancel(); _lifetime.Dispose();
        if (_leaveDialog is not null) await _leaveDialog.CloseAsync();
        if (_deleteDialog is not null) await _deleteDialog.CloseAsync();
        if (_adapter is not null) await _adapter.DisposeAsync();
        if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
