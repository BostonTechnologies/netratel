@page "/account/security"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using System.Text
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using NetRatel.Web.Services.Authentication
@using QRCoder
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILocalAccountApiService LocalAccountApi
@inject NavigationManager Navigation

<PageTitle>Account security</PageTitle>
<NavigationLock OnBeforeInternalNavigation="GuardNavigationAsync" ConfirmExternalNavigation="@(_busy || _recoveryCodes is { Count: > 0 })" />
<MudContainer MaxWidth="MaxWidth.Large" Class="security-page" data-testid="account-security-page">
    @if (_interactiveReady) { <span hidden data-testid="account-security-client-ready"></span> }
    <MudText Typo="Typo.h4">Account security</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">Manage how you sign in.</MudText>
    @if (!_isLocalAccount)
    {
        <MudAlert Severity="Severity.Info" data-testid="account-security-managed">Your organization manages this account. Change your sign-in settings with your identity provider.</MudAlert>
    }
    else if (_loading)
    {
        <MudGrid Spacing="3" data-testid="security-status-loading"><MudItem xs="12" md="6"><MudSkeleton Height="180px" /></MudItem><MudItem xs="12" md="6"><MudSkeleton Height="180px" /></MudItem></MudGrid>
    }
    else if (_status is null)
    {
        <MudAlert Severity="Severity.Error" data-testid="security-status-error">Security status is unavailable. No changes were made. <MudButton Variant="Variant.Text" OnClick="LoadStatusAsync">Retry</MudButton></MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6"><MudPaper Class="security-card" Elevation="1"><MudStack Spacing="2">
                <MudText Typo="Typo.h6">Passphrase</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Change the passphrase for local sign-in. You will sign in again afterwards.</MudText>
                <MudSpacer /><MudButton @ref="_passwordOpener" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenPassword" data-testid="open-password-dialog">Change passphrase</MudButton>
            </MudStack></MudPaper></MudItem>
            <MudItem xs="12" md="6"><MudPaper Class="security-card" Elevation="1"><MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6">Authenticator app</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@(_status.TwoFactorEnabled ? Color.Success : Color.Default)">@(_status.TwoFactorEnabled ? "Enabled" : "Not enabled")</MudChip>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@(_status.TwoFactorEnabled ? "An authenticator code is required at sign-in." : "Add a second step to protect your local account.")</MudText>
                <MudSpacer />
                @if (_status.TwoFactorEnabled)
                { <MudButton @ref="_mfaOpener" Variant="Variant.Outlined" OnClick="OpenDisable" data-testid="manage-mfa">Manage authenticator</MudButton> }
                else
                { <MudButton @ref="_mfaOpener" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenEnrollment" data-testid="open-mfa-setup">Set up authenticator</MudButton> }
            </MudStack></MudPaper></MudItem>
        </MudGrid>
    }
</MudContainer>

<MudDialog Visible="_passwordDialog" VisibleChanged="PasswordVisibleChanged" AriaLabel="Change passphrase" Options="@(new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false, FullWidth = true, MaxWidth = MaxWidth.Medium })">
    <DialogContent><MudStack Spacing="3" Class="security-dialog">
        <MudText Typo="Typo.h6">Change passphrase</MudText>
        <MudText Typo="Typo.body2">Use at least @_status?.MinimumPassphraseLength characters. Existing sessions will end when you save.</MudText>
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        <MudTextField Label="Current passphrase" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_passwordCurrent" autocomplete="current-password" data-testid="change-password-current" />
        <MudTextField Label="New passphrase" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_passwordNew" autocomplete="new-password" data-testid="change-password-new" />
        <MudTextField Label="Confirm new passphrase" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_passwordConfirm" autocomplete="new-password" data-testid="change-password-confirm" />
        @if (!CanChangePassword) { <MudText Typo="Typo.caption">Enter your current passphrase and matching new passphrases of the required length.</MudText> }
    </MudStack></DialogContent>
    <DialogActions><MudButton OnClick="ClosePassword" Disabled="_busy">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !CanChangePassword)" OnClick="ChangePasswordAsync" data-testid="change-local-password">Change passphrase</MudButton></DialogActions>
</MudDialog>

<MudDialog Visible="_enrollmentDialog" VisibleChanged="EnrollmentVisibleChanged" AriaLabel="Set up authenticator" Options="@(new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false, FullWidth = true, MaxWidth = MaxWidth.Medium })">
    <DialogContent><MudStack Spacing="3" Class="security-dialog">
        <MudText Typo="Typo.h6">Set up authenticator</MudText>
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        @if (_recoveryCodes is { Count: > 0 })
        {
            <MudAlert Severity="Severity.Warning" data-testid="mfa-recovery-codes"><MudText Typo="Typo.subtitle1">Save these recovery codes now</MudText><MudText Typo="Typo.body2">Each works once. They will not be shown again.</MudText>
            @foreach (var recoveryCode in _recoveryCodes) { <div><span class="mud-typography-caption" data-testid="mfa-recovery-code">@recoveryCode</span></div> }
            </MudAlert>
        }
        else if (_authenticatorSetup is null)
        {
            <MudText Typo="Typo.body2">Confirm your current passphrase. An active authenticator cannot be silently replaced.</MudText>
            <MudTextField Label="Current passphrase" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_setupPassword" autocomplete="current-password" data-testid="mfa-setup-current-password" />
        }
        else
        {
            <MudText Typo="Typo.body2">Scan with your authenticator app, or enter the key manually. Then enter the code from the app.</MudText>
            <div class="security-qr" data-testid="mfa-authenticator-secret"><img src="@_qrDataUrl" alt="Authenticator enrollment QR code" /></div>
            <MudTextField Label="Manual setup key" Variant="Variant.Outlined" Value="_authenticatorSetup.SharedKey" ReadOnly="true" />
            <MudTextField Label="Authenticator code" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_enrollmentCode" autocomplete="one-time-code" data-testid="mfa-enrollment-code" />
        }
    </MudStack></DialogContent>
    <DialogActions>
        @if (_recoveryCodes is { Count: > 0 })
        { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FinishEnrollment" Disabled="_busy" data-testid="finish-mfa-enrollment">I saved the recovery codes</MudButton> }
        else
        {
            <MudButton OnClick="CloseEnrollment" Disabled="_busy">Cancel</MudButton>
            @if (_authenticatorSetup is null)
            { <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_setupPassword))" OnClick="BeginMfaSetupAsync" data-testid="begin-mfa-setup">Continue</MudButton> }
            else
            { <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_enrollmentCode))" OnClick="EnableMfaAsync" data-testid="enable-mfa">Verify and enable</MudButton> }
        }
    </DialogActions>
</MudDialog>

<MudDialog Visible="_disableDialog" VisibleChanged="DisableVisibleChanged" AriaLabel="Disable authenticator" Options="@(new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false, FullWidth = true, MaxWidth = MaxWidth.Medium })">
    <DialogContent><MudStack Spacing="3" Class="security-dialog">
        <MudText Typo="Typo.h6">Disable authenticator</MudText>
        <MudAlert Severity="Severity.Warning">Your account will no longer require an authenticator code. You will sign in again afterwards.</MudAlert>
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        <MudTextField Label="Current passphrase" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_disablePassword" autocomplete="current-password" data-testid="disable-mfa-current-password" />
        <MudTextField Label="Current authenticator code" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_disableCode" autocomplete="one-time-code" data-testid="disable-mfa-code" />
    </MudStack></DialogContent>
    <DialogActions><MudButton OnClick="CloseDisable" Disabled="_busy">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(_busy || string.IsNullOrWhiteSpace(_disablePassword) || string.IsNullOrWhiteSpace(_disableCode))" OnClick="DisableMfaAsync" data-testid="disable-mfa">Disable authenticator</MudButton></DialogActions>
</MudDialog>

@code {
    private bool _isLocalAccount, _loading, _busy, _passwordDialog, _enrollmentDialog, _disableDialog, _interactiveReady;
    private bool _disposed;
    private MudButton? _passwordOpener, _mfaOpener;
    private MudButton? _pendingFocus;
    private int _enrollmentGeneration;
    private string? _error, _passwordCurrent, _passwordNew, _passwordConfirm, _setupPassword, _enrollmentCode, _disablePassword, _disableCode, _qrDataUrl;
    private LocalSecurityStatus? _status;
    private AuthenticatorSetup? _authenticatorSetup;
    private IReadOnlyList<string>? _recoveryCodes;
    private bool CanChangePassword => !string.IsNullOrWhiteSpace(_passwordCurrent) && _passwordNew is { Length: var length } &&
        length >= (_status?.MinimumPassphraseLength ?? int.MaxValue) && string.Equals(_passwordNew, _passwordConfirm, StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        _isLocalAccount = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.HasClaim("auth_mode", "local");
        if (_isLocalAccount) await LoadStatusAsync();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        _interactiveReady = true;
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _pendingFocus is not { } opener) return;
        _pendingFocus = null;
        await opener.FocusAsync();
    }
    private async Task LoadStatusAsync()
    {
        if (_disposed) return;
        _loading = true;
        try { var status = await LocalAccountApi.GetSecurityStatusAsync(); if (!_disposed) _status = status; }
        catch (HttpRequestException) { if (!_disposed) _status = null; }
        finally { if (!_disposed) _loading = false; }
    }
    private void OpenPassword() { if (_busy || _disposed) return; _error = null; _passwordDialog = true; }
    private void OpenEnrollment() { if (_busy || _disposed || _enrollmentDialog) return; _enrollmentGeneration++; _error = null; _enrollmentDialog = true; }
    private void OpenDisable() { if (_busy || _disposed) return; _error = null; _disableDialog = true; }
    private void ClosePassword() => PasswordVisibleChanged(false);
    private void CloseEnrollment() => EnrollmentVisibleChanged(false);
    private void CloseDisable() => DisableVisibleChanged(false);
    private void PasswordVisibleChanged(bool value) { if (_busy || _disposed) return; _passwordDialog = value; if (!value) { _passwordCurrent = _passwordNew = _passwordConfirm = _error = null; _pendingFocus = _passwordOpener; } }
    private void EnrollmentVisibleChanged(bool value)
    {
        if (_disposed || !value && (_busy || _recoveryCodes is { Count: > 0 })) return;
        _enrollmentDialog = value;
        if (!value) { _enrollmentGeneration++; _setupPassword = _enrollmentCode = _qrDataUrl = _error = null; _authenticatorSetup = null; _pendingFocus = _mfaOpener; }
    }
    private void DisableVisibleChanged(bool value) { if (_busy || _disposed) return; _disableDialog = value; if (!value) { _disablePassword = _disableCode = _error = null; _pendingFocus = _mfaOpener; } }

    private async Task ChangePasswordAsync()
    {
        if (_busy || !CanChangePassword) return;
        _busy = true; _error = null;
        try
        {
            await LocalAccountApi.ChangePasswordAsync(new(_passwordCurrent!, _passwordNew!));
            if (_disposed) return;
            _busy = false;
            ClosePassword();
            Navigation.NavigateTo("/logout", true);
        }
        catch (HttpRequestException exception)
        {
            if (_disposed) return;
            _error = exception.StatusCode switch
            {
                System.Net.HttpStatusCode.BadRequest => "The current passphrase was not accepted, or the new one does not meet policy.",
                System.Net.HttpStatusCode.TooManyRequests => "Too many security attempts. Wait a minute before trying again.",
                _ => "The account service is unavailable. Your entries remain so you can retry."
            };
        }
        finally { if (!_disposed) _busy = false; }
    }
    private async Task BeginMfaSetupAsync()
    {
        if (_busy || !_enrollmentDialog || _disposed || string.IsNullOrWhiteSpace(_setupPassword)) return;
        var generation = _enrollmentGeneration;
        var password = _setupPassword;
        _busy = true; _error = null;
        try
        {
            var setup = await LocalAccountApi.BeginTwoFactorSetupAsync(password);
            if (!IsCurrentEnrollment(generation)) return;
            _authenticatorSetup = setup;
            _setupPassword = null;
            using var generator = new QRCodeGenerator();
            using var data = generator.CreateQrCode(setup.AuthenticatorUri, QRCodeGenerator.ECCLevel.Q);
            _qrDataUrl = "data:image/svg+xml;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(new SvgQRCode(data).GetGraphic(4)));
        }
        catch (HttpRequestException exception)
        {
            if (!IsCurrentEnrollment(generation)) return;
            _error = exception.StatusCode switch
            {
                System.Net.HttpStatusCode.Conflict => "An authenticator is already enabled. Disable it with its current code before replacing it.",
                System.Net.HttpStatusCode.BadRequest => "The current passphrase was not accepted.",
                System.Net.HttpStatusCode.TooManyRequests => "Too many security attempts. Wait a minute before trying again.",
                _ => "The account service is unavailable. Your passphrase remains here so you can retry."
            };
        }
        finally { if (IsCurrentEnrollment(generation)) _busy = false; }
    }
    private async Task EnableMfaAsync()
    {
        if (_busy || !_enrollmentDialog || _disposed || _authenticatorSetup is null || string.IsNullOrWhiteSpace(_enrollmentCode)) return;
        var generation = _enrollmentGeneration;
        var code = _enrollmentCode;
        _busy = true; _error = null;
        try
        {
            var codes = await LocalAccountApi.EnableTwoFactorAsync(code);
            if (!IsCurrentEnrollment(generation)) return;
            _recoveryCodes = codes;
            _authenticatorSetup = null;
            _enrollmentCode = _qrDataUrl = null;
        }
        catch (HttpRequestException exception)
        {
            if (!IsCurrentEnrollment(generation)) return;
            _error = exception.StatusCode switch
            {
                System.Net.HttpStatusCode.BadRequest => "The code was not accepted. Check the authenticator clock and try again.",
                System.Net.HttpStatusCode.TooManyRequests => "Too many security attempts. Wait a minute before trying again.",
                _ => "The account service is unavailable. Your enrollment remains here so you can retry."
            };
        }
        finally { if (IsCurrentEnrollment(generation)) _busy = false; }
    }
    private bool IsCurrentEnrollment(int generation) => !_disposed && _enrollmentDialog && _enrollmentGeneration == generation;
    private Task GuardNavigationAsync(LocationChangingContext context)
    {
        if (_busy || _recoveryCodes is { Count: > 0 }) context.PreventNavigation();
        return Task.CompletedTask;
    }
    private async Task DisableMfaAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_disablePassword) || string.IsNullOrWhiteSpace(_disableCode)) return;
        _busy = true; _error = null;
        try
        {
            await LocalAccountApi.DisableTwoFactorAsync(new(_disablePassword, _disableCode));
            if (_disposed) return;
            _busy = false;
            CloseDisable();
            Navigation.NavigateTo("/logout", true);
        }
        catch (HttpRequestException exception)
        {
            if (_disposed) return;
            _error = exception.StatusCode switch
            {
                System.Net.HttpStatusCode.BadRequest => "The passphrase or authenticator code was not accepted.",
                System.Net.HttpStatusCode.TooManyRequests => "Too many security attempts. Wait a minute before trying again.",
                _ => "The account service is unavailable. Your entries remain so you can retry."
            };
        }
        finally { if (!_disposed) _busy = false; }
    }
    private void FinishEnrollment()
    {
        if (_busy || _disposed || _recoveryCodes is not { Count: > 0 }) return;
        _recoveryCodes = null;
        CloseEnrollment();
        Navigation.NavigateTo("/logout", true);
    }
    public void Dispose()
    {
        _disposed = true;
        _enrollmentGeneration++;
        _passwordCurrent = _passwordNew = _passwordConfirm = _setupPassword = _enrollmentCode = _disablePassword = _disableCode = _qrDataUrl = null;
        _authenticatorSetup = null; _recoveryCodes = null;
    }
}
