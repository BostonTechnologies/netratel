@page "/jobs/{JobId:long}/runs/{RunId:long}"

@using System.Text.Json
@using NetRatel.Shared
@using NetRatel.Shared.Contracts.Tasks
@using NetRatel.Shared.Utils
@using NetRatel.Web.Services.ClientTasks

@inject IJobApiClient JobApi
@inject IJobRunStreamService RunStream
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

@implements IDisposable

<PageTitle>Job Run</PageTitle>

<MudStack Spacing="2" Class="job-run-page">
    @if (_isLoading && _run is null)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-6">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Class="mt-2">Loading run...</MudText>
        </MudStack>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError) && _run is null)
    {
        <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
    }
    else if (_run is null)
    {
        <MudAlert Severity="Severity.Warning">Run not found.</MudAlert>
    }
    else
    {
        <header class="job-run-header">
            <div class="job-run-title">
                <MudText Typo="Typo.h6">@GetJobName()</MudText>
                <MudChip T="string" Color="@RunStatusColor(_run.Status)" Variant="Variant.Outlined" Size="Size.Small">@_run.Status</MudChip>
                <MudText Typo="Typo.caption" Color="Color.Secondary" role="status">@LiveStateLabel</MudText>
            </div>
            <div class="job-run-actions">
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavManager.NavigateTo("/jobs"))">Jobs</MudButton>
                @if (!IsRunTerminal(_run))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Cancel"
                               OnClick="CancelRunAsync" Disabled="@(_isLoading || _isCancelling)">Cancel run</MudButton>
                }
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" aria-label="Refresh run" OnClick="ManualRefresh" Disabled="_isLoading" />
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="job-run-context">
                Run #@RunId · @(_run.TenantDisplayName ?? _run.TenantId?.ToString() ?? "Tenant unknown") · @GetTargetSummary() · @GetEnvironmentSummary() · @GetRunWindowLabel()
            </MudText>
        </header>

        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">@_loadError</MudText>
        }
        <MudText Typo="Typo.body2" Class="job-run-summary" role="status">@GetRunOutcomeSummary()</MudText>

        <section class="job-run-execution" aria-label="Execution steps and output">
            <div class="job-run-follow-bar">
                <MudText Typo="Typo.subtitle2">Steps and output</MudText>
                <MudSwitch T="bool" Value="_follow.Following" ValueChanged="SetFollowAsync" Label="Follow active step" Color="Color.Primary" Size="Size.Small" />
                @if (!_follow.Following && !IsRunTerminal(_run))
                {
                    <MudText Typo="Typo.caption" role="status">Follow paused</MudText>
                    <MudButton Size="Size.Small" OnClick="@(() => SetFollowAsync(true))">Resume</MudButton>
                }
            </div>
            @if (_steps.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@(IsRunTerminal(_run) ? "No step evidence was captured for this run." : "Waiting for step execution evidence.")</MudText>
            }
            else
            {
                <MudExpansionPanels MultiExpansion="true" Elevation="0">
                    @foreach (var state in _steps.OrderBy(s => s.Step.Ordinal))
                    {
                        var step = state.Step;
                        var parsedLog = state.Log is null ? null : ParseExecutionLog(state.Log);
                        <MudExpansionPanel @key="step.Id" Expanded="@state.Expanded"
                                           ExpandedChanged="@((bool expanded) => OnStepExpanded(state, expanded))" Class="job-run-step-panel">
                            <TitleContent>
                                <div class="job-run-step-header">
                                    <span class="job-run-step-name">@GetStepHeader(step)</span>
                                    <MudChip T="string" Color="@StepStatusColor(step.Status)" Variant="Variant.Text" Size="Size.Small">@step.Status</MudChip>
                                    <span class="job-run-step-time">@GetStepWindowLabel(step)</span>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <MudTabs ActivePanelIndex="state.ActiveTab" ActivePanelIndexChanged="@((int index) => OnStepTabChanged(state, index))" KeepPanelsAlive="true" Elevation="0" Class="job-run-output-tabs">
                                    <MudTabPanel Text="Output">
                                        @if (state.Loading && state.Log is null)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" role="status">Loading output…</MudText>
                                        }
                                        @if (parsedLog is not null && parsedLog.PlainLines.Count > 0)
                                        {
                                            <pre class="job-run-output" tabindex="0" aria-label="@($"Output for step {step.Ordinal}")">@BuildPlainBlock(parsedLog.PlainLines, string.Empty)</pre>
                                            @if (state.OutputTruncated)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Some output was omitted from this view.</MudText>
                                            }
                                        }
                                        else if (!string.IsNullOrWhiteSpace(step.LogText))
                                        {
                                            <pre class="job-run-output" tabindex="0" aria-label="@($"Output for step {step.Ordinal}")">@BoundText(step.LogText)</pre>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="job-run-empty-output" role="status">@GetOutputEmptyMessage(state)</MudText>
                                        }
                                    </MudTabPanel>
                                    <MudTabPanel Text="Diagnostics">
                                        <MudStack Spacing="2" Class="job-run-diagnostics">
                                            <MudText Typo="Typo.body2">@GetStepSummary(step)</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Started @FormatTimestamp(step.StartedAtMicros) · @(step.Status == JobStepRunStatusDto.Unknown ? "Reconciled" : "Completed") @FormatTimestamp(step.CompletedAtMicros)</MudText>
                                            @if (!string.IsNullOrWhiteSpace(step.Error))
                                            {
                                                <pre class="job-run-diagnostic-text">@BoundText(step.Error)</pre>
                                            }
                                            <MudText Typo="Typo.caption">@((step.ExitCode ?? state.Log?.ExitCode ?? parsedLog?.ExitCode) is int exit ? $"Exit code: {exit}" : "Exit code was not captured.")</MudText>
                                            @if (state.LoadFailed || state.OutputTruncated)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@(state.LoadFailed ? "Output could not be loaded." : "Some output was omitted from the live view.")</MudText>
                                                <MudButton Size="Size.Small" OnClick="@(() => LoadStepLogAsync(state))">Retry output</MudButton>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(step.TaskRequestId))
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => NavManager.NavigateTo($"/tasks/request/{Uri.EscapeDataString(step.TaskRequestId!)}"))">View linked task</MudButton>
                                            }
                                            @if (parsedLog is not null)
                                            {
                                                <details><summary>Captured data</summary><pre class="job-run-diagnostic-text">@BoundText(parsedLog.RawJson)</pre></details>
                                            }
                                        </MudStack>
                                    </MudTabPanel>
                                </MudTabs>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
        </section>

        <details class="job-run-details">
            <summary>Run details and inputs</summary>
            <MudStack Spacing="2" Class="pa-3">
                <MudText Typo="Typo.caption">Started by @(_run.StartedBy ?? "Unknown") · Created @FormatTimestamp(_run.CreatedAtMicros) · Started @FormatTimestamp(_run.StartedAtMicros) · @(_run.Status == JobRunStatusDto.Unknown ? "Reconciled" : "Completed") @FormatTimestamp(_run.CompletedAtMicros)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Agent ID: @(_run.AgentId?.ToString() ?? "Not recorded") · Client identity: @(string.IsNullOrWhiteSpace(_run.ClientIdentity) ? "Not recorded" : _run.ClientIdentity)</MudText>
                @if (!string.IsNullOrWhiteSpace(_run.Error))
                {
                    <pre class="job-run-diagnostic-text">@BoundText(_run.Error)</pre>
                }
                @if (_runOptions.Count > 0)
                {
                    <MudTable T="JobRunOptionDto" Items="_runOptions" Dense="true" Elevation="0" Class="job-run-options">
                        <HeaderContent><MudTh>Name</MudTh><MudTh>Value</MudTh><MudTh>Source</MudTh></HeaderContent>
                        <RowTemplate><MudTd DataLabel="Name">@context.Name</MudTd><MudTd DataLabel="Value">@context.Value</MudTd><MudTd DataLabel="Source">@(context.Source ?? "Unknown")</MudTd></RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">No run inputs were captured.</MudText>
                }
            </MudStack>
        </details>
    }
</MudStack>

@code {
    [Parameter] public long JobId { get; set; }
    [Parameter] public long RunId { get; set; }

    private readonly JobStepFollowState _follow = new();
    private long _routeGeneration;
    private JobRunDto? _run;
    private List<StepState> _steps = new();
    private IReadOnlyList<JobRunOptionDto> _runOptions = Array.Empty<JobRunOptionDto>();

    private bool _isLoading = true;
    private string _liveState = "Connecting";
    private bool _isCancelling;
    private bool _disposed;
    private const int MaximumOutputCharacters = 256 * 1024;
    private const int MaximumOutputLines = 2000;
    private string LiveStateLabel => _run is not null && IsRunTerminal(_run) ? "Recorded outcome" : _liveState;
    private string? _loadError;

    private readonly CancellationTokenSource _disposeCts = new();
    private CancellationTokenSource? _streamCts;
    private CancellationTokenSource? _routeCts;
    private ulong? _loadedRunId;

    private ulong RunIdValue => RunId < 0 ? 0UL : (ulong)RunId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedRunId == RunIdValue) return;
        StopStream();
        _routeCts?.Cancel();
        _routeCts?.Dispose();
        _routeCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        _routeGeneration++;
        _follow.Reset();
        _loadedRunId = RunIdValue;
        _run = null;
        _steps = [];
        _liveState = "Connecting";
        _isCancelling = false;
        await LoadInitialAsync(_routeCts.Token);
    }

    private async Task ManualRefresh()
    {
        await LoadInitialAsync(_routeCts?.Token ?? _disposeCts.Token, true);
    }

    private async Task CancelRunAsync()
    {
        if (_run is null || IsRunTerminal(_run) || _isCancelling)
        {
            return;
        }

        _isCancelling = true;
        var runId = _run.Id;
        var generation = _routeGeneration;
        var token = _routeCts?.Token ?? _disposeCts.Token;
        try
        {
            await JobApi.CancelJobRunAsync(runId, token);
            if (token.IsCancellationRequested || generation != _routeGeneration || _disposed) return;
            Snackbar.Add("Run cancellation requested.", Severity.Info);
            await LoadInitialAsync(_routeCts?.Token ?? _disposeCts.Token, true);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (generation == _routeGeneration && !_disposed) Snackbar.Add($"Failed to cancel run: {ex.Message}", Severity.Error);
        }
        finally { if (generation == _routeGeneration) _isCancelling = false; }
    }

    private async Task LoadInitialAsync(CancellationToken cancellationToken, bool fromUser = false)
    {
        if (fromUser && _isLoading)
        {
            return;
        }

        StopStream();
        var runId = RunIdValue;
        var generation = _routeGeneration;
        _isLoading = true;
        _loadError = null;
        _runOptions = Array.Empty<JobRunOptionDto>();
        if (fromUser)
        {
            StateHasChanged();
        }

        try
        {
            var run = await JobApi.GetJobRunAsync(runId, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (generation != _routeGeneration || _disposed) return;
            if (run is null)
            {
                _loadError = "Job run not found.";
                _run = null;
                _steps = new List<StepState>();
                _runOptions = Array.Empty<JobRunOptionDto>();
                return;
            }

            _run = run;
            JobId = (long)run.JobId;
            _runOptions = BuildRunOptions(run);

            var fetchedSteps = (await JobApi.GetJobRunStepsAsync(runId, cancellationToken)).OrderBy(step => step.Ordinal).ToList();
            cancellationToken.ThrowIfCancellationRequested();
            if (generation != _routeGeneration || _disposed) return;
            SyncStepStates(fetchedSteps);
            foreach (var state in _steps.Where(state => state.Expanded))
                await LoadStepLogAsync(state);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            if (!_disposed && generation == _routeGeneration && !cancellationToken.IsCancellationRequested)
                _loadError = "Failed to load run. Refresh to retry.";
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested && generation == _routeGeneration && !_disposed)
            {
                _isLoading = false;
                StartStream();
                if (!_disposed) await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StartStream()
    {
        StopStream();
        if (_disposed || _run is null || IsRunTerminal(_run)) return;
        _streamCts = CancellationTokenSource.CreateLinkedTokenSource(_routeCts?.Token ?? _disposeCts.Token);
        _ = ObserveRunAsync(_run.Id, _routeGeneration, _streamCts.Token);
    }

    private async Task ObserveRunAsync(ulong runId, long generation, CancellationToken cancellationToken)
    {
        try
        {
            await foreach (var update in RunStream.SubscribeAsync(runId, cancellationToken))
            {
                if (_disposed || cancellationToken.IsCancellationRequested || generation != _routeGeneration) break;
                await InvokeAsync(() =>
                {
                    if (_disposed || cancellationToken.IsCancellationRequested || generation != _routeGeneration) return;
                    _liveState = update.State;
                    if (update.Snapshot is { } snapshot && snapshot.Run.Id == runId)
                    {
                        _run = snapshot.Run;
                        _loadError = null;
                        _runOptions = BuildRunOptions(_run);
                        SyncStepStates(snapshot.Steps.OrderBy(step => step.Ordinal).ToList());
                        foreach (var captured in snapshot.Logs)
                        {
                            var state = _steps.FirstOrDefault(state => state.Step.Ordinal == captured.Ordinal);
                            if (state is null) continue;
                            ApplyLog(state, new ExecutionLogDto(state.Step.TaskRequestId, null, null, null, captured.Logs), captured.Truncated);

                        }
                        // Captured stream output is applied first; fetch only missing output for the newly followed step.
                        foreach (var state in _steps.Where(state => state.Expanded && state.Log is null && !state.LogAttempted))
                            _ = LoadStepLogAsync(state);
                    }
                    StateHasChanged();
                });
                if (_run is not null && IsRunTerminal(_run)) break;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception)
        {
            if (!_disposed && !cancellationToken.IsCancellationRequested && generation == _routeGeneration) await InvokeAsync(() => { _liveState = "Live updates unavailable. Refresh to retry."; StateHasChanged(); });
        }
    }

    private void StopStream()
    {
        _streamCts?.Cancel();
        _streamCts?.Dispose();
        _streamCts = null;
    }

    private IReadOnlyList<JobRunOptionDto> BuildRunOptions(JobRunDto? run)
    {
        if (run is null)
            return Array.Empty<JobRunOptionDto>();

        if (run.Options is { Count: > 0 })
            return run.Options;

        if (string.IsNullOrWhiteSpace(run.InputsJson))
            return Array.Empty<JobRunOptionDto>();

        try
        {
            using var doc = JsonDocument.Parse(run.InputsJson);
            if (doc.RootElement.ValueKind != JsonValueKind.Object)
                return Array.Empty<JobRunOptionDto>();

            var list = new List<JobRunOptionDto>();
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                var source = $"@option.{prop.Name}@";
                list.Add(new JobRunOptionDto(prop.Name, ConvertJsonElementToString(prop.Value), source));
            }

            return list;
        }
        catch
        {
            return Array.Empty<JobRunOptionDto>();
        }
    }

    private static string ConvertJsonElementToString(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.True => "true",
        JsonValueKind.False => "false",
        JsonValueKind.String => value.GetString() ?? string.Empty,
        JsonValueKind.Number => value.GetRawText(),
        JsonValueKind.Null or JsonValueKind.Undefined => string.Empty,
        _ => value.GetRawText()
    };

    private string GetJobName()
    {
        if (!string.IsNullOrWhiteSpace(_run?.JobName))
            return _run.JobName;

        return $"Job {_run?.JobId}";
    }

    private string GetRunWindowLabel()
    {
        if (_run?.Status == JobRunStatusDto.Unknown) return "Duration unknown";
        if (_run?.StartedAtMicros is null)
            return "Start time not captured";

        if (_run.CompletedAtMicros is null)
            return IsRunTerminal(_run) ? "Duration not captured" : "In progress";

        var duration = _run.CompletedAtMicros.Value - _run.StartedAtMicros.Value;
        return FormatDuration(duration);
    }

    private string GetRunOutcomeSummary()
    {
        if (_run is null) return "Run evidence is unavailable.";
        var summary = _run.Status switch
        {
            JobRunStatusDto.Succeeded => "Execution completed successfully.",
            JobRunStatusDto.Failed => string.IsNullOrWhiteSpace(_run.Error) ? "Execution failed. Expand diagnostics for details." : $"Execution failed: {TaskPresentation.ConciseReason(_run.Error)}",
            JobRunStatusDto.Running when _steps.Any(state => state.Step.StartedAtMicros.HasValue) => "Execution is in progress.",
            JobRunStatusDto.Running => "Waiting for agent execution evidence.",
            JobRunStatusDto.Pending => "Queued. Waiting for execution to start.",
            JobRunStatusDto.Cancelled => "Execution was cancelled.",
            JobRunStatusDto.TimedOut => "Execution timed out. Expand diagnostics for details.",
            JobRunStatusDto.Unknown => "Execution outcome is unknown. No terminal receipt was captured.",
            _ => "Execution status is unknown."
        };
        return summary;
    }

    private string GetTargetSummary()
    {
        var name = new[] { _run?.TargetDisplayName, _run?.TargetName, _run?.ClientDisplayName }.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
        var host = _run?.TargetHostName;
        if (!string.IsNullOrWhiteSpace(name)) return !string.IsNullOrWhiteSpace(host) && host != name ? $"{name} ({host})" : name;
        return !string.IsNullOrWhiteSpace(host) ? host : "Target unknown";
    }

    private string GetEnvironmentSummary() => _run?.Environment is { } environment ? environment.ToShortLabel() : "Environment not recorded";

    private static string GetStepWindowLabel(JobStepRunDto step) => step.Status == JobStepRunStatusDto.Unknown ? "Outcome unknown"
        : step.Status == JobStepRunStatusDto.Skipped ? "Skipped"
        : step.StartedAtMicros is null ? "Start not captured"
        : step.CompletedAtMicros is null ? (step.Status is JobStepRunStatusDto.Pending or JobStepRunStatusDto.Running ? "In progress" : "Duration not captured")
        : FormatDuration(step.CompletedAtMicros.Value - step.StartedAtMicros.Value);

    private string GetOutputEmptyMessage(StepState state)
    {
        if (state.LoadFailed) return "Output could not be loaded. Retry from Diagnostics.";
        if (state.OutputTruncated) return "Some output was omitted from this live view. Open Diagnostics to reload step output.";
        if (state.Step.Status == JobStepRunStatusDto.Unknown) return "No further output was captured. The execution outcome is unknown.";
        if (state.Step.Status == JobStepRunStatusDto.Skipped) return "This step was skipped; no output was captured.";
        if (state.Step.StartedAtMicros is null) return _run is not null && IsRunTerminal(_run)
            ? "Start was not captured. No output was captured." : "Waiting for step execution evidence.";
        return state.Step.CompletedAtMicros is null && _run is not null && !IsRunTerminal(_run)
            ? "Waiting for output. No output has been captured yet." : "Execution finished without captured output.";
    }

    private static string BoundText(string text)
    {
        var lines = text.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        var tail = string.Join('\n', lines.TakeLast(MaximumOutputLines));
        return tail.Length > MaximumOutputCharacters ? tail[^MaximumOutputCharacters..] : tail;
    }

    private static string FormatDuration(long micros)
    {
        if (micros <= 0)
            return "0s";

        var span = TimeSpan.FromMilliseconds(micros / 1000d);
        if (span.TotalHours >= 1)
            return $"{(int)span.TotalHours}h {span.Minutes}m";
        if (span.TotalMinutes >= 1)
            return $"{(int)span.TotalMinutes}m {span.Seconds}s";
        return $"{Math.Max(1, span.Seconds)}s";
    }

    private static string GetStepHeader(JobStepRunDto step)
    {
        var label = !string.IsNullOrWhiteSpace(step.ScriptName) ? step.ScriptName
            : !string.IsNullOrWhiteSpace(step.CommandLabel) ? Truncate(step.CommandLabel, 80)
            : "Step";
        return $"{step.Ordinal}. {label}";
    }

    private static string GetStepSummary(JobStepRunDto step)
    {
        if (!string.IsNullOrWhiteSpace(step.ScriptName))
            return string.IsNullOrWhiteSpace(step.ScriptType) ? step.ScriptName : $"{step.ScriptName} · {step.ScriptType}";
        return !string.IsNullOrWhiteSpace(step.CommandLabel) ? step.CommandLabel : "Execution definition was not captured.";
    }

    private bool SyncStepStates(List<JobStepRunDto> latest)
    {
        var existingById = _steps.ToDictionary(state => state.Step.Id);
        var newList = new List<StepState>();
        var changed = _steps.Count != latest.Count;
        foreach (var step in latest)
        {
            if (existingById.TryGetValue(step.Id, out var state))
            {
                changed |= state.Step != step;
                if (state.Step.TaskRequestId != step.TaskRequestId || state.Step.StartedAtMicros != step.StartedAtMicros)
                {
                    state.Log = null;
                    state.LogAttempted = false;
                    state.Loading = false;
                }
                state.Step = step;
                newList.Add(state);
            }
            else
            {
                newList.Add(new StepState { Step = step });
                changed = true;
            }
        }
        _steps = newList;
        if (_run is not null) ApplyFollowTarget(_follow.Reconcile(_run, latest));
        return changed;
    }

    private async Task OnStepExpanded(StepState state, bool expanded)
    {
        if (state.Expanded != expanded) _follow.Pause();
        state.Expanded = expanded;
        if (expanded && state.Log is null && !state.Loading) await LoadStepLogAsync(state);
    }

    private void OnStepTabChanged(StepState state, int index)
    {
        if (state.ActiveTab != index) _follow.Pause();
        state.ActiveTab = index;
    }

    private void ApplyFollowTarget(ulong? targetId)
    {
        if (targetId is null) return;
        foreach (var state in _steps)
        {
            state.Expanded = state.Step.Id == targetId;
            if (state.Expanded) state.ActiveTab = 0;
        }
    }

    private async Task SetFollowAsync(bool following)
    {
        if (!following) { _follow.Pause(); return; }
        if (_run is null) return;
        ApplyFollowTarget(_follow.Resume(_run, _steps.Select(state => state.Step).ToList()));
        foreach (var state in _steps.Where(state => state.Expanded && state.Log is null && !state.LogAttempted))
            await LoadStepLogAsync(state);
    }

    private async Task LoadStepLogAsync(StepState state)
    {
        if (_run is null || state.Loading || string.IsNullOrWhiteSpace(state.Step.TaskRequestId)) return;
        state.Loading = true;
        state.LogAttempted = true;
        state.LoadFailed = false;
        var runId = _run.Id;
        var step = state.Step;
        var generation = _routeGeneration;
        var outputRevision = state.OutputRevision;
        var cancellationToken = _routeCts?.Token ?? _disposeCts.Token;
        try
        {
            var log = await JobApi.GetJobStepLogsAsync(runId, step.Ordinal, cancellationToken);
            if (cancellationToken.IsCancellationRequested || generation != _routeGeneration || state.Step.TaskRequestId != step.TaskRequestId || state.Step.StartedAtMicros != step.StartedAtMicros) return;
            if (log is not null && state.OutputRevision == outputRevision)
            {
                ApplyLog(state, log, false);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            if (generation == _routeGeneration && !cancellationToken.IsCancellationRequested && state.OutputRevision == outputRevision
                && state.Step.TaskRequestId == step.TaskRequestId && state.Step.StartedAtMicros == step.StartedAtMicros) state.LoadFailed = true;
        }
        finally
        {
            if (state.Step.TaskRequestId == step.TaskRequestId && state.Step.StartedAtMicros == step.StartedAtMicros) state.Loading = false;
            if (!_disposed && generation == _routeGeneration && !cancellationToken.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private static void ApplyLog(StepState state, ExecutionLogDto log, bool truncated)
    {
        state.OutputRevision++;
        var ordered = log.Logs.GroupBy(line => line.Seq).Select(group => group.First()).OrderBy(line => line.Seq).ToList();
        var bounded = ordered.TakeLast(MaximumOutputLines).ToList();
        var remaining = MaximumOutputCharacters;
        for (var index = bounded.Count - 1; index >= 0; index--)
        {
            var message = bounded[index].Message;
            if (message.Length > remaining)
            {
                bounded[index] = bounded[index] with { Message = message[^remaining..] };
                bounded.RemoveRange(0, index);
                truncated = true;
                break;
            }
            remaining -= message.Length;
        }
        state.OutputTruncated = truncated || log.Truncated || bounded.Count < ordered.Count || (log.Plain?.Length ?? 0) > MaximumOutputCharacters;
        state.Log = log with { Logs = bounded, Plain = log.Plain is null ? null : BoundText(log.Plain) };
        state.LoadFailed = false;
    }

    private Color RunStatusColor(JobRunStatusDto status) => status switch
    {
        JobRunStatusDto.Succeeded => Color.Success,
        JobRunStatusDto.Running => Color.Info,
        JobRunStatusDto.Pending => Color.Warning,
        JobRunStatusDto.Cancelled => Color.Warning,
        JobRunStatusDto.Unknown => Color.Warning,
        JobRunStatusDto.Failed => Color.Error,
        JobRunStatusDto.TimedOut => Color.Error,
        _ => Color.Default
    };

    private Color StepStatusColor(JobStepRunStatusDto status) => status switch
    {
        JobStepRunStatusDto.Succeeded => Color.Success,
        JobStepRunStatusDto.Running => Color.Info,
        JobStepRunStatusDto.Pending => Color.Warning,
        JobStepRunStatusDto.Skipped => Color.Secondary,
        JobStepRunStatusDto.Cancelled => Color.Secondary,
        JobStepRunStatusDto.TimedOut => Color.Warning,
        JobStepRunStatusDto.Unknown => Color.Warning,
        JobStepRunStatusDto.Failed => Color.Error,
        _ => Color.Default
    };

    private static bool IsRunTerminal(JobRunDto run) =>
        run.Status is JobRunStatusDto.Succeeded or JobRunStatusDto.Failed or JobRunStatusDto.Cancelled or JobRunStatusDto.TimedOut or JobRunStatusDto.Unknown;

    private string FormatTimestamp(long micros) => FormatTimestamp((long?)micros);

    private string FormatTimestamp(long? micros)
    {
        if (micros is null) return "-";

        try
        {
            var dt = DateTimeOffset.FromUnixTimeMilliseconds(micros.Value / 1000);
            return dt.ToOffset(TimeSpan.FromHours(2)).ToString("g") + " SAST";
        }
        catch
        {
            return "-";
        }
    }

    private static string Truncate(string value, int max)
    {
        if (string.IsNullOrEmpty(value) || value.Length <= max)
            return value;

        return value[..max] + "…";
    }

    private static ParsedExecutionLog ParseExecutionLog(ExecutionLogDto log)
    {
        // Terminal execution payloads replace incremental output; rendering both would duplicate it.
        var candidates = new[] { log.Plain }.Concat(log.Logs.OrderByDescending(line => line.Seq).Select(line => line.Message));
        foreach (var candidate in candidates)
        {
            if (string.IsNullOrWhiteSpace(candidate) || !candidate.TrimStart().StartsWith('{')) continue;
            try
            {
                using var document = JsonDocument.Parse(candidate);
                var root = document.RootElement;
                if (!root.TryGetProperty("stdout", out var stdout) || stdout.ValueKind != JsonValueKind.Array) continue;
                var lines = stdout.EnumerateArray().Select(line => AnsiConsole.NormalizeForDisplay(line.GetString() ?? string.Empty)).ToList();
                if (root.TryGetProperty("stderr", out var stderr) && stderr.ValueKind == JsonValueKind.Array)
                    lines.AddRange(stderr.EnumerateArray().Select(line => AnsiConsole.NormalizeForDisplay(line.GetString() ?? string.Empty)));
                int? exit = root.TryGetProperty("exitCode", out var capturedExit) && capturedExit.TryGetInt32(out var value) ? value : null;
                return new ParsedExecutionLog(lines.Where(line => !string.IsNullOrWhiteSpace(line)).ToList(), exit, BoundText(candidate));
            }
            catch (Exception exception) when (exception is JsonException or InvalidOperationException) { }
        }
        var output = log.Logs.Count > 0
            ? log.Logs.OrderBy(line => line.Seq).Select(line => AnsiConsole.NormalizeForDisplay(line.Message)).ToList()
            : (log.Plain is null ? new List<string>() : AnsiConsole.NormalizeForDisplay(log.Plain).Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n').ToList());
        return new ParsedExecutionLog(output.Where(line => !string.IsNullOrWhiteSpace(line)).ToList(), null,
            BoundText(JsonSerializer.Serialize(log, new JsonSerializerOptions(JsonSerializerDefaults.Web))));
    }

    private static string BuildPlainBlock(IReadOnlyList<string> lines, string emptyMessage)
        => lines.Count == 0 ? emptyMessage : BoundText(string.Join(System.Environment.NewLine, lines));

    public void Dispose()
    {
        _disposed = true;
        StopStream();
        _routeCts?.Cancel();
        _routeCts?.Dispose();
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private sealed class StepState
    {
        public JobStepRunDto Step { get; set; } = default!;
        public ExecutionLogDto? Log { get; set; }
        public bool Loading { get; set; }
        public bool LogAttempted { get; set; }
        public long OutputRevision { get; set; }
        public bool LoadFailed { get; set; }
        public bool Expanded { get; set; }
        public int ActiveTab { get; set; }
        public bool OutputTruncated { get; set; }
    }

    private sealed record ParsedExecutionLog(IReadOnlyList<string> PlainLines, int? ExitCode, string RawJson);
}
