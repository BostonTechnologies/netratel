@using NetRatel.Shared
@using NetRatel.Shared.Contracts.Jobs
@implements IDisposable
@inject IHttpClientFactory HttpClients

<section class="node-picker" aria-label="Node selection" data-testid="job-node-picker">
    <div class="node-picker-summary">
        <MudIcon Icon="@Icons.Material.Outlined.Dns" Size="Size.Small" />
        <strong>@Label (@_selected.Count)</strong>
        <MudTooltip Text="@(_expanded ? "Close node selection" : "View and edit nodes")">
            <MudIconButton Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Outlined.Edit)" Size="Size.Small" OnClick="ToggleEditorAsync" Disabled="Disabled" aria-label="@(_expanded ? "Close node selection" : "View and edit nodes")" aria-expanded="@_expanded.ToString().ToLowerInvariant()" />
        </MudTooltip>
        @if (MaximumSelection == 1) { <span class="node-picker-hint">Choose one node</span> }
    </div>
    @if (_expanded)
    {
        <div class="node-picker-editor">
            <div class="node-picker-toolbar">
                <MudTextField T="string" Value="_search" ValueChanged="SearchTextChangedAsync" DebounceInterval="300" Label="Search nodes" Placeholder="Hostname, name, tag, OS or architecture" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Disabled="Disabled" OnKeyDown="SearchKeyAsync" />
                <MudButton OnClick="ToggleSelectedAsync" Disabled="Disabled" Size="Size.Small" Variant="Variant.Text">@(_selectedOnly ? "Available nodes" : $"Selected nodes ({_selected.Count})")</MudButton>
            </div>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@_error <MudButton OnClick="ReloadAsync" Size="Size.Small">Retry nodes</MudButton></MudAlert>
            }
            @if (_loading) { <MudProgressLinear Indeterminate="true" aria-label="Loading nodes" /> }
            <div class="node-picker-actions">
                @if (MaximumSelection != 1)
                {
                    <MudButton Size="Size.Small" OnClick="SelectVisibleAsync" Disabled="@(Disabled || _loading || _items.Count == 0)">Select visible (@_items.Count(node => node.IsEnabled))</MudButton>
                    <MudButton Size="Size.Small" OnClick="ClearVisibleAsync" Disabled="@(Disabled || _loading)">Clear visible</MudButton>
                }
                <span role="status">@(_selectedOnly ? $"{_selected.Count} selected" : $"{_selected.Count} selected · {_total} matching")</span>
            </div>
            <div class="node-picker-list" tabindex="0" role="region" aria-label="Selectable nodes">
                <MudChipSet T="Guid" SelectionMode="@(MaximumSelection == 1 ? SelectionMode.SingleSelection : SelectionMode.MultiSelection)" SelectedValues="VisibleSelection" SelectedValuesChanged="SelectionChangedAsync" SelectedValue="@_selected.FirstOrDefault()" SelectedValueChanged="SingleSelectionChangedAsync" CheckMark="true" Size="Size.Small" Variant="Variant.Outlined" SelectedColor="Color.Primary" Disabled="Disabled">
                    @foreach (var node in _items)
                    {
                        <MudTooltip Text="@NodeDetails(node)" @key="node.AgentId">
                            <MudChip T="Guid" Value="node.AgentId" Disabled="@(!node.IsEnabled && !_selected.Contains(node.AgentId))" Icon="@Icons.Material.Outlined.Dns" IconColor="@(node.IsOnline ? Color.Success : Color.Default)" Class="node-picker-chip" aria-label="@($"Select {NodeName(node)}")" title="@NodeDetails(node)">@NodeName(node)</MudChip>
                        </MudTooltip>
                    }
                </MudChipSet>
                @if (!_loading && _items.Count == 0) { <MudText Typo="Typo.body2" Class="pa-2">No nodes match this view.</MudText> }
            </div>
            @if (Candidates is null && !_selectedOnly && (_page > 1 || _total > PageSize))
            {
                <div class="node-picker-pagination">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(_page <= 1 || _loading)" OnClick="PreviousAsync" aria-label="Previous nodes" />
                    <span>Page @_page</span>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(_page * PageSize >= _total || _loading)" OnClick="NextAsync" aria-label="Next nodes" />
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter] public ClientEnvironment? Environment { get; set; }
    [Parameter] public IReadOnlyList<Guid> Value { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<Guid>> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<JobNodeInventoryDto>? Candidates { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int? MaximumSelection { get; set; }
    [Parameter] public string Label { get; set; } = "Nodes";
    private const int PageSize = 25;
    private JobTargetsApiClient Api => _api ??= new(HttpClients);
    private JobTargetsApiClient? _api;
    private readonly HashSet<Guid> _selected = [];
    private readonly Dictionary<Guid, JobNodeInventoryDto> _identities = [];
    private IReadOnlyList<JobNodeInventoryDto> _items = [];
    private IReadOnlyList<JobNodeInventoryDto>? _receivedCandidates;
    private IReadOnlyCollection<Guid> VisibleSelection => _items.Where(node => _selected.Contains(node.AgentId)).Select(node => node.AgentId).ToArray();
    private int _loadedTenant, _page = 1, _total;
    private ClientEnvironment? _loadedEnvironment;
    private bool _expanded, _selectedOnly, _loading;
    private string _search = "";
    private string? _error;
    private readonly CancellationTokenSource _dispose = new();
    private long _generation;

    protected override async Task OnParametersSetAsync()
    {
        var scopeChanged = _loadedTenant != TenantId || _loadedEnvironment != Environment;
        var candidatesChanged = !ReferenceEquals(_receivedCandidates, Candidates);
        var changed = !_selected.SetEquals(Value);
        if (!scopeChanged && !changed && !candidatesChanged) return;
        _loadedTenant = TenantId; _loadedEnvironment = Environment; _receivedCandidates = Candidates;
        _selected.Clear(); _selected.UnionWith(Value);
        if (scopeChanged) { _identities.Clear(); _page = 1; _search = ""; }
        if (_expanded) await ReloadAsync();
    }

    private async Task ToggleEditorAsync()
    {
        _expanded = !_expanded;
        if (_expanded) { _selectedOnly = _selected.Count > 0; _page = 1; await ReloadAsync(); }
    }

    private async Task ReloadAsync()
    {
        if (TenantId <= 0 || !_expanded) return;
        var generation = ++_generation;
        _loading = true; _error = null;
        try
        {
            if (Candidates is { } candidates)
            {
                foreach (var node in candidates) _identities[node.AgentId] = node;
                _items = candidates.Where(node => (!_selectedOnly || _selected.Contains(node.AgentId)) && MatchesSearch(node)).ToArray();
                _total = _items.Count;
            }
            else if (_selectedOnly)
            {
                var missing = _selected.Where(id => !_identities.ContainsKey(id)).ToArray();
                foreach (var batch in missing.Chunk(1000))
                {
                    try
                    {
                        var found = await Api.GetNodeIdentitiesAsync(TenantId, batch, _dispose.Token);
                        if (generation != _generation) return;
                        foreach (var node in found) _identities[node.AgentId] = node;
                    }
                    catch (HttpRequestException)
                    {
                        if (generation != _generation) return;
                        _error = "Some saved node details are unavailable. Your selection is retained; unavailable nodes can be deselected.";
                    }
                }
                _items = _selected.Select(id => _identities.GetValueOrDefault(id) ?? Unavailable(id)).Where(MatchesSearch)
                    .OrderBy(NodeName, StringComparer.OrdinalIgnoreCase).ThenBy(node => node.AgentId).ToArray();
                _total = _items.Count;
            }
            else
            {
                var result = await Api.GetNodesAsync(TenantId, _search, _page, Environment, _dispose.Token);
                if (generation != _generation) return;
                _total = result.TotalCount; _items = result.Items;
                foreach (var node in _items) _identities[node.AgentId] = node;
            }
        }
        catch (OperationCanceledException) when (_dispose.IsCancellationRequested) { return; }
        catch (HttpRequestException) { if (generation == _generation) _error = "Nodes could not be loaded. Your selection is retained."; }
        finally { if (generation == _generation) _loading = false; }
    }

    private async Task SelectionChangedAsync(IReadOnlyCollection<Guid>? values)
    {
        if (Disabled || _loading || !_expanded || MaximumSelection == 1) return;
        var visible = _items.Select(node => node.AgentId).ToHashSet();
        var next = (values ?? []).Where(visible.Contains).ToHashSet();
        _selected.ExceptWith(visible); _selected.UnionWith(next);
        await NotifyChangedAsync();
    }
    private async Task SingleSelectionChangedAsync(Guid value)
    {
        if (Disabled || _loading || !_expanded || MaximumSelection != 1) return;
        if (value != Guid.Empty && !_items.Any(node => node.AgentId == value && node.IsEnabled)) return;
        _selected.Clear(); if (value != Guid.Empty) _selected.Add(value);
        await NotifyChangedAsync();
    }
    private async Task NotifyChangedAsync()
    {
        await ValueChanged.InvokeAsync(_selected.Order().ToArray());
        if (_selectedOnly) await ReloadAsync();
    }
    private async Task SelectVisibleAsync()
    {
        if (Disabled || _loading) return;
        foreach (var node in _items.Where(node => node.IsEnabled)) _selected.Add(node.AgentId);
        await NotifyChangedAsync();
    }
    private async Task ClearVisibleAsync()
    {
        if (Disabled || _loading) return;
        foreach (var node in _items) _selected.Remove(node.AgentId);
        await NotifyChangedAsync();
    }
    private Task SearchTextChangedAsync(string? value) { _search = value ?? ""; _page = 1; return ReloadAsync(); }
    private Task SearchKeyAsync(KeyboardEventArgs args) => args.Key == "Enter" ? ReloadAsync() : Task.CompletedTask;
    private Task ToggleSelectedAsync() { _page = 1; _selectedOnly = !_selectedOnly; return ReloadAsync(); }
    private Task PreviousAsync() { _page = Math.Max(1, _page - 1); return ReloadAsync(); }
    private Task NextAsync() { _page++; return ReloadAsync(); }
    private bool MatchesSearch(JobNodeInventoryDto node) => string.IsNullOrWhiteSpace(_search) ||
        new[] { node.Hostname, node.Name, node.DisplayName, node.OperatingSystem, node.Architecture, string.Join(" ", node.Tags) }
            .Any(value => value?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) == true);
    private static JobNodeInventoryDto Unavailable(Guid id) => new(id, "", "Unavailable node", null, [], null, null, null, false, false, "Metadata unavailable");
    private static string NodeName(JobNodeInventoryDto node) => !string.IsNullOrWhiteSpace(node.Hostname) ? node.Hostname : node.DisplayName;
    private static string NodeDetails(JobNodeInventoryDto node) => string.Join(" · ", new[]
    {
        string.IsNullOrWhiteSpace(node.Hostname) ? "Hostname unavailable" : node.Hostname,
        node.DisplayName != node.Hostname ? node.DisplayName : null,
        !string.IsNullOrWhiteSpace(node.Name) ? $"Registered name: {node.Name}" : null,
        node.OperatingSystem, node.Architecture, node.IsOnline ? "Online" : "Offline",
        !node.IsEnabled ? node.UnavailableReason ?? "Unavailable" : null, string.Join(", ", node.Tags)
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    public void Dispose() { _expanded = false; ++_generation; _dispose.Cancel(); _dispose.Dispose(); }
}
