    private Color RunStatusColor(JobRunStatusDto status) => status switch
    {
        JobRunStatusDto.Succeeded => Color.Success,
        JobRunStatusDto.Running => Color.Info,
        JobRunStatusDto.Pending => Color.Warning,
        JobRunStatusDto.Cancelled => Color.Warning,
        JobRunStatusDto.Failed => Color.Error,
