@page "/jobs"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using NetRatel.Shared
@using NetRatel.Shared.Contracts
@using NetRatel.Shared.Contracts.Jobs

@inject IJobApiClient JobApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavManager

<PageTitle>Jobs</PageTitle>

<section class="jobs-console">
<MudContainer MaxWidth="MaxWidth.False">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="jobs-toolbar">
            <MudText Typo="Typo.h6">Jobs</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" Disabled="@_definitionActionBusy"
                       OnClick="@(() => RunDefinitionActionAsync(CreateJobAsync))">New Job</MudButton>
            <MudTooltip Text="Refresh jobs and runs">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" aria-label="Refresh jobs and runs"
                               Disabled="@_isLoading" OnClick="ReloadAsync" />
            </MudTooltip>
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Secondary" role="status">@DefinitionsSummary</MudText>
        <MudTabs @bind-ActivePanelIndex="_workspaceTab" KeepPanelsAlive="true" Elevation="0" Color="Color.Default" Class="jobs-workspace">
        <MudTabPanel Text="Definitions">
        <MudPaper Class="jobs-panel pa-3" Elevation="0">
            <MudStack Spacing="2">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="4">
                        <MudMenu Dense="true"
                                 Variant="Variant.Outlined"
                                 Color="Color.Default"
                                 Label="@FolderMenuLabel"
                                 StartIcon="@Icons.Material.Filled.FolderOpen"
                                 AnchorOrigin="Origin.BottomLeft"
                                 TransformOrigin="Origin.TopLeft"
                                 FullWidth="true">
                            <MudMenuItem OnClick="@(() => SelectFolder(null))">All folders</MudMenuItem>
                            <MudDivider />
                            @foreach (var folder in _folders)
                            {
                                <MudMenuItem OnClick="@(() => SelectFolder(folder))">
                                    @GetFolderDisplay(folder)
                                </MudMenuItem>
                            }
                        </MudMenu>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudTextField T="string"
                                      Value="_jobSearch"
                                      ValueChanged="OnJobSearchChanged"
                                      Placeholder="Search jobs, tenants, folders, or targets"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      Clearable="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="ClientEnvironment?"
                                   Label="Environment"
                                   Value="_jobEnvironment"
                                   ValueChanged="OnJobEnvironmentChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="ClientEnvironment?" Value="@(null)">Dev + Prod</MudSelectItem>
                            <MudSelectItem T="ClientEnvironment?" Value="@(ClientEnvironment.Dev)">Dev</MudSelectItem>
                            <MudSelectItem T="ClientEnvironment?" Value="@(ClientEnvironment.Prod)">Prod</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                @if (_isLoading)
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText Class="mt-2">Loading job definitions...</MudText>
                    </MudStack>
                }
                else if (_jobs.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        No jobs match the current filters. Adjust the scope or create a new workflow.
                    </MudAlert>
                }
                else
                {
                    <MudTable T="JobDto"
                              @key="_jobsTableKey"
                              Items="_jobs"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              Breakpoint="Breakpoint.Md"
                              OnRowClick="OnJobRowClick"
                              RowStyleFunc="JobRowStyle"
                              RowsPerPage="10"
                              FixedHeader="true" Height="min(470px, calc(100dvh - 310px))"
                              Class="jobs-table">
                        <HeaderContent>
                            <MudTh>Tenant</MudTh>
                            <MudTh>Folder</MudTh>
                            <MudTh>Target</MudTh>
                            <MudTh>Workflow</MudTh>
                            <MudTh>Env</MudTh>
                            <MudTh>Updated</MudTh>
                            <MudTh Class="text-right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Tenant">@((context.TenantDisplayName ?? context.TenantId?.ToString()) ?? "Unassigned")</MudTd>
                            <MudTd DataLabel="Folder">@GetFolderDisplay(context.FolderPath)</MudTd>
                            <MudTd DataLabel="Target">
                                <MudTooltip Text="@GetClientTooltip(context)">
                                    <span>@GetClientDisplayText(context)</span>
                                </MudTooltip>
                            </MudTd>
                            <MudTd DataLabel="Workflow">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@context.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(string.IsNullOrWhiteSpace(context.Description) ? "No description" : context.Description)
                                    </MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="Env">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.Environment == ClientEnvironment.Prod ? Color.Warning : Color.Success)">
                                    @context.Environment.ToShortLabel()
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Updated">@FormatTimestamp(context.UpdatedAtMicros)</MudTd>
                            <MudTd DataLabel="Actions" Class="text-right">
                                <span class="jobs-row-actions" @onclick:stopPropagation="true">
                                    <MudTooltip Text="@ActionTooltip("Run", context)">
                                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary"
                                                       aria-label="@($"Run {context.Name}")" Disabled="@_definitionActionBusy"
                                                       OnClick="@(() => RunDefinitionActionAsync(() => OpenRunDialogAsync(context)))" />
                                    </MudTooltip>
                                    <MudTooltip Text="@ActionTooltip("Edit", context)">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       aria-label="@($"Edit {context.Name}")" Disabled="@_definitionActionBusy"
                                                       OnClick="@(() => RunDefinitionActionAsync(() => OpenEditDialogAsync(context)))" />
                                    </MudTooltip>
                                    <MudTooltip Text="@ActionTooltip("Clone", context)">
                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                       aria-label="@($"Clone {context.Name}")" Disabled="@_definitionActionBusy"
                                                       OnClick="@(() => RunDefinitionActionAsync(() => OpenCopyDialogAsync(context)))" />
                                    </MudTooltip>
                                    <MudTooltip Text="@ActionTooltip("Delete", context)">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       aria-label="@($"Delete {context.Name}")" Disabled="@_definitionActionBusy"
                                                       OnClick="@(() => RunDefinitionActionAsync(() => DeleteJobAsync(context)))" />
                                    </MudTooltip>
                                </span>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 20, 50 }" />
                        </PagerContent>
                    </MudTable>
                }
            </MudStack>
        </MudPaper>

        </MudTabPanel>
        <MudTabPanel Text="Recent Runs">
        <MudPaper Class="jobs-panel pa-3" Elevation="0">
            <MudStack Spacing="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary" role="status">@RunsSummary</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudTextField T="string"
                                      Value="_runSearch"
                                      ValueChanged="OnRunSearchChanged"
                                      Placeholder="Search runs, clients, jobs"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      Clearable="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="JobRunStatusDto?"
                                   Label="Status"
                                   Value="_runStatus"
                                   ValueChanged="OnRunStatusChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="JobRunStatusDto?" Value="@(null)">All statuses</MudSelectItem>
                            @foreach (var status in _runStatusOptions)
                            {
                                <MudSelectItem T="JobRunStatusDto?" Value="@((JobRunStatusDto?)status)">@status</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="ClientEnvironment?"
                                   Label="Environment"
                                   Value="_runEnvironment"
                                   ValueChanged="OnRunEnvironmentChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="ClientEnvironment?" Value="@(null)">Dev + Prod</MudSelectItem>
                            <MudSelectItem T="ClientEnvironment?" Value="@(ClientEnvironment.Dev)">Dev</MudSelectItem>
                            <MudSelectItem T="ClientEnvironment?" Value="@(ClientEnvironment.Prod)">Prod</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2" Class="d-flex justify-end">
                        @if (_selectedJobId.HasValue)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearSelectedJobFilter">
                                Clear Job Focus
                            </MudButton>
                        }
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                    @if (_selectedJobId.HasValue)
                    {
                        <MudChip T="string" OnClose="ClearSelectedJobFilter" Variant="Variant.Outlined" Color="Color.Primary">
                            Job: @_selectedJobName
                        </MudChip>
                    }
                    @if (_runStatus.HasValue)
                    {
                        <MudChip T="string" OnClose="ClearRunStatusFilter" Variant="Variant.Outlined" Color="Color.Secondary">
                            Status: @_runStatus.Value
                        </MudChip>
                    }
                    @if (_runEnvironment.HasValue)
                    {
                        <MudChip T="string" OnClose="ClearRunEnvironmentFilter" Variant="Variant.Outlined" Color="Color.Info">
                            Env: @_runEnvironment.Value.ToShortLabel()
                        </MudChip>
                    }
                </MudStack>

                <MudTable T="JobRunDto"
                          @ref="_runsTable"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          ServerData="ReloadRunsAsync"
                          RowsPerPage="20"
                          OnRowClick="OnRunRowClick"
                          RowStyleFunc="RunRowStyle"
                          Breakpoint="Breakpoint.Md"
                          FixedHeader="true" Height="min(470px, calc(100dvh - 350px))"
                          Class="jobs-table jobs-runs-table">
                    <HeaderContent>
                        <MudTh>Status</MudTh>
                        <MudTh>Run</MudTh>
                        <MudTh>Client</MudTh>
                        <MudTh>Env</MudTh>
                        <MudTh>Workflow</MudTh>
                        <MudTh>Started</MudTh>
                        <MudTh>Completed</MudTh>
                        <MudTh Class="text-right">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Status">
                            <MudChip T="string"
                                     Color="@RunStatusColor(context.Status)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Run">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">#@context.Id</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@((context.TenantDisplayName ?? context.TenantId?.ToString()) ?? "Unassigned")</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Client">
                            <MudTooltip Text="@context.ClientIdentity">
                                <span>@ShortenIdentity(context.ClientDisplayName ?? context.ClientIdentity)</span>
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Env">@context.Environment.ToShortLabel()</MudTd>
                        <MudTd DataLabel="Workflow">@DisplayJobName(context)</MudTd>
                        <MudTd DataLabel="Started">@FormatTimestamp(context.StartedAtMicros)</MudTd>
                        <MudTd DataLabel="Completed">@FormatTimestamp(context.CompletedAtMicros)</MudTd>
                        <MudTd DataLabel="Actions" Class="text-right">
                            <span @onclick:stopPropagation="true">
                                <MudTooltip Text="Delete execution">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(async () => await DeleteRunAsync(context))" />
                                </MudTooltip>
                            </span>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 20, 50 }" />
                    </PagerContent>
                </MudTable>
            </MudStack>
        </MudPaper>
        </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>
</section>



@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    private readonly List<JobDto> _jobs = new();
    private readonly List<string> _folders = new();
    private string? _selectedFolder;
    private bool _isLoading;
    private MudTable<JobRunDto>? _runsTable;
    private string? _runSearch;
    private string? _jobSearch;
    private ClientEnvironment? _jobEnvironment;

    private ulong? _selectedJobId;
    private string _selectedJobName = string.Empty;

    private readonly JobRunStatusDto[] _runStatusOptions = Enum.GetValues<JobRunStatusDto>();
    private JobRunStatusDto? _runStatus;
    private ClientEnvironment? _runEnvironment;
    private int _jobsTableKey;
    private int _runsTableTotal;
    private int _workspaceTab;
    private bool _definitionActionBusy;
    private bool _definitionsLoadFailed;
    private bool _runsLoadFailed;
    private int _definitionsGeneration;
    private int _runsGeneration;
    private int _runPage;
    private DateTimeOffset? _definitionsLoadedAt;
    private DateTimeOffset? _runsLoadedAt;
    private IReadOnlyList<JobRunDto> _loadedRuns = Array.Empty<JobRunDto>();
    private int _runSummaryRunning;
    private int _runSummarySucceeded;
    private int _runSummaryFailed;

    private string FolderMenuLabel => string.IsNullOrWhiteSpace(_selectedFolder) ? "All folders" : GetFolderDisplay(_selectedFolder);
    private string DefinitionsSummary => _definitionsLoadFailed
        ? "Definitions could not be refreshed. " + (_definitionsLoadedAt.HasValue ? $"Showing previous snapshot: {_jobs.Count} definitions from {Freshness(_definitionsLoadedAt)}." : "No snapshot available.")
        : _definitionsLoadedAt.HasValue
            ? $"{_jobs.Count} matching definitions · {_folders.Count} folders in this scope · refreshed {Freshness(_definitionsLoadedAt)}"
            : "Loading definitions…";

    private string RunsSummary => _runsLoadFailed
        ? "Runs could not be refreshed. " + (_runsLoadedAt.HasValue ? $"Showing the previous snapshot from {Freshness(_runsLoadedAt)}; it may predate these filters." : "No snapshot available.")
        : _runsLoadedAt.HasValue
            ? $"Filtered history page {_runPage + 1}: {_loadedRuns.Count} shown of {_runsTableTotal} matching runs · page: {_runSummaryRunning} running, {_runSummarySucceeded} succeeded, {_runSummaryFailed} failed/timed out · refreshed {Freshness(_runsLoadedAt)}"
            : "Loading runs…";

    private static string Freshness(DateTimeOffset? value) => value!.Value.ToOffset(TimeSpan.FromHours(2)).ToString("HH:mm:ss") + " SAST";

    private string ActionTooltip(string action, JobDto job) => _definitionActionBusy
        ? "Finish the open job action first"
        : $"{action} {job.Name}";

    private async Task RunDefinitionActionAsync(Func<Task> action)
    {
        if (_definitionActionBusy) return;
        _definitionActionBusy = true;
        try { await action(); }
        finally { _definitionActionBusy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        _jobSearch = Search;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var generation = ++_definitionsGeneration;
        _isLoading = true;
        StateHasChanged();

        try
        {
            var jobs = await JobApi.GetJobsAsync(_selectedFolder, _jobSearch, _jobEnvironment);
            if (generation != _definitionsGeneration) return;
            _definitionsLoadFailed = false;
            _definitionsLoadedAt = DateTimeOffset.UtcNow;
            _jobs.Clear();
            _jobs.AddRange(jobs.OrderBy(j => j.FolderPath).ThenBy(j => j.Name));

            _folders.Clear();
            _folders.AddRange(_jobs.Select(j => j.FolderPath)
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(p => p, StringComparer.OrdinalIgnoreCase));

            if (_runsTable is not null)
            {
                await _runsTable.ReloadServerData();
            }
        }
        catch (Exception ex)
        {
            if (generation != _definitionsGeneration) return;
            _definitionsLoadFailed = true;
            Snackbar.Add($"Failed to load jobs: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (generation == _definitionsGeneration) _isLoading = false;
            StateHasChanged();
        }
    }

    private void SelectFolder(string? folder)
    {
        if (string.Equals(_selectedFolder, folder, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _selectedFolder = folder;
        _selectedJobId = null;
        _selectedJobName = string.Empty;
        _jobsTableKey++;
        _ = ReloadAsync();
    }

    private async Task CreateJobAsync()
    {
        var parameters = new DialogParameters
        {
            ["JobId"] = (ulong?)null,
            ["SuggestedFolder"] = _selectedFolder
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = false,
            BackdropClick = false
        };

        var dialogRef = await DialogService.ShowAsync<JobEditDialog>("New Job", parameters, options);
        var result = await dialogRef.Result;

        if (result is not null && !result.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditDialogAsync(JobDto job)
    {
        var parameters = new DialogParameters
        {
            ["JobId"] = job.Id,
            ["SuggestedFolder"] = job.FolderPath
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = false,
            BackdropClick = false
        };

        var dialogRef = await DialogService.ShowAsync<JobEditDialog>($"Edit Job: {job.Name}", parameters, options);
        var result = await dialogRef.Result;

        if (result is not null && !result.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task OpenCopyDialogAsync(JobDto job)
    {
        var parameters = new DialogParameters
        {
            ["JobId"] = (ulong?)null,
            ["CloneFromJobId"] = job.Id,
            ["SuggestedFolder"] = job.FolderPath
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = false,
            BackdropClick = false
        };

        var dialogRef = await DialogService.ShowAsync<JobEditDialog>($"Copy Job: {job.Name}", parameters, options);
        var result = await dialogRef.Result;

        if (result is not null && !result.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteJobAsync(JobDto job)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete Job",
            $"Are you sure you want to delete job '{job.Name}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm is true)
        {
            try
            {
                await JobApi.DeleteJobAsync(job.Id);
                Snackbar.Add("Job deleted.", Severity.Success);
                await ReloadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to delete job: {ex.Message}", Severity.Error);
            }
        }
    }

    private string JobRowStyle(JobDto job, int _) =>
        _selectedJobId.HasValue && _selectedJobId.Value == job.Id
            ? "cursor:pointer;background-color:rgba(99,102,241,0.10);"
            : "cursor:pointer";

    private void OnJobRowClick(TableRowClickEventArgs<JobDto> args)
    {
        if (args.Item is null) return;
        _selectedJobId = args.Item.Id;
        _selectedJobName = args.Item.Name;
        _workspaceTab = 1;
        _ = _runsTable?.ReloadServerData();
    }

    private async Task OnJobSearchChanged(string? value)
    {
        _jobSearch = value;
        await ReloadAsync();
    }

    private async Task OnJobEnvironmentChanged(ClientEnvironment? env)
    {
        _jobEnvironment = env;
        await ReloadAsync();
    }

    private Task ClearJobEnvironmentFilter()
    {
        _jobEnvironment = null;
        return ReloadAsync();
    }

    private Task ClearSelectedJobFilter()
    {
        _selectedJobId = null;
        _selectedJobName = string.Empty;
        return _runsTable is null ? Task.CompletedTask : _runsTable.ReloadServerData();
    }

    private async Task OpenRunDialogAsync(JobDto job)
    {
        var parameters = new DialogParameters
        {
            ["Job"] = job
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialogRef = await DialogService.ShowAsync<RunJobDialog>($"Run Job: {job.Name}", parameters, options);
        var result = await dialogRef.Result;

        if (result is not null && !result.Canceled && result.Data is JobRunDto run)
        {
            Snackbar.Add($"Job run {run.Id} started ({run.Status})", Severity.Success);
            NavManager.NavigateTo($"/jobs/{run.JobId}/runs/{run.Id}");
            if (_runsTable is not null)
            {
                await _runsTable.ReloadServerData();
            }
        }
    }

    private async Task<TableData<JobRunDto>> ReloadRunsAsync(TableState state, CancellationToken cancellationToken)
    {
        var generation = ++_runsGeneration;
        try
        {
            var paged = await JobApi.QueryJobRunsAsync(
                jobId: _selectedJobId,
                folder: _selectedFolder,
                search: _runSearch,
                status: _runStatus,
                environment: _runEnvironment,
                page: state.Page,
                pageSize: state.PageSize,
                cancellationToken: cancellationToken);

            if (generation != _runsGeneration) return LastRunsPage();
            var items = paged.Items ?? Array.Empty<JobRunDto>();
            _loadedRuns = items.ToArray();
            _runsLoadFailed = false;
            _runsLoadedAt = DateTimeOffset.UtcNow;
            _runPage = state.Page;
            _runsTableTotal = paged.TotalCount;
            _runSummaryRunning = items.Count(x => x.Status == JobRunStatusDto.Running);
            _runSummarySucceeded = items.Count(x => x.Status == JobRunStatusDto.Succeeded);
            _runSummaryFailed = items.Count(x => x.Status is JobRunStatusDto.Failed or JobRunStatusDto.TimedOut);

            return new TableData<JobRunDto>
            {
                Items = items,
                TotalItems = paged.TotalCount
            };
        }
        catch (OperationCanceledException)
        {
            return LastRunsPage();
        }
        catch (Exception ex)
        {
            if (generation == _runsGeneration)
            {
                _runsLoadFailed = true;
                Snackbar.Add($"Failed to load job runs: {ex.Message}", Severity.Error);
            }
            return LastRunsPage();
        }
    }

    private TableData<JobRunDto> LastRunsPage() => new() { Items = _loadedRuns, TotalItems = _runsTableTotal };

    private async Task OnRunSearchChanged(string? value)
    {
        _runSearch = value;
        if (_runsTable is not null)
        {
            await _runsTable.ReloadServerData();
        }
    }

    private async Task OnRunStatusChanged(JobRunStatusDto? status)
    {
        _runStatus = status;
        if (_runsTable is not null)
        {
            await _runsTable.ReloadServerData();
        }
    }

    private async Task OnRunEnvironmentChanged(ClientEnvironment? environment)
    {
        _runEnvironment = environment;
        if (_runsTable is not null)
        {
            await _runsTable.ReloadServerData();
        }
    }

    private Task ClearRunStatusFilter()
    {
        _runStatus = null;
        return _runsTable is null ? Task.CompletedTask : _runsTable.ReloadServerData();
    }

    private Task ClearRunEnvironmentFilter()
    {
        _runEnvironment = null;
        return _runsTable is null ? Task.CompletedTask : _runsTable.ReloadServerData();
    }

    private string RunRowStyle(JobRunDto _, int __) => "cursor:pointer";

    private void OnRunRowClick(TableRowClickEventArgs<JobRunDto> args)
    {
        if (args.Item is null) return;
        var run = args.Item;
        NavManager.NavigateTo($"/jobs/{run.JobId}/runs/{run.Id}");
    }

    private async Task DeleteRunAsync(JobRunDto run)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete Execution",
            $"Delete run #{run.Id} for '{DisplayJobName(run)}'? This removes the execution history entry and its logs.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm is not true)
        {
            return;
        }

        try
        {
            await JobApi.DeleteJobRunAsync(run.Id);
            Snackbar.Add($"Run #{run.Id} deleted.", Severity.Success);
            if (_runsTable is not null)
            {
                await _runsTable.ReloadServerData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete run: {ex.Message}", Severity.Error);
        }
    }

    private Color RunStatusColor(JobRunStatusDto status) => status switch
    {
        JobRunStatusDto.Succeeded => Color.Success,
        JobRunStatusDto.Running => Color.Info,
        JobRunStatusDto.Pending => Color.Warning,
        JobRunStatusDto.Cancelled => Color.Warning,
        JobRunStatusDto.Failed => Color.Error,
        JobRunStatusDto.TimedOut => Color.Error,
        _ => Color.Default
    };

    private static string DisplayJobName(JobRunDto run)
    {
        if (!string.IsNullOrWhiteSpace(run.JobName))
        {
            return run.JobName;
        }

        return $"Job #{run.JobId}";
    }

    private static string FormatTimestamp(long micros) => FormatTimestamp((long?)micros);

    private static string FormatTimestamp(long? micros)
    {
        if (micros is null) return "-";

        try
        {
            var dt = DateTimeOffset.FromUnixTimeMilliseconds(micros.Value / 1000);
            return dt.ToLocalTime().ToString("g");
        }
        catch
        {
            return "-";
        }
    }

    private static string ShortenIdentity(string? identity, int head = 6, int tail = 6)
    {
        if (string.IsNullOrWhiteSpace(identity))
            return "-";

        if (identity.Length <= head + tail + 3)
            return identity;

        return $"{identity[..head]}…{identity[^tail..]}";
    }

    private static string GetClientDisplayText(JobDto job)
    {
        if (!string.IsNullOrWhiteSpace(job.ClientDisplayName))
            return StripTrailingIp(job.ClientDisplayName) ?? job.ClientDisplayName;

        return ShortenIdentity(job.ClientIdentity);
    }

    private static string GetClientTooltip(JobDto job) => job.ClientIdentity ?? string.Empty;

    private static string? StripTrailingIp(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var trimmed = value.Trim();
        var openParen = trimmed.LastIndexOf(" (", StringComparison.Ordinal);
        return openParen > 0 && trimmed.EndsWith(')')
            ? trimmed[..openParen].Trim()
            : trimmed;
    }

    private static string GetFolderDisplay(string? folder)
    {
        if (string.IsNullOrWhiteSpace(folder))
        {
            return "Root";
        }

        return folder.Trim('/').Replace("/", " / ", StringComparison.Ordinal);
    }
}
