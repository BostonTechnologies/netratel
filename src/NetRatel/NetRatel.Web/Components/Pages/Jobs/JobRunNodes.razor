@using NetRatel.Shared.Contracts.Jobs
@implements IDisposable
@inject IJobApiClient JobApi

<section class="job-run-nodes" aria-label="Node workflows" data-testid="job-run-nodes">
    <div class="job-run-node-controls job-run-node-summary">
        <strong>@Run.TargetCount @(Run.TargetCount == 1 ? "node" : "nodes")</strong>
        @if (Run.NodeCounts is { } counts) { <span role="status">@CountsLabel(counts)</span> }
        @if (Run.EffectiveConcurrency > 1) { <span class="job-run-node-capacity" title="@($"Configured Thread Count: {Run.ExecutionPolicy?.ThreadCount ?? 1}")">@Run.EffectiveConcurrency parallel</span> }
        <MudSwitch T="bool" @bind-Value="_followSelected" Label="Follow selected node" Color="Color.Primary" Size="Size.Small" />
    </div>
    @if (_error is not null) { <MudAlert Severity="Severity.Warning" Dense="true">@_error <MudButton Size="Size.Small" OnClick="LoadAsync">Retry nodes</MudButton></MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" aria-label="Loading node summaries" /> }
    <MudExpansionPanels MultiExpansion="true" Elevation="0" Dense="true" Gutters="false">
        @foreach (var node in _nodes.OrderBy(node => node.Ordinal))
        {
            <MudExpansionPanel @key="node.AgentId" Expanded="_expanded.Contains(node.AgentId)" ExpandedChanged="@(expanded => NodeExpanded(node.AgentId, expanded))" Class="job-run-node-panel">
                <TitleContent>
                    <div class="job-run-node-heading">
                        <div class="job-run-node-name"><strong>@(string.IsNullOrWhiteSpace(node.Hostname) ? "Hostname unavailable" : node.Hostname)</strong> @if (!string.IsNullOrWhiteSpace(node.DisplayName) && node.DisplayName != node.Hostname) { <span> · @node.DisplayName</span> }</div>
                        <span class="job-run-node-state" style="@($"color:var(--mud-palette-{NodeColor(node.State).ToString().ToLowerInvariant()})")">@StateLabel(node.State)</span>
                        <span>@Window(node)</span>
                        @if (node.CurrentStepOrdinal > 0) { <span>Step @node.CurrentStepOrdinal</span> }
                        @if (_expanded.Contains(node.AgentId)) { <span @onclick:stopPropagation="true"><MudTooltip Text="Follow this node"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.MyLocation" Color="@(_selected == node.AgentId && _followSelected ? Color.Primary : Color.Default)" OnClick="@(() => SelectNode(node.AgentId))" aria-label="Follow this node" /></MudTooltip></span> }
                    </div>
                    @if (node.Reason is { Length: > 0 } reason) { <MudText Typo="Typo.caption" Class="job-run-node-reason" data-reason="@reason">@ReasonLabel(reason)</MudText> }
                </TitleContent>
                <ChildContent>
                    @if (_expanded.Contains(node.AgentId))
                    {
                        <JobRunNodeDetails @key="(Run.Id, node.AgentId, node.NativeRunId)" ParentRunId="Run.Id" Node="node" ViewState="ViewState(node.AgentId)" Following="@(_followSelected && _selected == node.AgentId)" FollowingChanged="@(following => FollowChanged(node.AgentId, following))" />
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
    @if (!_loading && _nodes.Count == 0) { <MudText Typo="Typo.body2">No node evidence is available.</MudText> }
    @if (_total > PageSize)
    {
        <div class="job-run-node-controls">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(_page <= 1 || _loading)" OnClick="PreviousAsync" aria-label="Previous nodes" />
            <MudText Typo="Typo.caption">Page @_page · @_total nodes</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(_page * PageSize >= _total || _loading)" OnClick="NextAsync" aria-label="Next nodes" />
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public JobRunDto Run { get; set; } = default!;
    private const int PageSize = 25;
    private IReadOnlyList<JobRunNodeDto> _nodes = [];
    private readonly HashSet<Guid> _expanded = [];
    private readonly Dictionary<Guid, JobRunNodeViewState> _viewStates = [];
    private JobRunDto? _received;
    private Guid? _selected;
    private int _page = 1, _total;
    private long _generation;
    private bool _followSelected = true, _loading;
    private string? _error;
    private readonly CancellationTokenSource _dispose = new();

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_received, Run)) return;
        if (_received?.Id != Run.Id)
        { _page = 1; _expanded.Clear(); _viewStates.Clear(); _selected = null; _followSelected = true; }
        _received = Run;
        if (_page == 1 && Run.Nodes is { Count: > 0 } nodes)
        {
            _nodes = nodes.OrderBy(node => node.Ordinal).Take(PageSize).ToArray();
            _total = Math.Max(Run.NodesTotalCount, Run.TargetCount);
            OpenSingleton();
        }
        else await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var generation = ++_generation;
        _loading = true; _error = null;
        try
        {
            var result = await JobApi.GetJobRunNodesAsync(Run.Id, _page, PageSize, _dispose.Token);
            if (generation != _generation) return;
            if (result.Items.Any(node => node.ParentRunId != Run.Id)) throw new InvalidDataException("The node page does not belong to this parent run.");
            _nodes = result.Items; _total = result.TotalCount; OpenSingleton();
        }
        catch (OperationCanceledException) when (_dispose.IsCancellationRequested) { _nodes = []; }
        catch (Exception ex) { if (generation == _generation) _error = ex.Message; }
        finally { if (generation == _generation) _loading = false; }
    }
    private void OpenSingleton()
    {
        if (_total == 1 && _nodes.Count == 1 && _viewStates.Count == 0) { _expanded.Add(_nodes[0].AgentId); _selected = _nodes[0].AgentId; }
    }
    private JobRunNodeViewState ViewState(Guid agentId)
    {
        if (!_viewStates.TryGetValue(agentId, out var state)) _viewStates[agentId] = state = new();
        return state;
    }
    private void NodeExpanded(Guid agentId, bool expanded)
    {
        if (expanded) { _expanded.Add(agentId); _selected ??= agentId; }
        else { _expanded.Remove(agentId); if (_selected == agentId) _followSelected = false; }
    }
    private void SelectNode(Guid agentId) { _selected = agentId; _followSelected = true; _expanded.Add(agentId); }
    private void FollowChanged(Guid agentId, bool following) { if (_selected == agentId) _followSelected = following; }
    private Task PreviousAsync() { _page = Math.Max(1, _page - 1); return LoadAsync(); }
    private Task NextAsync() { _page++; return LoadAsync(); }
    private static string StateLabel(JobRunNodeState state) => state switch { JobRunNodeState.NeverStarted => "Queued", JobRunNodeState.Claimed => "Starting", JobRunNodeState.Unknown => "Outcome unknown", _ => state.ToString() };
    private static string ReasonLabel(string reason) => reason switch
    {
        JobRunNodeReasons.StoppedAfterNodeFailure => "Not started after another node failed.",
        JobRunNodeReasons.StoppedAfterUnknownExecution => "Not started while another execution is uncertain.",
        JobRunNodeReasons.ParentCancelled => "Cancelled before starting.",
        _ => reason
    };
    private static string CountsLabel(JobRunNodeCountsDto counts) => string.Join(" · ", new[]
    {
        (counts.Queued, "queued"), (counts.Running, "running"), (counts.Succeeded, "succeeded"), (counts.Failed, "failed"),
        (counts.Skipped, "skipped"), (counts.Cancelled, "cancelled"), (counts.TimedOut, "timed out"), (counts.Unknown, "uncertain")
    }.Where(item => item.Item1 > 0).Select(item => $"{item.Item1} {item.Item2}"));
    private static Color NodeColor(JobRunNodeState state) => state switch { JobRunNodeState.Succeeded => Color.Success, JobRunNodeState.Failed or JobRunNodeState.TimedOut => Color.Error, JobRunNodeState.Running => Color.Info, _ => Color.Warning };
    private static string Window(JobRunNodeDto node) => node.StartedAtMicros is not { } start ? "Not started"
        : node.State == JobRunNodeState.Unknown ? "Duration unknown"
        : node.CompletedAtMicros is { } finish ? TimeSpan.FromMilliseconds(Math.Max(0, finish - start) / 1000d).ToString(@"hh\:mm\:ss") : "Running";
    public void Dispose() { _dispose.Cancel(); _dispose.Dispose(); }
}
