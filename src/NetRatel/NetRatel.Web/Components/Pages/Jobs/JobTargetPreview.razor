@using System.Text.Json
@using NetRatel.Shared
@using NetRatel.Shared.Contracts.Jobs
@implements IDisposable
@inject IHttpClientFactory HttpClients

<section class="job-target-preview" aria-label="Resolved target preview" data-testid="job-target-preview">
    @if (RuntimeUnresolved)
    { <MudText Typo="Typo.body2" role="status">Targets supplied when the job runs. A complete typed runtime binding is required before preview.</MudText> }
    else
    { <MudButton OnClick="@(() => PreviewAsync(1))" Color="Color.Primary" Variant="Variant.Outlined" Disabled="@(Disabled || TenantId <= 0 || Target is null || _loading)">@ButtonLabel</MudButton> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" aria-label="Resolving targets without execution" /> }
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert> }
    @if (_items is not null)
    {
        var policy = _launchPreview?.ExecutionPolicy ?? ExecutionPolicy ?? new();
        <MudText Typo="Typo.subtitle2" role="status">@_total targets · configured @policy.ThreadCount · up to @Math.Min(_total, policy.ThreadCount) active, subject to available capacity.</MudText>
        @if (_launchPreview is { } launch)
        { <MudText Typo="Typo.body2">Current effective concurrency: @launch.EffectiveConcurrency.@(launch.EffectiveConcurrency == 0 ? " Waiting for available execution capacity." : "")</MudText> }
        <MudText Typo="Typo.caption">@(_groupRevision is { } revision ? $"Group revision {revision}. " : "")Every match is included across every page. Preview dispatches no execution.</MudText>
        @foreach (var node in _items)
        {
            <MudPaper Outlined="true" Class="pa-2 job-target-preview-row" @key="node.AgentId">
                <MudText Typo="Typo.body2"><strong>@(string.IsNullOrWhiteSpace(node.Hostname) ? "Hostname unavailable" : node.Hostname)</strong> · @node.DisplayName</MudText>
                <MudText Typo="Typo.caption">@node.OperatingSystem · @(node.IsOnline ? "Online" : "Offline") · @string.Join(" · ", node.Tags)</MudText>
                <MudText Typo="Typo.caption">Client @node.AgentId</MudText>
            </MudPaper>
        }
        <div class="job-target-preview-pages">
            <MudButton OnClick="@(() => PreviewAsync(Math.Max(1, _page - 1)))" Disabled="@(_page <= 1 || _loading)">Previous targets</MudButton>
            <MudText Typo="Typo.caption">Page @_page · @_total total</MudText>
            <MudButton OnClick="@(() => PreviewAsync(_nextPage ?? _page))" Disabled="@(_nextPage is null || _loading)">Next targets</MudButton>
        </div>
        <MudText Typo="Typo.caption" Class="job-target-preview-digest">Preview digest: @_digest</MudText>
    }
</section>

@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter] public JobTargetDefinition? Target { get; set; }
    [Parameter] public JobExecutionPolicy? ExecutionPolicy { get; set; }
    [Parameter] public ClientEnvironment? Environment { get; set; }
    [Parameter] public JobRuntimeTargetInput? RuntimeTarget { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string[]>? Parameters { get; set; }
    [Parameter] public ulong? JobId { get; set; }
    [Parameter] public RunJobRequest? RunRequest { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string ButtonLabel { get; set; } = "Preview targets";
    [Parameter] public EventCallback<int?> CountChanged { get; set; }
    [Parameter] public EventCallback<JobLaunchPreviewDto?> LaunchPreviewChanged { get; set; }
    private const int PageSize = 25;
    private JobTargetsApiClient Api => _api ??= new(HttpClients);
    private JobTargetsApiClient? _api;
    private JobLaunchPreviewDto? _launchPreview;
    private IReadOnlyList<JobNodeInventoryDto>? _items;
    private string? _signature, _error, _digest;
    private int _page = 1, _total;
    private int? _nextPage;
    private long? _groupRevision;
    private long _generation;
    private bool _loading;
    private readonly CancellationTokenSource _dispose = new();
    private bool RuntimeUnresolved => Target?.Source == JobTargetSource.RuntimeInput &&
        (RunRequest?.RuntimeTarget ?? RuntimeTarget)?.Values is not { Count: > 0 } && Target.RuntimeInput?.DefaultValues is not { Count: > 0 };

    protected override async Task OnParametersSetAsync()
    {
        // Values stay in memory and the protected server request; the signature is never rendered or logged.
        var signature = JsonSerializer.Serialize(new { TenantId, Target, Environment, RuntimeTarget, Parameters, JobId, RunRequest });
        if (_signature == signature) return;
        var previouslyReceived = _signature is not null;
        _signature = signature; ++_generation; _loading = false; _launchPreview = null; _items = null; _error = null; _page = 1;
        if (previouslyReceived) { await CountChanged.InvokeAsync(null); await LaunchPreviewChanged.InvokeAsync(null); }
    }
    private async Task PreviewAsync(int page)
    {
        if (Disabled || TenantId <= 0 || Target is null || RuntimeUnresolved) return;
        var generation = ++_generation;
        _loading = true; _error = null;
        try
        {
            if (JobId is { } jobId && RunRequest is { } request)
            {
                var input = page > 1 && _launchPreview is { } previous ? request with { ExpectedTargetPlanDigest = previous.Digest } : request;
                var preview = await Api.PreviewRunAsync(jobId, input, page, PageSize, _dispose.Token);
                if (generation != _generation) return;
                if (preview.Nodes.Count > PageSize || preview.Page != page || preview.TargetCount < preview.Nodes.Count ||
                    preview.Digest is not { Length: 64 } || preview.Digest.Any(character => !Uri.IsHexDigit(character)))
                    throw new InvalidDataException("The launch preview exceeded its page bound or returned incomplete plan identity. Retry the preview.");
                _launchPreview = preview;
                _total = preview.TargetCount; _page = preview.Page; _nextPage = preview.NextPage; _groupRevision = preview.GroupRevision; _digest = preview.Digest;
                _items = preview.Nodes.Select(node => new JobNodeInventoryDto(node.AgentId,
                    node.Hostname, node.DisplayName ?? "", node.Name, node.Tags, node.OperatingSystem, node.Architecture, node.Environment,
                    node.IsOnline, node.IsEnabled, null)).ToArray();
                await LaunchPreviewChanged.InvokeAsync(preview);
            }
            else
            {
                var preview = await Api.PreviewAsync(TenantId, new(Target, Environment, RuntimeTarget: RuntimeTarget, Parameters: Parameters, Page: page, PageSize: PageSize), _dispose.Token);
                if (generation != _generation) return;
                if (preview.Items.Count > PageSize || preview.Page != page) throw new InvalidDataException("The target preview exceeded its requested page bound. Retry the preview.");
                _total = preview.TotalCount; _page = preview.Page; _nextPage = preview.NextPage; _groupRevision = preview.GroupRevision; _digest = preview.Digest; _items = preview.Items;
            }
            await CountChanged.InvokeAsync(_total);
        }
        catch (OperationCanceledException) when (_dispose.IsCancellationRequested) { _items = null; }
        catch (Exception ex)
        {
            if (generation == _generation)
            { _error = ex.Message; _items = null; _launchPreview = null; await CountChanged.InvokeAsync(null); await LaunchPreviewChanged.InvokeAsync(null); }
        }
        finally { if (generation == _generation) _loading = false; }
    }
    public void Dispose() { _dispose.Cancel(); _dispose.Dispose(); }
}
