@using System.Text.Json
@using NetRatel.Shared
@using NetRatel.Shared.Contracts.Jobs
@implements IDisposable
@inject IJobApiClient JobApi
@inject IHttpClientFactory HttpClients
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

<MudDialog Class="@(_params?.Count > 1 || _availableNodes.Count > 25 ? "jobs-run-dialog jobs-run-dialog-wide" : "jobs-run-dialog")">
    <DialogContent>
        <form class="run-job-dialog" id="@_formId" autocomplete="off" aria-label="Job inputs" @onsubmit:preventDefault="true">
            <div class="run-job-context">
                <strong>@Job.Name</strong>
                <span>@TargetSummary</span>
                <span>@(Job.TenantDisplayName ?? "Tenant label unavailable")</span>
                <span>@(Job.Environment?.ToShortLabel() ?? "Environment unknown")</span>
            </div>
            @if (Job.Target is not null)
            {
                <section class="run-job-targets" aria-label="Invocation targets">
                    @if (Job.Target.Source == JobTargetSource.ExecutionGroup)
                    {
                        <MudText Typo="Typo.caption">HA Group@(_launchPreview?.GroupName is { Length: > 0 } name ? $": {name}" : "") · One healthy worker per run, balanced across the selected pool.</MudText>
                    }
                    @if (Job.Target.Source == JobTargetSource.RuntimeInput && Job.Target.RuntimeInput is { } runtime)
                    {
                        @if (runtime.Kind is JobRuntimeTargetKind.ClientId or JobRuntimeTargetKind.ClientIds && Job.TenantId is { } tenantId)
                        {
                            <JobNodePicker TenantId="tenantId" Environment="Job.Environment" Value="RuntimeIds" ValueChanged="RuntimeNodesChangedAsync" MaximumSelection="@(runtime.Kind == JobRuntimeTargetKind.ClientId ? 1 : null)" Disabled="_isSubmitting" />
                            <details class="run-job-direct-values"><summary>Enter client IDs</summary>
                                <MudTextField T="string" Value="_runtimeValues" ValueChanged="RuntimeValuesChangedAsync" Label="@($"{runtime.Name} ({runtime.Kind})")" InputId="@(_formId + "-runtime-target")" UserAttributes="@JobParameterInput.OperationalAttributes(_formId + "-runtime-target")" Lines="2" Variant="Variant.Outlined" Immediate="true" Disabled="_isSubmitting" HelperText="One exact client ID per line." />
                            </details>
                        }
                        else
                        {
                            <MudTextField T="string" Value="_runtimeValues" ValueChanged="RuntimeValuesChangedAsync" Label="@($"{runtime.Name} ({runtime.Kind})")" InputId="@(_formId + "-runtime-target")" UserAttributes="@JobParameterInput.OperationalAttributes(_formId + "-runtime-target")" Required="true" Lines="2" Variant="Variant.Outlined" Immediate="true" Disabled="_isSubmitting" HelperText="One exact value per line. Commas and filter punctuation stay literal." />
                        }
                        @if (RuntimeInputError is { } targetError) { <MudText Typo="Typo.caption" Color="Color.Error" role="alert">@targetError</MudText> }
                    }
                    @if (_availableNodes.Count > 0 && Job.Target.Source != JobTargetSource.RuntimeInput)
                    {
                        <JobNodePicker TenantId="@(Job.TenantId ?? 0)" Candidates="_availableNodes" Value="_selectedTargetIds" ValueChanged="InvocationNodesChangedAsync" Disabled="_isSubmitting" />
                    }
                    @if (_targetsLoading) { <MudProgressLinear Indeterminate="true" aria-label="Resolving available nodes" /> }
                    @if (_targetsError is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">@_targetsError <MudButton Size="Size.Small" OnClick="@(() => RefreshTargetsAsync(true, false))">Reload nodes</MudButton></MudAlert>
                    }
                </section>
            }
            @if (_params is null)
            {
                @if (_parameterLoadFailed)
                {
                    <MudAlert Severity="Severity.Error">Parameters could not be loaded. Try again before starting a run.</MudAlert>
                    <MudButton OnClick="LoadParametersAsync" Disabled="_loadingParameters">Retry parameters</MudButton>
                }
                else
                {
                    <MudProgressLinear Indeterminate="true" aria-label="Loading parameters" />
                }
            }
            else if (_params.Count == 0)
            {
                <MudText Typo="Typo.body2">This job has no inputs.</MudText>
            }
            else
            {
                <div class="run-job-inputs @(_params.Count == 1 ? "run-job-inputs-single" : "")">
                    @foreach (var p in _params)
                    {
                        var type = p.Type.ToLowerInvariant();
                        var error = FieldError(p);
                        <div class="run-job-field @(type == "json" || type == "string" && (GetValue(p.Name)?.Contains('\n') == true || p.Default?.Length > 180) ? "run-job-field-wide" : "")" @key="p.Id">
                            @if (type == "bool")
                            {
                                <MudSwitch T="bool" Value="GetBoolValue(p.Name)" ValueChanged="value => SetBoolValue(p.Name, value)" Label="@(p.Name + (p.Required ? " *" : ""))" Disabled="_isSubmitting" Color="Color.Primary" />
                                @if (!string.IsNullOrWhiteSpace(p.Description)) { <MudText Typo="Typo.caption">@p.Description</MudText> }
                            }
                            else if (type == "select")
                            {
                                <MudSelect T="string" Value="@GetValue(p.Name)" ValueChanged="value => SetValue(p.Name, value)" Label="@p.Name" InputId="@FieldId(p)" UserAttributes="@JobParameterInput.OperationalAttributes(FieldId(p))" Required="p.Required" Variant="Variant.Outlined" Margin="Margin.Dense" Error="@(error is not null)" HelperText="@p.Description" Disabled="_isSubmitting" Clearable="@(!p.Required)">
                                    @foreach (var option in JobParameterInput.SelectOptions(p.OptionsJson))
                                    { <MudSelectItem T="string" Value="@option">@option</MudSelectItem> }
                                </MudSelect>
                            }
                            else
                            {
                                <MudTextField T="string" Value="@GetValue(p.Name)" ValueChanged="value => SetValue(p.Name, value)" Label="@p.Name" InputId="@FieldId(p)" UserAttributes="@JobParameterInput.OperationalAttributes(FieldId(p), type == "secret")" Required="p.Required" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="@(type == "json" || type == "string" && GetValue(p.Name)?.Contains('\n') == true ? 3 : 1)" InputType="@(type == "secret" ? InputType.Password : InputType.Text)" InputMode="@(type == "int" ? InputMode.numeric : InputMode.text)" Error="@(error is not null)" HelperText="@p.Description" Disabled="_isSubmitting" />
                            }
                            @if (error is not null) { <div class="run-job-field-error" role="alert">@error</div> }
                        </div>
                    }
                </div>
            }
            <div class="run-job-metadata">
                <MudTextField @bind-Value="_startedBy" Label="Started by" InputId="@(_formId + "-started-by")" UserAttributes="@JobParameterInput.OperationalAttributes(_formId + "-started-by")" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isSubmitting" />
            </div>
            @if (_launchError is not null) { <MudText Color="Color.Error" Typo="Typo.body2" role="alert">@_launchError</MudText> }
        </form>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSubmitting">Cancel</MudButton>
        <MudButton Disabled="@(!CanRun)" OnClick="RunAsync" Color="Color.Primary" Variant="Variant.Filled">Start Run</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public JobDto Job { get; set; } = default!;
    [Parameter] public EventCallback<JobRunDto> OnRunCompleted { get; set; }
    private readonly string _formId = $"job-operation-{Guid.NewGuid():N}";
    private string FieldId(JobParamDto parameter) => $"{_formId}-parameter-{parameter.Id}";
    private List<JobParamDto>? _params;
    private readonly Dictionary<string, string?> _values = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _touched = new(StringComparer.OrdinalIgnoreCase);
    private string _startedBy = "ui";
    private string? _launchError;
    private bool _isSubmitting, _parameterLoadFailed, _loadingParameters, _submitted, _targetsLoading;
    private string _runtimeValues = "";
    private JobLaunchPreviewDto? _launchPreview;
    private IReadOnlyList<JobNodeInventoryDto> _availableNodes = [];
    private IReadOnlyList<Guid> _selectedTargetIds = [];
    private IReadOnlyList<Guid>? _invocationSubset;
    private string? _targetsError;
    private long _targetsGeneration;
    private CancellationTokenSource? _targetResolution;
    private JobTargetsApiClient? _targetsApi;
    private readonly CancellationTokenSource _dispose = new();
    private string TargetSummary => Job.Target?.Source switch
    {
        JobTargetSource.ExecutionGroup => "HA Group",
        JobTargetSource.ExplicitNodes => "Selected nodes",
        JobTargetSource.NodeFilter => "Matching nodes",
        JobTargetSource.RuntimeInput => "Targets supplied for this invocation",
        _ => Job.ClientDisplayName ?? "Target label unavailable"
    };
    private string[] RuntimeValues => JobTargetPicker.ParseLines(_runtimeValues);
    private IReadOnlyList<Guid> RuntimeIds => RuntimeValues.Where(value => Guid.TryParse(value, out _)).Select(Guid.Parse).ToArray();
    private string? RuntimeInputError => Job.Target?.Source != JobTargetSource.RuntimeInput ? null
        : RuntimeValues.Length == 0 ? "Supply the required runtime target input."
        : Job.Target.RuntimeInput?.Kind is JobRuntimeTargetKind.ClientId or JobRuntimeTargetKind.Hostname or JobRuntimeTargetKind.Tag && RuntimeValues.Length != 1 ? "This target type requires exactly one value."
        : Job.Target.RuntimeInput?.Kind is JobRuntimeTargetKind.ClientId or JobRuntimeTargetKind.ClientIds && RuntimeIds.Count != RuntimeValues.Length ? "Enter complete stable client IDs or select clients below."
        : null;
    private bool ValidInputs => _params is not null && _params.All(p => JobParameterInput.Validate(p.Type, GetValue(p.Name), p.Required, p.OptionsJson) is null);
    private bool CanResolve => ValidInputs && RuntimeInputError is null;
    private bool CanRun => !_isSubmitting && !_submitted && _params is not null && !string.IsNullOrWhiteSpace(_startedBy)
        && ValidInputs && RuntimeInputError is null && (Job.Target is null || !_targetsLoading && _launchPreview is not null);

    protected override Task OnInitializedAsync()
    {
        _runtimeValues = string.Join("\n", Job.Target?.RuntimeInput?.DefaultValues ?? []);
        return LoadParametersAsync();
    }
    private async Task LoadParametersAsync()
    {
        if (_loadingParameters) return;
        _loadingParameters = true;
        _parameterLoadFailed = false;
        try
        {
            _params = (await JobApi.GetJobParamsAsync(Job.Id)).ToList();
            foreach (var p in _params)
                if (!_values.ContainsKey(p.Name))
                    _values[p.Name] = p.Type.Equals("bool", StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(p.Default) ? "false" : p.Default ?? string.Empty;
            await MudDialog.SetOptionsAsync(MudDialog.Options with { MaxWidth = _params.Count > 1 ? MaxWidth.Large : MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        }
        catch { _parameterLoadFailed = true; _params = null; }
        finally { _loadingParameters = false; }
        if (_params is not null) await RefreshTargetsAsync(true, false);
    }
    private string? GetValue(string key) => _values.GetValueOrDefault(key);
    private string? FieldError(JobParamDto p) => _touched.Contains(p.Name) || !string.IsNullOrWhiteSpace(GetValue(p.Name))
        ? JobParameterInput.Validate(p.Type, GetValue(p.Name), p.Required, p.OptionsJson) : null;
    private Task SetValue(string key, string? value) { _values[key] = value; _touched.Add(key); return RefreshTargetsAsync(_invocationSubset is null, true); }
    private Task RuntimeValuesChangedAsync(string? value) { _runtimeValues = value ?? ""; return RefreshTargetsAsync(true, true); }
    private Task RuntimeNodesChangedAsync(IReadOnlyList<Guid> ids) { _runtimeValues = string.Join("\n", ids); return RefreshTargetsAsync(true, false); }
    private Task InvocationNodesChangedAsync(IReadOnlyList<Guid> ids)
    {
        _selectedTargetIds = ids;
        // Once the operator edits the set, keep those exact choices even when
        // parameters or the saved job change. Reselecting all visible nodes must
        // not grant any newly appearing node implicit permission for this run.
        _invocationSubset = ids;
        return RefreshTargetsAsync(false, false);
    }
    private async Task RefreshTargetsAsync(bool resetSelection, bool debounce)
    {
        if (Job.Target is null) return;
        var generation = ++_targetsGeneration;
        _targetResolution?.Cancel(); _targetResolution?.Dispose();
        _targetResolution = CancellationTokenSource.CreateLinkedTokenSource(_dispose.Token);
        var ct = _targetResolution.Token;
        _launchPreview = null; _targetsError = null; _targetsLoading = false;
        if (resetSelection) { _invocationSubset = null; _availableNodes = []; _selectedTargetIds = []; }
        if (!CanResolve) return;
        if (_invocationSubset is { Count: 0 }) { _targetsError = "Choose at least one node for this run."; return; }
        _targetsLoading = true;
        var request = BuildRequest(false);
        try
        {
            if (debounce) await Task.Delay(250, ct);
            _targetsApi ??= new(HttpClients);
            var first = await _targetsApi.PreviewRunAsync(Job.Id, request, 1, 100, ct);
            if (first.Page != 1 || first.Nodes.Count > 100 || first.Digest is not { Length: 64 } ||
                first.Digest.Any(character => !Uri.IsHexDigit(character)) || first.DefinitionDigest is not { Length: 64 } ||
                first.DefinitionDigest.Any(character => !Uri.IsHexDigit(character)) || first.Target.Source != Job.Target.Source)
                throw new InvalidDataException("The current target selection could not be verified. Reload the job and try again.");
            if (Job.Target.Source == JobTargetSource.ExecutionGroup && (first.WorkerPoolCount is not > 0 || first.TargetCount != 1))
                throw new InvalidDataException("The service must support one-worker HA admission before this job can run.");
            var nodes = new List<JobTargetNode>(first.Nodes);
            var page = first;
            while (page.NextPage is { } next)
            {
                if (next != page.Page + 1 || next > 100) throw new InvalidDataException("The node page sequence is incomplete.");
                page = await _targetsApi.PreviewRunAsync(Job.Id, request, next, 100, ct);
                if (page.Digest != first.Digest || page.DefinitionDigest != first.DefinitionDigest)
                    throw new InvalidDataException("The available nodes changed while loading.");
                nodes.AddRange(page.Nodes);
            }
            if (generation != _targetsGeneration) return;
            var expected = first.WorkerPoolCount ?? first.TargetCount;
            if (expected is < 1 or > 10_000 || nodes.Count != expected || nodes.Select(node => node.AgentId).Distinct().Count() != expected)
                throw new InvalidDataException("The complete node selection could not be loaded.");
            if (resetSelection)
            {
                _availableNodes = nodes.Select(node => new JobNodeInventoryDto(node.AgentId, node.Hostname,
                    node.DisplayName ?? node.Name ?? "Hostname unavailable", node.Name, node.Tags, node.OperatingSystem,
                    node.Architecture, node.Environment, node.IsOnline, node.IsEnabled, null)).ToArray();
                _selectedTargetIds = nodes.Select(node => node.AgentId).ToArray();
            }
            _launchPreview = first;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        catch (Exception error) when (error is HttpRequestException or InvalidDataException)
        { if (generation == _targetsGeneration) _targetsError = error.Message; }
        finally { if (generation == _targetsGeneration) _targetsLoading = false; }
    }
    private RunJobRequest BuildRequest(bool reviewed)
    {
        var payload = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        foreach (var p in _params ?? [])
            payload[p.Name] = p.Type.Equals("bool", StringComparison.OrdinalIgnoreCase) ? GetBoolValue(p.Name) : GetValue(p.Name);
        return new RunJobRequest(_startedBy, JsonSerializer.Serialize(payload), ClientIdentityOverride: null, Environment: Job.Environment)
        {
            RuntimeTarget = Job.Target?.Source == JobTargetSource.RuntimeInput && Job.Target.RuntimeInput is { } runtime ? new(runtime.Kind, RuntimeValues, runtime.AllOf) : null,
            ExpectedTargetPlanDigest = reviewed ? _launchPreview?.Digest : null,
            SelectedTargetAgentIds = _invocationSubset
        };
    }
    private bool GetBoolValue(string key) => bool.TryParse(GetValue(key), out var value) && value;
    private Task SetBoolValue(string key, bool value) => SetValue(key, value ? "true" : "false");
    private async Task RunAsync()
    {
        if (!CanRun || _params is null) return;
        _isSubmitting = true;
        _launchError = null;
        try
        {
            var run = await JobApi.RunJobAsync(Job.Id, BuildRequest(true));
            _submitted = true;
            Snackbar.Add("Run started.", Severity.Success);
            if (OnRunCompleted.HasDelegate) await OnRunCompleted.InvokeAsync(run);
            NavManager.NavigateTo($"/jobs/{Job.Id}/runs/{run.Id}");
            MudDialog.Close(DialogResult.Ok(run));
        }
        catch { _launchError = "The run could not be started. Your inputs are retained. Check the available nodes and try again."; _launchPreview = null; }
        finally { _isSubmitting = false; }
        if (!_submitted) await RefreshTargetsAsync(false, false);
    }
    private void Cancel() { if (!_isSubmitting) MudDialog.Cancel(); }
    public void Dispose() { _targetResolution?.Cancel(); _targetResolution?.Dispose(); _dispose.Cancel(); _dispose.Dispose(); }
}
