@using System.Linq
@using System.Text.Json
@using NetRatel.Shared.Contracts.Jobs

@inject IJobApiClient JobApi
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Class="run-job-dialog">
            @if (_job is null)
            {
                <MudText>No job selected.</MudText>
            }
            else
            {
                <MudPaper Class="run-job-hero pa-4" Elevation="0">
                    <MudStack Spacing="1">
                        <MudText Class="run-job-kicker">Launch Workflow</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.h5">@_job.Name</MudText>
                            <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">Job #@_job.Id</MudChip>
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(_job.Description))
                        {
                            <MudText Typo="Typo.body2">@_job.Description</MudText>
                        }
                    </MudStack>
                </MudPaper>

                <MudGrid Spacing="2">
                    <MudItem xs="12" md="7">
                        <MudPaper Class="run-job-panel pa-3" Elevation="0">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.subtitle1">Inputs</MudText>
                                    @if (_params is not null)
                                    {
                                        <MudChip T="string" Variant="Variant.Text" Size="Size.Small">@_params.Count parameter@(_params.Count == 1 ? string.Empty : "s")</MudChip>
                                    }
                                </MudStack>

                                @if (_params is null)
                                {
                                    <MudStack AlignItems="AlignItems.Center" Class="py-4">
                                        <MudProgressCircular Indeterminate="true" />
                                        <MudText Class="mt-2">Loading parameters...</MudText>
                                    </MudStack>
                                }
                                else if (_params.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                        This job has no parameters. Confirm the launch profile and start the run.
                                    </MudAlert>
                                }
                                else
                                {
                                    @foreach (var p in _params)
                                    {
                                        var type = p.Type?.ToLowerInvariant();
                                        <MudPaper Class="run-job-param pa-3" Elevation="0">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudText Typo="Typo.subtitle2">@p.Name</MudText>
                                                    @if (p.Required)
                                                    {
                                                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small">Required</MudChip>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(p.Type))
                                                    {
                                                        <MudChip T="string" Variant="Variant.Text" Size="Size.Small">@p.Type</MudChip>
                                                    }
                                                </MudStack>

                                                @if (type == "bool")
                                                {
                                                    <MudSwitch T="bool"
                                                               Value="@GetBoolValue(p.Name)"
                                                               ValueChanged="@((bool value) => SetBoolValue(p.Name, value))" />
                                                }
                                                else if (type == "select")
                                                {
                                                    var options = GetSelectOptions(p);
                                                    if (options.Count > 0)
                                                    {
                                                        <MudSelect T="string"
                                                                   Value="@GetValue(p.Name)"
                                                                   ValueChanged="@((string? value) => SetValue(p.Name, value))"
                                                                   Label="Select value"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense">
                                                            @foreach (var option in options)
                                                            {
                                                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    }
                                                    else
                                                    {
                                                        <MudTextField Value="@GetValue(p.Name)"
                                                                      ValueChanged="@((string? value) => SetValue(p.Name, value))"
                                                                      Label="Value"
                                                                      Variant="Variant.Outlined"
                                                                      Margin="Margin.Dense" />
                                                    }
                                                }
                                                else
                                                {
                                                    <MudTextField Value="@GetValue(p.Name)"
                                                                  ValueChanged="@((string? value) => SetValue(p.Name, value))"
                                                                  Label="Value"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense" />
                                                }

                                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                                {
                                                    <MudText Typo="Typo.caption">@p.Description</MudText>
                                                }
                                            </MudStack>
                                        </MudPaper>
                                    }
                                }
                            </MudStack>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5">
                        <MudPaper Class="run-job-panel pa-3" Elevation="0">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1">Launch Profile</MudText>
                                <MudTextField @bind-Value="_clientIdentityOverride"
                                              Label="Client identity override"
                                              Placeholder="Optional"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                                <MudTextField @bind-Value="_startedBy"
                                              Label="Started by"
                                              Required="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                                    The run will be created immediately and you will be redirected into its live execution trace.
                                </MudAlert>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@(!CanRun)" OnClick="RunAsync" Color="Color.Primary" Variant="Variant.Filled">Start Run</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    // passed in from DialogService
    [Parameter] public JobDto Job { get; set; } = default!;

    [Parameter] public EventCallback<JobRunDto> OnRunCompleted { get; set; }

    private JobDto? _job;
    private List<JobParamDto>? _params;
    private readonly Dictionary<string, string?> _values = new(StringComparer.OrdinalIgnoreCase);
    private string? _clientIdentityOverride;
    private string _startedBy = "ui";
    private bool _isSubmitting;

    private bool CanRun =>
        !_isSubmitting &&
        _job is not null &&
        _params is not null &&
        ValidateRequired() &&
        !string.IsNullOrWhiteSpace(_startedBy);

    protected override async Task OnInitializedAsync()
    {
        // initialize state from the Job parameter
        _job = Job;
        _params = null;
        _values.Clear();
        _clientIdentityOverride = null;
        _startedBy = "ui";
        _isSubmitting = false;

        try
        {
            var list = await JobApi.GetJobParamsAsync(_job.Id);
            _params = list.ToList();

            foreach (var param in _params)
            {
                var defaultValue = param.Default;
                if (string.Equals(param.Type, "bool", StringComparison.OrdinalIgnoreCase) &&
                    string.IsNullOrWhiteSpace(defaultValue))
                {
                    defaultValue = "false";
                }

                _values[param.Name] = defaultValue ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load parameters: {ex.Message}", Severity.Error);
            _params = [];
        }
    }

    private bool ValidateRequired()
    {
        if (_params is null) return false;

        foreach (var p in _params.Where(p => p.Required))
        {
            if (!_values.TryGetValue(p.Name, out var val) || string.IsNullOrWhiteSpace(val))
            {
                return false;
            }
        }

        return true;
    }

    private string? GetValue(string key)
        => _values.TryGetValue(key, out var val) ? val : null;

    private void SetValue(string key, string? value)
        => _values[key] = value;

    private bool GetBoolValue(string key)
        => _values.TryGetValue(key, out var val) && bool.TryParse(val, out var parsed) && parsed;

    private void SetBoolValue(string key, bool value)
        => _values[key] = value ? "true" : "false";

    private List<string> GetSelectOptions(JobParamDto param)
    {
        if (string.IsNullOrWhiteSpace(param.OptionsJson))
            return [];

        try
        {
            var options = JsonSerializer.Deserialize<List<string>>(param.OptionsJson);
            return options?.Where(o => !string.IsNullOrWhiteSpace(o)).ToList() ?? [];
        }
        catch
        {
            return [];
        }
    }

    private async Task RunAsync()
    {
        if (_job is null || _params is null)
            return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var payload = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
            foreach (var param in _params)
            {
                _values.TryGetValue(param.Name, out var raw);
                object? value = raw;
                if (string.Equals(param.Type, "bool", StringComparison.OrdinalIgnoreCase))
                {
                    value = bool.TryParse(raw, out var parsed) && parsed;
                }

                payload[param.Name] = value;
            }

            var json = JsonSerializer.Serialize(payload);
            var request = new RunJobRequest(
                _startedBy,
                json,
                _clientIdentityOverride);

            var run = await JobApi.RunJobAsync(_job.Id, request);
            Snackbar.Add($"Run started: {run.Id} ({run.Status})", Severity.Success);

            if (OnRunCompleted.HasDelegate)
                await OnRunCompleted.InvokeAsync(run);

            NavManager.NavigateTo($"/jobs/{_job.Id}/runs/{run.Id}");

            // close dialog and return run to caller
            MudDialog.Close(DialogResult.Ok(run));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to start job: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

<style>
    .run-job-hero,
    .run-job-panel,
    .run-job-param {
        border-radius: var(--netratel-radius-surface, 7px);
        border: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-surface);
    }

    .run-job-hero {
        border-left: 3px solid var(--mud-palette-primary);
    }

    .run-job-kicker {
        color: var(--mud-palette-primary);
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
</style>
