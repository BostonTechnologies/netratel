@using System.Linq
@using System.Threading
@implements IDisposable
@using MudBlazor
@using NetRatel.Shared
@using NetRatel.Shared.Contracts.Jobs
@using NetRatel.Shared.Contracts
@using NetRatel.Web.Models.Clients
@using NetRatel.Web.Services.Clients

@inject IJobApiClient JobApi
@inject ITenantApiService TenantApi
@inject ClientPresentationService ClientPresentation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Class="jobs-edit-dialog">
    <DialogContent>
        <div class="jobs-editor-container">
            @if (_createdInWorkspace)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="jobs-editor-saved" role="status">
                    Job #@_jobId created. Add steps or parameters below, then Save to finish.
                </MudText>
            }
            @if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_validationMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_cloneCopyWarning))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_cloneCopyWarning</MudAlert>
            }
            @if (_detailsLoadFailed)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
                    Saved steps and parameters could not be loaded. Retry before editing job details.
                    <MudButton Size="Size.Small" Disabled="@(_isSaving || _detailsBusy)"
                               OnClick="@(() => RunDetailsActionAsync(() => RefreshDetailsAsync(_jobId!.Value)))">Retry details</MudButton>
                </MudAlert>
            }
            <fieldset class="jobs-editor-fields" disabled="@(_isSaving || _isLoading)">
            <MudGrid Spacing="2" Class="flex-grow-1 jobs-editor-layout ma-0">
                <MudItem xs="12" md="4" Class="d-flex">
                    <MudPaper Elevation="0" Class="pa-3 jobs-editor-panel jobs-editor-sidebar">
                        <MudStack Spacing="2">
                            <MudTabs KeepPanelsAlive="true" Elevation="0" TabPanelsClass="pt-2" Color="Color.Default" Class="jobs-editor-definition-tabs">
                                <MudTabPanel Text="Definition" Icon="@Icons.Material.Filled.Work">
                                    <MudStack Spacing="2">
                                        <MudTextField @bind-Value="_name"
                                                      Label="Job Name"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Required="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Work" />

                                        <MudAutocomplete T="TenantDto"
                                                         Label="Tenant"
                                                         Value="_selectedTenant"
                                                         ValueChanged="OnTenantChanged"
                                                         SearchFunc="SearchTenants"
                                                         ToStringFunc="@(t => t?.Name)"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         AdornmentIcon="@Icons.Material.Filled.Business"
                                                         ResetValueOnEmptyText="true"
                                                         Clearable="true"
                                                         Required="true" />

                                        <MudSelect T="ClientEnvironment"
                                                   Label="Environment"
                                                   Value="_environment"
                                                   ValueChanged="OnEnvironmentChanged"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Disabled="@(_selectedTenant == null)">
                                            @foreach (var env in _environments)
                                            {
                                                <MudSelectItem Value="@env">@env.ToShortLabel()</MudSelectItem>
                                            }
                                        </MudSelect>

                                        <MudAutocomplete T="ClientPresentationModel"
                                                         Label="@(_selectedTenant == null ? "Select a Tenant first" : "Select Agent")"
                                                         Value="_selectedClient"
                                                         ValueChanged="OnClientChanged"
                                                         SearchFunc="SearchClients"
                                                         ToStringFunc="@(c => c == null ? "" : $"{c.DisplayName} ({c.HostName})")"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         AdornmentIcon="@Icons.Material.Filled.Fingerprint"
                                                         Disabled="@(_selectedTenant == null)"
                                                         ResetValueOnEmptyText="true"
                                                         Clearable="true"
                                                         Required="true">
                                            <ItemTemplate Context="client">
                                                <MudText Typo="Typo.body2">
                                                    <b>@client.DisplayName</b>
                                                    <span class="mud-text-secondary"> - @client.HostName (@client.OperatingSystem)</span>
                                                </MudText>
                                            </ItemTemplate>
                                        </MudAutocomplete>

                                        <MudTextField T="string"
                                                      Value="_folderSubfolder"
                                                      ValueChanged="OnSubfolderChanged"
                                                      Label="Folder (within tenant)"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Placeholder="e.g. Tests/Smoke"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Folder"
                                                      Disabled="@(_selectedTenant is null)" />

                                        <MudPaper Class="pa-2 jobs-editor-folder-preview" Outlined="true">
                                            <MudText Typo="Typo.caption" Class="jobs-editor-field-caption">Saved Path</MudText>
                                            <MudText Typo="Typo.body2" Style="font-family:monospace">@EffectiveFolderPathLabel</MudText>
                                        </MudPaper>

                                    </MudStack>
                                </MudTabPanel>
                                <MudTabPanel Text="Runtime">
                                    <MudStack Spacing="2">
                                        <MudGrid Spacing="1">
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int"
                                                                 @bind-Value="_expectedRuntimeMinutes"
                                                                 Label="Expected Runtime (minutes)"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Min="1" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int"
                                                                 @bind-Value="_graceRuntimeMinutes"
                                                                 Label="Grace Runtime (minutes)"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Min="0" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudStack>
                                </MudTabPanel>
                                <MudTabPanel Text="Schedule" Icon="@Icons.Material.Filled.Schedule">
                                    <MudStack Spacing="2">
                                        <MudSwitch T="bool"
                                                   @bind-Value="_scheduleEnabled"
                                                   Color="Color.Primary"
                                                   Label="Run on a schedule" />

                                        <MudSelect T="SchedulePreset"
                                                   Label="Repeat"
                                                   @bind-Value="_schedulePreset"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Disabled="@(!_scheduleEnabled)">
                                            <MudSelectItem Value="@SchedulePreset.EveryDay">Every day</MudSelectItem>
                                            <MudSelectItem Value="@SchedulePreset.SelectedDays">Selected days</MudSelectItem>
                                        </MudSelect>

                                        @if (_schedulePreset == SchedulePreset.SelectedDays)
                                        {
                                            <MudGrid Spacing="1">
                                                @foreach (var day in ScheduleDays)
                                                {
                                                    <MudItem xs="6">
                                                        <MudCheckBox T="bool"
                                                                     Value="@IsScheduleDaySelected(day)"
                                                                     ValueChanged="@(value => SetScheduleDay(day, value))"
                                                                     Disabled="@(!_scheduleEnabled)"
                                                                     Label="@day.ToString()" />
                                                    </MudItem>
                                                }
                                            </MudGrid>
                                        }

                                        <MudTimePicker Label="Run time"
                                                       Time="_scheduleTime"
                                                       TimeChanged="OnScheduleTimeChanged"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       AmPm="false"
                                                       Disabled="@(!_scheduleEnabled)" />

                                        <MudPaper Class="pa-2 jobs-editor-folder-preview" Outlined="true">
                                            <MudText Typo="Typo.caption" Class="jobs-editor-field-caption">Timezone</MudText>
                                            <MudText Typo="Typo.body2">@ScheduleTimeZoneId</MudText>
                                        </MudPaper>
                                    </MudStack>
                                </MudTabPanel>
                            </MudTabs>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="8" Class="d-flex">
                    <MudTabs @bind-ActivePanelIndex="_detailsTab" KeepPanelsAlive="true" Elevation="0" TabPanelsClass="pa-0" Color="Color.Default" Class="flex-grow-1 jobs-editor-tabs">

                <!-- STEPS TAB -->
                <MudTabPanel Text="Steps" Icon="@Icons.Material.Filled.PlaylistPlay" BadgeData="@(_steps.Count > 0 ? _steps.Count : null)" BadgeColor="Color.Secondary">
                    <MudTable Items="_steps" Dense="true" Hover="true" FixedHeader="true" Height="min(360px, calc(100dvh - 270px))" Style="background: transparent;">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6">Steps</MudText>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => RunDetailsActionAsync(AddStep))" Disabled="@(_jobId == null || _isSaving || _detailsBusy || _detailsLoadFailed)">
                                Add Step
                            </MudButton>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Action</MudTh>
                            <MudTh>Enabled</MudTh>
                            <MudTh>Details</MudTh>
                            <MudTh Style="text-align:right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><b>@context.Ordinal</b></MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@context.Type</MudChip>
                            </MudTd>
                            <MudTd>
                                <MudSwitch T="bool"
                                           Value="context.Enabled"
                                           ValueChanged="@(async (bool value) => await RunDetailsActionAsync(() => ToggleStepEnabledAsync(context, value)))"
                                           Color="Color.Primary"
                                           Disabled="@(_jobId == null || _isSaving || _detailsBusy || _detailsLoadFailed)" />
                            </MudTd>
                            <MudTd><MudText Typo="Typo.body2" Class="mud-text-secondary">@GetStepSummary(context)</MudText></MudTd>
                            <MudTd Style="text-align:right">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" OnClick="@(() => RunDetailsActionAsync(() => MoveStepAsync(context, -1)))" Disabled="@(_jobId == null || _isSaving || _detailsBusy || _detailsLoadFailed || !CanMove(context, -1))"/>
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" OnClick="@(() => RunDetailsActionAsync(() => MoveStepAsync(context, 1)))" Disabled="@(_jobId == null || _isSaving || _detailsBusy || _detailsLoadFailed || !CanMove(context, 1))"/>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => RunDetailsActionAsync(() => EditStepAsync(context)))" Disabled="@(_jobId == null || _isSaving || _detailsBusy || _detailsLoadFailed)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RunDetailsActionAsync(() => DeleteStepAsync(context)))" Disabled="@(_jobId == null || _isSaving || _detailsBusy || _detailsLoadFailed)" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            @if (_jobId == null)
                            {
                                <MudText Class="pa-3" Typo="Typo.body2" Color="Color.Secondary">Enter the definition, then choose Create and add steps. Steps require a saved job ID.</MudText>
                            }
                            else if (_detailsLoadFailed)
                            {
                                <MudText Align="Align.Center" Class="pa-4">Steps unavailable.</MudText>
                            }
                            else
                            {
                                <MudText Align="Align.Center" Class="pa-4">No steps configured.</MudText>
                            }
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>

                <!-- PARAMETERS TAB -->
                <MudTabPanel Text="Parameters" Icon="@Icons.Material.Filled.Tune" BadgeData="@(_params.Count > 0 ? _params.Count : null)" BadgeColor="Color.Secondary">
                    <MudTable Items="_params" Dense="true" Hover="true" FixedHeader="true" Height="min(360px, calc(100dvh - 270px))">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6">Parameters</MudText>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => RunDetailsActionAsync(AddParam))" Disabled="@(_jobId == null || _isSaving || _detailsBusy || _detailsLoadFailed)">
                                Add Param
                            </MudButton>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Default</MudTh>
                            <MudTh Style="text-align:right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name @(context.Required ? "*" : "")</MudTd>
                            <MudTd>@context.Type</MudTd>
                            <MudTd><MudText Typo="Typo.caption" Style="font-family:monospace">@GetParamDefault(context)</MudText></MudTd>
                            <MudTd Style="text-align:right">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => RunDetailsActionAsync(() => EditParamAsync(context)))" Disabled="@(_jobId == null || _isSaving || _detailsBusy || _detailsLoadFailed)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RunDetailsActionAsync(() => DeleteParamAsync(context)))" Disabled="@(_jobId == null || _isSaving || _detailsBusy || _detailsLoadFailed)" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            @if (_jobId == null)
                            {
                                <MudText Class="pa-3" Typo="Typo.body2" Color="Color.Secondary">Create the job first, then add runtime parameters here.</MudText>
                            }
                            else if (_detailsLoadFailed)
                            {
                                <MudText Align="Align.Center" Class="pa-4">Parameters unavailable.</MudText>
                            }
                            else
                            {
                                <MudText Align="Align.Center" Class="pa-4">No parameters configured.</MudText>
                            }
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>
                    </MudTabs>
                </MudItem>
            </MudGrid>
            </fieldset>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelAsync" Disabled="@(_isSaving || _detailsBusy)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(_isSaving || _isLoading || _detailsBusy)" StartIcon="@Icons.Material.Filled.Save">
            @(_isSaving ? "Saving…" : _jobId == null ? "Create and add steps" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ulong? JobId { get; set; }
    [Parameter] public ulong? CloneFromJobId { get; set; }
    [Parameter] public string? SuggestedFolder { get; set; }

    private enum SchedulePreset
    {
        EveryDay,
        SelectedDays
    }

    private ulong? _jobId;
    private bool _isSaving;
    private bool _isLoading = true;
    private bool _detailsBusy;
    private bool _detailsLoadFailed;
    private string? _cloneCopyWarning;
    private bool _createdInWorkspace;
    private int _detailsTab;
    private JobDto? _savedJob;
    private string _savedDefinition = string.Empty;
    private string DefinitionSnapshot => System.Text.Json.JsonSerializer.Serialize(new
    {
        Name = _name, TenantId = _selectedTenant?.Id, Environment = _environment,
        AgentId = _selectedClient?.AgentId ?? _rawAgentId, Folder = _folderSubfolder,
        ExpectedMinutes = _expectedRuntimeMinutes, GraceMinutes = _graceRuntimeMinutes,
        ScheduleEnabled = _scheduleEnabled, SchedulePreset = _schedulePreset, ScheduleTime = _scheduleTime,
        ScheduleDays = _selectedScheduleDays.OrderBy(day => day).ToArray()
    });
    private bool HasDefinitionChanges => DefinitionSnapshot != _savedDefinition;
    private string _name = string.Empty;
    private string? _validationMessage;
    private string? _suggestedFolderNormalized;
    private string _folderSubfolder = string.Empty;
    private bool _folderSubfolderOverridden;
    private bool _suppressFolderSubfolderTracking;
    private bool _isCloneDraft;
    private int _expectedRuntimeMinutes = 30;
    private int _graceRuntimeMinutes;
    private const string ScheduleTimeZoneId = "Africa/Johannesburg";
    private static readonly DayOfWeek[] ScheduleDays =
    [
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    ];
    private bool _scheduleEnabled;
    private SchedulePreset _schedulePreset = SchedulePreset.EveryDay;
    private TimeSpan? _scheduleTime = new(8, 0, 0);
    private HashSet<DayOfWeek> _selectedScheduleDays = ScheduleDays.ToHashSet();

    // --- Tenant / Client Selection State ---
    private List<TenantDto> _tenants = new();
    private TenantDto? _selectedTenant;

    private ClientEnvironment[] _environments = new[] { ClientEnvironment.Dev, ClientEnvironment.Prod };
    private ClientEnvironment _environment = ClientEnvironment.Dev;

    private ClientPresentationModel? _selectedClient;
    private Guid? _rawAgentId;

    private List<JobParamDto> _params = new();
    private List<JobStepDto> _steps = new();
    private CancellationTokenSource _disposeCts = new();

    protected override async Task OnInitializedAsync()
    {
        _suggestedFolderNormalized = string.IsNullOrWhiteSpace(SuggestedFolder)
            ? null
            : NormalizeFolder(SuggestedFolder!);

        // 1. Always load tenants first
        await LoadTenantsAsync();

        if (JobId.HasValue)
        {
            _jobId = JobId;
            await LoadJobAsync(JobId.Value);
        }
        else if (CloneFromJobId.HasValue)
        {
            await LoadCloneAsync(CloneFromJobId.Value);
        }
        else
        {
            TryPreselectTenantAndFolderFromSuggestedPath();
        }
        _savedDefinition = DefinitionSnapshot;
        _isLoading = false;
    }

    private async Task LoadTenantsAsync()
    {
        try
        {
            var list = await TenantApi.GetTenantsAsync(_disposeCts.Token);
            _tenants = list.OrderBy(t => t.Name).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load tenants: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadJobAsync(ulong jobId)
    {
        try
        {
            var job = await JobApi.GetJobAsync(jobId);
            if (job == null)
            {
                MudDialog.Cancel();
                return;
            }

            _name = job.Name;
            _rawAgentId = job.AgentId;
            _environment = job.Environment is ClientEnvironment.None ? _environment : job.Environment;
            ApplyRuntimePolicy(job);
            ApplySchedule(job.Schedule);

            // Match Tenant
            if (job.TenantId.HasValue)
            {
                _selectedTenant = _tenants.FirstOrDefault(t => t.Id == job.TenantId.Value);
                if (_selectedTenant != null)
                {
                    SetSubfolder(ExtractSubfolder(job.FolderPath, _selectedTenant.Name), isUserOverride: false);
                    await TryPreselectAgentAsync(job.AgentId);
                }
            }
            else
            {
                SetSubfolder(string.Empty, isUserOverride: false);
            }

            // Load sub-lists
            await RefreshDetailsAsync(jobId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load job: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadCloneAsync(ulong jobId)
    {
        try
        {
            var details = await JobApi.GetJobWithDetailsAsync(jobId, _disposeCts.Token);
            if (details is null)
            {
                MudDialog.Cancel();
                return;
            }

            var job = details.Job;

            _name = $"{job.Name} (copy)";
            _rawAgentId = job.AgentId;
            _environment = job.Environment is ClientEnvironment.None ? ClientEnvironment.Dev : job.Environment;
            ApplyRuntimePolicy(job);
            ApplySchedule(job.Schedule);

            _selectedTenant = job.TenantId.HasValue
                ? _tenants.FirstOrDefault(t => t.Id == job.TenantId.Value)
                : null;

            _selectedClient = null;
            if (_selectedTenant is not null)
            {
                SetSubfolder(ExtractSubfolder(job.FolderPath, _selectedTenant.Name), isUserOverride: false);
                await TryPreselectAgentAsync(job.AgentId);
            }
            else
            {
                SetSubfolder(string.Empty, isUserOverride: false);
            }

            _params = details.Params.OrderBy(p => p.Name).ToList();
            _steps = details.Steps.OrderBy(s => s.Ordinal).ToList();

            _isCloneDraft = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load job copy data: {ex.Message}", Severity.Error);
        }
    }

    private async Task TryPreselectAgentAsync(Guid? agentId)
    {
        if (_selectedTenant is null || !agentId.HasValue) return;
        var snapshot = await ClientPresentation.GetClientsAsync(_disposeCts.Token);
        _selectedClient = snapshot.Clients.FirstOrDefault(c => c.TenantId == _selectedTenant.Id && c.AgentId == agentId.Value);
    }

    // --- Autocomplete Logic ---

    private Task<IEnumerable<TenantDto>> SearchTenants(string value, CancellationToken ct)
    {
        IEnumerable<TenantDto> result =
            string.IsNullOrWhiteSpace(value)
                ? _tenants
                : _tenants.Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private void OnTenantChanged(TenantDto? tenant)
    {
        _selectedTenant = tenant;
        _selectedClient = null; // Reset client on tenant change
        _rawAgentId = null;

        _folderSubfolderOverridden = false;
        SetSubfolder(string.Empty, isUserOverride: false);

        StateHasChanged();
    }

    private void OnEnvironmentChanged(ClientEnvironment env)
    {
        _environment = env;
        _selectedClient = null;
        _rawAgentId = null; // A changed environment requires explicit target reselection.
        StateHasChanged();
    }

    private async Task<IEnumerable<ClientPresentationModel>> SearchClients(string value, CancellationToken ct)
    {
        if (_selectedTenant == null) return Enumerable.Empty<ClientPresentationModel>();

        try
        {
            var snapshot = await ClientPresentation.GetClientsAsync(ct);
            return snapshot.Clients.Where(c => c.TenantId == _selectedTenant.Id && c.Enabled)
                .Where(c => string.IsNullOrWhiteSpace(value) || $"{c.DisplayName} {c.HostName} {c.OperatingSystem}".Contains(value, StringComparison.OrdinalIgnoreCase))
                .Take(20);
        }
        catch
        {
            return Enumerable.Empty<ClientPresentationModel>();
        }
    }

    private void OnClientChanged(ClientPresentationModel? client)
    {
        _selectedClient = client is { Enabled: true } && client.TenantId == _selectedTenant?.Id ? client : null;
        _rawAgentId = _selectedClient?.AgentId;
    }

    private void OnSubfolderChanged(string path)
    {
        if (_suppressFolderSubfolderTracking)
        {
            _folderSubfolder = path;
            return;
        }

        _folderSubfolder = NormalizeSubfolder(path);
        _folderSubfolderOverridden = true;
    }

    private void SetSubfolder(string path, bool isUserOverride)
    {
        _suppressFolderSubfolderTracking = true;
        _folderSubfolder = NormalizeSubfolder(path);
        _folderSubfolderOverridden = isUserOverride;
        _suppressFolderSubfolderTracking = false;
    }

    private static string NormalizeFolder(string folder)
    {
        if (string.IsNullOrWhiteSpace(folder)) return "/";
        var f = folder.Replace("\\", "/", StringComparison.Ordinal);
        if (!f.StartsWith('/')) f = "/" + f;
        if (!f.EndsWith('/')) f += "/";
        return f;
    }

    private static string NormalizeSubfolder(string? subfolder)
    {
        if (string.IsNullOrWhiteSpace(subfolder))
            return string.Empty;

        var s = subfolder.Replace("\\", "/", StringComparison.Ordinal).Trim();
        s = s.Trim('/');

        if (string.IsNullOrWhiteSpace(s))
            return string.Empty;

        var segments = s.Split('/', StringSplitOptions.RemoveEmptyEntries)
            .Where(seg => seg is not "." and not "..")
            .ToArray();

        return string.Join("/", segments);
    }

    private static string BuildTenantLockedFolder(string tenantName, string? subfolder)
    {
        var root = NormalizeFolder($"/{tenantName}/");
        var normalizedSubfolder = NormalizeSubfolder(subfolder);
        return string.IsNullOrWhiteSpace(normalizedSubfolder)
            ? root
            : NormalizeFolder(root + normalizedSubfolder + "/");
    }

    private static string ExtractSubfolder(string? folderPath, string tenantName)
    {
        if (string.IsNullOrWhiteSpace(folderPath))
            return string.Empty;

        var normalized = NormalizeFolder(folderPath);
        var tenantRoot = NormalizeFolder($"/{tenantName}/");

        if (!normalized.StartsWith(tenantRoot, StringComparison.OrdinalIgnoreCase))
            return string.Empty;

        var remainder = normalized[tenantRoot.Length..].Trim('/');
        return NormalizeSubfolder(remainder);
    }

    private string EffectiveFolderPath =>
        _selectedTenant is null ? "/" : BuildTenantLockedFolder(_selectedTenant.Name, _folderSubfolder);

    private string EffectiveFolderPathLabel =>
        _selectedTenant is null ? "(select a tenant)" : EffectiveFolderPath;

    private void TryPreselectTenantAndFolderFromSuggestedPath()
    {
        if (string.IsNullOrWhiteSpace(_suggestedFolderNormalized))
            return;

        var segments = _suggestedFolderNormalized.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length == 0)
            return;

        var tenantName = segments[0];
        var tenant = _tenants.FirstOrDefault(t => string.Equals(t.Name, tenantName, StringComparison.OrdinalIgnoreCase));
        if (tenant is null)
            return;

        _selectedTenant = tenant;
        SetSubfolder(ExtractSubfolder(_suggestedFolderNormalized, tenant.Name), isUserOverride: false);
    }

    // --- Save & Main Logic ---

    private async Task SaveAsync()
    {
        if (_isSaving || _isLoading || _detailsBusy) return;
        _isSaving = true;
        _validationMessage = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_name))
            {
                _validationMessage = "Name is required.";
                return;
            }

            var finalTenantId = _selectedTenant?.Id;
            var finalAgentId = _selectedClient?.AgentId ?? _rawAgentId;

            if (finalTenantId == null) {
                 _validationMessage = "Please select a Tenant.";
                 return;
            }
            if (!finalAgentId.HasValue)
            {
                _validationMessage = "Please select an Agent.";
                return;
            }

            var lockedFolder = EffectiveFolderPath;
            var schedule = BuildScheduleRequest();
            if (_scheduleEnabled && schedule is null)
            {
                _validationMessage = "Select at least one schedule day and a run time.";
                return;
            }

            JobDto job;
            if (_jobId == null)
            {
                var templateParams = _isCloneDraft ? _params.ToList() : null;
                var templateSteps = _isCloneDraft ? _steps.ToList() : null;

                var req = new CreateJobRequest(
                    _name,
                    lockedFolder,
                    null,
                    finalTenantId,
                    string.Empty,
                    ExpectedRuntimeSeconds: _expectedRuntimeMinutes * 60,
                    GraceSeconds: _graceRuntimeMinutes * 60,
                    HardTimeoutSeconds: (_expectedRuntimeMinutes + _graceRuntimeMinutes) * 60,
                    Schedule: schedule,
                    AgentId: finalAgentId);
                job = await JobApi.CreateJobAsync(req);
                if (job.Id == 0) throw new InvalidOperationException("The server did not return a saved job ID.");
                _jobId = job.Id;
                _params = [];
                _steps = [];
                _savedJob = job;
                _createdInWorkspace = true;
                _savedDefinition = DefinitionSnapshot;
                _detailsTab = 0;

                if (_isCloneDraft && templateParams is not null && templateSteps is not null)
                {
                    try
                    {
                        await CloneJobDetailsAsync(job.Id, templateParams, templateSteps);
                        _isCloneDraft = false;
                        Snackbar.Add("Job copied. You can now edit steps and parameters.", Severity.Success);
                    }
                    catch (Exception ex)
                    {
                        _cloneCopyWarning = $"Job #{job.Id} was created, but not all steps or parameters were copied: {ex.Message}. Review the saved clone before running it.";
                    }
                    // Always show the clone's actual persisted children, including a partial copy.
                    // A failed reload keeps child actions blocked and offers an explicit retry.
                    try { await RefreshDetailsAsync(job.Id); }
                    catch { /* RefreshDetailsAsync records the unavailable state shown above. */ }
                }
                else
                {
                    Snackbar.Add("Job Created. You can now add steps.", Severity.Success);
                }

                _savedDefinition = DefinitionSnapshot;
                StateHasChanged();
            }
            else
            {
                var req = new UpdateJobRequest(
                    _name,
                    lockedFolder,
                    null,
                    finalTenantId,
                    string.Empty,
                    ExpectedRuntimeSeconds: _expectedRuntimeMinutes * 60,
                    GraceSeconds: _graceRuntimeMinutes * 60,
                    HardTimeoutSeconds: (_expectedRuntimeMinutes + _graceRuntimeMinutes) * 60,
                    Schedule: schedule,
                    AgentId: finalAgentId);
                job = await JobApi.UpdateJobAsync(_jobId.Value, req);
                _savedDefinition = DefinitionSnapshot;
                _savedJob = job;
                MudDialog.Close(DialogResult.Ok(job));
            }
        }
        catch (Exception ex)
        {
            _validationMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CloneJobDetailsAsync(ulong jobId, IReadOnlyList<JobParamDto> templateParams, IReadOnlyList<JobStepDto> templateSteps)
    {
        foreach (var p in templateParams)
        {
            await JobApi.AddJobParamAsync(jobId, new AddJobParamRequest(
                p.Name,
                p.Type,
                p.Required,
                p.Default,
                p.Description,
                p.OptionsJson));
        }

        foreach (var s in templateSteps.OrderBy(s => s.Ordinal))
        {
            await JobApi.AddJobStepAsync(jobId, new AddJobStepRequest(
                s.Ordinal,
                s.Type,
                s.Runner,
                s.Command,
                s.ScriptId,
                s.PayloadJson,
                s.Enabled));
        }
    }

    private void ApplyRuntimePolicy(JobDto job)
    {
        _expectedRuntimeMinutes = Math.Max(1, (int)Math.Ceiling(job.ExpectedRuntimeSeconds / 60d));
        _graceRuntimeMinutes = Math.Max(0, (int)Math.Ceiling(job.GraceSeconds / 60d));
    }

    private void ApplySchedule(JobScheduleDto? schedule)
    {
        if (schedule is null || !schedule.Enabled)
        {
            _scheduleEnabled = false;
            _schedulePreset = SchedulePreset.EveryDay;
            _scheduleTime = new TimeSpan(8, 0, 0);
            _selectedScheduleDays = ScheduleDays.ToHashSet();
            return;
        }

        _scheduleEnabled = true;
        _scheduleTime = TimeSpan.TryParse(schedule.TimeOfDay, out var parsedTime)
            ? parsedTime
            : new TimeSpan(8, 0, 0);

        var selectedDays = schedule.DaysOfWeek
            .Select(day => Enum.TryParse<DayOfWeek>(day, ignoreCase: true, out var parsedDay) ? parsedDay : (DayOfWeek?)null)
            .Where(day => day.HasValue)
            .Select(day => day!.Value)
            .ToHashSet();

        _selectedScheduleDays = selectedDays.Count == 0
            ? ScheduleDays.ToHashSet()
            : selectedDays;
        _schedulePreset = _selectedScheduleDays.Count == ScheduleDays.Length
            ? SchedulePreset.EveryDay
            : SchedulePreset.SelectedDays;
    }

    private JobScheduleDto? BuildScheduleRequest()
    {
        if (!_scheduleEnabled)
        {
            return null;
        }

        if (_scheduleTime is null)
        {
            return null;
        }

        var days = _schedulePreset == SchedulePreset.EveryDay
            ? ScheduleDays
            : ScheduleDays.Where(_selectedScheduleDays.Contains).ToArray();

        if (days.Length == 0)
        {
            return null;
        }

        return new JobScheduleDto(
            true,
            ScheduleTimeZoneId,
            $"{_scheduleTime.Value.Hours:00}:{_scheduleTime.Value.Minutes:00}",
            days.Select(day => day.ToString()).ToList());
    }

    private bool IsScheduleDaySelected(DayOfWeek day) => _selectedScheduleDays.Contains(day);

    private void SetScheduleDay(DayOfWeek day, bool selected)
    {
        if (selected)
        {
            _selectedScheduleDays.Add(day);
        }
        else
        {
            _selectedScheduleDays.Remove(day);
        }
    }

    private void OnScheduleTimeChanged(TimeSpan? time)
    {
        _scheduleTime = time;
    }

    // --- Standard Helpers (Same as previous) ---

    private async Task CancelAsync()
    {
        if (_isSaving || _detailsBusy) return;
        if (HasDefinitionChanges && await DialogService.ShowMessageBoxAsync(
                "Discard unsaved definition?", "Unsaved definition changes will be discarded. Saved steps and parameters are retained.",
                yesText: "Discard", cancelText: "Keep editing") is not true)
            return;
        if (_createdInWorkspace && _savedJob is not null)
            MudDialog.Close(DialogResult.Ok(_savedJob));
        else
            MudDialog.Cancel();
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private async Task RefreshDetailsAsync(ulong jobId)
    {
        try
        {
            var parameters = (await JobApi.GetJobParamsAsync(jobId)).OrderBy(p => p.Name).ToList();
            var steps = (await JobApi.GetJobStepsAsync(jobId)).OrderBy(s => s.Ordinal).ToList();
            _params = parameters;
            _steps = steps;
            _detailsLoadFailed = false;
        }
        catch
        {
            _detailsLoadFailed = true;
            throw;
        }
    }

    private bool CanModifyParam(JobParamDto param) => !_detailsLoadFailed && _jobId == param.JobId;
    private bool CanModifyStep(JobStepDto step) => !_detailsLoadFailed && _jobId == step.JobId;

    private async Task RunDetailsActionAsync(Func<Task> action)
    {
        if (_detailsBusy || _isSaving) return;
        _detailsBusy = true;
        try { await action(); }
        catch (Exception ex) { Snackbar.Add($"Could not update job details: {ex.Message}", Severity.Error); }
        finally { _detailsBusy = false; }
    }

    // --- Steps & Params (Dialog Calls) ---

    private async Task AddParam()
    {
        if (_jobId is null || _detailsLoadFailed) return;
        var jobId = _jobId.Value;

        var parameters = new DialogParameters { ["JobId"] = jobId };
        var dialog = await DialogService.ShowAsync<ParamEditDialog>("Add Parameter", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await RefreshDetailsAsync(jobId);
    }

    private async Task EditParamAsync(JobParamDto param)
    {
        if (!CanModifyParam(param)) return;
        var jobId = _jobId.Value;

        var parameters = new DialogParameters { ["JobId"] = jobId, ["ExistingParam"] = param };
        var dialog = await DialogService.ShowAsync<ParamEditDialog>("Edit Parameter", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await RefreshDetailsAsync(jobId);
    }

    private async Task AddStep()
    {
        if (_jobId is null || _detailsLoadFailed) return;
        var jobId = _jobId.Value;

        var parameters = new DialogParameters { ["JobId"] = jobId, ["JobParams"] = _params };
        var dialog = await DialogService.ShowAsync<StepEditDialog>("Add Step", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await RefreshDetailsAsync(jobId);
    }

    private async Task EditStepAsync(JobStepDto step)
    {
        if (!CanModifyStep(step)) return;
        var jobId = _jobId.Value;

        var parameters = new DialogParameters { ["JobId"] = jobId, ["ExistingStep"] = step, ["JobParams"] = _params };
        var dialog = await DialogService.ShowAsync<StepEditDialog>("Edit Step", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await RefreshDetailsAsync(jobId);
    }

    private async Task DeleteParamAsync(JobParamDto param)
    {
        if (!CanModifyParam(param)) return;
        await JobApi.DeleteJobParamAsync(param.Id);
        await RefreshDetailsAsync(_jobId.Value);
    }

    private async Task DeleteStepAsync(JobStepDto step)
    {
        if (!CanModifyStep(step)) return;
        await JobApi.DeleteJobStepAsync(step.Id);
        await RefreshDetailsAsync(_jobId.Value);
    }

    private async Task ToggleStepEnabledAsync(JobStepDto step, bool enabled)
    {
        if (!CanModifyStep(step)) return;
        var req = new UpdateJobStepRequest(
            step.Type,
            step.Runner,
            step.Command,
            step.ScriptId,
            step.PayloadJson,
            enabled);

        await JobApi.UpdateJobStepAsync(step.Id, req);
        await RefreshDetailsAsync(_jobId.Value);
    }

    private async Task MoveStepAsync(JobStepDto step, int delta)
    {
        if (!CanModifyStep(step)) return;
        await JobApi.ReorderJobStepAsync(step.Id, step.Ordinal + delta);
        await RefreshDetailsAsync(_jobId.Value);
    }

    private bool CanMove(JobStepDto step, int delta)
    {
        var newOrdinal = step.Ordinal + delta;
        return newOrdinal > 0 && newOrdinal <= _steps.Count;
    }

    private string GetStepSummary(JobStepDto step)
        => step.Type == JobStepTypeDto.RunCommand
            ? (string.IsNullOrWhiteSpace(step.Command) ? "RunCommand" : step.Command)
            : step.Type.ToString();
    private string GetParamDefault(JobParamDto param) => param.Default ?? "-";
}
