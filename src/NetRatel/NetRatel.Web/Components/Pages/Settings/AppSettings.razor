@page "/admin/app-settings"
@using System.Net.Http.Headers
@inject IHttpClientFactory Clients
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Class="p-6 space-y-4">
    <MudText Typo="Typo.h5">App Settings</MudText>

    <MudDivider />

    <MudText Typo="Typo.h6">Signing Key Management</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">
        Upload an ES256 private key PEM file for NetRatel.API signing.
        Uploading a new key overwrites the current key. Restart the API after upload.
    </MudText>

    <div class="d-flex flex-column gap-2">
        <InputFile OnChange="OnFileChanged" accept=".pem" />
        @if (_file is not null)
        {
            <MudText Typo="Typo.body2">Selected: @_file.Name (@FormatSize(_file.Size))</MudText>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    <MudStack Row="true" Spacing="2">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || _file is null)" OnClick="UploadAsync">
            Upload Key
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private IBrowserFile? _file;
    private bool _busy;
    private string? _error;

    private HttpClient Api => Clients.CreateClient("OrchestratorApi");

    private void OnFileChanged(InputFileChangeEventArgs args)
    {
        _file = args.File;
        _error = null;
    }

    private async Task UploadAsync()
    {
        if (_file is null)
        {
            _error = "Select a PEM file before uploading.";
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Title)] = "Overwrite signing key?",
            [nameof(ConfirmDialog.Message)] = "This will replace the existing signing key on disk. Continue?",
            [nameof(ConfirmDialog.YesText)] = "Overwrite",
            [nameof(ConfirmDialog.CancelText)] = "Cancel",
            [nameof(ConfirmDialog.YesButtonColor)] = Color.Warning
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not true)
        {
            return;
        }

        var selectedFile = _file;
        if (selectedFile is null)
        {
            _error = "Select a PEM file before uploading.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            using var multipart = new MultipartFormDataContent();
            await using var stream = selectedFile.OpenReadStream(10_000);
            using var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = MediaTypeHeaderValue.Parse("application/x-pem-file");
            multipart.Add(streamContent, "file", selectedFile.Name);

            using var response = await Api.PostAsync("/api/v1/system/signing-key", multipart);
            if (!response.IsSuccessStatusCode)
            {
                _error = await response.Content.ReadAsStringAsync();
                Snackbar.Add("Signing key upload failed.", Severity.Error);
                return;
            }

            Snackbar.Add("Signing key uploaded. Restart NetRatel.API to apply it.", Severity.Success);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add("Signing key upload failed.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        var units = new[] { "KB", "MB", "GB" };
        var value = (double)bytes;
        var unitIndex = 0;
        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.##} {units[unitIndex]}";
    }
}
