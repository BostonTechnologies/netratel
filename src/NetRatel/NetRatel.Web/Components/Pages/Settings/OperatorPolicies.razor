@page "/admin/operator-policies"
@rendermode InteractiveServer
@implements IDisposable
@using System.Net
@using NetRatel.Application.Operations
@using NetRatel.Web.Services.OperatorPolicy
@using NetRatel.Web.Components.Shared.OperatorPolicy
@inject IMcpOperatorPolicyApiService PolicyApi

<PageTitle>MCP operator policies</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-6 operator-policy-page">
    <MudStack Spacing="3">
        <div><MudText Typo="Typo.h4">MCP operator policies</MudText><MudText Typo="Typo.body2">Review bounded access for a separate operator credential, then confirm the exact change.</MudText></div>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" data-testid="policy-error">@_error</MudAlert> }
        @if (_loading) { <MudProgressCircular Indeterminate="true" /> }
        else if (_authority is null)
        { <MudAlert Severity="Severity.Info" data-testid="policy-access-denied">Policy administration permission is required.</MudAlert> }
        else
        {
            <MudPaper Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudSelect T="McpOperatorEnvironment" Label="Environment" Value="_environment" ValueChanged="EnvironmentChangedAsync" Disabled="_busy">
                        @foreach (var environment in Enum.GetValues<McpOperatorEnvironment>()) { <MudSelectItem Value="environment">@environment</MudSelectItem> }
                    </MudSelect>
                    <MudNumericField T="int?" Label="Tenant ID filter" @bind-Value="_tenantFilter" Min="1" Disabled="_busy" />
                    <MudButton OnClick="ReloadAsync" Disabled="_busy">Refresh</MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NewPolicy" Disabled="@(_busy || _environment != _authority.Environment)" data-testid="policy-create">Create policy</MudButton>
                </MudStack>
                <MudText Typo="Typo.caption">Signed-in subject: @_authority.Subject. Mutations use the current @_authority.Environment environment and require an existing bounded parent policy for this administrator.</MudText>
                <MudTable Items="_policies" Dense="true" Hover="true" Class="mt-3" data-testid="policy-list">
                    <HeaderContent><MudTh>Name / principal</MudTh><MudTh>Target</MudTh><MudTh>State / version</MudTh><MudTh>Expiry (UTC)</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name / principal"><strong>@context.Name</strong><br />@context.PrincipalSelector.Kind: @context.PrincipalSelector.Value</MudTd>
                        <MudTd DataLabel="Target">@context.TargetSelector.Kind · tenant @context.TargetSelector.TenantId<br />@context.TargetSelector.AgentId @context.TargetSelector.ClientTag</MudTd>
                        <MudTd DataLabel="State / version">@context.LifecycleState · v@context.Version</MudTd>
                        <MudTd DataLabel="Expiry (UTC)">@(context.ExpiresAtUtc?.ToUniversalTime().ToString("u") ?? "None")</MudTd>
                        <MudTd><MudButton OnClick="@(() => SelectAsync(context.PolicyId))" Disabled="_busy" data-testid="@($"policy-inspect-{context.PolicyId:D}")">Inspect</MudButton></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText>No policies match this environment and tenant filter.</MudText></NoRecordsContent>
                </MudTable>
            </MudPaper>
            @if (_selected is { } selected)
            {
                <MudPaper Class="pa-4" data-testid="selected-policy">
                    <MudText Typo="Typo.h6">@selected.Name · @selected.LifecycleState · version @selected.Version</MudText>
                    <MudText Typo="Typo.caption">Policy @selected.PolicyId · created by @selected.CreatedBy at @selected.CreatedAtUtc.ToUniversalTime().ToString("u")</MudText>
                    <PolicyDefinitionView Draft="@ToDraft(selected)" />
                    @if (_targetProfile is { } target)
                    { <MudAlert Severity="Severity.Info" Class="mt-2" data-testid="policy-target-profile">Persisted target: @target.Classification · profile v@target.Version · tags @string.Join(", ", target.Tags). Updated by @target.UpdatedBy at @target.UpdatedAtUtc.ToUniversalTime().ToString("u").</MudAlert> }
                    else if (selected.TargetSelector.Kind == McpOperatorTargetSelectorKind.ExactAgent)
                    { <MudAlert Severity="Severity.Warning">This exact target has no policy profile. Set its trusted classification before previewing a change.</MudAlert> }
                    <MudStack Row="true" Class="mt-3">
                        <MudButton OnClick="EditPolicy" Disabled="@(_busy || !CanReplace)" data-testid="policy-edit">Replace / restore reviewed bounds</MudButton>
                        <MudButton OnClick="@(() => PreviewStateAsync(PolicyChangeAction.Disable))" Disabled="@(_busy || !CanDisable)" data-testid="policy-disable">Preview disable</MudButton>
                        <MudButton Color="Color.Error" OnClick="@(() => PreviewStateAsync(PolicyChangeAction.Revoke))" Disabled="@(_busy || !CanRevoke)" data-testid="policy-revoke">Preview revoke</MudButton>
                    </MudStack>
                    @if (selected.Environment == _authority.Environment && selected.TargetSelector.Kind is McpOperatorTargetSelectorKind.ExactAgent or McpOperatorTargetSelectorKind.Tenant or McpOperatorTargetSelectorKind.ControlPlane)
                    {
                        <details class="mt-4"><summary>Check an owned credential's current admission</summary>
                            <MudText Typo="Typo.body2">Select a credential owned by this signed-in account. This read-only check uses the selected policy's tenant/client and the current profile revision.</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="4"><label class="policy-credential-picker">Owned HTTP MCP credential<select @bind="_credentialId" disabled="_busy" data-testid="policy-admission-credential"><option value="">Select credential</option>@foreach (var credential in _credentials) { <option value="@credential.Id">@credential.Name</option> }</select></label></MudItem>
                                <MudItem xs="12" md="4"><MudTextField Label="Tool" @bind-Value="_admissionTool" Disabled="_busy" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField Label="Operation" @bind-Value="_admissionOperation" Disabled="_busy" /></MudItem>
                            </MudGrid>
                            <MudButton OnClick="CheckAdmissionAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_credentialId))" data-testid="policy-admission-check">Check current admission</MudButton>
                            @if (_credentialAdmission is { } admission)
                            {
                                <div data-testid="policy-admission-result">
                                    <MudText>Credential @admission.CredentialState · @admission.AuthenticationStatus · checked @admission.CheckedAtUtc.ToUniversalTime().ToString("u")</MudText>
                                    <MudSimpleTable Dense="true" Elevation="0"><thead><tr><th>Operation</th><th>Application / owner grant</th><th>Tenant visible</th><th>Policy admission</th><th>Runtime / capability</th></tr></thead><tbody>
                                        @foreach (var result in admission.EffectiveAdmission)
                                        { <tr><td>@result.Target.Tool/@result.Target.Operation</td><td>@result.ApplicationGrantConfigured / @result.OwnerPermissionGranted</td><td>@result.TenantVisible</td><td>@result.PolicyAdmissionStatus · @(result.FailureCode ?? (result.AuthorizationAdmitted ? "authorized" : "not admitted"))</td><td>@result.TargetReadiness / @result.CapabilityAvailability</td></tr> }
                                    </tbody></MudSimpleTable>
                                    @foreach (var prerequisite in admission.RemainingPrerequisites) { <MudText Typo="Typo.body2">@prerequisite</MudText> }
                                    <MudText Typo="Typo.caption">Matching policy versions: @string.Join("; ", admission.MatchingPolicies.Select(policy => $"{policy.PolicyId} v{policy.Version}"))</MudText>
                                </div>
                            }
                        </details>
                    }
                    <MudText Typo="Typo.subtitle2" Class="mt-4">Retained change audit</MudText>
                    <MudSimpleTable Dense="true" Elevation="0"><thead><tr><th>Action</th><th>Version</th><th>Actor</th><th>UTC</th><th>Audit ID</th></tr></thead>
                        <tbody>@foreach (var audit in _audits) { <tr><td>@audit.Action</td><td>@audit.Version</td><td>@audit.ActorId</td><td>@audit.OccurredAtUtc.ToUniversalTime().ToString("u")</td><td>@audit.AuditId</td></tr> }</tbody>
                    </MudSimpleTable>
                </MudPaper>
            }
            @if (_editing && _preview is null)
            {
                <MudPaper Class="pa-4" data-testid="policy-editor">
                    <MudText Typo="Typo.h6">@(_editExisting ? "Replace selected policy" : "Create policy")</MudText>
                    <MudText Typo="Typo.body2">Expiry uses an explicit UTC offset. One path or shell per line. Empty previously defined grants stay empty; unchanged limits are preserved.</MudText>
                    <MudGrid Class="mt-1">
                        <MudItem xs="12" md="6"><MudTextField Label="Policy name" @bind-Value="_editor.Name" Disabled="_busy" /></MudItem>
                        <MudItem xs="6" md="3"><MudSelect T="McpOperatorPolicyEffect" Label="Effect" @bind-Value="_editor.Effect" Disabled="_busy">@foreach (var effect in Enum.GetValues<McpOperatorPolicyEffect>()) { <MudSelectItem Value="effect">@effect</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="6" md="3"><MudNumericField T="int" Label="Priority" @bind-Value="_editor.Priority" Min="-10000" Max="10000" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="4"><MudSelect T="McpOperatorPrincipalSelectorKind" Label="Principal selector" @bind-Value="_editor.PrincipalKind" Disabled="_busy">@foreach (var kind in Enum.GetValues<McpOperatorPrincipalSelectorKind>()) { <MudSelectItem Value="kind">@kind</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" md="8"><MudTextField Label="Exact principal value" @bind-Value="_editor.PrincipalValue" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="4"><MudSelect T="McpOperatorTargetSelectorKind" Label="Target selector" @bind-Value="_editor.TargetKind" Disabled="@(_busy || _editExisting)">@foreach (var kind in Enum.GetValues<McpOperatorTargetSelectorKind>()) { <MudSelectItem Value="kind">@kind</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="int" Label="Tenant ID" @bind-Value="_editor.TenantId" Min="0" Disabled="@(_busy || _editExisting)" /></MudItem>
                        <MudItem xs="12" md="5"><MudTextField Label="Exact client ID" @bind-Value="_editor.AgentId" Disabled="@(_busy || _editExisting || _editor.TargetKind != McpOperatorTargetSelectorKind.ExactAgent)" /></MudItem>
                        @if (_editor.TargetKind == McpOperatorTargetSelectorKind.ClientTag) { <MudItem xs="12"><MudTextField Label="Exact client tag" @bind-Value="_editor.ClientTag" Disabled="@(_busy || _editExisting)" /></MudItem> }
                        <MudItem xs="12" md="6"><MudSelect T="McpOperatorTargetClassification?" Label="Classification filter" @bind-Value="_editor.Classification" Clearable="true" Disabled="_busy">@foreach (var classification in Enum.GetValues<McpOperatorTargetClassification>().Where(value => value != McpOperatorTargetClassification.Unknown)) { <MudSelectItem T="McpOperatorTargetClassification?" Value="@((McpOperatorTargetClassification?)classification)">@classification</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" md="6"><MudSelect T="McpOperatorOperationFamily" Label="Operation families" MultiSelection="true" @bind-SelectedValues="_editor.Families" Disabled="_busy">@foreach (var family in OperatorPolicyDraftEditor.OperationFamilies) { <MudSelectItem Value="family">@family</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12"><MudTextField Label="Exact operation (optional; tool/operation)" @bind-Value="_editor.Operation" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Exact working directories" Lines="3" @bind-Value="_editor.WorkingDirectories" Disabled="_busy" data-testid="policy-working-directories" HelperText="/tmp does not include /tmp/example; add each required directory." /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Allowed shells" Lines="3" @bind-Value="_editor.Shells" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Read roots" Lines="3" @bind-Value="_editor.ReadRoots" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Write roots" Lines="3" @bind-Value="_editor.WriteRoots" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Expires at (UTC offset or Z)" @bind-Value="_editor.ExpiresAt" Disabled="_busy" Placeholder="2030-04-01T10:00:00Z" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Review by (UTC offset or Z)" @bind-Value="_editor.ReviewBy" Disabled="_busy" /></MudItem>
                        <MudItem xs="12"><MudTextField Label="Audit / change reference" @bind-Value="_editor.AuditReference" Disabled="_busy" /></MudItem>
                    </MudGrid>
                    <details class="mt-3"><summary>Limits and confirmation requirements</summary><OperatorPolicyLimitsEditor @bind-Value="_editor.Constraints" Disabled="_busy" /></details>
                    <MudStack Row="true" Class="mt-4"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="PreviewDraftAsync" Disabled="_busy" data-testid="policy-preview">Preview exact change</MudButton><MudButton OnClick="CancelEdit" Disabled="_busy">Cancel</MudButton></MudStack>
                </MudPaper>
            }
            @if (_preview is { } preview && _prepared is { } prepared)
            {
                <MudPaper Class="pa-4" data-testid="policy-preview-review">
                    <MudText Typo="Typo.h6">Confirm @prepared.Action.ToString().ToLowerInvariant()</MudText>
                    <MudText Typo="Typo.body2">@(prepared.PolicyId is { } id ? $"Policy {id} · expected version {prepared.ExpectedVersion}" : "New policy")</MudText>
                    @if (prepared.Draft is { } draft) { <PolicyDefinitionView Draft="draft" /> }
                    else if (_selected is { } current) { <PolicyDefinitionView Draft="@ToDraft(current)" /> }
                    <MudAlert Severity="Severity.Info" Class="mt-3">@StateChangeDescription(prepared.Action) Preview expires @preview.ExpiresAtUtc.ToUniversalTime().ToString("u"). Correlation: @preview.CorrelationId.</MudAlert>
                    <MudCheckBox T="bool" @bind-Value="_confirmed" Label="I reviewed the exact principal, target, bounds and expiry above." Disabled="_busy" data-testid="policy-confirm-checkbox" />
                    <MudStack Row="true"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmAsync" Disabled="@(_busy || !_confirmed)" data-testid="policy-confirm">Confirm reviewed change</MudButton><MudButton OnClick="DiscardPreview" Disabled="_busy">Back to edit</MudButton></MudStack>
                </MudPaper>
            }
        }
        @if (_success is not null) { <MudAlert Severity="Severity.Success" data-testid="policy-success">@_success</MudAlert> }
        @if (_readbackWarning is not null) { <MudAlert Severity="Severity.Warning" data-testid="policy-readback-warning">@_readbackWarning</MudAlert> }
        @if (_accepted is not null) { <MudButton OnClick="RefreshAcceptedAsync" Disabled="@(_busy || _authority is null)" data-testid="policy-refresh-accepted">Refresh accepted receipt</MudButton> }
    </MudStack>
</MudContainer>
