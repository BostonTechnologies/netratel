@page "/admin/operator-policies"
@rendermode InteractiveServer
@implements IDisposable
@using System.Net
@using NetRatel.Application.Operations
@using NetRatel.Web.Services.OperatorPolicy
@using NetRatel.Web.Components.Shared.OperatorPolicy
@inject IMcpOperatorPolicyApiService PolicyApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<OperatorPolicies> Logger

<PageTitle>MCP operator policies</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-6 operator-policy-page">
    <MudStack Spacing="3">
        <div class="policy-page-heading" id="policy-page-heading" tabindex="-1">
            <div><MudText Typo="Typo.h4">MCP operator policies</MudText><MudText Typo="Typo.body2">Find an operator's access, inspect its bounds and history, then review any change before applying it.</MudText></div>
            @if (_authority is not null)
            { <MudButton id="policy-create" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="NewPolicy" Disabled="@(_busy || _environment != _authority.Environment)" data-testid="policy-create">Create policy</MudButton> }
        </div>
        @if (!_dialogOpen)
        {
            @if (_error is not null) { <MudAlert Severity="Severity.Error" data-testid="policy-error">@_error</MudAlert> }
            @if (_success is not null) { <MudAlert Severity="Severity.Success" data-testid="policy-success">@_success</MudAlert> }
            @if (_readbackWarning is not null) { <MudAlert Severity="Severity.Warning" data-testid="policy-readback-warning">@_readbackWarning</MudAlert> }
            @if (_accepted is not null) { <MudButton OnClick="RefreshAcceptedAsync" Disabled="@(_busy || _authority is null)" data-testid="policy-refresh-accepted">Refresh accepted receipt</MudButton> }
        }
        @if (_loading) { <MudProgressCircular Indeterminate="true" /> }
        else if (_authority is null)
        { <MudAlert Severity="Severity.Info" data-testid="policy-access-denied">Policy administration permission is required.</MudAlert> }
        else
        {
            <MudPaper Class="pa-4 policy-list-panel" Outlined="true" Elevation="0">
                <MudExpansionPanels Elevation="0" Class="mb-3"><MudExpansionPanel Text="Consolidate legacy integration policies">
                    <MudText Typo="Typo.body2">Group eligible rules under one base per tenant while preserving each rule's operations, limits, expiry and denies. Conflicts stay unchanged.</MudText>
                    <MudAutocomplete T="string" Label="Integration" @bind-Value="_consolidationCredential" SearchFunc="SearchConsolidationCredentials" ToStringFunc="ConsolidationCredentialName" CoerceValue="false" Disabled="_busy" />
                    <MudButton OnClick="PreviewConsolidationAsync" Disabled="@(_busy || string.IsNullOrEmpty(_consolidationCredential))">Review consolidation</MudButton>
                </MudExpansionPanel></MudExpansionPanels>
                <MudGrid Spacing="2" Class="mb-2">
                    <MudItem xs="12" sm="5" md="3">
                        <MudSelect T="McpOperatorEnvironment" Label="Environment" Value="_environment" ValueChanged="EnvironmentChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" data-testid="policy-environment">
                            @foreach (var environment in Enum.GetValues<McpOperatorEnvironment>()) { <MudSelectItem Value="environment">@environment</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="8" sm="5" md="3"><MudAutocomplete T="int?" Label="Tenant or server" Value="_tenantFilter" ValueChanged="TenantFilterChangedAsync" SearchFunc="SearchTenantsAsync" ToStringFunc="TenantOptionName" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" data-testid="policy-tenant-filter" /></MudItem>
                    <MudItem xs="4" sm="2" md="6" Class="d-flex align-center justify-end"><MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync" Disabled="_busy" data-testid="policy-list-refresh">Refresh</MudButton></MudItem>
                </MudGrid>
                <MudGrid Spacing="2" Class="mb-2">
                    <MudItem xs="12" md="6"><MudTextField T="string" InputId="policy-search" Label="Search policies" Value="_search" ValueChanged="SearchChanged" Immediate="true" Clearable="true" Placeholder="Name, principal, policy ID, client or tag" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" data-testid="policy-search" /></MudItem>
                    <MudItem xs="12" sm="6" md="3"><MudSelect T="McpOperatorPolicyLifecycleState?" Label="Lifecycle" Value="_lifecycleFilter" ValueChanged="LifecycleFilterChanged" Clearable="true" Placeholder="All states" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" data-testid="policy-lifecycle-filter">
                        @foreach (var state in Enum.GetValues<McpOperatorPolicyLifecycleState>()) { <MudSelectItem T="McpOperatorPolicyLifecycleState?" Value="@((McpOperatorPolicyLifecycleState?)state)">@state</MudSelectItem> }
                    </MudSelect></MudItem>
                    <MudItem xs="12" sm="6" md="3"><MudSelect T="McpOperatorTargetSelectorKind?" Label="Target" Value="_targetFilter" ValueChanged="TargetFilterChanged" Clearable="true" Placeholder="All targets" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" data-testid="policy-target-filter">
                        @foreach (var target in Enum.GetValues<McpOperatorTargetSelectorKind>()) { <MudSelectItem T="McpOperatorTargetSelectorKind?" Value="@((McpOperatorTargetSelectorKind?)target)">@TargetLabel(target)</MudSelectItem> }
                    </MudSelect></MudItem>
                </MudGrid>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mt-2 mb-2">
                    <MudText Typo="Typo.body2" data-testid="policy-result-count">@FilteredPolicies.Count() base policies · @FilteredPolicies.Sum(p => VisibleChildren(p).Count()) child exceptions · @_policies.Count(p => p.LifecycleState != McpOperatorPolicyLifecycleState.Active || p.ExpiresAtUtc <= DateTimeOffset.UtcNow) historical records</MudText>
                    @if (HasListFilters) { <MudButton Size="Size.Small" OnClick="ResetListFilters" Disabled="_busy" data-testid="policy-reset-filters">Reset list filters</MudButton> }
                </MudStack>
                @if (_bulkSelection.Count > 0) { <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="PrepareBulkDeleteAsync" Disabled="_busy" Class="mb-3">Delete selected (@_bulkSelection.Count)</MudButton> }
                <MudTable T="McpOperatorPolicy" Items="FilteredPolicies" MultiSelection="true" @bind-SelectedItems="_bulkSelection" @bind-CurrentPage="_currentPage" RowsPerPage="_pageSize" RowsPerPageChanged="PageSizeChanged" RowClassFunc="PolicyRowClass" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" Loading="_busy && !_dialogOpen" data-testid="policy-list">
                    <HeaderContent><MudTh>Policy / principal</MudTh><MudTh>Target</MudTh><MudTh>State / version</MudTh><MudTh>Expiry (UTC)</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Policy / principal"><div class="policy-name">@context.Name</div>
                            @if (VisibleChildren(context).Any()) { <MudButton Size="Size.Small" OnClick="@(() => ToggleChildren(context.PolicyId))" aria-expanded="@_expandedPolicies.Contains(context.PolicyId)">@VisibleChildren(context).Count() exceptions</MudButton> }<div class="policy-secondary policy-principal">@PrincipalName(context.PrincipalSelector)</div></MudTd>
                        <MudTd DataLabel="Target"><span>@TenantName(context.TargetSelector.TenantId) · @TargetLabel(context.TargetSelector.Kind)</span><div class="policy-secondary policy-target">@context.TargetSelector.AgentId @context.TargetSelector.ClientTag</div></MudTd>
                        <MudTd DataLabel="State / version"><MudChip T="string" Size="Size.Small" Color="@LifecycleColor(context.LifecycleState)" Variant="Variant.Outlined">@(context.LifecycleState == McpOperatorPolicyLifecycleState.Active && context.ExpiresAtUtc <= DateTimeOffset.UtcNow ? "Expired" : context.LifecycleState.ToString())</MudChip><span class="policy-version">@($"v{context.Version}")</span></MudTd>
                        <MudTd DataLabel="Expiry (UTC)"><span class="policy-expiry">@(context.ExpiresAtUtc?.ToUniversalTime().ToString("u") ?? "None")</span></MudTd>
                        <MudTd DataLabel="Actions"><MudButton id="@InspectButtonId(context.PolicyId)" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="@(() => SelectAsync(context.PolicyId))" Disabled="_busy" aria-label="@($"Inspect {context.Name}")" data-testid="@InspectButtonId(context.PolicyId)">Inspect</MudButton></MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (_expandedPolicies.Contains(context.PolicyId)) {
                            <MudTr><MudTd colspan="6"><MudStack Class="pa-3" Spacing="2">@foreach (var child in VisibleChildren(context)) {
                                <MudPaper Outlined="true" Class="pa-3"><MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap"><div><MudText Typo="Typo.subtitle2">@child.Name</MudText><MudText Typo="Typo.caption">@child.Effect · @child.LifecycleState · @(child.Operations is { } ops ? string.Join(", ", ops) : child.Operation ?? child.OperationFamily.ToString()) · @ClientsLabel(child.TargetSelector)</MudText></div><MudButton id="@InspectButtonId(child.PolicyId)" OnClick="@(() => SelectAsync(child.PolicyId))">Inspect</MudButton></MudStack></MudPaper>
                            }</MudStack></MudTd></MudTr>
                        }
                    </ChildRowContent>
                    <NoRecordsContent><div class="policy-empty"><MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" /><MudText Typo="Typo.subtitle1">No matching policies</MudText><MudText Typo="Typo.body2">Adjust the search, lifecycle or target filter, or choose another environment and tenant.</MudText></div></NoRecordsContent>
                    <PagerContent><MudTablePager PageSizeOptions="PageSizes" RowsPerPageString="Policies per page" InfoFormat="{first_item}-{last_item} of {all_items}" /></PagerContent>
                </MudTable>
                <MudText Typo="Typo.caption" Class="mt-3">Signed in as @_authority.Subject. Changes use the @_authority.Environment environment and your existing bounded administration authority.</MudText>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@{ var dialogGeneration = _dialogGeneration; }
<MudDialog @key="dialogGeneration" Visible="_dialogOpen" VisibleChanged="@(visible => DialogVisibleChanged(dialogGeneration, visible))" DefaultFocus="DefaultFocus.FirstChild" Options="PolicyDialogOptions" AriaLabel="@DialogTitle" Style="width:min(1120px,calc(100vw - 32px));max-width:1120px" data-testid="policy-dialog">
    <TitleContent>
        <div class="policy-dialog-heading" @onkeydown="DialogKeyDown">
            <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" />
            <div class="policy-dialog-title"><MudText Typo="Typo.h6">@DialogTitle</MudText><MudText Typo="Typo.caption">@_environment · bounded operator access</MudText></div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseDialog" Disabled="_busy" aria-label="Close policy dialog" data-testid="policy-dialog-close" />
        </div>
    </TitleContent>
    <DialogContent>
        <div id="@DialogBodyId(dialogGeneration)" class="policy-dialog-body" tabindex="0" @onkeydown="DialogKeyDown" aria-label="Policy details and review">
            @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="policy-error">@_error</MudAlert> }
            @if (_success is not null) { <MudAlert Severity="Severity.Success" Class="mb-3" data-testid="policy-success">@_success</MudAlert> }
            @if (_readbackWarning is not null) { <MudAlert Severity="Severity.Warning" Class="mb-3" data-testid="policy-readback-warning">@_readbackWarning</MudAlert> }
            @if (_accepted is not null) { <MudButton OnClick="RefreshAcceptedAsync" Disabled="@(_busy || _authority is null)" Class="mb-3" data-testid="policy-refresh-accepted">Refresh accepted receipt</MudButton> }
            @if (_selectionLoading)
            { <div class="policy-dialog-loading" role="status" data-testid="policy-dialog-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><MudText Typo="Typo.body2">Loading policy details and change history…</MudText></div> }
            else if (_authority is null)
            { <MudAlert Severity="Severity.Info">Policy administration permission is required. Close this dialog and refresh after signing in.</MudAlert> }
            else if (_authority is not null)
            {
            @if (!_editing && _preview is null && _selected is { } selected)
            {
                <div data-testid="selected-policy">
                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                        <MudChip T="string" Size="Size.Small" Color="@LifecycleColor(selected.LifecycleState)">@selected.LifecycleState</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@selected.Effect</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Version @selected.Version</MudChip>
                        <MudText Typo="Typo.body2">@TenantName(selected.TargetSelector.TenantId) · @TargetLabel(selected.TargetSelector.Kind)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.caption">Policy @selected.PolicyId · created by @selected.CreatedBy at @selected.CreatedAtUtc.ToUniversalTime().ToString("u")</MudText>
                    <PolicyDefinitionView Draft="@ToDraft(selected)" TenantName="@TenantName(selected.TargetSelector.TenantId)" PrincipalName="@PrincipalName(selected.PrincipalSelector)" ClientNames="@ClientsLabel(selected.TargetSelector)" />
                    @if (_targetProfile is { } target)
                    { <MudAlert Severity="Severity.Info" Class="mt-2" data-testid="policy-target-profile">Persisted target: @target.Classification · profile @($"v{target.Version}") · tags @string.Join(", ", target.Tags). Updated by @target.UpdatedBy at @target.UpdatedAtUtc.ToUniversalTime().ToString("u").</MudAlert> }
                    else if (selected.TargetSelector.Kind == McpOperatorTargetSelectorKind.ExactAgent)
                    { <MudAlert Severity="Severity.Warning">This exact target has no policy profile. Set its trusted classification before previewing a change.</MudAlert> }
                    @if (selected.Environment == _authority?.Environment && selected.TargetSelector.Kind is McpOperatorTargetSelectorKind.ExactAgent or McpOperatorTargetSelectorKind.Tenant or McpOperatorTargetSelectorKind.ControlPlane)
                    {
                        <details class="policy-detail-section"><summary>Check credential admission</summary>
                            <MudText Typo="Typo.body2">Select a credential owned by this signed-in account. This read-only check uses the selected policy's tenant/client and the current profile revision.</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="4"><label class="policy-credential-picker">Owned HTTP MCP credential<select @bind="_credentialId" disabled="_busy" data-testid="policy-admission-credential"><option value="">Select credential</option>@foreach (var credential in _credentials) { <option value="@credential.Id">@credential.Name</option> }</select></label></MudItem>
                                <MudItem xs="12" md="8"><MudAutocomplete T="string" Label="Admission operation" Value="@($"{_admissionTool}/{_admissionOperation}")" ValueChanged="SelectAdmissionOperation" SearchFunc="SearchAdmissionOperations" CoerceValue="false" Disabled="_busy" /></MudItem>
                            </MudGrid>
                            <MudButton OnClick="CheckAdmissionAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_credentialId))" data-testid="policy-admission-check">Check current admission</MudButton>
                            @if (_credentialAdmission is { } admission)
                            {
                                <div data-testid="policy-admission-result">
                                    <MudText>Credential @admission.CredentialState · @admission.AuthenticationStatus · checked @admission.CheckedAtUtc.ToUniversalTime().ToString("u")</MudText>
                                    <MudSimpleTable Dense="true" Elevation="0"><thead><tr><th>Operation</th><th>Application / owner grant</th><th>Tenant visible</th><th>Policy admission</th><th>Runtime / capability</th></tr></thead><tbody>
                                        @foreach (var result in admission.EffectiveAdmission)
                                        { <tr><td>@result.Target.Tool/@result.Target.Operation</td><td>@result.ApplicationGrantConfigured / @result.OwnerPermissionGranted</td><td>@result.TenantVisible</td><td>@result.PolicyAdmissionStatus · @(result.FailureCode ?? (result.AuthorizationAdmitted ? "authorized" : "not admitted"))</td><td>@result.TargetReadiness / @result.CapabilityAvailability</td></tr> }
                                    </tbody></MudSimpleTable>
                                    @foreach (var prerequisite in admission.RemainingPrerequisites) { <MudText Typo="Typo.body2">@prerequisite</MudText> }
                                    <MudText Typo="Typo.caption">Matching policy versions: @string.Join("; ", admission.MatchingPolicies.Select(policy => $"{policy.PolicyId} v{policy.Version}"))</MudText>
                                </div>
                            }
                        </details>
                    }
                    <details class="policy-detail-section"><summary>Change history (@_audits.Count)</summary>
                    <MudSimpleTable Dense="true" Elevation="0"><thead><tr><th>Action</th><th>Version</th><th>Actor</th><th>UTC</th><th>Audit ID</th></tr></thead>
                        <tbody>@foreach (var audit in _audits) { <tr><td>@audit.Action</td><td>@audit.Version</td><td>@audit.ActorId</td><td>@audit.OccurredAtUtc.ToUniversalTime().ToString("u")</td><td>@audit.AuditId</td></tr> }</tbody>
                    </MudSimpleTable>
                    </details>
                </div>
            }
            @if (_editing && _preview is null)
            {
                <div data-testid="policy-editor">
                    <MudText Typo="Typo.subtitle1">Identity and access scope</MudText>
                    <MudText Typo="Typo.body2">Expiry uses an explicit UTC offset. One path or shell per line. Empty previously defined grants stay empty; unchanged limits are preserved.</MudText>
                    <MudGrid Class="mt-1">
                        <MudItem xs="12" md="6"><MudTextField Label="Policy name" @bind-Value="_editor.Name" Disabled="_busy" /></MudItem>
                        <MudItem xs="6" md="3"><MudSelect T="McpOperatorPolicyEffect" Label="Effect" @bind-Value="_editor.Effect" Disabled="_busy">@foreach (var effect in Enum.GetValues<McpOperatorPolicyEffect>()) { <MudSelectItem Value="effect">@effect</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="6" md="3"><MudNumericField T="int" Label="Priority" @bind-Value="_editor.Priority" Min="-10000" Max="10000" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="4"><MudSelect T="McpOperatorPrincipalSelectorKind" Label="Principal type" Value="_editor.PrincipalKind" ValueChanged="PrincipalKindChanged" Disabled="@(_busy || _editor.IntegrationCredentialId is not null || _editor.ParentPolicyId is not null)">@foreach (var kind in Enum.GetValues<McpOperatorPrincipalSelectorKind>()) { <MudSelectItem Value="kind">@kind</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" md="8"><MudAutocomplete T="string" Label="Principal" Value="_editor.PrincipalValue" ValueChanged="@((string value) => _editor.PrincipalValue = value)" SearchFunc="SearchPrincipalsAsync" ToStringFunc="PrincipalOptionName" Disabled="@(_busy || _editor.IntegrationCredentialId is not null || _editor.ParentPolicyId is not null)" CoerceValue="false" HelperText="Choose a known identity. Unresolved existing values are preserved." /></MudItem>
                        <MudItem xs="12" md="4"><MudSelect T="McpOperatorTargetSelectorKind" Label="Target selector" @bind-Value="_editor.TargetKind" Disabled="@(_busy || _editExisting)">@foreach (var kind in Enum.GetValues<McpOperatorTargetSelectorKind>()) { <MudSelectItem Value="kind">@kind</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" md="3"><MudAutocomplete T="int?" Label="Tenant" Value="@((int?)_editor.TenantId)" ValueChanged="EditorTenantChangedAsync" SearchFunc="SearchTenantsAsync" ToStringFunc="TenantOptionName" Disabled="@(_busy || _editExisting || _editor.ParentPolicyId is not null || _editor.TargetKind == McpOperatorTargetSelectorKind.ControlPlane)" /></MudItem>
                        <MudItem xs="12" md="5"><MudAutocomplete T="string" Label="Client" Value="_editor.AgentId" ValueChanged="@((string value) => _editor.AgentId = value)" SearchFunc="SearchClientsAsync" ToStringFunc="ClientOptionName" CoerceValue="false" Disabled="@(_busy || _editExisting || _editor.TargetKind != McpOperatorTargetSelectorKind.ExactAgent)" /></MudItem>
                        @if (_editor.TargetKind == McpOperatorTargetSelectorKind.ClientTag) { <MudItem xs="12"><MudAutocomplete T="string" Label="Client tag" Value="_editor.ClientTag" ValueChanged="@((string value) => _editor.ClientTag = value)" SearchFunc="SearchTagsAsync" Disabled="@(_busy || _editExisting)" /></MudItem> }
                        <MudItem xs="12" md="6"><MudSelect T="McpOperatorTargetClassification?" Label="Classification filter" @bind-Value="_editor.Classification" Clearable="true" Disabled="_busy">@foreach (var classification in Enum.GetValues<McpOperatorTargetClassification>().Where(value => value != McpOperatorTargetClassification.Unknown)) { <MudSelectItem T="McpOperatorTargetClassification?" Value="@((McpOperatorTargetClassification?)classification)">@classification</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" md="6"><MudSelect T="McpOperatorOperationFamily" Label="Operation families" MultiSelection="true" @bind-SelectedValues="_editor.Families" Disabled="_busy">@foreach (var family in OperatorPolicyDraftEditor.OperationFamilies) { <MudSelectItem Value="family">@family</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12"><MudAutocomplete T="string" @ref="_operationPicker" Label="Add catalog operation" Value="@(string.IsNullOrEmpty(_editor.Operation) ? "" : _editor.Operation)" ValueChanged="AddOperation" SearchFunc="SearchOperationsAsync" CoerceValue="false" Disabled="_busy" ResetValueOnEmptyText="true" />
                            <MudText Typo="Typo.caption">@(_editor.Operations is null ? "Existing family-wide selection" : $"{_editor.Operations.Count} selected operations")</MudText>
                            @if (_editor.Operations is { Count: > 0 }) { <MudExpansionPanels Elevation="0"><MudExpansionPanel Text="Inspect selected operations"><MudStack Row="true" Wrap="Wrap.Wrap">@foreach(var op in _editor.Operations) { <MudChip T="string" OnClose="@(() => RemoveOperation(op))">@op</MudChip> }</MudStack></MudExpansionPanel></MudExpansionPanels> }
                            <MudButton Size="Size.Small" OnClick="@(() => { _editor.Operations = []; _editor.Operation = ""; })" Disabled="_busy">Choose a new operation selection</MudButton>
                            @if (_editor.TargetKind == McpOperatorTargetSelectorKind.Tenant) {
                                <MudAutocomplete T="string" @ref="_clientPicker" Label="Add client exception (optional; all clients when empty)" Value="@(string.Empty)" ValueChanged="AddClient" SearchFunc="SearchClientsAsync" ToStringFunc="ClientOptionName" CoerceValue="false" Disabled="_busy" />
                                <MudStack Row="true" Wrap="Wrap.Wrap">@foreach(var client in _editor.AgentIds ?? []) { <MudChip T="string" OnClose="@(() => RemoveClient(client))">@ClientOptionName(client.ToString())</MudChip> }</MudStack>
                                <MudSelect T="string" Label="Client tags (optional)" MultiSelection="true" SelectedValues="@(_editor.ClientTags ?? [])" SelectedValuesChanged="@(tags => _editor.ClientTags = tags.Any() ? tags.ToArray() : null)" Disabled="_busy">@foreach(var tag in _directory.Tags.Concat(_editor.ClientTags ?? []).Distinct()) { <MudSelectItem Value="tag">@tag</MudSelectItem> }</MudSelect>
                            }</MudItem>
                        <MudItem xs="12"><MudText Typo="Typo.subtitle1" Class="mt-3">Paths and execution bounds</MudText></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Exact working directories" Lines="3" @bind-Value="_editor.WorkingDirectories" Disabled="_busy" data-testid="policy-working-directories" HelperText="/tmp does not include /tmp/example; add each required directory." /></MudItem>
                        <MudItem xs="12" md="6"><MudSelect T="string" Label="Allowed shells" MultiSelection="true" SelectedValues="EditorShells" SelectedValuesChanged="@(shells => _editor.Shells = string.Join('\n', shells))" Disabled="_busy">@foreach(var shell in KnownShells) { <MudSelectItem Value="shell">@shell</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Read roots" Lines="3" @bind-Value="_editor.ReadRoots" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Write roots" Lines="3" @bind-Value="_editor.WriteRoots" Disabled="_busy" /></MudItem>
                        <MudItem xs="12"><MudText Typo="Typo.subtitle1" Class="mt-3">Validity and review</MudText></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Expires at (UTC offset or Z)" @bind-Value="_editor.ExpiresAt" Disabled="_busy" Placeholder="2030-04-01T10:00:00Z" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField Label="Review by (UTC offset or Z)" @bind-Value="_editor.ReviewBy" Disabled="_busy" /></MudItem>
                        <MudItem xs="12"><MudTextField Label="Audit / change reference" @bind-Value="_editor.AuditReference" Disabled="_busy" /></MudItem>
                    </MudGrid>
                    <details class="policy-detail-section"><summary>Limits and confirmation requirements</summary><OperatorPolicyLimitsEditor @bind-Value="_editor.Constraints" Disabled="_busy" /></details>
                </div>
            }
            @if (_preview is { } preview && _prepared is { } prepared)
            {
                <div data-testid="policy-preview-review">
                    <MudText Typo="Typo.h6">Confirm @prepared.Action.ToString().ToLowerInvariant()</MudText>
                    <MudText Typo="Typo.body2">@(prepared.PolicyId is { } id ? $"Policy {id} · expected version {prepared.ExpectedVersion}" : "New policy")</MudText>
                    @if (prepared.Draft is { } draft) { <PolicyDefinitionView Draft="draft" TenantName="@TenantName(draft.TargetSelector.TenantId)" PrincipalName="@PrincipalName(draft.PrincipalSelector)" ClientNames="@ClientsLabel(draft.TargetSelector)" /> }
                    else if (_selected is { } current) { <PolicyDefinitionView Draft="@ToDraft(current)" TenantName="@TenantName(current.TargetSelector.TenantId)" PrincipalName="@PrincipalName(current.PrincipalSelector)" ClientNames="@ClientsLabel(current.TargetSelector)" /> }
                    <MudAlert Severity="Severity.Info" Class="mt-3">@StateChangeDescription(prepared.Action) Preview expires @preview.ExpiresAtUtc.ToUniversalTime().ToString("u"). Correlation: @preview.CorrelationId.</MudAlert>
                    <MudCheckBox T="bool" @bind-Value="_confirmed" Label="I reviewed the exact principal, target, bounds and expiry above." Disabled="_busy" data-testid="policy-confirm-checkbox" />
                </div>
            }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="policy-dialog-actions" @onkeydown="DialogKeyDown">
            @if (_authority is null)
            {
                <MudButton OnClick="CloseDialog" Disabled="_busy">Close</MudButton>
            }
            else if (_preview is not null)
            {
                <MudButton OnClick="DiscardPreview" Disabled="_busy">@(_editing ? "Back to edit" : "Back to details")</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmAsync" Disabled="@(_busy || !_confirmed)" data-testid="policy-confirm">@(_busy ? "Applying…" : "Confirm reviewed change")</MudButton>
            }
            else if (_editing)
            {
                <MudButton OnClick="CancelEditing" Disabled="_busy">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="PreviewDraftAsync" Disabled="_busy" data-testid="policy-preview">Preview exact change</MudButton>
            }
            else
            {
                @if (_selected is not null && _authority is not null)
                {
                    <MudButton Color="Color.Error" OnClick="@(() => PreviewStateAsync(PolicyChangeAction.Delete))" Disabled="@(_busy || _selected.LifecycleState == McpOperatorPolicyLifecycleState.Deleted)" data-testid="policy-delete">Delete</MudButton>
                    @if (_selected.ParentPolicyId is null && CanReplace) { <MudButton OnClick="NewException" Disabled="_busy">Add exception</MudButton> }
                    <MudButton Color="Color.Error" OnClick="@(() => PreviewStateAsync(PolicyChangeAction.Revoke))" Disabled="@(_busy || !CanRevoke)" data-testid="policy-revoke">Revoke</MudButton>
                    <MudButton OnClick="@(() => PreviewStateAsync(PolicyChangeAction.Disable))" Disabled="@(_busy || !CanDisable)" data-testid="policy-disable">Disable</MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditPolicy" Disabled="@(_busy || !CanReplace)" data-testid="policy-edit">Edit</MudButton>
                }
                <MudButton OnClick="CloseDialog" Disabled="_busy">Close</MudButton>
            }
        </div>
    </DialogActions>
</MudDialog>

<MudDialog Visible="@(_consolidationPlan is not null)" Options="PolicyDialogOptions" AriaLabel="Review legacy policy consolidation">
    <TitleContent><MudText Typo="Typo.h6">Consolidate legacy policies</MudText></TitleContent>
    <DialogContent>@if(_consolidationPlan is { } plan) {
        <MudAlert Severity="Severity.Info">Eligible rules keep their limits, expiry, target restrictions and deny behavior. Their policy IDs and audit history remain available under the new base.</MudAlert>
        <MudList T="string">@foreach(var scope in plan.Scopes) { <MudListItem Text="@($"{scope.Name}: {scope.PolicyCount} existing policies")" /> }</MudList>
        @foreach(var conflict in plan.Conflicts) { <MudAlert Severity="Severity.Warning">@conflict</MudAlert> }
        <MudCheckBox T="bool" @bind-Value="_consolidationConfirmed" Label="I reviewed these exact scopes and the preserved conflicts." Disabled="_busy" />
    }</DialogContent>
    <DialogActions><MudButton OnClick="@(() => _consolidationPlan = null)" Disabled="_busy">Cancel</MudButton><MudButton OnClick="ConfirmConsolidationAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !_consolidationConfirmed || _consolidationPlan?.Scopes.Count == 0)">Consolidate</MudButton></DialogActions>
</MudDialog>

<MudDialog Visible="_bulkOpen" Options="PolicyDialogOptions" AriaLabel="Review bulk policy deletion">
    <TitleContent><MudText Typo="Typo.h6">Delete @_bulkPlans.Count selected policies</MudText></TitleContent>
    <DialogContent><MudAlert Severity="Severity.Warning">This removes @BulkAffectedCount policies including child exceptions from management and authorization. Immutable audit/tombstone history is retained. Deletion cannot be undone.</MudAlert>
        <MudList T="string">@foreach(var item in _bulkPlans) { <MudListItem Text="@($"{item.Policy.Name} · v{item.Policy.Version} · {DeleteChildCount(item.Policy)} child exceptions")" /> }</MudList>
        @foreach(var result in _bulkResults) { <MudText Typo="Typo.body2">@result</MudText> }
        <MudCheckBox T="bool" @bind-Value="_bulkConfirmed" Label="I reviewed these policies and all affected child exceptions." Disabled="_busy" />
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _bulkOpen = false)" Disabled="_busy">Close</MudButton><MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmBulkDeleteAsync" Disabled="@(_busy || !_bulkConfirmed || _bulkResults.Count > 0)">Delete selected</MudButton></DialogActions>
</MudDialog>
