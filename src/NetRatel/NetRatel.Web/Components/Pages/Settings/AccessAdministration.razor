@page "/admin/access"
@rendermode InteractiveServer

@using MudBlazor
@using NetRatel.Web.Services.Access

@inject IAccessAdministrationApiService AccessApi
@inject ISnackbar Snackbar

<PageTitle>Access administration</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h4">Access administration</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Assign a role and its tenant scope together. Changes take effect on the next API operation.</MudText>
        </MudPaper>

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudPaper Class="pa-3">
                <MudText Typo="Typo.h6">Create local user</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Create a disabled account and give its one-time activation handoff to the intended operator through an approved channel.</MudText>
                <MudGrid Spacing="2" Class="mt-1">
                    <MudItem xs="12" md="4"><MudTextField Label="Display name" @bind-Value="_newDisplayName" data-testid="local-user-display-name" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField Label="Email" InputType="InputType.Email" @bind-Value="_newEmail" data-testid="local-user-email" /></MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Disabled="@(_creatingUser || string.IsNullOrWhiteSpace(_newDisplayName) || string.IsNullOrWhiteSpace(_newEmail))" OnClick="CreateLocalUserAsync" data-testid="create-local-user">Create activation handoff</MudButton></MudItem>
                </MudGrid>
                @if (_activation is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-testid="local-user-activation">
                        <MudText Typo="Typo.body2">Share this one-time activation token only with @_activation.Email through an approved channel.</MudText>
                        <label class="mud-typography mud-typography-body2" for="local-user-activation-token">One-time activation token</label>
                        <input id="local-user-activation-token" class="mud-input-slot mud-input-root mud-input-root-text mud-input-root-margin-dense" type="text" value="@_activation.ActivationToken" readonly data-testid="local-user-activation-token" />
                    </MudAlert>
                }
            </MudPaper>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-3">
                        <MudText Typo="Typo.h6">Local users</MudText>
                        <MudList T="LocalUserAccessDto" Dense="true">
                            @foreach (var user in _users)
                            {
                                <MudListItem Value="user" OnClick="@(() => SelectUserAsync(user.PrincipalId))">
                                    <MudText>@user.DisplayName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@user.Email · @(user.IsEnabled ? "enabled" : "disabled")</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-3">
                        <MudText Typo="Typo.h6">Assignments</MudText>
                        @if (_selectedPrincipalId is null)
                        {
                            <MudText Color="Color.Secondary">Select a user to edit an independent assignment draft.</MudText>
                        }
                        else
                        {
                            <MudGrid Spacing="2" Class="mb-3">
                                <MudItem xs="12" md="6">
                                    <MudSelect T="string" Label="Role" @bind-Value="_draftRoleId">
                                        @foreach (var role in _roles)
                                        {
                                            <MudSelectItem Value="@role.Id">@role.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudNumericField T="int?" Label="Tenant ID (blank = instance)" @bind-Value="_draftTenantId" />
                                </MudItem>
                                <MudItem xs="12" md="2" Class="d-flex align-end">
                                    <MudButton Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(_draftRoleId)" OnClick="AssignAsync">Add</MudButton>
                                </MudItem>
                            </MudGrid>
                            <MudTable Items="_assignments" Dense="true">
                                <HeaderContent><MudTh>Role</MudTh><MudTh>Scope</MudTh><MudTh></MudTh></HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Role">@context.RoleName</MudTd>
                                    <MudTd DataLabel="Scope">@(context.TenantId?.ToString() ?? "Instance")</MudTd>
                                    <MudTd><MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveAsync(context.Id))">Remove</MudButton></MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudStack>
</MudContainer>

@code {
    private IReadOnlyList<LocalUserAccessDto> _users = [];
    private IReadOnlyList<AccessRoleDto> _roles = [];
    private IReadOnlyList<RoleAssignmentDto> _assignments = [];
    private string? _selectedPrincipalId;
    private string? _draftRoleId;
    private int? _draftTenantId;
    private bool _loading = true;
    private bool _creatingUser;
    private string? _newDisplayName;
    private string? _newEmail;
    private LocalAccountActivationDto? _activation;
    private long _selectionVersion;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _users = await AccessApi.GetUsersAsync();
            _roles = await AccessApi.GetRolesAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("You do not have access administration permission.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectUserAsync(string principalId)
    {
        _selectedPrincipalId = principalId;
        _draftRoleId = null;
        _draftTenantId = null;
        var version = ++_selectionVersion;
        var assignments = await AccessApi.GetAssignmentsAsync(principalId);
        if (version != _selectionVersion || _selectedPrincipalId != principalId)
        {
            return;
        }

        _assignments = assignments;
    }

    private async Task CreateLocalUserAsync()
    {
        var displayName = _newDisplayName;
        var email = _newEmail;
        if (string.IsNullOrWhiteSpace(displayName) || string.IsNullOrWhiteSpace(email)) return;

        _creatingUser = true;
        try
        {
            _activation = await AccessApi.CreateLocalUserAsync(displayName, email);
            _users = await AccessApi.GetUsersAsync();
            _newDisplayName = null;
            _newEmail = null;
            Snackbar.Add("Local user created. Deliver the activation handoff through an approved channel.", Severity.Success);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The local user could not be created. Your entered name and email were kept for retry.", Severity.Error);
        }
        finally
        {
            _creatingUser = false;
        }
    }

    private async Task AssignAsync()
    {
        var principalId = _selectedPrincipalId;
        var roleId = _draftRoleId;
        var tenantId = _draftTenantId;
        if (principalId is null || string.IsNullOrWhiteSpace(roleId)) return;
        await AccessApi.AssignAsync(principalId, roleId, tenantId);
        if (_selectedPrincipalId == principalId)
        {
            await RefreshAssignmentsAsync(principalId);
        }
    }

    private async Task RemoveAsync(string assignmentId)
    {
        var principalId = _selectedPrincipalId;
        if (principalId is null) return;
        await AccessApi.RemoveAssignmentAsync(principalId, assignmentId);
        if (_selectedPrincipalId == principalId)
        {
            await RefreshAssignmentsAsync(principalId);
        }
    }

    private async Task RefreshAssignmentsAsync(string principalId)
    {
        var version = ++_selectionVersion;
        var assignments = await AccessApi.GetAssignmentsAsync(principalId);
        if (version == _selectionVersion && _selectedPrincipalId == principalId)
        {
            _assignments = assignments;
            _draftRoleId = null;
            _draftTenantId = null;
        }
    }
}
