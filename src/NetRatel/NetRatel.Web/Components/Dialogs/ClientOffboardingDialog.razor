@using System.Net
@using NetRatel.Shared.Contracts
@using NetRatel.Web.Models.Clients
@using NetRatel.Web.Services.Clients
@using NetRatel.Web.Services.Authentication
@implements IAsyncDisposable
@inject IClientOffboardingApiService OffboardingApi
@inject ILogger<ClientOffboardingDialog> Logger

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" data-testid="client-offboarding-dialog">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Color="Color.Secondary">@Client.HostName</MudText>
                @if (!string.IsNullOrWhiteSpace(Client.FriendlyName))
                {
                    <MudText>@Client.FriendlyName</MudText>
                }
                <MudText Typo="Typo.body2">@Client.TenantName · @(Client.Online ? "Online" : "Offline")</MudText>
                <MudText Typo="Typo.caption">Last seen: @(Client.LastHeartbeatUtc?.ToLocalTime().ToString("g") ?? "Not observed")</MudText>
                <MudText Typo="Typo.caption" Style="overflow-wrap:anywhere">Client ID: @Client.AgentId</MudText>
            </MudStack>
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" aria-label="Loading removal options" />
            }
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" data-testid="client-offboarding-error">@_error</MudAlert>
            }
            @if (_details?.Operation is { } operation)
            {
                <MudPaper Outlined="true" Class="pa-3" data-testid="client-offboarding-progress" role="status" aria-live="polite">
                    <MudText Typo="Typo.subtitle2">@ProgressTitle(operation)</MudText>
                    <MudText Typo="Typo.body2">@ProgressDescription(operation)</MudText>
                    @if (operation.FailureCode is not null)
                    {
                        <MudText Typo="Typo.caption">Reference: @operation.FailureCode</MudText>
                    }
                    <MudText Typo="Typo.caption">Requested: @operation.RequestedAtUtc.ToLocalTime().ToString("g")</MudText>
                </MudPaper>
            }
            @if (!Pending || _removeDuringPending)
            {
                @if (_removeDuringPending)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">The uninstall request may still be running. Removing this record revokes its access and removes it from the platform without waiting for that result.</MudAlert>
                }
                <MudRadioGroup T="string" @bind-Value="_action">
                    <MudRadio T="string" Value="@("remove")" Disabled="_busy" data-testid="client-offboarding-remove-option">Remove from platform</MudRadio>
                    <MudText Typo="Typo.body2" Class="ml-8 mb-2">Removes this record and revokes its access. The software stays installed on the computer.</MudText>
                    <MudRadio T="string" Value="@("uninstall")" Disabled="@(_busy || _removeDuringPending || _details?.CanUninstall != true)" data-testid="client-offboarding-uninstall-option">Uninstall and remove</MudRadio>
                    <MudText Typo="Typo.body2" Class="ml-8">Stops and removes the NetRatel client service and its installation. This record is removed after completion is confirmed.</MudText>
                    @if (_details is { CanUninstall: false })
                    {
                        <MudText Typo="Typo.caption" Class="ml-8">@UnavailableMessage(_details.UnavailableReason)</MudText>
                    }
                </MudRadioGroup>
                <MudTextField T="string" @bind-Value="_reason" Label="Reason (optional)" MaxLength="256" Disabled="_busy" Variant="Variant.Outlined" />
            }
            else
            {
                <MudText Typo="Typo.body2">You can close this dialog. The operation continues and its status is saved.</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Disabled="_busy" data-testid="client-offboarding-close">@(_details?.Operation is null ? "Cancel" : "Close")</MudButton>
        @if (Pending && !_removeDuringPending)
        {
            <MudButton Color="Color.Error" OnClick="ChooseRecordRemoval" Disabled="_busy"
                       data-testid="client-offboarding-remove-pending">Remove record only…</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RetryAsync"
                       Disabled="@(_busy || _details?.CanUninstall != true || _details.Operation!.ReceiptExpiresAtUtc <= DateTimeOffset.UtcNow)"
                       data-testid="client-offboarding-retry">Retry request</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmAsync"
                       Disabled="@(_loading || _busy || _details is null || _action == "uninstall" && !_details.CanUninstall)"
                       data-testid="client-offboarding-confirm">@(_busy ? "Working…" : _action == "uninstall" ? "Uninstall and remove" : "Remove client")</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public ClientPresentationModel Client { get; set; } = default!;
    [CascadingParameter] private IMudDialogInstance? Dialog { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private ClientOffboardingDetailsDto? _details;
    private string _action = "remove";
    private string? _reason;
    private string? _error;
    private bool _loading = true;
    private bool _busy;
    private bool _removeDuringPending;
    private Task? _polling;
    private Guid _requestId = Guid.NewGuid();
    private bool Pending => _details?.Operation?.State is "requested" or "accepted" or "confirmation_pending";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _loading = false;
        StartPolling();
    }

    private async Task RefreshAsync()
    {
        try
        {
            _details = await OffboardingApi.GetAsync(Client.TenantId, Client.AgentId, _lifetime.Token);
            if (_details.Removed) Dialog?.Close(DialogResult.Ok(true));
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; }
        catch (Exception exception)
        {
            _error = FailureMessage(exception);
            Logger.LogWarning(exception, "Could not read offboarding for tenant {TenantId}, agent {AgentId}.", Client.TenantId, Client.AgentId);
        }
    }

    private Task RetryAsync()
    {
        if (_details?.Operation is { } operation) _requestId = operation.OperationId;
        _action = "uninstall";
        return ConfirmAsync();
    }

    private void ChooseRecordRemoval()
    {
        _removeDuringPending = true;
        _action = "remove";
    }

    private async Task ConfirmAsync()
    {
        if (_busy || _details is null || _action == "uninstall" && !_details.CanUninstall) return;
        _busy = true;
        _error = null;
        try
        {
            _details = _action == "uninstall"
                ? await OffboardingApi.UninstallAsync(Client.TenantId, Client.AgentId, new(_requestId, _reason), _lifetime.Token)
                : await OffboardingApi.RemoveAsync(Client.TenantId, Client.AgentId, new(_reason), _lifetime.Token);
            if (_details.Removed) Dialog?.Close(DialogResult.Ok(true));
            else if (_details.Operation?.State == "failed") _requestId = Guid.NewGuid();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; }
        catch (Exception exception)
        {
            _error = FailureMessage(exception);
            Logger.LogWarning(exception, "Client removal request did not return a result. tenantId={TenantId}, agentId={AgentId}", Client.TenantId, Client.AgentId);
            // Reconcile a potentially accepted operation before offering another request.
            await RefreshAsync();
        }
        finally { _busy = false; }
        StartPolling();
    }

    private void StartPolling()
    {
        if (Pending && (_polling is null || _polling.IsCompleted)) _polling = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (Pending && await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; }
    }

    private static string ProgressTitle(ClientOffboardingOperationDto operation) => operation.State switch
    {
        "requested" => "Uninstall requested",
        "accepted" => "Uninstall in progress",
        "completed" => "Uninstall completed",
        "failed" => "Uninstall did not complete",
        _ => "Waiting for uninstall confirmation"
    };

    private static string ProgressDescription(ClientOffboardingOperationDto operation) => operation.State switch
    {
        "requested" => "Waiting for the client to accept the request. The record remains visible.",
        "accepted" => "The client accepted the request. Waiting for the helper to confirm service and installation removal.",
        "completed" => "The service and installation were removed and this record has been offboarded.",
        "failed" => "The record has been retained. Check the failure reference before trying again or removing the record separately.",
        _ => "Completion has not been confirmed. A disconnected client alone does not establish that uninstall succeeded."
    };

    private static string UnavailableMessage(string? reason) => reason switch
    {
        "client_offline" => "Uninstall is available when this client is online.",
        "control_session_unavailable" => "Waiting for the client's control connection.",
        "client_not_active" => "Uninstall requires an enabled client.",
        "client_removed" => "This client has been removed.",
        _ => "This installation does not advertise managed uninstall. A supported Windows or Linux service client is required."
    };

    private static string FailureMessage(Exception exception) => exception switch
    {
        ReauthRequiredException => "Sign in again to manage this client.",
        ClientOffboardingApiException { Code: "uninstall_confirmation_expired" } => "The completion window has elapsed. The record is retained until you reconcile the installation and remove it separately.",
        ClientOffboardingApiException { Code: "client_offline" or "control_session_unavailable" or "client_session_changed" } => "The client connection changed. Refresh its status and try again when it is online.",
        HttpRequestException { StatusCode: HttpStatusCode.Forbidden } => "You do not have permission to manage this client's tenant.",
        HttpRequestException { StatusCode: HttpStatusCode.NotFound } => "This client record is no longer available.",
        HttpRequestException { StatusCode: HttpStatusCode.Unauthorized } => "Sign in again to manage this client.",
        _ => "The operation status could not be confirmed. Refresh or reopen this dialog to check its saved progress."
    };

    private void Close() => Dialog?.Cancel();

    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        if (_polling is not null) await _polling;
        _lifetime.Dispose();
    }
}
