@using NetRatel.Shared.Contracts
@using NetRatel.Shared.Contracts.Requests

<MudDialog Class="tenant-editor-dialog">
    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="flex-wrap">
                <div>
                    <MudText Typo="Typo.h6">@DialogTitle</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(IsEditMode && Tenant is not null ? $"Tenant #{Tenant.TenantId}" : "Create a new tenant record")
                    </MudText>
                </div>

                @if (IsEditMode && Tenant is not null)
                {
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">
                        Updated @Tenant.UpdatedAt.ToLocalTime().ToString("g")
                    </MudChip>
                }
            </MudStack>

            <MudForm @ref="_form">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.Name"
                                      Label="Tenant name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.Location"
                                      Label="Location"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Description"
                                      Label="Description"
                                      Variant="Variant.Outlined"
                                      Lines="2"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.ContactPerson"
                                      Label="Contact person"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.ContactEmail"
                                      Label="Contact email"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_domainsText"
                                      Label="Domains"
                                      HelperText="Comma, space, or new-line separated"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudSwitch T="bool"
                                   @bind-Value="_model.AutoUpdate"
                                   Color="Color.Primary">
                            Auto Update
                        </MudSwitch>
                    </MudItem>

                    <MudItem xs="12">
                        <MudSelect T="string" @bind-Value="_model.AutoUpdateChannel"
                                   Label="Release channel" Variant="Variant.Outlined"
                                   HelperText="Global release automation does not change this tenant's channel."
                                   data-testid="tenant-release-channel">
                            <MudSelectItem Value="@("stable")">Stable releases only</MudSelectItem>
                            <MudSelectItem Value="@("prerelease")">Stable releases and prereleases</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="bool" @bind-Value="_pinTargetVersion"
                                   Label="Target version policy" Variant="Variant.Outlined"
                                   data-testid="tenant-target-policy">
                            <MudSelectItem T="bool" Value="false">No pin / follow selected channel</MudSelectItem>
                            <MudSelectItem T="bool" Value="true">Pin a specific version</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @if (_pinTargetVersion)
                    {
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="_model.AutoUpdateTargetVersion"
                                          Label="Target version" Variant="Variant.Outlined" Immediate="true"
                                          Required="true" RequiredError="Enter a version or choose no pin."
                                          Validation="@(new Func<string?, string?>(ValidateTargetVersion))"
                                          HelperText="Only this version can be offered. Newer releases remain excluded until you change or clear the pin."
                                          data-testid="tenant-target-version-input" />
                        </MudItem>
                    }

                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-3" data-testid="tenant-effective-update-policy">
                            <MudText Typo="Typo.subtitle2">Effective update policy</MudText>
                            <MudText Typo="Typo.body2">Automatic updates: @(_model.AutoUpdate ? "on" : "off") · Channel: @(_model.AutoUpdateChannel == "prerelease" ? "Stable releases and prereleases" : "Stable releases only")</MudText>
                            <MudText Typo="Typo.body2" Style="overflow-wrap: anywhere;" data-testid="tenant-target-version">
                                @(_pinTargetVersion ? $"Target version pin: {_model.AutoUpdateTargetVersion}. Only this version is eligible within the selected channel." : "No pin / follow selected channel.")
                            </MudText>
                            @if (_pinTargetVersion && !TenantUpdatePolicyValidation.IsTargetInChannel(_model.AutoUpdateChannel, _model.AutoUpdateTargetVersion))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Warning">This prerelease pin is excluded by the selected channel. Choose the prerelease channel or clear the pin to allow eligible offers.</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">
            @(IsEditMode ? "Save Changes" : "Create Tenant")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public TenantDto? Tenant { get; set; }
    [Parameter] public string DialogTitle { get; set; } = "Tenant";
    [Parameter] public bool IsEditMode { get; set; }

    private MudForm? _form;
    private CreateTenantRequest _model = new();
    private string _domainsText = string.Empty;
    private bool _pinTargetVersion;

    protected override void OnParametersSet()
    {
        if (Tenant is null)
        {
            _model = new CreateTenantRequest();
            _domainsText = string.Empty;
            _pinTargetVersion = false;
            return;
        }

        _model = new CreateTenantRequest
        {
            Name = Tenant.Name,
            Description = Tenant.Description,
            Location = Tenant.Location,
            ContactPerson = Tenant.ContactPerson,
            ContactEmail = Tenant.ContactEmail,
            AutoUpdate = Tenant.AutoUpdate,
            AutoUpdateChannel = Tenant.AutoUpdateChannel,
            AutoUpdateTargetVersion = Tenant.AutoUpdateTargetVersion,
            Domains = Tenant.Domains.ToList()
        };

        _domainsText = string.Join(System.Environment.NewLine, Tenant.Domains);
        _pinTargetVersion = !string.IsNullOrWhiteSpace(Tenant.AutoUpdateTargetVersion);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }
        }

        _model.Name = _model.Name?.Trim() ?? string.Empty;
        _model.Description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim();
        _model.Location = string.IsNullOrWhiteSpace(_model.Location) ? null : _model.Location.Trim();
        _model.ContactPerson = string.IsNullOrWhiteSpace(_model.ContactPerson) ? null : _model.ContactPerson.Trim();
        _model.ContactEmail = string.IsNullOrWhiteSpace(_model.ContactEmail) ? null : _model.ContactEmail.Trim();
        _model.Domains = ParseDomains(_domainsText);
        _model.AutoUpdateTargetVersion = _pinTargetVersion ? _model.AutoUpdateTargetVersion?.Trim() : null;

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private string? ValidateTargetVersion(string? value)
    {
        var target = value?.Trim();
        if (TenantUpdatePolicyValidation.TargetVersionError(target) is { } error) return error;
        if ((!string.Equals(target, Tenant?.AutoUpdateTargetVersion, StringComparison.Ordinal) ||
             !string.Equals(_model.AutoUpdateChannel, Tenant?.AutoUpdateChannel, StringComparison.Ordinal)) &&
            !TenantUpdatePolicyValidation.IsTargetInChannel(_model.AutoUpdateChannel, target))
            return "Select the prerelease channel for this target, or choose no pin.";
        return null;
    }

    private static List<string> ParseDomains(string? raw)
    {
        return (raw ?? string.Empty)
            .Split([',', '\n', '\r', '\t', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
