@using Microsoft.AspNetCore.Components.Web.Virtualization
@using NetRatel.Shared.Contracts.FileSystem
@using NetRatel.Web.Components.Dialogs.FileBrowser
@using NetRatel.Web.Services.FileSystem
@implements IDisposable

<MudDialog Class="file-explorer-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">File Browser · @HostLabel</MudText>
                <MudText Typo="Typo.caption">Remote Explorer</MudText>
            </MudStack>
            <MudButton Variant="Variant.Text" OnClick="Close">Close</MudButton>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="file-explorer-content">
        <section class="file-explorer-shell" data-testid="file-explorer">
            <MudStack Spacing="1" Class="file-explorer-toolbar">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="file-explorer-navigation">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowUpward" OnClick="GoUpAsync" Disabled="_loading || _mutating || !CanGoUp">Up</MudButton>
                    <MudTextField @bind-Value="_currentPath" Label="Remote path" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" OnKeyDown="HandlePathKeyDownAsync" Disabled="_mutating" Class="flex-grow-1" data-testid="file-explorer-path" />
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="RefreshAsync" Disabled="_loading || _mutating" aria-label="Refresh directory" />
                    @if (_canCreateDirectory)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="ShowCreateDirectory" Disabled="_loading || _mutating || _gatewayReconnecting" data-testid="file-explorer-new-folder">New folder</MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" OnClick="ChooseUploadAsync" Disabled="_loading || _uploading || _mutating || _gatewayReconnecting || !_canWriteFiles">Upload</MudButton>
                    @if (_uploading)
                    {
                        <MudText Typo="Typo.caption">@_uploadState</MudText>
                        <MudProgressLinear Value="@_uploadPercent" Color="Color.Primary" Class="flex-grow-1" />
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelUploadAsync">Cancel upload</MudButton>
                    }
                    @if (_downloadState is not null)
                    {
                        <MudAlert Severity="@DownloadSeverity" Variant="Variant.Outlined" Dense="true" Class="w-100" data-testid="file-explorer-download-state">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.caption">@DownloadDetail</MudText>
                                @if (_downloadExpectedBytes is > 0)
                                {
                                    <MudProgressLinear Value="@DownloadPercent" Color="@DownloadColor" Class="flex-grow-1" />
                                }
                                @if (_downloadState is "preparing" or "streaming")
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelDownloadAsync">Cancel download</MudButton>
                                }
                            </MudStack>
                        </MudAlert>
                    }
                    <input @ref="_uploadInput" type="file" class="file-explorer-upload-input" @onchange="UploadAsync" />
                </MudStack>
                @if (_creatingDirectory)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="file-explorer-navigation" data-testid="file-explorer-create-folder">
                        <MudTextField @bind-Value="_newDirectoryName" Label="New folder name" HelperText="Enter one folder name, without path separators." Error="@(_newDirectoryName.Length > 0 && !CanCreateDirectory)" ErrorText="Enter a valid folder name for this system." Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Disabled="_mutating" Class="flex-grow-1" data-testid="file-explorer-folder-name" />
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateDirectoryAsync" Disabled="_mutating || !CanCreateDirectory" data-testid="file-explorer-create-folder-submit">Create folder</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CancelCreateDirectory" Disabled="_mutating">Cancel</MudButton>
                    </MudStack>
                }
                @if (_mutating)
                {
                    <MudProgressLinear Indeterminate="true" />
                    <MudText Typo="Typo.caption" data-testid="file-explorer-mutation-state">@_mutationState</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(_mutationError))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" data-testid="file-explorer-mutation-error">@_mutationError</MudAlert>
                }
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="file-explorer-location">
                    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" />
                    <MudText Typo="Typo.body2" data-testid="file-explorer-location">@_currentPath</MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudTextField @bind-Value="_filter" Placeholder="Filter files and folders..." Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="flex-grow-1" data-testid="file-explorer-filter" />
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" data-testid="file-explorer-count">@FilteredEntries.Count item@(FilteredEntries.Count == 1 ? string.Empty : "s")</MudChip>
                </MudStack>
            </MudStack>

            @if (_loading)
            {
                <div class="file-explorer-state" data-testid="file-explorer-loading">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText>@(_gatewayReconnecting ? "File gateway reconnecting…" : "Loading remote directory…")</MudText>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_lastDirectoryError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="file-explorer-error">@_lastDirectoryError</MudAlert>
            }
            else if (_entries.Count == 0)
            {
                <div class="file-explorer-state" data-testid="file-explorer-empty">
                    <MudIcon Icon="@Icons.Material.Filled.FolderOff" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle1">This directory is empty.</MudText>
                </div>
            }
            else if (FilteredEntries.Count == 0)
            {
                <div class="file-explorer-state" data-testid="file-explorer-no-filter-results">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle1">No files or folders match this filter.</MudText>
                </div>
            }
            else
            {
                <div class="file-explorer-list" role="list" data-testid="file-explorer-list">
                    <div class="file-explorer-row file-explorer-heading" role="presentation">
                        <span>Name</span>
                        <span>Type</span>
                        <span>Size</span>
                        <span>Created (UTC)</span>
                        <span>Modified (UTC)</span>
                        <span aria-label="Actions"></span>
                    </div>
                    <Virtualize Items="FilteredEntries" Context="entry" ItemSize="52" TItem="FileSystemEntryDto">
                        <div class="file-explorer-row" role="listitem" data-testid="file-explorer-entry">
                            <MudButton Variant="Variant.Text" Class="file-explorer-name" OnClick="@(() => OpenEntryAsync(entry))" Disabled="_mutating">
                                <MudIcon Icon="@(entry.IsDirectory ? Icons.Material.Filled.Folder : Icons.Material.Filled.Description)" Class="me-2" />
                                <span class="file-explorer-name-text">@entry.Name<span class="file-explorer-mobile-metadata">@(entry.LastModifiedUtc is null ? "Modified time not reported" : $"Modified {FormatTimestamp(entry.LastModifiedUtc)} UTC")</span></span>
                            </MudButton>
                            <MudText Typo="Typo.body2">@(entry.IsDirectory ? "Folder" : GetFileType(entry.Name))</MudText>
                            <MudText Typo="Typo.body2">@(entry.IsDirectory ? "—" : FormatBytes(entry.SizeBytes))</MudText>
                            <span class="file-explorer-timestamp" data-testid="file-explorer-entry-created">@FormatTimestamp(entry.CreatedUtc)</span>
                            <span class="file-explorer-timestamp" data-testid="file-explorer-entry-modified">@FormatTimestamp(entry.LastModifiedUtc)</span>
                            <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                                @if (entry.IsDirectory)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" OnClick="@(() => OpenDirectoryAsync(entry.FullPath))" Disabled="_mutating" aria-label="Open folder" />
                                    @if (_canDeleteDirectory && RemoteFilePath.TryGetDirectoryParent(entry.FullPath, out _))
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteDirectoryAsync(entry))" Disabled="_mutating" aria-label="Delete empty folder" data-testid="file-explorer-delete-folder" />
                                    }
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenFileAsync(entry))" aria-label="Open file viewer" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Download" OnClick="@(() => DownloadAsync(entry))" aria-label="Download file" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopyPathAsync(entry.FullPath))" aria-label="Copy remote path" />
                            </MudStack>
                        </div>
                    </Virtualize>
                </div>
            }
        </section>
        </div>
    </DialogContent>
</MudDialog>

<style>
    .file-explorer-dialog .mud-dialog-content { overflow: hidden; padding: 0; }
    .file-explorer-dialog .file-explorer-content { height: calc(100dvh - 7.5rem); }
    .file-explorer-shell { height: 100%; min-height: 0; display: flex; flex-direction: column; gap: 0.75rem; padding: 1rem; }
    .file-explorer-toolbar { flex: 0 0 auto; position: sticky; top: 0; z-index: 1; padding-bottom: 0.5rem; background: var(--mud-palette-surface); }
    .file-explorer-navigation { flex-wrap: wrap; }
    .file-explorer-location { min-width: 0; }
    .file-explorer-location .mud-typography { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .file-explorer-list { flex: 1 1 auto; min-height: 0; overflow: auto; border: 1px solid rgba(14, 90, 135, 0.16); border-radius: 8px; }
    .file-explorer-row { display: grid; grid-template-columns: minmax(12rem, 1fr) minmax(4rem, 6rem) minmax(5rem, 7rem) minmax(9rem, 11rem) minmax(9rem, 11rem) minmax(8rem, auto); align-items: center; gap: 0.75rem; min-height: 3.25rem; padding: 0.25rem 0.5rem; border-bottom: 1px solid rgba(14, 90, 135, 0.08); }
    .file-explorer-heading { position: sticky; top: 0; z-index: 1; min-height: 2.5rem; font-size: 0.75rem; font-weight: 600; color: var(--mud-palette-text-secondary); background: var(--mud-palette-surface); }
    .file-explorer-name { min-width: 0; justify-content: flex-start; text-align: left; text-transform: none; }
    .file-explorer-name span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .file-explorer-name-text { display: block; text-align: left; }
    .file-explorer-mobile-metadata { display: none; color: var(--mud-palette-text-secondary); font-size: 0.7rem; }
    .file-explorer-timestamp { color: var(--mud-palette-text-secondary); font-size: 0.75rem; }
    .file-explorer-upload-input { display: none; }
    .file-explorer-state { flex: 1 1 auto; min-height: 12rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; color: var(--mud-palette-text-secondary); }
    @@media (max-width: 950px) {
        .file-explorer-row { grid-template-columns: minmax(0, 1fr) auto; gap: 0.25rem 0.5rem; }
        .file-explorer-row > :nth-child(2), .file-explorer-row > :nth-child(3), .file-explorer-timestamp, .file-explorer-heading { display: none; }
        .file-explorer-mobile-metadata { display: block; }
    }
    @@media (max-width: 600px) {
        .file-explorer-dialog .file-explorer-content { height: calc(100dvh - 5.5rem); }
        .file-explorer-shell { padding: 0.75rem; }
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private FileSystemApiService FileSystemApi { get; set; } = default!;
    [Inject] private GatewayFileSystemApiService GatewayFileSystemApi { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    [Parameter] public string ClientIdentity { get; set; } = string.Empty;
    [Parameter] public int? TenantId { get; set; }
    [Parameter] public Guid? AgentId { get; set; }
    [Parameter] public string HostLabel { get; set; } = "Client";
    [Parameter] public string InitialPath { get; set; } = "/";

    private readonly List<FileSystemEntryDto> _entries = [];
    private List<FileSystemEntryDto> _filteredEntries = [];
    private string _currentPath = string.Empty;
    private string _filter = string.Empty;
    private bool _loading;
    private bool _gatewayReconnecting;
    private bool _disposed;
    private bool _canWriteFiles;
    private bool _canCreateDirectory;
    private bool _canDeleteDirectory;
    private bool _creatingDirectory;
    private bool _mutating;
    private string _newDirectoryName = string.Empty;
    private string? _mutationError;
    private string? _mutationState;
    private readonly CancellationTokenSource _directoryLifecycle = new();
    private bool _uploading;
    private double _uploadPercent;
    private string _uploadState = "Uploading remote file…";
    private string? _lastDirectoryError;
    private ElementReference _uploadInput;
    private string? _activeUploadId;
    private DotNetObjectReference<ClientFileSystemViewer>? _uploadCallbacks;
    private string? _activeDownloadId;
    private string? _downloadState;
    private string? _downloadFailure;
    private long _downloadBytes;
    private long? _downloadExpectedBytes;
    private DotNetObjectReference<ClientFileSystemViewer>? _downloadCallbacks;

    private List<FileSystemEntryDto> FilteredEntries { get { ApplyFilter(); return _filteredEntries; } }
    private bool CanGoUp => RemoteFilePath.TryGetDirectoryParent(_currentPath, out _);
    private bool IsGatewayClient => TenantId is not null && AgentId is not null;
    private bool CanCreateDirectory => _canCreateDirectory && RemoteFilePath.TryJoinDirectory(_currentPath, _newDirectoryName, out _);

    protected override async Task OnInitializedAsync()
    {
        _currentPath = RemoteFilePath.TryNormalizeDirectory(InitialPath, out var initialPath) ? initialPath : "/";
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (!RemoteFilePath.TryNormalizeDirectory(_currentPath, out var normalizedPath)) { _lastDirectoryError = "Enter an absolute Unix path or Windows drive path."; return; }
        _currentPath = normalizedPath;
        _loading = true;
        _lastDirectoryError = null;
        try
        {
            var response = await ListDirectoryAsync(_currentPath);
            _entries.Clear();
            _entries.AddRange(response.Entries.OrderBy(entry => entry.IsDirectory ? 0 : 1).ThenBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase));
            ApplyFilter();
        }
        catch (OperationCanceledException) when (_directoryLifecycle.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _lastDirectoryError = exception.Message;
            Snackbar.Add($"Failed to list directory: {exception.Message}", Severity.Error);
        }
        finally { _loading = false; _gatewayReconnecting = false; }
    }

    private Task HandlePathKeyDownAsync(KeyboardEventArgs args) =>
        string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase) && !_loading && !_mutating
            ? RefreshAsync()
            : Task.CompletedTask;

    private Task OpenEntryAsync(FileSystemEntryDto entry) => entry.IsDirectory ? OpenDirectoryAsync(entry.FullPath) : OpenFileAsync(entry);

    private async Task OpenDirectoryAsync(string path)
    {
        if (!RemoteFilePath.TryNormalizeDirectory(path, out var normalizedPath)) { _lastDirectoryError = "The selected remote path is invalid."; return; }
        _currentPath = normalizedPath;
        await RefreshAsync();
    }

    private async Task GoUpAsync()
    {
        if (RemoteFilePath.TryGetDirectoryParent(_currentPath, out var parent)) { _currentPath = parent; await RefreshAsync(); }
    }

    private void ShowCreateDirectory()
    {
        _creatingDirectory = true;
        _newDirectoryName = string.Empty;
        _mutationError = null;
    }

    private void CancelCreateDirectory() => _creatingDirectory = false;

    private async Task CreateDirectoryAsync()
    {
        if (_mutating || !CanCreateDirectory || !IsGatewayClient) return;
        var parent = _currentPath;
        var name = _newDirectoryName;
        _mutating = true;
        _mutationState = $"Creating {name}…";
        _mutationError = null;
        try
        {
            await GatewayFileSystemApi.CreateDirectoryAsync(TenantId!.Value, AgentId!.Value, parent, name, _directoryLifecycle.Token);
            if (_disposed) return;
            _creatingDirectory = false;
            _newDirectoryName = string.Empty;
            Snackbar.Add($"Created folder {name}.", Severity.Success);
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (_disposed) { return; }
        catch (Exception exception) { _mutationError = exception.Message; }
        finally { _mutating = false; _mutationState = null; }
    }

    private async Task DeleteDirectoryAsync(FileSystemEntryDto entry)
    {
        if (_mutating || !_canDeleteDirectory || !IsGatewayClient || !entry.IsDirectory || !RemoteFilePath.TryGetDirectoryParent(entry.FullPath, out _)) return;
        _mutating = true;
        _mutationError = null;
        _mutationState = "Review folder deletion…";
        try
        {
            var confirmed = await DialogService.ShowMessageBoxAsync("Delete empty folder",
                $"Delete '{entry.FullPath}' on {HostLabel}? Only an empty folder can be deleted.",
                yesText: "Delete folder", cancelText: "Cancel");
            if (confirmed != true || _disposed) return;
            _mutationState = $"Deleting {entry.Name}…";
            await GatewayFileSystemApi.DeleteDirectoryAsync(TenantId!.Value, AgentId!.Value, entry.FullPath, _directoryLifecycle.Token);
            if (_disposed) return;
            Snackbar.Add($"Deleted folder {entry.Name}.", Severity.Success);
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (_disposed) { return; }
        catch (Exception exception) { _mutationError = exception.Message; }
        finally { _mutating = false; _mutationState = null; }
    }

    private async Task OpenFileAsync(FileSystemEntryDto entry)
    {
        var parameters = new DialogParameters<ClientFileViewer>
        {
            { viewer => viewer.File, entry },
            { viewer => viewer.ClientIdentity, ClientIdentity },
            { viewer => viewer.TenantId, TenantId },
            { viewer => viewer.AgentId, AgentId }
        };
        var dialog = await DialogService.ShowAsync<ClientFileViewer>(entry.Name, parameters,
            new DialogOptions { FullScreen = true, CloseOnEscapeKey = true, CloseButton = false });
        await dialog.Result;
    }

    private async Task DownloadAsync(FileSystemEntryDto entry)
    {
        if (!IsGatewayClient)
        {
            Snackbar.Add("Browser-native download requires a gateway-backed client.", Severity.Warning);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_activeDownloadId))
        {
            await CancelDownloadAsync();
        }

        _activeDownloadId = Guid.NewGuid().ToString("D");
        _downloadCallbacks?.Dispose();
        _downloadCallbacks = DotNetObjectReference.Create(this);
        _downloadState = "preparing";
        _downloadFailure = null;
        _downloadBytes = 0;
        _downloadExpectedBytes = entry.SizeBytes >= 0 ? entry.SizeBytes : null;
        var url = $"/file-browser/transfers/download?tenantId={TenantId}&agentId={AgentId:D}&transferId={_activeDownloadId}&expectedBytes={_downloadExpectedBytes}&path={Uri.EscapeDataString(entry.FullPath)}";
        await JSRuntime.InvokeVoidAsync("netratelDownloads.start", url, _activeDownloadId, _downloadCallbacks);
    }

    private Task ChooseUploadAsync() => JSRuntime.InvokeVoidAsync("netratelFileTransfers.pick", _uploadInput).AsTask();

    private async Task UploadAsync(ChangeEventArgs args)
    {
        if (!IsGatewayClient || string.IsNullOrWhiteSpace(args.Value?.ToString()))
        {
            return;
        }

        var fileName = args.Value.ToString()!.Split('/').Last().Split('\\').Last();
        if (string.IsNullOrWhiteSpace(fileName) || fileName.IndexOfAny(['/', '\\', '\0']) >= 0)
        {
            Snackbar.Add("The upload destination is invalid.", Severity.Error);
            return;
        }

        if (!RemoteFilePath.TryJoinDirectory(_currentPath, fileName, out var destination))
        {
            Snackbar.Add("The upload destination is invalid.", Severity.Error);
            return;
        }

        if (_entries.Any(entry => string.Equals(entry.Name, fileName, StringComparison.OrdinalIgnoreCase)) &&
            !await JSRuntime.InvokeAsync<bool>("confirm", $"Overwrite remote file '{fileName}'?"))
        {
            return;
        }

        _activeUploadId = Guid.NewGuid().ToString("N");
        _uploadCallbacks = DotNetObjectReference.Create(this);
        _uploading = true;
        _uploadPercent = 0;
        _uploadState = "Uploading remote file…";
        try
        {
            var url = $"/file-browser/transfers/upload?tenantId={TenantId}&agentId={AgentId:D}&path={Uri.EscapeDataString(destination)}";
            await JSRuntime.InvokeVoidAsync(
                "netratelFileTransfers.upload",
                Timeout.InfiniteTimeSpan,
                _uploadInput,
                url,
                _activeUploadId,
                _uploadCallbacks);
            Snackbar.Add($"Uploaded {fileName} through the native streaming transfer.", Severity.Success);
            await RefreshAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _uploading = false;
            _activeUploadId = null;
            _uploadCallbacks?.Dispose();
            _uploadCallbacks = null;
        }
    }

    private Task CancelUploadAsync()
    {
        _uploadState = "Cancelling remote upload…";
        return string.IsNullOrWhiteSpace(_activeUploadId)
            ? Task.CompletedTask
            : JSRuntime.InvokeVoidAsync("netratelFileTransfers.cancel", _activeUploadId).AsTask();
    }

    [JSInvokable]
    public Task OnUploadProgress(long transferredBytes, long totalBytes)
    {
        _uploadPercent = totalBytes <= 0 ? 0 : Math.Clamp(transferredBytes * 100d / totalBytes, 0, 100);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadRetrying(int attempt, int maximumAttempts)
    {
        _uploadState = $"Reconnecting remote upload (attempt {attempt} of {maximumAttempts})…";
        return InvokeAsync(StateHasChanged);
    }

    private Task CancelDownloadAsync() => string.IsNullOrWhiteSpace(_activeDownloadId)
        ? Task.CompletedTask
        : JSRuntime.InvokeVoidAsync("netratelDownloads.cancel", _activeDownloadId).AsTask();

    [JSInvokable]
    public Task OnDownloadStatus(string state, long bytesTransferred, long? expectedBytes, string? failureCode)
    {
        _downloadState = state;
        _downloadBytes = Math.Max(0, bytesTransferred);
        _downloadExpectedBytes = expectedBytes;
        _downloadFailure = failureCode;
        if (state is "completed" or "failed" or "cancelled")
        {
            _activeDownloadId = null;
        }

        return InvokeAsync(StateHasChanged);
    }

    private async Task CopyPathAsync(string path)
    {
        try { await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", path); Snackbar.Add("Remote path copied to clipboard.", Severity.Success); }
        catch (Exception exception) { Snackbar.Add($"Failed to copy remote path: {exception.Message}", Severity.Error); }
    }

    private async Task<FileSystemListResponse> ListDirectoryAsync(string path)
    {
        if (!IsGatewayClient) return await FileSystemApi.ListDirectoryAsync(ClientIdentity, path);
        var response = await GatewayFileSystemApi.ListWithRecoveryAsync(TenantId!.Value, AgentId!.Value, path, async () =>
        {
            _gatewayReconnecting = true;
            await InvokeAsync(StateHasChanged);
        }, _directoryLifecycle.Token);
        _canWriteFiles = response.CanWriteFiles;
        _canCreateDirectory = response.CanCreateDirectory;
        _canDeleteDirectory = response.CanDeleteDirectory;
        return new FileSystemListResponse("akka-gateway", response.Path, "completed", null,
            response.Entries.Select(entry => new FileSystemEntryDto(response.Path, entry.Name, entry.FullPath, entry.IsDirectory, entry.SizeBytes)
            {
                CreatedUtc = entry.CreatedUtc,
                LastModifiedUtc = entry.LastModifiedUtc
            }).ToArray());
    }

    private static string FormatTimestamp(DateTimeOffset? timestamp) => timestamp?.UtcDateTime.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? "Not reported";

    private void ApplyFilter()
    {
        var filter = _filter.Trim();
        _filteredEntries = string.IsNullOrEmpty(filter) ? [.. _entries] : _entries.Where(entry => entry.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private static string GetFileType(string? fileName)
    {
        var fileNameStart = Math.Max(fileName?.LastIndexOf('/') ?? -1, fileName?.LastIndexOf('\\') ?? -1) + 1;
        var name = (fileName ?? string.Empty)[fileNameStart..];
        var extensionStart = name.LastIndexOf('.');
        return extensionStart <= 0 ? "File" : name[(extensionStart + 1)..].ToUpperInvariant();
    }

    private static string FormatBytes(long sizeBytes) => sizeBytes switch
    {
        < 0 => "Unknown",
        < 1024 => $"{sizeBytes} B",
        < 1024 * 1024 => $"{sizeBytes / 1024d:F1} KB",
        < 1024 * 1024 * 1024 => $"{sizeBytes / 1024d / 1024d:F1} MB",
        _ => $"{sizeBytes / 1024d / 1024d / 1024d:F1} GB"
    };

    private void Close() => MudDialog.Close();

    private Severity DownloadSeverity => _downloadState is "failed" ? Severity.Error : _downloadState is "cancelled" ? Severity.Warning : Severity.Info;
    private Color DownloadColor => _downloadState is "failed" or "cancelled" ? Color.Warning : Color.Primary;
    private double DownloadPercent => _downloadExpectedBytes is > 0 ? Math.Clamp(_downloadBytes * 100d / _downloadExpectedBytes.Value, 0, 100) : 0;
    private string DownloadDetail => _downloadState switch
    {
        "preparing" => "Preparing remote download…",
        "streaming" => _downloadExpectedBytes is > 0 ? $"Downloading {FormatBytes(_downloadBytes)} / {FormatBytes(_downloadExpectedBytes.Value)}" : $"Downloading {FormatBytes(_downloadBytes)}",
        "completed" => $"Download completed · {FormatBytes(_downloadBytes)}",
        "cancelled" => $"Download cancelled after {FormatBytes(_downloadBytes)}",
        _ => string.IsNullOrWhiteSpace(_downloadFailure) ? "Download failed" : $"Download failed: {_downloadFailure}"
    };

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _directoryLifecycle.Cancel();
        _directoryLifecycle.Dispose();
        _uploadCallbacks?.Dispose();
        _downloadCallbacks?.Dispose();
    }
}
