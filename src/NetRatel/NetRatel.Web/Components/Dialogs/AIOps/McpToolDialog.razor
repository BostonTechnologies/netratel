<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">AI Ops Tool</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>The AI Ops tool integration is not yet available via the API.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    private void Close() => MudDialog.Close();
}
