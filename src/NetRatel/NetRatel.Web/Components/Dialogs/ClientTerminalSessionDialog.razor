    };

  private bool MergeSessionMetadata(TerminalSessionDto latest)
  {
    if (_session is not null && !string.Equals(_session.SessionId, latest.SessionId, StringComparison.Ordinal))
    {
      return false;
    }

    ObserveGatewayTerminalAttachmentOwnership(latest);
    var changed = _session != latest;
    var previousLabel = _connectionLabel;
    var previousInputEnabled = _inputEnabled;
    var previousNotice = _terminalNotice;
    _session = latest;
    ApplySessionLifecycle(latest);
    return changed ||
           !string.Equals(previousLabel, _connectionLabel, StringComparison.Ordinal) ||
           previousInputEnabled != _inputEnabled ||
           !string.Equals(previousNotice, _terminalNotice, StringComparison.Ordinal);
  }

  private void ObserveGatewayTerminalAttachmentOwnership(TerminalSessionDto latest)
  {
    if (_session is not { } current ||
        current.Generation is not { } currentGeneration ||
        latest.Generation != currentGeneration ||
        string.IsNullOrWhiteSpace(current.AttachmentLeaseId) ||
        string.IsNullOrWhiteSpace(latest.AttachmentLeaseId) ||
        string.Equals(current.AttachmentLeaseId, latest.AttachmentLeaseId, StringComparison.Ordinal) ||
        !string.Equals(_attachmentHeartbeatSessionId, current.SessionId, StringComparison.Ordinal) ||
        _attachmentHeartbeatGeneration != currentGeneration ||
        !string.Equals(_attachmentHeartbeatLeaseId, current.AttachmentLeaseId, StringComparison.Ordinal))
    {
      return;
    }

    // A status GET may observe a newer owner after a hard reload or cloned-tab
    // handoff. It is evidence of lifecycle state, not permission for this old
    // circuit to claim the new fence back; the next browser callback stops.
    InvalidateGatewayTerminalAttachmentHeartbeat(
      current.SessionId,
      currentGeneration,
      current.AttachmentLeaseId);
  }

  private void ApplySessionLifecycle(TerminalSessionDto session)
  {
    if (IsSessionInputCapable(session))
    {
      ApplyConnectedState();
      return;
    }

    if (string.Equals(session.State, "failed", StringComparison.OrdinalIgnoreCase))
    {
      _connectionLabel = "failed";
      _inputEnabled = false;
      _terminalNotice = session.FailureCode ?? session.CloseReason ?? "Terminal open failed.";
      return;
    }

    if (string.Equals(session.State, "closed", StringComparison.OrdinalIgnoreCase))
    {
      _connectionLabel = "closed";
      _inputEnabled = false;
      return;
    }

    if (IsRecoverableTerminalTransportSignal(session.State))
    {
      MarkTransportReconnecting();
      return;
    }

    _inputEnabled = false;
    _connectionLabel = "connecting";
    _terminalNotice = "Terminal is opening.";
  }

  private void MarkTransportReconnecting()
  {
    if (IsTerminalFinalState())
    {
      return;
    }

    _inputEnabled = false;
    _connectionLabel = "reconnecting";
    _terminalNotice = "Terminal transport is reconnecting; input will resume automatically.";
  }

  private bool IsTerminalFinalState() =>
    _session is not null && IsTerminalFinalState(_session);

  private static bool IsTerminalFinalState(TerminalSessionDto session) =>
    string.Equals(session.State, "closed", StringComparison.OrdinalIgnoreCase) ||
    string.Equals(session.State, "failed", StringComparison.OrdinalIgnoreCase);

  private static bool IsRecoverableTerminalTransportSignal(string? value) =>
    !string.IsNullOrWhiteSpace(value) &&
    (value.Contains("terminal_transport_reconnecting", StringComparison.OrdinalIgnoreCase) ||
     value.Contains("terminal_transport_unavailable", StringComparison.OrdinalIgnoreCase) ||
     value.Contains("terminal-stream-connected:akka-gateway:suspended", StringComparison.OrdinalIgnoreCase) ||
     value.Contains("terminal-stream-connected:akka-gateway:reconnecting", StringComparison.OrdinalIgnoreCase) ||
     string.Equals(value, "suspended", StringComparison.OrdinalIgnoreCase) ||
     string.Equals(value, "reconnecting", StringComparison.OrdinalIgnoreCase));

  private void ApplyConnectedState()
  {
    _connectionLabel = "connected";
    _inputEnabled = true;
    if (!_hasReceivedOutput)
    {
      _terminalNotice = "Terminal is open; waiting for shell output.";
    }
  }

  private static bool IsSessionInputCapable(TerminalSessionDto? session) =>
    session is not null &&
    (string.Equals(session.State, "active", StringComparison.OrdinalIgnoreCase) ||
     string.Equals(session.State, "opened", StringComparison.OrdinalIgnoreCase) ||
     string.Equals(session.State, "open", StringComparison.OrdinalIgnoreCase));

  private bool IsExplicitCloseRequested => _closedByUser || _dialogCloseRequested;
  private bool IsCloseRequested => _disposed || IsExplicitCloseRequested;

  private async Task CloseOpenedSessionAfterDialogCloseAsync(string sessionId)
  {
    using var closeCts = new CancellationTokenSource(CloseCleanupTimeout);
    try
    {
      await Term.CloseAsync(sessionId, "Terminal dialog closed before opening completed.", closeCts.Token);
      // Do not discard recovery state before the server has accepted the close.
      // If this late-open cleanup races a recoverable outage, the persisted V2
      // handle remains available for the next dialog to reconcile it.
      await RemoveGatewayTerminalHandleAsync(sessionId, closeCts.Token);
    }
    catch (OperationCanceledException) when (closeCts.IsCancellationRequested)
    {
      Logger.LogDebug("[Terminal] Late-open terminal cleanup reached its deadline.");
    }
    catch (Exception)
    {
      Logger.LogDebug("[Terminal] Late-open terminal cleanup did not complete.");
    }
  }

  public async ValueTask DisposeAsync()
  {
    if (_disposed)
    {
      return;
    }

    _disposed = true;
    if (IsExplicitCloseRequested || !HasGatewayTerminalContext)
    {
      await CloseResourcesAndSessionAsync("Terminal dialog disposed.");
    }
    else
    {
      // A circuit replacement/hard reload should detach browser resources but
      // preserve the non-secret V2 handle for the next dialog to reattach.
      await DisposeResourcesWithoutClosingSessionAsync();
    }
  }

  private Task CloseResourcesAndSessionAsync(string reason)
    => CloseResourcesAsync(reason, closeSession: true);

  private Task DisposeResourcesWithoutClosingSessionAsync()
    => CloseResourcesAsync("Terminal dialog disposed after browser detach.", closeSession: false);

  private Task CloseResourcesAsync(string reason, bool closeSession)
  {
    lock (_closeResourcesSync)
    {
      return _closeResourcesTask ??= CloseResourcesAndSessionCoreAsync(reason, closeSession);
    }
  }

  private async Task CloseResourcesAndSessionCoreAsync(string reason, bool closeSession)
  {
    using var cleanupCts = new CancellationTokenSource(CloseCleanupTimeout);
    var cleanupCt = cleanupCts.Token;
    try
    {
      ++_sessionObservationVersion;
      _attachmentHeartbeatLifecycleCts.Cancel();
      await StopGatewayTerminalAttachmentHeartbeatAsync(cleanupCt);
      if (closeSession)
      {
        await CloseSessionIfActiveAsync(reason, cleanupCt);
      }

      await DisposeStreamAsync(cleanupCt);
      _attachmentHeartbeatReference?.Dispose();
      _attachmentHeartbeatReference = null;
      if (_attachmentHeartbeatModule is not null)
      {
        await _attachmentHeartbeatModule.DisposeAsync().AsTask().WaitAsync(cleanupCt);
        _attachmentHeartbeatModule = null;
      }
      if (_viewportModule is not null)
      {
        await _viewportModule.DisposeAsync().AsTask().WaitAsync(cleanupCt);
        _viewportModule = null;
      }
      if (_authoritySubscription is not null)
      {
        await _authoritySubscription.DisposeAsync().AsTask().WaitAsync(cleanupCt);
        _authoritySubscription = null;
      }
    }
    catch (OperationCanceledException) when (cleanupCt.IsCancellationRequested)
    {
      Logger.LogDebug("[Terminal] Terminal dialog cleanup timed out.");
    }
    catch (Exception)
    {
      Logger.LogDebug("[Terminal] Terminal dialog cleanup did not complete.");
    }
  }
}
