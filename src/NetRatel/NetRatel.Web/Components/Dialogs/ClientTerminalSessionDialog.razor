  private Task CloseAndExitAsync() => RequestDialogCloseAsync("User closed terminal dialog.");

  private async Task RequestDialogCloseAsync(string reason)
  {
    if (_dialogCloseRequested)
    {
      return;
    }

    _dialogCloseRequested = true;
    _closedByUser = true;
    _connectionLabel = "closing";
    _inputEnabled = false;
    await InvokeAsync(StateHasChanged);

    await CloseResourcesAndSessionAsync(reason);
    if (!_disposed)
    {
      MudDialog.Close(DialogResult.Ok(true));
    }
  }

  private async Task FitTerminalAsync()
  {
    if (_console is null)
    {
      return;
    }

    await _console.FitAsync();
    await RefreshSessionMetadataAsync();
  }

  private async Task ToggleFullscreenAsync() => await SetFullscreenAsync(!_isFullscreen);

  private async Task SetFullscreenAsync(bool fullscreen)
  {
    _isFullscreen = fullscreen;
    await MudDialog.SetOptionsAsync(MudDialog.Options with
    {
      FullScreen = fullscreen,
      FullWidth = true,
      MaxWidth = fullscreen ? MaxWidth.False : MaxWidth.ExtraExtraLarge
    });
    await Task.Yield();
    if (_console is not null)
    {
      await _console.FitAsync();
    }
  }

  private Task ClearTerminalAsync() =>
    _console?.ClearAsync() ?? Task.CompletedTask;

  private async Task PumpTerminalStreamAsync(CancellationToken ct)
  {
    var sessionId = _session?.SessionId;
    if (string.IsNullOrWhiteSpace(sessionId))
    {
      return;
    }

    var observationVersion = _sessionObservationVersion;
    while (!ct.IsCancellationRequested && IsObservedSession(sessionId, observationVersion))
    {
      var reconnect = false;
      try
      {
        await foreach (var message in Term.StreamSessionAsync(sessionId, ct))
        {
          if (ct.IsCancellationRequested || !IsObservedSession(sessionId, observationVersion))
          {
            return;
          }

          if (message.Kind.Equals("status", StringComparison.OrdinalIgnoreCase))
          {
            _terminalNotice = message.Reason;
            if (IsRecoverableTerminalTransportSignal(message.Reason))
            {
              MarkTransportReconnecting();
            }

            await InvokeAsync(StateHasChanged);
            continue;
          }

          if (message.Kind.Equals("error", StringComparison.OrdinalIgnoreCase))
          {
            _inputEnabled = false;
            QueueSessionReconciliation();
            break;
          }

          if (message.Kind.Equals("data", StringComparison.OrdinalIgnoreCase) ||
              (!message.Kind.Equals("close", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(message.Data)))
          {
            var shouldRefresh = false;
            if (string.Equals(message.Kind, "data", StringComparison.OrdinalIgnoreCase))
            {
              _hasReceivedOutput = true;
            }

            // Output can be buffered before the session GET observes a transport
            // suspension. Do not treat it as authority to resume stdin: only a
            // server-reported active/opened session may do that.
            if (IsSessionInputCapable(_session))
            {
              if (!_inputEnabled || !string.Equals(_connectionLabel, "connected", StringComparison.OrdinalIgnoreCase))
              {
                ApplyConnectedState();
                shouldRefresh = true;
              }

              if (!string.IsNullOrWhiteSpace(_terminalNotice))
              {
                _terminalNotice = null;
                shouldRefresh = true;
              }
            }

            if (shouldRefresh)
            {
              await InvokeAsync(StateHasChanged);
            }

            if (_console is not null)
            {
              await _console.AppendOutputAsync(message.Data ?? string.Empty);
            }

            continue;
          }

          if (message.Kind.Equals("close", StringComparison.OrdinalIgnoreCase))
          {
            _inputEnabled = false;
            QueueSessionReconciliation();
            return;
          }
        }

        reconnect = !IsTerminalFinalState();
      }
      catch (OperationCanceledException) when (ct.IsCancellationRequested)
      {
        return;
      }
      catch (Exception)
      {
        reconnect = true;
      }

      if (!reconnect || !IsObservedSession(sessionId, observationVersion) || IsTerminalFinalState())
      {
        return;
      }

      MarkTransportReconnecting();
      QueueSessionReconciliation();
      await InvokeAsync(StateHasChanged);
      await Task.Delay(StreamReconnectDelay, ct);
    }
  }

  private Task HandleConsoleReadyAsync() => Task.CompletedTask;

  private Task HandleInputChannelStatusChangedAsync(TerminalInputChannelStatus status)
  {
    _inputChannelState = status.State;
    _inputChannelLabel = status.State switch
    {
      "not-started" => "stdin not-started",
      "opening" => "stdin opening",
      "connected" => "stdin connected",
      "sending" => "stdin sending",
      "reconnecting" => "stdin reconnecting",
      "rest-fallback" => "stdin rest-fallback",
      "failed" => "stdin failed",
      "closed" => "stdin closed",
      _ => $"stdin {status.State}"
    };

    if (string.Equals(status.State, "reconnecting", StringComparison.OrdinalIgnoreCase))
    {
      MarkTransportReconnecting();
      QueueSessionReconciliation();
    }
    else if (string.Equals(status.State, "connected", StringComparison.OrdinalIgnoreCase) &&
             IsSessionInputCapable(_session))
    {
      ApplyConnectedState();
    }
    else if (string.Equals(status.State, "closed", StringComparison.OrdinalIgnoreCase))
    {
      _inputEnabled = false;
      QueueSessionReconciliation();
    }
    else if (string.Equals(status.State, "failed", StringComparison.OrdinalIgnoreCase))
    {
      _inputEnabled = false;
      QueueSessionReconciliation();
      _terminalNotice = string.IsNullOrWhiteSpace(status.Detail)
        ? "Terminal input channel failed."
        : $"Terminal input channel failed: {status.Detail}";
    }
    else if (string.Equals(status.State, "rest-fallback", StringComparison.OrdinalIgnoreCase))
    {
      _terminalNotice = "Terminal input websocket unavailable; using REST stdin fallback.";
    }

    return InvokeAsync(StateHasChanged);
  }

  private Task HandleConsoleStatusChangedAsync(TerminalConsole.TerminalConsoleStatus status)
  {
    if (string.Equals(status.State, "stdin-error", StringComparison.OrdinalIgnoreCase))
    {
      _inputEnabled = false;
      QueueSessionReconciliation();
    }

    if (!string.IsNullOrWhiteSpace(status.Detail))
    {
      _terminalNotice = $"Terminal render {status.State}: {status.Detail}";
      if (status.State.Contains("error", StringComparison.OrdinalIgnoreCase))
      {
        _connectionLabel = "failed";
      }
    }

    return InvokeAsync(StateHasChanged);
  }

  private async Task HandleConsoleResizedAsync(TerminalConsole.TerminalGridSize size)
  {
    _measuredGrid = size;
    if (_session is null && !_openStarted)
    {
      _openStarted = true;
      await OpenAndStartAsync();
    }

    await InvokeAsync(StateHasChanged);
  }

  private Task RefreshSessionMetadataAsync()
  {
    QueueSessionReconciliation();
    return Task.CompletedTask;
  }

  private async Task PollSessionStatusAsync(CancellationToken ct)
  {
    var sessionId = _session?.SessionId;
    var observationVersion = _sessionObservationVersion;
    try
    {
      using var timer = new PeriodicTimer(LifecyclePollInterval);
      while (await timer.WaitForNextTickAsync(ct) && IsObservedSession(sessionId, observationVersion))
      {
        QueueSessionReconciliation();
      }
    }
    catch (OperationCanceledException) when (ct.IsCancellationRequested)
    {
      Logger.LogDebug("[Terminal] Session observation stopped.");
    }
  }

  private Task HandleClosedAsync(string? reason)
  {
    if (!string.IsNullOrWhiteSpace(reason))
    {
      Snack.Add(reason, Severity.Info);
    }

    return Task.CompletedTask;
  }

  private async Task CloseSessionIfActiveAsync(string reason, CancellationToken ct)
  {
    if (_isClosing || _session is null)
    {
      return;
    }

    if (IsTerminalFinalState(_session))
    {
      await RemoveGatewayTerminalHandleAsync(_session.SessionId, ct);
      return;
    }

    _isClosing = true;
    try
    {
      await StopGatewayTerminalAttachmentHeartbeatAsync(ct);
      await Term.CloseAsync(_session.SessionId, reason, ct);
      _session = _session with { State = "closed", CloseReason = reason };
      _inputEnabled = false;
      _connectionLabel = "closed";
      // A successful close response is the server's durable acceptance of the
      // close request. Keep the persisted handle until that point so a transient
      // route/transport failure leaves a subsequent dialog able to reattach and
      // retry the close instead of orphaning a live terminal session.
      await RemoveGatewayTerminalHandleAsync(_session.SessionId, ct);
    }
    catch (OperationCanceledException) when (ct.IsCancellationRequested)
    {
      _isClosing = false;
    }
    catch (Exception ex)
    {
      if (!_closedByUser && !_disposed)
      {
        Snack.Add($"Failed to close terminal session: {ex.Message}", Severity.Warning);
      }
      _isClosing = false;
    }
  }

  private async Task DisposeStreamAsync(CancellationToken cleanupCt)
  {
    // Detach ownership before awaiting: Close and replacement may both enter
    // cleanup, and neither may dispose a successor's observers.
    var statusCts = _statusCts;
    var statusTask = _statusTask;
    var streamCts = _streamCts;
    var streamTask = _streamTask;
    _statusCts = null;
    _statusTask = null;
    _streamCts = null;
    _streamTask = null;
    statusCts?.Cancel();
    streamCts?.Cancel();
    try
    {
      await Task.WhenAll(statusTask ?? Task.CompletedTask, streamTask ?? Task.CompletedTask).WaitAsync(cleanupCt);
    }
    catch (OperationCanceledException)
    {
      Logger.LogDebug("[Terminal] Session observers stopped or reached their cleanup deadline.");
    }
    finally
    {
      statusCts?.Dispose();
      streamCts?.Dispose();
    }
  }

