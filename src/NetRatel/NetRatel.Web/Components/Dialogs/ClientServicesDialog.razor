@using NetRatel.Shared.Contracts.Services
@using NetRatel.Web.Services.Services
@implements IAsyncDisposable
@inject IClientServicesApiService ServicesApi
@inject IClientServicesLiveStreamService LiveServices

@{
    RenderFragment content = @<div class="client-services-shell">
        <header class="client-services-header">
            <div class="client-services-identity">
                <h1>Services</h1>
                <p title="@HostLabel">@HostLabel</p>
                <p title="@($"{TenantLabel} · Tenant {TenantId} · {ConnectionLabel}")">@TenantLabel · Tenant @TenantId · @ConnectionLabel</p>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" aria-label="Close services" data-testid="close-services" />
        </header>
        <div class="client-services-body">
        <section class="client-services-summary" aria-live="polite" data-testid="services-summary">
            @if (DisplayedInventory is { } inventory)
            {
                <span><strong>@(inventory.Status == ServiceCollectionStatus.Partial ? "Partial inventory" : _model!.Connected ? "Last complete inventory" : "Cached offline inventory")</strong> · @Age(inventory.ObservedAtUtc) · <time datetime="@inventory.ObservedAtUtc.ToString("O")">@inventory.ObservedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</time></span>
                @if (IsStale(inventory.ObservedAtUtc)) { <span class="services-stale">Stale inventory</span> }
                @if (inventory.Status == ServiceCollectionStatus.Partial) { <span>@ClientServicesPresentation.Reason(inventory.ErrorCode) Omitted services are not proven missing.</span> }
            }
            else { <span>No complete inventory received.</span> }
            <span data-testid="services-live-state">Update connection: @_streamState</span>
        </section>
        <section class="client-services-controls" aria-label="Services controls">
            <label class="client-services-search">Search services
                <input type="search" @bind="_search" @bind:event="oninput" placeholder="Name or display name" aria-label="Search services" data-testid="services-search" />
            </label>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync"
                       Disabled="@(!CanRefresh)" data-testid="services-refresh">@(_refreshing ? "Requesting…" : _refreshWait is not null ? "Waiting…" : "Refresh")</MudButton>
            <div class="client-services-filters" aria-label="Service state filters">
                @foreach (var filter in Filters)
                {
                    var selectedFilter = filter;
                    <button type="button" @onclick="@(() => _filter = selectedFilter)" aria-pressed="@(_filter == filter ? "true" : "false")" data-testid="@($"services-filter-{filter.ToLowerInvariant()}")">@filter</button>
                }
            </div>
        </section>
        <section class="client-services-scroll" aria-label="Services inventory" data-testid="services-inventory">
            @if (_pendingControl is { } pending)
            {
                <section class="service-control-confirm" aria-label="Confirm service operation" data-testid="service-control-confirm">
                    <strong>@pending.Action @pending.Service.Name on @HostLabel</strong>
                    <label>Reason (optional)<input type="text" @bind="_controlReason" maxlength="256" aria-label="Service operation reason" /></label>
                    <div class="service-control-buttons">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="ConfirmControlAsync" Disabled="@(!CanControl)" data-testid="service-control-confirm-button">Confirm @pending.Action.ToString().ToLowerInvariant()</MudButton>
                        <MudButton Size="Size.Small" OnClick="@(() => _pendingControl = null)" data-testid="service-control-cancel">Cancel</MudButton>
                    </div>
                </section>
            }
            @if (_controlMessage is not null)
            {
                <MudAlert Severity="@(_operation?.Status == "Completed" ? Severity.Success : Severity.Info)" Dense="true" data-testid="service-control-result">
                    @_controlMessage
                    @if (_operationId is { } operationId) { <small class="service-operation-id">Operation @operationId.ToString("D")</small> }
                </MudAlert>
            }
            @if (_model is { CanControlServices: true, Connected: true, SupportsServiceControl: false })
            {
                <p class="services-notice" data-testid="service-control-unsupported">Service controls are unavailable for this client. Windows and systemd clients need an agent that advertises service control.</p>
            }
            @if (_loading) { <MudProgressLinear Indeterminate="true" aria-label="Loading services" /> }
            @if (_error is not null) { <MudAlert Severity="Severity.Warning" Dense="true" data-testid="services-error">@_error</MudAlert> }
            @if (_refreshMessage is not null) { <MudAlert Severity="Severity.Info" Dense="true" data-testid="services-refresh-result">@_refreshMessage</MudAlert> }
            @if (_model is { Connected: true, SupportsServices: false })
            {
                <MudAlert Severity="Severity.Info" Dense="true" data-testid="services-unsupported">Services collection is unsupported by this client. A client upgrade may be required. @RetainedInventoryMessage</MudAlert>
            }
            @if (ClientServicesRefreshWait.InventoryAttempt(_model) is { Status: ServiceCollectionStatus.Error or ServiceCollectionStatus.Partial or ServiceCollectionStatus.Unsupported } attempt)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" data-testid="services-attempt">Latest inventory collection: @(attempt.Status == ServiceCollectionStatus.Partial && !attempt.IsFinal ? "In progress or interrupted" : attempt.Status.ToString()) · @Age(attempt.ObservedAtUtc). @ClientServicesPresentation.Reason(attempt.ErrorCode) @RetainedInventoryMessage This attempt does not prove a service is missing.</MudAlert>
            }
            @if (_model is { Connected: false })
            {
                <MudText Typo="Typo.body2" Class="services-notice" data-testid="services-offline">Client is offline. Refresh is unavailable; cached states describe their observation time.</MudText>
            }
            @if (!_loading && _model is not null && Rows.Count == 0)
            {
                <p data-testid="services-empty">@(DisplayedInventory is not null ? "The displayed inventory contains no services." : "No service inventory is available yet.")</p>
            }
            else if (!_loading && FilteredRows.Count == 0 && Rows.Count != 0)
            {
                <p data-testid="services-filter-empty">No services match these filters.</p>
            }
            @if (FilteredRows.Count > 0)
            {
                <p class="client-services-count">@FilteredRows.Count of @Rows.Count services · Monitoring watches only explicitly selected names.</p>
                <table class="client-services-table">
                    <caption class="services-visually-hidden">Service inventory, selected watch evidence and authorized service controls</caption>
                    <thead><tr><th scope="col">Service</th><th scope="col">State</th><th scope="col">Monitoring / observation</th><th scope="col">Platform details</th></tr></thead>
                    <tbody>
                        @foreach (var row in FilteredRows)
                        {
                            <tr data-testid="service-row" data-service-name="@row.Observation.Name">
                                <td data-label="Service"><strong>@row.Observation.DisplayName</strong><code>@row.Observation.Name</code>
                                    @if (_model?.CanControlServices == true)
                                    {
                                        <div class="service-control-buttons">
                                            @foreach (var action in ServiceActions)
                                            {
                                                var selectedAction = action;
                                                var service = row.Observation;
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="@(action == ClientServiceControlAction.Stop ? Color.Warning : Color.Primary)"
                                                           Disabled="@(!CanControlService(service))" OnClick="@(() => BeginControl(service, selectedAction))"
                                                           aria-label="@($"{action} service {service.Name}")" data-service-action="@action.ToString().ToLowerInvariant()">@action</MudButton>
                                            }
                                        </div>
                                    }
                                </td>
                                <td data-label="State"><span class="service-state" data-state="@row.Observation.State">@row.Observation.State</span></td>
                                <td data-label="Monitoring / observation"><span>@(row.Monitored ? "Monitored" : "Not monitored") · @row.Evidence</span>
                                    @if (row.HasObservation)
                                    { <time datetime="@row.Observation.ObservedAtUtc.ToString("O")">@Age(row.Observation.ObservedAtUtc)@(IsStale(row.Observation.ObservedAtUtc, row.FromWatch) ? " · Stale" : "")</time> }
                                    else { <small>No watch evidence yet</small> }
                                </td>
                                <td data-label="Platform details"><span>@row.Observation.Platform · @row.Observation.RawState</span>
                                    @if (row.Observation.Platform == ClientServicePlatform.LinuxSystemd)
                                    { <small>Load: @Value(row.Observation.LoadState) · Active: @Value(row.Observation.ActiveState) · Sub: @Value(row.Observation.SubState) · Enablement: @Value(row.Observation.UnitFileState)</small> }
                                    else if (row.Observation.Platform == ClientServicePlatform.Windows)
                                    { <small>Start mode: @Value(row.Observation.StartMode)</small> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
        </div>
    </div>;
}

@if (Embedded)
{
    <section class="client-services-embedded" data-testid="client-services-dialog">@content</section>
}
else
{
    <MudDialog Class="client-services-dialog" data-testid="client-services-dialog"><DialogContent>@content</DialogContent></MudDialog>
}

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter, EditorRequired] public int TenantId { get; set; }
    [Parameter, EditorRequired] public Guid AgentId { get; set; }
    [Parameter] public string HostLabel { get; set; } = "Client";
    [Parameter] public string TenantLabel { get; set; } = "";
    [Parameter] public bool Embedded { get; set; }

    private static readonly string[] Filters = ["All", "Running", "Stopped", "Failed", "Monitored"];
    private ClientServicesReadModelDto? _model;
    private CancellationTokenSource? _runCancellation;
    private Task? _liveTask;
    private Task? _ageTask;
    private Task? _controlTask;
    private int _activeTenant;
    private Guid _activeAgent;
    private long _generation;
    private bool _disposed;
    private bool _loading = true;
    private bool _refreshing;
    private string _search = "";
    private string _filter = "All";
    private string _streamState = "Connecting";
    private string? _error;
    private string? _refreshMessage;
    private ClientServicesRefreshWait? _refreshWait;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private static readonly ClientServiceControlAction[] ServiceActions = [ClientServiceControlAction.Start, ClientServiceControlAction.Stop, ClientServiceControlAction.Restart];
    private (ClientServiceObservation Service, ClientServiceControlAction Action)? _pendingControl;
    private string? _controlReason;
    private string? _controlMessage;
    private Guid? _operationId;
    private ClientServiceOperationDto? _operation;
    private bool _controlling;

    private string ConnectionLabel => _model is null ? "Loading" : _model.Connected ? "Online" : "Offline";
    private bool CanRefresh => !_loading && !_refreshing && _refreshWait is null && _model is { Connected: true, SupportsServices: true };
    private bool CanControl => !_loading && !_controlling && _model is { Connected: true, SupportsServiceControl: true, CanControlServices: true };
    private ClientServicesSnapshotDto? DisplayedInventory => _model?.LastCompleteInventory ?? _model?.LastPartialInventory;
    private string RetainedInventoryMessage => _model?.LastCompleteInventory is not null ? "Last complete inventory is retained." :
        _model?.LastPartialInventory is not null ? "Available partial inventory is retained." : "";

    protected override async Task OnParametersSetAsync()
    {
        if (_disposed || (_runCancellation is not null && TenantId == _activeTenant && AgentId == _activeAgent)) return;
        _runCancellation?.Cancel();
        _runCancellation?.Dispose();
        _runCancellation = new CancellationTokenSource();
        var token = _runCancellation.Token;
        var generation = ++_generation;
        _activeTenant = TenantId;
        _activeAgent = AgentId;
        _loading = true;
        _model = null;
        _error = null;
        _refreshMessage = null;
        _refreshing = false;
        _refreshWait = null;
        _search = "";
        _filter = "All";
        _streamState = "Connecting";
        _pendingControl = null;
        _operation = null;
        _operationId = null;
        _controlMessage = null;
        _controlling = false;
        try
        {
            var model = await ServicesApi.GetAsync(_activeTenant, _activeAgent, token);
            if (!IsCurrent(generation)) return;
            Apply(model);
            if (model is null) _error = "Services are unavailable for this client.";
            else _liveTask = ReadLiveAsync(_activeTenant, _activeAgent, generation, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            if (IsCurrent(generation)) _error = "Could not load services. Access may have changed, or the API is unavailable.";
        }
        finally
        {
            if (IsCurrent(generation))
            {
                _loading = false;
                _ageTask = UpdateAgeAsync(generation, token);
                // Render cached rows before awaiting admission; once per tenant/client opening.
                StateHasChanged();
                if (CanRefresh) _ = RefreshAsync();
            }
        }
    }

    private async Task ReadLiveAsync(int tenantId, Guid agentId, long generation, CancellationToken token)
    {
        try
        {
            await foreach (var item in LiveServices.SubscribeAsync(tenantId, agentId, token))
            {
                if (!IsCurrent(generation)) return;
                await InvokeAsync(() =>
                {
                    if (!IsCurrent(generation)) return;
                    _streamState = item.State;
                    if (item.Snapshot is { } model && model.TenantId == tenantId && model.AgentId == agentId) Apply(model);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or IOException or System.Text.Json.JsonException)
        {
            if (IsCurrent(generation)) await InvokeAsync(() => { _streamState = "Unavailable"; StateHasChanged(); });
        }
    }

    private void Apply(ClientServicesReadModelDto? model)
    {
        if (model is not null && (model.TenantId != _activeTenant || model.AgentId != _activeAgent)) return;
        if (_model is not null && model is not null && (model.Revision < _model.Revision ||
            (model.Revision == _model.Revision && model.GeneratedAtUtc < _model.GeneratedAtUtc))) return;
        _model = model;
        _now = DateTimeOffset.UtcNow;
        CheckRefreshOutcome();
    }

    private void CheckRefreshOutcome()
    {
        if (_refreshWait?.Outcome(_model, _now) is { } outcome)
        {
            _refreshWait = null;
            _refreshMessage = outcome;
        }
    }

    private bool CanControlService(ClientServiceObservation service) => CanControl &&
        service.Platform is ClientServicePlatform.Windows or ClientServicePlatform.LinuxSystemd &&
        service.State is not (ClientServiceState.Missing or ClientServiceState.Unsupported) &&
        !ClientServiceControlRules.IsProtectedService(service.Name);

    private void BeginControl(ClientServiceObservation service, ClientServiceControlAction action)
    {
        if (!CanControlService(service)) return;
        _pendingControl = (service, action);
        _controlReason = null;
    }

    private async Task ConfirmControlAsync()
    {
        if (!CanControl || _pendingControl is not { } pending || _runCancellation is null) return;
        var generation = _generation;
        var token = _runCancellation.Token;
        var operationId = Guid.NewGuid();
        _operationId = operationId;
        _operation = null;
        _pendingControl = null;
        _controlling = true;
        _controlMessage = $"Requesting {pending.Action.ToString().ToLowerInvariant()} for {pending.Service.Name}…";
        try
        {
            var response = await ServicesApi.ControlAsync(_activeTenant, _activeAgent,
                new(operationId, pending.Service.Name, pending.Service.Platform, pending.Action, _controlReason), token);
            if (!IsCurrent(generation)) return;
            ApplyOperation(response, operationId);
            if (_controlling) _controlTask = TrackOperationAsync(operationId, generation, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (ClientServiceControlApiException error)
        {
            if (IsCurrent(generation)) { _controlling = false; _controlMessage = ControlFailure(error.Code); }
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            if (IsCurrent(generation))
            {
                _controlMessage = "The request response was interrupted. Checking the saved operation before allowing another action.";
                _controlTask = TrackOperationAsync(operationId, generation, token);
            }
        }
        finally { if (IsCurrent(generation)) StateHasChanged(); }
    }

    private async Task TrackOperationAsync(Guid operationId, long generation, CancellationToken token)
    {
        var deadline = DateTimeOffset.UtcNow.AddMinutes(3);
        var notFoundDeadline = DateTimeOffset.UtcNow.AddSeconds(30);
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (IsCurrent(generation) && _controlling && await timer.WaitForNextTickAsync(token))
            {
                try
                {
                    var operation = await ServicesApi.GetOperationAsync(_activeTenant, _activeAgent, operationId, token);
                    if (!IsCurrent(generation)) return;
                    ApplyOperation(operation, operationId);
                    if (!_controlling && operation.Status == "Completed" && CanRefresh) await RefreshAsync();
                }
                catch (HttpRequestException error) when (error.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
                {
                    if (!IsCurrent(generation)) return;
                    _controlling = false;
                    _controlMessage = "Access to this operation has changed. Its saved execution continues independently of this dialog.";
                    if (_model is not null) _model = _model with { CanControlServices = false };
                }
                catch (HttpRequestException error) when (error.StatusCode == System.Net.HttpStatusCode.NotFound && DateTimeOffset.UtcNow >= notFoundDeadline)
                {
                    if (!IsCurrent(generation)) return;
                    _controlling = false;
                    _controlMessage = "No saved operation was found for this request. You can request the action again.";
                }
                catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
                {
                    if (IsCurrent(generation)) _controlMessage = _operation is null
                        ? "Checking whether the service operation was saved. Its request is not replayed."
                        : "The operation is saved, but its current result is unavailable. Reconnecting to check its outcome.";
                }
                if (!IsCurrent(generation)) return;
                if (_controlling && DateTimeOffset.UtcNow >= deadline)
                {
                    _controlling = false;
                    _controlMessage = "The service operation outcome is unconfirmed. Refresh the inventory before requesting another action; the original request is not replayed.";
                }
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private void ApplyOperation(ClientServiceOperationDto operation, Guid operationId)
    {
        if (operation.OperationId != operationId || operation.TenantId != _activeTenant || operation.AgentId != _activeAgent) return;
        _operation = operation;
        _controlling = !ClientServiceControlRules.IsTerminal(operation.Status) && operation.Status != "OutcomeUnknown";
        _controlMessage = operation.Status switch
        {
            "Completed" => $"{operation.Action} completed for {operation.ServiceName}. Verified state: {operation.Result?.State}.",
            "Failed" or "Cancelled" => $"{operation.Action} for {operation.ServiceName}: {ControlFailure(operation.FailureCode)}",
            "OutcomeUnknown" => $"The outcome for {operation.ServiceName} is unconfirmed. Refresh its state before requesting another action.",
            _ => $"{operation.Action} for {operation.ServiceName}: {operation.Status.ToLowerInvariant()}…"
        };
    }

    private static string ControlFailure(string? code) => code switch
    {
        "client_offline" => "The client is offline. No action was dispatched.",
        "service_control_unsupported" => "This client needs an upgrade before it can control services.",
        "agent_service_protected" => "Use client offboarding to remove the NetRatel service.",
        "service_operation_in_progress" or "service_controller_busy" => "Another service operation is in progress. Wait for its result.",
        "service_not_in_inventory" or "service_identity_unavailable" => "Refresh the inventory to confirm the exact service identity.",
        "service_access_denied" => "The installed client does not have permission to control this service.",
        "service_disabled" => "The service is disabled in the operating system.",
        "service_has_running_dependents" => "The service has running dependents. No dependent services were stopped automatically.",
        "service_operation_timeout" or "service_result_unconfirmed" => "The final state is unconfirmed. Refresh before retrying.",
        "service_not_found" => "The service no longer exists on this client.",
        "service_operation_expired" => "The request expired before service control began.",
        _ => "The service operation did not complete. Refresh its state and review the operation audit."
    };

    private async Task UpdateAgeAsync(long generation, CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(token))
                await InvokeAsync(() => { if (IsCurrent(generation)) { _now = DateTimeOffset.UtcNow; CheckRefreshOutcome(); StateHasChanged(); } });
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task RefreshAsync()
    {
        if (!CanRefresh || _runCancellation is null) return;
        var generation = _generation;
        var token = _runCancellation.Token;
        _refreshing = true;
        _refreshMessage = null;
        var baseline = _model;
        var startedAt = DateTimeOffset.UtcNow;
        _refreshWait = null;
        try
        {
            var response = await ServicesApi.RefreshAsync(_activeTenant, _activeAgent, token);
            if (!IsCurrent(generation)) return;
            _refreshMessage = response.Status switch
            {
                ClientServicesRefreshStatus.Requested => response.CorrelationSupported
                    ? $"Refresh {response.RequestId:D} requested. Waiting for its recorded inventory outcome."
                    : "Refresh requested. Waiting for a subsequent inventory outcome. This client cannot attribute it to the request.",
                ClientServicesRefreshStatus.Offline => "The client is offline. No refresh was requested.",
                ClientServicesRefreshStatus.Unsupported => "This client does not support services collection. No refresh was requested.",
                ClientServicesRefreshStatus.Throttled => response.CorrelationSupported && response.RequestId is { } pendingId
                    ? $"Refresh {pendingId:D} is already tracked. Waiting for its recorded outcome."
                    : response.RetryAfterUtc is { } retry
                        ? $"A refresh was requested recently. Waiting for a subsequent inventory outcome. Try again after {retry.ToUniversalTime():HH:mm:ss} UTC."
                        : "A refresh was requested recently. Try again shortly.",
                _ => "The refresh result is unavailable."
            };
            _refreshWait = response.Status == ClientServicesRefreshStatus.Requested ||
                response.Status == ClientServicesRefreshStatus.Throttled && response.RequestId is not null
                    ? new ClientServicesRefreshWait(baseline, startedAt, response.RequestId, response.CorrelationSupported) : null;
            _now = DateTimeOffset.UtcNow;
            CheckRefreshOutcome();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        { if (IsCurrent(generation)) { _refreshWait = null; _refreshMessage = "Refresh admission could not be confirmed. Available observations remain visible."; } }
        finally { if (IsCurrent(generation)) { _refreshing = false; StateHasChanged(); } }
    }

    private IReadOnlyList<ServiceRow> Rows
    {
        get
        {
            if (_model is null) return [];
            bool IsMonitored(ClientServiceObservation service) => _model.MonitoredServiceNames.Contains(service.Name,
                service.Platform == ClientServicePlatform.Windows ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal);
            var rows = (DisplayedInventory?.Services ?? []).ToDictionary(ServiceIdentity,
                service => new ServiceRow(service, IsMonitored(service), false,
                    DisplayedInventory?.Status == ServiceCollectionStatus.Partial ? "Partial inventory" : "Inventory"), StringComparer.Ordinal);
            foreach (var observation in _model.WatchedServices)
                rows[ServiceIdentity(observation)] = new ServiceRow(observation, IsMonitored(observation), true, "Selected watch");
            var platform = rows.Values.FirstOrDefault()?.Observation.Platform ?? ClientServicePlatform.Unknown;
            foreach (var name in _model.MonitoredServiceNames)
            {
                var comparer = platform == ClientServicePlatform.Windows ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;
                if (rows.Values.Any(row => comparer.Equals(row.Observation.Name, name))) continue;
                var unknown = new ClientServiceObservation(name, name, platform, ClientServiceState.Unknown, "Unknown",
                    null, null, null, null, null, default);
                rows[ServiceIdentity(unknown)] = new ServiceRow(unknown, true, false, "Awaiting selected watch", false);
            }
            if (_operation?.Result is { State: not ClientServiceState.Unknown } result)
            {
                var identity = $"{(int)result.Platform}:{(result.Platform == ClientServicePlatform.Windows ? result.ServiceName.ToUpperInvariant() : result.ServiceName)}";
                if (rows.TryGetValue(identity, out var observed) && result.ObservedAtUtc > observed.Observation.ObservedAtUtc)
                    rows[identity] = observed with
                    {
                        Observation = observed.Observation with
                        {
                            State = result.State, ObservedAtUtc = result.ObservedAtUtc, RawState = result.State.ToString(),
                            ActiveState = null, SubState = null, AuthoritativeMissing = result.State == ClientServiceState.Missing
                        },
                        Evidence = "Service action result", HasObservation = true
                    };
            }
            return rows.Values.OrderBy(row => row.Observation.Name, StringComparer.OrdinalIgnoreCase).ToArray();
        }
    }

    private IReadOnlyList<ServiceRow> FilteredRows => Rows.Where(row =>
        (_filter == "All" || (_filter == "Monitored" ? row.Monitored : row.Observation.State.ToString() == _filter)) &&
        (string.IsNullOrWhiteSpace(_search) || row.Observation.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         row.Observation.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase))).ToArray();

    private bool IsCurrent(long generation) => !_disposed && generation == _generation;
    private bool IsStale(DateTimeOffset observed, bool watch = false) => _now - observed > TimeSpan.FromSeconds(watch ? 90 : ClientServicesLimits.DefaultInventoryIntervalSeconds + 30);
    private string Age(DateTimeOffset observed)
    {
        var age = _now - observed;
        if (age < TimeSpan.FromSeconds(-5)) return "Client clock is ahead";
        if (age <= TimeSpan.FromSeconds(5)) return "Just observed";
        if (age.TotalMinutes < 1) return $"{Math.Max(0, (int)age.TotalSeconds)} seconds ago";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes} minutes ago";
        return $"{(int)age.TotalHours} hours ago";
    }
    private static string Value(string? value) => string.IsNullOrWhiteSpace(value) ? "Unknown" : value;
    private static string ServiceIdentity(ClientServiceObservation service) =>
        $"{(int)service.Platform}:{(service.Platform == ClientServicePlatform.Windows ? service.Name.ToUpperInvariant() : service.Name)}";
    private sealed record ServiceRow(ClientServiceObservation Observation, bool Monitored, bool FromWatch, string Evidence, bool HasObservation = true);

    private void Close()
    {
        ++_generation;
        _runCancellation?.Cancel();
        MudDialog?.Close();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        ++_generation;
        _runCancellation?.Cancel();
        // Both owned loops honor cancellation; requests which finish late are also fenced above.
        if (_liveTask is not null) await _liveTask;
        if (_ageTask is not null) await _ageTask;
        if (_controlTask is not null) await _controlTask;
        _runCancellation?.Dispose();
    }
}
