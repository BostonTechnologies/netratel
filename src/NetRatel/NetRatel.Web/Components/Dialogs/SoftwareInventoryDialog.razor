@using NetRatel.Web.Components.SoftwareInventory

<MudDialog Style="overflow:hidden" ContentStyle="padding:0;overflow-y:auto;min-height:0" AriaLabel="@($"Software inventory for {HostLabel}")">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6">@HostLabel</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Software inventory · saved snapshot and live refresh</MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent><SoftwareInventoryPanel TenantId="TenantId" AgentId="AgentId" AutoRefreshOnOpen="true" /></DialogContent>
    <DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(() => MudDialog?.Close())">Close inventory</MudButton></DialogActions>
</MudDialog>

@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter] public Guid AgentId { get; set; }
    [Parameter] public string HostLabel { get; set; } = "Client";
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
}
