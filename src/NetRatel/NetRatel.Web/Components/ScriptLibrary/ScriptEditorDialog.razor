<MudDialog Class="script-editor-dialog" ContentStyle="height:100%; min-height:0; display:flex; flex-direction:column; overflow:hidden; padding:16px;">
    <DialogContent>
        <ScriptEditorPane Draft="Draft" CanEdit="CanEdit" FullScreen="true" AutoFocus="true"
                          SaveRequested="SaveRequested" DeleteRequested="DeleteRequested"
                          Deleted="Close" ToggleFullScreen="Close" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public ScriptEditorDraft Draft { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public Func<Task<bool>>? DeleteRequested { get; set; }

    private void Close() => MudDialog.Close();
}
