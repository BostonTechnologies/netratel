@rendermode InteractiveServer
@using System.Linq
@using System.Timers
@using BlazorMonaco.Editor
@using MudBlazor
@using NetRatel.Shared.Contracts.Execution
@using NetRatel.Shared.Contracts.Scripts
@using NetRatel.Web.Services
@using NetRatel.Web.Services.ScriptLibrary

@inject ScriptLibraryClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<ScriptLibraryView> Logger

@implements IAsyncDisposable

<div class="script-library-shell">
    <div class="script-library-toolbar" data-testid="script-library-toolbar">
        <MudText Typo="Typo.h6">Script Library</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@(_loading ? "Loading…" : _loadFailed ? "Library refresh unavailable" : $"{_all.Count} shared script{(_all.Count == 1 ? string.Empty : "s")}")</MudText>
        @if (!ReadOnly && AllowAdding)
        {
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NewScript" data-testid="script-library-new">New Script</MudButton>
        }
        <MudTooltip Text="Refresh list">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="ReloadAsync" aria-label="Refresh script library" />
        </MudTooltip>
    </div>
    <div class="script-library-workspace @(ShowViewer ? string.Empty : "script-library-picker")" data-testid="script-library-workspace">
        <div class="script-library-tree-column">
            <div class="script-library-panel script-library-tree-panel">
            <MudStack Spacing="1">
                <MudTextField T="string"
                              Label="Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Value="@_search"
                              ValueChanged="@OnSearchChanged"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" />

                <MudSelect T="string" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@_filterType" ValueChanged="@OnFilterChanged" Clearable="true">
                    <MudSelectItem Value="@((string?)null)">All</MudSelectItem>
                    @foreach (var t in _types.OrderBy(t => t, StringComparer.OrdinalIgnoreCase))
                    {
                        <MudSelectItem Value="@t">@(ScriptLibraryTypes.Find(t)?.Label ?? t)</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            <MudDivider Class="my-2" />

            <!-- Scrollable tree area -->
            <div class="script-library-tree-scroll" data-testid="script-library-tree">
                @if (_loading)
                {
                    <div class="d-flex h-100 w-100 justify-center align-center">
                        <MudProgressCircular Indeterminate="true" />
                    </div>
                }
                else
                {
                    <MudTreeView T="ScriptTreeNode" Items="@_tree"
                                 Hover="true"
                                 ExpandOnClick="true"
                                 SelectedValue="@_active"
                                 SelectedValueChanged="OnActivatedChanged">
                        <ItemTemplate Context="item">
                            <MudTreeViewItem T="ScriptTreeNode" Items="@item.Children"
                                             Value="@item.Value"
                                             Expanded="@item.Expanded"
                                             ExpandedChanged="@(expanded => OnExpandedChanged(item, expanded))"
                                             Icon="@GetNodeIcon(item)">
                                <BodyContent>
                                    @if (item.Value is { } value)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100">
                                            <MudText Typo="Typo.body2" Class="mud-truncate">@value.Name</MudText>
                                            @if (!value.IsFolder && AllowEditing && !ReadOnly)
                                            {
                                                <div class="script-library-row-actions" @onclick:stopPropagation="true">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => BeginRename(value))" aria-label="@($"Rename {value.Name}")" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteScript(value))" aria-label="@($"Delete {value.Name}")" />
                                                </div>
                                            }
                                        </MudStack>
                                    }
                                </BodyContent>
                            </MudTreeViewItem>
                        </ItemTemplate>
                    </MudTreeView>
                }
            </div>

            </div>
        </div>

    @if (ShowViewer)
    {
        <div class="script-library-editor-column">
            <div class="script-library-panel script-library-editor-panel">
                @if (_current is null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Select a script to view or edit.</MudText>
                }
                else
                {
                    <div class="script-library-editor-head">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                            <MudStack Spacing="1">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.h6" Class="mr-2">@_current.Name</MudText>
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">@(ScriptLibraryTypes.Find(_current.ScriptType)?.Label ?? _current.ScriptType ?? "plaintext")</MudChip>
                                    @if (_dirty)
                                    {
                                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small">unsaved</MudChip>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@NormalizeFolder(_current.FolderPath) - updated @_current.UpdatedAt.ToLocalTime().ToString("g")</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudButton Variant="Variant.Filled"
                                           Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           Disabled="@(!AllowEditing || ReadOnly || !_dirty || _current is null || _saving)"
                                           OnClick="@Save">
                                    Save
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </div>

                    <div @ref="_editorHost" class="script-library-editor-frame" data-testid="script-library-editor-frame">
                        <div class="script-library-editor" data-testid="script-library-editor">
                            <StandaloneCodeEditor @key="_editorKey"
                                                  @ref="_editor"
                                                  Id="script-library-monaco"
                                                  CssClass="script-library-monaco"
                                                  OnDidInit="OnEditorInitialized"
                                                  OnDidChangeModelContent="OnEditorContentChanged"
                                                  ConstructionOptions="@EditorOptions" />
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    </div>
</div>

@code
{
    [Parameter] public bool AllowAdding { get; set; }
    [Parameter] public bool AllowEditing { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ShowViewer { get; set; } = true;
    [Parameter] public string? FilterByType { get; set; }
    [Parameter] public string? InitialSearch { get; set; }

    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private List<ScriptDto> _all = new();
    private List<ScriptTreeNode> _treeRoots = new();
    private List<TreeItemData<ScriptTreeNode>> _tree = new();
    private HashSet<string> _types = new(StringComparer.OrdinalIgnoreCase);
    private ScriptTreeNode? _active;
    private ScriptDto? _current;
    private StandaloneCodeEditor? _editor;
    private ElementReference _editorHost;
    private ElementReference _observedEditorHost;
    private string? _observedEditorKey;
    private System.Timers.Timer? _debounce;
    private CancellationTokenSource? _listCancellation;
    private long _listGeneration;
    private IJSObjectReference? _resizeObserverModule;
    private DotNetObjectReference<ScriptLibraryView>? _selfReference;
    private bool _disposed;
    private int _layoutQueued;
    private bool _loading;
    private bool _loadFailed;
    private bool _dirty;
    private bool _saving;
    private bool _editorInitialized;
    private bool _focusEditor;
    private string _selectedFolder = "/";
    private string _editorBaseline = string.Empty;
    private string? _search;
    private string? _filterType;
    private string _editorKey = Guid.NewGuid().ToString();

    protected override async Task OnInitializedAsync()
    {
        _filterType = FilterByType;
        _search = InitialSearch;
        await ReloadAsync();
        HookCtrlS();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _current is null)
        {
            return;
        }

        if (_resizeObserverModule is null)
        {
            _selfReference = DotNetObjectReference.Create(this);
            _resizeObserverModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/resizeObserver.js");
        }
        if (_observedEditorKey != _editorKey)
        {
            if (_observedEditorKey is not null)
                await _resizeObserverModule.InvokeVoidAsync("unobserveResize", _observedEditorHost);
            await _resizeObserverModule.InvokeVoidAsync("observeResize", _editorHost, _selfReference, nameof(OnEditorHostResize));
            _observedEditorHost = _editorHost;
            _observedEditorKey = _editorKey;
        }

        await LayoutEditorAsync();
        if (_focusEditor && _editorInitialized && _editor is not null)
        {
            _focusEditor = false;
            await _editor.Focus();
        }
    }

    [JSInvokable]
    public Task OnEditorHostResize()
    {
        if (_disposed || Interlocked.Exchange(ref _layoutQueued, 1) != 0)
        {
            return Task.CompletedTask;
        }

        _ = InvokeAsync(LayoutEditorAfterResizeAsync);
        return Task.CompletedTask;
    }

    private async Task LayoutEditorAfterResizeAsync()
    {
        try
        {
            await LayoutEditorAsync();
        }
        finally
        {
            Volatile.Write(ref _layoutQueued, 0);
        }
    }

    private async Task LayoutEditorAsync()
    {
        if (_editor is null || _disposed)
        {
            return;
        }

        try
        {
            await _editor.Layout();
        }
        catch (JSException) when (_disposed)
        {
            return;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _listCancellation?.Cancel();
        _listCancellation?.Dispose();
        if (_debounce is not null)
        {
            _debounce.Elapsed -= DebounceElapsed;
            _debounce.Dispose();
        }

        if (_resizeObserverModule is not null)
        {
            try
            {
                await _resizeObserverModule.InvokeVoidAsync("unobserveResize", _observedEditorHost);
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogDebug(ex, "The browser circuit closed before the script-library resize observer detached.");
            }
            try
            {
                await _resizeObserverModule.DisposeAsync();
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogDebug(ex, "The browser circuit closed before the script-library resize module disposed.");
            }
            _resizeObserverModule = null;
        }

        if (_editor is not null)
        {
            try
            {
                await _editor.DisposeEditor();
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogDebug(ex, "The browser circuit closed before the script-library Monaco editor disposed.");
            }
        }

        _selfReference?.Dispose();
        _selfReference = null;
    }

    private async Task ReloadAsync()
    {
        _listCancellation?.Cancel();
        _listCancellation?.Dispose();
        _listCancellation = new();
        var token = _listCancellation.Token;
        var generation = ++_listGeneration;
        _loading = true;
        StateHasChanged();

        try
        {
            var scripts = await Api.ListAsync(token);
            if (_disposed || generation != _listGeneration) return;
            _all = scripts;
            _loadFailed = false;
            if (_current is not null && !_dirty)
            {
                var refreshed = scripts.FirstOrDefault(script => script.Id == _current.Id);
                if (refreshed is not null)
                {
                    if (_current.Content != refreshed.Content || _current.ScriptType != refreshed.ScriptType)
                    {
                        _editorKey = Guid.NewGuid().ToString();
                        _editorInitialized = false;
                    }
                    _current = refreshed;
                    _editorBaseline = refreshed.Content ?? string.Empty;
                }
                else SelectNone();
            }
            _types = _all
                .Select(s => s.ScriptType)
                .Where(t => !string.IsNullOrWhiteSpace(t))
                .Select(t => t!.Trim())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            RebuildTree();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (!_disposed && generation == _listGeneration)
        {
            _loadFailed = true;
            Snackbar.Add($"Failed to load scripts: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (!_disposed && generation == _listGeneration)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private void InvalidateListReads()
    {
        ++_listGeneration;
        _listCancellation?.Cancel();
        _loading = false;
    }

    private void RebuildTree(bool captureExpansion = true)
    {
        if (captureExpansion) UpdateExpandedSnapshot();
        _treeRoots = ScriptTreeBuilder.Build(_all, _filterType, _search, _expanded);
        _tree = _treeRoots.Select(CreateTreeItemData).ToList();

        if (_current is not null)
        {
            var match = _treeRoots.SelectMany(Flatten).FirstOrDefault(n => !n.IsFolder && n.Id == _current.Id);
            if (match is null)
            {
                // Filtering or a refresh must not destroy an open draft.
                _active = null;
            }
            else
            {
                _active = match;
            }
        }
        else
        {
            _active = null;
        }
    }

    private void UpdateExpandedSnapshot()
    {
        _expanded.Clear();
        foreach (var item in _tree)
        {
            Capture(item);
        }

        void Capture(ITreeItemData<ScriptTreeNode> item)
        {
            if (item.Value is { } value)
            {
                value.IsExpanded = item.Expanded;
                if (value.IsFolder && value.IsExpanded)
                {
                    _expanded.Add(value.FullPath);
                }
            }

            if (item.Children is { Count: > 0 } children)
            {
                foreach (var child in children)
                {
                    Capture(child);
                }
            }
        }
    }

    private static TreeItemData<ScriptTreeNode> CreateTreeItemData(ScriptTreeNode node)
    {
        var item = new TreeItemData<ScriptTreeNode>
        {
            Value = node,
            Text = node.Name,
            Icon = node.IsFolder ? null : node.Icon,
            Expanded = node.IsExpanded,
            Children = node.Children.Count == 0
                ? new List<TreeItemData<ScriptTreeNode>>()
                : node.Children.Select(CreateTreeItemData).ToList()
        };

        return item;
    }

    private static string GetNodeIcon(ITreeItemData<ScriptTreeNode> item)
    {
        if (item.Value is not { } value)
        {
            return Icons.Material.Filled.InsertDriveFile;
        }

        if (value.IsFolder)
        {
            return item.Expanded
                ? Icons.Custom.Uncategorized.FolderOpen
                : Icons.Custom.Uncategorized.Folder;
        }

        return value.Icon ?? Icons.Material.Filled.InsertDriveFile;
    }

    private static void OnExpandedChanged(ITreeItemData<ScriptTreeNode> item, bool expanded)
    {
        item.Expanded = expanded;
        if (item.Value is { } value)
        {
            value.IsExpanded = expanded;
        }
    }

    private static IEnumerable<ScriptTreeNode> Flatten(ScriptTreeNode root)
    {
        yield return root;
        foreach (var child in root.Children.SelectMany(Flatten))
        {
            yield return child;
        }
    }

    private async Task OnActivatedChanged(ScriptTreeNode? node)
    {
        if (_current is not null && node is { IsFolder: false } && node.Id == _current.Id)
        {
            _active = node;
            return;
        }
        if (_dirty && node?.Id != _current?.Id)
        {
            var leave = await Confirm("Unsaved changes", "Discard changes and switch file?");
            if (!leave)
            {
                // revert to previous selection
                _active = _treeRoots.SelectMany(Flatten).FirstOrDefault(n => !n.IsFolder && n.Id == _current?.Id);
                StateHasChanged();
                return;
            }
        }

        _active = node;
        if (node is not null)
            _selectedFolder = node.IsFolder ? node.FullPath : NormalizeFolder(_all.FirstOrDefault(script => script.Id == node.Id)?.FolderPath);

        if (node is null || node.IsFolder)
        {
            SelectNone(clearActive: node is null);
            return;
        }

        _current = _all.FirstOrDefault(s => s.Id == node.Id);
        _editorBaseline = _current?.Content ?? string.Empty;
        _dirty = false;
        _editorInitialized = false;
        _editorKey = Guid.NewGuid().ToString();
        StateHasChanged();
    }

    private Task OnEditorContentChanged(ModelContentChangedEvent _)
        => UpdateDirtyFlagAsync();

    private Task OnEditorInitialized()
    {
        _editorInitialized = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task UpdateDirtyFlagAsync()
    {
        if (_editor is null || !_editorInitialized)
        {
            return;
        }

        var editor = _editor;
        var current = _current;
        var value = await editor.GetValue();
        if (!ReferenceEquals(editor, _editor) || !ReferenceEquals(current, _current) || _disposed) return;
        var dirty = !string.Equals(value, _editorBaseline, StringComparison.Ordinal);
        if (dirty != _dirty)
        {
            _dirty = dirty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Save()
    {
        if (_current is null || _editor is null || !AllowEditing || ReadOnly || _saving)
        {
            return;
        }

        var observed = _current;
        _saving = true;
        try
        {
            var content = await _editor.GetValue();
            if (!ReferenceEquals(_current, observed)) return;
            var sourceRevision = await Api.UpdateAsync(observed.Id, new UpdateScriptRequest(
                Name: null,
                FolderPath: null,
                Description: null,
                Content: content,
                ScriptType: null, ExpectedSourceRevision: observed.SourceRevision), CancellationToken.None);
            InvalidateListReads();

            var idx = _all.FindIndex(s => s.Id == observed.Id);
            if (idx >= 0 && _all[idx].SourceRevision <= sourceRevision)
            {
                _all[idx] = _all[idx] with { Content = content, UpdatedAt = DateTimeOffset.UtcNow, SourceRevision = sourceRevision };
            }

            if (ReferenceEquals(_current, observed))
            {
                var latestContent = await _editor.GetValue();
                if (ReferenceEquals(_current, observed))
                {
                    _current = observed with { Content = content, UpdatedAt = DateTimeOffset.UtcNow, SourceRevision = sourceRevision };
                    _editorBaseline = content;
                    _dirty = !string.Equals(latestContent, content, StringComparison.Ordinal);
                }
            }
            Snackbar.Add("Saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task NewScript()
    {
        if (!AllowAdding || ReadOnly)
        {
            return;
        }

        if (_dirty && !await Confirm("Unsaved changes", "Discard changes when the new script is created?")) return;
        var model = new NewScriptDialogModel
        {
            Folder = _selectedFolder,
            Type = ScriptLibraryTypes.Find(_filterType)?.Value ?? ScriptType.PowerShell,
            ExistingFolders = _all.SelectMany(script => ExistingFolderChain(script.FolderPath))
                .Append("/").Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToList()
        };
        var parameters = new DialogParameters
        {
            ["Model"] = model,
            ["CreateScript"] = new Func<CreateScriptRequest, Task<ulong>>(request => Api.CreateAsync(request, CancellationToken.None))
        };
        var dialog = await Dialogs.ShowAsync<NewScriptDialog>("New Script", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = false, BackdropClick = false });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ulong id || _disposed) return;

        var request = model.ToRequest();
        InvalidateListReads();
        var created = new ScriptDto(id, request.Name, request.FolderPath, request.Description, request.Content,
            request.ScriptType, DateTimeOffset.UtcNow, DateTimeOffset.UtcNow);
        _all.Add(created);
        _types.Add(created.ScriptType!);
        UpdateExpandedSnapshot();
        foreach (var folder in ScriptLibraryPlacement.FolderChain(created.FolderPath)) _expanded.Add(folder);
        // Make the just-created script visible even if the previous search/type
        // hid its placement. Embedded fixed-type picker scope remains intact.
        _search = null;
        _filterType = string.IsNullOrWhiteSpace(FilterByType) ? null : FilterByType;
        _current = created;
        _selectedFolder = request.FolderPath!;
        _editorBaseline = created.Content ?? string.Empty;
        _dirty = false;
        _editorInitialized = false;
        _editorKey = Guid.NewGuid().ToString();
        _focusEditor = ShowViewer;
        RebuildTree(captureExpansion: false);
        Snackbar.Add("Script created.", Severity.Success);
    }

    private async Task DeleteScript(ScriptTreeNode node)
    {
        if (node.Id is null || !AllowEditing || ReadOnly)
        {
            return;
        }

        var observedRevision = _all.Single(script => script.Id == node.Id.Value).SourceRevision;
        if (!await Confirm("Delete script", $"Delete '{node.Name}'?"))
        {
            return;
        }

        try
        {
            await Api.DeleteAsync(node.Id.Value, observedRevision, CancellationToken.None);
            InvalidateListReads();
            if (_current?.Id == node.Id.Value)
            {
                SelectNone();
            }

            await ReloadAsync();
            Snackbar.Add("Deleted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task BeginRename(ScriptTreeNode node)
    {
        if (node.Id is null || !AllowEditing || ReadOnly)
        {
            return;
        }

        var observedRevision = _all.Single(script => script.Id == node.Id.Value).SourceRevision;
        var (ok, newName) = await PromptRename(node.Name);
        if (!ok || string.Equals(newName, node.Name, StringComparison.Ordinal))
        {
            return;
        }

        try
        {
            var revision = await Api.UpdateAsync(node.Id.Value, new UpdateScriptRequest(
                Name: newName,
                FolderPath: null,
                Description: null,
                Content: null,
                ScriptType: null, ExpectedSourceRevision: observedRevision), CancellationToken.None);
            InvalidateListReads();

            if (_current?.Id == node.Id.Value)
                _current = _current with { Name = newName, SourceRevision = revision };

            await ReloadAsync();
            Snackbar.Add("Renamed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Rename failed: {ex.Message}", Severity.Error);
        }
    }

    private void OnSearchChanged(string? value)
    {
        _search = value;
        EnsureDebounceTimer();
        _debounce!.Stop();
        _debounce.Start();
    }

    private Task OnFilterChanged(string? value)
    {
        _filterType = string.IsNullOrWhiteSpace(value) ? null : value;
        RebuildTree();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void EnsureDebounceTimer()
    {
        if (_debounce is not null)
        {
            return;
        }

        _debounce = new System.Timers.Timer(250) { AutoReset = false };
        _debounce.Elapsed += DebounceElapsed;
    }

    private void DebounceElapsed(object? sender, ElapsedEventArgs e)
    {
        InvokeAsync(() =>
        {
            RebuildTree();
            StateHasChanged();
        });
    }

    private void SelectNone(bool clearActive = true)
    {
        if (clearActive) _active = null;
        _current = null;
        _dirty = false;
        _editorBaseline = string.Empty;
        _editorKey = Guid.NewGuid().ToString();
        StateHasChanged();
    }

    private async Task<(bool ok, string name)> PromptRename(string current)
    {
        var model = new RenameScriptDialogModel { Name = current };
        var parameters = new DialogParameters { ["Model"] = model };
        var dialogRef = await Dialogs.ShowAsync<RenameScriptDialog>("Rename Script", parameters);
        if (dialogRef is not { } dialog)
        {
            return (false, current);
        }

        var result = await dialog.Result;
        if (result is null)
        {
            return (false, current);
        }

        return (!result.Canceled, model.Name?.Trim() ?? current);
    }

    private Task<bool> Confirm(string title, string message)
        => Dialogs.ShowMessageBoxAsync(title, message, yesText: "Yes", cancelText: "Cancel")
                  .ContinueWith(t => t.Result == true);

    private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor _)
        => new()
        {
            Theme = "vs-dark",
            AutomaticLayout = true,
            ReadOnly = ReadOnly || !AllowEditing,
            Language = LangFor(_current?.ScriptType),
            Value = _current?.Content ?? string.Empty,
            ScrollBeyondLastLine = false
        };

    private static string LangFor(string? type) => ScriptLibraryTypes.Find(type)?.Language ?? "plaintext";

    private void HookCtrlS()
    {
        // Monaco already wires CMD/CTRL+S to "save" if you register it; hook via JS later if desired.
    }

    private static string NormalizeFolder(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "/";
        }

        var normalized = path.Trim().Replace('\\', '/');
        if (!normalized.StartsWith('/'))
        {
            normalized = "/" + normalized;
        }

        if (!normalized.EndsWith('/'))
        {
            normalized += "/";
        }

        return normalized;
    }

    private static IReadOnlyList<string> ExistingFolderChain(string? path)
    {
        try { return ScriptLibraryPlacement.FolderChain(path); }
        catch (ArgumentException) { return ["/"]; }
    }
}
