@using NetRatel.Shared.Contracts.Secrets
@using NetRatel.Web.Components.Pages.Jobs
@using NetRatel.Web.Services.Tenants
@inject SecretVaultApi Vault
@inject IDialogService Dialogs
@implements IDisposable

<MudDialog Class="secret-vault-dialog">
    <DialogContent>
        <MudStack Spacing="2" Class="secret-vault-content">
            @if (_error is not null) { <MudAlert Dense="true" Severity="Severity.Error" role="alert">@_error</MudAlert> }
            <div class="vault-form-fields">
                <MudTextField @bind-Value="_name" Label="Display name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudSelect T="ExecutionIdentityMode" Value="_mode" ValueChanged="ModeChanged" Label="Identity mode" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@ExecutionIdentityMode.WindowsPassword">Windows password logon</MudSelectItem>
                    <MudSelectItem Value="@ExecutionIdentityMode.UnixPrivilegedLocal">Unix privileged local account</MudSelectItem>
                </MudSelect>
            </div>
            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">Account</MudText>
                    <MudCheckBox @bind-Value="_useUsernameReference" Label="Select a username reference" />
                    @if (_useUsernameReference)
                    {
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => PickAsync(username: true))">Choose username reference</MudButton>
                        @if (_usernameReference is { } reference) { <MudText Typo="Typo.caption" Class="vault-wrap">@SecretVaultPresentation.Reference(reference)</MudText> }
                    }
                    else
                    {
                        <MudTextField @bind-Value="_username" Label="Public username" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    }
                    @if (_mode == ExecutionIdentityMode.WindowsPassword)
                    {
                        <MudTextField @bind-Value="_domain" Label="Windows domain (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => PickAsync(username: false))">Choose password reference</MudButton>
                        @if (_password is { } reference) { <MudText Typo="Typo.caption" Class="vault-wrap">@SecretVaultPresentation.Reference(reference)</MudText> }
                    }
                    <MudTextField @bind-Value="_account" Label="@(_mode == ExecutionIdentityMode.WindowsPassword ? "Approved Windows account SID (optional)" : "Approved Unix account UID (optional)")"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  HelperText="@AccountIdHelp" />
                </MudStack>
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">Execution scope</MudText>
                    <JobNodePicker TenantId="TenantId" @bind-Value="_clients" Label="Allowed clients" ForCredentialProfiles="true" Disabled="_busy" />
                    <div class="vault-control-actions">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="@(() => SelectAllAsync(false))">Select all tenant clients</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="@(() => SelectAllAsync(true))">Select all Windows clients</MudButton>
                    </div>
                    <MudText Typo="Typo.caption">Bulk selection replaces the list with the tenant's current matching clients.</MudText>
                    <div class="vault-control-actions">
                        <MudCheckBox @bind-Value="_jobs" Label="Jobs" />
                        <MudCheckBox @bind-Value="_terminals" Label="Terminals" />
                    </div>
                </MudStack>
            </MudPaper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Dialog.Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Save credential profile</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int TenantId { get; set; }
    [Parameter] public CredentialProfile? Profile { get; set; }
    [Parameter] public CancellationToken OwnerLifetime { get; set; }
    private CancellationTokenSource _lifetime = default!;
    private CancellationTokenRegistration _owner;
    private ExecutionIdentityMode _mode = ExecutionIdentityMode.WindowsPassword;
    private string? _name, _username, _domain, _account, _error;
    private IReadOnlyList<Guid> _clients = [];
    private SecretReference? _usernameReference, _password;
    private bool _useUsernameReference, _terminals, _busy;
    private bool _jobs = true;
    private string AccountIdHelp => _mode == ExecutionIdentityMode.WindowsPassword
        ? "For a local account, find the SID with Get-LocalUser on the Windows client. Add it before Run as."
        : "Find the numeric account ID with id -u on the Unix client. Add it before Run as.";

    protected override void OnInitialized()
    {
        _lifetime = CancellationTokenSource.CreateLinkedTokenSource(OwnerLifetime);
        _owner = OwnerLifetime.Register(() => _ = InvokeAsync(Dialog.Cancel));
        if (Profile is not { } current) return;
        (_mode, _name, _username, _domain, _account) = (current.Mode, current.DisplayName, current.PublicUsername, current.Domain, current.Scope.AccountId);
        (_usernameReference, _password, _useUsernameReference) = (current.UsernameReference, current.PasswordReference, current.UsernameReference is not null);
        (_jobs, _terminals, _clients) = (current.Scope.Jobs, current.Scope.Terminals, current.Scope.AgentIds);
    }

    private void ModeChanged(ExecutionIdentityMode mode) { _mode = mode; _account = null; }
    private async Task PickAsync(bool username)
    {
        var token = _lifetime.Token;
        var dialog = await Dialogs.ShowAsync<SecretPickerDialog>(username ? "Choose username secret" : "Choose password secret", new DialogParameters<SecretPickerDialog>
        {
            { x => x.TenantId, TenantId }, { x => x.Current, username ? _usernameReference : _password }, { x => x.OwnerLifetime, token }
        }, SecretVaultPresentation.Options);
        if (await dialog.Result is not { Canceled: false, Data: SecretReference reference } || token.IsCancellationRequested) return;
        if (username) _usernameReference = reference;
        else _password = reference;
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        var ct = _lifetime.Token;
        (_busy, _error) = (true, null);
        try
        {
            if (_clients.Count == 0)
                throw new SecretVaultUiException("Select one or more clients in this tenant.");
            var windows = _mode == ExecutionIdentityMode.WindowsPassword;
            var request = new SaveCredentialProfileRequest(_name ?? "", _mode, _useUsernameReference ? null : _username,
                _useUsernameReference ? _usernameReference : null, windows ? _domain : null, windows ? _password : null,
                new(_clients.ToArray(), _account, _jobs, _terminals), Profile?.Revision);
            var saved = await Vault.SaveProfileAsync(TenantId, Profile?.Id, request, ct);
            if (!ct.IsCancellationRequested) Dialog.Close(DialogResult.Ok(saved));
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        catch (SecretVaultUiException error) { _error = error.Message; }
        catch (HttpRequestException) { _error = "The vault is temporarily unavailable."; }
        finally { _busy = false; }
    }

    private async Task SelectAllAsync(bool windowsOnly)
    {
        if (_busy) return;
        var ct = _lifetime.Token;
        (_busy, _error) = (true, null);
        try
        {
            var clients = await Vault.ProfileTargetIdsAsync(TenantId, windowsOnly, ct);
            if (clients.Length == 0)
                throw new SecretVaultUiException(windowsOnly ? "This tenant has no eligible Windows clients." : "This tenant has no eligible clients.");
            if (!ct.IsCancellationRequested) _clients = clients;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        catch (SecretVaultUiException error) { _error = error.Message; }
        catch (HttpRequestException) { _error = "Clients could not be loaded. Your selection is retained."; }
        finally { _busy = false; }
    }

    public void Dispose() { _owner.Dispose(); _lifetime.Cancel(); _lifetime.Dispose(); }
}
