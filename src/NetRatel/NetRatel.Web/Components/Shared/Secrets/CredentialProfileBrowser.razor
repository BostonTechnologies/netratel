@using NetRatel.Shared.Contracts.Secrets
@using NetRatel.Web.Services.Tenants
@inject SecretVaultApi Vault
@inject IDialogService Dialogs
@implements IDisposable

<section aria-label="Credential profiles" class="secret-vault-content">
    <div class="vault-control-actions">
        <MudTooltip Text="Refresh credential profiles"><MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh credential profiles"
            OnClick="LoadAsync" Disabled="_busy" /></MudTooltip>
        @if (!SelectMode && Permissions.ManageCredentials && Permissions.Use)
        {
            <MudTooltip Text="Add credential profile"><MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" aria-label="Add credential profile"
                OnClick="@(() => EditAsync(null))" Disabled="_busy" /></MudTooltip>
        }
    </div>
    @if (_error is not null) { <MudAlert Dense="true" Severity="Severity.Error" role="alert">@_error</MudAlert> }
    @if (_busy) { <MudProgressLinear Indeterminate="true" aria-label="Loading credential profiles" /> }
    @foreach (var profile in VisibleProfiles)
    {
        <MudPaper @key="profile.Id" Outlined="true" Class="pa-2">
            <div class="vault-profile-row">
                <div class="vault-wrap">
                    <MudText Typo="Typo.subtitle2">@profile.DisplayName</MudText>
                    <MudText Typo="Typo.body2">@(profile.PublicUsername is { } user ? PublicAccount(profile, user) : "Username reference")</MudText>
                    <MudText Typo="Typo.caption">@SecretVaultPresentation.Identity(profile.Mode)</MudText>
                    @if (profile.Scope.AccountId is null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">Account approval needed for Run as</MudText>
                    }
                </div>
                <div class="vault-control-actions">
                    @if (SelectMode)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => OnSelected.InvokeAsync(profile))">Select</MudButton>
                    }
                    else if (Permissions.ManageCredentials)
                    {
                        <MudTooltip Text="Edit credential profile"><MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit credential profile"
                            OnClick="@(() => EditAsync(profile))" Disabled="_busy" /></MudTooltip>
                        <MudTooltip Text="Delete credential profile"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" aria-label="Delete credential profile"
                            OnClick="@(() => DeleteAsync(profile))" Disabled="_busy" /></MudTooltip>
                    }
                </div>
            </div>
        </MudPaper>
    }
    @if (!_busy && _error is null && !VisibleProfiles.Any())
    {
        <MudText Typo="Typo.body2" role="status">@(SelectMode ? "No eligible saved credentials." : "No credential profiles have been saved.")</MudText>
    }
</section>

@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter, EditorRequired] public SecretVaultPermissions Permissions { get; set; } = default!;
    [Parameter] public bool SelectMode { get; set; }
    [Parameter] public Guid? TargetAgentId { get; set; }
    [Parameter] public bool ForTerminal { get; set; }
    [Parameter] public EventCallback<CredentialProfile> OnSelected { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private CredentialProfile[] _profiles = [];
    private string? _error;
    private bool _busy;
    private IEnumerable<CredentialProfile> VisibleProfiles => SelectMode ? _profiles.Where(x => x.Scope.AccountId is { Length: > 0 } &&
        (ForTerminal ? x.Scope.Terminals : x.Scope.Jobs) && (!TargetAgentId.HasValue || x.Scope.AgentIds.Contains(TargetAgentId.Value))) : _profiles;

    protected override Task OnInitializedAsync() => LoadAsync();
    private Task LoadAsync() => ExecuteAsync(async ct => _profiles = await Vault.ProfilesAsync(TenantId, ct));

    private async Task EditAsync(CredentialProfile? profile)
    {
        var ct = _lifetime.Token;
        var editor = await Dialogs.ShowAsync<CredentialProfileDialog>(profile is null ? "Create credential profile" : "Edit credential profile",
            new DialogParameters<CredentialProfileDialog>
            { { x => x.TenantId, TenantId }, { x => x.Profile, profile }, { x => x.OwnerLifetime, ct } }, SecretVaultPresentation.Options);
        if (await editor.Result is { Canceled: false } && !ct.IsCancellationRequested) await LoadAsync();
    }

    private Task DeleteAsync(CredentialProfile profile) => ExecuteAsync(async ct =>
    {
        var plan = await Vault.PreviewRemovalAsync(TenantId, new(VaultRemovalKind.CredentialProfile, profile.Id, profile.Revision), ct);
        var approved = await Dialogs.ShowMessageBoxAsync("Review credential deletion", SecretVaultPresentation.Removal(plan),
            yesText: "Delete profile", cancelText: "Cancel");
        if (approved != true || ct.IsCancellationRequested) return;
        await Vault.ConfirmRemovalAsync(TenantId, plan, ct);
        _profiles = await Vault.ProfilesAsync(TenantId, ct);
    });

    private async Task ExecuteAsync(Func<CancellationToken, Task> action)
    {
        if (_busy) return;
        var ct = _lifetime.Token;
        (_busy, _error) = (true, null);
        try { await action(ct); }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        catch (SecretVaultUiException error) { _error = error.Message; }
        catch (HttpRequestException) { _error = "The vault is temporarily unavailable."; }
        finally { _busy = false; }
    }

    private static string PublicAccount(CredentialProfile profile, string user) => profile.Domain is { } domain ? $"{domain}\\{user}" : user;
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
