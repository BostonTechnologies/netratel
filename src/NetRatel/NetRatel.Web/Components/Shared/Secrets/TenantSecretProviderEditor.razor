@using NetRatel.Shared.Contracts.Secrets
@using NetRatel.Web.Services.Tenants
@inject SecretVaultApi Vault
@inject IDialogService Dialogs
@implements IDisposable

<MudStack Spacing="2" Class="secret-vault-content" data-testid="tenant-secret-provider-editor">
    @if (_error is not null)
    {
        <MudAlert Dense="true" Severity="Severity.Error" role="alert">@_error</MudAlert>
    }
    @if (_permissions is { } permissions)
    {
        @if (permissions.AdministerProviders && _connections.Length > 0)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <div class="vault-control-group">
                    <MudSelect T="Guid" Value="_draftDefault" ValueChanged="DefaultChangedAsync" Label="Default provider" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var provider in _connections.Where(x => x.Enabled))
                        { <MudSelectItem T="Guid" Value="provider.Id">@provider.DisplayName</MudSelectItem> }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Disabled="@(_busy || !DefaultDirty)" OnClick="SaveDefaultAsync">Save default</MudButton>
                </div>
            </MudPaper>
        }
        <MudPaper Outlined="true" Class="pa-3">
            <MudStack Spacing="1">
                <div class="vault-control-group">
                    @if (_connections.Length > 0)
                    {
                        <MudSelect T="Guid" @bind-Value="_selected" Label="Connection" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var provider in _connections) { <MudSelectItem T="Guid" Value="provider.Id">@provider.DisplayName</MudSelectItem> }
                        </MudSelect>
                    }
                    <div class="vault-control-actions">
                        @if (permissions.AdministerProviders)
                        {
                            <MudTooltip Text="Add provider connection"><MudIconButton Icon="@Icons.Material.Filled.Add" aria-label="Add provider connection"
                                Disabled="_busy" OnClick="@(() => ConfigureAsync(null))" /></MudTooltip>
                        }
                        @if (Selected is { } provider)
                        {
                            @if (permissions.AdministerProviders && provider.Kind != SecretProviderKind.Local)
                            {
                                <MudTooltip Text="Configure connection"><MudIconButton Icon="@Icons.Material.Filled.Settings" aria-label="Configure connection"
                                    Disabled="_busy" OnClick="@(() => ConfigureAsync(provider))" /></MudTooltip>
                            }
                            @if (permissions.AdministerProviders && provider.Enabled)
                            {
                                <MudTooltip Text="Test connection"><MudIconButton Icon="@Icons.Material.Filled.FactCheck" aria-label="Test connection"
                                    Disabled="_busy" OnClick="@(() => TestAsync(provider))" /></MudTooltip>
                            }
                            @if (permissions.Browse && provider.Enabled)
                            {
                                <MudTooltip Text="Browse provider secrets"><MudIconButton Icon="@Icons.Material.Filled.FolderOpen" aria-label="Browse provider secrets"
                                    Disabled="_busy" OnClick="Browse" /></MudTooltip>
                            }
                        }
                    </div>
                </div>
                @if (Selected is { } selected)
                {
                    <div class="vault-control-actions">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@SecretVaultPresentation.Provider(selected.Kind)</MudChip>
                        @if (!selected.Enabled) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Disabled</MudChip> }
                        @if (LastTest(selected) is { } test)
                        {
                            <MudText Typo="Typo.caption" role="status">@TestLabel(test) · @test.CheckedAtUtc.ToLocalTime().ToString("g")</MudText>
                        }
                        @if (permissions.AdministerProviders && selected.Kind != SecretProviderKind.Local && !selected.IsDefault)
                        {
                            @if (selected.Enabled)
                            {
                                <MudButton Size="Size.Small" Disabled="_busy" OnClick="@(() => RemoveConnectionAsync(selected, VaultRemovalKind.DisableConnection))">Disable</MudButton>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Disabled="_busy" OnClick="@(() => EnableAsync(selected))">Enable</MudButton>
                            }
                            <MudTooltip Text="Remove saved connection"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                aria-label="Remove saved connection" Disabled="_busy" OnClick="@(() => RemoveConnectionAsync(selected, VaultRemovalKind.DeleteConnection))" /></MudTooltip>
                        }
                    </div>
                }
            </MudStack>
        </MudPaper>
        @if (permissions.Browse)
        {
            <div class="vault-control-actions" role="group" aria-label="Vault views">
                <MudButton Color="@(!_credentials ? Color.Primary : Color.Default)" Variant="Variant.Text" OnClick="Browse">Secrets</MudButton>
                @if (permissions.ManageCredentials || permissions.RunAs)
                {
                    <MudButton Color="@(_credentials ? Color.Primary : Color.Default)" Variant="Variant.Text" OnClick="ShowCredentials">Credentials</MudButton>
                }
            </div>
            <SecretBrowser TenantId="TenantId" Connection="Selected" Permissions="permissions" Active="Active" ShowCredentials="_credentials" />
        }
    }
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" aria-label="Working with provider connections" />
    }
    @if (_error is not null && _permissions is null)
    {
        <MudButton Disabled="_busy" OnClick="ReloadAsync">Retry</MudButton>
    }
</MudStack>

@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<(bool Dirty, bool Saving)> DraftChanged { get; set; }
    private CancellationTokenSource _lifetime = new();
    private readonly Dictionary<Guid, SecretProviderTestResult> _testResults = [];
    private int _loadedTenant;
    private SecretVaultPermissions? _permissions;
    private SecretProviderConnection[] _connections = [];
    private Guid _draftDefault, _selected;
    private string? _error;
    private bool _credentials, _busy, _saving;
    private SecretProviderConnection? Selected => _connections.FirstOrDefault(x => x.Id == _selected);
    private Guid CurrentDefault => _connections.FirstOrDefault(x => x.IsDefault)?.Id ?? Guid.Empty;
    private bool DefaultDirty => _draftDefault != Guid.Empty && _draftDefault != CurrentDefault;

    protected override Task OnParametersSetAsync()
    {
        if (!Active || _loadedTenant == TenantId) return Task.CompletedTask;
        _lifetime.Cancel();
        _lifetime.Dispose();
        _lifetime = new();
        (_loadedTenant, _permissions, _connections, _draftDefault, _selected) = (TenantId, null, [], Guid.Empty, Guid.Empty);
        _testResults.Clear();
        return ReloadAsync();
    }

    private Task ReloadAsync() => PerformAsync(LoadAsync);
    private async Task LoadAsync(CancellationToken ct)
    {
        _permissions = await Vault.PermissionsAsync(TenantId, ct);
        if (!_permissions.Browse && !_permissions.AdministerProviders)
        {
            _error = "Your account cannot browse or administer this tenant's vault.";
            return;
        }
        var previousDefault = CurrentDefault;
        _connections = await Vault.ConnectionsAsync(TenantId, ct);
        if (_draftDefault == previousDefault || !_connections.Any(x => x.Id == _draftDefault && x.Enabled)) _draftDefault = CurrentDefault;
        if (Selected is null) _selected = CurrentDefault;
    }

    private Task DefaultChangedAsync(Guid id) { _draftDefault = id; return ReportDraftAsync(); }
    private void Browse() => _credentials = false;
    private void ShowCredentials() => _credentials = true;
    private Task ReportDraftAsync() => DraftChanged.InvokeAsync((DefaultDirty, _saving));
    private SecretProviderTestResult? LastTest(SecretProviderConnection connection) => _testResults.GetValueOrDefault(connection.Id) ?? connection.LastTest;

    private Task SaveDefaultAsync() => PerformAsync(async ct =>
    {
        var selected = _connections.Single(x => x.Id == _draftDefault);
        await Vault.DefaultAsync(TenantId, selected.Id, new(CurrentDefault, selected.Revision), ct);
        await LoadAsync(ct);
    }, saving: true);

    private async Task ConfigureAsync(SecretProviderConnection? connection)
    {
        var ct = _lifetime.Token;
        var opened = await Dialogs.ShowAsync<SecretConnectionDialog>(connection is null ? "Add secret provider" : "Configure secret provider",
            new DialogParameters<SecretConnectionDialog>
            { { x => x.TenantId, TenantId }, { x => x.Connection, connection }, { x => x.OwnerLifetime, ct } }, SecretVaultPresentation.Options);
        var result = await opened.Result;
        if (ct.IsCancellationRequested || result is null || result.Canceled || result.Data is not SecretProviderConnection saved) return;
        _testResults.Remove(saved.Id);
        _selected = saved.Id;
        await ReloadAsync();
    }

    private Task TestAsync(SecretProviderConnection provider) => PerformAsync(async ct =>
        _testResults[provider.Id] = await Vault.TestAsync(TenantId, provider.Id, provider.Revision, ct));

    private Task EnableAsync(SecretProviderConnection selected) => PerformAsync(async ct =>
    {
        await Vault.EnableAsync(TenantId, selected.Id, selected.Revision, ct);
        await LoadAsync(ct);
    }, saving: true);

    private Task RemoveConnectionAsync(SecretProviderConnection selected, VaultRemovalKind kind) => PerformAsync(async ct =>
    {
        var plan = await Vault.PreviewRemovalAsync(TenantId, new(kind, selected.Id, selected.Revision), ct);
        var approved = await Dialogs.ShowMessageBoxAsync("Review provider connection change", SecretVaultPresentation.Removal(plan),
            yesText: kind == VaultRemovalKind.DisableConnection ? "Disable" : "Remove connection", cancelText: "Cancel");
        if (approved != true || ct.IsCancellationRequested) return;
        await Vault.ConfirmRemovalAsync(TenantId, plan, ct);
        _testResults.Remove(selected.Id);
        await LoadAsync(ct);
    }, saving: true);

    private async Task PerformAsync(Func<CancellationToken, Task> operation, bool saving = false)
    {
        if (_busy) return;
        var ct = _lifetime.Token;
        (_busy, _saving, _error) = (true, saving, null);
        if (saving) await ReportDraftAsync();
        try { await operation(ct); }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        catch (SecretVaultUiException error) { _error = error.Message; }
        catch (HttpRequestException) { _error = "The vault is temporarily unavailable."; }
        finally
        {
            (_busy, _saving) = (false, false);
            if (saving && !ct.IsCancellationRequested) await ReportDraftAsync();
        }
    }

    private static string TestLabel(SecretProviderTestResult test) => test.ListedMetadata ? "Metadata listed" : test.ErrorCode switch
    {
        "Authentication" => "Authentication failed",
        "Forbidden" => "Metadata listing denied",
        "MetadataNotObserved" => "Metadata listing unverified",
        "KeyUnavailable" => "Protection keys unavailable",
        "Throttled" => "Provider rate limit reached",
        _ => "Connection test failed"
    };

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
