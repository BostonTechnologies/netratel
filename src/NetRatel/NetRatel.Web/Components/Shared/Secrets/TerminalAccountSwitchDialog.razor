@using NetRatel.Shared.Contracts.Secrets

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2">Switching starts a fresh shell. Commands, working state and scrollback stay with the current shell.</MudText>
            <ExecutionAccountPicker TenantId="TenantId" AgentId="AgentId" ForTerminal="true" Value="_selection"
                DefaultLabel="Choose an account" IncludeServiceAccount="true" OnChanged="AccountChanged" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(_requested is null)">Switch account</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int TenantId { get; set; }
    [Parameter] public Guid AgentId { get; set; }
    private Guid? _selection;
    private ExecutionIdentitySetting? _requested;

    private void AccountChanged(ExecutionAccountOption? option)
    {
        _selection = option?.Id;
        _requested = option switch
        {
            null => null,
            { Mode: ExecutionIdentityMode.AgentServiceAccount } => new(ExecutionIdentityMode.AgentServiceAccount),
            _ => new(option.Mode, option.Id)
        };
    }

    private void Save()
    {
        if (_requested is not null) Dialog.Close(DialogResult.Ok(_requested));
    }
}
