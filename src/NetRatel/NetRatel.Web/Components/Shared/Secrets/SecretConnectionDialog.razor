@using NetRatel.Shared.Contracts.Secrets
@using NetRatel.Web.Services.Tenants
@inject SecretVaultApi Vault
@inject IDialogService Dialogs
@implements IDisposable

<NavigationLock ConfirmExternalNavigation="@(_dirty || _saving)" OnBeforeInternalNavigation="BeforeLeaveAsync" />
<MudDialog Class="secret-vault-dialog">
    <DialogContent>
        <MudStack Spacing="2" Class="secret-vault-content">
            @if (_error is not null) { <MudAlert Dense="true" Severity="Severity.Error" role="alert">@_error</MudAlert> }
            <div class="vault-form-fields">
                <MudSelect T="SecretProviderKind" Value="_kind" ValueChanged="ChangeProvider" Label="Provider type" Disabled="@Fixed"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@SecretProviderKind.AzureKeyVault">Azure Key Vault</MudSelectItem>
                    <MudSelectItem Value="@SecretProviderKind.OpenBao">OpenBao KV v2</MudSelectItem>
                    <MudSelectItem Value="@SecretProviderKind.Infisical">Infisical</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_name" @bind-Value:after="MarkDirty" Label="Connection name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudTextField @bind-Value="_endpoint" @bind-Value:after="MarkDirty" Label="@(_kind == SecretProviderKind.AzureKeyVault ? "Vault name or HTTPS URI" : "HTTPS origin")"
                              ReadOnly="Fixed" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                @if (_kind == SecretProviderKind.AzureKeyVault)
                {
                    <MudCheckBox @bind-Value="_managed" @bind-Value:after="MarkDirty" Label="Use explicitly configured managed identity" Disabled="Fixed" />
                    @if (!_managed)
                    {
                        <MudTextField @bind-Value="_directory" @bind-Value:after="MarkDirty" Label="Entra directory tenant ID" ReadOnly="Fixed"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    }
                    <MudTextField @bind-Value="_client" @bind-Value:after="MarkDirty" Label="Application client ID" ReadOnly="Fixed"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                }
                else if (_kind == SecretProviderKind.OpenBao)
                {
                    <MudTextField @bind-Value="_mount" @bind-Value:after="MarkDirty" Label="KV v2 mount" ReadOnly="Fixed" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    <MudTextField @bind-Value="_base" @bind-Value:after="MarkDirty" Label="Allowed base path" ReadOnly="Fixed" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    <MudTextField @bind-Value="_authMount" @bind-Value:after="MarkDirty" Label="AppRole authentication mount" ReadOnly="Fixed" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                }
                else
                {
                    <MudTextField @bind-Value="_project" @bind-Value:after="MarkDirty" Label="Project ID" ReadOnly="Fixed" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    <MudTextField @bind-Value="_environment" @bind-Value:after="MarkDirty" Label="Environment slug" ReadOnly="Fixed" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    <MudTextField @bind-Value="_base" @bind-Value:after="MarkDirty" Label="Allowed secret path" ReadOnly="Fixed" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    <MudTextField @bind-Value="_client" @bind-Value:after="MarkDirty" Label="Universal Auth client ID" ReadOnly="Fixed" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                }
            </div>
            @if (_kind == SecretProviderKind.OpenBao)
            {
                <div class="vault-form-fields">
                    <MudTextField @bind-Value="_role" @bind-Value:after="MarkDirty" Label="AppRole Role ID" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="new-password" Immediate="true" />
                    <MudTextField @bind-Value="_secretId" @bind-Value:after="MarkDirty" Label="AppRole Secret ID" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="new-password" Immediate="true" />
                </div>
            }
            else if (!_managed || _kind != SecretProviderKind.AzureKeyVault)
            {
                <MudTextField @bind-Value="_secret" @bind-Value:after="MarkDirty" Label="Client secret" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="new-password" Immediate="true" />
            }
            @if (Connection?.HasStoredAuthentication == true)
            {
                <MudText Typo="Typo.caption">Leave an authentication field empty to keep its stored value.</MudText>
            }
            @if (Fixed)
            {
                <MudText Typo="Typo.caption">To change provider scope, add a connection and rebind the saved references that use this one.</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelAsync" Disabled="_saving">Cancel</MudButton>
        <MudButton OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_saving || !_dirty)">Save connection</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int TenantId { get; set; }
    [Parameter] public SecretProviderConnection? Connection { get; set; }
    [Parameter] public CancellationToken OwnerLifetime { get; set; }
    private CancellationTokenSource _lifetime = default!;
    private CancellationTokenRegistration _owner;
    private SecretProviderKind _kind = SecretProviderKind.AzureKeyVault;
    private string? _name, _endpoint, _directory, _client, _project, _environment, _mount = "secret", _base, _authMount = "approle";
    private string? _secret, _role, _secretId, _error;
    private bool _managed, _saving, _dirty;
    private bool Fixed => Connection is not null;

    protected override async Task OnInitializedAsync()
    {
        _lifetime = CancellationTokenSource.CreateLinkedTokenSource(OwnerLifetime);
        _owner = OwnerLifetime.Register(() => _ = InvokeAsync(ForceClose));
        await Dialog.SetOptionsAsync(Dialog.Options with { CloseOnEscapeKey = false, CloseOnNavigation = false });
        if (Connection?.Configuration is not { } config) return;
        (_kind, _name, _endpoint, _directory, _client, _managed) = (Connection.Kind, Connection.DisplayName, config.Endpoint, config.DirectoryTenantId, config.ClientId, config.ManagedIdentity);
        (_project, _environment, _mount, _base, _authMount) = (config.ProjectId, config.Environment, config.Mount, config.BasePath, config.AuthenticationMount);
    }

    private void MarkDirty() => _dirty = true;
    private void ChangeProvider(SecretProviderKind kind)
    {
        _kind = kind;
        (_endpoint, _directory, _client, _project, _environment, _base) = (null, null, null, null, null, null);
        _managed = false;
        Scrub();
        MarkDirty();
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        var ct = _lifetime.Token;
        (_saving, _error) = (true, null);
        try
        {
            if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_endpoint))
                throw new SecretVaultUiException("Enter the connection name and provider origin.");
            var request = new SaveSecretProviderRequest
            {
                Kind = _kind, DisplayName = _name, ExpectedRevision = Connection?.Revision,
                Configuration = new(_endpoint, _directory, _client, _managed, _mount, _base, _authMount, _project, _environment),
                ClientSecret = _kind != SecretProviderKind.OpenBao && !(_kind == SecretProviderKind.AzureKeyVault && _managed) ? AuthenticationInput(_secret) : null,
                RoleId = _kind == SecretProviderKind.OpenBao ? AuthenticationInput(_role) : null,
                SecretId = _kind == SecretProviderKind.OpenBao ? AuthenticationInput(_secretId) : null
            };
            var saved = await Vault.SaveConnectionAsync(TenantId, Connection?.Id, request, ct);
            Scrub();
            _dirty = false;
            if (!ct.IsCancellationRequested) Dialog.Close(DialogResult.Ok(saved));
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        catch (SecretVaultUiException error) { _error = error.Message; }
        catch (HttpRequestException) { _error = "The vault is temporarily unavailable. Refresh the saved connection before retrying."; }
        finally { _saving = false; }
    }

    private static string? AuthenticationInput(string? value) => string.IsNullOrEmpty(value) ? null : value;
    private async Task<bool> VerifyDiscardAsync() => !_saving && (!_dirty || await Dialogs.ShowMessageBoxAsync("Unsaved connection",
        "Discard the changes to this provider connection?", yesText: "Discard", cancelText: "Keep editing") == true);
    private async Task CancelAsync() { if (await VerifyDiscardAsync()) ForceClose(); }
    private async Task BeforeLeaveAsync(LocationChangingContext location)
    {
        if (!await VerifyDiscardAsync()) location.PreventNavigation();
        else ForceClose();
    }
    private void Scrub() => (_secret, _role, _secretId) = (null, null, null);
    private void ForceClose() { Scrub(); Dialog.Cancel(); }
    public void Dispose() { _owner.Dispose(); _lifetime.Cancel(); _lifetime.Dispose(); Scrub(); }
}
