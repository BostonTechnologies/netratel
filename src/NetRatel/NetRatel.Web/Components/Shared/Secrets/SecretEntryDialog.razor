@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using NetRatel.Shared.Contracts.Secrets
@using NetRatel.Web.Services.Tenants
@inject SecretVaultApi Vault
@implements IDisposable

<MudDialog Class="secret-vault-dialog">
    <DialogContent>
        <MudStack Spacing="2" Class="secret-vault-content">
            <MudText Typo="Typo.subtitle2">@Connection.DisplayName</MudText>
            @if (Locator is not null)
            {
                <MudText Typo="Typo.body2" Class="vault-wrap">@(_entry?.Entry.Name ?? Locator)</MudText>
            }
            @if (_error is not null)
            {
                <MudAlert Dense="true" Severity="Severity.Error" role="alert">@_error</MudAlert>
            }
            @if (_busy)
            {
                <MudProgressLinear Indeterminate="true" aria-label="Working with secret entry" />
            }
            @if (Intent == SecretEntryIntent.Edit && (Locator is null || _entry is not null))
            {
                @if (Connection.Kind == SecretProviderKind.Local || Locator is null)
                {
                    <MudTextField @bind-Value="_name" Label="Secret name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                }
                @if (Connection.Kind != SecretProviderKind.OpenBao)
                {
                    <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                }
                @if (Connection.Kind == SecretProviderKind.AzureKeyVault)
                {
                    <MudCheckBox @bind-Value="_enabled" Label="Enabled" />
                }
                @if (Connection.Capabilities.StructuredFields)
                {
                    @foreach (var field in _fields)
                    {
                        <MudPaper @key="field" Outlined="true" Class="pa-3">
                            <MudStack Spacing="1">
                                <MudTextField @bind-Value="field.Name" ReadOnly="field.Existing" Label="Field name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                @if (!field.Remove)
                                {
                                    <MudSelect T="string" @bind-Value="field.Type" Label="Field type" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem T="string" Value="@("text")">Text</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("number")">Number</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("boolean")">Boolean</MudSelectItem>
                                    </MudSelect>
                                    <MudTextField @bind-Value="field.Value" Label="Replacement value" InputType="InputType.Password" Variant="Variant.Outlined"
                                        Margin="Margin.Dense" Immediate="true" autocomplete="new-password" />
                                }
                                @if (field.Existing)
                                {
                                    <MudCheckBox @bind-Value="field.Remove" Label="Remove this field" />
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" OnClick="@(() => _fields.Remove(field))">Remove field</MudButton>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddField">Add field</MudButton>
                }
                else
                {
                    @if (Locator is not null) { <MudCheckBox @bind-Value="_replace" Label="Replace the stored value" /> }
                    @if (_replace || Locator is null)
                    {
                        <MudTextField @bind-Value="_value" Label="Secret value" InputType="InputType.Password" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Immediate="true" autocomplete="new-password" />
                        <label class="vault-wrap">Load a UTF-8 value from a file <InputFile OnChange="ReadValueAsync" /></label>
                    }
                }
                @if (Connection.Capabilities.WriteConcurrency == SecretWriteConcurrency.BestEffort && Locator is not null)
                {
                    <MudText Typo="Typo.caption">The provider checks the observed version before saving.</MudText>
                }
            }
            else if (_entry is { } details)
            {
                @if (details.Entry.Version is { } version) { <MudText Typo="Typo.caption" Class="vault-wrap">Current version @version</MudText> }
                @if (details.UsedBy.Length > 0)
                {
                    <MudText Typo="Typo.subtitle2">Used by</MudText>
                    <MudText Typo="Typo.body2" Class="vault-wrap">@string.Join(", ", details.UsedBy)</MudText>
                }
                @if (Intent is SecretEntryIntent.Reveal or SecretEntryIntent.Select)
                {
                    <MudSelect T="SecretVersionMode" Value="_versionMode" ValueChanged="VersionModeChangedAsync" Label="Version selection"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@SecretVersionMode.LatestAtExecution">@(Intent == SecretEntryIntent.Select ? "Latest at execution" : "Latest")</MudSelectItem>
                        <MudSelectItem Value="@SecretVersionMode.Pinned">Pinned version</MudSelectItem>
                    </MudSelect>
                    @if (_versionMode == SecretVersionMode.Pinned)
                    {
                        <MudTextField T="string" Value="_version" ValueChanged="VersionChangedAsync" Label="Exact version"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@VersionsHelp(details)" />
                    }
                    @if (Connection.Capabilities.StructuredFields)
                    {
                        <MudSelect T="string" @bind-Value="_field" @bind-Value:after="HideValue" Label="Field" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var field in details.Fields) { <MudSelectItem T="string" Value="@field.Name">@field.Name</MudSelectItem> }
                        </MudSelect>
                    }
                }
                @if (_revealed is not null)
                {
                    <pre class="vault-revealed" aria-label="Revealed secret value">@_revealed.Value</pre>
                    <MudButton Size="Size.Small" OnClick="HideValue">Hide value</MudButton>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Close</MudButton>
        @if (Intent == SecretEntryIntent.Edit)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || (Locator is not null && _entry is null))" OnClick="SaveAsync">Save secret</MudButton>
        }
        else if (Intent is SecretEntryIntent.Select or SecretEntryIntent.Reveal)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || !_referenceValidated)" OnClick="SelectOrRevealAsync">
                @(Intent == SecretEntryIntent.Select ? "Use reference" : "Reveal value")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int TenantId { get; set; }
    [Parameter, EditorRequired] public SecretProviderConnection Connection { get; set; } = default!;
    [Parameter] public string? Locator { get; set; }
    [Parameter] public string Folder { get; set; } = "";
    [Parameter] public SecretEntryIntent Intent { get; set; }
    [Parameter] public SecretReference? Current { get; set; }
    [Parameter] public CancellationToken OwnerLifetime { get; set; }

    private CancellationTokenSource _lifetime = default!;
    private CancellationTokenRegistration _closeWhenOwnerEnds;
    private SecretEntryDetails? _entry;
    private RevealedSecret? _revealed;
    private readonly List<FieldDraft> _fields = [];
    private string? _name, _description, _value, _field, _version, _error;
    private bool _replace, _enabled = true, _busy, _referenceValidated;
    private SecretVersionMode _versionMode;

    protected override async Task OnInitializedAsync()
    {
        _lifetime = CancellationTokenSource.CreateLinkedTokenSource(OwnerLifetime);
        _closeWhenOwnerEnds = OwnerLifetime.Register(() => _ = InvokeAsync(Cancel));
        if (Locator is null)
        {
            if (Connection.Capabilities.StructuredFields) AddField();
            return;
        }
        if (Current is { } current && current.ConnectionId == Connection.Id && current.Locator == Locator)
            (_versionMode, _version, _field) = (current.VersionMode, current.Version, current.Field);
        await LoadAsync();
        if (_entry is { } details)
        {
            (_name, _description, _enabled) = (details.Entry.Name, details.Entry.Description, details.Entry.Enabled != false);
            if (Intent == SecretEntryIntent.Edit)
                _fields.AddRange(details.Fields.Select(field => new FieldDraft { Name = field.Name, Existing = true }));
        }
    }

    private Task LoadAsync() => ExecuteAsync(async ct =>
    {
        var version = _versionMode == SecretVersionMode.Pinned ? _version : null;
        _referenceValidated = false;
        _entry = await Vault.EntryAsync(TenantId, Connection.Id, Locator!, version, ct);
        _referenceValidated = _versionMode == SecretVersionMode.LatestAtExecution || !string.IsNullOrEmpty(version);
        if (!_entry.Fields.Any(field => field.Name == _field))
            _field = _entry.Fields.Length == 1 ? _entry.Fields[0].Name : null;
    });

    private Task VersionModeChangedAsync(SecretVersionMode mode)
    {
        _versionMode = mode;
        _version ??= _entry?.Entry.Version;
        HideValue();
        return LoadAsync();
    }

    private Task VersionChangedAsync(string? version)
    {
        _version = version?.Trim();
        HideValue();
        return LoadAsync();
    }

    private static string VersionsHelp(SecretEntryDetails details) => details.Versions.Length == 0 ? "Enter a provider version identifier." :
        "Observed versions: " + string.Join(", ", details.Versions.Take(4));

    private void AddField() => _fields.Add(new FieldDraft());

    private Task ReadValueAsync(InputFileChangeEventArgs change) => ExecuteAsync(async ct =>
    {
        await using var stream = change.File.OpenReadStream(128 * 1024, ct);
        using var reader = new StreamReader(stream, new UTF8Encoding(false, true), detectEncodingFromByteOrderMarks: false);
        _value = await reader.ReadToEndAsync(ct);
    });

    private Task SaveAsync() => ExecuteAsync(async ct =>
    {
        if (Locator is null && string.IsNullOrWhiteSpace(_name))
            throw new SecretVaultUiException("Enter a secret name.");
        var local = Connection.Kind == SecretProviderKind.Local;
        var changes = BuildFields();
        var request = new WriteSecretEntryRequest
        {
            Locator = Locator ?? (local ? null : string.IsNullOrEmpty(Folder) ? _name : $"{Folder}/{_name}"),
            Name = local ? _name : null,
            ExpectedRevision = _entry?.Entry.Revision,
            ExpectedVersion = _entry?.Entry.Version,
            Value = !Connection.Capabilities.StructuredFields && (_replace || Locator is null) ? _value ?? "" : null,
            Description = Connection.Capabilities.StructuredFields ? null : _description ?? "",
            Enabled = Connection.Kind == SecretProviderKind.AzureKeyVault ? _enabled : null,
            Fields = Connection.Capabilities.StructuredFields ? changes : null,
            RemoveFields = Connection.Capabilities.StructuredFields ? _fields.Where(x => x.Remove).Select(x => x.Name!).ToArray() : null
        };
        var saved = await Vault.WriteAsync(TenantId, Connection.Id, request, ct);
        Scrub();
        if (!ct.IsCancellationRequested) Dialog.Close(DialogResult.Ok(saved));
    });

    private Dictionary<string, JsonElement> BuildFields()
    {
        var fields = new Dictionary<string, JsonElement>(StringComparer.Ordinal);
        foreach (var field in _fields.Where(x => !x.Remove && (!x.Existing || x.Value is not null)))
        {
            if (string.IsNullOrWhiteSpace(field.Name) || fields.ContainsKey(field.Name))
                throw new SecretVaultUiException("Enter a distinct name for each changed field.");
            fields.Add(field.Name, field.Type == "text" ? JsonSerializer.SerializeToElement(field.Value ?? "") : ParseField(field));
        }
        return fields;
    }

    private static JsonElement ParseField(FieldDraft field)
    {
        try
        {
            using var json = JsonDocument.Parse(field.Value ?? "");
            var value = json.RootElement;
            if (field.Type == "number" && value.ValueKind == JsonValueKind.Number ||
                field.Type == "boolean" && value.ValueKind is JsonValueKind.True or JsonValueKind.False)
                return value.Clone();
        }
        catch (JsonException) { throw new SecretVaultUiException("Enter a valid number or Boolean value for the selected field type."); }
        throw new SecretVaultUiException("The field value does not match its selected type.");
    }

    private Task SelectOrRevealAsync() => ExecuteAsync(async ct =>
    {
        if ((_versionMode == SecretVersionMode.Pinned && string.IsNullOrWhiteSpace(_version)) ||
            (Connection.Capabilities.StructuredFields && _field is null))
            throw new SecretVaultUiException("Select the required version and field.");
        var reference = new SecretReference(SecretReference.CurrentSchemaVersion, Connection.Id, Locator!, _field,
            _versionMode, _versionMode == SecretVersionMode.Pinned ? _version : null);
        if (Intent == SecretEntryIntent.Select)
            Dialog.Close(DialogResult.Ok(reference));
        else
        {
            var revealed = await Vault.RevealAsync(TenantId, reference, ct);
            if (!ct.IsCancellationRequested) _revealed = revealed;
        }
    });

    private async Task ExecuteAsync(Func<CancellationToken, Task> action)
    {
        if (_busy || _lifetime.IsCancellationRequested) return;
        var ct = _lifetime.Token;
        (_busy, _error) = (true, null);
        try { await action(ct); }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        catch (SecretVaultUiException error) { _error = error.Message; }
        catch (HttpRequestException) { _error = "The vault is temporarily unavailable."; }
        catch (IOException) { _error = "Choose a readable UTF-8 file no larger than 128 KiB."; }
        catch (DecoderFallbackException) { _error = "The selected file is not valid UTF-8."; }
        finally { _busy = false; }
    }

    private void HideValue() => _revealed = null;
    private void Scrub()
    {
        (_revealed, _value) = (null, null);
        foreach (var field in _fields) field.Value = null;
    }
    private void Cancel() { Scrub(); Dialog.Cancel(); }
    public void Dispose()
    {
        _closeWhenOwnerEnds.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
        Scrub();
    }

    private sealed class FieldDraft
    {
        public string? Name { get; set; }
        public string? Value { get; set; }
        public string Type { get; set; } = "text";
        public bool Existing { get; init; }
        public bool Remove { get; set; }
    }
}
