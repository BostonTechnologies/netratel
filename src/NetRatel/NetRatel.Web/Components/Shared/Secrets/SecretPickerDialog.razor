@using NetRatel.Shared.Contracts.Secrets
@using NetRatel.Web.Services.Tenants
@inject SecretVaultApi Vault
@implements IDisposable

<MudDialog Class="secret-vault-dialog">
    <DialogContent>
        <MudStack Spacing="2" Class="secret-vault-content">
            @if (_error is not null)
            {
                <MudAlert Dense="true" Severity="Severity.Error" role="alert">@_error</MudAlert>
            }
            else if (_permissions is { } permissions)
            {
                @if (Mode == SecretBrowserMode.PickSecret)
                {
                    <MudSelect T="Guid" @bind-Value="_connectionId" Label="Secret provider" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var connection in _connections) { <MudSelectItem T="Guid" Value="connection.Id">@connection.DisplayName</MudSelectItem> }
                    </MudSelect>
                }
                <SecretBrowser TenantId="TenantId" Connection="@_connections.SingleOrDefault(x => x.Id == _connectionId)" Permissions="permissions"
                    Mode="Mode" Current="Current" Selected="Select" CredentialSelected="SelectCredential" TargetAgentId="TargetAgentId" ForTerminal="ForTerminal" />
            }
            else
            {
                <MudProgressLinear Indeterminate="true" aria-label="Loading vault permissions" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions><MudButton OnClick="Dialog.Cancel">Cancel</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int TenantId { get; set; }
    [Parameter] public SecretReference? Current { get; set; }
    [Parameter] public SecretBrowserMode Mode { get; set; } = SecretBrowserMode.PickSecret;
    [Parameter] public Guid? TargetAgentId { get; set; }
    [Parameter] public bool ForTerminal { get; set; }
    [Parameter] public CancellationToken OwnerLifetime { get; set; }
    private CancellationTokenSource _lifetime = default!;
    private CancellationTokenRegistration _owner;
    private SecretVaultPermissions? _permissions;
    private SecretProviderConnection[] _connections = [];
    private Guid _connectionId;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _lifetime = CancellationTokenSource.CreateLinkedTokenSource(OwnerLifetime);
        _owner = OwnerLifetime.Register(() => _ = InvokeAsync(Dialog.Cancel));
        var ct = _lifetime.Token;
        try
        {
            var permissions = await Vault.PermissionsAsync(TenantId, ct);
            if (!permissions.Browse || !permissions.Use || Mode == SecretBrowserMode.PickCredential && !permissions.RunAs)
            {
                _error = "Your account cannot select this kind of reference for this tenant.";
                return;
            }
            if (Mode == SecretBrowserMode.PickSecret)
            {
                _connections = (await Vault.ConnectionsAsync(TenantId, ct)).Where(x => x.Enabled).ToArray();
                _connectionId = _connections.FirstOrDefault(x => x.Id == Current?.ConnectionId)?.Id ??
                    _connections.FirstOrDefault(x => x.IsDefault)?.Id ?? Guid.Empty;
            }
            _permissions = permissions;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        catch (SecretVaultUiException error) { _error = error.Message; }
        catch (HttpRequestException) { _error = "The vault is temporarily unavailable."; }
    }

    private void Select(SecretReference reference) => Dialog.Close(DialogResult.Ok(reference));
    private void SelectCredential(CredentialProfile credential) => Dialog.Close(DialogResult.Ok(credential));
    public void Dispose() { _owner.Dispose(); _lifetime.Cancel(); _lifetime.Dispose(); }
}
