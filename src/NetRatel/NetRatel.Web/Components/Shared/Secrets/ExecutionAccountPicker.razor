@using NetRatel.Shared.Contracts.Secrets
@using NetRatel.Web.Services.Tenants
@using NetRatel.Web.Services.Jobs
@implements IDisposable
@inject IServiceProvider Services

@if (_available)
{
    <MudSelect T="Guid?" Label="@Label" Variant="Variant.Outlined" Margin="Margin.Dense"
               Value="@Value" ValueChanged="ChooseAsync" Disabled="@(Disabled || _loading || _error is not null)" FullWidth="true">
        <MudSelectItem T="Guid?" Value="@((Guid?)null)">@DefaultLabel</MudSelectItem>
        @if (IncludeServiceAccount)
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)Guid.Empty)">Agent service account</MudSelectItem>
        }
        @if (Value is { } selected && selected != Guid.Empty && !VisibleOptions.Any(option => option.Id == selected))
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)selected)" Disabled="true">Saved account unavailable</MudSelectItem>
        }
        @foreach (var option in VisibleOptions)
        {
            <MudSelectItem T="Guid?" @key="option.Id" Value="@((Guid?)option.Id)">@option.DisplayName</MudSelectItem>
        }
    </MudSelect>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="Loading execution accounts" />
    }
    else if (_error is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" role="status">@_error</MudText>
    }
}

@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter] public Guid? AgentId { get; set; }
    [Parameter] public bool ForTerminal { get; set; }
    [Parameter] public IReadOnlyList<Guid>? TargetIds { get; set; }
    [Parameter] public Guid? ExecutionGroupId { get; set; }
    [Parameter] public string Label { get; set; } = "Run as";
    [Parameter] public string DefaultLabel { get; set; } = "Client default";
    [Parameter] public bool IncludeServiceAccount { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<ExecutionAccountOption?> OnChanged { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private (int Tenant, Guid? Agent, bool Terminal, Guid? Group) _scope;
    private ExecutionAccountOption[] _options = [];
    private IReadOnlyList<Guid>? _groupMembers;
    private bool _available, _loading;
    private string? _error;
    private IEnumerable<ExecutionAccountOption> VisibleOptions => (_groupMembers ?? TargetIds) is { Count: > 0 } targets
        ? _options.Where(option => option.AgentIds.Any(targets.Contains)) : _options;

    protected override async Task OnParametersSetAsync()
    {
        var scope = (TenantId, AgentId, ForTerminal, ExecutionGroupId);
        if (scope == _scope) return;
        _scope = scope;
        _options = [];
        _groupMembers = null;
        _error = null;
        _available = TenantId > 0 && Services.GetService(typeof(SecretVaultApi)) is SecretVaultApi;
        if (!_available) return;
        var vault = (SecretVaultApi)Services.GetService(typeof(SecretVaultApi))!;
        _loading = true;
        var ct = _lifetime.Token;
        try
        {
            var options = await vault.ExecutionAccountsAsync(scope.TenantId, scope.AgentId, scope.ForTerminal, ct);
            IReadOnlyList<Guid>? members = null;
            if (scope.ExecutionGroupId is { } group && Services.GetService(typeof(JobTargetsApiClient)) is JobTargetsApiClient targets)
                members = (await targets.GetGroupAsync(scope.TenantId, group, ct)).Members.Select(member => member.AgentId).ToArray();
            if (_scope == scope && !ct.IsCancellationRequested) (_options, _groupMembers) = (options, members);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        catch (Exception error) when (error is SecretVaultUiException or HttpRequestException or InvalidOperationException)
        {
            if (_scope == scope) _error = error is SecretVaultUiException ? error.Message : "Execution accounts could not be loaded.";
        }
        finally { if (_scope == scope) _loading = false; }
    }

    private Task ChooseAsync(Guid? id) => OnChanged.InvokeAsync(id switch
    {
        null => null,
        { } service when service == Guid.Empty && IncludeServiceAccount => new(Guid.Empty, "Agent service account", ExecutionIdentityMode.AgentServiceAccount, []),
        _ => VisibleOptions.SingleOrDefault(option => option.Id == id)
    });

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
