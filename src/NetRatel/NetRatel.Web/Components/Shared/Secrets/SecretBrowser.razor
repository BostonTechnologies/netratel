@using NetRatel.Shared.Contracts.Secrets
@using NetRatel.Web.Services.Tenants
@inject SecretVaultApi Vault
@inject IDialogService Dialogs
@implements IDisposable

@if (!Active)
{
    @* Disposing the active browser clears its dialogs and cancels its requests. *@
}
else if (Mode == SecretBrowserMode.PickCredential || ShowCredentials)
{
    <CredentialProfileBrowser @key="TenantId" TenantId="TenantId" Permissions="Permissions" SelectMode="@(Mode == SecretBrowserMode.PickCredential)"
                              TargetAgentId="TargetAgentId" ForTerminal="ForTerminal" OnSelected="CredentialSelected" />
}
else if (Connection is { Enabled: true } connection && Permissions.Browse)
{
    <section class="vault-browser" aria-label="Secrets" data-testid="secret-browser">
        <div class="vault-toolbar">
            <MudTextField T="string" Value="_search" ValueChanged="SearchChangedAsync" DebounceInterval="300" Immediate="true"
                          Label="Search secrets" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
            <div class="vault-actions">
                <MudTooltip Text="Refresh secrets">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh secrets" OnClick="RefreshAsync" Disabled="_busy" />
                </MudTooltip>
                @if (CanManage)
                {
                    <MudTooltip Text="Create secret">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" aria-label="Create secret"
                                       OnClick="@(() => OpenEntryAsync(null, SecretEntryIntent.Edit))" />
                    </MudTooltip>
                }
            </div>
        </div>
        @if (connection.Kind is SecretProviderKind.OpenBao or SecretProviderKind.Infisical)
        {
            <nav aria-label="Secret folder" class="vault-folder">
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => OpenFolderAsync(string.Empty))">Provider root</MudButton>
                @if (_folder.Length > 0)
                {
                    <MudTooltip Text="Parent folder">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-label="Parent folder" OnClick="OpenParentAsync" />
                    </MudTooltip>
                    <span>@_folder</span>
                }
            </nav>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert>
        }
        @if (_busy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading secret metadata" />
        }
        @if (_entries.Length > 0)
        {
            <table class="vault-table">
                <thead><tr><th scope="col">Name</th><th scope="col">Version</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                    @foreach (var entry in _entries)
                    {
                        <tr @key="(entry.Locator, entry.IsFolder)">
                            <td>
                                @if (entry.IsFolder)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.Folder" Size="Size.Small" OnClick="@(() => OpenFolderAsync(entry.Locator))">@entry.Name</MudButton>
                                }
                                else
                                {
                                    <strong>@entry.Name</strong>
                                    @if (entry.Description is not null) { <span class="vault-caption">@entry.Description</span> }
                                }
                            </td>
                            <td class="vault-entry-version">@entry.Version</td>
                            <td class="vault-entry-status">
                                @(entry.IsFolder ? "Folder" : entry.Enabled is false ? "Unavailable" : "Secret")
                                @if (entry.UpdatedAtUtc is { } updated) { <span class="vault-caption">@updated.ToLocalTime().ToString("g")</span> }
                            </td>
                            <td>
                                @if (!entry.IsFolder)
                                {
                                    <div class="vault-actions">
                                    @if (Mode == SecretBrowserMode.PickSecret)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(!Permissions.Use)"
                                                   OnClick="@(() => OpenEntryAsync(entry, SecretEntryIntent.Select))">Select</MudButton>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="Secret details"><MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small"
                                            aria-label="Secret details" OnClick="@(() => OpenEntryAsync(entry, SecretEntryIntent.Details))" /></MudTooltip>
                                        @if (Permissions.Reveal)
                                        {
                                            <MudTooltip Text="Reveal value"><MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                aria-label="Reveal value" OnClick="@(() => OpenEntryAsync(entry, SecretEntryIntent.Reveal))" /></MudTooltip>
                                        }
                                        @if (CanManage)
                                        {
                                            <MudTooltip Text="Edit secret"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                aria-label="Edit secret" OnClick="@(() => OpenEntryAsync(entry, SecretEntryIntent.Edit))" /></MudTooltip>
                                            <MudTooltip Text="Delete secret"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                aria-label="Delete secret" Disabled="_busy" OnClick="@(() => DeleteAsync(entry))" /></MudTooltip>
                                        }
                                    }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (!_busy && _error is null)
        {
            <MudText Typo="Typo.body2" role="status">@(_search is { Length: > 0 } ? "No matches in this result scope." : "This folder has no secrets.")</MudText>
        }
        <div class="vault-footer">
            <span role="status">@_searchScope @(_truncated ? "Results are limited to the provider's bounded folder listing." : "")</span>
            @if (_next is not null)
            {
                <MudButton Size="Size.Small" Disabled="_busy" OnClick="NextAsync">More results</MudButton>
            }
        </div>
    </section>
}
else
{
    <MudText Typo="Typo.body2" role="status">@(Permissions.Browse ? "Select an enabled provider to browse its secrets." : "Your account cannot browse secrets in this tenant.")</MudText>
}

@code {
    [Parameter, EditorRequired] public int TenantId { get; set; }
    [Parameter] public SecretProviderConnection? Connection { get; set; }
    [Parameter, EditorRequired] public SecretVaultPermissions Permissions { get; set; } = default!;
    [Parameter] public SecretBrowserMode Mode { get; set; }
    [Parameter] public bool ShowCredentials { get; set; }
    [Parameter] public bool Active { get; set; } = true;
    [Parameter] public bool ForTerminal { get; set; }
    [Parameter] public Guid? TargetAgentId { get; set; }
    [Parameter] public SecretReference? Current { get; set; }
    [Parameter] public EventCallback<SecretReference> Selected { get; set; }
    [Parameter] public EventCallback<CredentialProfile> CredentialSelected { get; set; }

    private CancellationTokenSource _session = new();
    private CancellationTokenSource? _query;
    private (int TenantId, Guid? ConnectionId, long? Revision, bool Active, bool Credentials) _scope;
    private SecretEntryMetadata[] _entries = [];
    private string _folder = "";
    private string? _search, _next, _error, _searchScope;
    private bool _truncated, _busy;
    private bool CanManage => Mode == SecretBrowserMode.Manage && Permissions.Manage;

    protected override async Task OnParametersSetAsync()
    {
        var next = (TenantId, Connection?.Id, Connection?.Revision, Active, ShowCredentials || Mode == SecretBrowserMode.PickCredential);
        if (_scope == next)
            return;
        _scope = next;
        _session.Cancel();
        _session.Dispose();
        _session = new();
        (_folder, _search, _entries, _next, _error) = ("", null, [], null, null);
        if (Active && !next.Item5 && Permissions.Browse && Connection is { Enabled: true })
            await RefreshAsync();
    }

    private Task RefreshAsync() => LoadAsync(nextPage: false);
    private Task NextAsync() => LoadAsync(nextPage: true);
    private Task SearchChangedAsync(string? search) { _search = search; return RefreshAsync(); }
    private Task OpenFolderAsync(string folder) { _folder = folder; return RefreshAsync(); }
    private Task OpenParentAsync()
    {
        var separator = _folder.LastIndexOf('/');
        return OpenFolderAsync(separator < 0 ? "" : _folder[..separator]);
    }

    private async Task LoadAsync(bool nextPage)
    {
        if (!Active || Connection is not { Enabled: true } connection)
            return;
        if (!nextPage) (_entries, _next) = ([], null);
        _query?.Cancel();
        _query?.Dispose();
        _query = CancellationTokenSource.CreateLinkedTokenSource(_session.Token);
        var token = _query.Token;
        (_busy, _error) = (true, null);
        try
        {
            var result = await Vault.BrowseAsync(TenantId, connection.Id, _folder, _search, nextPage ? _next : null, token);
            if (!token.IsCancellationRequested)
            {
                _entries = nextPage ? _entries.Concat(result.Entries).DistinctBy(x => (x.Locator, x.IsFolder)).ToArray() : result.Entries;
                (_next, _truncated, _searchScope) = (result.NextCursor, result.Truncated, result.SearchScope);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (SecretVaultUiException error) { if (!token.IsCancellationRequested) _error = error.Message; }
        catch (HttpRequestException) { if (!token.IsCancellationRequested) _error = "The vault is temporarily unavailable."; }
        finally { if (!token.IsCancellationRequested) _busy = false; }
    }

    private async Task OpenEntryAsync(SecretEntryMetadata? entry, SecretEntryIntent intent)
    {
        if (Connection is not { } connection)
            return;
        var token = _session.Token;
        var dialog = await Dialogs.ShowAsync<SecretEntryDialog>(intent switch
        {
            SecretEntryIntent.Edit => entry is null ? "Create secret" : "Edit secret",
            SecretEntryIntent.Select => "Select secret reference",
            SecretEntryIntent.Reveal => "Reveal secret value",
            _ => "Secret details"
        }, new DialogParameters<SecretEntryDialog>
        {
            { x => x.TenantId, TenantId }, { x => x.Connection, connection }, { x => x.Locator, entry?.Locator },
            { x => x.Folder, _folder }, { x => x.Intent, intent }, { x => x.Current, Current }, { x => x.OwnerLifetime, token }
        }, SecretVaultPresentation.Options);
        var result = await dialog.Result;
        if (token.IsCancellationRequested || result is null || result.Canceled)
            return;
        if (result.Data is SecretReference reference)
            await Selected.InvokeAsync(reference);
        else if (intent == SecretEntryIntent.Edit)
            await RefreshAsync();
    }

    private async Task DeleteAsync(SecretEntryMetadata row)
    {
        if (Connection is not { } connection)
            return;
        var tenant = TenantId;
        var token = _session.Token;
        (_busy, _error) = (true, null);
        try
        {
            var entry = (await Vault.EntryAsync(tenant, connection.Id, row.Locator, null, token)).Entry;
            if (entry.Revision is null || entry.Version is null)
                throw new SecretVaultUiException("Refresh the secret version before deleting it.");
            var plan = await Vault.PreviewRemovalAsync(tenant, new(VaultRemovalKind.Secret, connection.Id, connection.Revision,
                new(entry.Locator, entry.Revision, entry.Version)), token);
            var approved = await Dialogs.ShowMessageBoxAsync("Review secret deletion", SecretVaultPresentation.Removal(plan),
                yesText: "Delete secret", cancelText: "Cancel");
            if (approved != true || token.IsCancellationRequested)
                return;
            var result = await Vault.ConfirmRemovalAsync(tenant, plan, token);
            await RefreshAsync();
            if (result.Secret?.Pending == true && !token.IsCancellationRequested)
                _searchScope = "The provider accepted the deletion and is still processing it.";
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (SecretVaultUiException error) { if (!token.IsCancellationRequested) _error = error.Message; }
        catch (HttpRequestException) { if (!token.IsCancellationRequested) _error = "Refresh the vault before retrying deletion."; }
        finally { if (!token.IsCancellationRequested) _busy = false; }
    }

    public void Dispose()
    {
        _query?.Cancel();
        _query?.Dispose();
        _session.Cancel();
        _session.Dispose();
    }
}
