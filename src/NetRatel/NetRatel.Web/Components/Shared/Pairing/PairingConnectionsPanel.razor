@using System.Text.RegularExpressions
@using NetRatel.Shared.SystemPairing
@using NetRatel.Web.Services.Pairing
@implements IDisposable
@inject IPairingApiClient Api
@inject IJSRuntime JS

<section class="pairing-connections" data-testid="system-connections">
    <div class="pairing-toolbar">
        <MudTextField T="string" Label="Search system connections" @bind-Value="_search" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="pairing-search" />
        <MudSelect T="string" Label="Status" @bind-Value="_statusFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pairing-filter">
            <MudSelectItem T="string" Value='@("all")'>All (@_connections.Length)</MudSelectItem>
            <MudSelectItem T="string" Value='@("connected")'>Configured (@_connections.Count(Connected))</MudSelectItem>
            <MudSelectItem T="string" Value='@("attention")'>Needs attention (@_connections.Count(x => !Connected(x)))</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="GenerateAsync" Disabled="@_busy" data-testid="generate-pairing-code">Generate a Pairing Code</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Link" OnClick="OpenCreate" Disabled="@(_busy || _loading)" data-testid="create-connection">Create Connection</MudButton>
    </div>
    @if (_error is not null && !_createOpen) { <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="pairing-error">@_error</MudAlert> }
    @if (_notice is not null) { <MudText Typo="Typo.body2" Color="Color.Success" Class="mb-3" data-testid="pairing-success">@_notice</MudText> }
    @if (_loading) { <MudSkeleton Height="80px" /> }
    else if (_connections.Length == 0) { <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="pairing-empty">No system connections yet.</MudText> }
    else
    {
        <div class="pairing-grid">
            @foreach (var connection in VisibleConnections)
            {
                var testing = _testing.Contains(Key(connection));
                <MudPaper Class="pairing-card" Elevation="0" Outlined="true" data-testid="connection-card" @key="Key(connection)">
                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                        <div class="pairing-heading"><MudText Typo="Typo.subtitle2">@(connection.Mapping?.Name ?? $"NetRatel ↔ {connection.Peer.Name}")</MudText><MudText Typo="Typo.caption">@connection.Peer.WebOrigin</MudText></div>
                        <MudChip T="string" Size="Size.Small" Color="@(Connected(connection) ? Color.Success : Color.Warning)">@Status(connection)</MudChip>
                    </MudStack>
                    @if (connection.Mapping is { } mapping)
                    {
                        <MudText Typo="Typo.body2" Class="mt-1">@ChoiceName(connection.PairId, mapping.NetRatelTenantId, true) → @ChoiceName(connection.PairId, mapping.RatelDeskOrganizationId, false)@(mapping.RatelDeskCustomerId is { } customer ? $" · {CustomerName(connection.PairId, customer)}" : "")</MudText>
                        <MudText Typo="Typo.caption">@Capabilities(mapping)</MudText>
                    }
                    <div aria-live="polite">
                        @if (testing) { <MudText Typo="Typo.caption">Testing connection…</MudText> }
                        else if (connection.LastTest is { } result) { <MudText Typo="Typo.caption" Color="@(result.Success ? Color.Success : Color.Error)" data-testid="connection-test-result">@result.Message · @result.TestedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</MudText> }
                        else { <MudText Typo="Typo.caption">Not tested</MudText> }
                    </div>
                    @if (_rowErrors.TryGetValue(Key(connection), out var rowError)) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1" data-testid="connection-error">@rowError</MudAlert> }
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => ViewAsync(connection))" Disabled="@(_busy || _deleting.Contains(Key(connection)))" data-testid="connection-view">@(Connected(connection) ? "View" : "Continue setup")</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => TestAsync(connection))" Disabled="@(_busy || testing || connection.Mapping is null || _deleting.Contains(Key(connection)))" data-testid="connection-test">Test connection</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(() => _deleteTarget = connection)" Disabled="@_deleting.Contains(Key(connection))" data-testid="connection-delete">Delete connection</MudButton>
                    </MudStack>
                </MudPaper>
            }
        </div>
        @if (!VisibleConnections.Any()) { <MudText Typo="Typo.body2">No matching connections.</MudText> }
    }
</section>

<MudDialog Visible="@(_code is not null)" VisibleChanged="CodeVisibleChanged" AriaLabel="System pairing code" Options="ReviewOptions" ContentStyle="max-height:65dvh;overflow-y:auto">
    <TitleContent><MudText Typo="Typo.h6">System pairing code</MudText></TitleContent>
    <DialogContent>
        @if (_code is { } generatedCode)
        {
            <div class="pairing-code" data-testid="pairing-code-panel">
                <MudTextField T="string" Label="Pairing code" Value="@generatedCode.Code" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pairing-short-code" data-testid="generated-pairing-code" />
                <MudText Typo="Typo.caption">Expires @generatedCode.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC · single use</MudText>
                @if (_clipboardError) { <MudText Typo="Typo.caption">Clipboard access is unavailable. Select and copy the code above.</MudText> }
            </div>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _code = null)">Close</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyCodeAsync">Copy</MudButton></DialogActions>
</MudDialog>
<MudDialog Visible="_createOpen" VisibleChanged="CreateVisibleChanged" AriaLabel="Create Connection" Options="ReviewOptions" ContentStyle="max-height:65dvh;overflow-y:auto">
    <TitleContent><MudText Typo="Typo.h6">Create Connection</MudText></TitleContent>
    <DialogContent>
        <div class="pairing-form" data-testid="pairing-create-form">
            <MudTextField T="string" Label="Address" @bind-Value="_address" Immediate="true" Disabled="@_busy" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="https://desk.example.test" data-testid="pairing-address" />
            <MudTextField T="string" Label="Pairing code" @bind-Value="_pairingCode" Immediate="true" Disabled="@_busy" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="XXXX-XXXX" Class="pairing-short-code mt-2" data-testid="pairing-code" autocomplete="off" />
            @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" data-testid="pairing-error">@_error</MudAlert> }
        </div>
    </DialogContent>
    <DialogActions><MudButton OnClick="CloseCreate" Disabled="@_busy">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanPair || _busy)" OnClick="PairAsync" data-testid="pair-and-connect">@(_busy ? "Pairing…" : "Pair & connect")</MudButton></DialogActions>
</MudDialog>
<MudDialog Visible="@(_selected is not null)" VisibleChanged="ConfigurationVisibleChanged" AriaLabel="Connection configuration" Options="ReviewOptions" ContentStyle="max-height:65dvh;overflow-y:auto">
    <TitleContent><MudText Typo="Typo.h6">@(_selected?.Mapping is null ? "Systems paired" : "Connection configuration")</MudText></TitleContent>
    <DialogContent>
        @if (_selected is { } selected)
        {
            <div class="pairing-form" data-testid="pairing-final-form">
                <MudText Typo="Typo.body2" Class="mb-2">@selected.Peer.Name · @selected.Peer.WebOrigin</MudText>
                @if (_directoryLoading) { <MudProgressLinear Indeterminate="true" /><MudText Typo="Typo.body2">Loading available tenants and organizations…</MudText> }
                @if (_directoryError is not null) { <MudAlert Severity="Severity.Error" Dense="true" data-testid="pairing-directory-error">@_directoryError <MudButton Size="Size.Small" OnClick="ReloadDirectoryAsync" Disabled="@_busy">Retry</MudButton></MudAlert> }
                @if (_tenantHintUnavailable) { <MudText Typo="Typo.body2" Color="Color.Warning" data-testid="pairing-tenant-hint-error">The linked tenant is unavailable. Choose an available tenant explicitly; no mapping has changed.</MudText> }
                <div class="pairing-tenant-grid">
                    <MudSelect T="string" Label="NetRatel tenant" Value="@_netRatelTenant" ValueChanged="TenantChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_busy || _directoryLoading || _directory is null)" data-testid="pairing-netratel-tenant">
                        @foreach (var tenant in _directory?.NetRatelTenants ?? []) { <MudSelectItem T="string" Value="@tenant.Id">@tenant.Name</MudSelectItem> }
                    </MudSelect>
                    <MudSelect T="string" Label="RatelDesk tenant / organization" Value="@_organization" ValueChanged="OrganizationChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_busy || _directoryLoading || _directory is null)" data-testid="pairing-rateldesk-organization">
                        @foreach (var organization in _directory?.RatelDeskOrganizations ?? []) { <MudSelectItem T="string" Value="@organization.Id">@organization.Name</MudSelectItem> }
                    </MudSelect>
                </div>
                @if (_createIncidents)
                {
                    <MudSelect T="string" Label="RatelDesk customer" Value="@_customer" ValueChanged="CustomerChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_busy || _directoryLoading || _directory is null)" Class="mt-2" data-testid="pairing-rateldesk-customer">
                        @foreach (var customer in Customers) { <MudSelectItem T="string" Value="@customer.Id">@customer.Name</MudSelectItem> }
                    </MudSelect>
                }
                <MudTextField T="string" Label="Connection name" @bind-Value="_name" Immediate="true" Disabled="@_busy" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" MaxLength="128" data-testid="pairing-connection-name" />
                <MudCheckBox T="bool" Value="@_createIncidents" ValueChanged="IncidentsChanged" Disabled="@_busy" Label="Create incidents — NetRatel → RatelDesk" Dense="true" data-testid="pairing-create-incidents" />
                <MudCheckBox T="bool" @bind-Value="_runAutomation" Disabled="@_busy" Label="Run automation — RatelDesk → NetRatel" Dense="true" data-testid="pairing-run-automation" />
                @if (_saveError is not null) { <MudAlert Severity="Severity.Error" Dense="true" data-testid="pairing-save-error">@_saveError</MudAlert> }
            </div>
        }
    </DialogContent>
    <DialogActions><MudButton Disabled="@_busy" OnClick="CloseConfiguration">Close</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !CanSave)" OnClick="SaveAsync" data-testid="pairing-save">Save</MudButton></DialogActions>
</MudDialog>
<MudDialog Visible="@(_deleteTarget is not null)" VisibleChanged="DeleteVisibleChanged" AriaLabel="Delete system connection" Options="ReviewOptions">
    <TitleContent><MudText Typo="Typo.h6">Delete system connection?</MudText></TitleContent>
    <DialogContent><MudText>@(_deleteTarget?.Mapping?.Name ?? _deleteTarget?.Peer.Name)</MudText><MudText Typo="Typo.body2">This removes the selected connection and revokes its local access.</MudText></DialogContent>
    <DialogActions><MudButton OnClick="@(() => _deleteTarget = null)">Cancel</MudButton><MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmDeleteAsync" data-testid="confirm-connection-delete">Delete connection</MudButton></DialogActions>
</MudDialog>

@code {
    [Parameter] public int? InitialTenantId { get; set; }
    private static readonly DialogOptions ReviewOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false, CloseOnEscapeKey = false };
    private string _search = "", _statusFilter = "all";
    private PairingConnectionDto? _deleteTarget;
    private readonly HashSet<string> _testing = new(StringComparer.Ordinal);
    private IEnumerable<PairingConnectionDto> VisibleConnections => _connections.Where(x =>
        (_statusFilter == "all" || (_statusFilter == "connected") == Connected(x)) &&
        (string.IsNullOrWhiteSpace(_search) || string.Join(" ", x.Mapping?.Name, x.Peer.Name, x.Peer.WebOrigin,
            x.Mapping is { } m ? ChoiceName(x.PairId, m.NetRatelTenantId, true) + " " + ChoiceName(x.PairId, m.RatelDeskOrganizationId, false) : "")
            .Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)));
    private void CodeVisibleChanged(bool visible) { if (!visible) _code = null; }
    private void CreateVisibleChanged(bool visible) { if (!visible) CloseCreate(); }
    private void ConfigurationVisibleChanged(bool visible) { if (!visible && !_busy) CloseConfiguration(); }
    private void DeleteVisibleChanged(bool visible) { if (!visible) _deleteTarget = null; }
    private async Task ConfirmDeleteAsync() { if (_deleteTarget is not { } target) return; _deleteTarget = null; await DeleteAsync(target); }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly Dictionary<string, PairingDirectories> _directories = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _rowErrors = new(StringComparer.Ordinal);
    private readonly HashSet<string> _deleted = new(StringComparer.Ordinal), _deleting = new(StringComparer.Ordinal);
    private PairingConnectionDto[] _connections = [];
    private PairingConnectionDto? _selected;
    private PairingDirectories? _directory;
    private PairingCodeResponse? _code;
    private string _address = "", _pairingCode = "", _name = "", _netRatelTenant = "", _organization = "", _customer = "";
    private string? _error, _saveError, _notice, _directoryError, _operationInput;
    private Guid _operationId = Guid.NewGuid(), _mappingId;
    private bool _loading = true, _busy, _createOpen, _createIncidents, _runAutomation, _directoryLoading, _clipboardError, _disposed, _tenantHintUnavailable;
    private int _selectionGeneration, _listGeneration;
    private bool CanPair => TryNormalizeAddress(_address, out _) && Regex.IsMatch(_pairingCode.Trim(), "^[A-Za-z0-9]{4}-?[A-Za-z0-9]{4}$");
    private IEnumerable<PairingChoice> Customers => (_directory?.Customers ?? []).Where(x => x.ParentId == _organization);
    private bool CanSave => _directory is not null && !_directoryLoading && !string.IsNullOrWhiteSpace(_name) && _name.Length <= 128 &&
        _directory.NetRatelTenants.Any(x => x.Id == _netRatelTenant) && _directory.RatelDeskOrganizations.Any(x => x.Id == _organization) &&
        (_createIncidents || _runAutomation) && (!_createIncidents || Customers.Any(x => x.Id == _customer));

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var generation = ++_listGeneration; _loading = true; _error = null;
        try
        {
            var connections = await Api.ListAsync(_lifetime.Token);
            if (_disposed || generation != _listGeneration) return;
            _connections = connections.Where(x => !Deleted(x)).ToArray();
            await Task.WhenAll(_connections.Where(x => x.Mapping is not null).Select(x => x.PairId).Distinct().Select(LoadNamesAsync));
            if (_disposed || generation != _listGeneration) return;
        }
        catch (Exception e) when (Expected(e)) { if (!_disposed && generation == _listGeneration) _error = Failure(e); }
        finally { if (!_disposed && generation == _listGeneration) _loading = false; }
    }
    private async Task LoadNamesAsync(string pairId)
    {
        try { var directory = await Api.DirectoryAsync(pairId, _lifetime.Token); if (!_disposed) _directories[pairId] = directory; }
        catch (Exception e) when (Expected(e)) { /* View reloads directory and shows its failure; cards remain deletable. */ }
    }
    private void OpenCreate()
    {
        if (_busy || _disposed) return;
        CloseConfiguration(); _code = null; _createOpen = true; _error = _notice = null; _address = _pairingCode = "";
        _operationId = Guid.NewGuid(); _operationInput = null;
    }
    private void CloseCreate() { if (_busy) return; _createOpen = false; _pairingCode = ""; }
    private async Task GenerateAsync()
    {
        if (_busy || _disposed) return;
        _busy = true; _error = _notice = null; _code = null; _clipboardError = false;
        try { var code = await Api.GenerateCodeAsync(_lifetime.Token); if (!_disposed) _code = code; }
        catch (Exception e) when (Expected(e)) { if (!_disposed) _error = Failure(e); }
        finally { if (!_disposed) _busy = false; }
    }
    private async Task CopyCodeAsync()
    {
        if (_code is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _code.Code); _clipboardError = false; }
        catch (JSException) { _clipboardError = true; }
    }
    private async Task PairAsync()
    {
        if (_busy || !CanPair || _disposed || !TryNormalizeAddress(_address, out var address)) return;
        var code = _pairingCode.Trim().ToUpperInvariant(); var input = address + "\n" + code;
        if (_operationInput is not null && _operationInput != input) _operationId = Guid.NewGuid();
        _operationInput = input; _busy = true; _error = _notice = null;
        try
        {
            var connection = await Api.ConnectAsync(new(address, code, _operationId), _lifetime.Token);
            if (_disposed || Deleted(connection)) return;
            Upsert(connection); _pairingCode = ""; _operationInput = null; _createOpen = false; _notice = "Systems paired.";
            await ViewAsync(connection);
        }
        catch (Exception e) when (Expected(e)) { if (!_disposed) _error = Failure(e); }
        finally { if (!_disposed) _busy = false; }
    }
    private async Task ViewAsync(PairingConnectionDto connection)
    {
        if (_disposed || Deleted(connection)) return;
        var generation = ++_selectionGeneration;
        _selected = connection; _saveError = _directoryError = null; _createOpen = false; _pairingCode = ""; _tenantHintUnavailable = false;
        _mappingId = connection.Mapping?.Id ?? Guid.NewGuid(); _name = connection.Mapping?.Name ?? $"NetRatel ↔ {connection.Peer.Name}";
        _netRatelTenant = connection.Mapping?.NetRatelTenantId ?? ""; _organization = connection.Mapping?.RatelDeskOrganizationId ?? ""; _customer = connection.Mapping?.RatelDeskCustomerId ?? "";
        _createIncidents = connection.Mapping?.CreateIncidents ?? false; _runAutomation = connection.Mapping?.RunAutomation ?? false; _directory = null;
        await LoadDirectoryAsync(connection, generation);
    }
    private Task ReloadDirectoryAsync() => _selected is { } selected ? LoadDirectoryAsync(selected, _selectionGeneration) : Task.CompletedTask;
    private async Task LoadDirectoryAsync(PairingConnectionDto connection, int generation)
    {
        _directoryLoading = true; _directoryError = null;
        try
        {
            var directory = await Api.DirectoryAsync(connection.PairId, _lifetime.Token);
            if (!CurrentSelection(connection, generation)) return;
            _directory = directory; _directories[connection.PairId] = directory;
            if (string.IsNullOrEmpty(_netRatelTenant))
            {
                var hint = InitialTenantId?.ToString(System.Globalization.CultureInfo.InvariantCulture);
                _tenantHintUnavailable = hint is not null && !directory.NetRatelTenants.Any(x => x.Id == hint);
                _netRatelTenant = _tenantHintUnavailable ? "" : hint ?? directory.NetRatelTenants.FirstOrDefault()?.Id ?? "";
            }
            if (string.IsNullOrEmpty(_organization)) _organization = directory.RatelDeskOrganizations.FirstOrDefault()?.Id ?? "";
        }
        catch (Exception e) when (Expected(e)) { if (CurrentSelection(connection, generation)) _directoryError = Failure(e); }
        finally { if (CurrentSelection(connection, generation)) _directoryLoading = false; }
    }
    private void CloseConfiguration() { _selectionGeneration++; _selected = null; _directory = null; _directoryLoading = false; _saveError = _directoryError = null; }
    private void TenantChanged(string value) { _netRatelTenant = value; _saveError = null; _tenantHintUnavailable = false; }
    private void OrganizationChanged(string value) { _organization = value; _customer = ""; _saveError = null; }
    private void CustomerChanged(string value) { _customer = value; _saveError = null; }
    private void IncidentsChanged(bool value) { _createIncidents = value; _saveError = null; }
    private async Task SaveAsync()
    {
        if (_busy || _disposed || _selected is not { } selected || !CanSave) return;
        var generation = _selectionGeneration;
        var mapping = new PairingMapping(_mappingId, selected.PairId, _name.Trim(), _netRatelTenant, _organization, _createIncidents ? _customer : null, _createIncidents, _runAutomation);
        _busy = true; _saveError = _notice = null;
        try
        {
            var connection = await Api.SaveAsync(mapping, _lifetime.Token);
            if (!CurrentSelection(selected, generation) || Deleted(connection)) return;
            Upsert(connection); _selected = connection;
            if (Connected(connection)) { _notice = "Connected. The selected mapping and capabilities are active."; CloseConfiguration(); }
            else _saveError = "The systems are paired, but activation did not complete. Review the selected resources and retry Save. Reference: mapping-not-active.";
        }
        catch (Exception e) when (Expected(e)) { if (CurrentSelection(selected, generation)) _saveError = Failure(e); }
        finally { if (!_disposed) _busy = false; }
    }
    private async Task TestAsync(PairingConnectionDto connection)
    {
        if (_disposed || Deleted(connection) || connection.Mapping is null || !_testing.Add(Key(connection))) return;
        _rowErrors.Remove(Key(connection));
        try
        {
            var result = await Api.TestAsync(connection, _lifetime.Token);
            if (!_disposed && !Deleted(connection) && _connections.FirstOrDefault(x => Key(x) == Key(connection)) is { } current)
            {
                // A response about the prior mapping must not overwrite new configuration or certify it.
                if (current.Mapping == connection.Mapping) Upsert(current with { LastTest = result });
            }
        }
        catch (Exception e) when (Expected(e)) { if (!_disposed && !Deleted(connection)) _rowErrors[Key(connection)] = Failure(e); }
        finally { if (!_disposed) _testing.Remove(Key(connection)); }
    }
    private async Task DeleteAsync(PairingConnectionDto connection)
    {
        var key = Key(connection); if (_disposed || !_deleting.Add(key)) return; _rowErrors.Remove(key);
        try
        {
            await Api.DeleteAsync(connection, _lifetime.Token);
            if (_disposed) return;
            _deleted.Add(key); _listGeneration++; _loading = false; _connections = _connections.Where(x => Key(x) != key).ToArray();
            if (_selected is { } selected && (Key(selected) == key || selected.PairId == connection.PairId && connection.Mapping is null)) CloseConfiguration();
            _notice = "Connection deleted. Its local access has been revoked.";
        }
        catch (Exception e) when (Expected(e)) { if (!_disposed) _rowErrors[key] = Failure(e); }
        finally { if (!_disposed) _deleting.Remove(key); }
    }
    private void Upsert(PairingConnectionDto connection)
    {
        if (Deleted(connection)) return;
        _connections = _connections.Where(x => Key(x) != Key(connection) && !(x.PairId == connection.PairId && x.Mapping is null && connection.Mapping is not null)).Append(connection).OrderBy(x => x.Mapping?.Name ?? x.Peer.Name).ToArray();
    }
    private bool CurrentSelection(PairingConnectionDto connection, int generation) => !_disposed && generation == _selectionGeneration && !Deleted(connection) && _selected?.PairId == connection.PairId;
    private bool Deleted(PairingConnectionDto connection) => _deleted.Contains(Key(connection)) || _deleted.Contains("pair:" + connection.PairId) || _deleting.Contains(Key(connection)) || _deleting.Contains("pair:" + connection.PairId);
    private static string Key(PairingConnectionDto connection) => connection.Mapping is { } mapping ? "mapping:" + mapping.Id.ToString("D") : "pair:" + connection.PairId;
    private static bool Connected(PairingConnectionDto connection) => connection.Mapping is not null && connection.Status.Equals("connected", StringComparison.OrdinalIgnoreCase);
    private static string Status(PairingConnectionDto connection) => Connected(connection) ? "Connected" : connection.Mapping is null ? "Needs attention · paired" : "Needs attention";
    private static string Capabilities(PairingMapping mapping) => string.Join(" · ", new[] { mapping.CreateIncidents ? "Create incidents · NetRatel → RatelDesk" : null, mapping.RunAutomation ? "Run automation · RatelDesk → NetRatel" : null }.Where(x => x is not null));
    private string ChoiceName(string pairId, string id, bool netRatel) => _directories.TryGetValue(pairId, out var directory) ? (netRatel ? directory.NetRatelTenants : directory.RatelDeskOrganizations).FirstOrDefault(x => x.Id == id)?.Name ?? $"Unavailable ({id})" : $"Unavailable ({id})";
    private string CustomerName(string pairId, string id) => _directories.TryGetValue(pairId, out var directory) ? directory.Customers.FirstOrDefault(x => x.Id == id)?.Name ?? $"Unavailable customer ({id})" : $"Unavailable customer ({id})";
    private static bool Expected(Exception e) => e is PairingApiException or HttpRequestException or IOException or OperationCanceledException or System.Text.Json.JsonException;
    private static string Failure(Exception e) => e is PairingApiException api ? $"{api.Message} Reference: {api.Code} / {api.Reference}." : $"The request did not complete. Check the system's availability, then retry this operation; your draft is retained. Reference: {Guid.NewGuid():N}.";
    internal static bool TryNormalizeAddress(string value, out string address)
    {
        address = value.Trim(); if (!address.Contains("://", StringComparison.Ordinal)) address = "https://" + address;
        if (!Uri.TryCreate(address, UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https") || string.IsNullOrWhiteSpace(uri.Host) || !string.IsNullOrEmpty(uri.UserInfo) || !string.IsNullOrEmpty(uri.Query) || !string.IsNullOrEmpty(uri.Fragment)) { address = ""; return false; }
        address = uri.AbsoluteUri.TrimEnd('/'); return true;
    }
    public void Dispose()
    {
