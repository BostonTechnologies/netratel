@using NetRatel.Shared.Contracts.Netclaw
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime JS

<section @ref="_surface" class="netclaw-conversation chat-canvas ai-conversation @(_fullscreen ? "netclaw-fullscreen" : "")"
         role="@(_fullscreen ? "dialog" : "region")" aria-modal="@(_fullscreen ? "true" : null)" aria-label="Netclaw conversation" tabindex="-1" data-testid="netclaw-conversation" @onkeydown="SurfaceKeyDown">
    <header class="chat-conversation-heading">
        <div class="chat-assistant-identity"><span class="chat-avatar"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" /></span><div><h2>@Snapshot.Investigation.Title</h2><p>@TenantName · @StateLabel(Snapshot.Investigation.State)</p></div></div>
        <div class="netclaw-header-actions">
            @if (Snapshot.Investigation.State != InvestigationState.Archived && CanInvestigate)
            {
                <MudTooltip Text="Archive conversation"><MudIconButton Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" OnClick="() => _archive = !_archive" Disabled="Busy" aria-label="Archive chat" /></MudTooltip>
            }
            <MudTooltip Text="@(_fullscreen ? "Restore conversation" : "Maximise conversation")">
                <MudIconButton Icon="@(_fullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" Size="Size.Small" OnClick="ToggleFullscreen" aria-label="@(_fullscreen ? "Restore conversation" : "Maximise conversation")" data-testid="conversation-fullscreen" />
            </MudTooltip>
            <div class="netclaw-display-settings">
                <MudTooltip Text="Chat display settings"><MudIconButton Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" OnClick="() => _settings = !_settings" aria-label="Chat display settings" aria-expanded="@_settings" Class="netclaw-display-trigger" /></MudTooltip>
                @if (_settings) {
                <div class="netclaw-display-panel">
                    <strong>Chat display settings</strong><small>Compact tool rows</small>
                    <label><input type="checkbox" @bind="_display.ShowTimestamps" @bind:after="SaveDisplay" />Timestamps</label>
                    <label><input type="checkbox" @bind="_display.ShowCallIds" @bind:after="SaveDisplay" />Call IDs on rows</label>
                    <label><input type="checkbox" @bind="_display.ExpandDetails" @bind:after="SaveDisplay" />Expand details automatically</label>
                    <label><input type="checkbox" @bind="_display.ShowUsage" @bind:after="SaveDisplay" />Token usage</label>
                    <label><input type="checkbox" @bind="_display.ShowProcessing" @bind:after="SaveDisplay" />Processing trace</label>
                    <label><input type="checkbox" @bind="_display.ShowCompaction" @bind:after="SaveDisplay" />Compaction</label>
                    <label><input type="checkbox" @bind="_display.ShowSubagents" @bind:after="SaveDisplay" />Subagent activity</label>
                </div>
                }
            </div>
        </div>
    </header>
    <div class="netclaw-scroll-area" @ref="_transcript" role="log" aria-label="Saved chat messages" aria-live="polite" aria-relevant="additions text">
        @if (Context is not null) { <div class="netclaw-context">@Context</div> }
        @if (_archive)
        {
            <div class="chat-notice chat-archive-confirmation"><div><strong>Archive this conversation?</strong><p>The saved transcript and previous actions are preserved.</p>
                @if (Snapshot.Investigation.State != InvestigationState.Idle) { <label class="chat-check"><input type="checkbox" @bind="_acknowledge" />I understand that the current Netclaw turn may still be running and its side effects may be unconfirmed.</label> }
            </div><div class="chat-notice-actions"><button type="button" class="chat-secondary-button" @onclick="() => _archive = false">Keep open</button><button type="button" class="chat-primary-button" @onclick="ArchiveAsync" disabled="@(Busy || Snapshot.Investigation.State != InvestigationState.Idle && !_acknowledge)">Archive chat</button></div></div>
        }
        <div class="chat-transcript ai-transcript">
            @foreach (var item in Events)
            {
                @if (item.Type is "operator" or "assistant" or "assistant_recovered")
                {
                    <article @key="item.Sequence" class="chat-message @(item.Type == "operator" ? "chat-message-operator" : "chat-message-assistant")">
                        <header><strong>@(item.Type == "operator" ? "Operator" : "Netclaw")</strong><time datetime="@item.CreatedAtUtc.ToString("O")" title="@item.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")">@item.CreatedAtUtc.UtcDateTime.ToString("HH:mm 'UTC'")</time></header>
                        @if (item.Type == "operator") { <div class="chat-operator-text">@item.Text</div> }
                        else { @if (item.Type == "assistant_recovered") { <small>Recovered history excerpt · original timestamp and completeness unavailable</small> } <ChatMessageContent Text="@item.Text" /> }
                    </article>
                }
                else if (item.Type is "tool_call" or "tool_result" or "error" or "artifact" || VisibleOptional(item.Type))
                { <NetclawTraceRow @key="item.Sequence" Event="item" Events="Events" Display="_display" /> }
                else if (item.Type != "approval_request" && item.Type is not ("usage" or "processing_state" or "compaction" or "subagent"))
                { <p @key="item.Sequence" class="chat-timeline">@item.Text</p> }
            }
            @if (Snapshot.Draft is { Length: > 0 } draft)
            { <article class="chat-message chat-message-assistant chat-draft"><header><strong>Netclaw</strong><span class="chat-working-label">Writing…</span></header><ChatMessageContent Text="@draft" IsStreaming="true" /></article> }
            @if (Cursor < Snapshot.LastSequence) { <button type="button" class="chat-secondary-button chat-load-more" @onclick="LoadMore" disabled="Busy">Load more saved messages</button> }
        </div>
        @if (Snapshot.Investigation.State == InvestigationState.AwaitingApproval)
        {
            @foreach (var approval in Snapshot.PendingApprovals)
            {
                var detail = Events.LastOrDefault(x => x.Type == "approval_request" && x.CallId == approval.CallId);
                <div class="chat-approval" role="status" @key="approval.CallId"><strong>Netclaw needs your decision</strong><p>@(detail?.Text ?? "Load the saved request details before making a decision.")</p>
                    @if (detail?.Trace is not null) { <NetclawTraceRow Event="detail" Display="_display" /> }
                    <div class="chat-notice-actions">
                        @if (detail is null && Cursor < Snapshot.LastSequence) { <button type="button" class="chat-secondary-button" @onclick="LoadMore" disabled="Busy">Load request details</button> }
                        @foreach (var option in approval.Options) { <button type="button" class="@(option.Key == "deny" ? "chat-secondary-button" : "chat-primary-button")" disabled="@(Busy || !CanInvestigate || detail is null)" @onclick="() => Approve.InvokeAsync((approval.CallId, option.Key))">@option.Label</button> }
                    </div>
                </div>
            }
        }
        @if (Snapshot.Investigation.State == InvestigationState.DeliveryUnknown)
        {
            <div class="chat-notice chat-recovery" role="status"><div><strong>Conversation outcome unconfirmed</strong><p>@(Snapshot.Recovery?.Summary ?? "Recover the saved session to check admission and completion evidence. A connected daemon does not establish completion of this conversation.")</p>
                @if (Snapshot.Recovery?.LastAttemptAtUtc is { } attempted) { <small>Last recovery attempt: @attempted.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</small> }
                <p>Nothing is resent. You can archive with the acknowledgement and start a new conversation after checking possible side effects.</p></div>
                <button type="button" class="chat-secondary-button" @onclick="Recover" disabled="@(Busy || !CanInvestigate)">@(Busy ? "Recovering…" : "Recover session")</button>
            </div>
        }
        @if (LiveError is not null) { <p class="chat-live-status" role="status">@LiveError</p> }
        @if (Snapshot.Investigation.State is InvestigationState.Processing or InvestigationState.Queued) { <p class="chat-processing" role="status">@(Snapshot.Investigation.State == InvestigationState.Queued ? "Message saved. Connecting to Netclaw…" : "Netclaw is working…")</p> }
    </div>
    @if (Snapshot.Investigation.State == InvestigationState.Archived)
    { <div class="chat-archived">This conversation is archived. Start a new conversation from the workspace.</div> }
    else if (ConnectionReady)
    {
        <div class="chat-composer-area"><div class="chat-composer">
            <label class="chat-visually-hidden" for="@_composerId">Message Netclaw</label>
            <textarea id="@_composerId" @ref="_composer" value="@Message" @oninput="InputMessage" @onchange="InputMessage" @onkeydown="KeyDown" placeholder="Message Netclaw…" maxlength="16000" rows="3" disabled="@(!CanEditMessage)" data-testid="chat-message"></textarea>
            <div class="chat-composer-toolbar"><span class="chat-composer-tenant">Netclaw · @TenantName</span><button type="button" class="chat-send-button" @onclick="SendMessage" disabled="@(!CanSend)" data-testid="chat-send">@SendLabel</button></div>
        </div><p class="chat-composer-hint">@(CanInvestigate ? "Ctrl / ⌘ + Enter to send · Enter for a new line" : "Your current access allows you to read saved conversations.")</p></div>
    }
    else { <div class="chat-archived">Enable this tenant’s Netclaw connection to continue chatting.</div> }
</section>

@code {
    [Parameter, EditorRequired] public InvestigationSnapshotDto Snapshot { get; set; } = default!;
    [Parameter] public IReadOnlyList<InvestigationEventDto> Events { get; set; } = [];
    [Parameter] public string? TenantName { get; set; }
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public EventCallback<string> MessageChanged { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CanInvestigate { get; set; }
    [Parameter] public bool ConnectionReady { get; set; } = true;
    [Parameter] public bool CanEditMessage { get; set; }
    [Parameter] public bool CanSend { get; set; }
    [Parameter] public string SendLabel { get; set; } = "Send";
    [Parameter] public string? LiveError { get; set; }
    [Parameter] public RenderFragment? Context { get; set; }
    [Parameter] public EventCallback Send { get; set; }
    [Parameter] public EventCallback Recover { get; set; }
    [Parameter] public EventCallback LoadMore { get; set; }
    [Parameter] public EventCallback<bool> Archive { get; set; }
    [Parameter] public EventCallback<(string CallId, string Key)> Approve { get; set; }
    private readonly string _composerId = "netclaw-composer-" + Guid.NewGuid().ToString("N");
    private ElementReference _surface, _transcript, _composer;
    private IJSObjectReference? _module, _scroll;
    private DotNetObjectReference<NetclawConversation>? _reference;
    private ChatDisplayOptions _display = new();
    private bool _fullscreen, _archive, _acknowledge, _disposed, _settings;
    private long _renderedSequence = -1;
    private string? _renderedDraft;
    private bool _forceFollow;
    private async Task SendMessage() { _forceFollow = true; await Send.InvokeAsync(); }
    private long Cursor => Events.LastOrDefault()?.Sequence ?? 0;
    private bool VisibleOptional(string type) => type switch { "usage" => _display.ShowUsage, "processing_state" => _display.ShowProcessing, "compaction" => _display.ShowCompaction, "subagent" => _display.ShowSubagents, _ => false };
    private static string StateLabel(InvestigationState state) => state switch { InvestigationState.Idle => "Ready", InvestigationState.Processing => "Working", InvestigationState.AwaitingApproval => "Awaiting approval", InvestigationState.DeliveryUnknown => "Needs recovery", InvestigationState.Queued => "Queued", _ => "Archived" };
    private Task InputMessage(ChangeEventArgs e) => MessageChanged.InvokeAsync(e.Value?.ToString() ?? "");
    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Enter" && (e.CtrlKey || e.MetaKey) && CanSend ? SendMessage() : Task.CompletedTask;
    private async Task ArchiveAsync() { await Archive.InvokeAsync(_acknowledge); _archive = false; _acknowledge = false; }
    private async Task ToggleFullscreen() { _fullscreen = !_fullscreen; if (_module is not null) await _module.InvokeVoidAsync("setFullscreen", _surface, _fullscreen, _reference); }
    [JSInvokable] public async Task RestoreConversation() { if (_fullscreen && !_disposed) { await ToggleFullscreen(); await InvokeAsync(StateHasChanged); } }
    private Task SurfaceKeyDown(KeyboardEventArgs e) => e.Key == "Escape" && _settings ? CloseDisplaySettings() : Task.CompletedTask;
    [JSInvokable] public async Task CloseDisplaySettings() { _settings = false; await InvokeAsync(StateHasChanged); }
    private async Task SaveDisplay() { if (_module is not null) await _module.InvokeVoidAsync("saveDisplay", _display); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            if (firstRender)
            {
                _reference = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/netclaw-conversation.js");
                _display = await _module.InvokeAsync<ChatDisplayOptions?>("readDisplay") ?? new();
                _scroll = await JS.InvokeAsync<IJSObjectReference>("import", "./js/netclaw-chat.js");
                StateHasChanged();
            }
            if (_scroll is not null)
            {
                if (firstRender || _forceFollow || _renderedSequence != Snapshot.LastSequence || _renderedDraft != Snapshot.Draft)
                    await _scroll.InvokeVoidAsync("followOutput", _transcript, firstRender || _forceFollow);
                _renderedSequence = Snapshot.LastSequence; _renderedDraft = Snapshot.Draft; _forceFollow = false;
                if (Snapshot.Investigation.State != InvestigationState.Archived && ConnectionReady) await _scroll.InvokeVoidAsync("prepareComposer", _composer);
            }
        }
        catch (JSException) { /* The saved conversation remains usable when browser storage is unavailable. */ }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_module is not null) { await _module.InvokeVoidAsync("setFullscreen", _surface, false, _reference); await _module.DisposeAsync(); } if (_scroll is not null) await _scroll.DisposeAsync(); }
        catch (JSDisconnectedException) { /* Browser already disconnected. */ }
        _reference?.Dispose();
    }
}
