@using NetRatel.Application.Operations
<MudGrid Class="mt-2">
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Command duration (seconds)" Value="Value.MaxCommandDurationSeconds" ValueChanged="@(value => ChangedAsync(Value with { MaxCommandDurationSeconds = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Terminal idle (seconds)" Value="Value.MaxTerminalIdleSeconds" ValueChanged="@(value => ChangedAsync(Value with { MaxTerminalIdleSeconds = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Terminal lifetime (seconds)" Value="Value.MaxTerminalLifetimeSeconds" ValueChanged="@(value => ChangedAsync(Value with { MaxTerminalLifetimeSeconds = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Concurrent terminal sessions" Value="Value.MaxConcurrentTerminalSessions" ValueChanged="@(value => ChangedAsync(Value with { MaxConcurrentTerminalSessions = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Concurrent commands" Value="Value.MaxConcurrentCommands" ValueChanged="@(value => ChangedAsync(Value with { MaxConcurrentCommands = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Output bytes" Value="Value.MaxOutputBytes" ValueChanged="@(value => ChangedAsync(Value with { MaxOutputBytes = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Artifact bytes" Value="Value.MaxArtifactBytes" ValueChanged="@(value => ChangedAsync(Value with { MaxArtifactBytes = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Script bytes" Value="Value.MaxScriptBytes" ValueChanged="@(value => ChangedAsync(Value with { MaxScriptBytes = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Job target count" Value="Value.MaxJobTargetCount" ValueChanged="@(value => ChangedAsync(Value with { MaxJobTargetCount = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Task target count" Value="Value.MaxTaskTargetCount" ValueChanged="@(value => ChangedAsync(Value with { MaxTaskTargetCount = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Fan-out" Value="Value.MaxFanOut" ValueChanged="@(value => ChangedAsync(Value with { MaxFanOut = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Onboarding lifetime (seconds)" Value="Value.MaxOnboardingCodeLifetimeSeconds" ValueChanged="@(value => ChangedAsync(Value with { MaxOnboardingCodeLifetimeSeconds = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Onboarding uses" Value="Value.MaxOnboardingCodeUses" ValueChanged="@(value => ChangedAsync(Value with { MaxOnboardingCodeUses = value }))" Min="1" Disabled="Disabled" /></MudItem>
    <MudItem xs="12" md="4"><MudSelect T="McpOperatorConfirmationClass?" Label="Required confirmation" Value="Value.RequiredConfirmationClass" ValueChanged="@(value => ChangedAsync(Value with { RequiredConfirmationClass = value }))" Clearable="true" Disabled="Disabled">@foreach (var kind in Enum.GetValues<McpOperatorConfirmationClass>()) { <MudSelectItem T="McpOperatorConfirmationClass?" Value="@((McpOperatorConfirmationClass?)kind)">@kind</MudSelectItem> }</MudSelect></MudItem>
    <MudItem xs="12" md="4"><MudSelect T="bool?" Label="Destructive operations" Value="Value.DestructiveOperationsAllowed" ValueChanged="@(value => ChangedAsync(Value with { DestructiveOperationsAllowed = value }))" Clearable="true" Disabled="Disabled"><MudSelectItem T="bool?" Value="@((bool?)false)">Denied</MudSelectItem><MudSelectItem T="bool?" Value="@((bool?)true)">Allowed</MudSelectItem></MudSelect></MudItem>
    <MudItem xs="12" md="4"><MudSelect T="bool?" Label="Active tenant deletion" Value="Value.AllowActiveTenantDeletion" ValueChanged="@(value => ChangedAsync(Value with { AllowActiveTenantDeletion = value }))" Clearable="true" Disabled="Disabled"><MudSelectItem T="bool?" Value="@((bool?)false)">Denied</MudSelectItem><MudSelectItem T="bool?" Value="@((bool?)true)">Allowed</MudSelectItem></MudSelect></MudItem>
    <MudItem xs="12"><MudSelect T="McpOperatorTargetClassification" Label="Allowed target classifications" MultiSelection="true" SelectedValues="@(Value.AllowedTargetClassifications ?? [])" SelectedValuesChanged="@(values => ChangedAsync(Value with { AllowedTargetClassifications = values.ToArray() }))" Disabled="Disabled">@foreach (var classification in Enum.GetValues<McpOperatorTargetClassification>().Where(value => value != McpOperatorTargetClassification.Unknown)) { <MudSelectItem Value="classification">@classification</MudSelectItem> }</MudSelect></MudItem>
</MudGrid>
@code {
    [Parameter, EditorRequired] public McpOperatorConstraints Value { get; set; } = new();
    [Parameter] public EventCallback<McpOperatorConstraints> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private Task ChangedAsync(McpOperatorConstraints value) => ValueChanged.InvokeAsync(value);
}
