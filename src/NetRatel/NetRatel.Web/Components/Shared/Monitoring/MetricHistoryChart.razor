@using Microsoft.JSInterop
@using NetRatel.Shared.Contracts.Monitoring
@using NetRatel.Web.Services.Monitoring
@inject IJSRuntime JS
@inject ILogger<MetricHistoryChart> Logger
@implements IAsyncDisposable

<MudPaper Class="pa-4 metric-chart" Outlined="true" data-testid="@CardId">
    <MudText Typo="Typo.h6">@Title</MudText>
    @Controls
    @if (Series.Length == 0)
    {
        <p class="metric-empty">No loaded measurements for this selection.</p>
    }
    else
    {
        <div class="metric-statistics">
            @foreach (var row in Series)
            {
                var total = row.Summary;
                var label = SeriesLabel(row);
                <div class="metric-statistics-series" data-testid="@($"metrics-stats-{row.Series.Kind}")">
                    <strong>@label</strong>
                    <dl>
                        <dt>Last retained</dt><dd>@Value(total.Last, row) <small>@MetricHistoryPresentation.Time(total.LastObservedAtUtc, Zone)</small></dd>
                        <dt>Weighted average</dt><dd>@Value(total.WeightedAverage, row)</dd>
                        <dt>Observed peak</dt><dd>@Value(total.Maximum, row)</dd>
                        <dt>Coverage</dt><dd>@MetricHistoryPresentation.Duration(total.CoveredMicroseconds)</dd>
                        @if (row.Series.Kind == MetricHistoryKind.DiskUsedPercent && decimal.TryParse(total.DiskTotalBytes, out var capacity) &&
                            decimal.TryParse(total.DiskFreeBytes, out var free))
                        {
                            <dt>Volume capacity</dt><dd title="@($"{total.DiskTotalBytes} bytes")">@MetricHistoryPresentation.Bytes(total.DiskTotalBytes)</dd>
                            <dt>Free</dt><dd title="@($"{total.DiskFreeBytes} bytes")">@MetricHistoryPresentation.Bytes(total.DiskFreeBytes)</dd>
                            <dt>Used</dt><dd>@MetricHistoryPresentation.Bytes((capacity - free).ToString("0", System.Globalization.CultureInfo.InvariantCulture))</dd>
                        }
                    </dl>
                    @if (total.Quality != MetricHistoryQuality.None) { <small>@MetricHistoryPresentation.Quality(total.Quality)</small> }
                </div>
                @if (row.Series.Kind is MetricHistoryKind.NetworkRx or MetricHistoryKind.NetworkTx)
                {
                    <div class="metric-volume" data-testid="@(row.Series.Kind == MetricHistoryKind.NetworkRx ? "metrics-received" : "metrics-sent")">
                        <span>@(row.Series.Kind == MetricHistoryKind.NetworkRx ? "Received" : "Sent")</span>
                        <strong title="@ExactVolume(total.TransferredBytes)">@MetricHistoryPresentation.Bytes(total.TransferredBytes)</strong>
                        <small>@MetricHistoryPresentation.Duration(total.CoveredMicroseconds) covered · @MetricHistoryPresentation.Quality(total.Quality)</small>
                    </div>
                }
            }
        </div>
        @if (Series.Any(row => row.Points.Any(point => Plotted(point) is not null)))
        {
            <figure class="metrics-figure">
                <figcaption class="metrics-legend">
                    @for (var i = 0; i < Series.Length; i++)
                    {
                        <span class="@(i == 0 ? "metric-line-primary" : "metric-line-secondary")">@SeriesLabel(Series[i]) · @Series[i].Series.Unit</span>
                    }
                </figcaption>
                <canvas @ref="_canvas" tabindex="0" aria-label="@($"{Title} by time. Use arrow keys to inspect points.")"></canvas>
                <div class="metric-tooltip" tabindex="0" role="region" aria-label="Chart point details">
                    <p @ref="_detail" role="status" aria-atomic="true">Hover over the chart or use the arrow keys to inspect a point.</p>
                </div>
            </figure>
        }
        else { <p class="metric-empty">No measured values in this range. @MetricHistoryPresentation.Quality(Series.Aggregate(MetricHistoryQuality.None, (quality, row) => quality | row.Summary.Quality))</p> }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public MetricHistorySeries[] Series { get; set; } = [];
    [Parameter] public string? CardId { get; set; }
    [Parameter] public RenderFragment? Controls { get; set; }
    [Parameter, EditorRequired] public MetricHistoryResponse? History { get; set; }
    [Parameter, EditorRequired] public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Utc;
    private IJSObjectReference? _module, _chart;
    private MetricHistoryResponse? _drawnHistory;
    private MetricHistorySeries[] _drawnSeries = [];
    private string? _drawnZone;
    private ElementReference _canvas, _detail;
    private bool _disposed, _drawing;

    private static string SeriesLabel(MetricHistorySeries row) => row.Series.Kind switch
    {
        MetricHistoryKind.NetworkRx => "RX · Receive",
        MetricHistoryKind.NetworkTx => "TX · Transmit",
        _ => row.Series.DisplayName
    };
    private static string Value(double? number, MetricHistorySeries row) => MetricHistoryPresentation.Value(number, row.Series.Unit);
    private static string? ExactVolume(string? bytes) => bytes is null ? null : $"{bytes} bytes";
    private static double? Plotted(MetricHistoryPoint point) => point.Statistics.WeightedAverage ?? point.Statistics.Last ?? point.Statistics.Maximum;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _drawing || (ReferenceEquals(_drawnHistory, History) &&
            _drawnZone == Zone.Id && _drawnSeries.SequenceEqual(Series))) return;
        _drawing = true;
        var history = History;
        var series = Series;
        var zone = Zone;
        var canvas = _canvas;
        var detail = _detail;
        bool Current() => !_disposed && ReferenceEquals(history, History) && zone.Id == Zone.Id && series.SequenceEqual(Series);
        try
        {
            var previous = _chart;
            _chart = null;
            await NetRatel.Web.Services.BrowserInteropCleanup.ReleaseAsync(Logger, previous);
            if (!Current() || history is null || !series.Any(row => row.Points.Any(point => Plotted(point) is not null))) return;
            if (_module is null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/monitoring-metrics.js");
                if (_disposed)
                {
                    await NetRatel.Web.Services.BrowserInteropCleanup.ReleaseAsync(Logger, null, module);
                    return;
                }
                _module = module;
            }
            if (!Current() || _module is null) return;
            var timespan = history.ToExclusiveUtc - history.FromUtc;
            var ticks = Enumerable.Range(0, 5)
                .Select(i => TimeZoneInfo.ConvertTime(history.FromUtc + timespan * (i / 4d), zone).ToString(timespan.TotalHours <= 24 ? "HH:mm" : "dd MMM")).ToArray();
            var plots = series.Select(row => new
            {
                name = SeriesLabel(row),
                points = row.Points.Where(point => Plotted(point) is not null).Select(point => new
                {
                    x = point.FromUtc.ToUnixTimeMilliseconds(), end = point.ToExclusiveUtc.ToUnixTimeMilliseconds(),
                    y = Plotted(point), min = point.Statistics.Minimum, max = point.Statistics.Maximum,
                    continuous = (point.Statistics.Quality & (MetricHistoryQuality.PartialCoverage | MetricHistoryQuality.Reset |
                        MetricHistoryQuality.Missing | MetricHistoryQuality.Failed)) == 0,
                    description = $"{MetricHistoryPresentation.Time(point.FromUtc, zone)} to {MetricHistoryPresentation.Time(point.ToExclusiveUtc, zone)} · " +
                        $"{SeriesLabel(row)} {Value(Plotted(point), row)} · coverage {MetricHistoryPresentation.Duration(point.Statistics.CoveredMicroseconds)} · " +
                        MetricHistoryPresentation.Quality(point.Statistics.Quality)
                }).ToArray()
            }).ToArray();
            var peak = series.SelectMany(row => row.Points.Select(point => point.Statistics.Maximum ?? Plotted(point) ?? 0)).DefaultIfEmpty(0).Max();
            var yMax = series[0].Series.Unit == "%" ? 100 : Math.Max(1, peak);
            var labels = Enumerable.Range(0, 4).Select(i => MetricHistoryPresentation.Value(yMax * (i / 3d), series[0].Series.Unit)).ToArray();
            var chart = await _module.InvokeAsync<IJSObjectReference>("draw", canvas, detail, history.FromUtc.ToUnixTimeMilliseconds(),
                history.ToExclusiveUtc.ToUnixTimeMilliseconds(), yMax, labels, ticks, plots);
            if (Current()) _chart = chart;
            else await NetRatel.Web.Services.BrowserInteropCleanup.ReleaseAsync(Logger, chart);
        }
        catch (Exception error) when (error is JSException or JSDisconnectedException or OperationCanceledException)
        {
            Logger.LogDebug("Metric chart interop ended ({FailureType}).", error.GetType().Name);
        }
        finally
        {
            _drawnHistory = history;
            _drawnSeries = series;
            _drawnZone = zone.Id;
            _drawing = false;
            if (!_disposed && !Current()) StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        return NetRatel.Web.Services.BrowserInteropCleanup.ReleaseAsync(Logger, _chart, _module);
    }
}
