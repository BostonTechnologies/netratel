@using System.Globalization
@using Microsoft.JSInterop
@using NetRatel.Shared.Contracts.Monitoring
@using NetRatel.Web.Services.Monitoring
@inject IMonitoringApiService Api
@inject IJSRuntime JS
@inject ILogger<MetricHistoryWorkspace> Logger
@implements IAsyncDisposable

<section class="metrics-workspace" aria-label="Historical metrics" data-testid="monitoring-metrics" aria-busy="@State.Loading">
    @if (Active)
    {
        @if (State.CheckingAccess)
        {
            <MudProgressLinear Indeterminate="true" aria-label="Checking historical metrics access" />
        }
        else
        {
            <div class="metrics-controls metrics-primary-controls">
                @if (State.Loading) { <MudProgressLinear Class="metrics-loading" Indeterminate="true" aria-label="Loading historical metrics" /> }
                @if (!State.PermissionDenied)
                {
                    @ClientPicker
                    <label>Time range<select value="@Preset" @onchange="ChangeRange">
                        @foreach (var option in Ranges) { <option value="@option.Key">@option.Value.Label</option> }
                        <option value="custom">Custom</option>
                    </select></label>
                    <MudTooltip Text="Refresh metrics">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh metrics" OnClick="RefreshAsync" Disabled="@State.Loading" />
                    </MudTooltip>
                }
            </div>
            @if (Preset == "custom" && !State.PermissionDenied)
            {
                <div class="metrics-controls">
                    <label>From local date<input type="date" @bind="_fromDate" /></label>
                    <label>Through local date<input type="date" @bind="_toDate" /></label>
                    <MudButton OnClick="ApplyCustom">Apply dates</MudButton>
                    <small>@Zone.Id</small>
                </div>
            }
            @if (_dateError is not null) { <p role="alert">@_dateError</p> }
            @if (State.PermissionDenied) { <MudAlert Severity="Severity.Warning">You do not have permission to read this tenant’s metrics.</MudAlert> }
            else if (State.Error is not null) { <MudAlert Severity="Severity.Error">@State.Error</MudAlert> }
            else if (AgentId is null && !State.Loading) { <p>Select a computer to view its metrics.</p> }

            @if ((State.Catalogue?.Status ?? State.History?.Status) is { } status)
            {
                <div class="metrics-status" data-testid="metrics-collection-status">
                    <strong>@(status.Enabled ? "Collection enabled" : "Collection disabled")</strong>
                    <span>Last persisted @Time(status.LastPersistedAtUtc)</span>
                    <span>Last accepted @Time(status.LastAcceptedAtUtc)</span>
                    @if (status.QueueFrames > 0) { <span>@status.QueueFrames queued</span> }
                    @if (status.DroppedFrames > 0) { <span>@status.DroppedFrames dropped on this server</span> }
                    @if (status.PartialFrames > 0) { <span>@status.PartialFrames incomplete inventories</span> }
                    @if (status.LateObservations > 0) { <span>@status.LateObservations late observations</span> }
                    @if (status.Disposition is { } disposition) { <span role="status">@CollectionMessage(disposition)</span> }
                </div>
                @if (State.Catalogue?.Series.Count == 0 && !State.Loading)
                {
                    <p>@(status.Enabled ? "No metrics have been retained for this computer yet." : "Collection is disabled and this computer has no retained metrics.")</p>
                }
                @if (State.Catalogue?.ClientOnline == false)
                {
                    <p role="status">This computer is offline. Retained history is available for completed observations.</p>
                }
                else if (State.Catalogue is { Series.Count: > 0 } catalogue && catalogue.Series.All(item => !item.RecentlyObserved))
                {
                    <p role="status">No recent observations for this computer. Retained history is still available.</p>
                }
            }

            @if (State.HasReadAccess && !State.PermissionDenied && AgentId is not null)
            {
                var history = State.History;
                @if (history is not null)
                {
                    <p class="metrics-range-note">
                        @if (State.Error is not null) { <strong>Last successfully loaded · </strong> }
                        @Time(history.FromUtc) to @Time(history.ToExclusiveUtc) · @Zone.Id · @Duration(history.ResolutionSeconds * 1_000_000L) intervals
                    </p>
                    @if (history.Disposition == "outside_retention") { <MudAlert Severity="Severity.Info">This range is outside the tenant’s retention policy.</MudAlert> }
                    else if (history.Disposition == "no_observations") { <p>No observations were retained in this range.</p> }
                }

                var disks = Available(MetricHistoryKind.DiskUsedPercent).ToArray();
                var interfaces = Interfaces.ToArray();
                var services = Available(MetricHistoryKind.ServiceState).ToArray();
                <div class="metrics-grid">
                    <MetricHistoryChart Title="CPU utilization" Series="@Series(MetricHistoryKind.CpuPercent)" History="history" Zone="Zone" />
                    <MetricHistoryChart Title="Memory utilization" Series="@Series(MetricHistoryKind.MemoryPercent)" History="history" Zone="Zone" />
                    <MetricHistoryChart Title="Memory used and capacity" Series="@Series(MetricHistoryKind.MemoryUsedBytes, MetricHistoryKind.MemoryTotalBytes)" History="history" Zone="Zone" />
                    <MetricHistoryChart Title="Disk usage" CardId="metrics-disk-card" Series="@Series(MetricHistoryKind.DiskUsedPercent)" History="history" Zone="Zone">
                        <Controls>
                            <label class="metrics-resource">Disk volume<select value="@State.SelectedDisk" @onchange="ChangeDisk" disabled="@(disks.Length == 0)" data-testid="metrics-disk">
                                <option value="">@(disks.Length == 0 ? "No retained volumes" : "Select a volume")</option>
                                @foreach (var disk in disks) { <option value="@disk.Id">@disk.DisplayName</option> }
                            </select></label>
                        </Controls>
                    </MetricHistoryChart>
                    <div class="metrics-wide">
                        <MetricHistoryChart Title="Network RX/TX" CardId="metrics-network-card" Series="@Series(MetricHistoryKind.NetworkRx, MetricHistoryKind.NetworkTx)" History="history" Zone="Zone">
                            <Controls>
                                <label class="metrics-resource">Network interface<select value="@State.SelectedInterface" @onchange="ChangeInterface" disabled="@(interfaces.Length == 0)" data-testid="metrics-interface">
                                    <option value="">@(interfaces.Length == 0 ? "No retained interfaces" : "Select an interface")</option>
                                    @foreach (var item in interfaces) { <option value="@item.ResourceKey">@InterfaceLabel(item, interfaces)</option> }
                                </select></label>
                            </Controls>
                        </MetricHistoryChart>
                    </div>
                    <div class="metrics-wide">
                        <MetricHistoryServicePanel Series="@Series(MetricHistoryKind.ServiceState).FirstOrDefault()" History="history" Zone="Zone">
                            <Controls>
                                <label class="metrics-resource">Watched service<select value="@State.SelectedService" @onchange="ChangeService" disabled="@(services.Length == 0)" data-testid="metrics-service">
                                    <option value="">@(services.Length == 0 ? "No retained watched services" : "Select a service")</option>
                                    @foreach (var item in services) { <option value="@item.Id">@item.DisplayName</option> }
                                </select></label>
                            </Controls>
                        </MetricHistoryServicePanel>
                    </div>
                </div>
            }
        }
    }
</section>

@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter] public Guid? AgentId { get; set; }
    [Parameter, EditorRequired] public MetricHistorySelection Selection { get; set; } = new();
    [Parameter] public EventCallback<MetricHistorySelection> SelectionChanged { get; set; }
    [Parameter] public EventCallback ReadAccessLost { get; set; }
    [Parameter] public RenderFragment? ClientPicker { get; set; }
    [Parameter] public bool Active { get; set; } = true;
    [Parameter] public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Utc;

    private static readonly Dictionary<string, (string Label, TimeSpan Duration)> Ranges = new(StringComparer.Ordinal)
    {
        ["1h"] = ("Last hour", TimeSpan.FromHours(1)), ["6h"] = ("Last 6 hours", TimeSpan.FromHours(6)),
        ["24h"] = ("Last 24 hours", TimeSpan.FromDays(1)), ["7d"] = ("Last 7 days", TimeSpan.FromDays(7)),
        ["30d"] = ("Last 30 days", TimeSpan.FromDays(30)), ["90d"] = ("Last 90 days", TimeSpan.FromDays(90)),
        ["1y"] = ("Last year", TimeSpan.FromDays(365))
    };

    private MetricWorkspaceState? _state;
    private MetricWorkspaceState State => _state ??= new(Api);
    private (int Tenant, Guid? Agent, MetricHistorySelection Selection)? _requested;
    private string? _zoneId;
    private DateTime? _fromDate, _toDate;
    private string? _dateError;
    private IJSObjectReference? _module, _subscription;
    private DotNetObjectReference<MetricHistoryWorkspace>? _reference;
    private bool _disposed, _wasActive, _updatingBrowser, _polling, _needsRefresh = true;
    private long _refreshGeneration;
    private string Preset => Selection.Range is { } range && (range == "custom" || Ranges.ContainsKey(range)) ? range : "24h";
    private bool Polling => Active && Preset != "custom" && !State.PermissionDenied;
    private IEnumerable<MetricSeriesDescription> Available(MetricHistoryKind kind) =>
        State.Catalogue?.Series.Where(item => item.Kind == kind).OrderBy(item => item.DisplayName, StringComparer.Ordinal) ?? Enumerable.Empty<MetricSeriesDescription>();
    private IEnumerable<MetricSeriesDescription> Interfaces =>
        Available(MetricHistoryKind.NetworkRx).Concat(Available(MetricHistoryKind.NetworkTx))
            .GroupBy(item => item.ResourceKey, StringComparer.Ordinal).Select(group => group.OrderByDescending(item => item.RecentlyObserved).First())
            .OrderBy(item => item.DisplayName, StringComparer.Ordinal).ThenBy(item => item.ResourceKey, StringComparer.Ordinal);
    private static string InterfaceLabel(MetricSeriesDescription item, MetricSeriesDescription[] interfaces)
    {
        var label = item.DisplayName + (item.RecentlyObserved ? "" : " (retained)");
        return interfaces.Count(other => other.DisplayName == item.DisplayName && other.RecentlyObserved == item.RecentlyObserved) > 1
            ? $"{label} · {item.ResourceKey[..Math.Min(10, item.ResourceKey.Length)]}" : label;
    }

    private MetricHistorySeries[] Series(params MetricHistoryKind[] kinds) =>
        State.History?.Series.Where(item => kinds.Contains(item.Series.Kind) && MatchesSelection(item.Series))
            .OrderBy(item => item.Series.Kind).ToArray() ?? [];

    private bool MatchesSelection(MetricSeriesDescription series) => series.Kind switch
    {
        MetricHistoryKind.DiskUsedPercent => series.Id == State.SelectedDisk,
        MetricHistoryKind.NetworkRx or MetricHistoryKind.NetworkTx => series.ResourceKey == State.SelectedInterface,
        MetricHistoryKind.ServiceState => series.Id == State.SelectedService,
        _ => true
    };

    protected override Task OnParametersSetAsync()
    {
        if (!Active)
        {
            _wasActive = false;
            Pause();
            return Task.CompletedTask;
        }

        var requested = (TenantId, AgentId, Selection);
        var changed = _requested != requested;
        if (_requested is { } previous && (previous.Tenant, previous.Agent) != (TenantId, AgentId))
        {
            Pause();
            _state = null;
        }
        if (_requested?.Selection.From != Selection.From || _requested?.Selection.To != Selection.To || _zoneId != Zone.Id)
        {
            _zoneId = Zone.Id;
            _fromDate = TryReadBound(Selection.From, out var from) ? TimeZoneInfo.ConvertTime(from, Zone).Date : null;
            _toDate = TryReadBound(Selection.To, out var to) ? TimeZoneInfo.ConvertTime(to.AddTicks(-1), Zone).Date : null;
        }
        var activated = !_wasActive;
        _wasActive = true;
        _requested = requested;
        if (!activated && !changed) return Task.CompletedTask;
        return changed || _needsRefresh || State.PermissionDenied ? RefreshAsync() : RecheckAccessAsync();
    }

    private async Task RecheckAccessAsync()
    {
        await State.RecheckAccessAsync(TenantId);
        await ReportAccessLossAsync();
    }

    private async Task RefreshAsync()
    {
        if (_disposed || !Active || TenantId <= 0) return;
        var to = DateTimeOffset.UtcNow;
        var from = to.AddHours(-24);
        _dateError = null;
        if (Preset == "custom")
        {
            if (!TryReadBound(Selection.From, out from) || !TryReadBound(Selection.To, out to) || from >= to)
            {
                _dateError = "Choose a start and end date to load the custom range.";
                Pause();
                return;
            }
        }
        else from = to - Ranges[Preset].Duration;
        var generation = ++_refreshGeneration;
        _needsRefresh = true;
        await State.RefreshAsync(new(TenantId, AgentId, Selection.Interface, Selection.Disk, Selection.Service, Selection.AlertResource, from, to));
        if (generation != _refreshGeneration || _disposed) return;
        _needsRefresh = false;
        await ReportAccessLossAsync();
    }

    private Task ReportAccessLossAsync() =>
        !_disposed && Active && State.PermissionDenied && Selection != new MetricHistorySelection()
            ? ReadAccessLost.InvokeAsync() : Task.CompletedTask;

    private void Pause()
    {
        ++_refreshGeneration;
        _state?.Cancel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _updatingBrowser || _polling == Polling) return;
        _updatingBrowser = true;
        try
        {
            if (_subscription is null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/monitoring-metrics.js");
                if (module is null) return;
                if (_disposed) { await NetRatel.Web.Services.BrowserInteropCleanup.ReleaseAsync(Logger, null, module); return; }
                _module = module;
                _reference ??= DotNetObjectReference.Create(this);
                var subscription = await module.InvokeAsync<IJSObjectReference>("subscribe", _reference);
                if (_disposed) { await NetRatel.Web.Services.BrowserInteropCleanup.ReleaseAsync(Logger, subscription); return; }
                _subscription = subscription;
            }
            if (_subscription is not null)
            {
                var polling = Polling;
                await _subscription.InvokeVoidAsync("setActive", polling);
                _polling = polling;
                if (!_disposed && _polling != Polling) StateHasChanged();
            }
        }
        catch (Exception error) when (error is JSException or JSDisconnectedException or OperationCanceledException)
        {
            Logger.LogDebug("Metrics browser refresh is unavailable ({FailureType}).", error.GetType().Name);
        }
        finally { _updatingBrowser = false; }
    }

    [JSInvokable]
    public Task RefreshVisibleMetrics() => InvokeAsync(async () =>
    {
        if (_disposed || !Polling || State.Loading) return;
        var refresh = RefreshAsync();
        StateHasChanged();
        await refresh;
        if (!_disposed) StateHasChanged();
    });

    [JSInvokable]
    public Task PauseHiddenMetrics() => InvokeAsync(() =>
    {
        if (_disposed || !Polling) return;
        Pause();
        StateHasChanged();
    });

    private Task ChangeRange(ChangeEventArgs args)
    {
        var range = args.Value?.ToString();
        var now = DateTimeOffset.UtcNow;
        return SelectionChanged.InvokeAsync(Selection with
        {
            Range = range,
            From = range == "custom" ? now.AddHours(-24).ToString("O") : null,
            To = range == "custom" ? now.ToString("O") : null
        });
    }

    private Task ChangeInterface(ChangeEventArgs args) =>
        SelectionChanged.InvokeAsync(Selection with { Interface = args.Value?.ToString() });
    private Task ChangeDisk(ChangeEventArgs args) => SelectionChanged.InvokeAsync(Selection with { Disk = ReadId(args) });
    private Task ChangeService(ChangeEventArgs args) => SelectionChanged.InvokeAsync(Selection with { Service = ReadId(args) });
    private static long? ReadId(ChangeEventArgs args) => long.TryParse(args.Value?.ToString(), out var id) ? id : null;
    private static bool TryReadBound(string? value, out DateTimeOffset bound) =>
        DateTimeOffset.TryParseExact(value, "O", CultureInfo.InvariantCulture, DateTimeStyles.None, out bound);
    private async Task ApplyCustom()
    {
        try
        {
            var dates = MonitoringDateRange.ToUtc(_fromDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                _toDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), Zone);
            if (dates.FromUtc is not { } from || dates.ToExclusiveUtc is not { } to) throw new ArgumentException();
            to = to <= DateTimeOffset.UtcNow ? to : DateTimeOffset.UtcNow;
            if (from >= to) throw new ArgumentException();
            await SelectionChanged.InvokeAsync(Selection with { Range = "custom", From = from.ToString("O"), To = to.ToString("O") });
        }
        catch (ArgumentException) { _dateError = "Choose valid dates in the displayed timezone."; }
    }

    private string Time(DateTimeOffset? at) => MetricHistoryPresentation.Time(at, Zone);
    private static string Duration(long microseconds) => MetricHistoryPresentation.Duration(microseconds);
    private static string CollectionMessage(string code) => code switch
    {
        "queue_capacity" or "queue_age" => "The history queue dropped observations.",
        "row_budget" or "maintenance_backlog" => "History is paused while maintenance frees capacity.",
        "maintenance_lag" => "Rollups are behind.",
        "late_observation" => "Some observations arrived after sealing.",
        "series_capacity" => "Some resources reached the history series limit.",
        "persistence_unavailable" => "History persistence is temporarily unavailable.",
        _ => code
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Pause();
        await NetRatel.Web.Services.BrowserInteropCleanup.ReleaseAsync(Logger, _subscription, _module);
        _reference?.Dispose();
    }
}
