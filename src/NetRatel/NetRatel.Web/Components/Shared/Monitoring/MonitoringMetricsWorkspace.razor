@using NetRatel.Web.Services.Monitoring
@inject NavigationManager Navigation

<MetricHistoryWorkspace TenantId="TenantId" AgentId="AgentId" Selection="Selection" SelectionChanged="ChangeSelection" Zone="Zone">
    <ClientPicker>
        <MonitoringClientFilter TenantId="TenantId" Value="AgentId" ValueChanged="ChangeAgent"
                                EmptyLabel="Select a computer" SelectFirst="true" />
    </ClientPicker>
</MetricHistoryWorkspace>

@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter] public Guid? AgentId { get; set; }
    [Parameter] public string? Range { get; set; }
    [Parameter] public string? From { get; set; }
    [Parameter] public string? To { get; set; }
    [Parameter] public string? InterfaceKey { get; set; }
    [Parameter] public long? DiskId { get; set; }
    [Parameter] public long? ServiceId { get; set; }
    [Parameter] public string? AlertResource { get; set; }
    [Parameter] public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Utc;

    private MetricHistorySelection Selection => new(Range, From, To, InterfaceKey, DiskId, ServiceId, AlertResource);

    private void ChangeAgent(Guid? value) => Update(new()
    {
        ["metricsClient"] = value, ["metricsInterface"] = null, ["metricsDisk"] = null,
        ["metricsService"] = null, ["metricsResource"] = null
    });

    private void ChangeSelection(MetricHistorySelection selection) => Update(new()
    {
        ["metricsRange"] = selection.Range, ["metricsFrom"] = selection.From, ["metricsTo"] = selection.To,
        ["metricsInterface"] = selection.Interface, ["metricsDisk"] = selection.Disk, ["metricsService"] = selection.Service
    });

    private void Update(Dictionary<string, object?> fields) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(fields));
}
