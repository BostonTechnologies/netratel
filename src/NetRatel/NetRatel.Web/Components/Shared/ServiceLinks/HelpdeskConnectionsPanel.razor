@using NetRatel.Shared.ServiceLinks
@using NetRatel.Shared.Contracts.RatelDesk
@using System.Text.Json
@using NetRatel.Web.Services.ServiceLinks
@implements IDisposable
@inject HelpdeskM2MApiClient Api
@inject NavigationManager Navigation

<MudStack Spacing="2" data-testid="helpdesk-service-link-list">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.subtitle2">RatelDesk connections</MudText>
        <MudSpacer />
        <MudButton Size="Size.Small" OnClick="RefreshAsync" Disabled="@busy">Refresh status</MudButton>
    </MudStack>
    @if (error is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">@error</MudAlert>
    }
    @if (busy && links.Count == 0)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (links.Count == 0 && error is null)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No RatelDesk connection is configured.</MudText>
    }
    @foreach (var link in links)
    {
        <MudPaper Outlined="true" Class="pa-3" Style="overflow-wrap:anywhere" data-testid="helpdesk-link-status">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.subtitle2">RatelDesk · @PeerHost(link)</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(link)">@StatusLabel(link)</MudChip>
                </MudStack>
                <MudText Typo="Typo.body2">@(link.LocalTenantName ?? "Tenant details unavailable") · @ApprovedTarget(link)</MudText>
                <MudExpansionPanels Elevation="0"><MudExpansionPanel Text="Connection details">
                <MudText Typo="Typo.caption">Instance @link.PeerInstanceId · local tenant @link.LocalTenantId · peer organization @(link.PeerTenantId ?? "Awaiting remote selection")</MudText>
                <MudText Typo="Typo.caption">Source: @(link.DeploymentManaged ? "Deployment configuration · read-only" : "Approved Web-managed connection")</MudText>
                <MudText Typo="Typo.caption">Rotation policy: @(link.AutomaticRotationEnabled ? $"automatic renewal after {link.RotationAgeDays} days" : "manual renewal") · @link.RotationOverlapSeconds second predecessor overlap after verified switch.</MudText>
                <MudGrid Spacing="1">
                    <MudItem xs="12" sm="6"><MudText Typo="Typo.body2">RatelDesk → NetRatel: @InboundStatus(link)</MudText></MudItem>
                    <MudItem xs="12" sm="6"><MudText Typo="Typo.body2">NetRatel → RatelDesk: @OutboundStatus(link)</MudText></MudItem>
                </MudGrid>
                @if (link.LifecycleState == "revocation_pending")
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">Local access is disabled. Peer revocation confirmation is still pending.</MudAlert>
                }
                @if (link.LastErrorCode is not null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning">@ErrorLabel(link.LastErrorCode)</MudText>
                }
                @if (link.Rotations.Count > 0)
                {
                    @foreach (var rotation in link.Rotations)
                    {
                        <MudText Typo="Typo.caption">@rotation.DirectionId rotation: @rotation.RotationState · credential @rotation.ExpectedCurrentCredentialRevision → @(rotation.SuccessorCredentialRevision?.ToString() ?? "Pending")</MudText>
                    }
                }
                </MudExpansionPanel></MudExpansionPanels>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Size="Size.Small" Href="@($"/account/integration-credentials/link/review/{Uri.EscapeDataString(link.AttemptId)}")">Review exact grants</MudButton>
                    @if (!link.DeploymentManaged && link.LifecycleState is not ("revoked" or "expired" or "failed"))
                    {
                        @if (CanContinueApproval(link))
                        {
                            <form method="post" action="/account/integration-credentials/link/continue" data-enhance="false" data-testid="helpdesk-resume-approval">
                                <AntiforgeryToken />
                                <input type="hidden" name="attemptId" value="@link.AttemptId" />
                                <MudButton ButtonType="ButtonType.Submit" Size="Size.Small" Disabled="busy">Resume RatelDesk approval</MudButton>
                            </form>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Disabled="@(busy || link.DeploymentManaged)" OnClick='@(() => ActionAsync(link, "resume"))'>Resume</MudButton>
                        }
                        @if (pendingLinkId == Identifier(link) && pendingRotationDirection is null)
                        {
                            <MudText Typo="Typo.caption">Disable both directions and request peer revocation?</MudText>
                            <MudButton Size="Size.Small" Disabled="busy" OnClick="CancelPending">Keep connection</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" Disabled="@(busy || link.DeploymentManaged)" OnClick='@(() => ActionAsync(link, link.Decision == "commit" ? "revoke" : "cancel"))'>Confirm disconnect</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" Disabled="busy" OnClick="() => PrepareDisconnect(link)">@(link.Decision == "commit" ? "Disconnect" : "Cancel setup")</MudButton>
                        }
                    }
                    @if (LifecycleConnected(link) && link.LinkId is not null)
                    {
                        <MudButton Size="Size.Small" Disabled="busy" OnClick="@(() => TestAsync(link))" data-testid="helpdesk-test-connection">Test connection</MudButton>
                    }
                    @if (IsConnected(link))
                    {
                        <MudButton Size="Size.Small" Href="/account/integration-credentials/link/return" Color="Color.Primary">Return to Flow</MudButton>
                    }
                    @if (!link.DeploymentManaged && IsConnected(link))
                    {
                        @foreach (var direction in link.GrantSummary?.Grants ?? [])
                        {
                            @if (pendingLinkId == Identifier(link) && pendingRotationDirection == direction.DirectionId)
                            {
                                <MudText Typo="Typo.caption">Rotate @direction.CallerProduct → @direction.TargetProduct under its existing approved grant?</MudText>
                                <MudButton Size="Size.Small" Disabled="busy" OnClick="CancelPending">Cancel rotation</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Primary" Disabled="@(busy || link.DeploymentManaged)" OnClick='@(() => ActionAsync(link, "rotate", direction.DirectionId))'>Confirm rotation</MudButton>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Disabled="@(busy || link.DeploymentManaged)" OnClick="() => PrepareRotation(link, direction.DirectionId)">Rotate @direction.CallerProduct → @direction.TargetProduct</MudButton>
                            }
                        }
                    }
                    @if (!link.DeploymentManaged && link.LifecycleState is "revoked" or "expired" or "failed")
                    {
                        <MudButton Size="Size.Small" OnClick="@(() => Navigation.NavigateTo(ReconnectUrl(link), forceLoad: true))" Color="Color.Primary">Reconnect with new approval</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
    }
    @if (testResult is not null)
    {
        <MudAlert Dense="true" Severity="@(testResult.OutboundAuthenticated && testResult.PeerAcknowledgedInbound ? Severity.Success : Severity.Warning)" data-testid="helpdesk-connection-test-result">
            NetRatel → RatelDesk fresh authenticated probe: @(testResult.OutboundAuthenticated ? "passed" : "not confirmed"). RatelDesk → NetRatel peer acknowledgement: @(testResult.PeerAcknowledgedInbound ? "confirmed" : "not confirmed"). Incident delivery: @(testResult.IncidentDeliveryReady ? "verified separately" : "requires separate receiver capability and target validation"). The test creates no incident and invokes no task.
        </MudAlert>
    }
    <ServiceClientRegistryPanel />
</MudStack>

@code {
    private List<ServiceLinkAdminStatus> links = [];
    private readonly Dictionary<string, RatelDeskConnectionCompletionDto> completions = new(StringComparer.Ordinal);
    private string? error, pendingLinkId, pendingRotationDirection;
    private bool busy, disposed;
    private ServiceLinkTestResult? testResult;
    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task RefreshAsync()
    {
        if (disposed || busy) return;
        busy = true; error = null; links = []; completions.Clear(); testResult = null; ClearPending();
        try
        {
            var current = await Api.ListLinksAsync();
            if (!disposed)
            {
                links = current.ToList();
                foreach (var link in links.Where(LifecycleConnected))
                {
                    if (disposed) break;
                    await CompleteAsync(link);
                }
            }
        }
        catch (ServiceAdministrationException exception) when (exception.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized)
        { if (!disposed) error = "Current integration management permission is required. Use an authorized account and refresh."; }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidDataException or ServiceAdministrationException or OperationCanceledException)
        { if (!disposed) error = "Reciprocal connection status is unavailable. Refresh to retry."; }
        finally { busy = false; }
    }
    private string ApprovedTarget(ServiceLinkAdminStatus link) => link.LinkId is not null && completions.TryGetValue(link.LinkId, out var completion)
        ? $"{completion.OrganizationName ?? "Organization details unavailable"} / {completion.CustomerName ?? "Customer details unavailable"}"
        : "Incident target awaiting verification";
    private void ClearPending() { pendingLinkId = null; pendingRotationDirection = null; }
    private void CancelPending() { if (!disposed && !busy) ClearPending(); }
    private bool IsRetainedRow(ServiceLinkAdminStatus link) => !disposed && links.Any(current => ReferenceEquals(current, link));
    private bool IsCurrentRow(ServiceLinkAdminStatus link) => !busy && IsRetainedRow(link);
    private void PrepareDisconnect(ServiceLinkAdminStatus link)
    {
        if (!IsCurrentRow(link) || link.DeploymentManaged || link.LifecycleState is "revoked" or "expired" or "failed") return;
        pendingLinkId = Identifier(link); pendingRotationDirection = null;
    }
    private void PrepareRotation(ServiceLinkAdminStatus link, string direction)
    {
        if (!IsCurrentRow(link) || link.DeploymentManaged || !IsConnected(link) || !HasDirection(link, direction)) return;
        pendingLinkId = Identifier(link); pendingRotationDirection = direction;
    }
    private static bool HasDirection(ServiceLinkAdminStatus link, string? direction) => direction is not null &&
        (link.GrantSummary?.Grants.Any(grant => grant.DirectionId == direction) ?? false);
    private bool CanAct(ServiceLinkAdminStatus link, string action, string? direction) => IsCurrentRow(link) && !link.DeploymentManaged && (action switch
    {
        "resume" => link.LifecycleState is not ("revoked" or "expired" or "failed"),
        "revoke" or "cancel" => pendingLinkId == Identifier(link) && pendingRotationDirection is null &&
            link.LifecycleState is not ("revoked" or "expired" or "failed") && action == (link.Decision == "commit" ? "revoke" : "cancel"),
        "rotate" => IsConnected(link) && HasDirection(link, direction) && pendingLinkId == Identifier(link) && pendingRotationDirection == direction,
        _ => false
    });
    private static string Identifier(ServiceLinkAdminStatus link) => link.LinkId ?? link.AttemptId;
    private async Task ActionAsync(ServiceLinkAdminStatus link, string action, string? directionId = null)
    {
        if (!CanAct(link, action, directionId)) return;
        busy = true; error = null;
        try
        {
            await Api.ActOnLinkAsync(link, action, directionId);
            if (!disposed) ClearPending();
        }
        catch (Exception exception) when (exception is HttpRequestException or ServiceAdministrationException or OperationCanceledException)
        { if (!disposed) error = "The lifecycle operation could not be confirmed. The current durable connection status remains authoritative."; }
        finally { busy = false; }
        if (!disposed && error is null) await RefreshAsync();
    }
    private async Task CompleteAsync(ServiceLinkAdminStatus link)
    {
        if (!IsRetainedRow(link) || !LifecycleConnected(link) || link.LinkId is null || !int.TryParse(link.LocalTenantId, out var tenantId)) return;
        try
        {
            var result = await Api.CompleteConnectionAsync(tenantId, link.LinkId);
            if (IsRetainedRow(link)) completions[link.LinkId] = result;
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidDataException or ServiceAdministrationException or OperationCanceledException)
        { if (IsRetainedRow(link)) completions.Remove(link.LinkId); }
    }
    private async Task TestAsync(ServiceLinkAdminStatus link)
    {
        if (!IsCurrentRow(link) || !LifecycleConnected(link) || link.LinkId is null) return;
        busy = true; error = null; testResult = null;
        try
        {
            await CompleteAsync(link);
            if (!IsRetainedRow(link)) return;
            var current = await Api.TestLinkAsync(link.LinkId);
            if (!disposed) testResult = current;
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidDataException or ServiceAdministrationException or OperationCanceledException)
        { if (!disposed) error = "The read-only authenticated probes could not be confirmed. Review the stored directions before retrying."; }
        finally { busy = false; }
    }
    public void Dispose() { disposed = true; links = []; completions.Clear(); testResult = null; ClearPending(); }
    private static string InboundStatus(ServiceLinkAdminStatus link) => link.LifecycleState is "revoked" or "revocation_pending" or "expired" ? "Local authorization disabled" : link.LocalInboundActive ? "Authenticated and active" : link.LifecycleState == "active" ? "Current grant unavailable" : link.LocalInboundReady ? "Control-only; business activation pending" : "Awaiting approval / verification";
    private static string OutboundStatus(ServiceLinkAdminStatus link) => link.LifecycleState is "revoked" or "revocation_pending" or "expired" ? "Local sender disabled" : link.LocalBusinessSenderEnabled && link.PeerActiveAcknowledged ? "Authenticated and active" : link.LifecycleState == "active" ? "Sender disabled; grant or peer acknowledgement unavailable" : link.LocalOutboundPersisted ? "Credentials saved; verification / acknowledgement pending" : "Awaiting approved credentials";
    private static bool LifecycleConnected(ServiceLinkAdminStatus link) => link.LifecycleState == "active" && link.LocalInboundActive && link.LocalBusinessSenderEnabled && link.PeerActiveAcknowledged;
    private static bool CanContinueApproval(ServiceLinkAdminStatus link) => link.Decision == "undecided" && link.LifecycleState == "awaiting_approval" && link.Descriptor.InitiatorEndpointSnapshot.Product == "netratel";
    private bool IsConnected(ServiceLinkAdminStatus link) => LifecycleConnected(link) && link.LinkId is not null && completions.TryGetValue(link.LinkId, out var completion) && completion.Ready;
    private string StatusLabel(ServiceLinkAdminStatus link) => link.LastErrorCode is "upgrade-required" or "service-link-unsupported" or "unsupported-contract" ? "Upgrade required" : IsConnected(link) ? "Connected" : link.LifecycleState switch
    {
        "awaiting_approval" or "approved" => "Awaiting approval",
        "prepared" or "verified" or "commit_decided" => "Completing setup",
        "active" => LifecycleConnected(link) ? "Approved · verify connection" : "Needs attention · grant unavailable",
        "in_doubt" => "Needs attention · recovery pending",
        "revocation_pending" => "Disconnecting · peer confirmation pending",
        "revoked" => "Disconnected", "expired" => "Expired", "failed" => "Needs attention", _ => "Needs attention"
    };
    private Color StatusColor(ServiceLinkAdminStatus link) => IsConnected(link) ? Color.Success : link.LifecycleState is "failed" or "in_doubt" or "active" ? Color.Warning : Color.Default;
    private static string PeerHost(ServiceLinkAdminStatus link)
    {
        var peer = link.Descriptor.InitiatorEndpointSnapshot.Product == "rateldesk" ? link.Descriptor.InitiatorEndpointSnapshot : link.Descriptor.ResponderEndpointSnapshot;
        return Uri.TryCreate(peer.WebBaseUrl, UriKind.Absolute, out var uri) ? uri.Authority : "Unverified peer";
    }
    private static string ReconnectUrl(ServiceLinkAdminStatus link)
    {
        var peer = link.Descriptor.InitiatorEndpointSnapshot.Product == "rateldesk" ? link.Descriptor.InitiatorEndpointSnapshot : link.Descriptor.ResponderEndpointSnapshot;
        return "/account/integration-credentials?purpose=helpdesk-m2m&peer_url=" + Uri.EscapeDataString(peer.WebBaseUrl)
            + "&tenant_id=" + Uri.EscapeDataString(link.LocalTenantId)
            + "&peer_tenant_id=" + Uri.EscapeDataString(link.PeerTenantId ?? "");
    }
    private static string ErrorLabel(string code) => code switch
    {
        "upgrade-required" or "service-link-unsupported" or "unsupported-contract" => "Upgrade required: this peer does not support the requested connection capability. Manual configuration remains available.",
        "deployment-managed" or "deployment-owned-profile" => "The deployment-owned outbound profile cannot be replaced by guided setup. Configure its approved values in deployment.",
        "grant-unavailable" => "The current approved grant is unavailable. Review the selected tenant, resources, request definitions and source before reconnecting with new approval.",
        _ => "Connection needs attention. Resume to reconcile its stored decision and authenticated checks."
    };
}
