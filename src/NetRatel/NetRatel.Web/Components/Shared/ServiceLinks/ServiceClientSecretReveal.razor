@using NetRatel.Shared.ServiceIdentity
@inject IJSRuntime JS

<MudStack Spacing="2" data-testid="helpdesk-service-secret-reveal">
    <MudAlert Dense="true" Severity="Severity.Warning">The secret is displayed once. Store it in RatelDesk's protected service credential setting.</MudAlert>
    <MudTextField Label="Service client ID" Value="@Reveal.Client.ClientId" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField Label="New service client secret" Value="@Reveal.ClientSecret" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField Label="Service issuer" Value="@Reveal.Issuer" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField Label="Service token endpoint" Value="@Reveal.TokenEndpoint" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField Label="Service audience" Value="@Reveal.Audience" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudText Typo="Typo.body2">Scopes: @string.Join(" ", Reveal.Scopes). Authenticate with client_credentials and client_secret_post at the token endpoint.</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
        <MudButton Variant="Variant.Outlined" OnClick="CopyAsync">Copy new secret</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StoredAsync">I stored the service secret</MudButton>
    </MudStack>
    @if (clipboardError) { <MudText Typo="Typo.caption">Clipboard access is unavailable. Select and copy the one-time secret field.</MudText> }
</MudStack>

@code {
    [Parameter, EditorRequired] public ServiceClientReveal Reveal { get; set; } = default!;
    [Parameter] public EventCallback OnStored { get; set; }
    private bool clipboardError;
    private Task StoredAsync() => OnStored.InvokeAsync();
    private async Task CopyAsync()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Reveal.ClientSecret); }
        catch (JSException) { clipboardError = true; }
    }
}
