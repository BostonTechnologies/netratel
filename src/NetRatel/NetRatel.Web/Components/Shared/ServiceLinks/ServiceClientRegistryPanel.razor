@implements IDisposable
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Routing
@using NetRatel.Shared.ServiceIdentity
@using NetRatel.Web.Services.ServiceLinks
@inject HelpdeskM2MApiClient Api

<NavigationLock OnBeforeInternalNavigation="GuardNavigation" ConfirmExternalNavigation="@(busy || reveal is not null)" />
<MudExpansionPanels Elevation="0" Class="mt-3"><MudExpansionPanel Text="Service clients and rotation" data-testid="helpdesk-service-clients">
    <MudStack Spacing="2">
        <MudButton Size="Size.Small" OnClick="RefreshAsync" Disabled="busy">Refresh service clients</MudButton>
        @if (error is not null) { <MudAlert Dense="true" Severity="Severity.Warning">@error</MudAlert> }
        @if (clients.Length == 0 && deployments.Length == 0 && error is null) { <MudText Typo="Typo.body2">No accessible service clients are configured.</MudText> }
        @foreach (var deployment in deployments)
        {
            <MudPaper Outlined="true" Class="pa-3" Style="overflow-wrap:anywhere" data-testid="helpdesk-service-client-row">
                <MudText Typo="Typo.subtitle2">Deployment client · @deployment.ClientId</MudText>
                <MudText Typo="Typo.body2">Audience: @deployment.Audience · scopes: @string.Join(", ", deployment.Scopes)</MudText>
                <MudText Typo="Typo.caption">Deployment configuration · read-only. Its complete registration and secret are managed in deployment.</MudText>
            </MudPaper>
        }
        @foreach (var client in clients)
        {
            <MudPaper Outlined="true" Class="pa-3" Style="overflow-wrap:anywhere" data-testid="helpdesk-service-client-row">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">@client.Name · @client.Status</MudText>
                    <MudText Typo="Typo.caption">Client @client.ClientId · tenant @client.TenantId · credential revision @client.CredentialRevision</MudText>
                    <MudText Typo="Typo.body2">@string.Join(", ", client.Scopes)</MudText>
                    <MudText Typo="Typo.caption">Source: @(client.ReadOnly ? "Deployment configuration · read-only" : client.LinkId is not null ? "Reciprocal connection" : "Web-managed service client"). Peer @client.PeerInstanceId · organization @client.PeerTenantId.</MudText>
                    @if (client.ReadOnly)
                    {
                        <MudText Typo="Typo.caption">Its complete registration is controlled by deployment configuration. Change its approved values there.</MudText>
                    }
                    else if (client.LinkId is not null)
                    {
                        <MudText Typo="Typo.caption">Rotate or disconnect this identity through its reciprocal connection so both peers retain the same grant.</MudText>
                    }
                    else if (client.Status == "active")
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            <MudButton Size="Size.Small" Disabled="@(busy || reveal is not null)" OnClick="@(() => Prepare(client, false))">Rotate manual client</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" Disabled="@(busy || reveal is not null)" OnClick="@(() => Prepare(client, true))">Revoke manual client</MudButton>
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        }
        @if (pending is not null)
        {
            <MudAlert Dense="true" Severity="Severity.Warning">@(revoke ? "Revoke this client's current and cached authorization?" : "Generate a successor secret under the same tenant, peer and resource grant?")</MudAlert>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                <MudButton OnClick="ClearPending" Disabled="busy">Cancel</MudButton>
                <MudButton OnClick="ConfirmAsync" Variant="Variant.Filled" Color="@(revoke ? Color.Error : Color.Primary)" Disabled="busy">@(revoke ? "Confirm revocation" : "Confirm rotation")</MudButton>
            </MudStack>
        }
        @if (reveal is { } visibleReveal)
        { <ServiceClientSecretReveal @key="visibleReveal" Reveal="visibleReveal" OnStored="@(() => ClearRevealAsync(visibleReveal))" /> }
    </MudStack>
</MudExpansionPanel></MudExpansionPanels>

@code {
    private ServiceClientMetadata[] clients = [];
    private ServiceClientDeploymentMetadata[] deployments = [];
    private ServiceClientMetadata? pending;
    private ServiceClientReveal? reveal;
    private bool busy, revoke, disposed;
    private string? error;
    private readonly CancellationTokenSource lifetime = new();
    protected override Task OnInitializedAsync() => RefreshAsync();
    private async Task RefreshAsync()
    {
        if (busy || reveal is not null) return;
        busy = true; error = null;
        clients = []; deployments = []; pending = null; revoke = false;
        try
        {
            var managedTask = Api.ListClientsAsync(lifetime.Token);
            var deploymentTask = LoadDeploymentAsync();
            await Task.WhenAll(managedTask, deploymentTask);
            if (!disposed) { clients = await managedTask; deployments = await deploymentTask; }
        }
        catch (ServiceAdministrationException exception) when (exception.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized)
        { if (!disposed) ClearUnauthorizedState(); }
        catch (Exception exception) when (exception is OperationCanceledException or HttpRequestException or JsonException or InvalidDataException or ServiceAdministrationException) { error = "Current service-client metadata is unavailable. Refresh before changing credentials."; }
        finally { if (!disposed) busy = false; }
    }
    private async Task<ServiceClientDeploymentMetadata[]> LoadDeploymentAsync()
    {
        try { return await Api.ListDeploymentClientsAsync(lifetime.Token); }
        catch (ServiceAdministrationException exception) when (exception.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized) { return []; }
    }
    private void Prepare(ServiceClientMetadata client, bool revoking)
    {
        if (disposed || busy || reveal is not null || client.ReadOnly || client.LinkId is not null || client.Status != "active" ||
            !clients.Any(current => ReferenceEquals(current, client))) return;
        pending = client; revoke = revoking;
    }
    private void ClearPending() { if (disposed || busy) return; pending = null; revoke = false; }
    private void ClearUnauthorizedState()
    {
        clients = []; deployments = []; pending = null; reveal = null; revoke = false;
        error = "Current service-client management permission is required. Refresh after signing in with an authorized account.";
    }
    private async Task ConfirmAsync()
    {
        if (disposed || busy || reveal is not null || pending is null || pending.ReadOnly || pending.LinkId is not null) return;
        var client = pending; var revoking = revoke; busy = true; error = null;
        try
        {
            if (revoking) await Api.RevokeAsync(client, lifetime.Token);
            else { var result = await Api.RotateAsync(client, lifetime.Token); if (!disposed) reveal = result; }
            pending = null;
        }
        catch (ServiceAdministrationException exception) when (exception.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized)
        { if (!disposed) ClearUnauthorizedState(); return; }
        catch (Exception exception) when (exception is OperationCanceledException or HttpRequestException or JsonException or InvalidDataException or ServiceAdministrationException)
        { error = "The credential change could not be confirmed. Refresh its revision before retrying; saved secrets cannot be revealed again."; }
        finally { if (!disposed) busy = false; }
        if (!disposed && reveal is null) await RefreshAsync();
    }
    private async Task ClearRevealAsync(ServiceClientReveal expected)
    { if (disposed || busy || !ReferenceEquals(reveal, expected)) return; reveal = null; await RefreshAsync(); }
    private Task GuardNavigation(LocationChangingContext context) { if (busy || reveal is not null) context.PreventNavigation(); return Task.CompletedTask; }
    public void Dispose() { disposed = true; reveal = null; lifetime.Cancel(); lifetime.Dispose(); }
}
