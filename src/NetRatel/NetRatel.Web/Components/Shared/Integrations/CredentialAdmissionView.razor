@using NetRatel.Shared.Connectivity
@using NetRatel.Web.Services

<section aria-label="Current HTTP MCP admission" data-testid="credential-admission">
    <h3>Configured grants and current admission</h3>
    @if (Admission is null)
    {
        <p>@(Loading ? "Checking current owner-scoped admission…" : "Current admission is unavailable or not checked. Configured grants do not establish tenant admission.")</p>
    }
    else
    {
        <p>Credential lifecycle: @Admission.CredentialState · authentication validity: @Admission.AuthenticationStatus</p>
        <p>Binding: @Admission.Resource · @Admission.Instance · @Admission.Environment</p>
        <p>Exact expiry: <code>@IntegrationCredentialExpiry.Display(Admission.CredentialExpiresAtUtc)</code> · checked <code>@Admission.CheckedAtUtc.UtcDateTime.ToString("O")</code></p>
        <details><summary>Configured application grants: @Admission.ConfiguredGrants.Count tenant · @Admission.ConfiguredInstancePermissions.Count server-level</summary>
            <ul>@foreach (var grant in Admission.ConfiguredGrants) { <li>Tenant @grant.TenantId: <code>@grant.Permission</code></li> }
                @foreach (var permission in Admission.ConfiguredInstancePermissions) { <li>Server-level: <code>@permission</code></li> }</ul>
        </details>
        @foreach (var item in Admission.EffectiveAdmission)
        {
            <details><summary>@item.Target.Tool/@item.Target.Operation · tenant @item.Target.TenantId · @(item.FailureCode ?? "authorization admitted; dispatch readiness not checked")</summary>
                <p>Required delegation: <code>@item.RequiredScope</code> · roles: @string.Join(", ", item.RequiredRoles)</p>
                <p>Application grant configured: @item.ApplicationGrantConfigured · current durable owner permission: @item.OwnerPermissionGranted · tenant visible: @item.TenantVisible</p>
                <p>Policy: @item.PolicyAdmissionStatus · allowed: @(item.PolicyAllowed?.ToString() ?? "not checked") · matching policies: @string.Join(", ", item.MatchingPolicies)</p>
                @if (item.Target.AgentId is { } agent) { <p>Agent @agent · profile revision @item.Target.ProfileRevision</p> }
                <p>Target readiness: @item.TargetReadiness · operation capability: @item.CapabilityAvailability</p>
            </details>
        }
        @foreach (var policy in Admission.MatchingPolicies)
        {
            <p>Policy <code>@policy.PolicyId</code> · @policy.Environment · tenant @policy.TenantId · @policy.Operation · @policy.Effect · exact expiry <code>@(policy.ExpiresAtUtc is { } expiry ? IntegrationCredentialExpiry.Display(expiry) : "none")</code> · review by <code>@(policy.ReviewByUtc is { } review ? IntegrationCredentialExpiry.Display(review) : "none")</code></p>
        }
        <ul>@foreach (var prerequisite in Admission.RemainingPrerequisites) { <li>@prerequisite</li> }</ul>
        <p>@Admission.NextAction</p>
    }
    <p><a href="https://github.com/BostonTechnologies/netratel/blob/main/docs/mcp-http/local-credential-mode.md#reviewed-admission">Supported reviewed request, inspect and resume flow</a></p>
</section>

@code {
    [Parameter] public CredentialMcpAdmission? Admission { get; set; }
    [Parameter] public bool Loading { get; set; }
}
