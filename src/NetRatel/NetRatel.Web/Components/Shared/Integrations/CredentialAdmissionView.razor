@using NetRatel.Application.Operations
@using NetRatel.Shared.Operations
@using NetRatel.Shared.Connectivity
@using NetRatel.Web.Services

<section class="credential-admission" aria-label="Current HTTP MCP admission" aria-busy="@Loading" data-testid="credential-admission">
    <div class="admission-heading">
        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Primary" />
        <div><h3>Current admission</h3><p>Configured grants, owner permissions and operator policies.</p></div>
        @HeaderActions
    </div>
    @if (Admission is null)
    {
        <div class="admission-empty" role="status">
            @if (Loading)
            { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" /><span>Checking current owner-scoped admission…</span> }
            else
            { <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" /><div><strong>Current admission is unavailable or not checked.</strong><p>Configured grants do not establish tenant admission. Refresh admission to check again.</p></div> }
        </div>
    }
    else
    {
        <div class="admission-summary">
            <div class="admission-status-strip">
                <div><span class="admission-label">Credential lifecycle</span><strong>@DisplayState(Admission.CredentialState)</strong></div>
                <div><span class="admission-label">Authentication validity</span><code>@Admission.AuthenticationStatus</code></div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Admission.Environment</MudChip>
            </div>
            <dl class="admission-metadata">
                <div class="admission-wide"><dt>Server binding</dt><dd>@Admission.Resource</dd></div>
                <div><dt>Instance</dt><dd>@Admission.Instance</dd></div>
                <div><dt>Checked (UTC)</dt><dd><time datetime="@Admission.CheckedAtUtc.UtcDateTime.ToString("O")">@Admission.CheckedAtUtc.UtcDateTime.ToString("O")</time></dd></div>
                <div class="admission-wide"><dt>Exact expiry (UTC)</dt><dd><code>@IntegrationCredentialExpiry.Display(Admission.CredentialExpiresAtUtc)</code></dd></div>
            </dl>
        </div>

        <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true" Class="admission-panels">
            <MudExpansionPanel>
                <TitleContent><div class="admission-panel-title"><MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" /><strong>Current application grants</strong><span>@Admission.ConfiguredGrants.Count tenant · @Admission.ConfiguredInstancePermissions.Count server-level</span></div></TitleContent>
                <ChildContent>
                    @if (Admission.ConfiguredGrants.Count == 0 && Admission.ConfiguredInstancePermissions.Count == 0)
                    { <p class="admission-muted">No application grants are configured.</p> }
                    else
                    {
                        <ul class="admission-grants">
                            @foreach (var grant in Admission.ConfiguredGrants) { <li><span>Tenant @grant.TenantId</span><code>@grant.Permission</code></li> }
                            @foreach (var permission in Admission.ConfiguredInstancePermissions) { <li><span>Server-level</span><code>@permission</code></li> }
                        </ul>
                    }
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <div class="admission-section-label"><h4>Named operation checks (sample coverage)</h4><span>@Admission.EffectiveAdmission.Count operations</span></div>
        <p>Each row covers its named operation and target. Runtime readiness and capabilities remain unchecked; no operation is executed.</p>
        @if (CheckTargets.HasDelegate)
        {
            <MudExpansionPanels Elevation="0"><MudExpansionPanel Text="Check an exact operation and target">
                <MudSelect T="int" Label="Tenant or server scope" Value="_tenant" ValueChanged="ScopeChanged" Disabled="Loading">
                    @foreach (var scope in AvailableScopes) { <MudSelectItem Value="scope">@(scope == 0 ? "Server access" : $"Tenant {scope}")</MudSelectItem> }
                </MudSelect>
                <MudSelect T="string" Label="Operation to authorize" @bind-Value="_operation" Disabled="Loading">
                    @foreach (var operation in AvailableOperations) { <MudSelectItem Value="operation">@operation</MudSelectItem> }
                </MudSelect>
                <MudTextField T="string" Label="Agent ID (for a client target)" @bind-Value="_agent" HelperText="Copy the Agent ID from Clients. Leave blank for a tenant or server operation." Disabled="Loading" />
                <MudButton OnClick="CheckExactAsync" Disabled="@(Loading || string.IsNullOrEmpty(_operation))" Variant="Variant.Outlined" data-testid="check-exact-admission">Check authorization only</MudButton>
                @if (_checkError is not null) { <MudAlert Severity="Severity.Warning">@_checkError</MudAlert> }
                <a href="/clients/mgmt">Find a client</a> · <a href="/admin/operator-policies">Review policies and target profiles</a>
            </MudExpansionPanel></MudExpansionPanels>
        }
        @if (Admission.EffectiveAdmission.Count == 0)
        { <p class="admission-empty-text">No operation-specific admission checks are available for this credential.</p> }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true" Class="admission-panels">
                @foreach (var item in Admission.EffectiveAdmission)
                {
                    <MudExpansionPanel>
                        <TitleContent>
                            <div class="admission-operation-title">
                                <div><strong>@item.Target.Tool<span class="admission-operation-separator">/</span>@item.Target.Operation</strong><span>Tenant @item.Target.TenantId</span></div>
                                <MudChip T="string" Size="Size.Small" Color="@(item.AuthorizationAdmitted ? Color.Success : Color.Warning)" Variant="Variant.Outlined">@(item.AuthorizationAdmitted ? "Authorization admitted" : item.PolicyAdmissionStatus == "conditional_runtime_unverified" ? "Policy allowed; runtime unchecked" : "Not admitted")</MudChip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <p class="admission-operation-outcome">@(item.FailureCode ?? (item.AuthorizationAdmitted ? "Authorization admitted; dispatch readiness not checked" : "Authorization not admitted"))</p>
                            <div class="admission-checks">
                                <div><span>Application grant configured</span><MudChip T="string" Size="Size.Small" Color="@CheckColor(item.ApplicationGrantConfigured)" Variant="Variant.Outlined">@YesNo(item.ApplicationGrantConfigured)</MudChip></div>
                                <div><span>Current durable owner permission</span><MudChip T="string" Size="Size.Small" Color="@CheckColor(item.OwnerPermissionGranted)" Variant="Variant.Outlined">@YesNo(item.OwnerPermissionGranted)</MudChip></div>
                                <div><span>Tenant visible</span><MudChip T="string" Size="Size.Small" Color="@CheckColor(item.TenantVisible)" Variant="Variant.Outlined">@YesNo(item.TenantVisible)</MudChip></div>
                                <div><span>Policy allowed</span><MudChip T="string" Size="Size.Small" Color="@(item.PolicyAllowed is { } allowed ? CheckColor(allowed) : Color.Default)" Variant="Variant.Outlined">@(item.PolicyAdmissionStatus == "not_required_by_route" ? "Not required by route" : item.PolicyAllowed is { } policyAllowed ? YesNo(policyAllowed) : "Not checked")</MudChip></div>
                            </div>
                            <dl class="admission-metadata admission-operation-metadata">
                                <div><dt>Required delegation</dt><dd><code>@item.RequiredScope</code></dd></div>
                                <div><dt>Required roles</dt><dd>@(item.RequiredRoles.Count > 0 ? string.Join(", ", item.RequiredRoles) : "None")</dd></div>
                                <div><dt>Failing layer</dt><dd>@(item.FailureLayer ?? "None")</dd></div>
                                <div><dt>Policy evaluation</dt><dd>@DisplayState(item.PolicyAdmissionStatus)</dd></div>
                                <div><dt>Target readiness</dt><dd>@DisplayState(item.TargetReadiness)</dd></div>
                                <div><dt>Operation capability</dt><dd>@DisplayState(item.CapabilityAvailability)</dd></div>
                                @if (item.Target.AgentId is { } agent)
                                {
                                    <div><dt>Agent</dt><dd><code>@agent</code></dd></div>
                                    <div><dt>Profile revision</dt><dd>@item.Target.ProfileRevision</dd></div>
                                }
                                <div class="admission-wide"><dt>Matching policies</dt><dd>@if (item.MatchingPolicies.Count == 0) { <span>None</span> } else { <ul class="admission-policy-ids">@foreach (var id in item.MatchingPolicies) { <li><code>@id</code></li> }</ul> }</dd></div>
                            </dl>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
        @if (Admission.TargetsTruncated)
        { <p class="admission-muted">This response contains a limited set of operation checks.</p> }

        @if (Admission.MatchingPolicies.Count > 0)
        {
            <div class="admission-section-label"><h4>Matching operator policies</h4><span>@Admission.MatchingPolicies.Count policies</span></div>
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true" Class="admission-panels">
                @foreach (var policy in Admission.MatchingPolicies)
                {
                    <MudExpansionPanel @key="policy.PolicyId">
                        <TitleContent><div class="admission-operation-title"><div><strong>@(policy.Operation ?? "Operator policy")</strong><span>@policy.Environment · Tenant @policy.TenantId</span></div><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@policy.Effect</MudChip></div></TitleContent>
                        <ChildContent>
                            <dl class="admission-metadata">
                                <div class="admission-wide"><dt>Policy ID</dt><dd><code>@policy.PolicyId</code></dd></div>
                                <div><dt>Exact expiry (UTC)</dt><dd><code>@(policy.ExpiresAtUtc is { } expiry ? IntegrationCredentialExpiry.Display(expiry) : "None")</code></dd></div>
                                <div><dt>Review by (UTC)</dt><dd><code>@(policy.ReviewByUtc is { } review ? IntegrationCredentialExpiry.Display(review) : "None")</code></dd></div>
                                @if (policy.AgentId is { } agent) { <div><dt>Agent</dt><dd><code>@agent</code></dd></div> }
                                <div><dt>Version</dt><dd>@policy.Version</dd></div>
                            </dl>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }

        @if (Admission.RemainingPrerequisites.Count > 0 || !string.IsNullOrWhiteSpace(Admission.NextAction))
        {
            <div class="admission-next-action">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                <div><h4>Next steps</h4>@if (Admission.RemainingPrerequisites.Count > 0) { <ul>@foreach (var prerequisite in Admission.RemainingPrerequisites) { <li>@prerequisite</li> }</ul> }<p>@Admission.NextAction</p></div>
            </div>
        }
    }
    <a class="admission-help" href="https://github.com/BostonTechnologies/netratel/blob/main/docs/mcp-http/local-credential-mode.md#reviewed-admission" target="_blank" rel="noopener noreferrer"><MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />Supported reviewed request, inspect and resume flow</a>
</section>

@code {
    [Parameter] public CredentialMcpAdmission? Admission { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<ReviewedMcpAccessTarget>> CheckTargets { get; set; }
    private int _tenant;
    private string _operation = "", _agent = "";
    private string? _checkError;
    private IEnumerable<int> AvailableScopes => Admission is null ? [] : Admission.ConfiguredGrants.Select(g => g.TenantId).Concat(Admission.ConfiguredInstancePermissions.Count > 0 ? new[] { 0 } : []).Distinct().Order();
    private IEnumerable<string> AvailableOperations => Admission is null ? [] : McpIntegrationPolicyCatalog.Supported(_tenant,
        _tenant == 0 ? Admission.ConfiguredInstancePermissions : Admission.ConfiguredGrants.Where(g => g.TenantId == _tenant).Select(g => g.Permission))
        .Select(op => op.ToolName + "/" + op.OperationName).Distinct().Order();
    protected override void OnParametersSet() { if (!AvailableScopes.Contains(_tenant)) _tenant = AvailableScopes.FirstOrDefault(); }
    private void ScopeChanged(int tenant) { _tenant = tenant; _operation = ""; _agent = ""; _checkError = null; }
    private async Task CheckExactAsync()
    {
        _checkError = null;
        if (!_operation.Contains('/')) return;
        var parts = _operation.Split('/', 2);
        if (!string.IsNullOrWhiteSpace(_agent) && !Guid.TryParse(_agent, out _)) { _checkError = "Enter a valid Agent ID."; return; }
        Guid? agent = Guid.TryParse(_agent, out var id) ? id : null;
        var model = McpOperationTargetCatalog.Find(parts[0], parts[1])?.Model;
        if (model is McpOperationTargetModel.Agent or McpOperationTargetModel.ObjectDerived && agent is null)
        { _checkError = "Select a tenant and enter its Agent ID."; return; }
        var targets = new List<ReviewedMcpAccessTarget> { new(_tenant, parts[0], parts[1], agent) };
        if (parts[0] == "netratel_search" && parts[1] == "clients")
        {
            if (agent is null || _tenant == 0) { _checkError = "Check discovery with an exact client in a selected tenant; the server boundary is checked together."; return; }
            targets.Insert(0, new(0, parts[0], parts[1]));
        }
        await CheckTargets.InvokeAsync(targets);
    }
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    private static string DisplayState(string value) => value.Replace('_', ' ');
    private static string YesNo(bool value) => value ? "Yes" : "No";
    private static Color CheckColor(bool value) => value ? Color.Success : Color.Warning;
}
