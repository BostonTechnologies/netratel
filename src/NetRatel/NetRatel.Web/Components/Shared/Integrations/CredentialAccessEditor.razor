@implements IDisposable
@using System.Net.Http.Json
@using System.Text.Json
@using NetRatel.Infrastructure.Identity
@using NetRatel.Shared.Connectivity
@using NetRatel.Web.Services
@inject IHttpClientFactory Clients
@inject ILogger<CredentialAccessEditor> Logger

<section class="credential-access-editor" aria-label="Edit credential access" data-testid="credential-access-editor">
    <h4 tabindex="-1" @ref="_heading">@(_saved ? "Access saved" : _receipt is null ? "Edit access" : "Review access changes")</h4>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" data-testid="access-edit-error">@_error</MudAlert>
        @if (_diagnostic is not null) { <p class="access-diagnostic" data-testid="access-edit-diagnostic">@_diagnostic</p> }
    }
    @if (_baseline is null || _authority is null)
    {
        @if (_busy) { <MudProgressLinear Indeterminate="true" aria-label="Loading current access" /> }
        else { <MudButton OnClick="InitializeAsync" data-testid="access-edit-retry-load">Retry loading access</MudButton> }
    }
    else if (_saved)
    {
        <MudAlert Severity="Severity.Success" data-testid="access-edit-saved">Access updated on this credential. Continue using the saved secret and check current admission below.</MudAlert>
    }
    else if (_receipt is null)
    {
        <p>Add or remove tenants and choose their permissions. Switching scopes preserves the other selections.</p>
        <div class="access-edit-tenants">
            @foreach (var tenant in _selectedTenants)
            {
                <span class="access-edit-tenant" @key="tenant"><span>@TenantName(tenant)</span><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Disabled="@(_busy || _requestId is not null)" OnClick="@(() => RemoveTenant(tenant))" aria-label="@($"Remove {TenantName(tenant)}")" data-testid="@($"access-remove-tenant-{tenant}")" /></span>
            }
            @if (_authority.Tenants.Any(tenant => !_selectedTenants.Contains(tenant.TenantId)))
            {
                <label>Add tenant
                    <select @bind="_tenantToAdd" disabled="@(_busy || _requestId is not null)" data-testid="access-add-tenant-select">
                        <option value="">Choose a tenant</option>
                        @foreach (var tenant in _authority.Tenants.Where(tenant => !_selectedTenants.Contains(tenant.TenantId)))
                        { <option value="@tenant.TenantId">@tenant.Name (ID @tenant.TenantId)</option> }
                    </select>
                </label>
                <MudButton OnClick="AddTenant" Disabled="@(_busy || _requestId is not null || _tenantToAdd is null)" Variant="Variant.Outlined" data-testid="access-add-tenant">Add tenant</MudButton>
            }
        </div>
        <IntegrationPermissionSelector Scopes="PermissionScopes" Grants="_grants" InstancePermissions="_instancePermissions" Changed="ChangePermissions" Disabled="@(_busy || _requestId is not null)" TestIdPrefix="access-edit" />
        @if (_requestId is not null)
        { <p role="status">The submitted draft is preserved. Retry review to recover the same request before making further changes.</p> }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ReviewAsync" Disabled="_busy" data-testid="access-review">@(_busy ? "Preparing review…" : _requestId is null ? "Review changes" : "Retry review")</MudButton>
    }
    else
    {
        var request = _receipt.Request;
        <p>@_baseline.Name · exact expiry @IntegrationCredentialExpiry.Format(request.Proposal.ExpiresAtUtc)</p>
        <p>The credential ID, secret, connection type and HTTP MCP server stay the same. Operation policies require their own review.</p>
        <div class="access-change-summary" data-testid="access-change-summary">
            <p>@request.Proposal.Grants.Count tenant grants · @request.Proposal.InstancePermissions.Count server-level grants</p>
            @foreach (var group in request.Proposal.Grants.GroupBy(grant => grant.TenantId))
            { <details open><summary>@TenantName(group.Key) · @group.Count() permissions</summary><ul>@foreach (var grant in group) { <li>@PermissionLabel(grant.Permission) <code>@grant.Permission</code>@(HasOriginalGrant(grant) ? "" : " — added")</li> }</ul></details> }
            @if (request.Proposal.InstancePermissions.Count > 0)
            { <details open><summary>Server-level access</summary><ul>@foreach (var permission in request.Proposal.InstancePermissions) { <li>@PermissionLabel(permission) <code>@permission</code>@(_baseline.InstancePermissions.Contains(permission) ? "" : " — added")</li> }</ul></details> }
            @if (RemovedGrants.Any() || RemovedInstancePermissions.Any())
            { <details open><summary>Removed access</summary><ul>@foreach (var grant in RemovedGrants) { <li>@TenantName(grant.TenantId): @PermissionLabel(grant.Permission)</li> }@foreach (var permission in RemovedInstancePermissions) { <li>Server-level: @PermissionLabel(permission)</li> }</ul></details> }
        </div>
        @if (request.Status == "pending")
        {
            <MudCheckBox T="bool" @bind-Value="_confirmed" Disabled="_busy" Label="I approve these exact access changes. Record my approval if my account is eligible." data-testid="access-review-confirm" />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => ApplyAsync())" Disabled="@(_busy || !_confirmed)" data-testid="access-apply">@(_busy ? "Applying…" : "Apply changes")</MudButton>
            <div class="access-pending-review" role="status" data-testid="access-pending-review">
                <strong>Need another administrator's approval?</strong>
                <p>An authorized administrator can open API &amp; MCP credentials, enter <strong>@request.UserCode</strong> under Review client, and approve this exact request. <a href="/account/integration-credentials?tab=credentials" target="_blank" rel="noopener noreferrer">Open browser review in another tab</a>, or close this editor and Details to use Review client on this page, then reopen Edit access. Approval is checked while this editor is open and applied automatically.</p>
                <span>Review reference: @request.RequestId</span>
            </div>
        }
        else if (request.Status == "approved")
        { <p role="status">Approved. Applying the reviewed changes…</p> }
        else
        { <MudAlert Severity="Severity.Warning" data-testid="access-review-status">This review is @request.Status. Return to the draft to prepare a new request.</MudAlert> }
        <div class="access-editor-actions">
            <MudButton OnClick="RefreshReviewAsync" Disabled="_busy" data-testid="access-check-review">Check review status</MudButton>
            <MudButton OnClick="BackToEditAsync" Disabled="_busy" data-testid="access-back-to-edit">Back to edit</MudButton>
        </div>
    }
    <div class="access-editor-actions"><MudButton OnClick="CloseAsync" Disabled="_busy" data-testid="access-close">Close editor</MudButton></div>
</section>

@code {
    [Parameter, EditorRequired] public string CredentialId { get; set; } = "";
    [Parameter] public EventCallback<ReviewedMcpAccessReceipt> Applied { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    private HttpClient Api => Clients.CreateClient("OrchestratorApi");
    private string Route => "/api/v2/account/integration-credentials/" + Uri.EscapeDataString(CredentialId) + "/access-requests";
    private string RequestRoute => Route + "/" + Uri.EscapeDataString(_requestId!);
    private readonly CancellationTokenSource _lifetime = new();
    private IntegrationCredentialSummary? _baseline;
    private AccessAuthority? _authority;
    private readonly HashSet<IntegrationPairingGrant> _grants = [];
    private readonly HashSet<string> _instancePermissions = new(StringComparer.Ordinal);
    private readonly SortedSet<int> _selectedTenants = [];
    private int? _tenantToAdd;
    private string? _requestId, _error, _diagnostic;
    private ReviewedMcpAccessReceipt? _receipt;
    private bool _busy, _confirmed, _saved, _disposed, _focusHeading = true;
    private ElementReference _heading;
    protected override async Task OnInitializedAsync()
    {
        await InitializeAsync();
        if (!_disposed) _ = PollReviewAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusHeading || _disposed) return;
        _focusHeading = false;
        await _heading.FocusAsync();
    }
    private async Task InitializeAsync()
    {
        if (_busy || _disposed) return;
        await SetBusyAsync(true); _error = _diagnostic = null;
        try
        {
            var authority = ReadAccessAsync<AccessAuthority>("/api/v2/account/integration-credentials/authority", "load-authority");
            var credentials = ReadAccessAsync<List<IntegrationCredentialSummary>>("/api/v2/account/integration-credentials/", "load-credentials");
            var requests = ReadAccessAsync<List<ReviewedMcpAccessRequest>>(Route, "load-reviews");
            await Task.WhenAll(authority, credentials, requests);
            if (_disposed) return;
            var loadedAuthority = await authority;
            var baseline = (await credentials)?.SingleOrDefault(credential => credential.Id == CredentialId);
            if (baseline is null || loadedAuthority is null) { _error = "This credential is unavailable. Refresh the credential list and check your account access."; return; }
            var pending = (await requests)?.FirstOrDefault(request => request.Status is "pending" or "approved");
            ReviewedMcpAccessReceipt? receipt = null;
            if (pending is not null)
            {
                receipt = await ReadAccessAsync<ReviewedMcpAccessReceipt>(Route + "/" + Uri.EscapeDataString(pending.RequestId), "load-pending-review");
                if (receipt is null) { _error = "Could not recover the pending review. Retry loading access to restore the submitted selections."; return; }
            }
            if (_disposed) return;
            // Publish one complete snapshot only after the pending draft has also loaded.
            _authority = loadedAuthority; _baseline = baseline; _requestId = pending?.RequestId;
            SetDraft(receipt?.Request.Proposal.Grants ?? baseline.Grants.Select(grant => new IntegrationPairingGrant(grant.TenantId, grant.Permission)),
                receipt?.Request.Proposal.InstancePermissions ?? baseline.InstancePermissions);
            if (receipt is not null) await AcceptReceiptAsync(receipt);
        }
        catch (Exception error) when (IsRequestFailure(error))
        { if (!_disposed && _error is null) ReportRequestFailure("load-access", error, "Retry loading access to recover your complete saved selections."); }
        finally { await SetBusyAsync(false); }
        if (_receipt?.Request.Status == "approved") await ApplyAsync();
    }
    private void SetDraft(IEnumerable<IntegrationPairingGrant> grants, IEnumerable<string> instancePermissions)
    {
        _grants.Clear(); _grants.UnionWith(grants);
        _instancePermissions.Clear(); _instancePermissions.UnionWith(instancePermissions);
        _selectedTenants.Clear(); _selectedTenants.UnionWith(_grants.Select(grant => grant.TenantId));
        _confirmed = false;
    }
    private IReadOnlyList<IntegrationPermissionScope> PermissionScopes => _authority is null ? [] : _selectedTenants.Select(tenant =>
        new IntegrationPermissionScope(tenant, TenantName(tenant), ScopePermissions(tenant))).Concat(
        _authority.InstancePermissions.Count > 0 || _instancePermissions.Count > 0 || _baseline?.InstancePermissions.Count > 0 ? [new IntegrationPermissionScope(null, "Server-level access", ScopePermissions(null))] : []).ToArray();
    private IntegrationPermission[] ScopePermissions(int? tenant)
    {
        var authorized = (tenant is int id ? _authority?.Tenants.FirstOrDefault(scope => scope.TenantId == id)?.Permissions : _authority?.InstancePermissions) ?? [];
        var selected = tenant is int selectedTenant ? _grants.Where(grant => grant.TenantId == selectedTenant).Select(grant => grant.Permission) : _instancePermissions;
        var original = tenant is int originalTenant ? _baseline?.Grants.Where(grant => grant.TenantId == originalTenant).Select(grant => grant.Permission) : _baseline?.InstancePermissions;
        return authorized.Concat(selected.Concat(original ?? []).Distinct().Where(id => authorized.All(permission => permission.Id != id))
            .Select(id => new IntegrationPermission(id, id, "Existing selection: restore your account authority or remove this permission before saving."))).OrderBy(permission => permission.Label).ToArray();
    }
    private string TenantName(int id) => _authority?.Tenants.FirstOrDefault(tenant => tenant.TenantId == id)?.Name is { } name ? $"{name} (ID {id})" : $"Tenant {id} (currently unavailable)";
    private string PermissionLabel(string id) => _authority?.Tenants.SelectMany(tenant => tenant.Permissions).Concat(_authority.InstancePermissions).FirstOrDefault(permission => permission.Id == id)?.Label ?? id;
    private bool HasOriginalGrant(IntegrationPairingGrant grant) => _baseline!.Grants.Any(original => original.TenantId == grant.TenantId && original.Permission == grant.Permission);
    private IEnumerable<IntegrationCredentialGrantRequest> RemovedGrants => _baseline!.Grants.Where(grant => !_receipt!.Request.Proposal.Grants.Contains(new(grant.TenantId, grant.Permission)));
    private IEnumerable<string> RemovedInstancePermissions => _baseline!.InstancePermissions.Except(_receipt!.Request.Proposal.InstancePermissions);
    private void AddTenant() { if (_busy || _requestId is not null || _tenantToAdd is not int id || !_authority!.Tenants.Any(tenant => tenant.TenantId == id)) return; _selectedTenants.Add(id); _tenantToAdd = null; }
    private void RemoveTenant(int id) { if (_busy || _requestId is not null) return; _selectedTenants.Remove(id); _grants.RemoveWhere(grant => grant.TenantId == id); }
    private void ChangePermissions(IntegrationPermissionChange change)
    {
        if (_busy || _requestId is not null) return;
        foreach (var permission in change.Permissions)
            if (change.TenantId is int tenant) { var grant = new IntegrationPairingGrant(tenant, permission); if (change.Selected) _grants.Add(grant); else _grants.Remove(grant); }
            else if (change.Selected) _instancePermissions.Add(permission); else _instancePermissions.Remove(permission);
    }
    private async Task ReviewAsync()
    {
        if (_busy || _disposed || _baseline is null || _receipt is not null) return;
        if (_grants.Count == 0 && _instancePermissions.Count == 0) { _error = "Choose at least one tenant or server-level permission. Use Revoke to stop all access."; return; }
        await SetBusyAsync(true); _error = _diagnostic = null;
        _requestId ??= Guid.NewGuid().ToString("N");
        try
        {
            using var response = await Api.PostAsJsonAsync(Route, new { RequestId = _requestId, Grants = _grants.OrderBy(grant => grant.TenantId).ThenBy(grant => grant.Permission).ToArray(), InstancePermissions = _instancePermissions.Order().ToArray() }, _lifetime.Token);
            if (_disposed) return;
            if (!response.IsSuccessStatusCode)
            {
                await ShowErrorAsync(response, "review");
                // Validation and authority failures cannot have created a proposal. Keep editable selections.
                if (response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Forbidden) _requestId = null;
                return;
            }
            _confirmed = false; _focusHeading = true;
            await AcceptReceiptAsync(await response.Content.ReadFromJsonAsync<ReviewedMcpAccessReceipt>(_lifetime.Token));
        }
        catch (Exception error) when (IsRequestFailure(error)) { if (!_disposed) ReportRequestFailure("review", error, "Your submitted draft is retained; retry review to recover the same request."); }
        finally { await SetBusyAsync(false); }
        if (_receipt?.Request.Status == "approved") await ApplyAsync();
    }
    private async Task ApplyAsync()
    {
        if (_busy || _disposed || _receipt is null || _receipt.Request.Status == "pending" && !_confirmed) return;
        await SetBusyAsync(true); _error = _diagnostic = null;
        try
        {
            using var response = await Api.PostAsJsonAsync(RequestRoute + "/apply", new { _receipt.Request.ProposalHash, Confirm = true }, _lifetime.Token);
            if (_disposed) return;
            if (!response.IsSuccessStatusCode) { await ShowErrorAsync(response, "apply"); return; }
            await AcceptReceiptAsync(await response.Content.ReadFromJsonAsync<ReviewedMcpAccessReceipt>(_lifetime.Token));
        }
        catch (Exception error) when (IsRequestFailure(error)) { if (!_disposed) ReportRequestFailure("apply", error, "Your review is retained. Check review status to recover the result before trying again."); }
        finally { await SetBusyAsync(false); }
    }
    private async Task AcceptReceiptAsync(ReviewedMcpAccessReceipt? receipt)
    {
        if (_disposed) return;
        if (receipt is null) { _error = "The review response was incomplete. Your draft is retained; retry or check review status to recover the result."; return; }
        _receipt = receipt;
        // The server binds the proposal to the credential at submission. A change made while
        // this draft was open must appear in the review's removed-access list as well.
        if (_baseline is not null)
            _baseline = _baseline with
            {
                Grants = receipt.ConfiguredGrants.Select(grant => new IntegrationCredentialGrantRequest(grant.TenantId, grant.Permission)).ToArray(),
                InstancePermissions = receipt.ConfiguredInstancePermissions,
                ExpiresAtUtc = receipt.CredentialExpiresAtUtc ?? _baseline.ExpiresAtUtc
            };
        if (receipt.Request.Status == "consumed")
        { _saved = true; _error = null; _focusHeading = true; await Applied.InvokeAsync(receipt); }
        else if (receipt.ReviewFailure is { } failure) _error = failure.Remediation;
    }
    private async Task RefreshReviewAsync()
    {
        if (_busy || _disposed || _requestId is null || _saved) return;
        await SetBusyAsync(true); _error = _diagnostic = null;
        try
        {
            await AcceptReceiptAsync(await ReadAccessAsync<ReviewedMcpAccessReceipt>(RequestRoute, "check-review"));
        }
        catch (Exception error) when (IsRequestFailure(error)) { if (!_disposed && _error is null) ReportRequestFailure("check-review", error, "Your draft and review reference are retained; check review status again."); }
        finally { await SetBusyAsync(false); }
        if (_receipt?.Request.Status == "approved") await ApplyAsync();
    }
    private async Task BackToEditAsync()
    {
        if (_busy || _disposed || _requestId is null) return;
        await SetBusyAsync(true); _error = _diagnostic = null;
        try
        {
            using var response = await Api.PostAsync(RequestRoute + "/cancel", null, _lifetime.Token);
            if (_disposed) return;
            if (!response.IsSuccessStatusCode) { await ShowErrorAsync(response, "cancel"); return; }
            var receipt = await response.Content.ReadFromJsonAsync<ReviewedMcpAccessReceipt>(_lifetime.Token);
            if (receipt is null) { _error = "Could not confirm cancellation. Your draft is retained; check review status before changing it."; return; }
            if (receipt?.Request.Status == "consumed") { await AcceptReceiptAsync(receipt); return; }
            _requestId = null; _receipt = null; _confirmed = false; _focusHeading = true;
        }
        catch (Exception error) when (IsRequestFailure(error)) { if (!_disposed) ReportRequestFailure("cancel", error, "Your selections are retained. Retry cancellation before changing the submitted draft."); }
        finally { await SetBusyAsync(false); }
    }
    private async Task PollReviewAsync()
    {
        // Leave room within the account's ten-request window for review, approval and recovery.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(async () => { if (!_disposed && !_busy && !_saved && _receipt?.Request.Status is "pending" or "approved") { await RefreshReviewAsync(); if (!_disposed) StateHasChanged(); } });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    private async Task<T?> ReadAccessAsync<T>(string route, string stage)
    {
        try
        {
            using var response = await Api.GetAsync(route, _lifetime.Token);
            if (!response.IsSuccessStatusCode)
            {
                await ShowErrorAsync(response, stage);
                response.EnsureSuccessStatusCode();
            }
            try
            {
                return await response.Content.ReadFromJsonAsync<T>(_lifetime.Token)
                    ?? throw new JsonException("Incomplete access response.");
            }
            catch (Exception error) when (IsRequestFailure(error))
            {
                ReportRequestFailure(stage, error, "Retry to recover the complete saved access and pending review.", (int)response.StatusCode, Correlation(response));
                throw;
            }
        }
        catch (Exception error) when (IsRequestFailure(error))
        {
            if (!_disposed && _error is null) ReportRequestFailure(stage, error, "Retry to recover the complete saved access and pending review.");
            throw;
        }
    }
    private async Task ShowErrorAsync(HttpResponseMessage response, string stage)
    {
        _error = response.StatusCode switch
        {
            System.Net.HttpStatusCode.Forbidden => "Your account cannot approve or delegate this access. Keep the draft, review your current authority, or have an authorized administrator approve the review code.",
            System.Net.HttpStatusCode.Unauthorized => "Sign in again, then reopen Edit access to recover your submitted review.",
            System.Net.HttpStatusCode.TooManyRequests => "Too many requests. Your draft is retained; wait a moment and retry.",
            System.Net.HttpStatusCode.BadRequest => "The credential or review destination is unavailable. Check the configured public Web and HTTP MCP addresses; your selections are retained.",
            _ => "The access service is unavailable. Your draft is retained; retry or check the saved review status."
        };
        string? code = null;
        var correlation = Correlation(response);
        try
        {
            // Never display arbitrary upstream text, redirects, HTML or credential-bearing bodies.
            if (response.Content.Headers.ContentLength is not > 16384 && response.Content.Headers.ContentType?.MediaType is "application/json" or "application/problem+json")
            {
                await response.Content.LoadIntoBufferAsync(16384, _lifetime.Token);
                var problem = await response.Content.ReadFromJsonAsync<AccessProblem>(_lifetime.Token);
                if (IntegrationPairingFailure.IsKnownCode(problem?.Code))
                {
                    code = problem!.Code;
                    if (!_disposed) _error = IntegrationPairingFailure.ForCode(code!, stage).Remediation;
                    correlation = SafeReference(problem.CorrelationId) ?? correlation;
                }
            }
        }
        catch (Exception error) when (IsRequestFailure(error)) { }
        RecordDiagnostic(stage, (int)response.StatusCode, code ?? "http_failure", correlation);
    }
    private void ReportRequestFailure(string stage, Exception error, string recovery, int? status = null, string? correlation = null)
    {
        if (_disposed) return;
        var code = error is JsonException ? "invalid_response" : error is OperationCanceledException ? "request_interrupted" : "transport_failure";
        _error = $"Could not complete {stage.Replace('-', ' ')}. {recovery}";
        RecordDiagnostic(stage, status, code, correlation);
    }
    private void RecordDiagnostic(string stage, int? status, string code, string? correlation)
    {
        correlation ??= System.Diagnostics.Activity.Current?.TraceId.ToString();
        _diagnostic = $"Stage: {stage} · HTTP: {status?.ToString() ?? "no response"} · Code: {code}" + (correlation is null ? "" : $" · Reference: {correlation}");
        Logger.LogWarning("Credential access request failed. Stage {Stage}, HTTP {HttpStatus}, code {FailureCode}, reference {CorrelationId}", stage, status, code, correlation);
    }
    private static string? Correlation(HttpResponseMessage response) => response.Headers.TryGetValues("X-Correlation-ID", out var values) ? SafeReference(values.FirstOrDefault()) : null;
    private static string? SafeReference(string? value) => value is { Length: > 0 and <= 128 } && value.All(character => char.IsAsciiLetterOrDigit(character) || character is '-' or '_' or '.' or ':') ? value : null;
    private Task CloseAsync() => _busy ? Task.CompletedTask : Closed.InvokeAsync();
    private async Task SetBusyAsync(bool busy) { if (_disposed) return; _busy = busy; await BusyChanged.InvokeAsync(busy); }
    private static bool IsRequestFailure(Exception error) => error is HttpRequestException or IOException or JsonException or OperationCanceledException;
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
    private sealed record AccessAuthority(IReadOnlyList<AccessTenant> Tenants, IReadOnlyList<IntegrationPermission> InstancePermissions);
    private sealed record AccessTenant(int TenantId, string Name, IReadOnlyList<IntegrationPermission> Permissions);
    private sealed record AccessProblem(string? Code, string? CorrelationId);
}
