@implements IDisposable
@using System.Net.Http.Json
@using System.Text.Json
@using NetRatel.Shared.Connectivity
@using NetRatel.Web.Services
@inject IHttpClientFactory Clients

<MudPaper Class="pa-4 mb-5" Elevation="0" Outlined="true" data-testid="integration-pairing-panel">
    <MudText Typo="Typo.h6">Connect a CLI or MCP client</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">Enter the short code shown by your client's setup. Review its connection and choose the access you want to approve.</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="pairing-error">@_error</MudAlert> }
    @if (_message is not null) { <MudAlert Severity="Severity.Success" Class="mb-3" data-testid="pairing-complete">@_message</MudAlert> }
    @if (_review is null)
    {
        <EditForm Model="_entry" OnSubmit="LookupAsync">
            <AntiforgeryToken />
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudTextField T="string" Label="Client verification code" Variant="Variant.Outlined" @bind-Value="_entry.UserCode" Placeholder="ABCD-EFGH" Disabled="_busy" MaxLength="9" data-testid="pairing-code" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" data-testid="pairing-lookup">@(_busy ? "Checking…" : "Review connection")</MudButton>
            </MudStack>
        </EditForm>
    }
    else
    {
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Confirm code <strong data-testid="pairing-confirm-code">@_review.UserCode</strong></MudText>
            <MudText Typo="Typo.body2">Connection: <strong>@_review.Name</strong> · @(_review.Purpose == PairingCredentialPurpose.Api ? "API / CLI / stdio MCP" : "HTTP MCP client")</MudText>
            <MudText Typo="Typo.body2">Instance: @_review.PublicOrigin</MudText>
            @if (_review.Resource is not null) { <MudText Typo="Typo.body2">HTTP MCP resource: @_review.Resource</MudText> }
            @if (_review.RequestedPermissions.Count > 0)
            { <MudText Typo="Typo.body2">Client suggestions: @string.Join(", ", _review.RequestedPermissions). Choose access explicitly below.</MudText> }
            <MudText Typo="Typo.caption">Approve before @_review.ExpiresAtUtc.UtcDateTime.ToString("HH:mm") UTC. Your sign-in and code lookup do not approve this connection.</MudText>
            <MudDatePicker Label="Credential expires on (23:59 UTC)" @bind-Date="_expiry" MinDate="DateTime.UtcNow.Date.AddDays(1)" MaxDate="DateTime.UtcNow.Date.AddDays(364)" Variant="Variant.Outlined" Disabled="_busy" />
            <MudText Typo="Typo.subtitle2">Tenant permissions</MudText>
            <MudText Typo="Typo.body2">Select each permission for the intended tenant. No access is selected automatically.</MudText>
            <MudExpansionPanels Elevation="0">
                @foreach (var tenant in _authority!.Tenants)
                {
                    <MudExpansionPanel Text="@tenant.Name">
                        @foreach (var permission in tenant.Permissions)
                        {
                            var grant = new IntegrationPairingGrant(tenant.TenantId, permission.Id);
                            <MudCheckBox T="bool" Value="@_grants.Contains(grant)" ValueChanged="@(value => SelectGrant(grant, value))" Label="@permission.Label" Disabled="_busy" data-testid="@($"pairing-grant-{tenant.TenantId}-{permission.Id}")" />
                            <MudText Typo="Typo.caption">@permission.Description</MudText>
                        }
                    </MudExpansionPanel>
                }
                @if (_authority.InstancePermissions.Count > 0)
                {
                    <MudExpansionPanel Text="Server-level access (advanced)">
                        <MudText Typo="Typo.body2">Server-level grants may expose instance-wide information. Select them only when this client needs them.</MudText>
                        @foreach (var permission in _authority.InstancePermissions)
                        { <MudCheckBox T="bool" Value="@_instancePermissions.Contains(permission.Id)" ValueChanged="@(value => SelectInstance(permission.Id, value))" Label="@permission.Label" Disabled="_busy" /> }
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
            @if (_grants.Count > 0 || _instancePermissions.Count > 0)
            {
                <MudText Typo="Typo.subtitle2">Selected access</MudText>
                @foreach (var grant in _grants.OrderBy(grant => grant.TenantId).ThenBy(grant => grant.Permission))
                { <MudText Typo="Typo.body2">@_authority!.Tenants.Single(tenant => tenant.TenantId == grant.TenantId).Name · @grant.Permission</MudText> }
                @foreach (var permission in _instancePermissions.Order()) { <MudText Typo="Typo.body2">Server-level · @permission</MudText> }
            }
            <MudCheckBox T="bool" @bind-Value="_confirmed" Label="@($"I recognize code {_review.UserCode} and approve this connection with the selected access and expiry.")" Disabled="_busy" data-testid="pairing-confirm" />
            <MudStack Row="true">
                <MudButton OnClick="Reset" Disabled="_busy">Back</MudButton>
                <MudButton Color="Color.Error" OnClick="DenyAsync" Disabled="_busy" data-testid="pairing-deny">Deny connection</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ApproveAsync" Disabled="@(_busy || !_confirmed || _grants.Count == 0 && _instancePermissions.Count == 0)" data-testid="pairing-approve">@(_busy ? "Saving…" : "Approve connection")</MudButton>
            </MudStack>
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public EventCallback Approved { get; set; }
    private sealed class CodeEntry { public string UserCode { get; set; } = string.Empty; }
    private readonly CodeEntry _entry = new();
    private IntegrationPairingReview? _review;
    private PairingAuthority? _authority;
    private readonly HashSet<IntegrationPairingGrant> _grants = [];
    private readonly HashSet<string> _instancePermissions = new(StringComparer.Ordinal);
    private DateTime? _expiry = DateTime.UtcNow.Date.AddDays(30);
    private bool _busy, _confirmed, _disposed;
    private string? _error, _message;
    private readonly CancellationTokenSource _lifetime = new();
    private HttpClient Api => Clients.CreateClient("OrchestratorApi");
    private async Task LookupAsync()
    {
        if (_busy || _disposed) return;
        _busy = true; _error = _message = null;
        try
        {
            using var response = await Api.PostAsJsonAsync(IntegrationPairingProtocol.AccountRoute + "/lookup", new IntegrationPairingCodeRequest(_entry.UserCode), _lifetime.Token);
            if (!response.IsSuccessStatusCode) { _error = "This code is unavailable or expired. Check the code or start a new request in your client."; return; }
            var review = await response.Content.ReadFromJsonAsync<IntegrationPairingReview>(_lifetime.Token);
            var authority = await Api.GetFromJsonAsync<PairingAuthority>("/api/v2/account/integration-credentials/authority", _lifetime.Token);
            if (_disposed) return;
            if (review is null || authority is null) { _error = "Could not load the requested connection. Try again."; return; }
            _grants.Clear(); _instancePermissions.Clear(); _confirmed = false;
            _review = review; _authority = authority;
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        { if (!_disposed) _error = "Could not check the connection. Your code is preserved; try again."; }
        finally { if (!_disposed) _busy = false; }
    }
    private void SelectGrant(IntegrationPairingGrant grant, bool selected)
    { if (_busy) return; if (selected) _grants.Add(grant); else _grants.Remove(grant); _confirmed = false; }
    private void SelectInstance(string permission, bool selected)
    { if (_busy) return; if (selected) _instancePermissions.Add(permission); else _instancePermissions.Remove(permission); _confirmed = false; }
    private async Task ApproveAsync()
    {
        if (_busy || _disposed || _review is null || !_confirmed || _grants.Count == 0 && _instancePermissions.Count == 0) return;
        var expiry = IntegrationCredentialExpiry.EndOfUtcDay(_expiry);
        if (expiry is null || expiry <= DateTimeOffset.UtcNow || expiry > DateTimeOffset.UtcNow.AddDays(365))
        { _error = "Choose a credential expiry after today and within one year."; return; }
        await DecideAsync("approve", new IntegrationPairingApprovalRequest(_review.UserCode, expiry.Value,
            _grants.ToArray(), _instancePermissions.ToArray()));
    }
    private Task DenyAsync() => _review is null ? Task.CompletedTask : DecideAsync("deny", new IntegrationPairingCodeRequest(_review.UserCode));
    private async Task DecideAsync<T>(string action, T request)
    {
        if (_busy || _disposed) return;
        _busy = true; _error = null;
        try
        {
            using var response = await Api.PostAsJsonAsync(IntegrationPairingProtocol.AccountRoute + "/" + action, request, _lifetime.Token);
            if (_disposed) return;
            if (!response.IsSuccessStatusCode)
            {
                var problem = response.StatusCode == System.Net.HttpStatusCode.BadRequest
                    ? await response.Content.ReadFromJsonAsync<PairingValidationProblem>(_lifetime.Token) : null;
                _error = problem?.Errors?.ContainsKey("durableAuthority") == true ? IntegrationPairingProtocol.DurableAuthorityGuidance :
                    "The request changed or your access is no longer available. Review your selection or start a new client request.";
                _confirmed = false; return;
            }
            _review = null; _entry.UserCode = string.Empty;
            _grants.Clear(); _instancePermissions.Clear(); _confirmed = false;
            _message = action == "approve" ? "Connection approved. Return to your client to save its credential. You can revoke it here after setup." : "Connection denied. No credential was issued.";
            if (action == "approve") await Approved.InvokeAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        { if (!_disposed) { _error = "Could not save your decision. Check the client status before trying again."; _confirmed = false; } }
        finally { if (!_disposed) _busy = false; }
    }
    private void Reset()
    { if (_busy) return; _review = null; _error = null; _confirmed = false; _grants.Clear(); _instancePermissions.Clear(); }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
    private sealed record PairingValidationProblem(Dictionary<string, string[]>? Errors);
    private sealed record PairingPermission(string Id, string Label, string Description);
    private sealed record PairingTenant(int TenantId, string Name, IReadOnlyList<PairingPermission> Permissions);
    private sealed record PairingAuthority(IReadOnlyList<PairingTenant> Tenants, IReadOnlyList<PairingPermission> InstancePermissions);
}
