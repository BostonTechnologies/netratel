@using Microsoft.AspNetCore.Components.Web
<div class="credential-scope-help" @onkeydown="HandleKey">
    <h3>@Title</h3>
    <div class="credential-scope-help-anchor">
        <MudIconButton @ref="_opener" Icon="@Icons.Material.Outlined.Info" Size="Size.Small"
            OnClick="Toggle" aria-label="@($"About {Title.ToLowerInvariant()}")" aria-expanded="@(_open ? "true" : "false")"
            aria-controls="@TestId" data-testid="@TestId" />
        <MudPopover Open="_open" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
            Style="width: min(20rem, calc(100vw - 3rem)); padding: 1rem; white-space: normal">
            <div id="@TestId" role="region" aria-label="@($"About {Title.ToLowerInvariant()}")" tabindex="-1" @ref="_content" @onkeydown="HandleKey">
                <p>@Description</p>
                <p>Grants remain subject to your current authority and operation policies. Selecting permissions does not create policies or approval.</p>
                <MudButton Size="Size.Small" OnClick="CloseAsync">Close explanation</MudButton>
            </div>
        </MudPopover>
    </div>
</div>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    [Parameter, EditorRequired] public string TestId { get; set; } = "";
    private bool _open;
    private bool _focusHelp;
    private ElementReference _content;
    private MudIconButton? _opener;
    private void Toggle() { _open = !_open; _focusHelp = _open; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusHelp) { _focusHelp = false; await _content.FocusAsync(); }
    }
    private async Task CloseAsync() { _open = false; if (_opener is not null) await _opener.FocusAsync(); }
    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" && _open ? CloseAsync() : Task.CompletedTask;
}
