@using AutomationTrace.Contracts
@using NetRatel.Shared.Contracts
@inject IHttpClientFactory Clients

<section aria-label="Related automation resources" class="automation-related" aria-busy="@loading">
    <header class="related-header">
        <div class="related-heading"><MudIcon Icon="@Icons.Material.Outlined.Link" Size="Size.Small" /><MudText Typo="Typo.subtitle2">Related resources</MudText></div>
        @if (!loading && error is null)
        {
            <div class="related-tickets">
                @foreach (var ticket in ExternalTickets)
                {
                    <div class="related-ticket">
                        <span class="related-ticket-kind">@ReferenceLabel(ticket)</span>
                        <MudLink Href="@ticket.ExternalUrl" Target="_blank" rel="noopener noreferrer" Underline="Underline.Always"
                                 Class="related-ticket-link" aria-label="@($"Open {ReferenceLabel(ticket).ToLowerInvariant()} {ticket.Reference}")">
                            @ticket.Reference <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" />
                        </MudLink>
                    </div>
                }
            </div>
        }
    </header>
    @if (loading) { <MudText Typo="Typo.caption" role="status">Loading associations…</MudText> }
    else if (error is not null)
    { <div class="related-status"><MudText Typo="Typo.caption" role="status">@error</MudText><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadAsync">Retry</MudButton></div> }
    else if (items.Count == 0 && origins.Count == 0) { <MudText Typo="Typo.caption" Color="Color.Secondary">No retained automation links.</MudText> }
    else
    {
        @foreach (var origin in origins)
        {
            <div class="related-origin" @key="(origin.SourceInstanceId, origin.Task.Id, origin.AttemptId)">
                <div class="related-source">
                    <span class="related-label">Source request</span>
                    @if (SourceRequestUrl(origin) is { } sourceUrl)
                    { <MudLink Href="@sourceUrl" Target="_blank" rel="noopener noreferrer" Underline="Underline.Always">@origin.Request.Reference</MudLink> }
                    else { <span class="related-source-reference">@origin.Request.Reference</span> }
                    <span class="related-source-title">@origin.Request.Title</span>
                </div>
                <dl class="related-facts">
                    @if (origin.Service?.Name is { } service) { <div><dt>Service</dt><dd>@service</dd></div> }
                    <div><dt>Submitted by</dt><dd>@(origin.SubmittedBy?.DisplayName ?? "Unavailable in retained evidence")</dd></div>
                    <div><dt>Requested for</dt><dd>@(origin.RequestedFor?.DisplayName ?? "Unavailable in retained evidence")</dd></div>
                    <div><dt>Task</dt><dd>@origin.Task.Name</dd></div>
                </dl>
            </div>
        }
        <nav class="related-native-links" aria-label="Related native resources">
            @foreach (var item in items)
            {
                <MudLink @key="(item.PeerInstanceId, item.PeerOrganizationId, item.ResourceKind, item.ResourceId)" Href="@item.Url"
                         Class="related-native-link" Underline="Underline.Always" title="@item.Title">
                    <MudIcon Icon="@ResourceIcon(item)" Size="Size.Small" />
                    <span>@ResourceLabel(item)</span>
                    <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" Class="related-link-arrow" />
                </MudLink>
            }
        </nav>
    }
</section>
@code {
    [Parameter] public int TenantId { get; set; }
    [Parameter] public string Kind { get; set; } = "request";
    [Parameter] public string ResourceId { get; set; } = "";
    private string? scope, error;
    private IReadOnlyList<AutomationResourceSearchDto> items = [];
    private IReadOnlyList<AutomationOriginContext> origins = [];
    private IEnumerable<AutomationResourceSearchDto> ExternalTickets => items
        .Where(item => item.ExternalUrl is { } url && IsHttps(url))
        .DistinctBy(item => (item.PeerInstanceId, item.PeerOrganizationId, item.ReferenceKind, item.Reference, item.ExternalUrl));
    private bool loading;
    protected override async Task OnParametersSetAsync()
    {
        var next = $"{TenantId}:{Kind}:{ResourceId}";
        if (next == scope) return; scope = next; await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var current = scope; loading = true; error = null; items = []; origins = [];
        try
        {
            var page = await Clients.CreateClient("OrchestratorApi").GetFromJsonAsync<PagedResult<AutomationResourceSearchDto>>(
                $"/api/v1/tenants/{TenantId}/automation-resources/{Uri.EscapeDataString(Kind)}/{Uri.EscapeDataString(ResourceId)}?pageSize=25");
            var context = await Clients.CreateClient("OrchestratorApi").GetFromJsonAsync<List<AutomationOriginContext>>(
                $"/api/v1/tenants/{TenantId}/automation-resources/{Uri.EscapeDataString(Kind)}/{Uri.EscapeDataString(ResourceId)}/origins");
            if (current == scope) { items = page?.Items ?? []; origins = context ?? []; }
        }
        catch (HttpRequestException) { if (current == scope) error = "Associations could not be loaded for your current access."; }
        finally { if (current == scope) loading = false; }
    }
    private static bool IsHttps(string url) => Uri.TryCreate(url, UriKind.Absolute, out var uri) && uri.Scheme == "https" && uri.UserInfo.Length == 0;
    private static string? SourceRequestUrl(AutomationOriginContext origin) => origin.Links
        .FirstOrDefault(link => link.Kind == "source-request" && IsHttps(link.Url))?.Url;
    private static string ReferenceLabel(AutomationResourceSearchDto item) => item.ReferenceKind == "incident" ? "Incident" : "Source request";
    private static string ResourceLabel(AutomationResourceSearchDto item) => item.ResourceKind switch
    { "request" => "Request " + item.ResourceId, "job-run" => "Job execution", "flow-run" => "Flow run", _ => item.Title };
    private static string ResourceIcon(AutomationResourceSearchDto item) => item.ResourceKind switch
    { "request" => Icons.Material.Outlined.Assignment, "job-run" => Icons.Material.Outlined.PlayCircle, _ => Icons.Material.Outlined.AccountTree };
}
