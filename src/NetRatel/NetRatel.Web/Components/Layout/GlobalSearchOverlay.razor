@using Microsoft.AspNetCore.Components.Web
@using NetRatel.Web.Services.Search
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable

@inject IGlobalSearchService SearchService
@inject NavigationManager Nav

@if (Open)
{
    <div class="global-search-backdrop" @onclick="CloseAsync">
        <div class="global-search-panel" @onclick:stopPropagation="true">
            <div class="global-search-input-row">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Medium" />
                <MudTextField @ref="_searchInput"
                              T="string"
                              Value="@_query"
                              ValueChanged="OnQueryChangedAsync"
                              Placeholder="Search..."
                              Immediate="true"
                              Variant="Variant.Text"
                              Underline="false"
                              Class="global-search-input"
                              OnKeyDown="OnKeyDownAsync" />
            </div>

            <div class="global-search-body">
                @if (string.IsNullOrWhiteSpace(_query))
                {
                    <MudStack Spacing="1" Class="global-search-section-list">
                        @foreach (var group in _groups)
                        {
                            <button type="button" class="@RowClass("global-search-row", group.Href)" @onclick="@(() => NavigateAsync(group.Href))">
                                <MudIcon Icon="@group.Icon" Size="Size.Small" />
                                <span>@group.Title</span>
                            </button>
                        }
                    </MudStack>
                }
                else if (!_isLoading && !_groups.Any(g => g.Results.Count > 0 || g.TimedOut))
                {
                    <div class="global-search-empty">No matches found</div>
                }
                else
                {
                    <MudStack Spacing="2" Class="global-search-results">
                        @foreach (var group in _groups.Where(g => g.IsLoading || g.TimedOut || g.Results.Count > 0))
                        {
                            <section>
                                <div class="global-search-group-title">
                                    <span>@group.Title</span>
                                    @if (group.IsLoading)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                    }
                                </div>
                                @foreach (var result in group.Results)
                                {
                                    <button type="button" class="@RowClass("global-search-result", result.Href)" @onclick="@(() => NavigateAsync(result.Href))">
                                        <MudIcon Icon="@result.Icon" Size="Size.Small" />
                                        <span class="global-search-result-main">
                                            <span class="global-search-result-title">@result.Title</span>
                                            @if (!string.IsNullOrWhiteSpace(result.Subtitle))
                                            {
                                                <span class="global-search-result-subtitle">@result.Subtitle</span>
                                            }
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(result.Meta))
                                        {
                                            <span class="global-search-result-meta">@result.Meta</span>
                                        }
                                    </button>
                                }
                                @if (group.TimedOut && !string.IsNullOrWhiteSpace(group.ContinueHref))
                                {
                                    <button type="button" class="@RowClass("global-search-row", group.ContinueHref)" @onclick="@(() => NavigateAsync(group.ContinueHref))">
                                        <MudIcon Icon="@group.Icon" Size="Size.Small" />
                                        <span>@group.Title search timed out — continue search</span>
                                    </button>
                                }
                                else if (!string.IsNullOrWhiteSpace(group.ContinueHref))
                                {
                                    <button type="button" class="@RowClass("global-search-row", group.ContinueHref)" @onclick="@(() => NavigateAsync(group.ContinueHref))">
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                        <span>Continue search in @group.Title</span>
                                    </button>
                                }
                            </section>
                        }
                    </MudStack>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? Authentication { get; set; }

    private MudTextField<string>? _searchInput;
    private IReadOnlyList<GlobalSearchGroup> _groups = [];
    private CancellationTokenSource? _searchCts;
    private string? _query;
    private bool _isLoading;
    private bool _wasOpen;
    private long _generation;
    private int _selection;
    private Task<AuthenticationState>? _authentication;
    protected override void OnInitialized() => Nav.LocationChanged += LocationChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_authentication, Authentication))
        {
            _authentication = Authentication; FenceSearch(); _groups = []; _wasOpen = false;
        }
        if (Open && !_wasOpen)
        {
            _query = string.Empty;
            _groups = await SearchService.SearchAsync(null);
            _wasOpen = true;
            _ = FocusInputAsync();
        }
        else if (!Open)
        {
            _wasOpen = false;
            FenceSearch();
        }
    }

    private async Task FocusInputAsync()
    {
        await Task.Delay(50);
        if (_searchInput is not null)
        {
            await _searchInput.FocusAsync();
        }
    }

    private async Task OnQueryChangedAsync(string? value)
    {
        _query = value;
        var generation = ++_generation; _selection = 0;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        if (string.IsNullOrWhiteSpace(_query))
        {
            _isLoading = false;
            var empty = await SearchService.SearchAsync(null, token);
            if (!token.IsCancellationRequested && generation == _generation) _groups = empty;
            return;
        }

        _groups = _groups.Select(group => group with
        { Results = [], ContinueHref = null, TotalCount = null, IsLoading = true, TimedOut = false }).ToArray();
        _isLoading = true;
        StateHasChanged();

        try
        {
            await Task.Delay(250, token);
            var groups = _groups.ToDictionary(group => group.Key, StringComparer.Ordinal);
            await foreach (var group in SearchService.SearchIncrementalAsync(_query, token))
            {
                if (token.IsCancellationRequested || generation != _generation || !Open) return;
                groups[group.Key] = group;
                _groups = _groups.Select(existing => groups.TryGetValue(existing.Key, out var updated) ? updated : existing).ToList();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (!token.IsCancellationRequested && generation == _generation)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseAsync();
        }
        else if (args.Key == "Enter")
        {
            var links = SelectionLinks();
            if (links.Count > 0)
            {
                await NavigateAsync(links[Math.Clamp(_selection, 0, links.Count - 1)]);
            }
        }
        else if (args.Key is "ArrowDown" or "ArrowUp")
        {
            var count = SelectionLinks().Count;
            if (count > 0) _selection = Math.Clamp(_selection + (args.Key == "ArrowDown" ? 1 : -1), 0, count - 1);
        }
    }

    private async Task NavigateAsync(string href)
    {
        await CloseAsync();
        Nav.NavigateTo(href);
    }

    private async Task CloseAsync()
    {
        FenceSearch();
        await OpenChanged.InvokeAsync(false);
    }
    private IReadOnlyList<string> SelectionLinks() => string.IsNullOrWhiteSpace(_query)
        ? _groups.Select(group => group.Href).ToArray()
        : _groups.Where(group => !group.IsLoading).SelectMany(group => group.Results.Select(result => result.Href)
            .Concat(group.ContinueHref is { } href ? [href] : Array.Empty<string>())).ToArray();
    private string RowClass(string css, string? href)
    {
        var links = SelectionLinks();
        return links.Count > 0 && links[Math.Clamp(_selection, 0, links.Count - 1)] == href ? css + " global-search-selected" : css;
    }
    private void FenceSearch() { ++_generation; _searchCts?.Cancel(); _isLoading = false; _selection = 0; }
    private void LocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    { FenceSearch(); _groups = []; if (Open) await OpenChanged.InvokeAsync(false); });
    public void Dispose() { Nav.LocationChanged -= LocationChanged; FenceSearch(); _searchCts?.Dispose(); }
}
