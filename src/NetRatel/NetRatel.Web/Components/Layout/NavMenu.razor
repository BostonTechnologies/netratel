@implements IDisposable
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NetRatel.Web.Services.Access.IAccessAdministrationApiService AccessApi
@inject IDeploymentBrandingApiService BrandingApi
@inject ILogger<NavMenu> Logger

<MudNavMenu Class="netratel-nav">
    <a class="netratel-nav-brand" href="/" aria-label="@($"{ApplicationName} home")">
        <img src="@CompactLogoUrl" width="64" height="64" alt="@ApplicationName" />
        <span>@ApplicationName</span>
    </a>
    <AuthorizeView Context="outerAuthState">
        <Authorized Context="outerAuthState">
            <div class="nav-section-heading"><span>Command</span></div>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>

            <MudNavGroup Title="Orchestration" Expanded="true" Icon="@Icons.Material.Filled.Workspaces">
                <MudNavLink Href="/jobs" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Work">Jobs</MudNavLink>
                <MudNavLink Href="/requests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Stream">Requests</MudNavLink>
                <MudNavLink Href="/tasks/new" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AddTask">New Task</MudNavLink>
                <MudNavLink Href="/tasks/history" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">Task History</MudNavLink>
            </MudNavGroup>

            <MudNavLink Href="/scriptlibrary" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Code">Script Library</MudNavLink>

            <div class="nav-section-heading"><span>Estate</span></div>
            <MudNavGroup Title="Estate Management" Expanded="false" Icon="@Icons.Material.Filled.Business">
                <MudNavLink Href="/clients" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Devices">Clients</MudNavLink>
                <MudNavLink Href="/tenants" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Tenants</MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/clients/mgmt" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RocketLaunch">Agent Installers</MudNavLink>

            <div class="nav-section-heading"><span>Signals</span></div>
            <MudNavLink Href="/notifications" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Notifications">Notifications</MudNavLink>
            <MudNavGroup Title="AI Ops" Expanded="false">
                <MudNavLink Href="/ai/ops" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Insights">MCP Tools</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <MudDivider Class="my-2 nav-account-divider" />

    <AuthorizeView Context="accountAuthState">
        <Authorized Context="accountAuthState">
            <MudNavLink Href="/account/security" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">@userName</MudNavLink>
            <MudNavLink Href="/account/integration-credentials" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Key">Integration</MudNavLink>
            <AuthorizeView Roles="Operator" Context="adminAuthState">
                <Authorized Context="adminAuthState">
                    <MudNavGroup Title="Admin" Expanded="false" Icon="@Icons.Material.Filled.Settings">
                        <MudNavLink Href="/admin/app-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Tune">App Settings</MudNavLink>
                        <MudNavLink Href="/settings/connectivity" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Lan">Connectivity</MudNavLink>
                        <MudNavLink Href="/clients/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Terminal">Client Runtime Settings</MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>
            @if (canAdministerAccess)
            {
                <MudNavLink Href="/admin/access" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings">Access</MudNavLink>
                <MudNavLink Href="/admin/branding" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.BrandingWatermark">Branding</MudNavLink>
            }
            <MudNavLink Href="/logout" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Logout">Logout</MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>

</MudNavMenu>

@code {
    private string? currentUrl;
    private string? userName;
    private bool canAdministerAccess;
    private EffectiveDeploymentBranding? _branding;
    private string ApplicationName => _branding?.ApplicationName.Value ?? "NetRatel";
    private string CompactLogoUrl => _branding?.CompactLogoUrl.Value ?? "brand/netratel-mark-64.png";

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userName = authState.User.Identity?.Name;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            try
            {
                canAdministerAccess = (await AccessApi.GetSelfAsync()).IsInstanceAdministrator;
            }
            catch (HttpRequestException)
            {
                canAdministerAccess = false;
            }
        }
        try
        {
            ApplyBranding(await BrandingApi.GetPublicAsync());
        }
        catch (HttpRequestException exception)
        {
            // Preserve approved built-in presentation if the API is temporarily unavailable.
            Logger.LogDebug(exception, "Could not read public deployment branding while loading navigation.");
        }
    }

    private void ApplyBranding(EffectiveDeploymentBranding candidate)
    {
        if (_branding is null || candidate.Version >= _branding.Version)
        {
            _branding = candidate;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
