<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8a60dfbe-1ade-4a47-b0bd-3925006a9dcb</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <CompressDiscoveredAssetsDuringBuild>false</CompressDiscoveredAssetsDuringBuild>
    <EnableDefaultCompressedItems>false</EnableDefaultCompressedItems>
    <!-- slopwatch-ignore: SW005 Existing MudBlazor extension package emits EXTEXP0001; this inherited suppression is unrelated to QRCoder. -->
    <NoWarn>$(NoWarn);EXTEXP0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Components\ScriptLibraryView.razor.cs" />
  </ItemGroup>

    <ItemGroup>
      <PackageReference Include="VeloxDev.Core" Version="10.3.0" />
      <PackageReference Include="VeloxDev.Razor" Version="10.3.0" />
      <PackageReference Include="BlazorDownloadFile" Version="2.4.0.2" />
      <PackageReference Include="BlazorMonaco" Version="3.5.0" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
      <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
      <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
      <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
      <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
      <PackageReference Include="CodeBeam.MudBlazor.Extensions" Version="9.2.0" />
      <PackageReference Include="MudBlazor" Version="9.12.0" />
      <PackageReference Include="MudBlazor.ThemeManager" Version="4.0.0" />
      <PackageReference Include="QRCoder" Version="1.8.1" />
      <PackageReference Include="Scalar.AspNetCore" Version="2.18.7" />
    <PackageReference Include="XtermBlazor" Version="2.4.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetRatel.Application\NetRatel.Application.csproj" />
    <ProjectReference Include="..\NetRatel.ServiceDefaults\NetRatel.ServiceDefaults.csproj" />
    <ProjectReference Include="..\NetRatel.Shared\NetRatel.Shared.csproj" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\Pages\Clients\Tasks\" />
    <Folder Include="Components\Views\" />
  </ItemGroup>

  <!-- The app uses Monaco's default English UI; browser locale does not select NLS.
       Revalidate this publish-only selection when the package or locale policy changes.
       Keep the English bundle, NLS loader, all languages, workers and vendor sources. -->
  <Target Name="SelectPublishedMonacoAssets"
          BeforeTargets="GenerateStaticWebAssetsPublishManifest"
          DependsOnTargets="ResolveAllPublishStaticWebAssets">
    <Error Condition="'%(PackageReference.Identity)' == 'BlazorMonaco' and '%(PackageReference.Version)' != '3.5.0'"
           Text="Revalidate the Monaco NLS publish selection for the changed BlazorMonaco package." />
    <ItemGroup>
      <_MonacoAlternateNls Include="@(StaticWebAsset)"
          Condition="'%(StaticWebAsset.SourceId)' == 'BlazorMonaco'
            and $([System.String]::Copy('%(StaticWebAsset.RelativePath)').StartsWith('lib/monaco-editor/min/vs/nls.messages.'))
            and '%(StaticWebAsset.RelativePath)' != 'lib/monaco-editor/min/vs/nls.messages.js.js'" />
      <_SelectedMonacoAlternateNls Include="@(_MonacoAlternateNls)"
          Condition="'%(_MonacoAlternateNls.SourceType)' == 'Package'
            and '%(_MonacoAlternateNls.BasePath)' == '_content/BlazorMonaco'
            and '%(_MonacoAlternateNls.AssetRole)' == 'Primary'
            and '%(_MonacoAlternateNls.AssetKind)' == 'All'
            and $([System.Text.RegularExpressions.Regex]::IsMatch('%(_MonacoAlternateNls.RelativePath)', '^lib/monaco-editor/min/vs/nls[.]messages[.](cs|de|es|fr|it|ja|ko|pl|pt-br|ru|tr|zh-cn|zh-tw)[.]js[.]js$'))" />
    </ItemGroup>
    <Error Condition="'@(_MonacoAlternateNls->Count())' != '13' or '@(_SelectedMonacoAlternateNls->Count())' != '13'"
           Text="The Monaco NLS asset graph changed; revalidate the exact 13 alternate locale assets before publishing." />
    <FilterStaticWebAssetEndpoints Endpoints="@(StaticWebAssetEndpoint)"
                                  Assets="@(_SelectedMonacoAlternateNls)" Filters="">
      <Output TaskParameter="FilteredEndpoints" ItemName="_SelectedMonacoAlternateNlsEndpoints" />
    </FilterStaticWebAssetEndpoints>
    <Error Condition="'@(_SelectedMonacoAlternateNlsEndpoints->Count())' != '26'"
           Text="The Monaco NLS endpoint graph changed; revalidate its asset and fingerprinted routes before publishing." />
    <ItemGroup>
      <StaticWebAsset Remove="@(_SelectedMonacoAlternateNls)" />
      <StaticWebAssetEndpoint Remove="@(_SelectedMonacoAlternateNlsEndpoints)" />
    </ItemGroup>
  </Target>

</Project>
