{
  "ConnectionStrings": {
    "NetRatelDb": "Host=postgres;Port=5432;Database=netratel;Username=netratel;Password=replace-at-deployment"
  },
  "DataProtection": {
    "ApplicationName": "NetRatel",
    "KeysDirectory": "/var/netratel/keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "MachineToken": {
      "Enabled": false,
      "Authority": "https://issuer.example.invalid",
      "Audience": "netratel-machine-token",
      "RequiredGroups": [ "netratel-operators" ],
      "SessionRoles": [ "Operator" ],
      "AllowedSigningAlgorithms": [ "RS256", "ES256" ]
    }
  },
  "Authorization": {
    "Oidc": {
      "AdminGroupId": "replace-with-operator-group-id"
    }
  },
  "SystemToken": {
    "Issuer": "https://netratel.example.invalid/system",
    "Audience": "netratel.system"
  },
  "M2M": {
    "Authority": "http://api:9222",
    "Audience": "netratel.api",
    "AllowedCallerClientIds": [ "netratel.cli", "netratel.client.artifacts" ],
    "AccessTokenLifetimeMinutes": 10
  },
  "M2MClients": {
    "netratel.cli": {
      "AllowedAudiences": [ "netratel.api" ],
      "AllowedScopes": [ "netratel.api" ]
    },
    "netratel.client.artifacts": {
      "AllowedAudiences": [ "netratel.api" ],
      "AllowedScopes": [ "netratel.api" ]
    }
  },
  "ClientArtifacts": {
    "StorageRoot": "/var/netratel/artifacts",
    "LegacyRoot": "artifacts/client",
    "EnableFallbackScan": false,
    "PublicBaseUrl": "https://netratel.example.invalid"
  },
  "StorageOptions": {
    "RootPath": "/var/netratel/storage"
  },
  "AgentAuth": {
    "Issuer": "https://netratel.example.invalid",
    "Audience": "netratel-agent",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 365,
    "SigningKeyId": "netratel-agent-es256"
  },
  "RemoteSupport": {
    "Ice": {
      "SessionLifetime": "00:30:00",
      "StunUrls": [],
      "Turn": {
        "Enabled": false,
        "Urls": [],
        "Realm": "",
        "UsernamePrefix": "netratel"
      }
    }
  },
  "NetRatelAkkaMigration": {
    "SignalRShadowEnabled": false,
    "SignalRShadowLocalCanaryEnabled": false
  }
}
