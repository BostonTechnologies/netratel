# Copy to .env before running Docker Compose. Do not commit .env.
POSTGRES_DB=netratel
POSTGRES_USER=netratel
POSTGRES_PASSWORD=replace-with-a-long-random-value
NETRATEL_WEB_PORT=8080
NETRATEL_WEB_BIND_ADDRESS=127.0.0.1
# Leave OIDC blank for the restricted fresh-install setup shell. Existing OIDC
# deployments must provide all values through their deployment secret mechanism.
# Optional: NETRATEL_AUTHENTICATION_MODE=Local ignores unused old OIDC values.
# Auto (the default) preserves existing OIDC deployments.
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_API_SCOPE=
OIDC_API_AUDIENCE=
OIDC_TOKEN_ENDPOINT=
OIDC_ADMIN_GROUP_ID=
OIDC_CLIENT_SECRET=
# Set this only for an operational OIDC/native-agent run; bootstrap status does
# not load agent signing material.
NETRATEL_AGENT_AUTH_PRIVATE_KEY=
