# Copy to .env before running Docker Compose. Do not commit .env.
POSTGRES_DB=netratel
POSTGRES_USER=netratel
POSTGRES_PASSWORD=replace-with-a-long-random-value
NETRATEL_WEB_PORT=8080
NETRATEL_WEB_BIND_ADDRESS=127.0.0.1
OIDC_AUTHORITY=https://issuer.example.invalid
OIDC_CLIENT_ID=replace-with-oidc-client-id
OIDC_API_SCOPE=netratel.api
OIDC_API_AUDIENCE=netratel.api
OIDC_TOKEN_ENDPOINT=https://issuer.example.invalid/oauth/token
OIDC_ADMIN_GROUP_ID=replace-with-operator-group-id
OIDC_CLIENT_SECRET=replace-with-your-oidc-client-secret
NETRATEL_AGENT_AUTH_PRIVATE_KEY=./.netratel-agent-es256-private.pem
