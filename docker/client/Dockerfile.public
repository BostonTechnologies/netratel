# Public, standalone NetRatel Client image. Site-specific operator tooling is
# supplied by a separately reviewed deployment overlay.
# This file intentionally has no source, credential, or tooling dependency on
# private repositories.
FROM mcr.microsoft.com/dotnet/sdk:10.0.302-noble AS build
ARG BUILD_CONFIGURATION=Release
ARG TARGETARCH
WORKDIR /src

RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) ;; \
      *) echo "The public client container currently supports linux/amd64 only." >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential; \
    rm -rf /var/lib/apt/lists/*

COPY ["global.json", "Directory.Build.props", "Directory.Build.targets", "./"]
COPY ["src/NetRatel/NetRatel.Client/NetRatel.Client.csproj", "src/NetRatel/NetRatel.Client/"]
COPY ["src/NetRatel/NetRatel.Application/NetRatel.Application.csproj", "src/NetRatel/NetRatel.Application/"]
COPY ["src/NetRatel/NetRatel.Infrastructure/NetRatel.Infrastructure.csproj", "src/NetRatel/NetRatel.Infrastructure/"]
COPY ["src/NetRatel/NetRatel.Shared/NetRatel.Shared.csproj", "src/NetRatel/NetRatel.Shared/"]
COPY ["src/NetRatel/NetRatel.AgentGateway.Contracts/NetRatel.AgentGateway.Contracts.csproj", "src/NetRatel/NetRatel.AgentGateway.Contracts/"]
RUN dotnet restore "src/NetRatel/NetRatel.Client/NetRatel.Client.csproj" --runtime linux-x64

COPY . .
RUN dotnet publish "src/NetRatel/NetRatel.Client/NetRatel.Client.csproj" \
      --configuration "${BUILD_CONFIGURATION}" \
      --runtime linux-x64 \
      --self-contained true \
      --no-restore \
      --output /out

FROM mcr.microsoft.com/dotnet/runtime-deps:10.0-noble AS runtime
ARG APP_USER=netratel
ARG APP_UID=10001
ARG APP_GID=10001

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends bash ca-certificates python3; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --system --gid "${APP_GID}" "${APP_USER}"; \
    useradd --system --uid "${APP_UID}" --gid "${APP_GID}" --home-dir /var/lib/netratel --create-home --shell /usr/sbin/nologin "${APP_USER}"; \
    mkdir -p /etc/netratel /var/lib/netratel; \
    chown -R "${APP_USER}:${APP_USER}" /etc/netratel /var/lib/netratel

WORKDIR /app
COPY --from=build --chown=netratel:netratel /out ./
ENV NETRATEL_POWERSHELL_HOME=/var/lib/netratel/powershell
USER netratel
ENTRYPOINT ["/app/NetRatel.Client"]
