# Actual API deployment keys; mounted secret is independent of delegation.
M2M__Authority=https://netratel.example.invalid
M2M__Audience=netratel.api
M2M__AllowedCallerClientIds__0=netratel.cli
M2M__AllowedCallerClientIds__1=netratel.client.artifacts
M2M__AllowedCallerClientIds__2=netratel-mcp-http
M2MClients__netratel_mcp_http__SecretFile=/run/netratel-mcp-secrets/outbound-m2m.secret
M2MClients__netratel_mcp_http__AllowedAudiences__0=netratel.api
M2MClients__netratel_mcp_http__AllowedScopes__0=netratel.api
