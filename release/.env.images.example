# Immutable digests are populated only after an approved public release.
POSTGRES_DB=netratel
POSTGRES_USER=netratel
POSTGRES_PASSWORD=replace-with-a-long-random-value
NETRATEL_WEB_PORT=8080
NETRATEL_WEB_BIND_ADDRESS=127.0.0.1
# Optional compose.public-https.yaml overlay. Replace every example with the
# real public origin, certificate files, and a free Docker subnet.
NETRATEL_PUBLIC_HOST=netratel.example.com
# These origins also configure API-owned installer addresses. Leave both blank
# for a base deployment configured on Admin / Branding. The HTTPS overlay needs
# the public origin; explicitly set both to the same value for a shared ingress.
NETRATEL_PUBLIC_ORIGIN=https://netratel.example.com
NETRATEL_PUBLIC_GATEWAY_ORIGIN=https://netratel.example.com
NETRATEL_HTTPS_BIND_ADDRESS=0.0.0.0
NETRATEL_HTTPS_PORT=443
NETRATEL_HTTPS_CERTIFICATE=./tls/fullchain.pem
NETRATEL_HTTPS_PRIVATE_KEY=./tls/privkey.pem
NETRATEL_INGRESS_SUBNET=172.29.20.0/24
NETRATEL_INGRESS_PROXY_IP=172.29.20.10
# Leave every OIDC value empty for local-account mode. Set this complete group
# only for an explicitly configured OIDC or hybrid deployment.
# Optional: set NETRATEL_AUTHENTICATION_MODE=Local when unused old OIDC values
# remain in the environment. Auto preserves existing OIDC deployments.
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_API_SCOPE=
OIDC_API_AUDIENCE=
OIDC_TOKEN_ENDPOINT=
OIDC_ADMIN_GROUP_ID=
OIDC_CLIENT_SECRET=
NETRATEL_AGENT_AUTH_PRIVATE_KEY=./.netratel-agent-es256-private.pem
NETRATEL_API_IMAGE=ghcr.io/bostontechnologies/netratel-api@sha256:REPLACE_AFTER_APPROVED_PUBLIC_RELEASE
NETRATEL_MIGRATIONS_IMAGE=ghcr.io/bostontechnologies/netratel-migrations@sha256:REPLACE_AFTER_APPROVED_PUBLIC_RELEASE
NETRATEL_WEB_IMAGE=ghcr.io/bostontechnologies/netratel-web@sha256:REPLACE_AFTER_APPROVED_PUBLIC_RELEASE

# Optional HTTP MCP deployment; select compose.mcp-http.yaml explicitly.
NETRATEL_MCP_HTTP_IMAGE=ghcr.io/bostontechnologies/netratel-mcp-http@sha256:REPLACE_AFTER_APPROVED_PUBLIC_RELEASE
NETRATEL_WEB_API_BACKEND_URL=http://api:9222/
NETRATEL_WEB_MCP_BACKEND_URL=http://mcp-http:9224/
NETRATEL_MCP_INSTANCE=prod
NETRATEL_MCP_PROD_API_BASE_URL=https://netratel.example.com
# Blank resource/audience use the trusted public origin plus /mcp.
NETRATEL_MCP_PUBLIC_RESOURCE_URI=
NETRATEL_MCP_AUDIENCE=
NETRATEL_MCP_LOCAL_CREDENTIAL_MODE=true
NETRATEL_MCP_AUTHENTICATION_MODE=LocalCredential
# OIDC mode instead needs false/Oidc above and all three nonempty values below.
NETRATEL_MCP_OIDC_AUTHORITY=
NETRATEL_MCP_REQUIRED_GROUP=
NETRATEL_MCP_REQUIRED_SCOPE=
NETRATEL_MCP_DELEGATION_ENABLED=true
NETRATEL_MCP_DELEGATION_ISSUER=netratel-mcp-prod
NETRATEL_MCP_DELEGATION_AUDIENCE=netratel-api-prod
NETRATEL_MCP_DELEGATION_SERVICE_PRINCIPAL=netratel-mcp-http
NETRATEL_MCP_DELEGATION_KEY_ID=deployment-v1
# Container path; select compose.mcp-http.secrets.yaml and set its host directory.
NETRATEL_MCP_DELEGATION_KEY_FILE=/run/netratel-mcp-secrets/delegation.key
NETRATEL_MCP_SECRETS_DIRECTORY=
# Environment-only outbound: this is a separate actual-key container env file.
NETRATEL_MCP_OUTBOUND_ENV_FILE=./mcp-http.outbound.env
NETRATEL_MCP_API_ENV_FILE=./mcp-http.api.env
# Existing JSON alternative: select compose.mcp-http.config.yaml instead.
NETRATEL_MCP_OUTBOUND_CONFIG_FILE=
# Optional custom/split topology port binding overlay.
NETRATEL_MCP_HTTP_BIND_ADDRESS=127.0.0.1
NETRATEL_MCP_HTTP_PORT=9224
# Match a custom setup --listen-port value when using the port overlay.
NETRATEL_MCP_HTTP_CONTAINER_PORT=9224
# Standalone setup uses only an existing tooling image and this absolute mount.
NETRATEL_SETUP_OUTPUT_DIRECTORY=
NETRATEL_SETUP_UID=10001
NETRATEL_SETUP_GID=10001
