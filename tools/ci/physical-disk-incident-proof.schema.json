{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netratel:physical-disk-incident-proof:v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "netratel.physical-disk-incident-proof.v2"
    },
    "status": {
      "const": "PASS_ACTUAL_PHYSICAL_INCIDENT"
    },
    "candidateSource": {
      "type": "string",
      "maxLength": 1024
    },
    "candidateTree": {
      "type": "string",
      "maxLength": 1024
    },
    "reviewedSource": {
      "type": "string",
      "maxLength": 1024
    },
    "actualTestCheckout": {
      "type": "string",
      "maxLength": 1024
    },
    "companion": {
      "$ref": "#/$defs/PhysicalProduct"
    },
    "producer": {
      "$ref": "#/$defs/PhysicalProducer"
    },
    "admission": {
      "$ref": "#/$defs/PhysicalAdmission"
    },
    "volume": {
      "$ref": "#/$defs/PhysicalVolume"
    },
    "rule": {
      "$ref": "#/$defs/PhysicalRule"
    },
    "recordedTask": {
      "$ref": "#/$defs/PhysicalRecordedTask"
    },
    "baselineCollections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhysicalDiskSample"
      },
      "maxItems": 128
    },
    "breachCollections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhysicalDiskSample"
      },
      "maxItems": 128
    },
    "continuedBreachCollections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhysicalDiskSample"
      },
      "maxItems": 128
    },
    "recoveryCollections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhysicalDiskSample"
      },
      "maxItems": 128
    },
    "secondBreachCollections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhysicalDiskSample"
      },
      "maxItems": 128
    },
    "committedLoss": {
      "$ref": "#/$defs/PhysicalCommittedLoss"
    },
    "rotation": {
      "$ref": "#/$defs/PhysicalRotation"
    },
    "durableIdentities": {
      "$ref": "#/$defs/PhysicalDurableProof"
    },
    "unlink": {
      "$ref": "#/$defs/PhysicalUnlinkProof"
    },
    "apiProcesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhysicalApiProcess"
      },
      "maxItems": 128
    },
    "cleanup": {
      "$ref": "#/$defs/PhysicalCleanup"
    }
  },
  "required": [
    "schema",
    "status",
    "candidateSource",
    "candidateTree",
    "reviewedSource",
    "actualTestCheckout",
    "companion",
    "producer",
    "admission",
    "volume",
    "rule",
    "recordedTask",
    "baselineCollections",
    "breachCollections",
    "continuedBreachCollections",
    "recoveryCollections",
    "secondBreachCollections",
    "committedLoss",
    "rotation",
    "durableIdentities",
    "unlink",
    "apiProcesses",
    "cleanup"
  ],
  "$defs": {
    "PhysicalAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occurrenceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "flowRunId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "flowVersionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "actionKey": {
          "type": "string",
          "maxLength": 1024
        },
        "receiverKey": {
          "type": "string",
          "maxLength": 1024
        },
        "payloadSha256": {
          "type": "string",
          "maxLength": 1024
        },
        "receiverFingerprint": {
          "type": "string",
          "maxLength": 1024
        },
        "sourceNamespaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sourceInstanceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "semanticRevision": {
          "type": "integer"
        }
      },
      "required": [
        "occurrenceId",
        "flowRunId",
        "flowVersionId",
        "actionKey",
        "receiverKey",
        "payloadSha256",
        "receiverFingerprint",
        "sourceNamespaceId",
        "sourceInstanceId",
        "semanticRevision"
      ]
    },
    "PhysicalAdmission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "connectionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "connectionEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceStreamId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "committedOwner": {
          "type": "boolean"
        },
        "productionSystemClock": {
          "type": "boolean"
        },
        "producer": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "agentId",
        "connectionId",
        "connectionEpoch",
        "evidenceStreamId",
        "committedOwner",
        "productionSystemClock",
        "producer"
      ]
    },
    "PhysicalAllocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completedAtUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "bytes": {
          "type": "integer"
        },
        "actualBlocksBytes": {
          "type": "integer"
        },
        "selectedFreeBefore": {
          "type": "integer"
        },
        "selectedFreeAfter": {
          "type": "integer"
        },
        "hostFreeAfter": {
          "type": "integer"
        }
      },
      "required": [
        "completedAtUtc",
        "bytes",
        "actualBlocksBytes",
        "selectedFreeBefore",
        "selectedFreeAfter",
        "hostFreeAfter"
      ]
    },
    "PhysicalApiProcess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processId": {
          "type": "integer"
        },
        "startedAtUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "exitedAtUtc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "type": "string",
          "maxLength": 1024
        },
        "generation": {
          "type": "integer"
        }
      },
      "required": [
        "processId",
        "startedAtUtc",
        "exitedAtUtc",
        "exitCode",
        "role",
        "generation"
      ]
    },
    "PhysicalCleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientStoppedAndRemoved": {
          "type": "boolean"
        },
        "mountRemoved": {
          "type": "boolean"
        },
        "loopDetached": {
          "type": "boolean"
        },
        "backingRemoved": {
          "type": "boolean"
        },
        "privateCredentialsRemoved": {
          "type": "boolean"
        },
        "allApiProcessesExited": {
          "type": "boolean"
        },
        "imagesRemoved": {
          "type": "integer"
        },
        "fleetChanges": {
          "type": "integer"
        },
        "bothProductFixturesDisposed": {
          "type": "boolean",
          "const": true
        },
        "apiPrivateStateRemoved": {
          "type": "boolean",
          "const": true
        },
        "ownedMetadataRemoved": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "clientStoppedAndRemoved",
        "mountRemoved",
        "loopDetached",
        "backingRemoved",
        "privateCredentialsRemoved",
        "allApiProcessesExited",
        "imagesRemoved",
        "fleetChanges",
        "bothProductFixturesDisposed",
        "apiPrivateStateRemoved",
        "ownedMetadataRemoved"
      ]
    },
    "PhysicalCommittedLoss": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actualUpstreamStatus": {
          "type": "integer"
        },
        "transactionCommitted": {
          "type": "boolean"
        },
        "responseAbortedAfterIndependentRead": {
          "type": "boolean"
        },
        "namespaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "key": {
          "type": "string",
          "maxLength": 1024
        },
        "fingerprint": {
          "type": "string",
          "maxLength": 1024
        },
        "incidentRows": {
          "type": "integer"
        },
        "receiptRows": {
          "type": "integer"
        },
        "confirmationEnqueues": {
          "type": "integer"
        }
      },
      "required": [
        "actualUpstreamStatus",
        "transactionCommitted",
        "responseAbortedAfterIndependentRead",
        "namespaceId",
        "key",
        "fingerprint",
        "incidentRows",
        "receiptRows",
        "confirmationEnqueues"
      ]
    },
    "PhysicalDiskSample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "maxLength": 1024
        },
        "collectionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "collectedAtUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "frameObservedAtUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "receivedAtUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "transportSequence": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer"
        },
        "freeBytes": {
          "type": "integer"
        },
        "collectionComplete": {
          "type": "boolean"
        },
        "transportAccepted": {
          "type": "boolean"
        },
        "durableCommittedOwner": {
          "type": "boolean"
        }
      },
      "required": [
        "scope",
        "collectionId",
        "collectedAtUtc",
        "frameObservedAtUtc",
        "receivedAtUtc",
        "transportSequence",
        "totalBytes",
        "freeBytes",
        "collectionComplete",
        "transportAccepted",
        "durableCommittedOwner"
      ]
    },
    "PhysicalDurableProof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occurrences": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "maxItems": 128
        },
        "raisedEvents": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "maxItems": 128
        },
        "dispatchIntentKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 128
        },
        "flowRunIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "maxItems": 128
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhysicalAction"
          },
          "maxItems": 128
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "maxItems": 128
        },
        "incidents": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 128
        },
        "confirmationEffects": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "maxItems": 128
        },
        "mayHaveCommitted": {
          "type": "boolean"
        },
        "actionSucceeded": {
          "type": "boolean"
        }
      },
      "required": [
        "occurrences",
        "raisedEvents",
        "dispatchIntentKeys",
        "flowRunIds",
        "actions",
        "receipts",
        "incidents",
        "confirmationEffects",
        "mayHaveCommitted",
        "actionSucceeded"
      ]
    },
    "PhysicalProducer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageId": {
          "type": "string",
          "maxLength": 1024
        },
        "executableSha256": {
          "type": "string",
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "maxLength": 1024
        },
        "source": {
          "type": "string",
          "maxLength": 1024
        },
        "producer": {
          "type": "string",
          "maxLength": 1024
        },
        "slowCollectionSeconds": {
          "type": "integer"
        },
        "maximumLifetimeSeconds": {
          "type": "integer"
        },
        "caSha256": {
          "type": "string",
          "maxLength": 1024
        },
        "trustedTlsAlpnVerified": {
          "type": "boolean"
        },
        "unrelatedCaRejected": {
          "type": "boolean"
        },
        "ownedExt4Visible": {
          "type": "boolean"
        }
      },
      "required": [
        "imageId",
        "executableSha256",
        "version",
        "source",
        "producer",
        "slowCollectionSeconds",
        "maximumLifetimeSeconds",
        "caSha256",
        "trustedTlsAlpnVerified",
        "unrelatedCaRejected",
        "ownedExt4Visible"
      ]
    },
    "PhysicalProduct": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 1024
        },
        "source": {
          "type": "string",
          "maxLength": 1024
        },
        "apiImage": {
          "type": "string",
          "maxLength": 1024
        },
        "webImage": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "version",
        "source",
        "apiImage",
        "webImage"
      ]
    },
    "PhysicalRecordedTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentRequestId": {
          "type": "string",
          "maxLength": 1024
        },
        "taskId": {
          "type": "string",
          "maxLength": 1024
        },
        "automationBindingId": {
          "type": "string",
          "maxLength": 1024
        },
        "netRatelRequestId": {
          "type": "integer"
        },
        "jobRunId": {
          "type": "string",
          "maxLength": 1024
        },
        "stepId": {
          "type": "string",
          "maxLength": 1024
        },
        "activityId": {
          "type": "string",
          "maxLength": 1024
        },
        "successWorklogId": {
          "type": "string",
          "maxLength": 1024
        },
        "callbackStatus": {
          "type": "integer"
        },
        "taskTemplateId": {
          "type": "string",
          "maxLength": 1024
        },
        "correlationId": {
          "type": "string",
          "maxLength": 1024
        },
        "commandMarker": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "parentRequestId",
        "taskId",
        "automationBindingId",
        "netRatelRequestId",
        "jobRunId",
        "stepId",
        "activityId",
        "successWorklogId",
        "callbackStatus",
        "taskTemplateId",
        "correlationId",
        "commandMarker"
      ]
    },
    "PhysicalRotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beforeCredentialRevision": {
          "type": "integer"
        },
        "afterCredentialRevision": {
          "type": "integer"
        },
        "beforeSemanticRevision": {
          "type": "integer"
        },
        "afterSemanticRevision": {
          "type": "integer"
        },
        "beforeSourceNamespaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "afterSourceNamespaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "beforeCredentialRevision",
        "afterCredentialRevision",
        "beforeSemanticRevision",
        "afterSemanticRevision",
        "beforeSourceNamespaceId",
        "afterSourceNamespaceId"
      ]
    },
    "PhysicalRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "flowVersionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "configurationHash": {
          "type": "string",
          "maxLength": 1024
        },
        "resourceKey": {
          "type": "string",
          "maxLength": 1024
        },
        "configurationRevision": {
          "type": "integer"
        },
        "connectorId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "semanticRevision": {
          "type": "integer"
        }
      },
      "required": [
        "ruleId",
        "flowVersionId",
        "configurationHash",
        "resourceKey",
        "configurationRevision",
        "connectorId",
        "semanticRevision"
      ]
    },
    "PhysicalUnlinkProof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positiveControlStatusBeforeUnlink": {
          "type": "integer"
        },
        "protectedDenialStatus": {
          "type": "integer"
        },
        "samePrivateAuthorizationHandleUsed": {
          "type": "boolean"
        },
        "cachedAuthorizationCommonExpiresAtUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Minimum of the actually parsed receiver and NetRatel inbound cached JWT expiries; no token value."
        },
        "latestDenialObservedAtUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Final observation after receiver denial, immediate and settled denial on both actual NetRatel API replicas and revoked-current credential issuance denial."
        },
        "positivelyControlledInboundReplicas": {
          "type": "integer",
          "const": 2
        },
        "immediateDeniedInboundReplicas": {
          "type": "integer",
          "const": 2
        },
        "settledDeniedInboundReplicas": {
          "type": "integer",
          "const": 2
        }
      },
      "required": [
        "positiveControlStatusBeforeUnlink",
        "protectedDenialStatus",
        "cachedAuthorizationCommonExpiresAtUtc",
        "latestDenialObservedAtUtc",
        "samePrivateAuthorizationHandleUsed",
        "positivelyControlledInboundReplicas",
        "immediateDeniedInboundReplicas",
        "settledDeniedInboundReplicas"
      ]
    },
    "PhysicalVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backingBytes": {
          "type": "integer"
        },
        "selectedAvailableBefore": {
          "type": "integer"
        },
        "hostAvailableBefore": {
          "type": "integer"
        },
        "filesystem": {
          "type": "string",
          "maxLength": 1024
        },
        "sparseBacking": {
          "type": "boolean"
        },
        "allocation": {
          "$ref": "#/$defs/PhysicalAllocation"
        },
        "recovery": {
          "$ref": "#/$defs/PhysicalAllocation"
        },
        "secondAllocation": {
          "$ref": "#/$defs/PhysicalAllocation"
        }
      },
      "required": [
        "backingBytes",
        "selectedAvailableBefore",
        "hostAvailableBefore",
        "filesystem",
        "sparseBacking",
        "allocation",
        "recovery",
        "secondAllocation"
      ]
    }
  }
}
